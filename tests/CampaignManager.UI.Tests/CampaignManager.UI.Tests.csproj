<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-кит на bUnit: поведение компонентов (диалог, бросок, таблица, редактор списка) и служб.
    Вёрстку под iPad bUnit не проверит — её смотрят в браузере на /dev/ui (AUDIT, «Тесты»).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CampaignManager.UI\CampaignManager.UI.csproj" />
  </ItemGroup>

</Project>
