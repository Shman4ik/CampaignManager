<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Web\CampaignManager.Web.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>82cc3d4c-4bb9-4f91-a0f3-efb8fd54d8d5</UserSecretsId>
    <!-- DCP и дашборд берутся из Aspire CLI (aspire на PATH, иначе пакет через dnx), а не из
         NuGet. Без этого Aspire 13.5+ выдаёт ASPIRE010, а при TreatWarningsAsErrors это ошибка. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

</Project>
