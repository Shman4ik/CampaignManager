@namespace CampaignManager.Web.Components
@using CampaignManager.Web.Components.Layout
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <base href="/"/>
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]"/>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Campaign Manager — Call of Cthulhu 7e"/>
    <meta property="og:description" content="Веб-приложение для ведения настольной ролевой игры Call of Cthulhu 7th Edition. Управление кампаниями, персонажами, боем и вики."/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content="/favicon.png"/>
    <meta name="description" content="Campaign Manager — инструмент для ведения Call of Cthulhu 7e. Кампании, персонажи, бой, погоня, вики."/>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/flowbite@1.5.4/dist/flowbite.min.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Tailwind CSS (locally generated) -->
    <link href="@Assets["styles.css"]" rel="stylesheet"/>
    <!-- Design System -->
    <link href="@Assets["css/design-system.css"]" rel="stylesheet"/>
    <link href="@Assets["css/markdown-styles.css"]" rel="stylesheet"/>
    <!-- Диалог переподключения circuit -->
    <link href="@Assets["css/reconnect.css"]" rel="stylesheet"/>
    <!-- CSS Isolation Bundle - Scoped component styles -->
    <link href="@Assets["CampaignManager.Web.styles.css"]" rel="stylesheet"/>
    <HeadOutlet/>
</head>
<body>
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == false)
                    {
                        <p>У вас нет прав доступа к этой странице.</p>
                    }
                </NotAuthorized>
                <Authorizing>
                    <p>Проверка авторизации...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Извините, по этому адресу ничего не найдено.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<!--
    Диалог переподключения. id обязателен: по нему Blazor находит элемент и вместо
    стандартного англоязычного оверлея переключает на нём классы состояния
    (components-reconnect-show / -retrying / -paused / -failed / -resume-failed / -rejected).
    Логика пауз и возобновления — в js/circuit-persistence.js, стили — в css/reconnect.css.
-->
<div id="components-reconnect-modal" class="cm-reconnect">
    <div class="cm-reconnect__dialog" role="alertdialog" aria-live="assertive">
        <div class="cm-reconnect__spinner" aria-hidden="true"></div>

        <p class="cm-reconnect__text cm-reconnect__text--retrying">
            <span class="cm-reconnect__title">Связь с сервером потеряна</span>
            Восстанавливаем соединение — открытая сцена сохранена.
            <span class="cm-reconnect__attempt cm-reconnect__hint">
                Попытка <span id="components-reconnect-current-attempt"></span>
                из <span id="components-reconnect-max-retries"></span>,
                следующая через <span id="components-seconds-to-next-attempt"></span> с
            </span>
        </p>

        <p class="cm-reconnect__text cm-reconnect__text--paused">
            <span class="cm-reconnect__title">Сессия приостановлена</span>
            Состояние сохранено в браузере. Продолжим с того же места, как только сервер ответит.
        </p>

        <p class="cm-reconnect__text cm-reconnect__text--failed">
            <span class="cm-reconnect__title">Не удалось переподключиться</span>
            Сервер не отвечает или был перезапущен.
        </p>

        <p class="cm-reconnect__text cm-reconnect__text--resume-failed">
            <span class="cm-reconnect__title">Не удалось продолжить сессию</span>
            Сохранённое состояние больше недоступно — придётся перезагрузить страницу.
            <span class="cm-reconnect__hint">Бой и погоня восстановятся из сохранённой сцены.</span>
        </p>

        <p class="cm-reconnect__text cm-reconnect__text--rejected">
            <span class="cm-reconnect__title">Соединение закрыто сервером</span>
            Перезагрузите страницу, чтобы продолжить работу.
        </p>

        <div class="cm-reconnect__actions">
            <button id="cm-reconnect-resume" type="button" class="cm-btn cm-btn-primary cm-btn-sm">
                <span>Продолжить</span>
            </button>
            <button id="cm-reconnect-retry" type="button" class="cm-btn cm-btn-secondary cm-btn-sm">
                <span>Повторить</span>
            </button>
            <button id="cm-reconnect-reload" type="button" class="cm-btn cm-btn-secondary cm-btn-sm">
                <span>Перезагрузить страницу</span>
            </button>
        </div>
    </div>
</div>

<script src="_framework/blazor.web.js"></script>
<script src="@Assets["js/app.js"]"></script>
<script src="@Assets["js/character-page.js"]"></script>
<script src="@Assets["js/circuit-persistence.js"]"></script>
</body>
</html>