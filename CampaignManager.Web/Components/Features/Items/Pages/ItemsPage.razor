@page "/items"
@using CampaignManager.Web.Components.Features.Items.Components
@using CampaignManager.Web.Components.Features.Items.Model
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Предметы - Campaign Manager</PageTitle>

<PageHeader Title="Предметы">
    <Actions>
        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="ShowAddModal">
            <i class="fas fa-plus"></i>
            <span>Добавить</span>
        </button>
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel Title="Фильтры"
                 @bind-IsExpanded="isSearchPanelVisible">
        <ActionButtons>
            @if (isSearchPanelVisible)
            {
                <button type="button" class="cm-btn cm-btn-outline-primary cm-btn-sm" @onclick="ResetFilters">
                    <i class="fas fa-undo-alt"></i>
                    <span>Сбросить</span>
                </button>
            }
        </ActionButtons>
        <ChildContent>
            @* Поиск, тип и два флажка — одной строкой: в портрете она переносится,
               в ландшафте занимает одну полосу вместо трёх. *@
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <input type="text" id="itemSearch"
                       value="@searchQuery"
                       @oninput="HandleSearchInput"
                       placeholder="Поиск предметов..."
                       class="min-w-[12rem] flex-1 rounded border border-primary-300 bg-primary-50 px-3 py-1.5 text-sm transition-colors hover:border-primary-400 hover:bg-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500/25" />

                <select id="itemType" @onchange="HandleTypeChanged"
                        class="rounded border border-primary-300 bg-primary-50 px-3 py-1.5 text-sm transition-colors hover:border-primary-400 hover:bg-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500/25">
                    <option value="">Все типы</option>
                    @if (itemTypes is not null)
                    {
                        @foreach (var type in itemTypes)
                        {
                            <option value="@type" selected="@(selectedType == type)">@type</option>
                        }
                    }
                </select>

                <div class="flex flex-wrap items-center gap-x-4">
                    <label for="era1920s" class="flex min-h-[36px] cursor-pointer items-center gap-2">
                        <input type="checkbox" id="era1920s" checked="@is1920Filter"
                               @onchange="SetEra1920"
                               class="h-5 w-5 rounded border-primary-300 accent-accent-500" />
                        <span class="text-sm text-primary-700">1920-е</span>
                    </label>
                    <label for="eraModern" class="flex min-h-[36px] cursor-pointer items-center gap-2">
                        <input type="checkbox" id="eraModern" checked="@isModernFilter"
                               @onchange="SetEraModern"
                               class="h-5 w-5 rounded border-primary-300 accent-accent-500" />
                        <span class="text-sm text-primary-700">Наши дни</span>
                    </label>
                </div>
            </div>
        </ChildContent>
    </FilterPanel>

    @if (!paginatedItems.Any())
    {
        <EmptyState
            Title="Предметы не найдены"
            Message="Попробуйте изменить параметры фильтра или добавить новый предмет."
            IconClass="fa-search" />
    }
    else
    {
        <ItemsListView
            Items="@paginatedItems"
            ExpandedItemId="@expandedItemId"
            ShowEra="@showEra"
            CurrentSortField="@sortField"
            SortAscending="@sortAscending"
            OnSortChanged="ToggleSort"
            OnEdit="ShowEditModal"
            OnDelete="ShowDeleteModal"
            OnToggleExpand="ToggleItemDetails" />

        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    TotalItems="filteredItems.Count()"
                    ItemsPerPage="itemsPerPage"
                    ItemsLabel="предметов"
                    OnPageChanged="GoToPage" />
    }
</div>

<!-- Modal for adding/editing items -->
<Modal IsVisible="showModal"
       OnClose="HideModal"
       Title="@(isEditMode ? "Редактировать предмет" : "Добавить предмет")"
       MaxWidth="4xl">
    <ChildContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-4 p-3 bg-red-100 text-red-700 rounded-lg border border-red-300 flex items-start">
                <i class="fas fa-exclamation-triangle text-red-500 mr-2 mt-0.5"></i>
                <span>@errorMessage</span>
            </div>
        }
        <EditForm Model="editItem" OnValidSubmit="HandleValidSubmit" Id="item-edit-form">
            <DataAnnotationsValidator/>
            <ValidationSummary class="mb-4 text-red-600"/>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="item-name" class="cm-field-label">Название *</label>
                    <InputText @bind-Value="editItem.Name" id="item-name"
                               class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50 focus:outline-none focus:ring-2 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"/>
                    <ValidationMessage For="@(() => editItem.Name)" class="text-red-600 text-sm mt-1"/>
                </div>

                <div>
                    <label for="item-type" class="cm-field-label">Тип</label>
                    <InputText @bind-Value="editItem.Type" id="item-type"
                               class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50 focus:outline-none focus:ring-2 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"/>
                    <ValidationMessage For="@(() => editItem.Type)" class="text-red-600 text-sm mt-1"/>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Эпоха *</label>
                    <div class="flex flex-wrap gap-4">
                        <div class="flex items-center">
                            <input type="checkbox" id="edit-era1920s" @bind="editItem1920"
                                   class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded"/>
                            <label for="edit-era1920s" class="ml-2 block text-sm text-gray-700">1920-е</label>
                        </div>
                        <div class="flex items-center">
                            <input type="checkbox" id="edit-eraModern" @bind="editItemModern"
                                   class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded"/>
                            <label for="edit-eraModern" class="ml-2 block text-sm text-gray-700">Наши дни</label>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label for="item-description"
                           class="cm-field-label">Описание</label>
                    <InputTextArea @bind-Value="editItem.Description" id="item-description" rows="4"
                                   class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50 focus:outline-none focus:ring-2 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"/>
                    <ValidationMessage For="@(() => editItem.Description)" class="text-red-600 text-sm mt-1"/>
                </div>

                <div class="md:col-span-2">
                    <label for="item-imageurl" class="cm-field-label">URL
                        изображения</label>
                    <InputText @bind-Value="editItem.ImageUrl" id="item-imageurl"
                               class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50 focus:outline-none focus:ring-2 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"/>
                    <ValidationMessage For="@(() => editItem.ImageUrl)" class="text-red-600 text-sm mt-1"/>
                </div>
            </div>
            <!-- Hidden submit button for form submission -->
            <button type="submit" @ref="itemFormSubmitButton" style="display:none;"></button>
        </EditForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="cm-btn cm-btn-secondary" @onclick="HideModal">
            <span>Отмена</span>
        </button>
        <button type="button" class="cm-btn cm-btn-primary" @onclick="SubmitItemForm">
            <span>@(isEditMode ? "Сохранить" : "Добавить")</span>
        </button>
    </FooterContent>
</Modal>

<!-- Modal for delete confirmation -->
<ConfirmationModal IsVisible="showDeleteModal"
                   OnConfirm="ConfirmDelete"
                   OnCancel="HideDeleteModal"
                   Title="Подтверждение удаления"
                   Message="@($"Вы уверены, что хотите удалить предмет \"{deleteItem?.Name}\"?")"
                   ConfirmText="Удалить"
                   IconType="error" />
