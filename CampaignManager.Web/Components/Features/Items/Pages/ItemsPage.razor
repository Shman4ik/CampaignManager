@page "/items"
@using CampaignManager.Web.Components.Features.Items.Components
@using CampaignManager.Web.Components.Features.Items.Model
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Предметы</PageTitle>

<PageHeader Title="Предметы">
    <Actions>
        @if (canEdit)
        {
            <Button Variant="primary" Size="sm" Icon="fa-plus" OnClick="ShowAddModal">Добавить</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel Title="Фильтры"
                 @bind-IsExpanded="isSearchPanelVisible" OnReset="ResetFilters">
        <ChildContent>
            @* Поиск, тип и два флажка — одной строкой: в портрете она переносится,
               в ландшафте занимает одну полосу вместо трёх. *@
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                @* Поля — штатный cm-input; ширину задают обёртки, а не утилиты на самом поле
                   (.cm-input прибит к width: 100%). *@
                <div class="min-w-[12rem] flex-1">
                    <input type="search" id="itemSearch"
                           value="@searchQuery"
                           @oninput="HandleSearchInput"
                           placeholder="Поиск предметов..."
                           aria-label="Поиск предметов"
                           class="cm-input" />
                </div>

                <div class="w-48 shrink-0">
                    <select id="itemType" @onchange="HandleTypeChanged" aria-label="Тип предмета" class="cm-input">
                        <option value="">Все типы</option>
                        @if (itemTypes is not null)
                        {
                            @foreach (var type in itemTypes)
                            {
                                <option value="@type" selected="@(selectedType == type)">@type</option>
                            }
                        }
                    </select>
                </div>

                <div class="flex flex-wrap items-center gap-x-4">
                    <label for="era1920s" class="flex min-h-[36px] cursor-pointer items-center gap-2">
                        <input type="checkbox" id="era1920s" checked="@is1920Filter"
                               @onchange="SetEra1920"
                               class="h-5 w-5 rounded border-primary-300 accent-accent-500" />
                        <span class="text-sm text-primary-700">1920-е</span>
                    </label>
                    <label for="eraModern" class="flex min-h-[36px] cursor-pointer items-center gap-2">
                        <input type="checkbox" id="eraModern" checked="@isModernFilter"
                               @onchange="SetEraModern"
                               class="h-5 w-5 rounded border-primary-300 accent-accent-500" />
                        <span class="text-sm text-primary-700">Наши дни</span>
                    </label>
                </div>
            </div>
        </ChildContent>
    </FilterPanel>

    @if (!paginatedItems.Any())
    {
        @if (canEdit)
        {
            <EmptyState
                Title="Предметы не найдены"
                Message="Попробуйте изменить параметры фильтра или добавить новый предмет."
                IconClass="fa-search">
                <ActionButton>
                    <Button Variant="primary" Icon="fa-plus" OnClick="ShowAddModal">Добавить предмет</Button>
                </ActionButton>
            </EmptyState>
        }
        else
        {
            @* Справочник правят только Хранитель и администратор — игроку «добавить» не предлагаем. *@
            <EmptyState
                Title="Предметы не найдены"
                Message="Попробуйте изменить параметры фильтра."
                IconClass="fa-search" />
        }
    }
    else
    {
        <ItemsListView
            Items="@paginatedItems"
            ExpandedItemId="@expandedItemId"
            ShowEra="@showEra"
            CanEdit="@canEdit"
            CurrentSortField="@sortField"
            SortAscending="@sortAscending"
            OnSortChanged="ToggleSort"
            OnEdit="ShowEditModal"
            OnDelete="ShowDeleteModal"
            OnToggleExpand="ToggleItemDetails" />

        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    TotalItems="filteredItems.Count()"
                    ItemsPerPage="itemsPerPage"
                    ItemsLabel="предметов"
                    OnPageChanged="GoToPage" />
    }
</div>

<!-- Modal for adding/editing items -->
<Modal IsVisible="showModal"
       OnClose="HideModal"
       Title="@(isEditMode ? "Редактировать предмет" : "Добавить предмет")"
       MaxWidth="4xl"
       HeaderColorScheme="primary">
    <ChildContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Type="error" ShowIcon>@errorMessage</Alert>
        }
        <EditForm Model="editItem" OnValidSubmit="HandleValidSubmit" Id="item-edit-form">
            <DataAnnotationsValidator/>
            <ValidationSummary/>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="item-name" class="cm-field-label">Название *</label>
                    <InputText @bind-Value="editItem.Name" id="item-name" class="cm-input"/>
                    <ValidationMessage For="@(() => editItem.Name)" class="text-error-600 text-sm mt-1"/>
                </div>

                <div>
                    <label for="item-type" class="cm-field-label">Тип</label>
                    <InputText @bind-Value="editItem.Type" id="item-type" class="cm-input"/>
                    <ValidationMessage For="@(() => editItem.Type)" class="text-error-600 text-sm mt-1"/>
                </div>

                <div class="md:col-span-2">
                    <div class="cm-field-label">Эпоха *</div>
                    @* Флажок — вся строка в 40px, попасть можно и по подписи. *@
                    <div class="flex flex-wrap gap-x-6">
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <input type="checkbox" @bind="editItem1920" class="cm-checkbox"/>
                            1920-е
                        </label>
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <input type="checkbox" @bind="editItemModern" class="cm-checkbox"/>
                            Наши дни
                        </label>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label for="item-description" class="cm-field-label">Описание</label>
                    <InputTextArea @bind-Value="editItem.Description" id="item-description" rows="4" class="cm-input"/>
                    <ValidationMessage For="@(() => editItem.Description)" class="text-error-600 text-sm mt-1"/>
                </div>

                <div class="md:col-span-2">
                    <label for="item-imageurl" class="cm-field-label">URL изображения</label>
                    <InputText @bind-Value="editItem.ImageUrl" id="item-imageurl" class="cm-input"/>
                    <ValidationMessage For="@(() => editItem.ImageUrl)" class="text-error-600 text-sm mt-1"/>
                </div>
            </div>
            <!-- Hidden submit button for form submission -->
            <button type="submit" @ref="itemFormSubmitButton" class="hidden"></button>
        </EditForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="cm-btn cm-btn-secondary" @onclick="HideModal">
            <span>Отмена</span>
        </button>
        <button type="button" class="cm-btn cm-btn-primary" @onclick="SubmitItemForm">
            <span>@(isEditMode ? "Сохранить" : "Добавить")</span>
        </button>
    </FooterContent>
</Modal>

<!-- Modal for delete confirmation -->
<ConfirmationModal IsVisible="showDeleteModal"
                   OnConfirm="ConfirmDelete"
                   OnCancel="HideDeleteModal"
                   Title="Подтверждение удаления"
                   Message="@($"Вы уверены, что хотите удалить предмет \"{deleteItem?.Name}\"?")"
                   ConfirmText="Удалить"
                   IconType="error" />
