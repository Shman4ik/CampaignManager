@using CampaignManager.Web.Components.Features.Items.Model
@using CampaignManager.Web.Components.Features.Items.Services
@using CampaignManager.Web.Components.Shared
@namespace CampaignManager.Web.Components.Features.Items.Components

<div class="cm-card overflow-hidden">
    @* Таблица — от md (768) и шире; уже — карточки.
       Четыре колонки помещаются и в портрет iPad (1024), поэтому порог здесь ниже,
       чем у каталога оружия: там колонок девять и таблица требует xl.
       Раскрытая строка не повторяет колонки — в ней только то, чего в них нет. *@
    <div class="hidden md:block overflow-x-auto it-table">
        <table class="cm-table">
            <thead>
            <tr>
                <SortableTableHeader Title="Название" FieldName="@nameof(Item.Name)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <SortableTableHeader Title="Тип" FieldName="@nameof(Item.Type)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <th>Описание</th>
                @if (CanEdit)
                {
                    <th><span class="sr-only">Действия</span></th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Items)
            {
                var canExpand = CanExpand(item);
                <tr class="@(ExpandedItemId == item.Id ? "it-row-open" : null) @(canExpand ? "cursor-pointer" : null)"
                    @onclick="() => ToggleAsync(item)">
                    <td>
                        <div class="flex items-center gap-1.5">
                            @* Стрелка — только у строки, которой есть что раскрыть; у остальных
                               пустое место той же ширины, чтобы названия стояли ровно. *@
                            <i class="fas @(ExpandedItemId == item.Id ? "fa-caret-down" : "fa-caret-right") w-2 text-center @(canExpand ? "text-primary-300" : "invisible")"></i>
                            <span class="font-semibold text-gray-900">@item.Name</span>
                            @if (ShowEra)
                            {
                                <Badge Variant="secondary" Size="sm" Rounded="md">@ItemEraText.Describe(item.Era)</Badge>
                            }
                        </div>
                    </td>
                    <td class="text-primary-500">@TypeOrDash(item)</td>
                    <td class="it-desc text-primary-500">@item.Description</td>
                    @if (CanEdit)
                    {
                        <td @onclick:stopPropagation="true">
                            <div class="flex justify-end gap-1">
                                <button type="button" aria-label="Изменить: @item.Name"
                                        class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary"
                                        @onclick="() => OnEdit.InvokeAsync(item)">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button type="button" aria-label="Удалить: @item.Name"
                                        class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error"
                                        @onclick="() => OnDelete.InvokeAsync(item)">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </td>
                    }
                </tr>

                @* Строка деталей — только под картинку: длинное описание раскрывается на месте,
                   в самой ячейке (.it-row-open > .it-desc), а эпоха — бейдж у названия. *@
                @if (ExpandedItemId == item.Id && !string.IsNullOrEmpty(item.ImageUrl))
                {
                    <tr class="it-details">
                        <td colspan="@ColumnCount">
                            <span class="it-label">Изображение</span>
                            <img src="@item.ImageUrl" alt="@item.Name" class="it-image" />
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @* Карточки ниже md: название, тип и начало описания в строке, остальное — по раскрытию. *@
    <div class="divide-y divide-primary-100 md:hidden">
        @foreach (var item in Items)
        {
            var canExpand = CanExpand(item);
            <div class="px-3 py-2">
                <div class="flex items-start gap-2">
                    <div class="min-w-0 flex-1 @(canExpand ? "cursor-pointer" : null)" @onclick="() => ToggleAsync(item)">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <i class="fas @(ExpandedItemId == item.Id ? "fa-caret-down" : "fa-caret-right") w-2 text-center @(canExpand ? "text-primary-300" : "invisible")"></i>
                            <span class="font-semibold text-gray-900">@item.Name</span>
                            @if (ShowEra)
                            {
                                <Badge Variant="secondary" Size="sm" Rounded="md">@ItemEraText.Describe(item.Era)</Badge>
                            }
                        </div>
                        <div class="ml-4 mt-0.5 text-xs text-primary-500 @(ExpandedItemId == item.Id ? null : "truncate")">
                            <span>@TypeOrDash(item)</span>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <span class="mx-1 text-primary-300">·</span>
                                <span class="@(ExpandedItemId == item.Id ? "whitespace-pre-wrap" : null)">@item.Description</span>
                            }
                        </div>
                    </div>
                    @if (CanEdit)
                    {
                        <button type="button" aria-label="Изменить: @item.Name"
                                class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary flex-shrink-0"
                                @onclick="() => OnEdit.InvokeAsync(item)">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button type="button" aria-label="Удалить: @item.Name"
                                class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error flex-shrink-0"
                                @onclick="() => OnDelete.InvokeAsync(item)">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    }
                </div>

                @if (ExpandedItemId == item.Id && !string.IsNullOrEmpty(item.ImageUrl))
                {
                    <dl class="it-card-details">
                        <dt>Изображение</dt>
                        <dd><img src="@item.ImageUrl" alt="@item.Name" class="it-image" /></dd>
                    </dl>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Item> Items { get; set; } = [];
    [Parameter] public Guid? ExpandedItemId { get; set; }

    /// <summary>Показывать метку эпохи в строке: смысл есть, только когда список не сужен до одной эпохи.</summary>
    [Parameter] public bool ShowEra { get; set; }

    /// <summary>
    ///     Кнопки «Изменить/Удалить». Без права правки колонка действий пропадает целиком,
    ///     а не остаётся пустой полосой справа.
    /// </summary>
    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public string? CurrentSortField { get; set; }
    [Parameter] public bool SortAscending { get; set; }
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    [Parameter] public EventCallback<Item> OnEdit { get; set; }
    [Parameter] public EventCallback<Item> OnDelete { get; set; }
    [Parameter] public EventCallback<Item> OnToggleExpand { get; set; }

    // Название, тип, описание — всегда; действия — только с правом правки.
    private int ColumnCount => CanEdit ? 4 : 3;

    private static string TypeOrDash(Item item) => string.IsNullOrEmpty(item.Type) ? "—" : item.Type;

    /// <summary>
    ///     С какой длины описание в строке обрезается многоточием. Колонка описания — 55% таблицы;
    ///     на портрете iPad (самая узкая таблица) в неё входит около 60 знаков.
    /// </summary>
    private const int ClippedDescriptionLength = 60;

    // Раскрывать есть что только у предмета с картинкой или с описанием длиннее строки:
    // эпоха — бейдж у названия (а при фильтре по одной эпохе её называет сам фильтр), тип
    // и короткое описание уже видны. Раньше раскрытие у большинства предметов показывало
    // одну эпоху либо фразу «всё уже показано в строке» — лишний клик ради ничего.
    private static bool CanExpand(Item item) =>
        !string.IsNullOrEmpty(item.ImageUrl)
        || (item.Description?.Length ?? 0) > ClippedDescriptionLength;

    private Task ToggleAsync(Item item) =>
        CanExpand(item) || ExpandedItemId == item.Id
            ? OnToggleExpand.InvokeAsync(item)
            : Task.CompletedTask;
}
