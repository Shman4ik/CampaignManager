@using CampaignManager.Web.Components.Features.Bestiary.Model
@using CampaignManager.Web.Extensions
@inject NavigationManager NavigationManager

@* Статблок существа. Короткие числа (СИЛ…МОЩ, ПЗ, ПМ) идут сеткой, число колонок которой
   считает сама ширина (.cr-stats, auto-fill), а строки с оговорками — бонус к урону,
   скорость, атаки за раунд, броня, потеря рассудка — каждая во всю ширину карточки.
   Раньше всё лежало в grid-cols-2 внутри колонки 2/3 карточки, и на портрете iPad
   (где список тогда уже шёл в две колонки) «Атак за раунд: 2 (может схватить…)»
   рвалось на восемь строк, а левая и правая половины статблока разъезжались по высоте. *@
<div class="cm-card overflow-hidden hover:shadow-md transition-shadow">
    <div class="cm-card-header flex-wrap">
        <span class="cm-card-title truncate">@Creature.Name</span>
        <div class="flex flex-wrap gap-1 flex-shrink-0">
            <Button Variant="outline-primary" Size="sm" Icon="fa-edit" OnClick="() => EditCreature(Creature)">Изменить</Button>
            <Button Variant="outline-error" Size="sm" Icon="fa-trash-alt" OnClick="() => OnDelete.InvokeAsync(Creature)">Удалить</Button>
        </div>
    </div>
    <div class="cm-card-body">
        <div class="mb-3">
            <Badge Variant="info" Size="sm" Rounded="full" WithBorder="false">
                @Creature.Type.ToRussianString()
            </Badge>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mb-3">
            <div class="flex-1 min-w-0">
                <h3 class="cm-section-title mb-1">Характеристики</h3>
                <div class="cr-stats text-sm">
                    @foreach (var stat in ShortStats)
                    {
                        <CharacteristicItem Label="@stat.Label" Value="@stat.Value" DiceRoll="@stat.DiceRoll"/>
                    }
                </div>
            </div>

            @* Первая картинка — обложка; остальные тапом по миниатюре, а не по наведению:
               на iPad за столом наведения нет. *@
            @if (Creature.Images.Count > 0)
            {
                var shown = Creature.Images[Math.Min(_imageIndex, Creature.Images.Count - 1)];
                <div class="sm:w-40 shrink-0 flex flex-col items-center gap-2">
                    <img src="@CreatureImage.ToSrc(shown.Url)" alt="@(shown.Caption ?? Creature.Name)"
                         class="max-w-full h-auto max-h-40 object-contain rounded" loading="lazy"/>
                    @if (!string.IsNullOrWhiteSpace(shown.Caption))
                    {
                        <span class="text-xs text-gray-500 text-center">@shown.Caption</span>
                    }
                    @if (Creature.Images.Count > 1)
                    {
                        <div class="flex flex-wrap justify-center gap-1">
                            @for (var i = 0; i < Creature.Images.Count; i++)
                            {
                                var index = i;
                                var image = Creature.Images[index];
                                <button type="button"
                                        class="h-11 w-11 rounded border overflow-hidden @(index == _imageIndex ? "border-accent-500 ring-2 ring-accent-500/30" : "border-gray-200")"
                                        aria-label="@($"Картинка {index + 1}: {image.Caption ?? Creature.Name}")"
                                        @onclick="() => _imageIndex = index">
                                    <img src="@CreatureImage.ToSrc(image.Url)" alt="" class="h-full w-full object-cover" loading="lazy"/>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (StatLines.Count > 0)
        {
            <dl class="text-sm space-y-0.5 mb-3">
                @foreach (var line in StatLines)
                {
                    <div>
                        <dt class="inline font-medium">@line.Label:</dt>
                        <dd class="inline">@line.Value</dd>
                    </div>
                }
            </dl>
        }

        <div class="mt-4 text-sm">
            <h3 class="cm-section-title mb-1">Описание</h3>
            <p class="cm-text-muted">
                @(string.IsNullOrEmpty(Creature.Description)
                    ? "Описание отсутствует."
                    : Creature.Description)
            </p>
        </div>

        @if (Creature.SpecialAbilities.Count > 0)
        {
            <div class="mt-4">
                <h3 class="cm-section-title mb-1">Особые умения</h3>
                <div class="text-sm text-gray-700">
                    @foreach (var ability in Creature.SpecialAbilities)
                    {
                        <div class="mb-1"><span class="font-semibold">@ability.Key:</span> @ability.Value</div>
                    }
                </div>
            </div>
        }

        @if (Creature.Skills.Count > 0)
        {
            <div class="mt-4">
                <h3 class="cm-section-title mb-1">Навыки</h3>
                <div class="text-sm text-gray-700">
                    @string.Join(", ", Creature.Skills.Select(FormatSkill))
                </div>
            </div>
        }

        @if (Creature.Attacks.Count > 0)
        {
            <div class="mt-4">
                <h3 class="cm-section-title mb-1">Атаки</h3>
                <div class="text-sm text-gray-700 space-y-1">
                    @foreach (var attack in Creature.Attacks)
                    {
                        @* Строка как в книге: «Ближний бой 60% (30/12), урон 2d6 + БкУ» (стр. 278) *@
                        <div class="mb-1">
                            <span class="font-semibold">@attack.Name</span>
                            <span class="text-gray-600">
                                @if (attack.SkillValue > 0)
                                {
                                    @($"{attack.SkillValue}% ({attack.SkillValue / 2}/{attack.SkillValue / 5}), урон {FormatDamage(attack)}")
                                }
                                else
                                {
                                    @* Особая атака без процента решается встречной проверкой или срабатывает сама. *@
                                    @("без броска, см. описание")
                                }
                            </span>
                            @if (attack.Kind is not CreatureAttackKind.Melee)
                            {
                                <span class="ml-1">
                                    <Badge Variant="secondary" Size="sm" Rounded="full" WithBorder="false">@KindLabel(attack.Kind)</Badge>
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(attack.Description))
                            {
                                <span class="text-gray-500 block ml-4">@attack.Description</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public required Creature Creature { get; set; }

    [Parameter] public EventCallback<Creature> OnDelete { get; set; }

    private int _imageIndex;

    /// <summary>Короткие числа статблока — идут сеткой.</summary>
    private List<(string Label, object? Value, string? DiceRoll)> ShortStats { get; set; } = [];

    /// <summary>Строки статблока с оговорками — каждая во всю ширину.</summary>
    private List<(string Label, string Value)> StatLines { get; set; } = [];

    protected override void OnParametersSet()
    {
        var c = Creature.CreatureCharacteristics;
        List<(string Label, object? Value, string? DiceRoll)> shortStats =
        [
            ("СИЛ", c.Strength?.Value, c.Strength?.DiceRoll),
            ("ВЫН", c.Constitution?.Value, c.Constitution?.DiceRoll),
            ("ТЕЛ", c.Size?.Value, c.Size?.DiceRoll),
            ("ЛВК", c.Dexterity?.Value, c.Dexterity?.DiceRoll),
            ("ИНТ", c.Intelligence?.Value, c.Intelligence?.DiceRoll),
            ("МОЩ", c.Power?.Value, c.Power?.DiceRoll),
            ("ПЗ", c.HealPoint, null),
            ("ПМ", c.ManaPoint, null)
        ];
        ShortStats = [.. shortStats.Where(s => !string.IsNullOrWhiteSpace(s.Value?.ToString()))];

        List<(string Label, string? Value)> lines =
        [
            ("Ср. бонус к урону", NullIfEmpty(c.AverageDamageBonus)),
            ("Ср. комплекция", c.AverageComplexity.ToString()),
            ("Скорость", FormatSpeed(c)),
            ("Атак за раунд", FormatAttacksPerRound(c)),
            ("Броня", FormatArmor(c)),
            ("Уклонение", c.DodgeSkill > 0 ? $"{c.DodgeSkill}%" : null),
            ("Потеря рассудка", NullIfEmpty(c.SanityLoss))
        ];
        StatLines = [.. lines.Where(l => !string.IsNullOrWhiteSpace(l.Value)).Select(l => (l.Label, l.Value!))];
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private static string FormatSkill(CreatureSkill skill) =>
        string.IsNullOrWhiteSpace(skill.Note)
            ? $"{skill.Name} {skill.Value}%"
            : $"{skill.Name} {skill.Value}% ({skill.Note})";

    private static string KindLabel(CreatureAttackKind kind) => kind switch
    {
        CreatureAttackKind.Ranged => "дальний бой",
        CreatureAttackKind.Maneuver => "манёвр",
        CreatureAttackKind.Special => "особая",
        _ => "ближний бой"
    };

    // «урон равен БкУ» книга печатает именно так — своих костей у такой атаки нет (стр. 306).
    private static string FormatDamage(CreatureAttack attack) => attack.DamageBonus switch
    {
        CreatureDamageBonusMode.OnlyBonus => "равен БкУ",
        CreatureDamageBonusMode.Full => $"{attack.DamageFormula} + БкУ",
        CreatureDamageBonusMode.Half => $"{attack.DamageFormula} + ½ БкУ",
        _ => attack.DamageFormula
    };

    // Книга пишет скорость по способам передвижения: «8 / плавание 10», «6 / полёт 20» (стр. 280).
    private static string? FormatSpeed(CreatureCharacteristics c)
    {
        if (!string.IsNullOrWhiteSpace(c.SpeedNote)) return c.SpeedNote;
        if (c.Speed <= 0 && c.SwimSpeed is null && c.FlySpeed is null) return null;

        var parts = new List<string> { c.Speed.ToString() };
        if (c.SwimSpeed is { } swim) parts.Add($"плавание {swim}");
        if (c.FlySpeed is { } fly) parts.Add($"полёт {fly}");
        return string.Join(" / ", parts);
    }

    private static string? FormatAttacksPerRound(CreatureCharacteristics c) =>
        string.IsNullOrWhiteSpace(c.AttacksPerRoundNote)
            ? (c.AttacksPerRound > 0 ? c.AttacksPerRound.ToString() : null)
            : $"{c.AttacksPerRound} ({c.AttacksPerRoundNote})";

    // «Броня: нет» у книги часто идёт вместе с оговоркой, которая и есть настоящая защита,
    // поэтому ноль без примечания показываем как «нет», а не прячем (стр. 280).
    private static string? FormatArmor(CreatureCharacteristics c)
    {
        var note = string.IsNullOrWhiteSpace(c.ArmorNote) ? null : c.ArmorNote;
        if (c.Armor > 0) return note is null ? $"{c.Armor}" : $"{c.Armor} — {note}";
        return note ?? "нет";
    }

    // Редактирование существа
    private void EditCreature(Creature creature)
    {
        NavigationManager.NavigateTo($"/bestiary/creatures/edit/{creature.Id}");
    }

}
