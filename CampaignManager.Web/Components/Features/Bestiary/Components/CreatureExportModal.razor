@namespace CampaignManager.Web.Components.Features.Bestiary.Components
@using CampaignManager.Web.Components.Features.Bestiary.Services
@inject CreatureImportService CreatureImportService
@inject IJSRuntime JS
@inject ILogger<CreatureExportModal> Logger

<Modal IsVisible="_isVisible"
       OnClose="Hide"
       Title="@(_single ? "Экспорт существа в JSON" : "Экспорт бестиария в JSON")"
       MaxWidth="4xl"
       HeaderColorScheme="primary">
    <ChildContent>
        <div class="space-y-4">
            <Alert Type="info" Title="Обменный формат">
                Этот JSON принимает кнопка «Импорт JSON» на странице бестиария — на этой же платформе
                или на другой. Поправьте статблок и вставьте обратно: существо обновится по названию.
            </Alert>

            @if (_isLoading)
            {
                <LoadingIndicator/>
            }
            else
            {
                <textarea class="cm-input font-mono text-xs" rows="20" readonly>@_json</textarea>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <Button ButtonType="button" OnClick="Hide" Variant="secondary">Закрыть</Button>
            <Button ButtonType="button" OnClick="CopyToClipboard" Variant="primary"
                    IsDisabled="@(_isLoading || string.IsNullOrEmpty(_json))">
                @(_copied ? "Скопировано" : "Скопировать")
            </Button>
        </div>
    </FooterContent>
</Modal>

@code {

    private bool _isVisible;
    private bool _isLoading;
    private bool _copied;
    private bool _single;
    private string? _json;

    /// <summary>Без аргумента — весь бестиарий, с идентификатором — одно существо.</summary>
    public async Task Show(Guid? creatureId = null)
    {
        _isVisible = true;
        _isLoading = true;
        _copied = false;
        _single = creatureId is not null;
        _json = null;
        StateHasChanged();

        _json = await CreatureImportService.ExportAsync(creatureId is { } id ? [id] : null);

        _isLoading = false;
        StateHasChanged();
    }

    public void Hide()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task CopyToClipboard()
    {
        if (string.IsNullOrEmpty(_json)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _json);
            _copied = true;
        }
        catch (JSException ex)
        {
            // Буфер обмена недоступен (нет https или отказ браузера) — текст всё равно виден в поле.
            Logger.LogWarning(ex, "Clipboard write failed for bestiary export");
        }
    }

}
