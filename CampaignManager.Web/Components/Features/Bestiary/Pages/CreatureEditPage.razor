@page "/bestiary/creatures/edit/{Id:guid?}"
@using CampaignManager.Web.Components.Features.Bestiary.Components
@using CampaignManager.Web.Components.Features.Bestiary.Model
@using CampaignManager.Web.Components.Features.Bestiary.Services
@using CampaignManager.Web.Components.Features.Wiki.Components
@using CampaignManager.Web.Extensions
@using CampaignManager.Web.Utilities.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator,GameMaster")]

@inject NavigationManager NavigationManager
@inject CreatureService CreatureService
@inject MinioService MinioService
@inject ILogger<CreatureEditPage> Logger

@rendermode InteractiveServer

<PageTitle>@pageTitle</PageTitle>

<PageHeader Title="@pageTitle">
    <Actions>
        @if (Id.HasValue)
        {
            <Button Variant="secondary" Size="sm" Icon="fa-file-export" OnClick="ShowExport">JSON</Button>
        }
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="Cancel">
            <span>Отмена</span>
        </button>
        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="Save">
            <span>Сохранить</span>
        </button>
    </Actions>
</PageHeader>

<div class="cm-page">
    @if (!string.IsNullOrEmpty(saveError))
    {
        <Alert Type="error" Title="Не сохранено">@saveError</Alert>
    }
    @if (isLoading)
    {
        <LoadingIndicator/>
    }
    else
    {
        <div class="cm-card">
            <div class="cm-card-body">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label for="name" class="cm-field-label">Название</label>
                    <input id="name" type="text" @bind="creature.Name"
                           class="cm-input w-full"/>
                </div>

                <div>
                    <label for="type" class="cm-field-label">Тип</label>
                    <select id="type" @bind="creature.Type"
                            class="cm-input w-full">
                        @foreach (var type in EnumExtensions.GetEnumTypes<CreatureType>())
                        {
                            <option value="@type">@type.ToRussianString()</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-6">
                <label for="description" class="cm-field-label">Описание</label>
                <textarea id="description" @bind="creature.Description" rows="4"
                          class="cm-input w-full"></textarea>
            </div>

            @* Картинок может быть несколько: формы оборотня и шоггота-владыки, облик бога и аватара,
               тварь рядом с человеком для масштаба. Первая — обложка карточки. *@
            <div class="cm-section-header"><span class="cm-section-title">Иллюстрации</span></div>
            <div class="mb-6">
                @foreach (var image in images)
                {
                    var index = images.IndexOf(image);
                    <div class="flex flex-wrap items-start gap-3 py-3 border-t border-t-gray-200 first:border-t-0">
                        <div class="h-24 w-24 shrink-0 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(image.Url))
                            {
                                <img src="@CreatureImage.ToSrc(image.Url)" alt="@(image.Caption ?? creature.Name)"
                                     class="h-full w-full object-contain"/>
                            }
                            else
                            {
                                <i class="fas fa-image text-gray-300 text-2xl"></i>
                            }
                        </div>
                        <div class="flex-1 min-w-[14rem] space-y-2">
                            <div>
                                <label class="cm-field-label">Файл в хранилище или ссылка https://</label>
                                <AutocompleteMinioImage @bind-Value="image.Url"/>
                            </div>
                            <div>
                                <label class="cm-field-label">Подпись</label>
                                <input type="text" @bind="image.Caption" placeholder="форма шоггота"
                                       class="cm-input w-full"/>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-1">
                            @if (index == 0)
                            {
                                <Badge Variant="info" Size="sm" Rounded="full" WithBorder="false">обложка</Badge>
                            }
                            else
                            {
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm"
                                        @onclick="() => MoveImageToFront(image)">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>Обложкой</span>
                                </button>
                            }
                            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm"
                                    aria-label="@($"Убрать картинку {index + 1}")" @onclick="() => RemoveImage(image)">
                                <i class="fas fa-trash-alt"></i><span>Удалить</span>
                            </button>
                        </div>
                    </div>
                }

                <div class="flex flex-wrap items-center gap-2 mt-3">
                    <label for="imageUpload" class="cm-btn cm-btn-secondary cm-btn-sm cursor-pointer">
                        <i class="fas fa-upload"></i>
                        <span>Загрузить файлы…</span>
                    </label>
                    <InputFile id="imageUpload" OnChange="UploadImages" accept="image/*" multiple class="hidden"/>
                    <Button Variant="secondary" Size="sm" Icon="fa-link" OnClick="AddImage">Добавить по ссылке</Button>
                    @if (isUploadingImage)
                    {
                        <span class="cm-text-sm text-gray-500">Загрузка…</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(uploadError))
                {
                    <Alert Type="error" Small="true" class="mt-2">@uploadError</Alert>
                }
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Характеристики</span></div>
            @* Значение и бросок — одна строка на характеристику: так их печатает книга
               («СИЛ 90, бросок (1d6+6)×5»), и вдвое ниже, чем в два этажа.
               Ширину задают обёртки, а не классы на самом поле: .cm-input прибит к
               width:100%, и тейлвиндовские w-* до него не достают. *@
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-4 gap-y-2 mb-6">
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Сила</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Strength.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Strength.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Ловкость</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Dexterity.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Dexterity.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Интеллект</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Intelligence.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Intelligence.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Выносливость</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Constitution.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Constitution.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Мощь</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Power.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Power.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Телосложение</label>
                    <div class="w-20 shrink-0">
                        <input type="number" @bind="creature.CreatureCharacteristics.Size.Value" class="cm-input"/>
                    </div>
                    <div class="flex-1 min-w-0">
                        <input type="text" @bind="creature.CreatureCharacteristics.Size.DiceRoll"
                               placeholder="3d6×5" class="cm-input"/>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-4 mb-4">
                <div>
                    <label class="cm-field-label">Ср. бонус к урону</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.AverageDamageBonus"
                           placeholder="+2d6" class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Ср. комплекция</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.AverageComplexity"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">ПЗ</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.HealPoint"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">ПМ</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.ManaPoint"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Уклонение</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.DodgeSkill"
                           class="cm-input w-full"/>
                </div>
            </div>

            @* Дальше — по строкам статблока: у книги скорость, число атак и броня идут
               одной строкой вместе со своими оговорками, поэтому и правятся вместе. *@
            <div class="space-y-3 mb-6">
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Скорость</label>
                        <div class="w-20 shrink-0">
                            <input type="number" @bind="creature.CreatureCharacteristics.Speed"
                                   class="cm-input" aria-label="Скорость"/>
                        </div>
                        <span class="text-sm text-gray-400">/ плавание</span>
                        <div class="w-20 shrink-0">
                            <input type="number" @bind="creature.CreatureCharacteristics.SwimSpeed"
                                   placeholder="—" class="cm-input" aria-label="Скорость плавания"/>
                        </div>
                        <span class="text-sm text-gray-400">/ полёт</span>
                        <div class="w-20 shrink-0">
                            <input type="number" @bind="creature.CreatureCharacteristics.FlySpeed"
                                   placeholder="—" class="cm-input" aria-label="Скорость полёта"/>
                        </div>
                        <div class="flex-1 min-w-[12rem]">
                            <input type="text" @bind="creature.CreatureCharacteristics.SpeedNote"
                                   placeholder="словами: перекатывание 10"
                                   class="cm-input" aria-label="Скорость словами"/>
                        </div>
                    </div>
                    <p class="cm-field-note">
                        Пустое плавание — половина обычной скорости, пустой полёт — летать существо не умеет (стр. 141).
                    </p>
                </div>

                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Атак за раунд</label>
                        <div class="w-20 shrink-0">
                            <input type="number" min="1" @bind="creature.CreatureCharacteristics.AttacksPerRound"
                                   class="cm-input" aria-label="Атак за раунд"/>
                        </div>
                        <div class="flex-1 min-w-[12rem]">
                            <input type="text" @bind="creature.CreatureCharacteristics.AttacksPerRoundNote"
                                   placeholder="оговорка: максимум 1 укус за раунд"
                                   class="cm-input" aria-label="Оговорка к числу атак"/>
                        </div>
                    </div>
                    <p class="cm-field-note">
                        Столько же защит за раунд, прежде чем враги получат бонусную кость (стр. 279).
                    </p>
                </div>

                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Броня</label>
                        <div class="w-20 shrink-0">
                            <input type="number" @bind="creature.CreatureCharacteristics.Armor"
                                   class="cm-input" aria-label="Броня в пунктах"/>
                        </div>
                        <div class="flex-1 min-w-[12rem]">
                            <input type="text" @bind="creature.CreatureCharacteristics.ArmorNote"
                                   placeholder="словами: огнестрел наносит минимальный урон"
                                   class="cm-input" aria-label="Броня словами"/>
                        </div>
                    </div>
                    <p class="cm-field-note">
                        «Броня: нет» у книги часто идёт с оговоркой — она и есть настоящая защита.
                    </p>
                </div>

                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <label class="cm-field-label cm-field-label-inline w-28 shrink-0">Потеря рассудка</label>
                        <div class="w-28 shrink-0">
                            <input type="text" @bind="creature.CreatureCharacteristics.SanityLoss"
                                   placeholder="0/1d6" class="cm-input" aria-label="Потеря рассудка"/>
                        </div>
                    </div>
                    <p class="cm-field-note">
                        Успех/провал. Предел привыкания к ужасному:
                        @(SanityLossFormula.MaxLoss(creature.CreatureCharacteristics.SanityLoss)) пунктов (стр. 167).
                    </p>
                </div>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Навыки</span></div>
            <div class="mb-6 space-y-2">
                @foreach (var skill in skills)
                {
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-2 items-end p-2 border rounded-lg">
                        <div class="md:col-span-4">
                            <label class="cm-field-label">Название</label>
                            <input type="text" @bind="skill.Name" placeholder="Скрытность" class="cm-input w-full"/>
                        </div>
                        <div class="md:col-span-2">
                            <label class="cm-field-label">%</label>
                            <input type="number" min="1" max="100" @bind="skill.Value" class="cm-input w-full"/>
                        </div>
                        <div class="md:col-span-4">
                            <label class="cm-field-label">Уточнение</label>
                            <input type="text" @bind="skill.Note" placeholder="в воде 80%" class="cm-input w-full"/>
                        </div>
                        @* «Удалить строку» во всех трёх списках формы — навыки, атаки, умения —
                           одна и та же подписанная кнопка: голая корзина на планшете ничего не говорит. *@
                        <div class="md:col-span-2 flex justify-end">
                            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm"
                                    aria-label="@($"Удалить навык {skill.Name}")" @onclick="() => RemoveSkill(skill)">
                                <i class="fas fa-trash-alt"></i><span>Удалить</span>
                            </button>
                        </div>
                    </div>
                }
                <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddSkill" AdditionalClasses="mt-2">Добавить навык</Button>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Атаки</span></div>
            <div class="mb-6 space-y-3">
                @foreach (var attack in attacks)
                {
                    <div class="p-3 border rounded-lg space-y-2">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                            <div class="md:col-span-2">
                                <label class="block text-xs font-medium text-gray-600">Название</label>
                                <input type="text" @bind="attack.Name" placeholder="Ужасная жадная пасть"
                                       class="cm-input w-full"/>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Навык %</label>
                                <input type="number" @bind="attack.SkillValue" min="1" max="100"
                                       class="cm-input w-full"/>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Урон</label>
                                <input type="text" @bind="attack.DamageFormula" placeholder="1D8"
                                       class="cm-input w-full"/>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Вид</label>
                                <select value="@attack.Kind"
                                        @onchange="e => SetAttackKind(attack, e.Value?.ToString())"
                                        class="cm-input w-full">
                                    <option value="@CreatureAttackKind.Melee">Ближний бой</option>
                                    <option value="@CreatureAttackKind.Ranged">Дальний бой</option>
                                    <option value="@CreatureAttackKind.Maneuver">Манёвр</option>
                                    <option value="@CreatureAttackKind.Special">Особая</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Бонус к урону</label>
                                <select value="@attack.DamageBonus"
                                        @onchange="e => SetDamageBonus(attack, e.Value?.ToString())"
                                        class="cm-input w-full">
                                    <option value="@CreatureDamageBonusMode.None">не добавляется</option>
                                    <option value="@CreatureDamageBonusMode.Full">+ БкУ</option>
                                    <option value="@CreatureDamageBonusMode.Half">+ ½ БкУ</option>
                                    <option value="@CreatureDamageBonusMode.OnlyBonus">урон равен БкУ</option>
                                </select>
                            </div>
                            <div class="md:col-span-2 flex items-end justify-end">
                                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm"
                                        aria-label="@($"Удалить атаку {attack.Name}")"
                                        @onclick="() => RemoveAttack(attack)">
                                    <i class="fas fa-trash-alt"></i><span>Удалить</span>
                                </button>
                            </div>
                        </div>
                        @* Книга описывает особые атаки целым абзацем (проглатывание, гипноз,
                           вытягивание СИЛ), поэтому строка в одну линию не годится. *@
                        <div>
                            <label class="block text-xs font-medium text-gray-600">Описание эффектов</label>
                            <textarea @bind="attack.Description" rows="3"
                                      placeholder="Яд, захват, встречная проверка СИЛ и т.д."
                                      class="cm-input w-full resize-y"></textarea>
                        </div>
                    </div>
                }
                <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddAttack" AdditionalClasses="mt-2">Добавить атаку</Button>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Особые умения</span></div>
            <div class="space-y-3">
                @foreach (var ability in specialAbilities)
                {
                    <div class="flex space-x-3 items-start p-3 border rounded-lg">
                        <div class="flex-1 space-y-1">
                            <label class="block text-xs font-medium text-gray-600">Название</label>
                            <input type="text" @bind="ability.KeyText" placeholder="Название умения"
                                   class="cm-input w-full"/>
                        </div>
                        <div class="flex-1 space-y-1">
                            <label class="block text-xs font-medium text-gray-600">Описание</label>
                            <textarea @bind="ability.ValueText" rows="3"
                                      placeholder="Описание умения"
                                      class="cm-input w-full"></textarea>
                        </div>
                        <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm mt-5 shrink-0"
                                aria-label="@($"Удалить умение {ability.KeyText}")"
                                @onclick="() => RemoveSpecialAbility(ability)">
                            <i class="fas fa-trash-alt"></i><span>Удалить</span>
                        </button>
                    </div>
                }
                <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddSpecialAbility" AdditionalClasses="mt-2">Добавить особое умение</Button>
            </div>

            @* Текст статблока в том виде, в каком его залили из книги. Поля выше разобраны
               именно из него, поэтому он остаётся под рукой для сверки, но не редактируется:
               источник правды — разобранные поля. *@
            @if (creature.CombatDescriptions.Count > 0)
            {
                <details class="mt-6 border border-gray-200 rounded-lg">
                    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-semibold text-gray-700">
                        Исходный текст из книги (@creature.CombatDescriptions.Count @Plural(creature.CombatDescriptions.Count))
                    </summary>
                    <div class="px-3 pb-3 pt-1 text-sm text-gray-600 space-y-1.5">
                        <p class="text-xs text-gray-500">
                            Поля выше разобраны из этих строк. Правьте поля — здесь только сверка.
                        </p>
                        @foreach (var line in creature.CombatDescriptions.OrderBy(kv => kv.Key, StringComparer.CurrentCulture))
                        {
                            <div>
                                <span class="font-semibold text-gray-800">@line.Key:</span>
                                <span>@line.Value</span>
                            </div>
                        }
                    </div>
                </details>
            }
            </div>
        </div>
    }

    @if (Id.HasValue)
    {
        <EditHistoryPanel EntityType="Creature" EntityId="Id.Value"/>
    }
</div>

<CreatureExportModal @ref="exportModal"/>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Creature creature = new()
    {
        Name = string.Empty,
        CreatureCharacteristics = new CreatureCharacteristics
        {
            Strength = new CreatureCharacteristicModel(),
            Dexterity = new CreatureCharacteristicModel(),
            Intelligence = new CreatureCharacteristicModel(),
            Constitution = new CreatureCharacteristicModel(),
            Power = new CreatureCharacteristicModel(),
            Size = new CreatureCharacteristicModel()
        }
    };

    private List<CreatureAttack> attacks = [];
    private List<CreatureSkill> skills = [];
    private List<DictionaryEntry> specialAbilities = new();
    private bool isLoading = true;
    private string pageTitle = "Новое существо";
    private List<CreatureImage> images = [];
    private bool isUploadingImage;
    private string? uploadError;
    private string? saveError;
    private CreatureExportModal? exportModal;
    private Guid? _lastLoadedId;
    private bool _hasLoadedOnce;

    private class DictionaryEntry
    {
        public string KeyText { get; set; } = string.Empty;
        public string ValueText { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Сравнивать только Id нельзя: у нового существа он null, как и _lastLoadedId,
        // поэтому первый заход не грузил данные и страница навсегда оставалась в isLoading.
        if (!_hasLoadedOnce || Id != _lastLoadedId)
        {
            _hasLoadedOnce = true;
            _lastLoadedId = Id;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        pageTitle = Id.HasValue ? "Редактирование существа" : "Создание существа";
        isLoading = true;

        // Always ensure our creature characteristics are initialized to prevent null references
        EnsureCreatureCharacteristicsInitialized();

        if (Id.HasValue && Id != Guid.Empty)
        {
            var existingCreature = await CreatureService.GetCreatureByIdAsync(Id.Value);
            if (existingCreature != null)
            {
                creature = existingCreature;
                EnsureCreatureCharacteristicsInitialized();
                attacks = creature.Attacks?.ToList() ?? [];
                skills = creature.Skills?.ToList() ?? [];

                specialAbilities = creature.SpecialAbilities?.Select(kv =>
                                       new DictionaryEntry { KeyText = kv.Key, ValueText = kv.Value }).ToList()
                                   ?? new List<DictionaryEntry>();

                images = creature.Images?.Select(i => new CreatureImage { Url = i.Url, Caption = i.Caption }).ToList() ?? [];
            }
            else
            {
                NavigationManager.NavigateTo("/bestiary");
                return;
            }
        }
        else
        {
            pageTitle = "Создание существа";
            creature = new Creature
            {
                Name = string.Empty,
                CreatureCharacteristics = new CreatureCharacteristics
                {
                    Strength = new CreatureCharacteristicModel(),
                    Dexterity = new CreatureCharacteristicModel(),
                    Intelligence = new CreatureCharacteristicModel(),
                    Constitution = new CreatureCharacteristicModel(),
                            Power = new CreatureCharacteristicModel(),
                    Size = new CreatureCharacteristicModel()
                }
            };
            EnsureCreatureCharacteristicsInitialized();
            AddAttack();
            AddSpecialAbility();
        }

        isLoading = false;
    }

    private void EnsureCreatureCharacteristicsInitialized()
    {
        // Initialize CreatureCharacteristics if null
        creature.CreatureCharacteristics ??= new CreatureCharacteristics();

        // Initialize individual characteristic models if they're null
        creature.CreatureCharacteristics.Strength ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Dexterity ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Intelligence ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Constitution ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Power ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Size ??= new CreatureCharacteristicModel();
    }

    // Файл кладётся сразу под постоянным именем: картинок несколько, и прежняя схема
    // «временный файл, при сохранении — images/beasts/{имя}.jpg» перезаписывала бы их друг другом.
    private async Task UploadImages(InputFileChangeEventArgs e)
    {
        isUploadingImage = true;
        uploadError = null;
        StateHasChanged();

        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var extension = Path.GetExtension(file.Name);
                if (string.IsNullOrEmpty(extension)) extension = ".jpg";
                var objectName = $"images/beasts/{Slug(creature.Name)}-{Guid.NewGuid().ToString("N")[..8]}{extension.ToLowerInvariant()}";

                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                await MinioService.UploadAsync(stream, objectName, file.ContentType);
                images.Add(new CreatureImage { Url = objectName });
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error uploading creature image {FileName}", file.Name);
                uploadError = $"«{file.Name}» не загрузился: {ex.Message}";
            }
        }

        isUploadingImage = false;
        StateHasChanged();
    }

    private static string Slug(string name)
    {
        var slug = new string(name.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-');
        return string.IsNullOrEmpty(slug) ? "creature" : slug;
    }

    private void AddImage() => images.Add(new CreatureImage());

    private void RemoveImage(CreatureImage image) => images.Remove(image);

    private void MoveImageToFront(CreatureImage image)
    {
        images.Remove(image);
        images.Insert(0, image);
    }

    private async Task ShowExport()
    {
        if (exportModal is not null && Id is { } id)
            await exportModal.Show(id);
    }

    private static void SetAttackKind(CreatureAttack attack, string? value)
    {
        if (Enum.TryParse<CreatureAttackKind>(value, out var kind))
            attack.Kind = kind;
    }

    private static void SetDamageBonus(CreatureAttack attack, string? value)
    {
        if (Enum.TryParse<CreatureDamageBonusMode>(value, out var mode))
            attack.DamageBonus = mode;
    }

    private static string Plural(int count) =>
        (count % 10, count % 100) switch
        {
            (1, not 11) => "строка",
            (2 or 3 or 4, not (12 or 13 or 14)) => "строки",
            _ => "строк"
        };

    private void AddSkill()
    {
        skills.Add(new CreatureSkill());
        StateHasChanged();
    }

    private void RemoveSkill(CreatureSkill item)
    {
        skills.Remove(item);
        StateHasChanged();
    }

    private void AddAttack()
    {
        attacks.Add(new CreatureAttack());
        StateHasChanged();
    }

    private void RemoveAttack(CreatureAttack item)
    {
        attacks.Remove(item);
        StateHasChanged();
    }

    private void AddSpecialAbility()
    {
        specialAbilities.Add(new DictionaryEntry());
        StateHasChanged();
    }

    private void RemoveSpecialAbility(DictionaryEntry item)
    {
        specialAbilities.Remove(item);
        StateHasChanged();
    }

    private async Task Save()
    {
        saveError = null;
        try
        {
            EnsureCreatureCharacteristicsInitialized();
            creature.Attacks = attacks
                .Where(a => !string.IsNullOrWhiteSpace(a.Name))
                .ToList();

            creature.Skills = skills
                .Where(sk => !string.IsNullOrWhiteSpace(sk.Name))
                .ToList();

            creature.Images = images
                .Where(i => !string.IsNullOrWhiteSpace(i.Url))
                .Select(i => new CreatureImage
                {
                    Url = i.Url.Trim(),
                    Caption = string.IsNullOrWhiteSpace(i.Caption) ? null : i.Caption.Trim()
                })
                .ToList();

            creature.SpecialAbilities = specialAbilities
                .Where(entry => !string.IsNullOrWhiteSpace(entry.KeyText))
                .ToDictionary(entry => entry.KeyText, entry => entry.ValueText);

            var success = false;

            if (Id.HasValue)
            {
                success = await CreatureService.UpdateCreatureAsync(creature);
            }
            else
            {
                var createdCreature = await CreatureService.CreateCreatureAsync(creature);
                success = createdCreature != null;

                if (success)
                {
                    creature = createdCreature!;
                    Id = creature.Id; // Set the Id parameter to the new ID
                }
            }

            if (success)
            {
                NavigationManager.NavigateTo("/bestiary");
            }
            else
            {
                // Создание отказывает только на занятом имени — у Creatures уникальный индекс по Name.
                saveError = Id.HasValue
                    ? "Не удалось сохранить существо."
                    : $"Не удалось создать существо: название «{creature.Name}» уже занято?";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving creature {CreatureId}", creature.Id);
            saveError = $"Не удалось сохранить существо: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/bestiary");
    }

}
