@page "/bestiary/creatures/edit/{Id:guid?}"
@using CampaignManager.Web.Components.Features.Bestiary.Model
@using CampaignManager.Web.Components.Features.Bestiary.Services
@using CampaignManager.Web.Components.Features.Wiki.Components
@using CampaignManager.Web.Extensions
@using CampaignManager.Web.Utilities.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator,GameMaster")]

@inject NavigationManager NavigationManager
@inject CreatureService CreatureService
@inject MinioService MinioService

@rendermode InteractiveServer

<PageTitle>@pageTitle</PageTitle>

<PageHeader Title="@pageTitle">
    <Actions>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="Cancel">
            <span>Отмена</span>
        </button>
        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="Save">
            <span>Сохранить</span>
        </button>
    </Actions>
</PageHeader>

<div class="cm-page">
    @if (isLoading)
    {
        <div class="flex justify-center items-center h-64">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
        </div>
    }
    else
    {
        <div class="cm-card">
            <div class="cm-card-body">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label for="name" class="cm-field-label">Название</label>
                    <input id="name" type="text" @bind="creature.Name"
                           class="cm-input w-full"/>
                </div>

                <div>
                    <label for="type" class="cm-field-label">Тип</label>
                    <select id="type" @bind="creature.Type"
                            class="cm-input w-full">
                        @foreach (var type in EnumExtensions.GetEnumTypes<CreatureType>())
                        {
                            <option value="@type">@type.ToRussianString()</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-6">
                <label for="description" class="cm-field-label">Описание</label>
                <textarea id="description" @bind="creature.Description" rows="4"
                          class="cm-input w-full"></textarea>
            </div>

            <div class="mb-6">
                <label class="cm-field-label">Изображение существа</label>
                <div class="grid grid-cols-1 md:grid-cols-7 gap-4 items-start">
                    <div class="md:col-span-4 space-y-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">URL изображения</label>
                            <AutocompleteMinioImage @bind-Value="creature.ImageUrl"
                                                    @bind-Value:after="RefreshDisplayImageUrlAsync"/>
                        </div>
                        <div>
                            <label for="imageUpload"
                                   class="inline-flex items-center px-3 py-2 text-sm font-medium text-primary-700 bg-white border border-primary-300 rounded-lg hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500/25 transition duration-150 ease-in-out shadow-sm cursor-pointer">
                                <i class="fas fa-upload mr-2"></i>
                                <span>Выбрать файл...</span>
                            </label>
                            <InputFile id="imageUpload" OnChange="UploadImage" class="hidden"/>
                            @if (isUploadingImage)
                            {
                                <span class="ml-3 text-sm text-blue-500 align-middle">Загрузка...</span>
                            }
                            else if (!string.IsNullOrEmpty(selectedFileName))
                            {
                                <span class="ml-3 text-sm text-gray-500 align-middle">@selectedFileName</span>
                            }
                            else if (string.IsNullOrEmpty(creature.ImageUrl))
                            {
                                <span class="ml-3 text-sm text-gray-500 align-middle">Файл не выбран</span>
                            }
                        </div>
                    </div>
                    <div class="md:col-span-3 mt-3 md:mt-0">
                        @if (!string.IsNullOrEmpty(displayImageUrl))
                        {
                            <img src="@displayImageUrl" alt="Предпросмотр"
                                 class="max-h-48 w-full object-contain rounded-lg border border-gray-300 p-1 bg-gray-50"/>
                        }
                        else if (!string.IsNullOrEmpty(creature.ImageUrl))
                        {
                            <div
                                class="flex items-center justify-center h-48 border border-gray-300 rounded-lg bg-gray-50 text-gray-400 text-sm">
                                Загрузка предпросмотра...
                            </div>
                        }
                        else
                        {
                            <div
                                class="flex items-center justify-center h-48 border border-gray-300 rounded-lg bg-gray-50 text-gray-400 text-sm">
                                Предпросмотр изображения
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Характеристики</span></div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                <div>
                    <label class="cm-field-label">Сила</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Strength.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Strength.DiceRoll" placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
                <div>
                    <label class="cm-field-label">Ловкость</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Dexterity.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Dexterity.DiceRoll" placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
                <div>
                    <label class="cm-field-label">Интеллект</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Intelligence.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Intelligence.DiceRoll"
                           placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
                <div>
                    <label class="cm-field-label">Выносливость</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Constitution.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Constitution.DiceRoll"
                           placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
                <div>
                    <label class="cm-field-label">Мощь</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Power.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Power.DiceRoll" placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
                <div>
                    <label class="cm-field-label">Телосложение</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Size.Value"
                           class="cm-input w-full"/>
                    <input type="text" @bind="creature.CreatureCharacteristics.Size.DiceRoll" placeholder="2d6+1"
                           class="cm-input w-full mt-1"/>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                <div>
                    <label class="cm-field-label">Ср. бонус к урону</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.AverageDamageBonus"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Ср. комплекция</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.AverageComplexity"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Скорость</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Speed"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Плавание</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.SwimSpeed"
                           placeholder="—" class="cm-input w-full"/>
                    <p class="text-xs text-gray-500 mt-0.5">Пусто — половина обычной (стр. 141).</p>
                </div>
                <div>
                    <label class="cm-field-label">Полёт</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.FlySpeed"
                           placeholder="—" class="cm-input w-full"/>
                    <p class="text-xs text-gray-500 mt-0.5">Пусто — полёт недоступен.</p>
                </div>
                <div>
                    <label class="cm-field-label">Атак за раунд</label>
                    <input type="number" min="1" @bind="creature.CreatureCharacteristics.AttacksPerRound"
                           class="cm-input w-full"/>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Столько же защит за раунд без бонусной кости врагам (стр. 279).
                    </p>
                </div>
                <div>
                    <label class="cm-field-label">ПЗ</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.HealPoint"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">ПМ</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.ManaPoint"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Броня</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.Armor"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Уклонение</label>
                    <input type="number" @bind="creature.CreatureCharacteristics.DodgeSkill"
                           class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Потеря рассудка</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.SanityLoss"
                           placeholder="0/1d6"
                           class="cm-input w-full"/>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Успех/провал. Из провальной части сыщик получает предел привыкания
                        к ужасному: @(SanityLossFormula.MaxLoss(creature.CreatureCharacteristics.SanityLoss)) пунктов.
                    </p>
                </div>
            </div>

            @* Строки статблока, которые книга печатает словами, а не числом *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div>
                    <label class="cm-field-label">Броня словами</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.ArmorNote"
                           placeholder="огнестрел наносит минимальный урон" class="cm-input w-full"/>
                    <p class="text-xs text-gray-500 mt-0.5">
                        «Броня: нет» у книги часто идёт с оговоркой — она и есть настоящая защита.
                    </p>
                </div>
                <div>
                    <label class="cm-field-label">Оговорка к числу атак</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.AttacksPerRoundNote"
                           placeholder="максимум 1 укус за раунд" class="cm-input w-full"/>
                </div>
                <div>
                    <label class="cm-field-label">Скорость словами</label>
                    <input type="text" @bind="creature.CreatureCharacteristics.SpeedNote"
                           placeholder="перекатывание 10" class="cm-input w-full"/>
                </div>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Навыки</span></div>
            <div class="mb-6 space-y-2">
                @foreach (var skill in skills)
                {
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-2 items-end p-2 border rounded-lg">
                        <div class="md:col-span-4">
                            <label class="cm-field-label">Название</label>
                            <input type="text" @bind="skill.Name" placeholder="Скрытность" class="cm-input w-full"/>
                        </div>
                        <div class="md:col-span-2">
                            <label class="cm-field-label">%</label>
                            <input type="number" min="1" max="100" @bind="skill.Value" class="cm-input w-full"/>
                        </div>
                        <div class="md:col-span-5">
                            <label class="cm-field-label">Уточнение</label>
                            <input type="text" @bind="skill.Note" placeholder="в воде 80%" class="cm-input w-full"/>
                        </div>
                        <div class="md:col-span-1 flex justify-end">
                            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm"
                                    aria-label="@($"Удалить навык {skill.Name}")" @onclick="() => RemoveSkill(skill)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
                <button type="button" class="cm-btn cm-btn-success cm-btn-sm mt-2" @onclick="AddSkill">
                    <i class="fas fa-plus"></i>
                    <span>Добавить навык</span>
                </button>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Атаки</span></div>
            <div class="mb-6 space-y-3">
                @foreach (var attack in attacks)
                {
                    <div class="p-3 border rounded-lg space-y-2">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                            <div class="md:col-span-2">
                                <label class="block text-xs font-medium text-gray-600">Название</label>
                                <input type="text" @bind="attack.Name" placeholder="Ужасная жадная пасть"
                                       class="cm-input w-full"/>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Навык %</label>
                                <input type="number" @bind="attack.SkillValue" min="1" max="100"
                                       class="cm-input w-full"/>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Урон</label>
                                <input type="text" @bind="attack.DamageFormula" placeholder="1D8"
                                       class="cm-input w-full"/>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Вид</label>
                                <select value="@attack.Kind"
                                        @onchange="e => SetAttackKind(attack, e.Value?.ToString())"
                                        class="cm-input w-full">
                                    <option value="@CreatureAttackKind.Melee">Ближний бой</option>
                                    <option value="@CreatureAttackKind.Ranged">Дальний бой</option>
                                    <option value="@CreatureAttackKind.Maneuver">Манёвр</option>
                                    <option value="@CreatureAttackKind.Special">Особая</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600">Бонус к урону</label>
                                <select value="@attack.DamageBonus"
                                        @onchange="e => SetDamageBonus(attack, e.Value?.ToString())"
                                        class="cm-input w-full">
                                    <option value="@CreatureDamageBonusMode.None">не добавляется</option>
                                    <option value="@CreatureDamageBonusMode.Full">+ БкУ</option>
                                    <option value="@CreatureDamageBonusMode.Half">+ ½ БкУ</option>
                                    <option value="@CreatureDamageBonusMode.OnlyBonus">урон равен БкУ</option>
                                </select>
                            </div>
                            <div class="md:col-span-2 flex items-end gap-2">
                                <div class="flex-1">
                                    <label class="block text-xs font-medium text-gray-600">Описание эффектов</label>
                                    <input type="text" @bind="attack.Description" placeholder="Яд, захват и т.д."
                                           class="cm-input w-full"/>
                                </div>
                                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm" @onclick="() => RemoveAttack(attack)" title="Удалить атаку">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <button type="button" class="cm-btn cm-btn-success cm-btn-sm mt-2" @onclick="AddAttack">
                    <i class="fas fa-plus"></i>
                    <span>Добавить атаку</span>
                </button>
            </div>

            <div class="cm-section-header"><span class="cm-section-title">Особые умения</span></div>
            <div class="space-y-3">
                @foreach (var ability in specialAbilities)
                {
                    <div class="flex space-x-3 items-start p-3 border rounded-lg">
                        <div class="flex-1 space-y-1">
                            <label class="block text-xs font-medium text-gray-600">Название</label>
                            <input type="text" @bind="ability.KeyText" placeholder="Название умения"
                                   class="cm-input w-full"/>
                        </div>
                        <div class="flex-1 space-y-1">
                            <label class="block text-xs font-medium text-gray-600">Описание</label>
                            <textarea @bind="ability.ValueText" rows="3"
                                      placeholder="Описание умения"
                                      class="cm-input w-full"></textarea>
                        </div>
                        <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm mt-5" @onclick="() => RemoveSpecialAbility(ability)" title="Удалить умение">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                }
                <button type="button" class="cm-btn cm-btn-success cm-btn-sm mt-2" @onclick="AddSpecialAbility">
                    <i class="fas fa-plus"></i>
                    <span>Добавить особое умение</span>
                </button>
            </div>

            @* Текст статблока в том виде, в каком его залили из книги. Поля выше разобраны
               именно из него, поэтому он остаётся под рукой для сверки, но не редактируется:
               источник правды — разобранные поля. *@
            @if (creature.CombatDescriptions.Count > 0)
            {
                <details class="mt-6 border border-gray-200 rounded-lg">
                    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-semibold text-gray-700">
                        Исходный текст из книги (@creature.CombatDescriptions.Count @Plural(creature.CombatDescriptions.Count))
                    </summary>
                    <div class="px-3 pb-3 pt-1 text-sm text-gray-600 space-y-1.5">
                        <p class="text-xs text-gray-500">
                            Поля выше разобраны из этих строк. Правьте поля — здесь только сверка.
                        </p>
                        @foreach (var line in creature.CombatDescriptions.OrderBy(kv => kv.Key, StringComparer.CurrentCulture))
                        {
                            <div>
                                <span class="font-semibold text-gray-800">@line.Key:</span>
                                <span>@line.Value</span>
                            </div>
                        }
                    </div>
                </details>
            }
            </div>
        </div>
    }

    @if (Id.HasValue)
    {
        <EditHistoryPanel EntityType="Creature" EntityId="Id.Value"/>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Creature creature = new()
    {
        Name = string.Empty,
        CreatureCharacteristics = new CreatureCharacteristics
        {
            Strength = new CreatureCharacteristicModel(),
            Dexterity = new CreatureCharacteristicModel(),
            Intelligence = new CreatureCharacteristicModel(),
            Constitution = new CreatureCharacteristicModel(),
            Power = new CreatureCharacteristicModel(),
            Size = new CreatureCharacteristicModel()
        }
    };

    private List<CreatureAttack> attacks = [];
    private List<CreatureSkill> skills = [];
    private List<DictionaryEntry> specialAbilities = new();
    private bool isLoading = true;
    private string pageTitle = "Новое существо";
    private IBrowserFile? uploadedImage;
    private string? selectedFileName;
    private bool isUploadingImage;
    private string? displayImageUrl;
    private Guid? _lastLoadedId;

    private class DictionaryEntry
    {
        public string KeyText { get; set; } = string.Empty;
        public string ValueText { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _lastLoadedId)
        {
            _lastLoadedId = Id;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        pageTitle = Id.HasValue ? "Редактирование существа" : "Создание существа";
        isLoading = true;

        // Always ensure our creature characteristics are initialized to prevent null references
        EnsureCreatureCharacteristicsInitialized();

        if (Id.HasValue && Id != Guid.Empty)
        {
            var existingCreature = await CreatureService.GetCreatureByIdAsync(Id.Value);
            if (existingCreature != null)
            {
                creature = existingCreature;
                EnsureCreatureCharacteristicsInitialized();
                attacks = creature.Attacks?.ToList() ?? [];
                skills = creature.Skills?.ToList() ?? [];

                specialAbilities = creature.SpecialAbilities?.Select(kv =>
                                       new DictionaryEntry { KeyText = kv.Key, ValueText = kv.Value }).ToList()
                                   ?? new List<DictionaryEntry>();

                if (!string.IsNullOrEmpty(creature.ImageUrl))
                {
                    await RefreshDisplayImageUrlAsync();
                }
            }
            else
            {
                NavigationManager.NavigateTo("/bestiary");
                return;
            }
        }
        else
        {
            pageTitle = "Создание существа";
            creature = new Creature
            {
                Name = string.Empty,
                CreatureCharacteristics = new CreatureCharacteristics
                {
                    Strength = new CreatureCharacteristicModel(),
                    Dexterity = new CreatureCharacteristicModel(),
                    Intelligence = new CreatureCharacteristicModel(),
                    Constitution = new CreatureCharacteristicModel(),
                            Power = new CreatureCharacteristicModel(),
                    Size = new CreatureCharacteristicModel()
                }
            };
            EnsureCreatureCharacteristicsInitialized();
            AddAttack();
            AddSpecialAbility();
        }

        isLoading = false;
    }

    private void EnsureCreatureCharacteristicsInitialized()
    {
        // Initialize CreatureCharacteristics if null
        creature.CreatureCharacteristics ??= new CreatureCharacteristics();

        // Initialize individual characteristic models if they're null
        creature.CreatureCharacteristics.Strength ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Dexterity ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Intelligence ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Constitution ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Power ??= new CreatureCharacteristicModel();
        creature.CreatureCharacteristics.Size ??= new CreatureCharacteristicModel();
    }

    private async Task RefreshDisplayImageUrlAsync()
    {
        if (!string.IsNullOrEmpty(creature.ImageUrl))
        {
            try
            {
                displayImageUrl = await MinioService.GetPresignedUrlAsync(creature.ImageUrl);
            }
            catch (Exception ex)
            {
                // Log error or notify user
                Console.WriteLine($"Error getting presigned URL: {ex.Message}");
                displayImageUrl = null; // Or a placeholder error image URL
            }
        }
        else
        {
            displayImageUrl = null;
        }

        StateHasChanged();
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        uploadedImage = e.File;
        selectedFileName = e.File.Name;

        if (uploadedImage != null)
        {
            isUploadingImage = true;
            StateHasChanged();
            try
            {
                var tempImageName = $"temp-{Guid.NewGuid()}{Path.GetExtension(uploadedImage.Name)}";

                await using var stream = uploadedImage.OpenReadStream(5 * 1024 * 1024); // 5MB limit
                await MinioService.UploadAsync(stream, tempImageName, uploadedImage.ContentType);

                creature.ImageUrl = tempImageName;
                selectedFileName = uploadedImage.Name; // Keep displaying selected file name until save
                await RefreshDisplayImageUrlAsync();
            }
            catch (Exception ex)
            {
                // Handle upload error (e.g., display a message to the user)
                selectedFileName = $"Ошибка загрузки: {ex.Message}";
                Console.WriteLine($"File upload failed: {ex.Message}");
                creature.ImageUrl = null; // Clear image URL on error
                displayImageUrl = null;
            }
            finally
            {
                isUploadingImage = false;
                StateHasChanged();
            }
        }
    }

    private static void SetAttackKind(CreatureAttack attack, string? value)
    {
        if (Enum.TryParse<CreatureAttackKind>(value, out var kind))
            attack.Kind = kind;
    }

    private static void SetDamageBonus(CreatureAttack attack, string? value)
    {
        if (Enum.TryParse<CreatureDamageBonusMode>(value, out var mode))
            attack.DamageBonus = mode;
    }

    private static string Plural(int count) =>
        (count % 10, count % 100) switch
        {
            (1, not 11) => "строка",
            (2 or 3 or 4, not (12 or 13 or 14)) => "строки",
            _ => "строк"
        };

    private void AddSkill()
    {
        skills.Add(new CreatureSkill());
        StateHasChanged();
    }

    private void RemoveSkill(CreatureSkill item)
    {
        skills.Remove(item);
        StateHasChanged();
    }

    private void AddAttack()
    {
        attacks.Add(new CreatureAttack());
        StateHasChanged();
    }

    private void RemoveAttack(CreatureAttack item)
    {
        attacks.Remove(item);
        StateHasChanged();
    }

    private void AddSpecialAbility()
    {
        specialAbilities.Add(new DictionaryEntry());
        StateHasChanged();
    }

    private void RemoveSpecialAbility(DictionaryEntry item)
    {
        specialAbilities.Remove(item);
        StateHasChanged();
    }

    private async Task Save()
    {
        try
        {
            EnsureCreatureCharacteristicsInitialized();
            creature.Attacks = attacks
                .Where(a => !string.IsNullOrWhiteSpace(a.Name))
                .ToList();

            creature.Skills = skills
                .Where(sk => !string.IsNullOrWhiteSpace(sk.Name))
                .ToList();

            creature.SpecialAbilities = specialAbilities
                .Where(entry => !string.IsNullOrWhiteSpace(entry.KeyText))
                .ToDictionary(entry => entry.KeyText, entry => entry.ValueText);

            var success = false;

            if (Id.HasValue)
            {
                success = await CreatureService.UpdateCreatureAsync(creature);
            }
            else
            {
                var createdCreature = await CreatureService.CreateCreatureAsync(creature);
                success = createdCreature != null;

                if (success)
                {
                    creature = createdCreature!;
                    Id = creature.Id; // Set the Id parameter to the new ID
                }
            }

            if (success)
            {
                if (uploadedImage != null)
                {
                    await UploadImageToServer();
                }

                NavigationManager.NavigateTo("/bestiary");
            }
            else
            {
                Console.WriteLine("Error saving creature");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving creature: {ex.Message}");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/bestiary");
    }

    private async Task UploadImageToServer()
    {
        if (uploadedImage == null) return;

        try
        {
            var fileName = $"images/beasts/{creature.Name.ToLower().Replace(" ", "-")}.jpg";
            var stream = uploadedImage.OpenReadStream(5 * 1024 * 1024); // 5MB limit

            await MinioService.UploadAsync(
                stream,
                fileName,
                uploadedImage.ContentType);

            creature.ImageUrl = fileName;
            await CreatureService.UpdateCreatureAsync(creature);
        }
        catch (Exception ex)
        {
            // Handle upload error (e.g., display a message to the user)
            Console.WriteLine($"Error uploading image: {ex.Message}");
        }
    }

    private string GetImageUrl(string? imageName)
    {
        if (string.IsNullOrEmpty(imageName))
            return string.Empty;

        if (imageName.StartsWith("http://") || imageName.StartsWith("https://"))
            return imageName;

        return $"/api/minio/image/{imageName}";
    }

}
