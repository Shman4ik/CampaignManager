@page "/bestiary"
@using CampaignManager.Web.Components.Features.Bestiary.Components
@using CampaignManager.Web.Components.Features.Bestiary.Model
@using CampaignManager.Web.Components.Features.Bestiary.Services
@using CampaignManager.Web.Extensions
@attribute [Authorize]

@inject CreatureService CreatureService
@inject NavigationManager NavigationManager
@inject ILogger<CreaturesPage> Logger
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
<PageTitle>Существа</PageTitle>

<PageHeader Title="Существа">
    <Actions>
        <AuthorizeView Roles="Administrator,GameMaster">
            <Button Variant="secondary" Size="sm" Icon="fa-file-import" OnClick="ShowImportModal">Импорт JSON</Button>
        </AuthorizeView>
        <Button Variant="secondary" Size="sm" Icon="fa-file-export" OnClick="ShowExportModal">Экспорт JSON</Button>
        <Button Variant="primary" Size="sm" Icon="fa-plus" OnClick="CreateNewCreature">Добавить</Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel Title="Фильтры" @bind-IsExpanded="_isSearchPanelVisible" OnReset="ClearFilters">
        <ChildContent>
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1 min-w-0">
                    <label for="searchQuery" class="cm-field-label">Поиск</label>
                    <input type="search" id="searchQuery"
                           class="cm-input"
                           placeholder="Поиск по названию..."
                           value="@_searchTerm"
                           @oninput="HandleSearchInput"/>
                </div>
                <div class="w-full sm:w-56 shrink-0">
                    <label for="typeFilter" class="cm-field-label">Тип существа</label>
                    <select id="typeFilter"
                            class="cm-input"
                            value="@_selectedType"
                            @onchange="TypeSelectionChanged">
                        <option value="">Все типы</option>
                        @foreach (var type in EnumExtensions.GetEnumTypes<CreatureType>())
                        {
                            <option value="@type">@type.ToRussianString()</option>
                        }
                    </select>
                </div>
            </div>
        </ChildContent>
    </FilterPanel>

    @if (_loading)
    {
        <LoadingIndicator/>
    }
    else if (_creatures.Count == 0)
    {
        <EmptyState IconClass="fa-skull"
                    Title="Существа не найдены"
                    Message="@(HasActiveFilters ? "Нет существ, соответствующих критериям поиска." : "В бестиарии пока нет существ. Добавьте первое, чтобы начать.")">
            <ActionButton>
                <Button Variant="primary" Icon="fa-plus" OnClick="CreateNewCreature">Добавить существо</Button>
                @if (HasActiveFilters)
                {
                    <Button Variant="secondary" Icon="fa-undo-alt" OnClick="ClearFilters">Очистить фильтры</Button>
                }
            </ActionButton>
        </EmptyState>
    }
    else
    {
        @* Галерея плиток: колонок столько, сколько влезает по 13rem (.cr-grid) — пять в альбоме
           iPad, четыре в портрете. Раскрытая карточка встаёт во всю ширину ряда, а dense-укладка
           подтягивает плитки после неё в дыру, что остаётся в её прежнем ряду. *@
        <div class="cr-grid">
            @foreach (var creature in _creatures)
            {
                <CreatureCard @key="creature.Id"
                              Creature="@creature"
                              Expanded="@(creature.Id == Open)"
                              OnToggle="ToggleCreature"
                              OnDelete="@(c => ConfirmDelete(c))"/>
            }
        </div>
        <Pagination CurrentPage="@_currentPage"
                    TotalPages="@TotalPages"
                    TotalItems="@_totalItems"
                    ItemsPerPage="@_pageSize"
                    ItemsLabel="существ"
                    OnPageChanged="GoToPage"/>
    }
</div>

<ConfirmationModal IsVisible="_showDeleteModal"
                   OnConfirm="DeleteCreature"
                   OnCancel="@(() => { _showDeleteModal = false; _creatureToDelete = null; })"
                   Title="Подтверждение удаления"
                   Message="@($"Вы уверены, что хотите удалить \"{_creatureToDelete?.Name}\"? Это действие нельзя отменить.")"
                   ConfirmText="Удалить"
                   IconType="error" />

<AuthorizeView Roles="Administrator,GameMaster">
    <CreatureImportModal @ref="_importModal" OnImported="LoadData"/>
</AuthorizeView>
<CreatureExportModal @ref="_exportModal"/>



@code {
    private List<Creature> _creatures = [];
    private bool _loading = true;
    private string _searchTerm = "";
    private string _selectedType = "";
    private bool _isSearchPanelVisible = true;

    // Модальное окно удаления
    private bool _showDeleteModal;
    private Creature? _creatureToDelete;

    private CreatureImportModal? _importModal;
    private CreatureExportModal? _exportModal;

    /// <summary>
    ///     Раскрытое существо. В адресе, а не в поле: так раскрытая карточка переживает паузу
    ///     circuit'а и F5, и на неё можно дать ссылку.
    /// </summary>
    [SupplyParameterFromQuery(Name = "open")]
    public Guid? Open { get; set; }

    private Guid? _scrollTo;

    private int _currentPage = 1;
    // 20 плиток — ровно четыре ряда и в альбоме iPad (пять колонок), и в портрете (четыре).
    private readonly int _pageSize = 20;
    private int _totalItems;
    private int TotalPages => (int)Math.Ceiling((double)_totalItems / _pageSize);

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _selectedType != "";

    protected override async Task OnInitializedAsync()
    {
        // После F5 или по ссылке с ?open= раскрытая карточка может быть далеко внизу.
        _scrollTo = Open;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _totalItems = await CreatureService.GetCreatureCountAsync(_searchTerm, _selectedType);
            _creatures = await CreatureService.GetAllCreaturesAsync(_searchTerm, _selectedType, _currentPage, _pageSize);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading creatures data");
        }
        finally
        {
            _loading = false;
        }
    }


    // Одно раскрытое существо за раз: второе раскрытие сворачивает первое, иначе длинные
    // статблоки двух тварей разносили бы сетку на несколько экранов.
    private void ToggleCreature(Creature creature)
    {
        var next = creature.Id == Open ? (Guid?)null : creature.Id;
        _scrollTo = next;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("open", next), replace: true);
    }

    // Раскрытая карточка уходит в начало следующего ряда, и тапнутое место уезжает из-под
    // пальца — подтягиваем её заголовок к шапке, если он оказался не на виду.
    // Ждём рендера, где Open уже новый: NavigateTo меняет его не сразу, и рендер сразу после
    // клика ещё рисует плитку — прокрутка тогда искала бы карточку, которой нет.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _scrollTo is not { } id || id != Open) return;
        _scrollTo = null;
        await JSRuntime.InvokeVoidAsync("revealElement", $"creature-{id}");
    }

    // Каждый фильтр возвращает на первую страницу: с пятой страницы узкий поиск
    // иначе уводил в пустой список, хотя подходящие существа есть.
    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        _currentPage = 1;
        await LoadData();
    }

    private async Task TypeSelectionChanged(ChangeEventArgs e)
    {
        _selectedType = e.Value?.ToString() ?? "";
        _currentPage = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _searchTerm = "";
        _selectedType = "";
        _currentPage = 1;
        await LoadData();
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowImportModal() => _importModal?.Show();

    private async Task ShowExportModal()
    {
        if (_exportModal is not null)
            await _exportModal.Show();
    }

    // Создание нового существа
    private void CreateNewCreature()
    {
        NavigationManager.NavigateTo("/bestiary/creatures/edit");
    }

    // Удаление существа
    private void ConfirmDelete(Creature creature)
    {
        _creatureToDelete = creature;
        _showDeleteModal = true;
    }

    private async Task DeleteCreature()
    {
        if (_creatureToDelete is null)
        {
            return;
        }

        try
        {
            var success = await CreatureService.DeleteCreatureAsync(_creatureToDelete.Id);
            if (success)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting creature {CreatureId}", _creatureToDelete.Id);
        }
        finally
        {
            _showDeleteModal = false;
            _creatureToDelete = null;
        }
    }

}
