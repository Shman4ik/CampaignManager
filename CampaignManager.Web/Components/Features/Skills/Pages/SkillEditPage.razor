@page "/skills/edit"
@page "/skills/edit/{Id:guid}"
@using CampaignManager.Web.Components.Features.Skills.Model
@using CampaignManager.Web.Components.Features.Skills.Services
@using CampaignManager.Web.Components.Features.Wiki.Components
@using CampaignManager.Web.Extensions
@using CampaignManager.Web.Utilities
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator,GameMaster")]

@inject SkillService SkillService
@inject NavigationManager NavigationManager
@inject ILogger<SkillEditPage> Logger
@rendermode InteractiveServer

<PageTitle>@(Id.HasValue ? "Редактировать навык" : "Создать навык")</PageTitle>

<PageHeader Title="@(Id.HasValue ? "Редактировать навык" : "Создать навык")">
    <Actions>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="Cancel"><span>Отмена</span></button>
        <button type="submit" form="SkillForm" class="cm-btn cm-btn-primary cm-btn-sm" disabled="@_saving"><i class="fas @(_saving ? "fa-spinner fa-spin" : "fa-save")"></i> <span>@(_saving ? "Сохранение..." : "Сохранить")</span></button>
    </Actions>
</PageHeader>

<div class="cm-page">
    @* Ошибка — над формой: сохраняют из шапки, и под длинной формой её бы не заметили. *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Type="error" ShowIcon>@_errorMessage</Alert>
    }

    <div class="cm-card">
        <div class="cm-card-body">
            @* id обязателен: «Сохранить» живёт в шапке, вне формы, и находит её по form="SkillForm".
               FormName id не выставляет — без этого кнопка в шапке ничего не отправляла, и форма
               держала вторую пару «Отмена/Сохранить» внизу. *@
            <EditForm id="SkillForm" Model="_skill" OnValidSubmit="SaveSkill" FormName="SkillForm">
                <DataAnnotationsValidator/>

                <!-- Name and Base Value -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="md:col-span-2">
                        <label for="name" class="cm-field-label">
                            Название навыка *
                        </label>
                        <InputText id="name" @bind-Value="_skill.Name"
                                   class="cm-input"
                                   placeholder="Введите название навыка"/>
                        <ValidationMessage For="() => _skill.Name" class="text-error-600 text-xs mt-1"/>
                    </div>

                    <div>
                        <label for="baseValue" class="cm-field-label">
                            Базовое значение (%) *
                        </label>
                        <InputNumber id="baseValue" @bind-Value="_skill.BaseValue"
                                     class="cm-input"
                                     min="0" max="100"/>
                        <ValidationMessage For="() => _skill.BaseValue" class="text-error-600 text-xs mt-1"/>
                    </div>
                </div>

                <!-- Category and Flags -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label for="category" class="cm-field-label">
                            Категория навыка *
                        </label>
                        <InputSelect id="category" @bind-Value="_skill.Category"
                                     class="cm-input">
                            @foreach (var category in EnumExtensions.GetEnumTypes<SkillCategory>())
                            {
                                <option value="@category">@category.ToRussianString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _skill.Category" class="text-error-600 text-xs mt-1"/>
                    </div>

                    @* Флажок — это вся строка в 40px: label обнимает чекбокс, так что попасть
                       пальцем можно по подписи, а не только по квадратику. *@
                    <div>
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <InputCheckbox @bind-Value="_skill.IsUncommon" class="cm-checkbox"/>
                            Необычный навык
                        </label>
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <InputCheckbox @bind-Value="_skill.CanRetry" class="cm-checkbox"/>
                            Можно повторить проверку
                        </label>
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <InputCheckbox @bind-Value="_skill.Is1920" class="cm-checkbox"/>
                            Классический сеттинг (1920-е)
                        </label>
                        <label class="flex min-h-[40px] cursor-pointer items-center gap-2 text-sm text-primary-700">
                            <InputCheckbox @bind-Value="_skill.IsModern" class="cm-checkbox"/>
                            Современный сеттинг
                        </label>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-6">
                    <label for="description" class="cm-field-label">
                        Описание
                    </label>
                    <InputTextArea id="description" @bind-Value="_skill.Description"
                                   class="cm-input"
                                   rows="3" placeholder="Описание навыка..."/>
                    <ValidationMessage For="() => _skill.Description" class="text-error-600 text-xs mt-1"/>
                </div>

                <!-- Time Required -->
                <div class="mb-6">
                    <label for="timeRequired" class="cm-field-label">
                        Время выполнения
                    </label>
                    <InputText id="timeRequired" @bind-Value="_skill.TimeRequired"
                               class="cm-input"
                               placeholder="Например: 1 раунд, 10 минут, 1 час..."/>
                </div>

                <!-- Usage Examples -->
                <div class="mb-6">
                    <div class="cm-field-label">Примеры использования</div>
                    <div class="space-y-2">
                        @for (int i = 0; i < _skill.UsageExamples.Count; i++)
                        {
                            var index = i;
                            <div class="flex items-center gap-2">
                                <div class="flex-1 min-w-0">
                                    <InputText @bind-Value="_skill.UsageExamples[index]" class="cm-input" placeholder="Пример использования навыка..."/>
                                </div>
                                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm shrink-0"
                                        aria-label="@($"Удалить пример {index + 1}")"
                                        @onclick="() => RemoveUsageExample(index)">
                                    <i class="fas fa-trash-alt"></i><span>Удалить</span>
                                </button>
                            </div>
                        }
                        <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddUsageExample">Добавить пример</Button>
                    </div>
                </div>

                <!-- Failure Consequences -->
                <div class="mb-6">
                    <div class="cm-field-label">Последствия провала</div>
                    <div class="space-y-2">
                        @for (int i = 0; i < _skill.FailureConsequences.Count; i++)
                        {
                            var index = i;
                            <div class="flex items-center gap-2">
                                <div class="flex-1 min-w-0">
                                    <InputText @bind-Value="_skill.FailureConsequences[index]" class="cm-input" placeholder="Последствие провала..."/>
                                </div>
                                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm shrink-0"
                                        aria-label="@($"Удалить последствие {index + 1}")"
                                        @onclick="() => RemoveFailureConsequence(index)">
                                    <i class="fas fa-trash-alt"></i><span>Удалить</span>
                                </button>
                            </div>
                        }
                        <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddFailureConsequence">Добавить последствие</Button>
                    </div>
                </div>

                <!-- Opposing Skills -->
                <div class="mb-6">
                    <div class="cm-field-label">Противоположные навыки</div>
                    <div class="space-y-2">
                        @for (int i = 0; i < _skill.OpposingSkills.Count; i++)
                        {
                            var index = i;
                            <div class="flex items-center gap-2">
                                <div class="flex-1 min-w-0">
                                    <InputText @bind-Value="_skill.OpposingSkills[index]" class="cm-input" placeholder="Название противоположного навыка..."/>
                                </div>
                                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm shrink-0"
                                        aria-label="@($"Удалить противоположный навык {index + 1}")"
                                        @onclick="() => RemoveOpposingSkill(index)">
                                    <i class="fas fa-trash-alt"></i><span>Удалить</span>
                                </button>
                            </div>
                        }
                        <Button Variant="secondary" Size="sm" Icon="fa-plus" OnClick="AddOpposingSkill">Добавить противоположный навык</Button>
                    </div>
                </div>

            </EditForm>
        </div>
    </div>

    @if (Id.HasValue)
    {
        <EditHistoryPanel EntityType="SkillModel" EntityId="Id.Value"/>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private SkillModel _skill = new();
    private bool _saving = false;
    private string _errorMessage = "";
    private Guid? _lastLoadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _lastLoadedId)
        {
            _lastLoadedId = Id;
            if (Id.HasValue)
            {
                await LoadSkill();
            }
            else
            {
                // Initialize new skill with default values
                _skill = new SkillModel
                {
                    Category = SkillCategory.Actions,
                    BaseValue = 0,
                    UsageExamples = new List<string>(),
                    FailureConsequences = new List<string>(),
                    OpposingSkills = new List<string>()
                };
            }
        }
    }

    private async Task LoadSkill()
    {
        if (!Id.HasValue) return;

        try
        {
            var skill = await SkillService.GetSkillByIdAsync(Id.Value);
            if (skill is not null)
            {
                _skill = skill;
            }
            else
            {
                _errorMessage = "Навык не найден.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading skill {SkillId}", Id.Value);
            _errorMessage = "Ошибка при загрузке навыка.";
        }
    }

    private async Task SaveSkill()
    {
        _saving = true;
        _errorMessage = "";

        try
        {
            // Clean up empty entries from lists
            _skill.UsageExamples = _skill.UsageExamples.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
            _skill.FailureConsequences = _skill.FailureConsequences.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
            _skill.OpposingSkills = _skill.OpposingSkills.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();

            if (Id.HasValue)
            {
                var updateResult = await SkillService.UpdateSkillAsync(_skill);
                if (!updateResult.IsSuccess)
                {
                    _errorMessage = updateResult.Error!;
                    return;
                }
            }
            else
            {
                var createResult = await SkillService.CreateSkillAsync(_skill);
                if (!createResult.IsSuccess)
                {
                    _errorMessage = createResult.Error!;
                    return;
                }
            }

            NavigationManager.NavigateTo("/skills");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving skill");
            _errorMessage = "Произошла ошибка при сохранении навыка.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/skills");
    }

    // List management methods
    private void AddUsageExample()
    {
        _skill.UsageExamples.Add("");
    }

    private void RemoveUsageExample(int index)
    {
        if (index >= 0 && index < _skill.UsageExamples.Count)
        {
            _skill.UsageExamples.RemoveAt(index);
        }
    }

    private void AddFailureConsequence()
    {
        _skill.FailureConsequences.Add("");
    }

    private void RemoveFailureConsequence(int index)
    {
        if (index >= 0 && index < _skill.FailureConsequences.Count)
        {
            _skill.FailureConsequences.RemoveAt(index);
        }
    }

    private void AddOpposingSkill()
    {
        _skill.OpposingSkills.Add("");
    }

    private void RemoveOpposingSkill(int index)
    {
        if (index >= 0 && index < _skill.OpposingSkills.Count)
        {
            _skill.OpposingSkills.RemoveAt(index);
        }
    }

}
