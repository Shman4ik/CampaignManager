@namespace CampaignManager.Web.Components.Features.Music.Components
@using CampaignManager.Web.Components.Features.Music.Services
@using CampaignManager.Web.Utilities.Services
@rendermode InteractiveServer
@implements IDisposable
@inject MusicPlaybackService Playback
@inject MusicTrackService TrackService
@inject IdentityService IdentityService

@* Кнопка «Музыка» в шапке любой страницы — её ставит PageHeader рядом с ширмой. Открывает и
   прячет панель плеера (MusicPlayerBar в лэйауте), сама панель по умолчанию скрыта. Свой
   rendermode — по той же причине, что у KeeperScreenButton: шапка бывает и на статичных
   страницах. Без фонотеки прячется: открывать было бы нечего. *@

@if (_isKeeper && (_hasLibrary || Playback.CurrentTrack is not null))
{
    <button type="button"
            class="cm-btn cm-btn-sm @(Playback.IsPanelOpen ? "cm-btn-primary" : "cm-btn-secondary") shrink-0"
            aria-expanded="@(Playback.IsPanelOpen ? "true" : "false")"
            @onclick="Playback.TogglePanel">
        @* Играет при скрытой панели — видно по иконке, а не только по звуку из колонки. *@
        <i class="fa-solid @(Playback.IsPlaying ? "fa-volume-high" : "fa-music") mr-1" aria-hidden="true"></i><span>Музыка</span>
    </button>
}

@code {
    private bool _isKeeper;
    private bool _hasLibrary;

    protected override async Task OnInitializedAsync()
    {
        Playback.OnChange += OnPlaybackChanged;
        TrackService.OnLibraryChanged += OnLibraryChanged;

        _isKeeper = await IdentityService.IsKeeper();
        if (_isKeeper)
            _hasLibrary = (await TrackService.GetAllTracksAsync()).Count > 0;
    }

    private void OnPlaybackChanged() => InvokeAsync(StateHasChanged);

    private void OnLibraryChanged() => InvokeAsync(async () =>
    {
        _hasLibrary = (await TrackService.GetAllTracksAsync()).Count > 0;
        StateHasChanged();
    });

    public void Dispose()
    {
        Playback.OnChange -= OnPlaybackChanged;
        TrackService.OnLibraryChanged -= OnLibraryChanged;
    }
}
