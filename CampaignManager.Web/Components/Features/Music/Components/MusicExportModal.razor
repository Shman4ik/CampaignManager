@namespace CampaignManager.Web.Components.Features.Music.Components
@using CampaignManager.Web.Components.Features.Music.Services
@inject MusicImportService MusicImportService
@inject IJSRuntime JS
@inject ILogger<MusicExportModal> Logger

<Modal IsVisible="_isVisible"
       OnClose="Hide"
       Title="Экспорт фонотеки в JSON"
       MaxWidth="4xl"
       HeaderColorScheme="primary">
    <ChildContent>
        <div class="space-y-4">
            <Alert Type="info" Title="Обменный формат">
                Этот JSON принимает кнопка «Импорт JSON» — на этой же платформе или на другой.
                Возьмите его за образец, когда собираете новую подборку.
            </Alert>

            @if (_isLoading)
            {
                <LoadingIndicator/>
            }
            else
            {
                <textarea class="cm-input font-mono text-xs" rows="20" readonly>@_json</textarea>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <Button ButtonType="button" OnClick="Hide" Variant="secondary">Закрыть</Button>
            <Button ButtonType="button" OnClick="CopyToClipboard" Variant="primary"
                    IsDisabled="@(_isLoading || string.IsNullOrEmpty(_json))">
                @(_copied ? "Скопировано" : "Скопировать")
            </Button>
        </div>
    </FooterContent>
</Modal>

@code {

    private bool _isVisible;
    private bool _isLoading;
    private bool _copied;
    private string? _json;

    public async Task Show()
    {
        _isVisible = true;
        _isLoading = true;
        _copied = false;
        _json = null;
        StateHasChanged();

        _json = await MusicImportService.ExportAsync();

        _isLoading = false;
        StateHasChanged();
    }

    public void Hide()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task CopyToClipboard()
    {
        if (string.IsNullOrEmpty(_json)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _json);
            _copied = true;
        }
        catch (JSException ex)
        {
            // Буфер обмена недоступен (нет https или отказ браузера) — текст всё равно виден в поле.
            Logger.LogWarning(ex, "Clipboard write failed for music export");
        }
    }

}
