@page "/npcs"
@using CampaignManager.Web.Components.Features.Campaigns.Services
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.NPC.Components
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Model
@using CampaignManager.Web.Utilities.Services
@attribute [Authorize]

@inject CharacterService CharacterService
@inject CampaignService CampaignService
@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager
@inject IdentityService IdentityService
@rendermode InteractiveServer

<PageTitle>НПС и прегены</PageTitle>

<PageHeader Title="НПС и прегены">
    <Actions>
        @if (_isKeeper)
        {
            <Button OnClick="CreateNpc" Variant="primary" Size="sm" Icon="fa-masks-theater">Добавить НПС</Button>
            <Button OnClick="CreatePregen" Variant="secondary" Size="sm" Icon="fa-user-plus">Добавить прегена</Button>
        }
    </Actions>
</PageHeader>

@if (!_isKeeper)
{
    <div class="cm-page">
        <Alert Type="error" Title="Доступ запрещён">
            Эта страница доступна только для Хранителя.
        </Alert>
    </div>
}
else
{
    <div class="cm-page">

        @if (!string.IsNullOrEmpty(_notificationMessage))
        {
            <div class="mb-4">
                <NotificationAlert Type="@_notificationType" Message="@_notificationMessage" OnClose="ClearNotification"/>
            </div>
        }

        <div class="border-b border-gray-200 mb-4">
            <nav class="flex flex-wrap gap-1 -mb-px">
                <button type="button"
                        class="px-4 py-2 text-sm font-medium rounded-t-md border-b-2 transition-colors @(_tab =="npc" ? "border-accent-500 text-accent-600 bg-white" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")"
                        @onclick='() => _tab = "npc"'>
                    <i class="fa-solid fa-masks-theater mr-1"></i> НПС (@_npcs.Count)
                </button>
                <button type="button"
                        class="px-4 py-2 text-sm font-medium rounded-t-md border-b-2 transition-colors @(_tab =="pregen" ? "border-accent-500 text-accent-600 bg-white" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")"
                        @onclick='() => _tab = "pregen"'>
                    <i class="fa-solid fa-user mr-1"></i> Прегены (@_pregens.Count)
                </button>
            </nav>
        </div>

        <FilterPanel>
            <div class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[16rem]">
                    <label class="cm-field-label">Поиск</label>
                    <input type="text" class="cm-input w-full" placeholder="Поиск по имени..."
                           @bind="_search" @bind:event="oninput"/>
                </div>
                <label class="flex items-center gap-2 cursor-pointer cm-btn cm-btn-secondary cm-btn-sm">
                    <input type="checkbox" class="cm-checkbox" checked="@_showArchived" @onchange="ToggleArchived"/>
                    Показывать архив
                </label>
            </div>
        </FilterPanel>

        @if (_isLoading)
        {
            <div class="flex justify-center p-12">
                <LoadingIndicator/>
            </div>
        }
        else if (Visible.Count == 0)
        {
            <EmptyState Title="@(_tab == "npc" ? "Нет НПС" : "Нет прегенов")"
                        Message="Создайте первого — он появится в библиотеке и будет доступен во всех сценариях."
                        IconClass="fa-users-slash"/>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var character in Visible)
                {
                    <CharacterSummaryCard Character="character"
                                          OwnerLabel="@OwnerLabel(character)"
                                          ScenarioNames="@ScenarioNamesFor(character)"
                                          OnCast="@(_tab == "npc" ? OnCastCallback : default)"
                                          OnRemove="@(character.Status == CharacterStatus.Archived ? default : OnArchiveCallback)"
                                          OnRestore="@(character.Status == CharacterStatus.Archived ? OnRestoreCallback : default)"/>
                }
            </div>
        }
    </div>

    <ConfirmationModal IsVisible="_showArchiveConfirmation"
                       OnConfirm="ArchiveAsync"
                       OnCancel="CancelArchive"
                       Title="Отправить в архив"
                       Message="@($"Отправить «{_pendingArchive?.CharacterName}» в архив? Лист останется доступен во вкладке архива.")"
                       ConfirmText="В архив"
                       IconType="warning"
                       WarningText=""/>

    @if (_castTarget is not null)
    {
        <CastNpcDialog CharacterId="_castTarget.Id"
                       CharacterName="@_castTarget.CharacterName"
                       OnCancel="CloseCastDialog"
                       OnSaved="HandleCastSaved"/>
    }
}

@code {
    private bool _isKeeper;
    private bool _isLoading = true;
    private string _tab = "npc";
    private string _search = "";
    private bool _showArchived;

    private List<CharacterStorageDto> _npcs = [];
    private List<CharacterStorageDto> _pregens = [];
    private Dictionary<Guid, List<string>> _scenarioNames = [];
    private Dictionary<Guid, string> _campaignNames = [];

    private CharacterStorageDto? _pendingArchive;
    private bool _showArchiveConfirmation;
    private CharacterStorageDto? _castTarget;

    private string? _notificationMessage;
    private string _notificationType = "success";

    private EventCallback<CharacterStorageDto> OnCastCallback => EventCallback.Factory.Create<CharacterStorageDto>(this, ShowCastDialog);
    private EventCallback<CharacterStorageDto> OnArchiveCallback => EventCallback.Factory.Create<CharacterStorageDto>(this, ConfirmArchive);
    private EventCallback<CharacterStorageDto> OnRestoreCallback => EventCallback.Factory.Create<CharacterStorageDto>(this, RestoreAsync);

    private List<CharacterStorageDto> Visible =>
        (_tab == "npc" ? _npcs : _pregens)
        .Where(c => string.IsNullOrWhiteSpace(_search)
                    || c.CharacterName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _isKeeper = await IdentityService.IsKeeper();
        if (_isKeeper)
            await LoadAsync();
        else
            _isLoading = false;
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _npcs = await CharacterService.GetNpcsAsync(null, _showArchived);
            _pregens = await CharacterService.GetPregenTemplatesAsync(_showArchived);
            _scenarioNames = await ScenarioService.GetNpcScenarioNamesAsync();

            var campaigns = await CampaignService.GetKeeperCampaignsAsync();
            _campaignNames = campaigns.ToDictionary(c => c.Id, c => c.Name);
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка при загрузке: {ex.Message}", "error");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string OwnerLabel(CharacterStorageDto character) =>
        character.CampaignId is { } campaignId && _campaignNames.TryGetValue(campaignId, out var name)
            ? $"Кампания: {name}"
            : character.CampaignId is not null
                ? "Кампания"
                : "Библиотека";

    private IReadOnlyList<string> ScenarioNamesFor(CharacterStorageDto character) =>
        _scenarioNames.TryGetValue(character.Id, out var names) ? names : [];

    private async Task ToggleArchived(ChangeEventArgs e)
    {
        _showArchived = e.Value is true;
        await LoadAsync();
    }

    private void CreateNpc() => NavigationManager.NavigateTo("/character/create/npc");

    private void CreatePregen() => NavigationManager.NavigateTo("/character/create/pregen");

    private void ConfirmArchive(CharacterStorageDto character)
    {
        _pendingArchive = character;
        _showArchiveConfirmation = true;
    }

    private void CancelArchive()
    {
        _pendingArchive = null;
        _showArchiveConfirmation = false;
    }

    private async Task ArchiveAsync()
    {
        if (_pendingArchive is null) return;

        try
        {
            await CharacterService.SetCharacterStatusAsync(_pendingArchive.Id, CharacterStatus.Archived);
            ShowNotification($"«{_pendingArchive.CharacterName}» отправлен в архив", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка при архивировании: {ex.Message}", "error");
        }
        finally
        {
            _pendingArchive = null;
            _showArchiveConfirmation = false;
        }
    }

    private async Task RestoreAsync(CharacterStorageDto character)
    {
        try
        {
            await CharacterService.SetCharacterStatusAsync(character.Id, CharacterStatus.Active);
            ShowNotification($"«{character.CharacterName}» возвращён из архива", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowNotification($"Ошибка при восстановлении: {ex.Message}", "error");
        }
    }

    private void ShowCastDialog(CharacterStorageDto character) => _castTarget = character;

    private void CloseCastDialog() => _castTarget = null;

    private async Task HandleCastSaved()
    {
        _castTarget = null;
        ShowNotification("НПС добавлен в сценарий", "success");
        await LoadAsync();
    }

    private void ShowNotification(string message, string type)
    {
        _notificationMessage = message;
        _notificationType = type;
    }

    private void ClearNotification() => _notificationMessage = null;
}
