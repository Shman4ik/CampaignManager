@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Extensions

@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager

@* Занимает НПС в сценарии. Лист персонажа не копируется — создаётся только связь,
   поэтому правки НПС видны сразу во всех сценариях, где он занят.
   Страница рисует диалог только пока он нужен, поэтому IsVisible всегда true. *@

<Modal IsVisible="true" OnClose="OnCancel" Title="НПС в сценарии" MaxWidth="md" MaxHeight="null">
    <ChildContent>
        <p class="cm-text-muted mb-4">
            «@CharacterName» появится в выбранном сценарии. Лист остаётся один: правки увидят
            все сценарии, где он занят.
        </p>

        @if (_isLoading)
        {
            <LoadingIndicator/>
        }
        else if (_scenarios.Count == 0)
        {
            <div class="text-center my-4">
                <p class="cm-text-muted">Нет доступных сценариев.</p>
                <Button OnClick="CreateNewScenario" Variant="primary" Size="sm" Icon="fa-plus" AdditionalClasses="mt-2">
                    Создать новый сценарий
                </Button>
            </div>
        }
        else
        {
            <div class="mb-4">
                <label for="scenarioSelect" class="cm-field-label">Сценарий</label>
                <select @bind="_selectedScenarioId" id="scenarioSelect" class="cm-input">
                    <option value="">— Выберите сценарий —</option>
                    @foreach (var scenario in _scenarios)
                    {
                        <option value="@scenario.Id">@scenario.Name</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="roleSelect" class="cm-field-label">Роль</label>
                    <select @bind="_role" id="roleSelect" class="cm-input">
                        @foreach (var role in Enum.GetValues<NpcRole>())
                        {
                            <option value="@role">@role.ToRussianString()</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="countInput" class="cm-field-label">Сколько</label>
                    <input type="number" id="countInput" min="1" max="20" @bind="_count" class="cm-input"/>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Type="error" ShowIcon class="mt-4 !mb-0">@_errorMessage</Alert>
        }
    </ChildContent>
    <FooterContent>
        <Button OnClick="OnCancel" Variant="secondary">Отмена</Button>
        @if (_scenarios.Count > 0)
        {
            <Button OnClick="SaveAsync" Variant="primary" IsDisabled="@(!IsFormValid)">Добавить</Button>
        }
    </FooterContent>
</Modal>

@code {
    /// <summary>Лист НПС, который занимаем в сценарии.</summary>
    [Parameter] public required Guid CharacterId { get; set; }

    /// <summary>Имя НПС — для подписи диалога.</summary>
    [Parameter] public string CharacterName { get; set; } = "";

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private List<Scenario> _scenarios = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _selectedScenarioId = "";
    private NpcRole _role = NpcRole.Neutral;
    private int _count = 1;

    private bool IsFormValid => Guid.TryParse(_selectedScenarioId, out _) && _count >= 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _scenarios = await ScenarioService.GetAllScenariosAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при загрузке сценариев: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!IsFormValid) return;

        _errorMessage = null;

        var added = await ScenarioService.AddNpcToScenarioAsync(
            Guid.Parse(_selectedScenarioId), CharacterId, _role, _count);

        if (!added)
        {
            _errorMessage = "Не удалось добавить НПС в сценарий.";
            return;
        }

        await OnSaved.InvokeAsync();
    }

    // Маршрут создания — /scenarios/new; прежний /scenarios/create вёл на «ничего не найдено».
    private void CreateNewScenario() => NavigationManager.NavigateTo("/scenarios/new");
}
