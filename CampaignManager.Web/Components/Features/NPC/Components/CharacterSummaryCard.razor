@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Extensions
@inject NavigationManager NavigationManager

@* Карточка листа НПС или прегена. Одна и та же и в библиотеке, и в сценарии:
   отличаются только переданные обработчики.
   Framed="false" — строка списка без своей рамки, для места внутри чужой карточки
   (секции «НПС сценария» и «Преген-персонажи» на странице сценария): карточка в
   карточке съедала ~35px ширины двойным отступом и читалась как мусор. Родитель
   разделяет такие строки линейкой. В сетке библиотеки /npcs карточка своя (Framed="true"). *@

<div class="@(Framed ? "cm-card overflow-hidden hover:shadow-md transition-shadow" : "")">
    <div class="@(Framed ? "cm-card-header flex-wrap" : "flex flex-wrap items-center justify-between gap-2 mb-3")">
        <span class="cm-card-title break-words">@Character.CharacterName</span>
        <div class="flex flex-wrap gap-1">
            <button type="button" class="cm-btn cm-btn-outline-primary cm-btn-sm" @onclick="() => Edit()">
                <i class="fa-solid fa-edit"></i><span>Изменить</span>
            </button>
            @if (OnCast.HasDelegate)
            {
                <button type="button" class="cm-btn cm-btn-outline-primary cm-btn-sm" @onclick="() => OnCast.InvokeAsync(Character)">
                    <i class="fa-solid fa-link"></i><span>В сценарий</span>
                </button>
            }
            @if (OnRemove.HasDelegate)
            {
                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm" @onclick="() => OnRemove.InvokeAsync(Character)">
                    <i class="fa-solid fa-trash-alt"></i><span>@RemoveLabel</span>
                </button>
            }
            @if (OnRestore.HasDelegate)
            {
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => OnRestore.InvokeAsync(Character)">
                    <i class="fa-solid fa-rotate-left"></i><span>Вернуть</span>
                </button>
            }
        </div>
    </div>
    <div class="@(Framed ? "cm-card-body" : "")">
        <!-- Вид, владелец, занятость -->
        <div class="flex flex-wrap gap-1.5 mb-3">
            <Badge Variant="@(Character.Kind == CharacterKind.Npc ? "error" : "info")" Size="sm" Rounded="full" WithBorder="false">
                <i class="fa-solid @(Character.Kind == CharacterKind.Npc ? "fa-masks-theater" : "fa-user") mr-1"></i>@Character.Kind.ToRussianString()
            </Badge>

            @if (!string.IsNullOrEmpty(OwnerLabel))
            {
                <Badge Variant="secondary" Size="sm" Rounded="full" WithBorder="false">@OwnerLabel</Badge>
            }

            @if (Character.Status == CharacterStatus.Archived)
            {
                <Badge Variant="secondary" Size="sm" Rounded="full" WithBorder="false">Архив</Badge>
            }

            @if (!string.IsNullOrEmpty(Character.Character.PersonalInfo.Occupation))
            {
                <Badge Variant="accent" Size="sm" Rounded="full" WithBorder="false">@Character.Character.PersonalInfo.Occupation</Badge>
            }

            @if (Character.Character.PersonalInfo.Age > 0)
            {
                <Badge Variant="secondary" Size="sm" Rounded="full" WithBorder="false">@Character.Character.PersonalInfo.Age лет</Badge>
            }

            @foreach (var scenarioName in ScenarioNames)
            {
                <Badge Variant="success" Size="sm" Rounded="full" WithBorder="false">
                    <i class="fa-solid fa-scroll mr-1"></i>@scenarioName
                </Badge>
            }
        </div>

        @* Роль и количество — свойства появления НПС в сценарии, а не самого листа *@
        @if (OnCastChanged.HasDelegate)
        {
            <div class="flex flex-wrap items-end gap-2 mb-3">
                <div class="w-44">
                    <label class="cm-field-label">Роль в сценарии</label>
                    <select value="@Role" @onchange="HandleRoleChanged" class="cm-input">
                        @foreach (var role in Enum.GetValues<NpcRole>())
                        {
                            <option value="@role">@role.ToRussianString()</option>
                        }
                    </select>
                </div>
                <div class="w-20">
                    <label class="cm-field-label">Сколько</label>
                    <input type="number" min="1" max="20" value="@Count" @onchange="HandleCountChanged" class="cm-input"/>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4 text-sm">
            @if (!string.IsNullOrEmpty(Character.Character.PersonalInfo.Gender))
            {
                <div><span class="font-semibold">Пол:</span> @Character.Character.PersonalInfo.Gender</div>
            }
            @if (!string.IsNullOrEmpty(Character.Character.PersonalInfo.Residence))
            {
                <div><span class="font-semibold">Место жительства:</span> @Character.Character.PersonalInfo.Residence</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Character.Character.Backstory))
        {
            <div class="w-full mt-4 text-gray-700 text-sm overflow-y-auto pr-2 custom-scrollbar max-h-[100px]">
                <h3 class="font-semibold mb-1 text-sm">Предыстория:</h3>
                @Character.Character.Backstory
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public required CharacterStorageDto Character { get; set; }

    /// <summary>
    ///     Рисовать ли собственную карточку. <c>false</c> — строка без рамки для места внутри
    ///     чужой карточки; разделять такие строки линейкой — дело родителя.
    /// </summary>
    [Parameter] public bool Framed { get; set; } = true;

    /// <summary>Кому принадлежит лист: библиотека, кампания или сценарий.</summary>
    [Parameter] public string? OwnerLabel { get; set; }

    /// <summary>Сценарии, в которых НПС уже занят.</summary>
    [Parameter] public IReadOnlyList<string> ScenarioNames { get; set; } = [];

    /// <summary>Роль в текущем сценарии — только для карточки внутри сценария.</summary>
    [Parameter] public NpcRole Role { get; set; } = NpcRole.Neutral;

    /// <summary>Сколько таких НПС выходит в текущем сценарии.</summary>
    [Parameter] public int Count { get; set; } = 1;

    /// <summary>Подпись кнопки удаления: «Архив» в библиотеке, «Убрать» в сценарии.</summary>
    [Parameter] public string RemoveLabel { get; set; } = "Архив";

    [Parameter] public EventCallback<CharacterStorageDto> OnRemove { get; set; }

    [Parameter] public EventCallback<CharacterStorageDto> OnRestore { get; set; }

    [Parameter] public EventCallback<CharacterStorageDto> OnCast { get; set; }

    /// <summary>Изменили роль или количество НПС в сценарии.</summary>
    [Parameter] public EventCallback<(CharacterStorageDto Character, NpcRole Role, int Count)> OnCastChanged { get; set; }

    private void Edit() => NavigationManager.NavigateTo($"/character/{Character.Id}");

    private async Task HandleRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<NpcRole>(e.Value?.ToString(), out var role))
            await OnCastChanged.InvokeAsync((Character, role, Count));
    }

    private async Task HandleCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count) && count >= 1)
            await OnCastChanged.InvokeAsync((Character, Role, count));
    }
}
