@using CampaignManager.Web.Components.Features.Weapons.Model
@using CampaignManager.Web.Components.Features.Weapons.Components
@using CampaignManager.Web.Components.Features.Weapons.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Extensions
@namespace CampaignManager.Web.Components.Features.Weapons.Components

<div class="cm-card overflow-hidden">
    @* Таблица — от xl (1280) и шире; уже — карточки.
       Порог именно xl, а не lg: девять колонок требуют ~1130px, портрет iPad (1024)
       их не вмещает, и таблица там уезжала вбок вместе с кнопками строки.
       Колонки таблицы XVII идут отдельными столбцами, поэтому раскрытая строка
       не повторяет их, а показывает только то, чего в колонках нет. *@
    <div class="hidden xl:block overflow-x-auto wt-table">
        <table class="cm-table">
            <thead>
            <tr>
                <SortableTableHeader Title="Название" FieldName="@nameof(Weapon.Name)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <SortableTableHeader Title="Тип" FieldName="@nameof(Weapon.Type)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <SortableTableHeader Title="Урон" FieldName="@nameof(Weapon.Damage)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <th>Дист.</th>
                <th>Атаки</th>
                <th>Боезапас</th>
                <th>Осечка</th>
                <th>Цена</th>
                <th><span class="sr-only">Действия</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var weapon in Weapons)
            {
                <WeaponTableRow Weapon="@weapon"
                                IsExpanded="@(ExpandedWeaponId == weapon.Id)"
                                ShowEra="@ShowEra"
                                OnEdit="OnEdit"
                                OnDelete="OnDelete"
                                OnToggleExpand="() => OnToggleExpand.InvokeAsync(weapon)" />
            }
            </tbody>
        </table>
    </div>

    @* Карточки ниже xl: имя и четыре самых нужных числа в строке, остальное — по раскрытию. *@
    <div class="xl:hidden divide-y divide-primary-100">
        @foreach (var weapon in Weapons)
        {
            <div class="px-3 py-2">
                <div class="flex items-start gap-2">
                    <div class="flex-1 min-w-0 cursor-pointer" @onclick="() => OnToggleExpand.InvokeAsync(weapon)">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <i class="fas @(ExpandedWeaponId == weapon.Id ? "fa-caret-down" : "fa-caret-right") w-2 text-center text-primary-300"></i>
                            <span class="font-semibold text-gray-900">@weapon.Name</span>
                            @if (weapon.IsRare)
                            {
                                <Badge Variant="warning" Size="sm" Rounded="md">редк.</Badge>
                            }
                            @if (weapon.IsImpaling)
                            {
                                <Badge Variant="warning" Size="sm" Rounded="md">пронз.</Badge>
                            }
                        </div>
                        <div class="mt-0.5 ml-4 flex flex-wrap items-center gap-x-1.5 text-xs text-primary-500">
                            <span>@weapon.Type.ToRussianString()</span>
                            <span class="text-primary-300">·</span>
                            <span class="tabular-nums font-medium text-gray-900">
                                @weapon.Damage
                                @if (weapon.DamageInfo?.IsParsed == false)
                                {
                                    <UnparsedMark />
                                }
                            </span>
                            <span class="text-primary-300">·</span>
                            <span class="tabular-nums">
                                @WeaponStatsReader.RangeDisplay(weapon)
                                @if (!WeaponStatsReader.Range(weapon).IsParsed)
                                {
                                    <UnparsedMark />
                                }
                            </span>
                            <span class="text-primary-300">·</span>
                            <span class="tabular-nums">
                                @WeaponStatsReader.AttacksDisplay(weapon)
                                @if (!WeaponStatsReader.Attacks(weapon).IsParsed)
                                {
                                    <UnparsedMark />
                                }
                            </span>
                        </div>
                    </div>
                    <button type="button" aria-label="Изменить: @weapon.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary flex-shrink-0"
                            @onclick="() => OnEdit.InvokeAsync(weapon)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" aria-label="Удалить: @weapon.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error flex-shrink-0"
                            @onclick="() => OnDelete.InvokeAsync(weapon)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>

                @if (ExpandedWeaponId == weapon.Id)
                {
                    <dl class="wt-card-details">
                        <dt>Навык</dt>
                        <dd>@weapon.Skill</dd>
                        @if (WeaponStatsReader.Ammo(weapon) is { RawText.Length: > 0 } ammo)
                        {
                            <dt>Боезапас</dt>
                            <dd>@ammo.RawText</dd>
                        }
                        @if (WeaponStatsReader.TryMalfunctionThreshold(weapon, out var threshold))
                        {
                            <dt>Осечка</dt>
                            <dd>при броске ≥ @threshold</dd>
                        }
                        else if (!string.IsNullOrEmpty(weapon.Malfunction))
                        {
                            <dt>Осечка</dt>
                            <dd>@weapon.Malfunction<UnparsedMark /></dd>
                        }
                        @if (WeaponStatsReader.Cost(weapon) is { RawText.Length: > 0 } cost)
                        {
                            <dt>Цена</dt>
                            <dd>@cost.RawText</dd>
                        }
                        @if (WeaponStatsReader.BaseRangeMeters(weapon) is { } meters)
                        {
                            <dt>Дальность</dt>
                            <dd>базовая @meters м · большая @(meters * 2) м · сверхбольшая @(meters * 4) м</dd>
                        }
                        <dt>Встречается</dt>
                        <dd>@WeaponEraText.Describe(weapon)</dd>
                        @if (!string.IsNullOrEmpty(weapon.Notes))
                        {
                            <dt>Примечания</dt>
                            <dd class="whitespace-pre-wrap">@weapon.Notes</dd>
                        }
                    </dl>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Weapon> Weapons { get; set; } = Enumerable.Empty<Weapon>();
    [Parameter] public Guid? ExpandedWeaponId { get; set; }

    /// <summary>Показывать метки эпохи в строке: смысл есть, только когда список не сужен до одной эпохи.</summary>
    [Parameter] public bool ShowEra { get; set; }

    [Parameter] public string? CurrentSortField { get; set; }
    [Parameter] public bool SortAscending { get; set; }
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    [Parameter] public EventCallback<Weapon> OnEdit { get; set; }
    [Parameter] public EventCallback<Weapon> OnDelete { get; set; }
    [Parameter] public EventCallback<Weapon> OnToggleExpand { get; set; }
}
