@using CampaignManager.Web.Components.Features.Weapons.Model
@using CampaignManager.Web.Components.Features.Weapons.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Extensions
@namespace CampaignManager.Web.Components.Features.Weapons.Components

<tr class="@(IsExpanded ? "wt-row-open" : null) cursor-pointer" @onclick="ToggleExpand">
    <td>
        <div class="flex items-center gap-1.5">
            <i class="fas @(IsExpanded ? "fa-caret-down" : "fa-caret-right") text-primary-300 w-2 text-center"></i>
            <span class="font-semibold text-gray-900">@Weapon.Name</span>
            @if (ShowEra && Weapon.Is1920)
            {
                <Badge Variant="secondary" Size="sm" Rounded="md">1920-е</Badge>
            }
            @if (ShowEra && Weapon.IsModern)
            {
                <Badge Variant="secondary" Size="sm" Rounded="md">наши дни</Badge>
            }
            @if (Weapon.IsRare)
            {
                <Badge Variant="warning" Size="sm" Rounded="md">редк.</Badge>
            }
            @if (Weapon.IsImpaling)
            {
                <Badge Variant="warning" Size="sm" Rounded="md">пронз.</Badge>
            }
        </div>
    </td>
    <td class="text-primary-500">@Weapon.Type.ToRussianString()</td>
    <td class="text-primary-500">@Weapon.Skill</td>
    <td class="tabular-nums whitespace-nowrap font-medium text-gray-900">
        @Weapon.Damage
        @if (Weapon.DamageInfo?.IsParsed == false)
        {
            <UnparsedMark />
        }
    </td>
    <td class="tabular-nums whitespace-nowrap">
        @WeaponStatsReader.RangeDisplay(Weapon)
        @if (!WeaponStatsReader.Range(Weapon).IsParsed)
        {
            <UnparsedMark />
        }
    </td>
    <td class="tabular-nums">
        @WeaponStatsReader.AttacksDisplay(Weapon)
        @if (!WeaponStatsReader.Attacks(Weapon).IsParsed)
        {
            <UnparsedMark />
        }
    </td>
    <td class="tabular-nums whitespace-nowrap">@WeaponStatsReader.Ammo(Weapon).RawText</td>
    <td class="tabular-nums whitespace-nowrap">
        @if (WeaponStatsReader.TryMalfunctionThreshold(Weapon, out var threshold))
        {
            <text>≥ @threshold</text>
        }
        else if (!string.IsNullOrEmpty(Weapon.Malfunction))
        {
            @Weapon.Malfunction
            <UnparsedMark />
        }
    </td>
    <td class="tabular-nums whitespace-nowrap">@WeaponStatsReader.Cost(Weapon).RawText</td>
    <td @onclick:stopPropagation="true">
        <div class="flex gap-1 justify-end">
            <button type="button" aria-label="Изменить: @Weapon.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary"
                    @onclick="() => OnEdit.InvokeAsync(Weapon)">
                <i class="fas fa-pen"></i>
            </button>
            <button type="button" aria-label="Удалить: @Weapon.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error"
                    @onclick="() => OnDelete.InvokeAsync(Weapon)">
                <i class="fas fa-trash-alt"></i>
            </button>
        </div>
    </td>
</tr>

@if (IsExpanded)
{
    @* В строке уже стоит всё из таблицы XVII — здесь только то, чего в колонках нет. *@
    <tr class="wt-details">
        <td colspan="10">
            <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-primary-600">
                @if (WeaponStatsReader.BaseRangeMeters(Weapon) is { } meters)
                {
                    <div>
                        <span class="wt-label">Дальность</span>
                        базовая @meters м · большая @(meters * 2) м · сверхбольшая @(meters * 4) м
                    </div>
                }
                @if (WeaponStatsReader.AmmoCapacity(Weapon) is { } capacity)
                {
                    <div>
                        <span class="wt-label">Магазин</span>
                        @capacity выстрелов
                    </div>
                }
                @if (!ShowEra)
                {
                    <div>
                        <span class="wt-label">Встречается</span>
                        @EraText
                    </div>
                }
                @if (!string.IsNullOrEmpty(Weapon.Notes))
                {
                    <div class="basis-full">
                        <span class="wt-label">Примечания</span>
                        <span class="whitespace-pre-wrap">@Weapon.Notes</span>
                    </div>
                }
                @if (!HasDetails)
                {
                    <div class="text-primary-400">Всё об этом оружии уже показано в строке.</div>
                }
            </div>
        </td>
    </tr>
}

@code {
    [Parameter] public Weapon Weapon { get; set; } = new();
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>Показывать метки эпохи в строке: смысл есть, только когда список не сужен до одной эпохи.</summary>
    [Parameter] public bool ShowEra { get; set; }

    [Parameter] public EventCallback<Weapon> OnEdit { get; set; }
    [Parameter] public EventCallback<Weapon> OnDelete { get; set; }
    [Parameter] public EventCallback OnToggleExpand { get; set; }

    private string EraText => WeaponEraText.Describe(Weapon);

    private bool HasDetails =>
        WeaponStatsReader.BaseRangeMeters(Weapon) is not null
        || WeaponStatsReader.AmmoCapacity(Weapon) is not null
        || !ShowEra
        || !string.IsNullOrEmpty(Weapon.Notes);

    private Task ToggleExpand() => OnToggleExpand.InvokeAsync();
}
