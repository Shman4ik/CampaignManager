@using CampaignManager.Web.Components.Features.Combat.Components.Attack
@using CampaignManager.Web.Components.Features.Combat.Model
@using CampaignManager.Web.Components.Features.Combat.Services
@using CampaignManager.Web.Extensions

@inject CombatService CombatService

@* Настройка атаки. Общая часть — кто бьёт, чем и по кому — здесь, а разделы по виду атаки
   вынесены в Components/Attack: дальний бой (AttackRangedOptions), защита в ближнем бою
   (AttackDefenseOptions), броски (AttackRollInputs), модификаторы (AttackModifierOptions)
   и урон (AttackDamageInputs). Все они правят один AttackSetupState. *@

<div>
    <h4 class="text-base font-semibold text-gray-900 mb-3">Настройка атаки</h4>

    <!-- Атакующий -->
    <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Атакующий</label>
        <select class="border border-primary-300 rounded-md px-2 py-1.5 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"
                value="@_state.SelectedAttackerId"
                @onchange="OnAttackerChanged">
            <option value="">— Выберите —</option>
            @foreach (var c in AvailableAttackers)
            {
                <option value="@c.Id">@c.Name (@c.Side.ToRussianString())</option>
            }
        </select>
    </div>

    @if (_state.SelectedAttacker != null)
    {
        @if (AttackBlockReason is { } blockReason)
        {
            <div class="mb-3 rounded-md border border-warning-300 bg-warning-50 p-2 text-xs text-warning-800">
                <i class="fa-solid fa-triangle-exclamation mr-1"></i>@blockReason
            </div>
        }

        <!-- Оружие / Атака -->
        <div class="mb-3">
            <label class="block text-xs font-medium text-gray-600 mb-1">Оружие / Атака</label>
            <select class="border border-primary-300 rounded-md px-2 py-1.5 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"
                    value="@_state.SelectedWeaponIndex"
                    @onchange="OnWeaponChanged">
                <option value="-1">— Выберите —</option>
                @for (var i = 0; i < _state.AttackOptions.Count; i++)
                {
                    <option value="@i">@_state.AttackOptions[i].Name — @_state.AttackOptions[i].Damage</option>
                }
            </select>
        </div>

        @if (_state.SelectedWeaponIndex >= 0)
        {
            <!-- Тип атаки -->
            <div class="mb-2 text-xs">
                <span class="inline-block px-2 py-0.5 rounded font-medium @(_state.IsMelee ? "bg-warning-100 text-warning-700" : "bg-accent-100 text-accent-700")">
                    @(_state.IsMelee ? "Ближний бой" : "Дальний бой")
                </span>
            </div>

            <!-- Навык атаки -->
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-600 mb-1">Навык атаки</label>
                <input type="number" @bind="_state.AttackSkillValue"
                       class="border border-primary-300 rounded-md px-2 py-1 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors" />
            </div>

            <!-- Дальность, заклинившее оружие, режим стрельбы и патроны (только для дальнего боя) -->
            @if (!_state.IsMelee)
            {
                <AttackRangedOptions State="_state" OnChanged="Refresh" />
            }

            <!-- Цель -->
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-600 mb-1">Цель</label>
                <select class="border border-primary-300 rounded-md px-2 py-1.5 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500 hover:border-primary-400 hover:bg-white transition-colors"
                        value="@_state.SelectedDefenderId"
                        @onchange="OnDefenderChanged">
                    <option value="">— Выберите —</option>
                    @foreach (var c in AvailableDefenders)
                    {
                        <option value="@c.Id">@c.Name (@c.Side.ToRussianString())</option>
                    }
                </select>
            </div>

            @if (_state.SelectedDefender != null && _state.IsMelee)
            {
                <AttackDefenseOptions State="_state" OnChanged="Refresh" />
            }

            <!-- ═══ БРОСКИ КУБИКОВ ═══ -->
            <div class="border-t border-gray-200 pt-3 mt-3">
                <div class="text-xs font-semibold text-gray-700 mb-2 uppercase tracking-wide">Броски кубиков</div>

                <AttackRollInputs State="_state" OnChanged="Refresh" />

                <AttackModifierOptions State="_state" OnChanged="Refresh" />

                <!-- Урон (показывается когда бросок введён и атака успешна) -->
                @if (_state.AttackerRoll.HasValue && _state.AttackConnects)
                {
                    <AttackDamageInputs State="_state" OnChanged="Refresh" />
                }
            </div>

            <!-- Кнопка атаки -->
            <button type="button" class="cm-btn cm-btn-error w-full" @onclick="ResolveAttack" disabled="@(!CanResolve())">
                <span>Провести атаку</span>
            </button>
        }
    }
</div>
