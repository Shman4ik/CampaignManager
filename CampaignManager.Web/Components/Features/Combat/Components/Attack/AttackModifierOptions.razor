@* Свёрнутый блок «Модификаторы и условия»: кости от Хранителя, броня, готовность цели
   (стр. 104) и модификаторы стрельбы (стр. 110–113). Всё это меняет итог костей над броском,
   поэтому каждая правка перерисовывает панель целиком. *@

<!-- Модификаторы (скрываются) -->
<details class="mb-3">
    <summary class="text-xs font-medium text-gray-500 cursor-pointer hover:text-gray-700">Модификаторы и условия</summary>
    <div class="mt-2 space-y-2 pl-1">
        <div class="flex items-center gap-3">
            <label class="text-xs text-gray-600 w-36 shrink-0">Бонусные кости</label>
            <input type="number" min="0" max="2" @bind="State.BonusDice" @bind:after="Changed"
                   class="border border-primary-300 rounded-md px-2 py-1 text-sm w-16 focus:outline-none" />
        </div>
        <div class="flex items-center gap-3">
            <label class="text-xs text-gray-600 w-36 shrink-0">Штрафные кости</label>
            <input type="number" min="0" max="2" @bind="State.PenaltyDice" @bind:after="Changed"
                   class="border border-primary-300 rounded-md px-2 py-1 text-sm w-16 focus:outline-none" />
        </div>
        @if (State.IsMelee && State.SelectedDefender != null)
        {
            <div class="flex items-center gap-3">
                <label class="text-xs text-gray-600 w-36 shrink-0">Бонусные защитнику</label>
                <input type="number" min="0" max="2" @bind="State.DefenderBonusDice" @bind:after="Changed"
                       class="border border-primary-300 rounded-md px-2 py-1 text-sm w-16 focus:outline-none" />
            </div>
            <div class="flex items-center gap-3">
                <label class="text-xs text-gray-600 w-36 shrink-0">Штрафные защитнику</label>
                <input type="number" min="0" max="2" @bind="State.DefenderPenaltyDice" @bind:after="Changed"
                       class="border border-primary-300 rounded-md px-2 py-1 text-sm w-16 focus:outline-none" />
            </div>
        }
        <p class="text-xs text-gray-400">
            Кости применяются к бросающимся автоматически. Если вы вводите результат
            своих физических костей вручную, модификаторы уже должны быть в нём учтены.
        </p>
        <div class="border-t border-gray-200 pt-2 mt-2">
            <div class="text-xs font-semibold text-gray-500 mb-1">Броня и тип урона (стр. 106, 125)</div>
            <label class="flex items-start gap-2 text-xs text-gray-700 cursor-pointer">
                <input type="checkbox" class="mt-0.5" @bind="State.IgnoresArmor" @bind:after="Changed" />
                <span>Урон не снижается бронёй — магия, яд, утопление</span>
            </label>
            <div class="mt-1 flex items-center gap-2">
                <label class="text-xs text-gray-600">Броня преграды</label>
                <input type="number" min="0" @bind="State.CoverArmor" @bind:after="Changed"
                       class="border border-primary-300 rounded px-2 py-0.5 text-xs w-16 focus:outline-none" />
                <span class="text-xs text-gray-400">при стрельбе сквозь укрытие: забор 1, кирпичная стенка 10</span>
            </div>
        </div>

        <div class="border-t border-gray-200 pt-2 mt-2">
            <div class="text-xs font-semibold text-gray-500 mb-1">Готовность цели (стр. 104)</div>
            <div class="space-y-1">
                <label class="flex items-start gap-2 text-xs text-gray-700 cursor-pointer">
                    <input type="radio" name="surprise" class="mt-0.5"
                           checked="@(State.Surprise == SurpriseMode.TargetReady)"
                           @onchange="() => SetSurprise(SurpriseMode.TargetReady)" />
                    <span>Цель начеку — сама выбирает уклонение или контратаку</span>
                </label>
                <label class="flex items-start gap-2 text-xs text-gray-700 cursor-pointer">
                    <input type="radio" name="surprise" class="mt-0.5"
                           checked="@(State.Surprise == SurpriseMode.AutoHit)"
                           @onchange="() => SetSurprise(SurpriseMode.AutoHit)" />
                    <span>Не готова, атака предрешена — попадание автоматическое, кроме краха
                          <span class="text-gray-400">(удар по голове незамеченным противником)</span></span>
                </label>
                <label class="flex items-start gap-2 text-xs text-gray-700 cursor-pointer">
                    <input type="radio" name="surprise" class="mt-0.5"
                           checked="@(State.Surprise == SurpriseMode.BonusDie)"
                           @onchange="() => SetSurprise(SurpriseMode.BonusDie)" />
                    <span>Не готова, исход не предрешён — бонусная кость
                          <span class="text-gray-400">(попытка вырвать оружие)</span></span>
                </label>
            </div>
        </div>

        @if (!State.IsMelee)
        {
            <div class="border-t border-gray-200 pt-2 mt-2">
                <div class="text-xs font-semibold text-gray-500 mb-1">Модификаторы стрельбы</div>
                <div class="space-y-1">
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsPointBlank" @bind:after="Changed" />
                        В упор (≤ЛВК/15 м) → +1 бонусная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsAiming" @bind:after="Changed" />
                        Прицеливание (потрачен раунд) → +1 бонусная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsTargetTakingCover" @bind:after="Changed" />
                        Цель укрылась от огня → +1 штрафная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsTargetBehindCover" @bind:after="Changed" />
                        Частичное укрытие (≥50%) → +1 штрафная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsTargetFastMoving" @bind:after="Changed" />
                        Быстро движущаяся цель (СКО ≥8) → +1 штрафная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsFiringIntoMelee" @bind:after="Changed" />
                        Стрельба в ближнем бою → +1 штрафная
                    </label>
                    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                        <input type="checkbox" @bind="State.IsReloadAndFire" @bind:after="Changed" />
                        Зарядка + выстрел → +1 штрафная
                    </label>
                </div>

            </div>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public required AttackSetupState State { get; set; }

    /// <summary>Что-то поменялось — панель перерисовывается целиком, как до разбиения на части.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task Changed() => OnChanged.InvokeAsync();

    private Task SetSurprise(SurpriseMode mode)
    {
        State.SetSurprise(mode);
        return Changed();
    }
}
