@* Броски атаки и защиты: итог костей, поле броска с кнопкой «авто» и уровень успеха у каждого,
   плюс пояснение, если цель застигнута врасплох. Уровень успеха и кости считает CombatService —
   тем же расчётом, что и при разрешении атаки. *@

<!-- Итог модификаторов: виден всегда, чтобы бросок не был сюрпризом -->
@{
    var mods = State.CurrentModifiers();
    var attacker = State.SelectedAttacker!;
}
@if (mods.BonusDice > 0 || mods.PenaltyDice > 0)
{
    <div class="mb-3 rounded-md border border-gray-200 bg-gray-50 p-2">
        <div class="text-xs font-semibold text-gray-700">
            @if (mods.Net > 0)
            {
                <span class="text-success-700">@CombatService.DescribeDice(mods.Net, true) к броску атаки</span>
            }
            else if (mods.Net < 0)
            {
                <span class="text-error-700">@CombatService.DescribeDice(-mods.Net, false) к броску атаки</span>
            }
            else
            {
                <span class="text-gray-600">Кости взаимно погашены</span>
            }
            <span class="font-normal text-gray-400"> (+@mods.BonusDice / −@mods.PenaltyDice)</span>
        </div>
        <ul class="mt-1 space-y-0.5">
            @foreach (var reason in mods.Reasons)
            {
                <li class="text-xs text-gray-500">@reason</li>
            }
        </ul>
    </div>
}


<!-- Бросок атакующего -->
<div class="mb-3">
    <div class="flex items-center gap-2">
        <label class="text-xs font-medium text-gray-600 w-36 shrink-0">
            @attacker.Name (d100)
        </label>
        <input type="number" min="1" max="100"
               value="@State.AttackerRoll"
               @oninput="e => EnterRoll(e, isAttacker: true)"
               class="border border-primary-300 rounded-md px-2 py-1 text-sm text-primary-700 bg-primary-50 w-20 focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500"
               placeholder="1–100" />
        <button @onclick="AutoRollAttacker" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 whitespace-nowrap"><i class="fa-solid fa-dice-d20 mr-1"></i>авто</button>
    </div>
    @if (State.AttackerRoll.HasValue)
    {
        <div class="mt-0.5 ml-36 text-xs font-medium @CombatService.GetSuccessLevelColor(State.AttackerSuccessLevel)">
            → @CombatService.GetSuccessLevelText(State.AttackerSuccessLevel)
            @if (State.AttackerRollDetail is { HasExtraDice: true })
            {
                <span class="ml-1 font-normal text-gray-500">@CombatService.FormatRollDetail(State.AttackerRollDetail)</span>
            }
            @if (!State.IsMelee && State.RequiredLevel != SuccessLevel.RegularSuccess)
            {
                var required = State.RequiredLevel;
                <span>&#160;</span>
                <span class="font-normal @(State.AttackerSuccessLevel < required ? "text-error-600" : "text-success-700")">
                    @(State.AttackerSuccessLevel < required
                        ? $"— нужен {CombatService.GetDifficultyName(required)} успех"
                        : "— сложности хватает")
                </span>
            }
        </div>
    }
</div>

<!-- Бросок защитника (ближний бой) -->
@if (State.IsMelee && State.SelectedDefender != null && State.EffectiveSurprise == SurpriseMode.TargetReady)
{
    <div class="mb-3">
        <div class="flex items-center gap-2">
            <label class="text-xs font-medium text-gray-600 w-36 shrink-0">
                @State.SelectedDefender.Name (d100)
            </label>
            <input type="number" min="1" max="100"
                   value="@State.DefenderRoll"
                   @oninput="e => EnterRoll(e, isAttacker: false)"
                   class="border border-primary-300 rounded-md px-2 py-1 text-sm text-primary-700 bg-primary-50 w-20 focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500"
                   placeholder="1–100" />
            <button @onclick="AutoRollDefender" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 whitespace-nowrap"><i class="fa-solid fa-dice-d20 mr-1"></i>авто</button>
        </div>
        @if (State.DefenderRoll.HasValue)
        {
            <div class="mt-0.5 ml-36 text-xs font-medium @CombatService.GetSuccessLevelColor(State.DefenderSuccessLevel)">
                → @CombatService.GetSuccessLevelText(State.DefenderSuccessLevel)
                @if (State.DefenderRollDetail is { HasExtraDice: true })
                {
                    <span class="ml-1 font-normal text-gray-500">@CombatService.FormatRollDetail(State.DefenderRollDetail)</span>
                }
            </div>
        }
    </div>
}
@if (State.EffectiveSurprise != SurpriseMode.TargetReady)
{
    <div class="mb-3 text-xs text-warning-700 bg-warning-50 rounded p-2">
        @if (State.EffectiveSurprise == SurpriseMode.AutoHit)
        {
            <text>Цель застигнута врасплох: она не защищается, а атака проходит
            автоматически — промахом считается только крах.</text>
        }
        else
        {
            <text>Цель застигнута врасплох: она не защищается, атакующий получает
            бонусную кость.</text>
            @if (!State.IsMelee && State.Surprise == SurpriseMode.AutoHit)
            {
                <text> Для дистанционной атаки автоматическое попадание правилами
                не допускается (стр. 105), поэтому применена бонусная кость.</text>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public required AttackSetupState State { get; set; }

    /// <summary>Что-то поменялось — панель перерисовывается целиком, как до разбиения на части.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task EnterRoll(ChangeEventArgs e, bool isAttacker)
    {
        State.EnterRoll(e.Value?.ToString(), isAttacker);
        return OnChanged.InvokeAsync();
    }

    private Task AutoRollAttacker()
    {
        State.AutoRollAttacker();
        return OnChanged.InvokeAsync();
    }

    private Task AutoRollDefender()
    {
        State.AutoRollDefender();
        return OnChanged.InvokeAsync();
    }
}
