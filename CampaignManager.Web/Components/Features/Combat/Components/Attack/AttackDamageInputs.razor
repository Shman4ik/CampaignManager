@* Урон попавшей атаки: оружие, бонус к урону, проникающая рана при чрезвычайном успехе
   (стр. 101, 110) и урон контратаки, если защитник победил ответным ударом. Панель рисует блок,
   только когда бросок введён и атака попадает. *@

@{
    var attacker = State.SelectedAttacker!;
    var option = State.AttackOptions[State.SelectedWeaponIndex];
    bool isExtraordinary = State.AttackerSuccessLevel >= SuccessLevel.ExtremeSuccess;
    bool isImpaling = CombatService.IsImpalingWeapon(option.Weapon ?? new Weapon { Name = option.Name, Type = WeaponType.Melee });
    var dbType = CombatService.ResolveDamageBonusType(State.IsMelee, option.Weapon?.DamageInfo?.GetDefaultDamage());
    var appliesDb = dbType != DamageBonusType.None && attacker.DamageBonus != "0";
}

<div class="bg-gray-50 rounded-md border border-gray-100 p-3 mb-3">
    <div class="text-xs font-semibold text-gray-600 mb-2">
        Урон (@option.Damage
        @if (appliesDb)
        {
            <span> + @(dbType == DamageBonusType.Half ? "половина Б.к.У." : "Б.к.У.") @attacker.DamageBonus</span>
        })
    </div>

    @if (isExtraordinary)
    {
        var maxDmg = CombatService.MaximizeDiceFormula(option.Damage);
        var rawMaxDb = appliesDb ? CombatService.MaximizeDiceFormula(attacker.DamageBonus) : 0;
        var maxDb = dbType == DamageBonusType.Half ? rawMaxDb / 2 : rawMaxDb;
        <div class="text-xs text-success-700 mb-2">
            @(isImpaling ? "Проникающая рана" : "Чрезвычайный успех") — максимальный урон:
            <strong>@maxDmg@(maxDb != 0 ? $" + {maxDb}" : "")</strong>
            @if (isImpaling) { <span> + доп. бросок @option.Damage</span> }
        </div>
        @if (isImpaling)
        {
            <div class="flex items-center gap-2 mb-1">
                <label class="text-xs text-gray-600 w-36 shrink-0">Доп. бросок (@option.Damage)</label>
                <input type="number" min="0" value="@State.ExtraImpalingRoll"
                       @oninput="e => EnterDamage(e, AttackDamageField.ExtraImpaling)"
                       class="border border-primary-300 rounded-md px-2 py-1 text-xs w-20 focus:outline-none"
                       placeholder="рез." />
                <button @onclick="() => AutoRollDamage(AttackDamageField.ExtraImpaling, option.Damage)" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20"></i></button>
            </div>
        }
    }
    else
    {
        <div class="flex items-center gap-2 mb-1">
            <label class="text-xs text-gray-600 w-36 shrink-0">Урон оружия</label>
            <input type="number" min="0" value="@State.WeaponDamageRoll"
                   @oninput="e => EnterDamage(e, AttackDamageField.Weapon)"
                   class="border border-primary-300 rounded-md px-2 py-1 text-xs w-20 focus:outline-none"
                   placeholder="рез." />
            <button @onclick="() => AutoRollDamage(AttackDamageField.Weapon, option.Damage)" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20"></i></button>
        </div>
        @if (appliesDb)
        {
            <div class="flex items-center gap-2 mb-1">
                <label class="text-xs text-gray-600 w-36 shrink-0">
                    @(dbType == DamageBonusType.Half ? "½ Б.к.У." : "Б.к.У.") (@attacker.DamageBonus)
                </label>
                <input type="number" value="@State.DamageBonusRoll"
                       @oninput="e => EnterDamage(e, AttackDamageField.DamageBonus)"
                       class="border border-primary-300 rounded-md px-2 py-1 text-xs w-20 focus:outline-none"
                       placeholder="рез." />
                <button @onclick="() => AutoRollDamage(AttackDamageField.DamageBonus, attacker.DamageBonus)" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20"></i></button>
            </div>
        }
    }

    <!-- Контратака (fight back защитника победил) -->
    @if (State.DefenderReaction == CombatActionType.FightBack && State.DefenderRoll.HasValue
         && !State.ResolveOpposed())
    {
        var defender = State.SelectedDefender!;
        <div class="border-t border-gray-200 pt-2 mt-2">
            <div class="text-xs font-semibold text-error-700 mb-1">Контратака @defender.Name</div>
            <div class="flex items-center gap-2 mb-1">
                <label class="text-xs text-gray-600 w-36 shrink-0">Урон контратаки</label>
                <input type="number" min="0" value="@State.CounterWeaponRoll"
                       @oninput="e => EnterDamage(e, AttackDamageField.CounterWeapon)"
                       class="border border-primary-300 rounded-md px-2 py-1 text-xs w-20 focus:outline-none"
                       placeholder="рез." />
                <button @onclick='() => AutoRollDamage(AttackDamageField.CounterWeapon, State.CounterDamageFormula)' class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20"></i></button>
            </div>
            @if (defender.DamageBonus != "0")
            {
                <div class="flex items-center gap-2 mb-1">
                    <label class="text-xs text-gray-600 w-36 shrink-0">БкУ (@defender.DamageBonus)</label>
                    <input type="number" value="@State.CounterBonusRoll"
                           @oninput="e => EnterDamage(e, AttackDamageField.CounterBonus)"
                           class="border border-primary-300 rounded-md px-2 py-1 text-xs w-20 focus:outline-none"
                           placeholder="рез." />
                    <button @onclick='() => AutoRollDamage(AttackDamageField.CounterBonus, defender.DamageBonus)' class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20"></i></button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required AttackSetupState State { get; set; }

    /// <summary>Что-то поменялось — панель перерисовывается целиком, как до разбиения на части.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task EnterDamage(ChangeEventArgs e, AttackDamageField field)
    {
        State.EnterDamage(e.Value?.ToString(), field);
        return OnChanged.InvokeAsync();
    }

    private Task AutoRollDamage(AttackDamageField field, string formula)
    {
        State.AutoRollDamage(field, formula);
        return OnChanged.InvokeAsync();
    }
}
