@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Combat.Model
@using CampaignManager.Web.Components.Features.Combat.Services
@using CampaignManager.Web.Components.Features.Spells.Model
@using CampaignManager.Web.Components.Features.Spells.Services

@inject CombatService CombatService
@inject SpellService SpellService

@* Вкладка «Заклинание» боевого помощника. Правила считает CombatService (CombatService.Spells.cs),
   числа из текста стоимости подсказывает SpellStatsReader, а Хранитель их подтверждает. Своей
   карточки нет: панель рисуется внутри cm-card страницы, как соседние вкладки. *@

<div data-testid="spell-cast-panel">
    <h4 class="text-base font-semibold text-gray-900 mb-3">Сотворить заклинание</h4>

    <div class="mb-3">
        <label for="spell-caster" class="cm-field-label">Заклинатель</label>
        <select id="spell-caster" class="cm-input" value="@_casterId" @onchange="OnCasterChanged">
            <option value="">— Выберите —</option>
            @foreach (var c in AvailableCasters)
            {
                <option value="@c.Id">@c.Name (ПМ @c.CurrentMagicPoints/@c.MaxMagicPoints · МОЩ @CombatService.GetPower(c))</option>
            }
        </select>
    </div>

    @if (_caster is { } caster)
    {
        @if (_pending is { } pending)
        {
            @PendingView(pending)
        }
        else if (caster.CastingSpell is { } casting)
        {
            @InProgressView(caster, casting)
        }
        else
        {
            @SetupView(caster)
        }
    }
</div>

@code {
    [Parameter] public List<Combatant> Combatants { get; set; } = [];
    [Parameter] public Guid? ActiveCombatantId { get; set; }

    private const string SheetPrefix = "sheet:";
    private const string CatalogPrefix = "catalog:";
    private const string CustomKey = "custom";

    private Guid? _lastActiveId;
    private string _casterId = "";
    private Combatant? _caster;
    private List<Spell> _catalog = [];
    private bool _showCatalog;

    // Заклинание и цена
    private string _spellKey = "";
    private Spell? _spell;
    private string _customName = "";
    private SpellStatsReader.CostEstimate _cost = new(null, null, null, null);
    private SpellStatsReader.CastingTimeEstimate _time = new(null, null, false, false);
    private int _magicPoints;
    private int _sanity;
    private int _power;
    private int _hitPoints;
    private int _rounds = 1;

    // Цель и проверки
    private string _targetId = "";
    private bool _resists;
    private bool _firstCast;
    private bool _pushed;

    // Ручные броски: пусто — бросит программа
    private int? _castingRoll;
    private int? _pushRoll;
    private int? _casterPowerRoll;
    private int? _targetPowerRoll;
    private int? _intRoll;
    private int? _durationRoll;
    private int? _conRoll;

    private CombatActionResult? _pending;

    protected override async Task OnInitializedAsync()
    {
        _catalog = (await SpellService.GetAllSpellsAsync())
            .OrderBy(s => s.Name, StringComparer.CurrentCulture)
            .ToList();
    }

    protected override void OnParametersSet()
    {
        // Как в соседних вкладках: заклинателем по умолчанию становится тот, чей ход.
        if (ActiveCombatantId.HasValue && ActiveCombatantId != _lastActiveId)
        {
            _lastActiveId = ActiveCombatantId;
            var active = Combatants.FirstOrDefault(c => c.Id == ActiveCombatantId.Value && !c.IsDead && !c.IsUnconscious);
            if (active is not null && _pending is null)
                SelectCaster(active);
        }

        // Участника могли убрать из боя, пока вкладка была закрыта.
        if (_caster is not null && !Combatants.Contains(_caster))
            SelectCaster(null);
    }

    private IEnumerable<Combatant> AvailableCasters => Combatants.Where(c => !c.IsDead);

    private IEnumerable<Combatant> AvailableTargets => Combatants.Where(c => !c.IsDead && c.Id != _caster?.Id);

    private Combatant? Target => Guid.TryParse(_targetId, out var id) ? Combatants.FirstOrDefault(c => c.Id == id) : null;

    private string SpellName => _spellKey == CustomKey ? _customName.Trim() : _spell?.Name ?? "";

    private void OnCasterChanged(ChangeEventArgs e) =>
        SelectCaster(Guid.TryParse(e.Value?.ToString(), out var id) ? Combatants.FirstOrDefault(c => c.Id == id) : null);

    private void SelectCaster(Combatant? caster)
    {
        _caster = caster;
        _casterId = caster?.Id.ToString() ?? "";
        _pending = null;
        _showCatalog = false;
        _targetId = "";
        _resists = false;
        _firstCast = false;
        _pushed = false;
        SelectSpell("");
        ResetRolls();
    }

    private void ResetRolls()
    {
        _castingRoll = null;
        _pushRoll = null;
        _casterPowerRoll = null;
        _targetPowerRoll = null;
        _intRoll = null;
        _durationRoll = null;
        _conRoll = null;
    }

    private void OnSpellChanged(ChangeEventArgs e) => SelectSpell(e.Value?.ToString() ?? "");

    /// <summary>Выбор заклинания подставляет разобранную цену и время — Хранитель их поправит.</summary>
    private void SelectSpell(string key)
    {
        _spellKey = key;
        _spell = key switch
        {
            // Заклинания листа — по позиции: у старых копий в JSONB Id бывает пустым и одинаковым.
            _ when key.StartsWith(SheetPrefix, StringComparison.Ordinal)
                   && int.TryParse(key[SheetPrefix.Length..], out var index) =>
                _caster?.CharacterSource?.Spells.ElementAtOrDefault(index),
            _ when key.StartsWith(CatalogPrefix, StringComparison.Ordinal) =>
                _catalog.FirstOrDefault(s => s.Id.ToString() == key[CatalogPrefix.Length..]),
            _ => null
        };

        _cost = SpellStatsReader.ParseCost(_spell?.Cost);
        _time = SpellStatsReader.ParseCastingTime(_spell?.CastingTime);
        _magicPoints = SpellStatsReader.FixedAmount(_cost.MagicPoints) ?? 0;
        _sanity = SpellStatsReader.FixedAmount(_cost.Sanity) ?? 0;
        _power = SpellStatsReader.FixedAmount(_cost.Power) ?? 0;
        _hitPoints = SpellStatsReader.FixedAmount(_cost.HitPoints) ?? 0;
        _rounds = _time.Rounds ?? 1;
    }

    private static int Roll(string formula) => Math.Max(0, CombatService.RollDiceFormula(formula));

    private static int? ParseRoll(ChangeEventArgs e, int max = 100) =>
        int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, 1, max) : null;

    private static int ParseAmount(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0;

    /// <summary>
    ///     Худший множитель цены: провал повторной проверки добавляет ещё ×1d6, то есть до ×7.
    ///     Поле для броска последствия лишним не бывает — пустое бросит программа.
    /// </summary>
    private static int CostFactor(bool pushed) => pushed ? 7 : 1;

    /// <summary>
    ///     Сколько ПЗ может снять цена — чтобы заранее спросить проверку ВЫН, если рана будет
    ///     серьёзной. Срыв сотворения явную цену в ПЗ не берёт, только нехватку ПМ.
    /// </summary>
    private static int PredictedHitPointLoss(Combatant caster, SpellCastSetup setup, bool pushed, bool includeHitPointsCost)
    {
        var factor = CostFactor(pushed);
        var shortfall = Math.Max(0, setup.MagicPointsCost * factor - Math.Max(0, caster.CurrentMagicPoints));
        return shortfall + (includeHitPointsCost ? setup.HitPointsCost * factor : 0);
    }

    private static bool NeedsIntRoll(Combatant caster, SpellCastSetup setup, bool pushed) =>
        CombatService.HasSanity(caster) && setup.SanityCost * CostFactor(pushed) >= SanityRules.TemporaryInsanityThreshold;

    private static bool NeedsConRoll(Combatant caster, SpellCastSetup setup, bool pushed, bool includeHitPointsCost) =>
        PredictedHitPointLoss(caster, setup, pushed, includeHitPointsCost) is > 0 and var loss
        && WoundRules.IsMajorWound(loss, caster.MaxHitPoints);

    private SpellCastSetup BuildSetup(Combatant caster) => new()
    {
        CasterId = caster.Id,
        SpellId = _spell?.Id,
        SpellName = SpellName,
        CostText = _spell?.Cost,
        CastingTimeText = _spell?.CastingTime,
        MagicPointsCost = _magicPoints,
        SanityCost = CombatService.HasSanity(caster) ? _sanity : 0,
        PowerCost = _power,
        HitPointsCost = _hitPoints,
        CastingRounds = Math.Max(0, _rounds),
        TargetId = Target?.Id,
        TargetResists = _resists && Target is not null,
        IsFirstCast = _firstCast && caster.CharacterSource is not null,
        IsPushed = _pushed && _firstCast && caster.CharacterSource is not null
    };

    private SpellCastSetup WithRolls(SpellCastSetup setup)
    {
        setup.ManualCastingRoll = _castingRoll;
        setup.ManualPushMultiplier = _pushRoll;
        setup.ManualCasterPowerRoll = _casterPowerRoll;
        setup.ManualTargetPowerRoll = _targetPowerRoll;
        setup.ManualIntRoll = _intRoll;
        setup.ManualInsanityDurationRoll = _durationRoll;
        setup.ManualMajorWoundConRoll = _conRoll;
        return setup;
    }

    private void Cast(Combatant caster)
    {
        var setup = BuildSetup(caster);
        if (string.IsNullOrWhiteSpace(setup.SpellName))
            return;

        if (setup.CastingRounds >= 2)
        {
            CombatService.StartSpellcasting(setup);
            ResetRolls();
            return;
        }

        _pending = CombatService.ResolveSpellCast(WithRolls(setup));
    }

    private void Complete(SpellcastInProgress casting) =>
        _pending = CombatService.ResolveSpellCast(WithRolls(casting.Setup.WithoutRolls()));

    private void Interrupt(Combatant caster) =>
        _pending = CombatService.ResolveSpellInterruption(caster, _intRoll, _durationRoll, _conRoll);

    private void ApplyPending()
    {
        if (_pending is null)
            return;

        CombatService.ApplyResult(_pending);
        _pending = null;
        ResetRolls();
    }

    private void CancelPending() => _pending = null;

    private static string TimingText(int rounds, int currentRound) => rounds switch
    {
        <= 0 => "мгновенно: срабатывает сейчас, на ЛВК+50 — раньше обычного хода",
        1 => "срабатывает в этом раунде на ЛВК заклинателя",
        _ => $"сработает в раунде {currentRound + rounds - 1} на ЛВК заклинателя; до тех пор заклинатель занят"
    };

    /// <summary>Строки статблока про заклинания: у существ списка заклинаний в модели нет.</summary>
    private static IEnumerable<KeyValuePair<string, string>> StatblockSpellHints(Combatant caster) =>
        caster.CreatureSource?.SpecialAbilities
            .Where(a => a.Key.Contains("аклинан", StringComparison.OrdinalIgnoreCase)
                        || a.Value.Contains("аклинан", StringComparison.OrdinalIgnoreCase))
        ?? [];

    // ───────────────────────────── Разметка ─────────────────────────────

    private RenderFragment SetupView(Combatant caster) => __builder =>
    {
        var sheetSpells = caster.CharacterSource?.Spells ?? [];
        var catalogVisible = caster.CharacterSource is null || _showCatalog;
        var target = Target;
        var setup = BuildSetup(caster);

        <div class="mb-3">
            <label for="spell-pick" class="cm-field-label">Заклинание</label>
            <select id="spell-pick" class="cm-input" value="@_spellKey" @onchange="OnSpellChanged">
                <option value="">— Выберите —</option>
                @if (sheetSpells.Count > 0)
                {
                    <optgroup label="Знает (лист)">
                        @for (var i = 0; i < sheetSpells.Count; i++)
                        {
                            <option value="@(SheetPrefix + i)">@sheetSpells[i].Name</option>
                        }
                    </optgroup>
                }
                @if (catalogVisible)
                {
                    <optgroup label="Каталог">
                        @foreach (var spell in _catalog)
                        {
                            <option value="@(CatalogPrefix + spell.Id)">@spell.Name</option>
                        }
                    </optgroup>
                }
                <option value="@CustomKey">Своё заклинание…</option>
            </select>

            @if (caster.CharacterSource is not null)
            {
                @if (sheetSpells.Count == 0)
                {
                    <p class="cm-field-note">На листе нет заклинаний — сыщик творит только выученное (стр. 174).</p>
                }
                <label class="flex items-center gap-2 mt-2 min-h-[36px] cursor-pointer">
                    <input type="checkbox" class="cm-checkbox" checked="@_showCatalog"
                           @onchange="e => _showCatalog = e.Value is true" />
                    <span class="text-sm text-gray-700">Показать весь каталог (для НПС Хранителя)</span>
                </label>
            }
            else
            {
                <p class="cm-field-note">В статблоке существа нет списка заклинаний — выберите из каталога или впишите своё.</p>
                @foreach (var hint in StatblockSpellHints(caster))
                {
                    <p class="text-xs text-gray-600 mt-1"><span class="font-semibold">@hint.Key:</span> @hint.Value</p>
                }
            }
        </div>

        @if (_spellKey == CustomKey)
        {
            <div class="mb-3">
                <label for="spell-custom" class="cm-field-label">Название</label>
                <input id="spell-custom" type="text" class="cm-input" placeholder="Как назвал его Хранитель"
                       @bind="_customName" @bind:event="oninput" />
            </div>
        }

        @if (_spell is { } chosen)
        {
            <div class="mb-3 rounded-md border border-accent-200 bg-accent-50 px-3 py-2 text-xs text-accent-800">
                <div><span class="font-semibold">Стоимость:</span> @(chosen.Cost ?? "не указана")</div>
                <div><span class="font-semibold">Время сотворения:</span> @(chosen.CastingTime ?? "не указано")</div>
                @if (!string.IsNullOrWhiteSpace(chosen.Description))
                {
                    <details class="mt-1">
                        <summary class="cursor-pointer font-medium">Описание</summary>
                        <p class="mt-1 whitespace-pre-line text-gray-700">@chosen.Description</p>
                    </details>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SpellName))
        {
            <div class="border-t border-gray-200 pt-3 mb-3">
                <div class="text-xs font-semibold text-gray-700 mb-2 uppercase tracking-wide">Цена — подтвердите числа</div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    @CostField("spell-mp", "ПМ", _magicPoints, v => _magicPoints = v, _cost.MagicPoints)
                    @if (CombatService.HasSanity(caster))
                    {
                        @CostField("spell-san", "Рассудок", _sanity, v => _sanity = v, _cost.Sanity)
                    }
                    @CostField("spell-pow", "МОЩ", _power, v => _power = v, _cost.Power)
                    @CostField("spell-hp", "ПЗ", _hitPoints, v => _hitPoints = v, _cost.HitPoints)
                </div>
                <p class="cm-field-note mt-1">
                    ПМ сейчас @caster.CurrentMagicPoints: нехватка снимается с ПЗ (стр. 174). МОЩ тратится навсегда.
                    @if (!CombatService.HasSanity(caster))
                    {
                        <span>Рассудка у существа нет — эта часть цены не берётся.</span>
                    }
                </p>
            </div>

            <div class="mb-3">
                <label for="spell-rounds" class="cm-field-label">Раундов на сотворение <span class="cm-field-hint">(0 — мгновенно)</span></label>
                <div class="flex flex-wrap items-center gap-2">
                    <div class="w-24">
                        <input id="spell-rounds" type="number" min="0" max="99" class="cm-input"
                               value="@_rounds" @onchange="e => _rounds = ParseAmount(e)" />
                    </div>
                    @if (_time.RoundsFormula is { } roundsFormula)
                    {
                        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => _rounds = Math.Max(1, Roll(roundsFormula))">
                            <i class="fa-solid fa-dice-d20 mr-1"></i>Бросить @roundsFormula
                        </button>
                    }
                </div>
                <p class="cm-field-note">@TimingText(_rounds, CombatService.CurrentRound) (стр. 241).</p>
                @if (_time.MentionsLongerUnits)
                {
                    <Alert Type="warning" ShowIcon Small class="mt-2">
                        В описании — минуты, часы или дни. В бою такое заклинание обычно не творят; перечитайте
                        описание и впишите раунды, если Хранитель всё же разрешает.
                    </Alert>
                }
            </div>

            <div class="mb-3">
                <label for="spell-target" class="cm-field-label">Цель <span class="cm-field-hint">(необязательно)</span></label>
                <select id="spell-target" class="cm-input" value="@_targetId" @onchange="e => { _targetId = e.Value?.ToString() ?? string.Empty; _resists = false; }">
                    <option value="">— без цели —</option>
                    @foreach (var c in AvailableTargets)
                    {
                        <option value="@c.Id">@c.Name (МОЩ @CombatService.GetPower(c))</option>
                    }
                </select>
                @if (target is not null)
                {
                    <label class="flex items-start gap-2 mt-2 min-h-[36px] cursor-pointer">
                        <input type="checkbox" class="cm-checkbox mt-0.5" checked="@_resists"
                               @onchange="e => _resists = e.Value is true" />
                        <span class="text-sm text-gray-700">
                            Цель сопротивляется — встречная проверка МОЩ: лучший уровень успеха побеждает, при
                            равенстве — у кого МОЩ выше (стр. 241). Нужна ли она, сказано в описании заклинания.
                        </span>
                    </label>
                }
            </div>

            @if (caster.CharacterSource is not null)
            {
                <div class="mb-3">
                    <label class="flex items-start gap-2 min-h-[36px] cursor-pointer">
                        <input type="checkbox" class="cm-checkbox mt-0.5" checked="@_firstCast"
                               @onchange="e => { _firstCast = e.Value is true; if (!_firstCast) _pushed = false; }" />
                        <span class="text-sm text-gray-700">
                            Сыщик творит это заклинание впервые — трудная проверка МОЩ; при провале ничего не
                            происходит, но цена уплачена (стр. 176). НПС Хранителя и чудовища её не проходят.
                        </span>
                    </label>
                    @if (_firstCast)
                    {
                        <label class="flex items-start gap-2 mt-1 ml-6 min-h-[36px] cursor-pointer">
                            <input type="checkbox" class="cm-checkbox mt-0.5" checked="@_pushed"
                                   @onchange="e => _pushed = e.Value is true" />
                            <span class="text-sm text-gray-700">
                                Это повторная проверка: при провале заклинание всё же срабатывает, а цена
                                уплачивается ещё ×1d6 (стр. 176).
                            </span>
                        </label>
                    }
                </div>
            }

            @if (setup.CastingRounds <= 1)
            {
                @RollsView(caster, setup, target)
            }

            <button type="button" class="cm-btn cm-btn-primary w-full" data-testid="spell-cast-btn"
                    @onclick="() => Cast(caster)">
                @(setup.CastingRounds >= 2 ? $"Начать сотворение ({setup.CastingRounds} р.)" : "Сотворить")
            </button>
        }
    };

    private RenderFragment InProgressView(Combatant caster, SpellcastInProgress casting) => __builder =>
    {
        var setup = casting.Setup;
        var target = setup.TargetId is { } id ? Combatants.FirstOrDefault(c => c.Id == id) : null;
        var ready = CombatService.CurrentRound >= casting.CompletesInRound;

        <div class="mb-3 rounded-md border border-accent-200 bg-accent-50 px-3 py-2 text-sm text-accent-800">
            <div class="font-semibold">Творит «@setup.SpellName»@(target is null ? "" : $" на {target.Name}")</div>
            <div class="text-xs mt-0.5">
                Начато в раунде @casting.StartedRound, срабатывает в раунде @casting.CompletesInRound на ЛВК заклинателя.
                Цена: ПМ @setup.MagicPointsCost@(setup.SanityCost > 0 ? $", рассудок {setup.SanityCost}" : "")@(setup.PowerCost > 0 ? $", МОЩ {setup.PowerCost}" : "")@(setup.HitPointsCost > 0 ? $", ПЗ {setup.HitPointsCost}" : "").
            </div>
        </div>

        @if (casting.Disrupted)
        {
            <Alert Type="warning" ShowIcon Small>
                Заклинателя ранили — сотворение сорвано. Эффекта не будет, но ПМ и рассудок уплачиваются (стр. 177).
            </Alert>
            @ConsequenceRollsView(caster, setup, pushed: false, interruption: true)
            <button type="button" class="cm-btn cm-btn-primary w-full" @onclick="() => Interrupt(caster)">Оплатить срыв</button>
        }
        else if (ready)
        {
            @RollsView(caster, setup, target)
            <div class="flex flex-wrap gap-2">
                <button type="button" class="cm-btn cm-btn-primary flex-1" data-testid="spell-complete-btn"
                        @onclick="() => Complete(casting)">Завершить сотворение</button>
                <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm" @onclick="() => Interrupt(caster)">Прервать</button>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-700 mb-3">
                Осталось раундов: @(casting.CompletesInRound - CombatService.CurrentRound). Атака или ранение заклинателя
                сорвут сотворение: эффекта не будет, а ПМ и рассудок уйдут всё равно (стр. 177).
            </p>
            @ConsequenceRollsView(caster, setup, pushed: false, interruption: true)
            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm" @onclick="() => Interrupt(caster)">Прервать сотворение</button>
        }
    };

    /// <summary>Броски, которые решают исход: первое сотворение, 1d6 повтора, встречная МОЩ, последствия цены.</summary>
    private RenderFragment RollsView(Combatant caster, SpellCastSetup setup, Combatant? target) => __builder =>
    {
        var power = CombatService.GetPower(caster);
        var resisted = setup.TargetResists && target is not null;
        var targetPower = target is null ? 0 : CombatService.GetPower(target);
        var automatic = resisted && Math.Abs(power - targetPower) >= CombatService.AutomaticPowerGap;
        var hasRolls = setup.IsFirstCast || resisted || NeedsIntRoll(caster, setup, setup.IsPushed) || NeedsConRoll(caster, setup, setup.IsPushed, includeHitPointsCost: true);

        @if (hasRolls)
        {
            <div class="border-t border-gray-200 pt-3 mb-3">
                <div class="text-xs font-semibold text-gray-700 mb-1 uppercase tracking-wide">Броски</div>
                <p class="cm-field-note mb-2">Впишите свои кости или бросьте здесь; пустое поле бросит программа.</p>

                @if (setup.IsFirstCast)
                {
                    @RollField("spell-cast-roll", $"Трудная проверка МОЩ {power} (нужно ≤ {power / 2})", _castingRoll, v => _castingRoll = v,
                        () => CombatService.RollD100(), LevelHint(_castingRoll, power, SuccessLevel.HardSuccess))
                    @if (setup.IsPushed)
                    {
                        @RollField("spell-push-roll", "1d6 — во сколько раз ещё платить при провале повтора", _pushRoll, v => _pushRoll = v,
                            () => CombatService.RollDice(6), null, 6)
                    }
                }

                @if (resisted && automatic)
                {
                    <p class="text-sm text-gray-700 mb-2">
                        МОЩ @power против @targetPower: разница не меньше @CombatService.AutomaticPowerGap — встречная проверка не нужна (стр. 241).
                    </p>
                }
                else if (resisted)
                {
                    @RollField("spell-caster-pow", $"{caster.Name}: МОЩ {power}", _casterPowerRoll, v => _casterPowerRoll = v,
                        () => CombatService.RollD100(), LevelHint(_casterPowerRoll, power, null))
                    @RollField("spell-target-pow", $"{target!.Name}: МОЩ {targetPower}", _targetPowerRoll, v => _targetPowerRoll = v,
                        () => CombatService.RollD100(), LevelHint(_targetPowerRoll, targetPower, null))
                }

                @ConsequenceRollsView(caster, setup, setup.IsPushed, interruption: false)
            </div>
        }
    };

    /// <summary>Проверки, которых может потребовать сама цена: ИНТ за 5+ рассудка и ВЫН за серьёзную рану.</summary>
    private RenderFragment ConsequenceRollsView(Combatant caster, SpellCastSetup setup, bool pushed, bool interruption) => __builder =>
    {
        @if (NeedsIntRoll(caster, setup, pushed))
        {
            @RollField("spell-int-roll", $"Проверка ИНТ {caster.IntelligenceValue} — если потеря рассудка 5+ (стр. 153)", _intRoll, v => _intRoll = v,
                () => CombatService.RollD100(), _intRoll is { } r ? (r <= caster.IntelligenceValue ? "успех — временное безумие" : "провал — безумие не наступает") : null)
            @RollField("spell-duration-roll", "1d10 часов временного безумия", _durationRoll, v => _durationRoll = v,
                () => CombatService.RollDice(10), null, 10)
        }
        @if (NeedsConRoll(caster, setup, pushed, includeHitPointsCost: !interruption))
        {
            @RollField("spell-con-roll", $"Проверка ВЫН {caster.ConstitutionValue} — расплата ПЗ даёт серьёзную рану (стр. 176)", _conRoll, v => _conRoll = v,
                () => CombatService.RollD100(), _conRoll is { } c ? (c <= caster.ConstitutionValue ? "успех — в сознании" : "провал — без сознания") : null)
        }
    };

    private RenderFragment PendingView(CombatActionResult result) => __builder =>
    {
        var outcome = result.Spell!;
        var good = outcome.TakesEffect && result.AttackerWins;

        <div class="rounded-md border p-3 mb-3 @(outcome.Phase == SpellCastPhase.Interrupted ? "border-warning-200 bg-warning-50" : good ? "border-success-200 bg-success-50" : "border-error-200 bg-error-50")">
            <div class="text-sm font-semibold @(outcome.Phase == SpellCastPhase.Interrupted ? "text-warning-800" : good ? "text-success-800" : "text-error-800")">
                @(outcome.Phase == SpellCastPhase.Interrupted
                    ? "Сотворение сорвано"
                    : !outcome.TakesEffect ? "Заклинание не сработало"
                    : good ? "Заклинание сработало" : "Цель устояла")
            </div>
            <p class="text-sm text-gray-700 mt-1">@result.Summary</p>
        </div>
        <div class="flex gap-2">
            <button type="button" class="cm-btn cm-btn-primary w-full" data-testid="spell-apply-btn" @onclick="ApplyPending">Применить</button>
            <button type="button" class="cm-btn cm-btn-secondary w-full" @onclick="CancelPending">Отменить</button>
        </div>
    };

    private RenderFragment CostField(string id, string label, int value, Action<int> set, string? formula) => __builder =>
    {
        <div>
            <label for="@id" class="cm-field-label">@label</label>
            <input id="@id" type="number" min="0" max="999" class="cm-input" value="@value"
                   @onchange="e => set(ParseAmount(e))" />
            @if (formula is not null && SpellStatsReader.FixedAmount(formula) is null)
            {
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm mt-1 w-full" @onclick="() => set(Roll(formula))">
                    <i class="fa-solid fa-dice-d20 mr-1"></i>@formula
                </button>
            }
        </div>
    };

    private RenderFragment RollField(string id, string label, int? value, Action<int?> set, Func<int> roll, string? hint, int max = 100) => __builder =>
    {
        <div class="mb-2">
            <label for="@id" class="cm-field-label">@label</label>
            <div class="flex flex-wrap items-center gap-2">
                <div class="w-24">
                    <input id="@id" type="number" min="1" max="@max" class="cm-input" placeholder="авто"
                           value="@value" @onchange="e => set(ParseRoll(e, max))" />
                </div>
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => set(roll())">
                    <i class="fa-solid fa-dice-d20 mr-1"></i>Бросить
                </button>
                @if (hint is not null)
                {
                    <span class="text-xs font-medium text-gray-700">→ @hint</span>
                }
            </div>
        </div>
    };

    /// <summary>Уровень успеха вписанного броска; для проверки сотворения — прошла ли она (нужен трудный).</summary>
    private static string? LevelHint(int? roll, int value, SuccessLevel? required)
    {
        if (roll is not { } r)
            return null;

        var level = CombatService.CalculateSuccessLevel(r, value, required ?? SuccessLevel.RegularSuccess);
        var text = CombatService.GetSuccessLevelText(level);
        return required is { } need ? $"{text} — {(level >= need ? "пройдена" : "провал")}" : text;
    }
}
