@using CampaignManager.Web.Components.Features.Combat.Model
@using CampaignManager.Web.Components.Features.Combat.Services
@using CampaignManager.Web.Extensions

@inject CombatService CombatService

<div class="bg-white rounded-md shadow-sm border border-gray-200 p-3 mb-2 border-l-4 @(IsActive ? "border-l-accent-500" : "border-l-transparent")
            @(Combatant.IsDead ? "opacity-50" : "")">
    <!-- Заголовок -->
    <div class="flex justify-between items-start mb-2">
        <div>
            <div class="flex items-center gap-2">
                <h4 class="font-semibold text-gray-900 text-sm">@Combatant.Name</h4>
                <span class="@SideBadgeClass text-xs px-1.5 py-0.5 rounded font-medium">@Combatant.Side.ToRussianString()</span>
            </div>
            <div class="text-xs text-gray-500 mt-0.5">
                @if (CombatService.UseInitiativeRolls && Combatant.InitiativeRoll is { } initRoll)
                {
                    <text>Инициатива: @initRoll / @Combatant.Initiative — @CombatService.GetSuccessLevelText((SuccessLevel)Combatant.InitiativeRollLevel)</text>
                    @if (Combatant.InitiativeRollDetail is { HasExtraDice: true })
                    {
                        <text> @CombatService.FormatRollDetail(Combatant.InitiativeRollDetail)</text>
                    }
                }
                else
                {
                    <text>ИН: @(Combatant.HasFirearmReady ? Combatant.Initiative + 50 : Combatant.Initiative) &middot; ЛВК: @Combatant.Dexterity</text>
                }
                @if (Combatant.Armor > 0) { <span> &middot; Броня: @Combatant.Armor</span> }
                @if (Combatant.Build != 0) { <span> &middot; Комп: @(Combatant.Build > 0 ? "+" : "")@Combatant.Build</span> }
                @if (Combatant.DefenseCountThisRound > 0)
                {
                    <span class="ml-1 text-warning-600 font-medium">· Защит: @Combatant.DefenseCountThisRound/@Combatant.AttacksPerRound</span>
                }
            </div>
        </div>
        <div class="flex items-center gap-1 flex-wrap justify-end">
            <button @onclick="ToggleFirearmReady"
                    class="text-xs px-1.5 py-0.5 rounded border transition-colors @(Combatant.HasFirearmReady ? "border-accent-400 bg-accent-100 text-accent-700" : "border-gray-200 bg-gray-50 text-gray-400 hover:border-gray-300")"
                    title="Огнестрельное на изготовку (+50 к инициативе)"><i class="fa-solid fa-gun"></i></button>
            <button @onclick="ToggleAiming"
                    class="text-xs px-1.5 py-0.5 rounded border transition-colors @(Combatant.IsAiming ? "border-success-400 bg-success-100 text-success-700" : "border-gray-200 bg-gray-50 text-gray-400 hover:border-gray-300")"
                    title="Прицеливание (бонусная кость в след. раунде)"><i class="fa-solid fa-bullseye"></i></button>
            <button @onclick="ToggleProne"
                    class="text-xs px-1.5 py-0.5 rounded border transition-colors @(Combatant.IsProne ? "border-warning-500 bg-warning-100 text-warning-700" : "border-gray-200 bg-gray-50 text-gray-400 hover:border-gray-300")"
                    title="Повалён"><i class="fa-solid fa-arrow-down"></i></button>
            @if (OnDelayTurn.HasDelegate && !Combatant.IsDelayed && !Combatant.HasActedThisRound)
            {
                <button @onclick="DelayTurn"
                        class="text-xs px-1.5 py-0.5 rounded border border-gray-200 bg-gray-50 text-gray-400 hover:border-warning-300 hover:text-warning-600 transition-colors"
                        title="Отложить ход"><i class="fa-solid fa-pause"></i></button>
            }
            <button @onclick="OnRemove" class="text-gray-400 hover:text-error-500 transition-colors p-0.5" title="Удалить">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Бейджи состояний. Цвет = тяжесть состояния, текст = само состояние. -->
    @if (HasAnyState())
    {
        <div class="flex flex-wrap gap-1 mb-2">
            @if (Combatant.IsDead)
            {
                <span class="@BadgeDead">Мёртв</span>
            }
            @if (Combatant.IsDying && !Combatant.IsDead)
            {
                <span class="@BadgeDying">При смерти</span>
            }
            @if (Combatant.AttacksPerRound > 1 && !Combatant.IsDead)
            {
                <span class="@BadgeNeutral" title="Атак за раунд">
                    Атак: @Combatant.AttacksThisRound/@Combatant.AttacksPerRound
                </span>
            }
            @if (Combatant.AttackBlockedInRound.HasValue && !Combatant.IsDead)
            {
                <span class="@BadgeImpaired" title="Укрывался от огня и теряет атаку (стр. 111)">
                    Без атаки в раунде @Combatant.AttackBlockedInRound
                </span>
            }
            @if (Combatant.IsDisarmed && !Combatant.IsDead)
            {
                <span class="@BadgeImpaired" title="Оружие выбито манёвром (стр. 103)">Разоружён</span>
            }
            @if (Combatant.HasDisadvantage && !Combatant.IsDead)
            {
                <span class="@BadgeImpaired"
                      title="Правила не задают точный эффект — Хранитель сам решает, какую кость выдать (стр. 103)">
                    Невыгодное положение
                </span>
            }
            @if (Combatant.HasTacticalAdvantage && !Combatant.IsDead)
            {
                <span class="@BadgeGood"
                      title="01 в проверке инициативы: тактическое преимущество или бонусная кость к первой атаке (стр. 122)">
                    Преимущество
                </span>
            }
            @if (Combatant.SkipsTurnFromFumble && !Combatant.IsDead)
            {
                <span class="@BadgeCritical" title="Крах в проверке инициативы — боец пропускает ход (стр. 122)">
                    Пропуск хода
                </span>
            }
            @if (Combatant.IsStabilized && !Combatant.IsDead)
            {
                <span class="@BadgeGood"
                      title="Первая помощь дала 1 временный ПЗ: проверки ВЫН раз в час. Снять отметку «При смерти» может только Медицина.">
                    Стабилизирован
                </span>
            }
            @if (Combatant.IsUnconscious)
            {
                <span class="@BadgeImpaired">Без сознания</span>
            }
            @if (Combatant.HasMajorWound)
            {
                <span class="@BadgeCritical">Тяжёлая рана</span>
            }
            @if (Combatant.HasIndefiniteInsanity)
            {
                <span class="@BadgeIndefiniteInsanity">Бессрочное безумие</span>
            }
            @if (Combatant.HasTemporaryInsanity)
            {
                <span class="@BadgeInsanity" title="Временное безумие">
                    Безумие@(Combatant.TemporaryInsanityHours > 0 ? $" · {Combatant.TemporaryInsanityHours} ч" : "")
                </span>
            }
            @if (Combatant.IsProne)
            {
                <span class="@BadgeImpaired">Повалён</span>
            }
            @if (Combatant.IsGrappled)
            {
                <span class="@BadgeImpaired">Захвачен</span>
            }
            @if (Combatant.IsAiming)
            {
                <span class="@BadgeGood">Прицел.</span>
            }
            @if (Combatant.HasTakenCover)
            {
                <span class="@BadgeCover">Укрылся</span>
            }
            @if (Combatant.IsDelayed)
            {
                <span class="@BadgeNeutral">Отложен</span>
            }
            @if (Combatant.JammedWeaponName != null)
            {
                <span class="@BadgeNeutral" title="@Combatant.JammedWeaponName заклинило">
                    <i class="fa-solid fa-wrench mr-1 opacity-70"></i>Осечка
                </span>
            }
        </div>
    }

    <!-- Характеристики: HP / MP / Рассудок -->
    <div class="space-y-1.5 mb-2">
        <!-- HP -->
        <div>
            <div class="flex items-center justify-between text-xs mb-0.5">
                <span class="text-gray-600 font-medium">ОЗ</span>
                <div class="flex items-center gap-1">
                    <button @onclick="() => AdjustHp(-1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-error-100 text-gray-600 hover:text-error-600 text-xs flex items-center justify-center">−</button>
                    <span class="text-gray-900 font-semibold w-12 text-center">@Combatant.CurrentHitPoints / @Combatant.MaxHitPoints</span>
                    <button @onclick="() => AdjustHp(1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-success-100 text-gray-600 hover:text-success-600 text-xs flex items-center justify-center">+</button>
                </div>
            </div>
            <div class="bg-gray-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full transition-all @GetHpBarColor()" style="width: @GetHpPercent()%"></div>
            </div>
        </div>

        <!-- MP -->
        <div>
            <div class="flex items-center justify-between text-xs mb-0.5">
                <span class="text-gray-600 font-medium">ОМ</span>
                <div class="flex items-center gap-1">
                    <button @onclick="() => AdjustMp(-1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-error-100 text-gray-600 hover:text-error-600 text-xs flex items-center justify-center">−</button>
                    <span class="text-gray-900 font-semibold w-12 text-center">@Combatant.CurrentMagicPoints / @Combatant.MaxMagicPoints</span>
                    <button @onclick="() => AdjustMp(1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-success-100 text-gray-600 hover:text-success-600 text-xs flex items-center justify-center">+</button>
                </div>
            </div>
            <div class="bg-gray-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full bg-accent-600 transition-all" style="width: @GetMpPercent()%"></div>
            </div>
        </div>

        <!-- Рассудок -->
        <div>
            <div class="flex items-center justify-between text-xs mb-0.5">
                <span class="text-gray-600 font-medium">Рас.</span>
                <div class="flex items-center gap-1">
                    <button @onclick="() => AdjustSanity(-1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-error-100 text-gray-600 hover:text-error-600 text-xs flex items-center justify-center">−</button>
                    <span class="text-gray-900 font-semibold w-12 text-center">@Combatant.CurrentSanity / @Combatant.MaxSanity</span>
                    <button @onclick="() => AdjustSanity(1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-success-100 text-gray-600 hover:text-success-600 text-xs flex items-center justify-center">+</button>
                </div>
            </div>
            <div class="bg-gray-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full bg-secondary-600 transition-all" style="width: @GetSanityPercent()%"></div>
            </div>
        </div>

        <!-- Броня (стр. 106) -->
        <div class="flex items-center justify-between text-xs">
            <span class="text-gray-600 font-medium" title="Вычитается из физического урона, но не из урона от магии, яда и утопления (стр. 106)">Броня</span>
            <div class="flex items-center gap-1">
                <button @onclick="() => AdjustArmor(-1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-error-100 text-gray-600 hover:text-error-600 text-xs flex items-center justify-center">−</button>
                <span class="text-gray-900 font-semibold w-12 text-center">@Combatant.Armor</span>
                <button @onclick="() => AdjustArmor(1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-success-100 text-gray-600 hover:text-success-600 text-xs flex items-center justify-center">+</button>
            </div>
        </div>
    </div>

    @if (CanSpendLuck)
    {
        <button type="button" @onclick="SpendLuck"
                class="mt-2 w-full rounded border border-warning-300 bg-warning-50 px-2 py-1 text-xs text-warning-800 hover:bg-warning-100">
            Остаться в сознании за @CombatService.GetLuckCostToStayConscious(Combatant) Удачи
            (осталось @Combatant.Luck)
        </button>
    }

    <!-- Оружие / Атаки (свёрнуты по умолчанию) -->
    @if (HasActions())
    {
        <details class="mt-2">
            <summary class="text-xs font-medium text-gray-500 cursor-pointer hover:text-gray-700">
                Оружие и атаки
            </summary>
            <div class="mt-1.5 space-y-1">
                @if (Combatant.CharacterSource != null)
                {
                    @foreach (var weapon in Combatant.CharacterSource.Weapons)
                    {
                        <div class="bg-gray-50 border border-gray-100 p-1.5 rounded text-xs">
                            <span class="font-semibold text-gray-800">@weapon.Name</span>
                            <span class="text-gray-500 ml-1">@weapon.Damage &middot; @weapon.Attacks ат.</span>
                        </div>
                    }
                    @foreach (var spell in Combatant.CharacterSource.Spells)
                    {
                        <div class="bg-secondary-100 border border-secondary-200 p-1.5 rounded text-xs">
                            <span class="font-semibold text-secondary-800">@spell.Name</span>
                            <span class="text-secondary-600 ml-1">@spell.Cost</span>
                        </div>
                    }
                }
                else if (Combatant.CreatureSource != null)
                {
                    @foreach (var attack in Combatant.CreatureSource.Attacks)
                    {
                        <div class="bg-gray-50 border border-gray-100 p-1.5 rounded text-xs">
                            <span class="font-semibold text-gray-800">@attack.Name</span>
                            <span class="text-gray-500 ml-1">@(attack.IsMelee ? "Ближний" : "Дальний") @attack.SkillValue% &middot; @attack.DamageFormula</span>
                            @if (!string.IsNullOrEmpty(attack.Description))
                            {
                                <span class="text-gray-400 ml-1">@attack.Description</span>
                            }
                        </div>
                    }
                    @foreach (var ability in Combatant.CreatureSource.SpecialAbilities)
                    {
                        <div class="bg-warning-50 border border-warning-100 p-1.5 rounded text-xs">
                            <span class="font-semibold text-warning-800">@ability.Key</span>
                            <span class="text-warning-600 ml-1">@ability.Value</span>
                        </div>
                    }
                }
            </div>
        </details>
    }
</div>

@code {
    [Parameter] public required Combatant Combatant { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<Combatant> OnRemoveCallback { get; set; }
    [Parameter] public EventCallback<Combatant> OnDelayTurn { get; set; }
    [Parameter] public EventCallback OnSortNeeded { get; set; }

    /// <summary>
    /// Приглушённые бейджи состояний в стиле общего <c>Badge</c>: заливка -100, текст -800, рамка -200.
    /// Цвет кодирует тяжесть состояния, а не само состояние; классы записаны целиком — Tailwind не видит
    /// интерполированные имена.
    /// </summary>
    private const string BadgeBase = "inline-flex items-center text-xs px-1.5 py-0.5 rounded border font-medium";

    private const string BadgeNeutral = $"{BadgeBase} bg-primary-100 text-primary-800 border-primary-200";
    private const string BadgeGood = $"{BadgeBase} bg-success-100 text-success-800 border-success-200";
    private const string BadgeImpaired = $"{BadgeBase} bg-warning-100 text-warning-800 border-warning-200";
    private const string BadgeCritical = $"{BadgeBase} bg-error-100 text-error-800 border-error-200";

    /// <summary>Метка стороны участника. Классы литеральные — Tailwind не видит интерполяцию.</summary>
    private string SideBadgeClass => Combatant.Side switch
    {
        CombatSide.Party => "bg-accent-100 text-accent-700",
        CombatSide.Enemy => "bg-error-100 text-error-700",
        _ => "bg-primary-100 text-primary-700"
    };
    private const string BadgeCover = $"{BadgeBase} bg-accent-100 text-accent-800 border-accent-200";
    private const string BadgeInsanity = $"{BadgeBase} bg-secondary-100 text-secondary-800 border-secondary-200";

    /// <summary>Смерть, агония и бессрочное безумие — единственные состояния с плотной заливкой.</summary>
    private const string BadgeDead = $"{BadgeBase} bg-primary-900 text-primary-100 border-primary-900";
    private const string BadgeDying = $"{BadgeBase} bg-error-700 text-error-50 border-error-700";
    private const string BadgeIndefiniteInsanity = $"{BadgeBase} bg-secondary-800 text-secondary-100 border-secondary-800";

    private async Task OnRemove() => await OnRemoveCallback.InvokeAsync(Combatant);
    private async Task DelayTurn() => await OnDelayTurn.InvokeAsync(Combatant);

    private void AdjustHp(int delta) => Combatant.CurrentHitPoints = Math.Clamp(Combatant.CurrentHitPoints + delta, 0, Combatant.MaxHitPoints);
    private void AdjustMp(int delta) => Combatant.CurrentMagicPoints = Math.Clamp(Combatant.CurrentMagicPoints + delta, 0, Combatant.MaxMagicPoints);
    private void AdjustSanity(int delta) => Combatant.CurrentSanity = Math.Clamp(Combatant.CurrentSanity + delta, 0, Combatant.MaxSanity);

    private async Task ToggleFirearmReady()
    {
        Combatant.HasFirearmReady = !Combatant.HasFirearmReady;
        await OnSortNeeded.InvokeAsync();
    }
    private void ToggleProne() => Combatant.IsProne = !Combatant.IsProne;
    private void ToggleAiming() => Combatant.IsAiming = !Combatant.IsAiming;
    private void ToggleUnconscious() => Combatant.IsUnconscious = !Combatant.IsUnconscious;

    /// <summary>Можно ли предложить трату Удачи, чтобы остаться в сознании (стр. 123).</summary>
    private bool CanSpendLuck =>
        CombatService.UseLuckToStayConscious
        && Combatant.IsUnconscious
        && !Combatant.IsDead
        && Combatant.Luck >= CombatService.GetLuckCostToStayConscious(Combatant);

    private void SpendLuck() => CombatService.SpendLuckToStayConscious(Combatant);

    private void AdjustArmor(int delta) =>
        Combatant.Armor = Math.Max(0, Combatant.Armor + delta);

    private bool HasAnyState() =>
        Combatant.IsUnconscious || Combatant.HasMajorWound || Combatant.IsDying || Combatant.IsDead
        || Combatant.HasTemporaryInsanity || Combatant.HasIndefiniteInsanity
        || Combatant.IsProne || Combatant.IsGrappled
        || Combatant.IsAiming || Combatant.HasTakenCover || Combatant.IsDelayed
        || Combatant.JammedWeaponName != null
        || Combatant.IsStabilized
        || Combatant.AttackBlockedInRound.HasValue
        || Combatant.AttacksPerRound > 1
        || Combatant.IsDisarmed || Combatant.HasDisadvantage
        || Combatant.HasTacticalAdvantage || Combatant.SkipsTurnFromFumble;

    private bool HasActions() =>
        (Combatant.CharacterSource?.Weapons.Count > 0)
        || (Combatant.CharacterSource?.Spells.Count > 0)
        || (Combatant.CreatureSource?.Attacks.Count > 0)
        || (Combatant.CreatureSource?.SpecialAbilities.Count > 0);

    private double GetHpPercent() => Combatant.MaxHitPoints > 0
        ? Math.Max(0, (double)Combatant.CurrentHitPoints / Combatant.MaxHitPoints * 100) : 0;

    private double GetMpPercent() => Combatant.MaxMagicPoints > 0
        ? Math.Max(0, (double)Combatant.CurrentMagicPoints / Combatant.MaxMagicPoints * 100) : 0;

    private double GetSanityPercent() => Combatant.MaxSanity > 0
        ? Math.Max(0, (double)Combatant.CurrentSanity / Combatant.MaxSanity * 100) : 0;

    private string GetHpBarColor()
    {
        var pct = GetHpPercent();
        if (pct > 50) return "bg-success-600";
        if (pct > 25) return "bg-warning-600";
        return "bg-error-600";
    }
}
