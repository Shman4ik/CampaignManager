@using CampaignManager.Web.Components.Features.Combat.Model
@using CampaignManager.Web.Components.Features.Combat.Services

<div class="bg-white rounded-md shadow-md border-2 border-accent-200 p-4">
    <h4 class="text-base font-semibold text-gray-900 mb-3">Результат атаки</h4>

    @if (Result.ActionType == CombatActionType.Maneuver)
    {
        <!-- Манёвр -->
        <div class="bg-gray-50 rounded-md p-3 mb-2 text-sm">
            <span class="font-semibold">@Result.AttackerName</span>
            <span class="text-gray-500"> — </span>
            <span>@CombatService.GetManeuverName(Result.ManeuverType ?? ManeuverType.Disadvantage)</span>
            <span class="text-gray-500"> против </span>
            <span class="font-semibold">@Result.DefenderName</span>
        </div>
        <div class="flex gap-3 mb-3">
            @RollBadge(Result.AttackerName, Result.AttackerRoll, Result.AttackerSkillValue, Result.AttackerSuccessLevel, Result.AttackerRollDetail)
            @RollBadge(Result.DefenderName, Result.DefenderRoll, Result.DefenderSkillValue, Result.DefenderSuccessLevel, Result.DefenderRollDetail)
        </div>
        @if (Result.Modifiers.Reasons.Count > 0)
        {
            <div class="bg-gray-50 rounded-md px-3 py-2 mb-3 text-xs text-gray-600">
                <span class="font-medium text-gray-700">Модификаторы:</span>
                @string.Join(" · ", Result.Modifiers.Reasons)
            </div>
        }
        <div class="rounded-md p-3 mb-3 @(Result.ManeuverSucceeded ? "bg-success-50 border border-success-200" : "bg-error-50 border border-error-200")">
            <div class="text-sm font-semibold @(Result.ManeuverSucceeded ? "text-success-800" : "text-error-800")">
                @(Result.ManeuverSucceeded ? "Манёвр удался!" : "Манёвр не удался")
            </div>
        </div>
    }
    else
    {
        <!-- Бросок атакующего -->
        <div class="bg-gray-50 rounded-md p-3 mb-2 text-sm">
            <span class="font-semibold text-gray-900">@Result.AttackerName</span>
            <span class="text-gray-400 mx-1">→</span>
            <span class="font-bold text-lg text-gray-900">@Result.AttackerRoll</span>
            <span class="text-gray-400 mx-1">/</span>
            <span class="font-semibold text-gray-700">@Result.AttackerSkillValue</span>
            <span class="mx-2">—</span>
            <span class="font-semibold @CombatService.GetSuccessLevelColor(Result.AttackerSuccessLevel)">
                @CombatService.GetSuccessLevelText(Result.AttackerSuccessLevel)
            </span>
            @if (Result.AttackerRollDetail is { HasExtraDice: true })
            {
                <span class="text-xs text-gray-500">@CombatService.FormatRollDetail(Result.AttackerRollDetail)</span>
            }
            @if (Result.ActionType == CombatActionType.RangedAttack && Result.RangeLevel != RangeLevel.Base)
            {
                <div class="text-xs text-gray-500 mt-0.5">
                    @(Result.RangeLevel == RangeLevel.Long ? "Большая дальность" : "Сверхбольшая дальность"):
                    для попадания нужен @CombatService.GetDifficultyName(Result.RangeLevel) успех.
                </div>
            }
        </div>

        @if (Result.Modifiers.Reasons.Count > 0)
        {
            <div class="bg-gray-50 rounded-md px-3 py-2 mb-2 text-xs text-gray-600">
                <span class="font-medium text-gray-700">Модификаторы:</span>
                @string.Join(" · ", Result.Modifiers.Reasons)
            </div>
        }

        <!-- Бросок защитника -->
        @if (Result.SurpriseMode != SurpriseMode.TargetReady)
        {
            <div class="bg-warning-50 border border-warning-200 rounded-md p-3 mb-2 text-sm text-warning-800">
                <span class="font-semibold">@Result.DefenderName</span> застигнут врасплох — не защищается.
                @if (Result.SurpriseMode == SurpriseMode.AutoHit)
                {
                    <text>Атака проходит автоматически, промахом считается только крах.</text>
                }
            </div>
        }
        else if (Result.ActionType == CombatActionType.MeleeAttack && Result.DefenderId.HasValue)
        {
            <div class="bg-gray-50 rounded-md p-3 mb-2 text-sm">
                <span class="font-semibold text-gray-900">@Result.DefenderName</span>
                <span class="text-gray-400 mx-1 text-xs">(@(Result.DefenderReaction == CombatActionType.FightBack ? "ответный удар" : "уклонение"))</span>
                <span class="text-gray-400 mx-1">→</span>
                <span class="font-bold text-lg text-gray-900">@Result.DefenderRoll</span>
                <span class="text-gray-400 mx-1">/</span>
                <span class="font-semibold text-gray-700">@Result.DefenderSkillValue</span>
                <span class="mx-2">—</span>
                <span class="font-semibold @CombatService.GetSuccessLevelColor(Result.DefenderSuccessLevel)">
                    @CombatService.GetSuccessLevelText(Result.DefenderSuccessLevel)
                </span>
                @if (Result.DefenderRollDetail is { HasExtraDice: true })
                {
                    <span class="text-xs text-gray-500">@CombatService.FormatRollDetail(Result.DefenderRollDetail)</span>
                }
            </div>
        }

        @if (Result.IsMalfunction)
        {
            <div class="rounded-md p-3 mb-3 bg-warning-50 border border-warning-300">
                <div class="text-sm font-semibold text-warning-800"><i class="fa-solid fa-wrench mr-1"></i>@Result.MalfunctionMessage</div>
                <div class="text-xs text-warning-600 mt-1">Ремонт: проверка Механики или Стрельбы, 1d6 раундов.</div>
            </div>
        }

        <!-- Итог бросков -->
        <div class="rounded-md p-3 mb-3 @(Result.IsMalfunction ? "bg-warning-50 border border-warning-200" : Result.AttackerWins ? "bg-success-50 border border-success-200" : "bg-error-50 border border-error-200")">
            @if (Result.AttackerWins)
            {
                <div class="text-sm font-semibold text-success-800 mb-1">Попадание!</div>

                @if (Result.TotalDamage > 0 || Result.IsInstantDeath)
                {
                    <!-- Формула урона -->
                    <div class="text-sm text-gray-700 mb-1">
                        @Result.DamageFormula = <span class="font-semibold">@Result.DamageRolled</span>
                        @if (Result.BonusDamage != 0)
                        {
                            <span class="text-gray-500"> + БкУ <span class="font-semibold text-gray-700">@Result.BonusDamage</span></span>
                        }
                        @if (Result.ExtraDamage > 0)
                        {
                            <span class="text-secondary-600"> + доп. <strong>@Result.ExtraDamage</strong></span>
                        }
                        @if (Result.ArmorReduction > 0)
                        {
                            <span class="text-gray-400"> = @Result.RawDamage</span>
                            <span class="text-accent-600 text-xs"> − броня @Result.ArmorReduction</span>
                        }
                        <span class="ml-1 font-bold text-base @(Result.IsInstantDeath ? "text-error-700" : "text-gray-900")">
                            = @Result.TotalDamage
                        </span>
                    </div>

                    @if (Result.IsCritical)
                    {
                        <div class="text-xs font-bold text-warning-700 bg-warning-50 rounded px-2 py-1 inline-block"><i class="fa-solid fa-bolt mr-1"></i>Критический удар!</div>
                    }
                    else if (Result.IsExtreme)
                    {
                        <div class="text-xs font-bold @(Result.IsImpalingWeapon ? "text-error-700 bg-error-50" : "text-warning-700 bg-warning-50") rounded px-2 py-1 inline-block">
                            <i class="fa-solid @(Result.IsImpalingWeapon ? "fa-khanda" : "fa-burst") mr-1"></i>@(Result.IsImpalingWeapon ? "Проникающая рана!" : "Максимальный урон!")
                        </div>
                    }
                }

                <div class="text-sm text-gray-600 mt-1.5">
                    ОЗ @Result.DefenderName: @Result.DefenderHpBefore →
                    <span class="font-semibold @(Result.DefenderHpAfter <= 0 ? "text-error-700" : "text-gray-900")">@Result.DefenderHpAfter</span>
                </div>
            }
            else if (Result.DefenderReaction == CombatActionType.FightBack && Result.CounterTotalDamage > 0)
            {
                <div class="text-sm font-semibold text-warning-700">Промах! Атакующий получает контратаку.</div>
            }
            else
            {
                <div class="text-sm font-semibold text-error-800">Промах!</div>
            }
        </div>

        <!-- Мгновенная смерть -->
        @if (Result.IsInstantDeath)
        {
            <div class="bg-gray-900 text-white rounded-md p-3 mb-3 text-sm font-bold text-center">
                <i class="fa-solid fa-skull-crossbones mr-1"></i>@Result.DefenderName уничтожен мгновенно!
            </div>
        }

        <!-- Тяжёлая рана защитника -->
        @if (Result.TriggeredMajorWound && !Result.IsInstantDeath)
        {
            <div class="bg-warning-50 border border-warning-300 rounded-md p-3 mb-3">
                <div class="text-sm font-bold text-warning-800"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Тяжёлая рана!</div>
                <div class="text-sm text-gray-700 mt-1">
                    @Result.DefenderName падает. Проверка ВЫН:
                    бросок <strong>@Result.MajorWoundConRoll</strong>
                    — <span class="font-semibold @(Result.MajorWoundConRollSuccess ? "text-success-700" : "text-error-700")">
                        @(Result.MajorWoundConRollSuccess ? "успех" : "провал")
                    </span>
                </div>
                @if (Result.DefenderKnockedUnconscious)
                {
                    <div class="text-sm font-bold text-error-700 mt-1">@Result.DefenderName теряет сознание!</div>
                }
            </div>
        }

        <!-- Состояния защитника -->
        @if (Result.DefenderDead && !Result.IsInstantDeath)
        {
            <div class="bg-gray-800 text-white rounded-md p-3 mb-3 text-sm font-bold text-center">
                <i class="fa-solid fa-skull-crossbones mr-1"></i>@Result.DefenderName мёртв!
            </div>
        }
        else if (Result.DefenderDying)
        {
            <div class="bg-error-700 text-white rounded-md p-3 mb-3 text-sm font-bold text-center">
                <i class="fa-solid fa-skull mr-1"></i>@Result.DefenderName при смерти! (Проверка ВЫН каждый раунд)
            </div>
        }
        else if (Result.DefenderKnockedUnconscious && !Result.TriggeredMajorWound)
        {
            <div class="bg-warning-600 text-white rounded-md p-3 mb-3 text-sm font-bold text-center">
                @Result.DefenderName теряет сознание!
            </div>
        }

        <!-- Контратака (fight back) — урон по атакующему -->
        @if (Result.CounterTotalDamage > 0 || (Result.DefenderReaction == CombatActionType.FightBack && !Result.AttackerWins))
        {
            <div class="border border-error-200 bg-error-50 rounded-md p-3 mb-3">
                <div class="text-sm font-bold text-error-800 mb-1">
                    <i class="fa-solid fa-reply mr-1"></i>Контратака @Result.DefenderName → @Result.AttackerName
                </div>
                @if (Result.CounterTotalDamage > 0)
                {
                    <div class="text-sm text-gray-700">
                        @Result.CounterAttackDamageFormula = <strong>@Result.CounterDamageRolled</strong>
                        @if (Result.CounterBonusDamage != 0)
                        {
                            <span class="text-gray-500"> + БкУ <strong>@Result.CounterBonusDamage</strong></span>
                        }
                        @if (Result.CounterArmorReduction > 0)
                        {
                            <span class="text-accent-600 text-xs"> − броня @Result.CounterArmorReduction</span>
                        }
                        <span class="font-bold text-base ml-1">= @Result.CounterTotalDamage</span>
                    </div>
                    <div class="text-sm text-gray-600 mt-0.5">
                        ОЗ @Result.AttackerName: @Result.AttackerHpBefore →
                        <span class="font-semibold @(Result.AttackerHpAfter <= 0 ? "text-error-700" : "text-gray-900")">@Result.AttackerHpAfter</span>
                    </div>

                    @if (Result.AttackerTriggeredMajorWound)
                    {
                        <div class="text-xs text-warning-700 mt-1">
                            Тяжёлая рана! Проверка ВЫН: @Result.AttackerMajorWoundConRoll
                            — <span class="font-semibold @(Result.AttackerMajorWoundConRollSuccess ? "text-success-700" : "text-error-700")">
                                @(Result.AttackerMajorWoundConRollSuccess ? "успех" : "провал")
                            </span>
                        </div>
                    }
                    @if (Result.AttackerKnockedUnconscious)
                    {
                        <div class="text-xs font-bold text-error-700 mt-1">@Result.AttackerName теряет сознание!</div>
                    }
                    else if (Result.AttackerDying)
                    {
                        <div class="text-xs font-bold text-error-800 mt-1">@Result.AttackerName при смерти!</div>
                    }
                    else if (Result.AttackerDead)
                    {
                        <div class="text-xs font-bold text-gray-900 mt-1">@Result.AttackerName убит!</div>
                    }
                }
            </div>
        }
    }

    <!-- Кнопки -->
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-primary w-full" @onclick="OnApply"><span>Применить</span></button>
        <button type="button" class="cm-btn cm-btn-secondary w-full" @onclick="OnCancel"><span>Отменить</span></button>
    </div>
</div>

@code {
    [Parameter] public required CombatActionResult Result { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private RenderFragment RollBadge(string name, int roll, int skill, SuccessLevel level, DiceRollResult? detail = null) =>
        @<div class="bg-gray-50 rounded p-2 flex-1 text-xs">
            <div class="font-semibold text-gray-700">@name</div>
            <div class="mt-0.5">@roll / @skill</div>
            <div class="font-medium @CombatService.GetSuccessLevelColor(level)">@CombatService.GetSuccessLevelText(level)</div>
            @if (detail is { HasExtraDice: true })
            {
                <div class="text-gray-500">@CombatService.FormatRollDetail(detail)</div>
            }
        </div>;
}

