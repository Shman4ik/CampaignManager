@using CampaignManager.Web.Components.Features.Checks.Components
@using CampaignManager.Web.Components.Features.Combat.Services

@* Вкладка «Кубики» боевого помощника. Всегда внутри cm-card страницы — своей карточки не рисует.
   Проверка d100 — общий SkillCheckPanel: раньше здесь жила своя копия порогов, которая называла
   крах «Провал!», а провал — «Неудача», и не знала бонусных и штрафных костей. *@

<div class="cm-stack">
    <section>
        <h3 class="cm-section-title mb-3">Проверка d100</h3>
        <SkillCheckPanel InCombat="true"/>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Другие кости</h3>
        <div class="flex flex-wrap items-center gap-2">
            @foreach (var sides in Sides)
            {
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="@($"dice-d{sides}")"
                        @onclick="() => Roll(sides)">
                    <span>d@(sides)</span>
                </button>
            }
            @if (_last is { } last)
            {
                <span class="ml-2 text-sm text-gray-700" data-testid="dice-result">
                    d@(last.Sides): <strong class="text-lg text-primary-800">@last.Value</strong>
                </span>
            }
        </div>
    </section>
</div>

@code {
    /// <summary>Кости, которые встречаются в формулах урона книги: 1D3 … 1D20.</summary>
    private static readonly int[] Sides = [3, 4, 6, 8, 10, 20];

    private (int Sides, int Value)? _last;

    private void Roll(int sides) => _last = (sides, CombatService.RollDice(sides));
}
