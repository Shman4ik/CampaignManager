@using CampaignManager.Web.Components.Features.Combat.Model
@using CampaignManager.Web.Components.Features.Combat.Services

@inject CombatService CombatService

<div>
    <h4 class="text-base font-semibold text-gray-900 mb-3">Первая помощь</h4>

    <div class="bg-success-50 border border-success-200 rounded-md p-2 mb-3 text-xs text-success-800">
        CoC 7e стр. 118: помощь нужно оказать в течение часа после ранения, и проверка
        выполняется только один раз — повторные считаются повторной проверкой. Успех
        возвращает 1 ОЗ. Умирающему успех даёт 1 <strong>временный</strong> ПЗ и
        стабилизацию; снять отметку «При смерти» может только последующая Медицина.
    </div>

    <!-- Целитель -->
    <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Целитель</label>
        <select class="border border-primary-300 rounded-md px-2 py-1.5 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500"
                value="@_healerId"
                @onchange="OnHealerChanged">
            <option value="">— Выберите —</option>
            @foreach (var c in Combatants.Where(c => !c.IsDead))
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>

    @if (_healer != null)
    {
        <!-- Цель лечения -->
        <div class="mb-3">
            <label class="block text-xs font-medium text-gray-600 mb-1">Раненый</label>
            <select class="border border-primary-300 rounded-md px-2 py-1.5 text-sm text-primary-700 bg-primary-50 w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500"
                    value="@_targetId"
                    @onchange="OnTargetChanged">
                <option value="">— Выберите —</option>
                @foreach (var c in Combatants.Where(c => !c.IsDead && (c.CurrentHitPoints < c.MaxHitPoints || c.IsDying)))
                {
                    <option value="@c.Id">@c.Name (ОЗ: @c.CurrentHitPoints / @c.MaxHitPoints@(c.IsDying ? " — ПРИ СМЕРТИ" : ""))</option>
                }
            </select>
        </div>

        @if (_target != null)
        {
            // Отображаем состояние цели
            @if (_target.IsDying && !_target.IsStabilized)
            {
                <div class="bg-error-50 border border-error-300 rounded-md p-2 mb-3 text-xs text-error-800">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>@_target.Name при смерти. Успех даёт 1 временный ПЗ и стабилизацию:
                    проверки ВЫН станут почасовыми вместо ежераундовых. Отметку «При смерти»
                    снимет только последующая проверка Медицины.
                </div>
            }
            else if (_target.IsStabilized)
            {
                <div class="bg-warning-50 border border-warning-300 rounded-md p-2 mb-3 text-xs text-warning-800">
                    @_target.Name уже стабилизирован (1 временный ПЗ). Дальше нужна Медицина —
                    она снимет отметку «При смерти» и восстановит 1d3 ОЗ.
                </div>
            }

            @if (_target.FirstAidAttempted)
            {
                <div class="bg-gray-100 border border-gray-300 rounded-md p-2 mb-3 text-xs text-gray-700">
                    Первую помощь по этому ранению уже пытались оказать. Повторная проверка
                    правилами не допускается — помочь сможет только Медицина или новое ранение.
                </div>
            }

            <!-- Навык первой помощи -->
            <div class="mb-3">
                <label class="block text-xs font-medium text-gray-600 mb-1">Навык «Первая помощь» @_healer.Name</label>
                <input type="number" min="1" max="100" @bind="_firstAidSkill"
                       class="border border-primary-300 rounded-md px-2 py-1 text-sm w-full focus:outline-none focus:ring-1 focus:ring-accent-500/25 focus:border-accent-500" />
            </div>

            <!-- Бросок -->
            <div class="mb-3 border-t border-gray-200 pt-3">
                <div class="text-xs font-semibold text-gray-700 mb-2 uppercase tracking-wide">Бросок</div>
                <div class="flex items-center gap-2">
                    <label class="text-xs font-medium text-gray-600 w-36 shrink-0">d100 (@_healer.Name)</label>
                    <input type="number" min="1" max="100"
                           value="@_roll"
                           @oninput="OnRollInput"
                           class="border border-primary-300 rounded-md px-2 py-1 text-sm w-20 focus:outline-none"
                           placeholder="1–100" />
                    <button @onclick="AutoRoll" class="text-xs px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 text-gray-600"><i class="fa-solid fa-dice-d20 mr-1"></i>авто</button>
                </div>
                @if (_roll.HasValue)
                {
                    var level = CombatService.CalculateSuccessLevel(_roll.Value, _firstAidSkill);
                    <div class="mt-1 ml-36 text-xs font-medium @(level >= SuccessLevel.RegularSuccess ? "text-success-700" : "text-error-700")">
                        → @(_roll.Value) / @_firstAidSkill — @CombatService.GetSuccessLevelText(level)
                    </div>
                }
            </div>

            <!-- Предпросмотр результата -->
            @if (_roll.HasValue)
            {
                var level = CombatService.CalculateSuccessLevel(_roll.Value, _firstAidSkill);
                var success = level >= SuccessLevel.RegularSuccess;
                <div class="bg-@(success ? "green" : "red")-50 border border-@(success ? "green" : "red")-200 rounded-md p-3 mb-3">
                    @if (success)
                    {
                        @if (_target.IsDying)
                        {
                            <div class="text-sm font-semibold text-success-700"><i class="fa-solid fa-check mr-1"></i>Состояние стабилизировано</div>
                            <div class="text-xs text-gray-600 mt-0.5">
                                @_target.Name получает 1 временный ПЗ. Проверки ВЫН — раз в час.
                                Отметка «При смерти» останется до успешной Медицины.
                            </div>
                        }
                        else
                        {
                            <div class="text-sm font-semibold text-success-700"><i class="fa-solid fa-check mr-1"></i>+1 ОЗ (@_target.Name: @_target.CurrentHitPoints → @Math.Min(_target.CurrentHitPoints + 1, _target.MaxHitPoints))</div>
                        }
                    }
                    else
                    {
                        <div class="text-sm font-semibold text-error-700"><i class="fa-solid fa-xmark mr-1"></i>Первая помощь не удалась</div>
                        <div class="text-xs text-gray-600 mt-0.5">
                            Повторить проверку по этому ранению нельзя — запишите попытку и переходите к Медицине.
                        </div>
                    }
                </div>

                <div class="flex gap-2">
                    <button type="button" class="cm-btn cm-btn-primary w-full" @onclick="Apply">
                        <span>@(success ? "Применить" : "Записать неудачу")</span>
                    </button>
                    <button type="button" class="cm-btn cm-btn-secondary w-full" @onclick="Reset">
                        <span>Сброс</span>
                    </button>
                </div>
            }
            else
            {
                <p class="text-xs text-gray-400 text-center">Введите бросок для оценки результата</p>
            }
        }
    }
</div>

@code {
    [Parameter] public List<Combatant> Combatants { get; set; } = [];
    [Parameter] public EventCallback<(Combatant target, bool isDying, CombatActionResult logEntry)> OnFirstAidApplied { get; set; }
    [Parameter] public Guid? ActiveCombatantId { get; set; }

    private Guid? _lastActiveId;

    protected override void OnParametersSet()
    {
        if (ActiveCombatantId.HasValue && ActiveCombatantId != _lastActiveId)
        {
            _lastActiveId = ActiveCombatantId;
            var active = Combatants.FirstOrDefault(c => c.Id == ActiveCombatantId.Value && !c.IsDead);
            if (active != null) { _healerId = active.Id.ToString(); _healer = active; _roll = null; }
        }
    }

    private string _healerId = "";
    private string _targetId = "";
    private Combatant? _healer;
    private Combatant? _target;
    private int _firstAidSkill = 30;
    private int? _roll;

    private void OnHealerChanged(ChangeEventArgs e)
    {
        _healerId = e.Value?.ToString() ?? "";
        _healer = Guid.TryParse(_healerId, out var id) ? Combatants.FirstOrDefault(c => c.Id == id) : null;
        _roll = null;
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        _targetId = e.Value?.ToString() ?? "";
        _target = Guid.TryParse(_targetId, out var id) ? Combatants.FirstOrDefault(c => c.Id == id) : null;
        _roll = null;
    }

    private void OnRollInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            _roll = Math.Clamp(v, 1, 100);
    }

    private void AutoRoll()
    {
        _roll = CombatService.RollD100();
    }

    private async Task Apply()
    {
        if (_target == null || _healer == null || !_roll.HasValue) return;

        var level = CombatService.CalculateSuccessLevel(_roll.Value, _firstAidSkill);
        var success = level >= SuccessLevel.RegularSuccess;

        var wasDying = _target.IsDying;
        var hpBefore = _target.CurrentHitPoints;

        // Проверка выполняется один раз на ранение — фиксируем и успех, и неудачу (стр. 118)
        _target.FirstAidAttempted = true;

        if (success)
        {
            if (wasDying)
            {
                // Умирающему первая помощь даёт 1 временный ПЗ и стабилизацию.
                // Отметку «При смерти» снимает только последующая Медицина.
                _target.IsStabilized = true;
                _target.TemporaryHitPoints = 1;
                _target.CurrentHitPoints = Math.Max(_target.CurrentHitPoints, 1);
            }
            else
            {
                _target.CurrentHitPoints = Math.Min(_target.CurrentHitPoints + 1, _target.MaxHitPoints);
            }
        }

        var logEntry = new CombatActionResult
        {
            Round = CombatService.CurrentRound,
            AttackerId = _healer!.Id,
            AttackerName = _healer.Name,
            ActionType = CombatActionType.FirstAid,
            DefenderId = _target.Id,
            DefenderName = _target.Name,
            DefenderHpBefore = hpBefore,
            DefenderHpAfter = _target.CurrentHitPoints,
            AttackerRoll = _roll.Value,
            AttackerSkillValue = _firstAidSkill,
            AttackerSuccessLevel = level,
            AttackerWins = success,
            Summary = BuildSummary(success, wasDying, hpBefore)
        };

        await OnFirstAidApplied.InvokeAsync((_target, wasDying, logEntry));
        Reset();
    }

    private string BuildSummary(bool success, bool wasDying, int hpBefore)
    {
        var head = $"{_healer!.Name} оказывает первую помощь {_target!.Name}: " +
                   $"бросок {_roll!.Value}/{_firstAidSkill} — " +
                   CombatService.GetSuccessLevelText(CombatService.CalculateSuccessLevel(_roll.Value, _firstAidSkill)) + ".";

        if (!success)
            return head + " Повторная проверка по этому ранению не допускается.";

        return wasDying
            ? head + $" {_target.Name} стабилизирован: 1 временный ПЗ, проверки ВЫН раз в час. " +
                     "Отметка «При смерти» снимается только Медициной."
            : head + $" +1 ОЗ ({hpBefore}→{_target.CurrentHitPoints}).";
    }

    private void Reset()
    {
        _roll = null;
    }
}
