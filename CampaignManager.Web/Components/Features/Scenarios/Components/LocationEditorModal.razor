@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Components.Features.Music.Model
@using CampaignManager.Web.Components.Features.Music.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Utilities.Services
@inject MarkdownService MarkdownService
@inject MusicTrackService MusicTrackService

<Modal IsVisible="_isVisible"
       OnClose="Hide"
       Title="@(_isEdit ? "Редактировать локацию" : "Добавить локацию")"
       MaxWidth="xl"
       HeaderColorScheme="primary">
    <ChildContent>
        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="cm-field-label">Название</label>
                    <input type="text" @bind="_model.Name" class="cm-input" placeholder="Название локации"/>
                </div>
                <div>
                    <label class="cm-field-label">Адрес</label>
                    <input type="text" @bind="_model.Address" class="cm-input" placeholder="Адрес"/>
                </div>
            </div>

            <div>
                <label class="cm-field-label">Родительская локация</label>
                <select @bind="_selectedParentId" class="cm-input">
                    <option value="">-- Нет (верхний уровень) --</option>
                    @foreach (var loc in _availableParents)
                    {
                        <option value="@loc.Id">@loc.Name</option>
                    }
                </select>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-sm font-medium text-gray-700">Описание (Markdown)</label>
                    <Button ButtonType="button" OnClick="TogglePreview" Variant="primary" Size="sm">
                        @(_showPreview ? "Редактор" : "Просмотр")
                    </Button>
                </div>
                @if (_showPreview && !string.IsNullOrEmpty(_model.Description))
                {
                    <div class="border p-4 rounded-md bg-gray-50 markdown-content min-h-[200px] max-h-[400px] overflow-y-auto">
                        @((MarkupString)MarkdownService.ConvertToHtml(_model.Description))
                    </div>
                }
                else
                {
                    <textarea @bind="_model.Description" class="cm-input" rows="8"
                              placeholder="Описание локации для хранителя..."></textarea>
                }
            </div>

            <!-- Музыка сцены -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Музыка</label>
                <p class="text-xs text-gray-500 mb-2">
                    По тегам кнопка «Играть» в режиме игры берёт случайный трек из подходящих —
                    сцена звучит по-разному. Закреплённый трек добавляется к ним отдельной кнопкой.
                </p>

                @for (var index = 0; index < _model.MusicTags.Count; index++)
                {
                    var i = index;
                    var value = _model.MusicTags[i];
                    <div class="flex gap-2 mb-2">
                        <input type="text" class="cm-input !flex-1" list="cm-location-music-tags"
                               placeholder="напряжение"
                               value="@value"
                               @oninput="e => _model.MusicTags[i] = e.Value?.ToString() ?? string.Empty"/>
                        <Button ButtonType="button" Variant="outline-error" Size="sm" Icon="fa-times"
                                OnClick="() => _model.MusicTags.RemoveAt(i)"/>
                    </div>
                }

                <datalist id="cm-location-music-tags">
                    @foreach (var tag in _knownTags)
                    {
                        <option value="@tag"></option>
                    }
                </datalist>

                <Button ButtonType="button" Variant="outline-primary" Size="sm" Icon="fa-plus"
                        OnClick="() => _model.MusicTags.Add(string.Empty)">Добавить тег</Button>

                @if (_tracks.Count > 0)
                {
                    <div class="mt-3">
                        <span class="block text-sm font-medium text-gray-700 mb-1">Закрепить треки</span>
                        <div class="max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2 space-y-1">
                            @foreach (var track in _tracks)
                            {
                                <label class="flex min-h-[36px] cursor-pointer items-center gap-2">
                                    <input type="checkbox"
                                           class="h-5 w-5 rounded border-primary-300 accent-accent-500"
                                           checked="@_model.MusicTrackIds.Contains(track.Id)"
                                           @onchange="e => ToggleTrack(track.Id, e.Value is true)"/>
                                    <span class="text-sm text-primary-700">@track.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="mt-2 text-xs text-gray-500">
                        Фонотека пуста — треки заводятся на странице «Музыка».
                    </p>
                }
            </div>

            <!-- Skill Checks -->
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">Проверки навыков</label>
                    <Button ButtonType="button" OnClick="AddSkillCheck" Variant="primary" Size="sm" Icon="fa-plus">
                        Добавить
                    </Button>
                </div>
                @if (_model.SkillChecks.Count > 0)
                {
                    <div class="space-y-3">
                        @foreach (var check in _model.SkillChecks)
                        {
                            <div class="border border-gray-200 rounded-md p-3 bg-gray-50">
                                <div class="flex items-start gap-2">
                                    <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-2">
                                        <input type="text" @bind="check.SkillName" class="cm-input" placeholder="Навык"/>
                                        <select @bind="check.Difficulty" class="cm-input">
                                            <option value="">Обычная</option>
                                            <option value="Hard">Сложная</option>
                                            <option value="Extreme">Экстремальная</option>
                                        </select>
                                        <textarea @bind="check.SuccessResult" class="cm-input" rows="2"
                                                  placeholder="При успехе..."></textarea>
                                        <textarea @bind="check.FailureResult" class="cm-input" rows="2"
                                                  placeholder="При провале..."></textarea>
                                    </div>
                                    <Button ButtonType="button" OnClick="() => RemoveSkillCheck(check)" Variant="error" Size="sm" Icon="fa-trash"/>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500">Нет проверок навыков.</p>
                }
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="flex justify-end gap-2">
            <Button ButtonType="button" OnClick="Hide" Variant="secondary">Отмена</Button>
            <Button ButtonType="button" OnClick="Save" Variant="primary" IsDisabled="@(string.IsNullOrWhiteSpace(_model.Name))">
                @(_isEdit ? "Сохранить" : "Добавить")
            </Button>
        </div>
    </FooterContent>
</Modal>

@code {
    [Parameter] public EventCallback<ScenarioLocation> OnSaved { get; set; }

    private bool _isVisible;
    private bool _isEdit;
    private bool _showPreview;
    private ScenarioLocation _model = new() { Name = "" };
    private List<ScenarioLocation> _availableParents = [];
    private string _selectedParentId = "";
    private List<MusicTrack> _tracks = [];
    private List<string> _knownTags = [];

    protected override async Task OnInitializedAsync()
    {
        _tracks = await MusicTrackService.GetAllTracksAsync();
        _knownTags = await MusicTrackService.GetAllTagsAsync();
    }

    private void ToggleTrack(Guid trackId, bool selected)
    {
        if (selected)
        {
            if (!_model.MusicTrackIds.Contains(trackId)) _model.MusicTrackIds.Add(trackId);
        }
        else
        {
            _model.MusicTrackIds.Remove(trackId);
        }
    }

    public void Show(List<ScenarioLocation> existingLocations, ScenarioLocation? editLocation = null)
    {
        _isEdit = editLocation is not null;

        if (editLocation is not null)
        {
            _model = new ScenarioLocation
            {
                Id = editLocation.Id,
                Name = editLocation.Name,
                Address = editLocation.Address,
                Description = editLocation.Description,
                Order = editLocation.Order,
                ParentLocationId = editLocation.ParentLocationId,
                SkillChecks = editLocation.SkillChecks.Select(sc => new ScenarioSkillCheck
                {
                    Id = sc.Id,
                    SkillName = sc.SkillName,
                    Difficulty = sc.Difficulty,
                    SuccessResult = sc.SuccessResult,
                    FailureResult = sc.FailureResult
                }).ToList(),
                CreatureIds = [..editLocation.CreatureIds],
                ItemIds = [..editLocation.ItemIds],
                NpcIds = [..editLocation.NpcIds],
                HandoutIds = [..editLocation.HandoutIds],
                // Новое поле локации обязано попасть в эту копию: то, чего здесь нет,
                // молча стирается при любой правке локации.
                MusicTags = [..editLocation.MusicTags],
                // Удалённый из фонотеки трек оставил бы за собой висячий идентификатор во всех
                // локациях, где был закреплён. Пул его и так не найдёт, но копить мусор незачем —
                // отбрасываем при первой же правке локации.
                MusicTrackIds = [..editLocation.MusicTrackIds.Where(id => _tracks.Any(t => t.Id == id))]
            };
            _selectedParentId = editLocation.ParentLocationId?.ToString() ?? "";
            _availableParents = existingLocations.Where(l => l.Id != editLocation.Id).ToList();
        }
        else
        {
            _model = new ScenarioLocation
            {
                Name = "",
                Order = existingLocations.Count
            };
            _selectedParentId = "";
            _availableParents = existingLocations.ToList();
        }

        _showPreview = false;
        _isVisible = true;
        StateHasChanged();
    }

    private void Hide()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private void TogglePreview() => _showPreview = !_showPreview;

    private void AddSkillCheck()
    {
        _model.SkillChecks.Add(new ScenarioSkillCheck { SkillName = "" });
    }

    private void RemoveSkillCheck(ScenarioSkillCheck check)
    {
        _model.SkillChecks.Remove(check);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_model.Name)) return;

        _model.ParentLocationId = Guid.TryParse(_selectedParentId, out var parentId) ? parentId : null;
        // «Бой», «бой » и «бой» должны попасть в один пул — приводим к канону до сохранения.
        _model.MusicTags = MusicSource.NormalizeTags(_model.MusicTags);

        await OnSaved.InvokeAsync(_model);
        Hide();
    }
}
