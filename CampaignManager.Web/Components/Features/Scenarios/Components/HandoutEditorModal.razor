@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Utilities.Services
@inject MarkdownService MarkdownService

<Modal IsVisible="_isVisible"
       OnClose="Hide"
       Title="@(_isEdit ? "Редактировать раздатку" : "Добавить раздатку")"
       MaxWidth="lg"
       HeaderColorScheme="primary">
    <ChildContent>
        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="cm-field-label">Название</label>
                    @* oninput, а не change: кнопка «Добавить» зависит от названия, и с change она
                       включалась только на blur — первый тап по ней сразу после ввода приходился
                       в ещё выключенную кнопку и терялся, форма оставалась открытой. *@
                    <input type="text" @bind="_model.Name" @bind:event="oninput" class="cm-input" placeholder="Название раздатки"/>
                </div>
                <div>
                    <label class="cm-field-label">URL файла</label>
                    <input type="text" @bind="_model.FileUrl" class="cm-input" placeholder="Ссылка на изображение или файл"/>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_model.FileUrl))
            {
                <div class="border rounded-md p-2 bg-gray-50">
                    <img src="@_model.FileUrl" alt="@_model.Name" class="max-h-48 mx-auto rounded"/>
                </div>
            }

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="cm-field-label cm-field-label-inline">
                        Текст для игроков <span class="cm-field-hint">(markdown)</span>
                    </label>
                    <Button ButtonType="button" OnClick="TogglePreview" Variant="secondary" Size="sm">
                        @(_showPreview ? "Редактор" : "Просмотр")
                    </Button>
                </div>
                @if (_showPreview && !string.IsNullOrEmpty(_model.Description))
                {
                    <div class="border p-4 rounded-md bg-gray-50 markdown-content min-h-[150px] max-h-[300px] overflow-y-auto">
                        @((MarkupString)MarkdownService.ConvertToHtml(_model.Description))
                    </div>
                }
                else
                {
                    <textarea @bind="_model.Description" class="cm-input" rows="6"
                              placeholder="Текстовое содержание раздатки..."></textarea>
                }
            </div>

            @* Всё, что игроку читать нельзя («выдать после второй ночи», «проверка Рассудка 1/1d6»),
               пишется сюда: «Показать игрокам» и второй экран выводят только текст выше. *@
            <div>
                <label class="cm-field-label">
                    <i class="fa-solid fa-eye-slash"></i> Заметка Хранителя
                    <span class="cm-field-hint">(игроки её не увидят)</span>
                </label>
                <textarea @bind="_model.KeeperNote" class="cm-input" rows="2"
                          placeholder="Когда выдать, кому, какие проверки вызывает…"></textarea>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        @if (_saveFailed)
        {
            <Alert Type="error" ShowIcon Small class="!mb-0 sm:mr-auto">
                Не сохранилось — правки остались в форме, попробуйте ещё раз.
            </Alert>
        }
        <div class="flex justify-end gap-2">
            <Button ButtonType="button" OnClick="Hide" Variant="secondary" IsDisabled="_saving">Отмена</Button>
            <Button ButtonType="button" OnClick="Save" Variant="primary"
                    IsDisabled="@(_saving || string.IsNullOrWhiteSpace(_model.Name))">
                @(_saving ? "Сохранение…" : _isEdit ? "Сохранить" : "Добавить")
            </Button>
        </div>
    </FooterContent>
</Modal>

@code {
    /// <summary>
    ///     Сохранить раздатку; <c>false</c> — не вышло, и форма остаётся открытой с правками.
    ///     Раньше это был EventCallback: форма закрывалась и при отказе, молча теряя введённое.
    /// </summary>
    [Parameter, EditorRequired] public required Func<ScenarioHandout, Task<bool>> OnSave { get; set; }

    private bool _isVisible;
    private bool _isEdit;
    private bool _showPreview;
    private bool _saving;
    private bool _saveFailed;
    private ScenarioHandout _model = new() { Name = "" };

    public void Show(ScenarioHandout? editHandout = null, int nextOrder = 0)
    {
        _isEdit = editHandout is not null;

        if (editHandout is not null)
        {
            _model = new ScenarioHandout
            {
                Id = editHandout.Id,
                Name = editHandout.Name,
                Description = editHandout.Description,
                FileUrl = editHandout.FileUrl,
                KeeperNote = editHandout.KeeperNote,
                Order = editHandout.Order
            };
        }
        else
        {
            _model = new ScenarioHandout
            {
                Name = "",
                Order = nextOrder
            };
        }

        _showPreview = false;
        _saveFailed = false;
        _isVisible = true;
        StateHasChanged();
    }

    private void Hide()
    {
        if (_saving) return;
        _isVisible = false;
        StateHasChanged();
    }

    private void TogglePreview() => _showPreview = !_showPreview;

    /// <summary>
    ///     Пока идёт запись (с перечитыванием сценария — это секунды), кнопки выключены: второй тап
    ///     по «Добавить» раньше заводил ту же раздатку второй раз.
    /// </summary>
    private async Task Save()
    {
        if (_saving || string.IsNullOrWhiteSpace(_model.Name)) return;

        _saving = true;
        _saveFailed = false;
        bool saved;
        try
        {
            saved = await OnSave(_model);
        }
        finally
        {
            _saving = false;
        }

        if (saved)
            Hide();
        else
            _saveFailed = true;
    }
}
