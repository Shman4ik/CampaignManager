@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Model
@using CampaignManager.Web.Utilities.Services
@inject ScenarioService ScenarioService
@inject CharacterService CharacterService
@inject IdentityService IdentityService
@inject NavigationManager NavigationManager
@inject MarkdownService MarkdownService

@rendermode InteractiveServer

@if (_scenarios is not null && _scenarios.Count > 0)
{
    <div class="oneshot-section">
        @foreach (var scenario in _scenarios)
        {
            var pregens = scenario.Pregens
                .Where(n => n.Kind == CharacterKind.Pregen && n.Status != CharacterStatus.Archived)
                .ToList();
            <div class="oneshot-card">
                <!-- Header -->
                <div class="scenario-hd">
                    <div class="hd-left">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span class="hd-label">Активный ваншот</span>
                    </div>
                    @if (scenario.ScheduledDate.HasValue)
                    {
                        <span class="hd-date">
                            @scenario.ScheduledDate.Value.ToString("d MMMM yyyy, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))
                        </span>
                    }
                </div>

                <!-- Body -->
                <div class="card-body">
                    <div class="body-layout">
                        <!-- Left: Scenario info -->
                        <div class="scenario-info">
                            <h2 class="scenario-title">@scenario.Name</h2>

                            @* Длинный анонс свёрнут: целиком он занимал полэкрана главной. Но рядом со списком
                               персонажей колонка и так не ниже этого списка, и три строки с «Подробнее» там только
                               прятали текст, под которым пусто, — поэтому при прегенах режем лишь очень длинный анонс
                               и до высоты списка. Раскрытие — в поле, не в адресе: после паузы circuit анонс просто
                               снова свёрнут, и это не потеря. *@
                            @{
                                var descLength = !string.IsNullOrEmpty(scenario.AnnouncementText)
                                    ? scenario.AnnouncementText.Length
                                    : scenario.Description?.Length ?? 0;
                                var besidePregens = pregens.Count > 0;
                                var collapsible = descLength > (besidePregens ? DescriptionClampCharsBesidePregens : DescriptionClampChars);
                                var collapsed = collapsible && !_expandedDescriptions.Contains(scenario.Id);
                                var clampClass = collapsed ? (besidePregens ? "scenario-desc--clamped scenario-desc--clamped-tall" : "scenario-desc--clamped") : "";
                                var scenarioId = scenario.Id;
                            }
                            @if (!string.IsNullOrEmpty(scenario.AnnouncementText))
                            {
                                <div class="scenario-desc markdown-content @clampClass">
                                    @((MarkupString)MarkdownService.ConvertToHtml(scenario.AnnouncementText))
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(scenario.Description))
                            {
                                <p class="scenario-desc @clampClass">@scenario.Description</p>
                            }
                            @if (collapsible)
                            {
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm mb-2.5"
                                        aria-expanded="@(collapsed ? "false" : "true")"
                                        @onclick="() => ToggleDescription(scenarioId)">
                                    <i class="fa-solid @(collapsed ? "fa-chevron-down" : "fa-chevron-up") mr-1" aria-hidden="true"></i>@(collapsed ? "Подробнее" : "Свернуть")
                                </button>
                            }

                            <div class="meta-tags">
                                @if (!string.IsNullOrEmpty(scenario.Era))
                                {
                                    <span class="era-badge">@scenario.Era</span>
                                }
                                @if (!string.IsNullOrEmpty(scenario.Location))
                                {
                                    <span class="location-text">@scenario.Location</span>
                                }
                            </div>
                        </div>

                        <!-- Right: Characters (hidden on mobile) -->
                        @if (pregens.Count > 0)
                        {
                            @* Сетка из двух колонок, строки — subgrid: колонка кнопок одной ширины по самой
                               широкой («Забронировать»), и кнопки стоят ровным столбцом. Кто занял персонажа —
                               строкой под именем: Хранителю это важнее, чем кнопка «Освободить». *@
                            var freeCount = pregens.Count(p => !p.CampaignPlayerId.HasValue);
                            <div class="pregens-panel">
                                <div class="pregens-title">
                                    <span>Персонажи</span>
                                    <span class="pregens-count">свободно @freeCount из @pregens.Count</span>
                                </div>
                                @foreach (var pregen in pregens)
                                {
                                    var pregenId = pregen.Id;
                                    var isReserved = pregen.CampaignPlayerId.HasValue;
                                    var isMine = isReserved && !string.IsNullOrEmpty(_currentUserEmail)
                                                 && pregen.CampaignPlayer is not null
                                                 && string.Equals(pregen.CampaignPlayer.PlayerEmail, _currentUserEmail, StringComparison.OrdinalIgnoreCase);
                                    var occupation = pregen.Character?.PersonalInfo?.Occupation;
                                    <div class="pregen-row @(isReserved ? "pregen-row--taken" : "")">
                                        <div class="pregen-info" @onclick="() => NavigateToCharacter(pregenId)">
                                            <div class="pregen-avatar">
                                                @(pregen.CharacterName?.Length > 0 ? pregen.CharacterName[0].ToString().ToUpper() : "?")
                                            </div>
                                            <div>
                                                <div class="pregen-name">@pregen.CharacterName</div>
                                                @if (!string.IsNullOrEmpty(occupation))
                                                {
                                                    <div class="pregen-occ">@occupation</div>
                                                }
                                                @if (isMine)
                                                {
                                                    <div class="pregen-status pregen-status--mine"><i class="fa-solid fa-check" aria-hidden="true"></i> Ваш персонаж</div>
                                                }
                                                else if (isReserved)
                                                {
                                                    <div class="pregen-status"><i class="fa-solid fa-user" aria-hidden="true"></i> @(pregen.CampaignPlayer?.PlayerName ?? "Занят")</div>
                                                }
                                            </div>
                                        </div>
                                        @if (isMine || (isReserved && _access.GetValueOrDefault(scenario.Id).CanEdit))
                                        {
                                            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm" @onclick="() => OpenReleaseConfirm(pregen)">Освободить</button>
                                        }
                                        else if (isReserved)
                                        {
                                            <span class="reserved-label">Занят</span>
                                        }
                                        else
                                        {
                                            <AuthorizeView>
                                                <Authorized>
                                                    <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="() => OpenReserveConfirm(pregen, scenario)">Забронировать</button>
                                                </Authorized>
                                                <NotAuthorized>
                                                    <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick='() => NavigationManager.NavigateTo("/api/account/login", true)'>Войти</button>
                                                </NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_notification))
    {
        <div class="mb-4">
            <NotificationAlert Type="@_notificationType" Message="@_notification" OnClose="ClearNotification" />
        </div>
    }

    <ConfirmationModal IsVisible="_showConfirm"
                       Title="Забронировать персонажа"
                       Message="@($"Забронировать «{_pendingPregen?.CharacterName}» на ваншот «{_pendingScenario?.Name}»? После подтверждения персонаж станет вашим на эту игру.")"
                       ConfirmText="Забронировать"
                       CancelText="Отмена"
                       WarningText=""
                       IconType="info"
                       OnConfirm="ConfirmReserve"
                       OnCancel="CancelReserve" />

    <ConfirmationModal IsVisible="_showReleaseConfirm"
                       Title="Освободить персонажа"
                       Message="@($"Освободить «{_pendingPregen?.CharacterName}»? Персонаж снова станет доступен для бронирования.")"
                       ConfirmText="Освободить"
                       CancelText="Отмена"
                       WarningText=""
                       IconType="warning"
                       OnConfirm="ConfirmRelease"
                       OnCancel="CancelRelease" />
}

@code {
    private List<Scenario>? _scenarios;
    private string? _currentUserEmail;

    /// <summary>
    ///     Права на каждый анонс: чужую бронь снимает только ведущий сценария
    ///     (<c>CharacterService.ReleasePregenAsync</c>), а не любой Хранитель.
    /// </summary>
    private Dictionary<Guid, ScenarioAccess> _access = [];
    private bool _showConfirm;
    private bool _showReleaseConfirm;
    private CharacterStorageDto? _pendingPregen;
    private Scenario? _pendingScenario;
    private string? _notification;
    private string _notificationType = "info";

    /// <summary>Длиннее этого анонс сворачивается до трёх строк — примерно столько в них и влезает.</summary>
    private const int DescriptionClampChars = 240;

    /// <summary>Порог рядом со списком персонажей: до него анонс не выше самого списка (~12 строк).</summary>
    private const int DescriptionClampCharsBesidePregens = 800;

    private readonly HashSet<Guid> _expandedDescriptions = [];

    private void ToggleDescription(Guid scenarioId)
    {
        if (!_expandedDescriptions.Remove(scenarioId))
            _expandedDescriptions.Add(scenarioId);
    }

    protected override async Task OnInitializedAsync()
    {
        // Асинхронно: синхронный GetCurrentUserEmail в интерактивном рендере отдаёт null,
        // и своя бронь не узнавалась — «Освободить» у игрока пропадала.
        _currentUserEmail = await IdentityService.GetCurrentUserEmailAsync();
        await LoadScenariosAsync();
    }

    private async Task LoadScenariosAsync()
    {
        _scenarios = await ScenarioService.GetPublishedScenariosAsync();
        _access = await ScenarioService.GetAccessAsync(_scenarios);
    }

    private void NavigateToCharacter(Guid characterId)
    {
        NavigationManager.NavigateTo($"/character/{characterId}");
    }

    private void OpenReserveConfirm(CharacterStorageDto pregen, Scenario scenario)
    {
        _pendingPregen = pregen;
        _pendingScenario = scenario;
        _showConfirm = true;
    }

    private void CancelReserve()
    {
        _showConfirm = false;
        _pendingPregen = null;
        _pendingScenario = null;
    }

    private async Task ConfirmReserve()
    {
        if (_pendingPregen is null)
        {
            _showConfirm = false;
            return;
        }

        var pregenId = _pendingPregen.Id;
        _showConfirm = false;

        try
        {
            await CharacterService.ReservePregenAsync(pregenId);
            ScenarioService.InvalidatePublishedCache();
            await LoadScenariosAsync();
            _notification = "Персонаж успешно забронирован";
            _notificationType = "success";
            NavigationManager.NavigateTo($"/character/{pregenId}");
        }
        catch (InvalidOperationException ex)
        {
            _notification = ex.Message;
            _notificationType = "error";
            await LoadScenariosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/api/account/login", true);
        }
        finally
        {
            _pendingPregen = null;
            _pendingScenario = null;
        }
    }

    private void OpenReleaseConfirm(CharacterStorageDto pregen)
    {
        _pendingPregen = pregen;
        _showReleaseConfirm = true;
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingPregen = null;
    }

    private async Task ConfirmRelease()
    {
        if (_pendingPregen is null)
        {
            _showReleaseConfirm = false;
            return;
        }

        var pregenId = _pendingPregen.Id;
        _showReleaseConfirm = false;

        try
        {
            await CharacterService.ReleasePregenAsync(pregenId);
            await LoadScenariosAsync();
            _notification = "Персонаж освобождён";
            _notificationType = "success";
        }
        catch (InvalidOperationException ex)
        {
            _notification = ex.Message;
            _notificationType = "error";
        }
        catch (UnauthorizedAccessException ex)
        {
            _notification = ex.Message;
            _notificationType = "error";
        }
        finally
        {
            _pendingPregen = null;
        }
    }

    private void ClearNotification()
    {
        _notification = null;
        StateHasChanged();
    }
}
