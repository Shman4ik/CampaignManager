@* Заметка Хранителя к раздатке (ScenarioHandout.KeeperNote). Ставится только на экраны
   Хранителя — режим игры, обзор и редактор сценария. В показ игрокам (HandoutShowcase) и на
   второй экран (ScenarioHandoutPage) её не ставить: ради этого она и отделена от текста раздатки. *@
@if (!string.IsNullOrWhiteSpace(Note))
{
    <p class="mt-1 flex gap-1.5 text-xs italic text-secondary-700">
        <i class="fa-solid fa-eye-slash mt-0.5 shrink-0" aria-hidden="true"></i>
        <span><span class="font-semibold not-italic">Хранителю:</span> @Note</span>
    </p>
}

@code {
    [Parameter] public string? Note { get; set; }
}
