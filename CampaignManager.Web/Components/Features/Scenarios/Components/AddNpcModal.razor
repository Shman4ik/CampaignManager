@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Extensions
@using CampaignManager.Web.Model

<Modal IsVisible="_isVisible"
       OnClose="Hide"
       Title="@ModalTitle"
       MaxWidth="lg"
       HeaderColorScheme="primary">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="mb-4 p-3 rounded-md bg-red-50 text-red-700 border border-red-200">
                @_errorMessage
            </div>
        }

        <div class="mb-4">
            <input type="text"
                   placeholder="Поиск по имени..."
                   @bind-value="_searchTerm"
                   @bind-value:event="oninput"
                   class="cm-input"/>
        </div>

        @if (Kind == CharacterKind.Npc)
        {
            <div class="grid grid-cols-2 gap-3 mb-4">
                <div>
                    <label class="cm-field-label">Роль НПС</label>
                    <select @bind="_selectedRole" class="cm-input">
                        @foreach (var role in Enum.GetValues<NpcRole>())
                        {
                            <option value="@role">@role.ToRussianString()</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="cm-field-label">Сколько</label>
                    <input type="number" min="1" max="20" @bind="_count" class="cm-input"/>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 gap-3 max-h-[50vh] overflow-y-auto">
            @if (!FilteredNpcs.Any())
            {
                <div class="text-center p-4 text-gray-500">
                    Нет доступных персонажей.
                </div>
            }
            else
            {
                @foreach (var npc in FilteredNpcs)
                {
                    <div
                        class="border p-3 rounded-lg hover:bg-gray-50 cursor-pointer transition-all duration-200 @(_selectedNpc?.Id == npc.Id ? "border-primary-500 bg-primary-50" : "border-gray-200")"
                        @onclick="() => SelectNpc(npc)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <h3 class="font-medium">@npc.CharacterName</h3>
                                <Badge Variant="@(npc.Kind == CharacterKind.Npc ? "error" : "info")" Size="sm" Rounded="full" WithBorder="false">
                                    @npc.Kind.ToRussianString()
                                </Badge>
                            </div>
                            <Button OnClick="() => SelectNpc(npc)" Variant="info" Size="sm">
                                Выбрать
                            </Button>
                        </div>
                        <div class="mt-1 text-sm text-gray-600">
                            @if (!string.IsNullOrEmpty(npc.Character?.PersonalInfo?.Occupation))
                            {
                                <span class="mr-3">@npc.Character.PersonalInfo.Occupation</span>
                            }
                            @if (npc.Character?.PersonalInfo?.Age is not null)
                            {
                                <span>@npc.Character.PersonalInfo.Age лет</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </ChildContent>
    <FooterContent>
		<Button OnClick="Hide" Variant="secondary">Отмена</Button>
		<Button OnClick="AddToScenarioAsync" Variant="primary" IsDisabled="@(_selectedNpc is null)">Добавить</Button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public Guid ScenarioId { get; set; }

    /// <summary>Что добавляем: НПС занимается связью, преген копируется в сценарий.</summary>
    [Parameter] public CharacterKind Kind { get; set; } = CharacterKind.Npc;

    [Parameter] public EventCallback OnAdded { get; set; }

    [Inject] private CharacterService CharacterService { get; set; } = null!;
    [Inject] private ScenarioService ScenarioService { get; set; } = null!;
    [Inject] private ILogger<AddNpcModal> Logger { get; set; } = null!;

    private bool _isVisible;
    private string _searchTerm = string.Empty;
    private List<CharacterStorageDto> _available = [];
    private CharacterStorageDto? _selectedNpc;
    private string? _errorMessage;
    private NpcRole _selectedRole = NpcRole.Neutral;
    private int _count = 1;

    private string ModalTitle => Kind switch
    {
        CharacterKind.Npc => "Добавить НПС в сценарий",
        CharacterKind.Pregen => "Добавить преген-персонажа в сценарий",
        _ => "Добавить персонажа в сценарий"
    };

    private IEnumerable<CharacterStorageDto> FilteredNpcs =>
        _available
            .Where(n => string.IsNullOrWhiteSpace(_searchTerm)
                        || n.CharacterName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .Take(10);

    public async Task Show()
    {
        _selectedNpc = null;
        _searchTerm = string.Empty;
        _errorMessage = null;
        _selectedRole = NpcRole.Neutral;
        _count = 1;

        await LoadAvailableAsync();

        _isVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    public void Hide()
    {
        _isVisible = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectNpc(CharacterStorageDto npc) => _selectedNpc = npc;

    private async Task LoadAvailableAsync()
    {
        try
        {
            _available = Kind is CharacterKind.Npc
                ? await CharacterService.GetNpcsAsync()
                : await CharacterService.GetPregenTemplatesAsync();
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading characters for scenario {ScenarioId}", ScenarioId);
            _available = [];
            _errorMessage = "Не удалось загрузить персонажей. Попробуйте ещё раз.";
        }
    }

    private async Task AddToScenarioAsync()
    {
        if (_selectedNpc is null)
        {
            _errorMessage = "Выберите персонажа перед добавлением.";
            return;
        }

        try
        {
            if (Kind is CharacterKind.Npc)
            {
                // Лист не копируется: НПС занимается в сценарии связью.
                await ScenarioService.AddNpcToScenarioAsync(ScenarioId, _selectedNpc.Id, _selectedRole, _count);
            }
            else
            {
                // Преген расходуется игроком, поэтому сценарию нужна собственная копия листа.
                await CharacterService.CopyPregenToScenarioAsync(_selectedNpc.Id, ScenarioId);
            }

            await OnAdded.InvokeAsync();
            _errorMessage = null;
            Hide();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding character {CharacterId} to scenario {ScenarioId}", _selectedNpc.Id, ScenarioId);
            _errorMessage = "Не удалось добавить персонажа в сценарий.";
            await InvokeAsync(StateHasChanged);
        }
    }
}
