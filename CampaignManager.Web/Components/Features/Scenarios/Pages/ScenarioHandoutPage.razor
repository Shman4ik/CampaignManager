@page "/scenarios/{ScenarioId:guid}/handouts/{HandoutId:guid}"
@using CampaignManager.Web.Components.Features.Scenarios.Components
@using CampaignManager.Web.Components.Features.Scenarios.Services
@layout HandoutScreenLayout
@attribute [Authorize]
@inject ScenarioHandoutService HandoutService

@* Второй экран: одна раздатка на весь экран — телевизор, проектор или планшет игрока.
   Страница статическая (без @rendermode) и в лэйауте без интерактивных островов, так что
   circuit у неё нет и обрываться нечему. Какая раздатка — целиком в адресе; права проверяет
   ScenarioHandoutService. Шапки PageHeader здесь нет намеренно, как и у режима игры, —
   кроме случая, когда показывать нечего. *@

<PageTitle>Раздатка</PageTitle>

@if (_display is null)
{
    <PageHeader Title="Раздатка"/>
    <div class="cm-page">
        <Alert Type="error" Title="Раздатка недоступна">
            Раздатка не найдена, или вы не ведёте этот сценарий и не играете в его кампании.
        </Alert>
    </div>
}
else
{
    <HandoutShowcase Handout="_display.Handout" CloseHref="@CloseHref"/>
}

@code {
    [Parameter] public Guid ScenarioId { get; set; }

    [Parameter] public Guid HandoutId { get; set; }

    private HandoutDisplay? _display;

    // Ведущий возвращается к сценарию, игрок — на главную: страницы сценария ему не открыть.
    private string CloseHref => _display?.CanManage == true ? $"/scenarios/{ScenarioId}" : "/";

    protected override async Task OnParametersSetAsync() =>
        _display = await HandoutService.GetHandoutForDisplayAsync(ScenarioId, HandoutId);
}
