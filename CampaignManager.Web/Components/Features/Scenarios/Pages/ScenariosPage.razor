@page "/scenarios"
@using CampaignManager.Web.Components.Features.Scenarios.Components
@using CampaignManager.Web.Components.Features.Scenarios.Model
@using CampaignManager.Web.Components.Features.Scenarios.Services
@using CampaignManager.Web.Utilities.Services
@attribute [Authorize]
@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager
@inject ILogger<ScenariosPage> Logger
@inject IdentityService IdentityService
@rendermode InteractiveServer
<PageTitle>Шаблоны сценариев</PageTitle>

<PageHeader Title="Шаблоны сценариев">
    <Actions>
        @if (_isKeeper)
        {
            <Button Variant="secondary" Size="sm" Icon="fa-file-import" OnClick="ShowImportModal">Импорт JSON</Button>
            <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="@(() => NavigationManager.NavigateTo("/scenarios/new"))">
                <i class="fas fa-plus"></i> <span>Новый шаблон</span>
            </button>
        }
    </Actions>
</PageHeader>

@if (!_isKeeper)
{
    <div class="cm-page">
        <Alert Type="error" Title="Доступ запрещён">
            Эта страница доступна только для Хранителя.
        </Alert>
    </div>
}
else
{
<div class="cm-page">

    @if (_loading)
    {
        <LoadingIndicator/>
    }
    else if (_scenarios.Count == 0)
    {
        <EmptyState IconClass="fa-masks-theater"
                    Title="Шаблонов нет"
                    Message="Создайте новый шаблон или перенесите готовый сценарий из JSON-файла.">
            <ActionButton>
                <Button Variant="primary" Icon="fa-plus" OnClick="@(() => NavigationManager.NavigateTo("/scenarios/new"))">Новый шаблон</Button>
                <Button Variant="secondary" Icon="fa-file-import" OnClick="ShowImportModal">Импорт JSON</Button>
            </ActionButton>
        </EmptyState>
    }
    else
    {
        <FilterPanel OnReset="ClearFilters">
            <div class="min-w-[12rem] flex-1">
                <input type="search" id="scenarioSearch" placeholder="Поиск по названию..."
                       aria-label="Поиск по названию"
                       class="cm-input"
                       @bind="_searchTerm" @bind:event="oninput"/>
            </div>
        </FilterPanel>

        @if (!FilteredScenarios.Any())
        {
            <EmptyState IconClass="fa-search"
                        Title="Шаблоны не найдены"
                        Message="Нет шаблонов, подходящих под поиск.">
                <ActionButton>
                    <Button Variant="secondary" Icon="fa-undo-alt" OnClick="ClearFilters">Очистить фильтры</Button>
                </ActionButton>
            </EmptyState>
        }
        else
        {
        @* Три колонки только с xl: на портрете iPad (1024) lg уже срабатывает, и карточки
           сжимались до ~230px, а футер с тремя кнопками — до предела тап-цели. *@
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var scenario in FilteredScenarios)
            {
                var access = AccessOf(scenario);
                <div class="cm-card hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
                    <div class="cm-card-header">
                        <span class="cm-card-title truncate">@scenario.Name</span>
                    </div>
                    <div class="cm-card-body flex-grow">
                        @if (!string.IsNullOrEmpty(scenario.Era) || !string.IsNullOrEmpty(scenario.Location))
                        {
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                @if (!string.IsNullOrEmpty(scenario.Era))
                                {
                                    <Badge Variant="secondary" Size="sm" WithBorder="false">@scenario.Era</Badge>
                                }
                                @if (!string.IsNullOrEmpty(scenario.Location))
                                {
                                    <Badge Variant="primary" Size="sm" WithBorder="false">@scenario.Location</Badge>
                                }
                            </div>
                        }

                        <p class="cm-text-muted line-clamp-3">
                            @(string.IsNullOrEmpty(scenario.Description)
                                ? "Описание отсутствует."
                                : scenario.Description)
                        </p>
                    </div>
                    <div class="cm-card-footer mt-auto flex-col gap-1.5">
                        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm w-full justify-center" @onclick="@(() => NavigationManager.NavigateTo($"/scenarios/{scenario.Id}"))">
                            <i class="fas fa-eye"></i> <span>Просмотр</span>
                        </button>
                        @* Кнопки — по правам из ScenarioService: удалить шаблон может только автор
                           или администратор, а опубликованный ваншот уже привязан к кампании
                           и правится только её Хранителем. *@
                        @if (access.CanEdit || access.CanDelete)
                        {
                            <div class="grid @(access.CanEdit && access.CanDelete ? "grid-cols-2" : "grid-cols-1") gap-1.5 w-full">
                                @if (access.CanEdit)
                                {
                                    <button type="button" class="cm-btn cm-btn-outline-primary cm-btn-sm justify-center" @onclick="@(() => NavigationManager.NavigateTo($"/scenarios/{scenario.Id}/edit"))">
                                        <i class="fas fa-edit"></i> <span>Изменить</span>
                                    </button>
                                }
                                @if (access.CanDelete)
                                {
                                    <Button Variant="outline-error" Size="sm" Icon="fa-trash-alt" OnClick="@(() => ConfirmDelete(scenario))" AdditionalClasses="justify-center">Удалить</Button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
<ConfirmationModal IsVisible="_showDeleteModal"
                   OnConfirm="DeleteScenario"
                   OnCancel="@(() => { _showDeleteModal = false; _scenarioToDelete = null; })"
                   Title="Подтверждение удаления"
                   Message="@($"Вы уверены что хотите удалить шаблон сценария \"{_scenarioToDelete?.Name}\"?")"
                   ConfirmText="Удалить"
                   IconType="error" />

<!-- Import Scenario Modal -->
<ScenarioImportModal @ref="_importModal" OnImported="LoadScenarios"/>
}

@code {
    private List<Scenario> _scenarios = [];
    private bool _loading = true;
    private bool _showDeleteModal;
    private Scenario? _scenarioToDelete;
    private string _searchTerm = string.Empty;
    private bool _isKeeper;
    private ScenarioImportModal? _importModal;

    /// <summary>Права на каждую карточку: считает ScenarioService, страница только прячет кнопки.</summary>
    private Dictionary<Guid, ScenarioAccess> _access = [];

    private ScenarioAccess AccessOf(Scenario scenario) => _access.GetValueOrDefault(scenario.Id);

    private void ShowImportModal()
    {
        if (_importModal is null)
        {
            Logger.LogWarning("ScenarioImportModal reference is not initialized");
            return;
        }

        _importModal.Show();
    }

    private void ClearFilters() => _searchTerm = string.Empty;

    private IEnumerable<Scenario> FilteredScenarios => string.IsNullOrWhiteSpace(_searchTerm)
        ? _scenarios
        : _scenarios.Where(s => s.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _isKeeper = await IdentityService.IsKeeper();
        await LoadScenarios();
    }

    private async Task LoadScenarios()
    {
        try
        {
            _loading = true;
            _scenarios = await ScenarioService.GetAllScenariosAsync(true);
            _access = await ScenarioService.GetAccessAsync(_scenarios);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading scenario templates");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ConfirmDelete(Scenario scenario)
    {
        if (!AccessOf(scenario).CanDelete) return;

        _scenarioToDelete = scenario;
        _showDeleteModal = true;
    }

    private async Task DeleteScenario()
    {
        if (_scenarioToDelete is null)
        {
            return;
        }

        try
        {
            var success = await ScenarioService.DeleteScenarioAsync(_scenarioToDelete.Id);
            if (success)
            {
                await LoadScenarios();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting scenario {ScenarioId}", _scenarioToDelete.Id);
        }
        finally
        {
            _showDeleteModal = false;
            _scenarioToDelete = null;
        }
    }

}
