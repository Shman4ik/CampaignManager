@page "/reference"
@attribute [Authorize]
@rendermode InteractiveServer
@using CampaignManager.Web.Components.Features.KeeperScreen.Components
@using CampaignManager.Web.Components.Features.KeeperScreen.Model
@using CampaignManager.Web.Utilities.Services
@inject IdentityService IdentityService
@inject NavigationManager NavigationManager

@* Ширма Хранителя отдельной страницей — для закладки на планшете. Содержимое то же, что в
   выезжающей панели (KeeperReference); открытый раздел живёт в адресе (?block=…), а не в поле:
   так он переживает паузу circuit и F5, и на него можно дать ссылку. *@

<PageTitle>Ширма Хранителя</PageTitle>

<PageHeader Title="Ширма Хранителя" ShowKeeperScreen="false"/>

@if (_isKeeper is null)
{
    <div class="cm-page">
        <LoadingIndicator/>
    </div>
}
else if (_isKeeper is false)
{
    <div class="cm-page">
        <Alert Type="error" Title="Доступ запрещён">
            Ширма — справочник Хранителя, эта страница доступна только ему.
        </Alert>
    </div>
}
else
{
    <div class="cm-page">
        <div class="cm-card">
            <div class="cm-card-body">
                <KeeperReference ActiveBlock="@ActiveBlock" ActiveBlockChanged="@SelectBlock"/>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "block")]
    public string? Block { get; set; }

    private bool? _isKeeper;

    private KeeperScreenBlock ActiveBlock => KeeperScreenBlocks.FromSlug(Block);

    protected override async Task OnInitializedAsync() => _isKeeper = await IdentityService.IsKeeper();

    /// <summary><c>replace: true</c> — переключение разделов не должно забивать историю «назад».</summary>
    private void SelectBlock(KeeperScreenBlock block) =>
        NavigationManager.NavigateTo(
            NavigationManager.GetUriWithQueryParameter("block", KeeperScreenBlocks.Slug(block)),
            forceLoad: false, replace: true);
}
