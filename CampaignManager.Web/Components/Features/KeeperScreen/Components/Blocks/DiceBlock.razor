@using CampaignManager.Web.Components.Features.KeeperScreen.Components
@using CampaignManager.Web.Components.Features.KeeperScreen.Services

@* Ширма → «Кости»: бонусные и штрафные кости (гл. 5, стр. 89–90). Строки ближнего боя берутся
   у боевого движка (CombatModifierReference), своего списка здесь нет. *@

<div class="cm-stack">
    <section>
        <h3 class="cm-section-title mb-2">Как бросать (стр. 89)</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-700">
            <li>За каждую кость — ещё одна кость десятков, кость единиц одна на всех.</li>
            <li><strong>Бонусная</strong> — берут меньший из вариантов, <strong>штрафная</strong> — больший.
                Единицы 4, десятки 2 и 4: с бонусной выпало 24, со штрафной 44.</li>
            <li>Одна бонусная гасит одну штрафную. Обычно кость одна, в особых случаях — две.</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Когда давать (стр. 89–90)</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-700">
            <li><strong>Проверка навыка</strong> — меняйте сложность; кости — только в исключительных случаях.</li>
            <li><strong>Встречная проверка и бой</strong> — сложность не задают, выгоду или помеху выражают костью.</li>
            <li>Обстоятельство, которое сдвинуло бы шансы на пару процентов, кости не стоит: лёгкий дождь —
                не штраф к Вождению, тропический ливень в гонке — штраф.</li>
            <li>К проверкам Рассудка кости не применяют (стр. 152).</li>
            <li>Навык, проверенный с бонусной костью, для фазы развития не отмечают (стр. 92).</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Ближний бой — кости от боевого помощника</h3>
        <ModifierTable Rows="@CombatModifierReference.Melee()"/>
        <p class="cm-field-note mt-2">Кости стрельбы — во вкладке «Стрельба».</p>
    </section>
</div>
