@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Combat.Services

@* Ширма → «Удача» (гл. 5, стр. 88 и 97). Цены в калькуляторе считает LuckRules — та же
   арифметика, что у диалога проверки и у монеты в строке «Удача» на листе. *@

<div class="cm-stack">
    <section>
        <h3 class="cm-section-title mb-2">Проверка Удачи (стр. 88)</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-700">
            <li>Когда исход зависит от внешних сил, а не от умений сыщика. Если подходит навык — лучше навык.</li>
            <li>Общая проверка на группу — бросает тот, у кого Удача ниже всех.</li>
            <li>Беда должна случиться с кем-то одним — достаётся тому, у кого Удача ниже.</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Трата Удачи (необязательное правило, стр. 97)</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-700">
            <li>1 пункт Удачи уменьшает выпавшее число на 1. Тратить можно сколько угодно, но не больше текущей
                Удачи и только на свой бросок.</li>
            <li><strong>Нельзя</strong>: на проверки Удачи и Рассудка, на урон и потерю рассудка, на повторную
                проверку. Критический успех, крах и осечка действуют в любом случае.</li>
            <li>При провале — либо повторная проверка, либо Удача.</li>
            <li>Успех, купленный Удачей, отметки для развития не даёт.</li>
        </ul>

        <div class="flex items-end gap-3 flex-wrap mt-3">
            <div class="w-24">
                <label class="cm-field-label" for="ks-luck-roll">Выпало</label>
                <input id="ks-luck-roll" type="number" min="1" max="100" class="cm-input" data-testid="ks-luck-roll"
                       @bind="_roll" @bind:event="oninput"/>
            </div>
            <div class="w-24">
                <label class="cm-field-label" for="ks-luck-skill">Навык</label>
                <input id="ks-luck-skill" type="number" min="1" max="200" class="cm-input" data-testid="ks-luck-skill"
                       @bind="_skill" @bind:event="oninput"/>
            </div>
        </div>
        <p class="text-sm text-gray-700 mt-2" data-testid="ks-luck-options">
            @LuckSummary()
        </p>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Восстановление (стр. 97)</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-700">
            <li>После каждой игровой встречи: 1d100, и если выпало больше текущей Удачи — +1d10.</li>
            <li>Удача не бывает выше @DevelopmentPhaseRules.MaxLuck; стартовое значение больше нигде не нужно.</li>
            <li>Остаться в сознании за Удачу — необязательное правило боя (стр. 123), оно в боевом помощнике.</li>
        </ul>
    </section>
</div>

@code {
    private int? _roll = 35;
    private int? _skill = 27;

    private string LuckSummary()
    {
        if (_roll is not { } roll || _skill is not { } skill || roll is < 1 or > 100 || skill < 1)
            return "Впишите выпавшее число и значение навыка.";

        var level = CombatService.GetSuccessLevelText(LuckRules.LevelOf(roll, skill));
        if (!LuckRules.CanSpendOn(roll, skill))
            return $"Выпало {roll} против {skill}: {level} — выкупить нельзя.";

        var options = LuckRules.Options(roll, skill, int.MaxValue);
        if (options.Count == 0)
            return $"Выпало {roll} против {skill}: {level} — лучше не купить.";

        var prices = string.Join("; ", options.Select(o =>
            $"{CombatService.GetSuccessLevelText(o.Level)} — {o.Cost} (станет {o.ResultingRoll})"));
        return $"Выпало {roll} против {skill}: {level}. За Удачу: {prices}.";
    }
}
