@using CampaignManager.Web.Components.Features.KeeperScreen.Services
@using CampaignManager.Web.Utilities.Services
@rendermode InteractiveServer
@implements IDisposable
@inject KeeperScreenState Screen
@inject IdentityService IdentityService

@* Кнопка ширмы в шапке любой страницы (PageHeader и шапка режима игры сценария). Свой
   rendermode — потому что шапка бывает и на статичных страницах: там кнопка становится
   отдельным интерактивным островом. Саму панель рисует KeeperScreenHost в лэйауте. *@

@if (_isKeeper)
{
    <button type="button"
            class="cm-btn cm-btn-sm @(Screen.IsOpen ? "cm-btn-primary" : "cm-btn-secondary") shrink-0"
            aria-expanded="@(Screen.IsOpen ? "true" : "false")"
            data-testid="keeper-screen-toggle"
            @onclick="Screen.Toggle">
        <i class="fa-solid fa-book-open mr-1" aria-hidden="true"></i><span>Ширма</span>
    </button>
}

@code {
    private bool _isKeeper;

    protected override async Task OnInitializedAsync()
    {
        Screen.Changed += OnScreenChanged;
        _isKeeper = await IdentityService.IsKeeper();
    }

    private void OnScreenChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Screen.Changed -= OnScreenChanged;
}
