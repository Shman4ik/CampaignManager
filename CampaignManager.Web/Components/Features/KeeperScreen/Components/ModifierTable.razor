@using CampaignManager.Web.Components.Features.KeeperScreen.Services

@* Таблица «что даёт — когда положено» для костей боя. Строки приходят из
   CombatModifierReference, то есть от самого боевого движка. *@

<div class="overflow-x-auto">
    <table class="cm-table">
        <tbody>
        @foreach (var row in Rows)
        {
            <tr>
                <td class="font-semibold w-2/5">@row.Effect</td>
                <td>@row.Condition</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<DiceModifierRow> Rows { get; set; }
}
