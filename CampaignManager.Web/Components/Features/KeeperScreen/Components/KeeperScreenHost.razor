@using CampaignManager.Web.Components.Features.KeeperScreen.Model
@using CampaignManager.Web.Components.Features.KeeperScreen.Services
@rendermode InteractiveServer
@implements IDisposable
@inject KeeperScreenState Screen

@* Ширма Хранителя — панель, выезжающая справа поверх текущего экрана. Живёт в MainLayout, после
   панели плеера: бой, сценарий или лист остаются под ней и не перезагружаются. Открывает её
   KeeperScreenButton из шапки страницы; общий у них только KeeperScreenState.
   Слой — над боковой панелью и шапкой, но под модалками (z-50): диалог страницы важнее справки. *@

@if (Screen.IsOpen)
{
    <div class="ks-backdrop" aria-hidden="true" @onclick="Screen.Close"></div>
    <aside class="ks-drawer" role="dialog" aria-label="Ширма Хранителя" data-testid="keeper-screen">
        <header class="ks-drawer-header">
            <span class="ks-drawer-title"><i class="fa-solid fa-book-open mr-2" aria-hidden="true"></i>Ширма Хранителя</span>
            <a href="@KeeperScreenBlocks.Url(Screen.ActiveBlock)" class="cm-btn cm-btn-secondary cm-btn-sm"
               data-testid="keeper-screen-page" @onclick="Screen.Close">
                <i class="fa-solid fa-up-right-from-square mr-1" aria-hidden="true"></i><span>Страницей</span>
            </a>
            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="keeper-screen-close"
                    @onclick="Screen.Close">
                <i class="fa-solid fa-xmark mr-1" aria-hidden="true"></i><span>Закрыть</span>
            </button>
        </header>
        <div class="ks-drawer-body">
            <KeeperReference ActiveBlock="@Screen.ActiveBlock" ActiveBlockChanged="@Screen.Show"/>
        </div>
    </aside>
}

@code {
    protected override void OnInitialized() => Screen.Changed += OnScreenChanged;

    private void OnScreenChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Screen.Changed -= OnScreenChanged;
}
