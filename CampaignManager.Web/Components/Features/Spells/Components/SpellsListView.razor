@using CampaignManager.Web.Components.Features.Spells.Model
@using CampaignManager.Web.Components.Shared
@namespace CampaignManager.Web.Components.Features.Spells.Components

<div class="cm-card overflow-hidden">
    @* Таблица — от lg (1024) и шире; уже — карточки.
       Колонок здесь пять, а не девять, как у оружия, поэтому портрет iPad их вмещает.
       Стоимость и время сотворения — длинный свободный текст: в строке они обрезаны
       многоточием и разворачиваются на месте, а раскрытие их не повторяет. *@
    <div class="hidden lg:block overflow-x-auto sp-table">
        <table class="cm-table">
            <thead>
            <tr>
                <SortableTableHeader Title="Название" FieldName="@nameof(Spell.Name)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                @if (ShowType)
                {
                    <SortableTableHeader Title="Тип" FieldName="@nameof(Spell.SpellType)"
                                         CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                         OnSortChanged="OnSortChanged" />
                }
                <th>Стоимость</th>
                <th>Время сотворения</th>
                <th><span class="sr-only">Действия</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var spell in Spells)
            {
                <SpellTableRow Spell="@spell"
                               IsExpanded="@(ExpandedSpellId == spell.Id)"
                               ShowType="@ShowType"
                               OnEdit="OnEdit"
                               OnDelete="OnDelete"
                               OnToggleExpand="() => OnToggleExpand.InvokeAsync(spell)" />
            }
            </tbody>
        </table>
    </div>

    @* Карточки ниже lg: название, тип и стоимость в строке, остальное — по раскрытию. *@
    <div class="divide-y divide-primary-100 lg:hidden">
        @foreach (var spell in Spells)
        {
            <div class="px-3 py-2">
                <div class="flex items-start gap-2">
                    <div class="min-w-0 flex-1 cursor-pointer" @onclick="() => OnToggleExpand.InvokeAsync(spell)">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <i class="fas @(ExpandedSpellId == spell.Id ? "fa-caret-down" : "fa-caret-right") w-2 text-center text-primary-300"></i>
                            <span class="font-semibold text-gray-900">@spell.Name</span>
                        </div>
                        <div class="ml-4 mt-0.5 text-xs text-primary-500 @(ExpandedSpellId == spell.Id ? null : "truncate")">
                            @if (ShowType)
                            {
                                <span>@Dash(spell.SpellType)</span>
                                <span class="mx-1 text-primary-300">·</span>
                            }
                            <span>@Dash(spell.Cost)</span>
                            <span class="mx-1 text-primary-300">·</span>
                            <span>@Dash(spell.CastingTime)</span>
                        </div>
                    </div>
                    <button type="button" aria-label="Изменить: @spell.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary flex-shrink-0"
                            @onclick="() => OnEdit.InvokeAsync(spell)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" aria-label="Удалить: @spell.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error flex-shrink-0"
                            @onclick="() => OnDelete.InvokeAsync(spell)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>

                @if (ExpandedSpellId == spell.Id)
                {
                    <dl class="sp-card-details">
                        @if (!ShowType)
                        {
                            <dt>Тип</dt>
                            <dd>@Dash(spell.SpellType)</dd>
                        }
                        @if (spell.AlternativeNames.Count > 0)
                        {
                            <dt>Другие названия</dt>
                            <dd>
                                <span class="flex flex-wrap gap-1">
                                    @foreach (var altName in spell.AlternativeNames)
                                    {
                                        <Badge Variant="secondary" Size="sm" Rounded="md">@altName</Badge>
                                    }
                                </span>
                            </dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(spell.Description))
                        {
                            <dt>Описание</dt>
                            <dd class="whitespace-pre-wrap">@spell.Description</dd>
                        }
                    </dl>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Spell> Spells { get; set; } = [];
    [Parameter] public Guid? ExpandedSpellId { get; set; }

    /// <summary>Колонка типа: смысл есть, только когда список не сужен фильтром до одного типа.</summary>
    [Parameter] public bool ShowType { get; set; } = true;

    [Parameter] public string? CurrentSortField { get; set; }
    [Parameter] public bool SortAscending { get; set; } = true;
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    [Parameter] public EventCallback<Spell> OnEdit { get; set; }
    [Parameter] public EventCallback<Spell> OnDelete { get; set; }
    [Parameter] public EventCallback<Spell> OnToggleExpand { get; set; }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
