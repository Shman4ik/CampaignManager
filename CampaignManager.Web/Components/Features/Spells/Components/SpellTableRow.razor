@using CampaignManager.Web.Components.Features.Spells.Model
@using CampaignManager.Web.Components.Shared
@namespace CampaignManager.Web.Components.Features.Spells.Components

<tr class="@(IsExpanded ? "sp-row-open" : null) cursor-pointer" @onclick="ToggleExpand">
    <td>
        <div class="flex items-center gap-1.5">
            <i class="fas @(IsExpanded ? "fa-caret-down" : "fa-caret-right") w-2 text-center text-primary-300"></i>
            <span class="font-semibold text-gray-900">@Spell.Name</span>
        </div>
    </td>
    @if (ShowType)
    {
        <td class="sp-clip sp-col-type text-primary-500">@Dash(Spell.SpellType)</td>
    }
    <td class="sp-clip sp-col-cost">@Dash(Spell.Cost)</td>
    <td class="sp-clip sp-col-time">@Dash(Spell.CastingTime)</td>
    <td @onclick:stopPropagation="true">
        <div class="flex justify-end gap-1">
            <button type="button" aria-label="Изменить: @Spell.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary"
                    @onclick="() => OnEdit.InvokeAsync(Spell)">
                <i class="fas fa-pen"></i>
            </button>
            <button type="button" aria-label="Удалить: @Spell.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error"
                    @onclick="() => OnDelete.InvokeAsync(Spell)">
                <i class="fas fa-trash-alt"></i>
            </button>
        </div>
    </td>
</tr>

@if (IsExpanded)
{
    @* Стоимость и время не повторяются: открытая строка просто перестаёт их обрезать.
       Здесь — только то, чего в колонках нет вообще. *@
    <tr class="sp-details">
        <td colspan="@ColumnCount">
            <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-primary-600">
                @if (!ShowType)
                {
                    <div>
                        <span class="sp-label">Тип</span>
                        @Dash(Spell.SpellType)
                    </div>
                }
                @if (Spell.AlternativeNames.Count > 0)
                {
                    <div class="basis-full">
                        <span class="sp-label">Другие названия</span>
                        <span class="flex flex-wrap gap-1">
                            @foreach (var altName in Spell.AlternativeNames)
                            {
                                <Badge Variant="secondary" Size="sm" Rounded="md">@altName</Badge>
                            }
                        </span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Spell.Description))
                {
                    <div class="basis-full">
                        <span class="sp-label">Описание</span>
                        <span class="whitespace-pre-wrap">@Spell.Description</span>
                    </div>
                }
                @if (!HasDetails)
                {
                    <div class="text-primary-400">Всё об этом заклинании уже показано в строке.</div>
                }
            </div>
        </td>
    </tr>
}

@code {
    [Parameter] public Spell Spell { get; set; } = new() { Name = string.Empty, SpellType = string.Empty };
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>Колонка типа: смысл есть, только когда список не сужен фильтром до одного типа.</summary>
    [Parameter] public bool ShowType { get; set; } = true;

    [Parameter] public EventCallback<Spell> OnEdit { get; set; }
    [Parameter] public EventCallback<Spell> OnDelete { get; set; }
    [Parameter] public EventCallback OnToggleExpand { get; set; }

    // Название, стоимость, время, действия — всегда; тип — по флагу.
    private int ColumnCount => ShowType ? 5 : 4;

    private bool HasDetails =>
        !ShowType ||
        Spell.AlternativeNames.Count > 0 ||
        !string.IsNullOrWhiteSpace(Spell.Description);

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private Task ToggleExpand() => OnToggleExpand.InvokeAsync();
}
