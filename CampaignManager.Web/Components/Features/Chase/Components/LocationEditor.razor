@using CampaignManager.Web.Components.Features.Chase.Model

<div class="bg-gray-50 border border-gray-200 rounded-md p-3 mb-2">
    <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-700">Локация @Location.Number</span>
        <div class="flex gap-2">
            <label class="flex items-center gap-1 text-xs text-gray-600 cursor-pointer">
                <input type="checkbox" checked="@Location.HasBarrier" @onchange="e => ToggleBarrier((bool)(e.Value ?? false))"
                       class="rounded border-primary-300 accent-accent-500" />
                <i class="fa-solid fa-road-barrier mr-1"></i>Преграда
            </label>
            <label class="flex items-center gap-1 text-xs text-gray-600 cursor-pointer">
                <input type="checkbox" checked="@Location.HasHazard" @onchange="e => ToggleHazard((bool)(e.Value ?? false))"
                       class="rounded border-gray-300 text-warning-600 focus:ring-warning-500" />
                <i class="fa-solid fa-bolt mr-1"></i>Помеха
            </label>
        </div>
    </div>

    <!-- Описание локации -->
    <div class="mb-2">
        <input type="text" value="@Location.Description" @onchange="e => UpdateDescription(e.Value?.ToString())"
               placeholder="Описание локации (например: узкий переулок)"
               class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
    </div>

    @if (Location.HasBarrier)
    {
        <div class="bg-accent-50 border border-accent-100 rounded p-2 mb-2">
            <div class="text-xs font-medium text-accent-700 mb-1">Преграда</div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="text-xs text-gray-600">Название</label>
                    <input type="text" value="@Location.BarrierName" @onchange="e => UpdateBarrierName(e.Value?.ToString())"
                           placeholder="Запертая дверь"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Навык</label>
                    <input type="text" value="@Location.BarrierSkillName" @onchange="e => UpdateBarrierSkill(e.Value?.ToString())"
                           placeholder="Взлом"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Значение навыка</label>
                    <input type="number" value="@Location.BarrierSkillValue"
                           @onchange="e => UpdateBarrierSkillValue(e.Value?.ToString())"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Сложность</label>
                    <select value="@Location.BarrierDifficulty"
                            @onchange="e => UpdateBarrierDifficulty(e.Value?.ToString())"
                            class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                        <option value="1">Обычная</option>
                        <option value="2">Сложная</option>
                        <option value="3">Экстремальная</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs text-gray-600">Прочность (ПЗ)</label>
                    <input type="number" min="0" value="@Location.BarrierHitPoints"
                           @onchange="e => UpdateBarrierHitPoints(e.Value?.ToString())"
                           placeholder="0 = нельзя разрушить"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div class="col-span-2">
                    <label class="text-xs text-gray-600">Типовые преграды (стр. 136)</label>
                    <select value="" @onchange="e => ApplyBarrierPreset(e.Value?.ToString())"
                            class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                        <option value="">— выбрать из книги —</option>
                        @foreach (var preset in ChaseReference.BarrierPresets)
                        {
                            <option value="@preset.Name">@preset.Name — @preset.HitPoints ПЗ</option>
                        }
                    </select>
                </div>
                <div class="col-span-2">
                    <label class="text-xs text-gray-600">Примеры преград</label>
                    <select value="" @onchange="e => UseBarrierExample(e.Value?.ToString())"
                            class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                        <option value="">— подставить название —</option>
                        <optgroup label="Пешком">
                            @foreach (var example in ChaseReference.BarrierExamplesOnFoot)
                            {
                                <option value="@example">@example</option>
                            }
                        </optgroup>
                        <optgroup label="Автопогоня">
                            @foreach (var example in ChaseReference.BarrierExamplesDriving)
                            {
                                <option value="@example">@example</option>
                            }
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
    }

    @if (Location.HasHazard)
    {
        <div class="bg-warning-50 border border-warning-100 rounded p-2">
            <div class="text-xs font-medium text-warning-700 mb-1">Помеха</div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="text-xs text-gray-600">Название</label>
                    <input type="text" value="@Location.HazardName" @onchange="e => UpdateHazardName(e.Value?.ToString())"
                           placeholder="Лёд на дороге"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Навык</label>
                    <input type="text" value="@Location.HazardSkillName" @onchange="e => UpdateHazardSkill(e.Value?.ToString())"
                           placeholder="ЛВК"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Значение навыка</label>
                    <input type="number" value="@Location.HazardSkillValue"
                           @onchange="e => UpdateHazardSkillValue(e.Value?.ToString())"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                </div>
                <div>
                    <label class="text-xs text-gray-600">Сложность</label>
                    <select value="@Location.HazardDifficulty"
                            @onchange="e => UpdateHazardDifficulty(e.Value?.ToString())"
                            class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                        <option value="1">Обычная</option>
                        <option value="2">Сложная</option>
                        <option value="3">Экстремальная</option>
                    </select>
                </div>
                <div class="col-span-2">
                    <label class="text-xs text-gray-600">Формула урона при провале</label>
                    <input type="text" value="@Location.HazardDamageFormula" @onchange="e => UpdateHazardDamageFormula(e.Value?.ToString())"
                           placeholder="1D6"
                           class="w-full text-xs border border-gray-200 rounded px-2 py-1" />
                    <div class="flex flex-wrap gap-1 mt-1">
                        @foreach (var tier in ChaseReference.DamageTiers)
                        {
                            <button type="button" @onclick="() => UseDamageTier(tier)" title="@tier.Examples"
                                    class="px-1.5 py-0.5 text-xs rounded bg-gray-100 text-gray-600 hover:bg-gray-200">
                                @tier.Name @tier.Formula
                            </button>
                        }
                    </div>
                </div>
                <div class="col-span-2">
                    <label class="text-xs text-gray-600">Примеры помех (стр. 133)</label>
                    <select value="" @onchange="e => UseHazardExample(e.Value?.ToString())"
                            class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                        <option value="">— подставить название —</option>
                        <optgroup label="Пешком">
                            @foreach (var example in ChaseReference.HazardExamplesOnFoot)
                            {
                                <option value="@example">@example</option>
                            }
                        </optgroup>
                        <optgroup label="Автопогоня">
                            @foreach (var example in ChaseReference.HazardExamplesDriving)
                            {
                                <option value="@example">@example</option>
                            }
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required ChaseLocation Location { get; set; }
    [Parameter] public EventCallback<ChaseLocation> OnLocationUpdated { get; set; }

    private async Task NotifyUpdate() => await OnLocationUpdated.InvokeAsync(Location);

    private async Task ToggleBarrier(bool value) { Location.HasBarrier = value; await NotifyUpdate(); }
    private async Task ToggleHazard(bool value) { Location.HasHazard = value; await NotifyUpdate(); }
    private async Task UpdateDescription(string? v) { Location.Description = v; await NotifyUpdate(); }

    private async Task UpdateBarrierName(string? v) { Location.BarrierName = v; await NotifyUpdate(); }
    private async Task UpdateBarrierSkill(string? v) { Location.BarrierSkillName = v; await NotifyUpdate(); }
    private async Task UpdateBarrierSkillValue(string? v) { if (int.TryParse(v, out var val)) { Location.BarrierSkillValue = val; await NotifyUpdate(); } }
    private async Task UpdateBarrierDifficulty(string? v) { if (int.TryParse(v, out var val)) { Location.BarrierDifficulty = val; await NotifyUpdate(); } }
    private async Task UpdateBarrierHitPoints(string? v)
    {
        if (int.TryParse(v, out var val))
        {
            Location.BarrierHitPoints = val;
            Location.BarrierCurrentHitPoints = val;
            await NotifyUpdate();
        }
    }

    private async Task UpdateHazardName(string? v) { Location.HazardName = v; await NotifyUpdate(); }
    private async Task UpdateHazardSkill(string? v) { Location.HazardSkillName = v; await NotifyUpdate(); }
    private async Task UpdateHazardSkillValue(string? v) { if (int.TryParse(v, out var val)) { Location.HazardSkillValue = val; await NotifyUpdate(); } }
    private async Task UpdateHazardDifficulty(string? v) { if (int.TryParse(v, out var val)) { Location.HazardDifficulty = val; await NotifyUpdate(); } }
    private async Task UpdateHazardDamageFormula(string? v) { Location.HazardDamageFormula = v; await NotifyUpdate(); }

    private async Task ApplyBarrierPreset(string? presetName)
    {
        var preset = ChaseReference.BarrierPresets.FirstOrDefault(p => p.Name == presetName);
        if (preset is null) return;

        Location.BarrierName = preset.Name;
        Location.BarrierHitPoints = preset.HitPoints;
        Location.BarrierCurrentHitPoints = preset.HitPoints;
        await NotifyUpdate();
    }

    private async Task UseBarrierExample(string? example)
    {
        if (string.IsNullOrWhiteSpace(example)) return;
        Location.BarrierName = example;
        await NotifyUpdate();
    }

    private async Task UseHazardExample(string? example)
    {
        if (string.IsNullOrWhiteSpace(example)) return;
        Location.HazardName = example;
        await NotifyUpdate();
    }

    private async Task UseDamageTier(DamageTier tier)
    {
        Location.HazardDamageFormula = tier.Formula;
        await NotifyUpdate();
    }
}
