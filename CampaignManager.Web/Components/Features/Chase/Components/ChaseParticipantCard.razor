@using CampaignManager.Web.Components.Features.Chase.Model
@using CampaignManager.Web.Components.Features.Chase.Services

@inject ChaseService ChaseService

<div class="bg-white rounded-md shadow-sm border border-gray-200 p-3 mb-2 border-l-4
            @(IsActive ? "border-l-accent-500" : "border-l-transparent")
            @(!Participant.IsActive ? "opacity-50" : "")">
    <!-- Заголовок -->
    <div class="flex justify-between items-start mb-2">
        <div>
            <div class="flex items-center gap-2">
                <h4 class="font-semibold text-gray-900 text-sm">@Participant.Name</h4>
                @if (Participant.Role == ChaseRole.Prey)
                {
                    <span class="bg-success-100 text-success-700 text-xs px-1.5 py-0.5 rounded font-medium">Жертва</span>
                }
                else
                {
                    <span class="bg-error-100 text-error-700 text-xs px-1.5 py-0.5 rounded font-medium">Преследователь</span>
                }
                @if (Participant.IsPlayer)
                {
                    <span class="bg-accent-100 text-accent-700 text-xs px-1.5 py-0.5 rounded font-medium">Игрок</span>
                }
                @if (Participant.IsPassenger)
                {
                    <span class="bg-secondary-100 text-secondary-700 text-xs px-1.5 py-0.5 rounded font-medium">Пассажир</span>
                }
                @if (!string.IsNullOrWhiteSpace(Participant.RouteLabel))
                {
                    <span class="bg-gray-100 text-gray-700 text-xs px-1.5 py-0.5 rounded font-medium">@Participant.RouteLabel</span>
                }
            </div>
            <div class="text-xs text-gray-500 mt-0.5">
                @if (Participant.IsInVehicle)
                {
                    <span>@Participant.VehicleName (СКО: @Participant.VehicleSpeed)</span>
                }
                else
                {
                    <span>@ModeLabel (СКО: @Participant.BaseMov)</span>
                }
                @if (Participant.SpeedCheckCompleted)
                {
                    var modText = Participant.MovModifier switch { 1 => "+1", -1 => "−1", _ => "0" };
                    <span class="@(Participant.MovModifier > 0 ? "text-success-600" : Participant.MovModifier < 0 ? "text-error-600" : "text-gray-500")">
                        (мод: @modText → @Participant.AdjustedMov)
                    </span>
                }
                &middot; ЛВК: @Participant.Dexterity &middot; Поз: @Participant.CurrentLocation
            </div>
        </div>
        <button @onclick="OnRemove" class="text-gray-400 hover:text-error-500 transition-colors p-0.5" title="Удалить">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- Бейджи состояний -->
    @if (HasAnyState())
    {
        <div class="flex flex-wrap gap-1 mb-2">
            @if (Participant.IsCaught)
            {
                <span class="bg-error-700 text-white text-xs px-1.5 py-0.5 rounded font-medium">Пойман</span>
            }
            @if (Participant.HasEscaped)
            {
                <span class="bg-success-700 text-white text-xs px-1.5 py-0.5 rounded font-medium">Сбежал</span>
            }
            @if (Participant.IsEliminated)
            {
                <span class="bg-gray-800 text-white text-xs px-1.5 py-0.5 rounded font-medium">Выбыл</span>
            }
            @if (Participant.IsOutOfChase)
            {
                <span class="bg-gray-500 text-white text-xs px-1.5 py-0.5 rounded font-medium"
                      title="Преследователь медленнее самого медленного убегающего — в погоне не учитывается (стр. 140)">
                    Не в погоне
                </span>
            }
        </div>
    }

    <!-- Транспорт: Комплекция как прочность (стр. 136) -->
    @if (Participant.IsInVehicle && Participant.VehicleBuild > 0)
    {
        <div class="mb-2">
            <div class="flex items-center justify-between text-xs mb-0.5">
                <span class="text-gray-600 font-medium">
                    Комплекция транспорта
                    @if (Participant.VehicleArmor > 0)
                    {
                        <span class="text-gray-400">· броня @Participant.VehicleArmor</span>
                    }
                </span>
                <span class="text-gray-900 font-semibold">
                    @Participant.VehicleCurrentBuild.ToString("0.#") / @Participant.VehicleBuild.ToString("0.#")
                    @if (Participant.VehicleDamageCarry > 0)
                    {
                        <span class="text-gray-400 font-normal">(+@Participant.VehicleDamageCarry)</span>
                    }
                </span>
            </div>
            <div class="bg-gray-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full transition-all @GetBuildBarColor()" style="width: @GetBuildPercent()%"></div>
            </div>
            @if (Participant.IsVehicleWrecked)
            {
                <p class="text-xs text-error-600 mt-0.5">Транспорт разбит — Комплекция на нуле.</p>
            }
        </div>
    }

    <!-- HP -->
    <div class="mb-2">
        <div class="flex items-center justify-between text-xs mb-0.5">
            <span class="text-gray-600 font-medium">ОЗ</span>
            <div class="flex items-center gap-1">
                <button @onclick="() => AdjustHp(-1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-error-100 text-gray-600 hover:text-error-600 text-xs flex items-center justify-center">−</button>
                <span class="text-gray-900 font-semibold w-12 text-center">@Participant.CurrentHitPoints / @Participant.MaxHitPoints</span>
                <button @onclick="() => AdjustHp(1)" class="w-5 h-5 rounded bg-gray-100 hover:bg-success-100 text-gray-600 hover:text-success-600 text-xs flex items-center justify-center">+</button>
            </div>
        </div>
        <div class="bg-gray-200 rounded-full h-1.5">
            <div class="h-1.5 rounded-full transition-all @GetHpBarColor()" style="width: @GetHpPercent()%"></div>
        </div>
    </div>

    <!-- Действия перемещения -->
    @if (IsChaseActive)
    {
        <div class="flex items-center gap-2 text-xs text-gray-600">
            <span class="font-medium">Действия:</span>
            <div class="flex gap-0.5">
                @for (var i = 0; i < Participant.TotalMovementActions; i++)
                {
                    <div class="w-3 h-3 rounded-sm @(i < Participant.MovementActionsRemaining ? "bg-accent-500" : "bg-gray-200")"></div>
                }
            </div>
            <span>@Participant.MovementActionsRemaining / @Participant.TotalMovementActions</span>
            @if (Participant.MovementActionDebt > 0)
            {
                <span class="text-error-500">(долг: @Participant.MovementActionDebt)</span>
            }
        </div>
    }

    <!-- Настройка (до начала погони) -->
    @if (IsSetupMode)
    {
        <div class="mt-2 pt-2 border-t border-gray-100 space-y-2">
            <div class="flex items-center gap-2">
                <label class="text-xs text-gray-600">Роль:</label>
                <select class="text-xs border border-gray-200 rounded pl-1.5 pr-6 py-1" value="@Participant.Role"
                        @onchange="HandleRoleChange">
                    <option value="@ChaseRole.Prey">Жертва</option>
                    <option value="@ChaseRole.Pursuer">Преследователь</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-xs text-gray-600">Позиция:</label>
                <input type="number" min="1" class="text-xs border border-gray-200 rounded px-1.5 py-1 w-16"
                       value="@Participant.CurrentLocation"
                       @onchange="HandleLocationChange" />
            </div>

            <!-- Транспорт из таблицы V (стр. 143) -->
            <div class="flex items-center gap-2">
                <label class="text-xs text-gray-600 shrink-0">Транспорт:</label>
                <select class="text-xs border border-gray-200 rounded pl-1.5 pr-6 py-1 flex-1 min-w-0"
                        value="@(Participant.IsInVehicle ? Participant.VehicleName : "")"
                        @onchange="HandleVehicleChange">
                    <option value="">Пешком</option>
                    @foreach (var category in ChaseReference.VehicleCategories)
                    {
                        <optgroup label="@category">
                            @foreach (var vehicle in ChaseReference.Vehicles.Where(v => v.Category == category))
                            {
                                <option value="@vehicle.Name">
                                    @vehicle.Name — СКО @vehicle.Speed, Компл. @vehicle.Build.ToString("0.#")
                                </option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            @if (!Participant.IsInVehicle)
            {
                <!-- Способ передвижения (стр. 141) -->
                <div class="flex items-center gap-2">
                    <label class="text-xs text-gray-600 shrink-0">Способ:</label>
                    <select class="text-xs border border-gray-200 rounded pl-1.5 pr-6 py-1" value="@Participant.Mode"
                            @onchange="HandleModeChange">
                        <option value="@MovementMode.OnFoot">Пешком</option>
                        <option value="@MovementMode.Swimming">Вплавь</option>
                        <option value="@MovementMode.Flying">По воздуху</option>
                    </select>
                    @if (Participant.Mode != MovementMode.OnFoot)
                    {
                        <input type="number" min="0" placeholder="своя СКО"
                               class="text-xs border border-gray-200 rounded px-1.5 py-1 w-20"
                               value="@Participant.NativeModeSpeed"
                               @onchange="HandleNativeSpeedChange"
                               title="0 — своей СКО для способа нет, берётся половина обычной" />
                    }
                </div>
            }

            <div class="flex items-center gap-2 flex-wrap">
                <label class="flex items-center gap-1 text-xs text-gray-600 cursor-pointer">
                    <input type="checkbox" class="rounded border-gray-300" checked="@Participant.IsPassenger"
                           @onchange="HandlePassengerChange" />
                    Пассажир
                </label>
                <label class="text-xs text-gray-600">Маршрут:</label>
                <input type="text" placeholder="общий"
                       class="text-xs border border-gray-200 rounded px-1.5 py-1 w-20"
                       value="@Participant.RouteLabel"
                       @onchange="HandleRouteChange"
                       title="Разные метки — разные, независимо отслеживаемые погони (стр. 142)" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required ChaseParticipant Participant { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool IsSetupMode { get; set; }
    [Parameter] public bool IsChaseActive { get; set; }
    [Parameter] public EventCallback<ChaseParticipant> OnRemoveCallback { get; set; }
    [Parameter] public EventCallback<(Guid, ChaseRole)> OnRoleChanged { get; set; }
    [Parameter] public EventCallback<(Guid, int)> OnLocationChanged { get; set; }

    private async Task OnRemove() => await OnRemoveCallback.InvokeAsync(Participant);

    private void AdjustHp(int delta) =>
        Participant.CurrentHitPoints = Math.Clamp(Participant.CurrentHitPoints + delta, 0, Participant.MaxHitPoints);

    private bool HasAnyState() =>
        Participant.IsCaught || Participant.HasEscaped || Participant.IsEliminated || Participant.IsOutOfChase;

    private double GetHpPercent() => Participant.MaxHitPoints > 0
        ? Math.Max(0, (double)Participant.CurrentHitPoints / Participant.MaxHitPoints * 100) : 0;

    private string GetHpBarColor()
    {
        var pct = GetHpPercent();
        if (pct > 50) return "bg-success-500";
        if (pct > 25) return "bg-warning-500";
        return "bg-error-500";
    }

    private async Task HandleRoleChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<ChaseRole>(e.Value?.ToString(), out var role))
            await OnRoleChanged.InvokeAsync((Participant.Id, role));
    }

    private async Task HandleLocationChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var loc))
            await OnLocationChanged.InvokeAsync((Participant.Id, loc));
    }

    private string ModeLabel => Participant.Mode switch
    {
        MovementMode.Swimming => "Вплавь",
        MovementMode.Flying => "По воздуху",
        _ => "Пешком"
    };

    private double GetBuildPercent() => Participant.VehicleBuild > 0
        ? Math.Max(0, Participant.VehicleCurrentBuild / Participant.VehicleBuild * 100) : 0;

    private string GetBuildBarColor()
    {
        var pct = GetBuildPercent();
        if (pct > 50) return "bg-accent-500";
        if (pct > 25) return "bg-warning-500";
        return "bg-error-500";
    }

    private void HandleVehicleChange(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(name))
        {
            ChaseService.RemoveVehicle(Participant.Id);
            return;
        }

        var template = ChaseReference.FindVehicle(name);
        if (template is not null)
            ChaseService.SetVehicleFromTemplate(Participant.Id, template);
    }

    private void HandleModeChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<MovementMode>(e.Value?.ToString(), out var mode))
            ChaseService.ChangeMovementMode(Participant.Id, mode, Participant.NativeModeSpeed);
    }

    private void HandleNativeSpeedChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var speed))
            ChaseService.ChangeMovementMode(Participant.Id, Participant.Mode, Math.Max(0, speed));
    }

    private void HandlePassengerChange(ChangeEventArgs e)
    {
        var isPassenger = e.Value is bool b && b;
        var carrier = ChaseService.Participants
            .FirstOrDefault(p => p.IsInVehicle && p.Id != Participant.Id);
        ChaseService.SetPassenger(Participant.Id, isPassenger, carrier?.Id);
    }

    private void HandleRouteChange(ChangeEventArgs e) =>
        ChaseService.SetRoute(Participant.Id, e.Value?.ToString());
}
