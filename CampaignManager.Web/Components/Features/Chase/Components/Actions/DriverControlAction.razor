@inject ChaseService ChaseService

@* Удержать управление после серьёзной раны водителя (стр. 139). *@

<div class="bg-error-50 border border-error-200 rounded-md p-3 space-y-3">
    <div class="text-sm font-medium text-error-800">Серьёзная рана у водителя</div>
    <p class="text-xs text-error-700">
        Водитель, получивший серьёзную рану и оставшийся в сознании, немедленно проходит
        проверку как при трудной помехе. Потерявший сознание теряет управление автоматически.
    </p>
    <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
        <input type="checkbox" @bind="Form.DriverUnconscious" class="rounded border-gray-300" />
        Водитель без сознания — управление потеряно автоматически
    </label>
    <div class="grid grid-cols-2 gap-3">
        @if (!Form.DriverUnconscious)
        {
            <SkillCheckFields SkillPlaceholder="Вождение автомобиля"
                              @bind-SkillName="Form.SkillName" @bind-SkillValue="Form.SkillValue" @bind-Roll="Form.Roll"/>
        }
        <div>
            <label class="text-xs text-gray-600">Авария при провале (таблица VI)</label>
            <select @bind="Form.CrashTier" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                @foreach (var tier in ChaseReference.CrashTiers)
                {
                    <option value="@tier.Name">@tier.Name — @tier.BuildLossFormula Комплекции</option>
                }
            </select>
        </div>
        <div>
            <label class="text-xs text-gray-600">Потеря Комплекции</label>
            <input type="number" min="0" @bind="Form.BuildLossRoll" placeholder="авто"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div>
            <label class="text-xs text-gray-600">Потерянных действий 1d3</label>
            <input type="number" min="0" max="3" @bind="Form.LostActionsRoll" placeholder="авто"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div>
            <label class="text-xs text-gray-600">Урон водителю</label>
            <input type="number" min="0" @bind="Form.DamageRoll" placeholder="0"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
    </div>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-error cm-btn-sm" @onclick="Execute">
            <span>Проверить</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter, EditorRequired] public required ChaseActionForm Form { get; set; }
    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        var skill = string.IsNullOrWhiteSpace(Form.SkillName) ? "Вождение автомобиля" : Form.SkillName;
        var result = ChaseService.ResolveDriverControlCheck(
            Participant.Id, skill, Form.SkillValue,
            ChaseActionForm.Entered(Form.Roll),
            Form.DriverUnconscious, Form.CrashTier,
            ChaseActionForm.Entered(Form.BuildLossRoll),
            ChaseActionForm.Entered(Form.DamageRoll),
            ChaseActionForm.Entered(Form.LostActionsRoll));

        Form.DriverUnconscious = false;
        await OnResolved.InvokeAsync(result);
    }
}
