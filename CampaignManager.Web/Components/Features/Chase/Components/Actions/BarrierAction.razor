@inject ChaseService ChaseService

@* Преодолеть преграду перед следующей локацией (стр. 134): провал оставляет на месте. *@

<div class="bg-accent-50 border border-accent-200 rounded-md p-3 space-y-3">
    <div class="text-sm font-medium text-accent-800">
        Преграда: @(NextLocation.BarrierName ?? "Преграда")
        — @ChaseService.GetDifficultyText(NextLocation.BarrierDifficulty)
    </div>
    <div class="grid grid-cols-2 gap-3">
        <SkillCheckFields SkillPlaceholder="@NextLocation.BarrierSkillName"
                          @bind-SkillName="Form.SkillName" @bind-SkillValue="Form.SkillValue" @bind-Roll="Form.Roll"/>
    </div>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="Execute">
            <span>Выполнить</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter, EditorRequired] public required ChaseLocation NextLocation { get; set; }
    [Parameter, EditorRequired] public required ChaseActionForm Form { get; set; }
    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        var skill = string.IsNullOrWhiteSpace(Form.SkillName) ? "Навык" : Form.SkillName;
        var result = ChaseService.ResolveBarrier(
            Participant.Id, Participant.CurrentLocation + 1, skill, Form.SkillValue,
            ChaseActionForm.Entered(Form.Roll));
        await OnResolved.InvokeAsync(result);
    }
}
