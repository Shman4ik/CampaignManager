@inject ChaseService ChaseService

@* Спрятаться (стр. 139): только жертва; на транспорте — совместная проверка Скрытности и Вождения. *@

<div class="bg-secondary-50 border border-secondary-200 rounded-md p-3 space-y-3">
    <div class="text-sm font-medium text-secondary-800">Спрятаться — 1 действие перемещения</div>
    <p class="text-xs text-secondary-700">
        Пешком — Скрытность. На транспорте нужна совместная проверка Скрытности и Вождения:
        результат должен быть ниже обоих навыков. Хороший отрыв и обилие укрытий — повод
        дать бонусные кости.
    </p>
    <div class="grid grid-cols-2 gap-3">
        <div>
            <label class="text-xs text-gray-600">Скрытность</label>
            <input type="number" @bind="Form.SkillValue"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        @if (Participant.IsInVehicle)
        {
            <div>
                <label class="text-xs text-gray-600">Вождение</label>
                <input type="number" @bind="Form.SecondSkillValue"
                       class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
            </div>
        }
        <div>
            <label class="text-xs text-gray-600">Сложность</label>
            <select @bind="Form.Difficulty" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                <option value="1">Обычная</option>
                <option value="2">Сложная</option>
                <option value="3">Экстремальная</option>
            </select>
        </div>
        <div>
            <label class="text-xs text-gray-600">Бонусных костей</label>
            <select @bind="Form.BonusDice" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
            </select>
        </div>
        <div>
            <label class="text-xs text-gray-600">Бросок d100</label>
            <input type="number" min="1" max="100" @bind="Form.Roll" placeholder="01–100"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
    </div>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="Execute">
            <span>Спрятаться</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter, EditorRequired] public required ChaseActionForm Form { get; set; }
    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        var driving = Participant.IsInVehicle && Form.SecondSkillValue > 0 ? Form.SecondSkillValue : (int?)null;
        var result = ChaseService.ResolveHide(
            Participant.Id, Form.SkillValue, driving, Form.Difficulty, Form.BonusDice,
            ChaseActionForm.Entered(Form.Roll));
        await OnResolved.InvokeAsync(result);
    }
}
