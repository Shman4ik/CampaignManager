@inject ChaseService ChaseService

@* Боевой манёвр в погоне (стр. 136): успех отнимает у цели 1d3 действий перемещения. *@

<div class="bg-secondary-50 border border-secondary-200 rounded-md p-3 space-y-3">
    <div class="text-sm font-medium text-secondary-800">Боевой манёвр — стоит 1 действие</div>
    <p class="text-xs text-secondary-700">
        Успех: цель теряет 1d3 действий перемещения + возможный урон.
    </p>
    <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2">
            <label class="text-xs text-gray-600">Цель</label>
            <select @bind="Form.TargetId" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                <option value="">— выберите цель —</option>
                @foreach (var t in Targets)
                {
                    <option value="@t.Id">@t.Name (@ChaseService.GetRoleText(t.Role))</option>
                }
            </select>
        </div>
        <SkillCheckFields SkillPlaceholder="Ближний бой"
                          @bind-SkillName="Form.SkillName" @bind-SkillValue="Form.SkillValue" @bind-Roll="Form.Roll"/>
        <div>
            <label class="text-xs text-gray-600">Потерянных действий 1d3 (если успех)</label>
            <input type="number" min="1" max="3" @bind="Form.LostActionsRoll" placeholder="1–3"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div>
            <label class="text-xs text-gray-600">Урон (опционально)</label>
            <input type="number" min="0" @bind="Form.DamageRoll" placeholder="0"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
    </div>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="Execute"
                disabled="@string.IsNullOrEmpty(Form.TargetId)">
            <span>Выполнить манёвр</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter, EditorRequired] public required ChaseActionForm Form { get; set; }

    /// <summary>Участники в той же локации.</summary>
    [Parameter, EditorRequired] public required List<ChaseParticipant> Targets { get; set; }

    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        if (!Guid.TryParse(Form.TargetId, out var targetId)) return;
        var skill = string.IsNullOrWhiteSpace(Form.SkillName) ? "Ближний бой" : Form.SkillName;
        var result = ChaseService.ResolveCombatManeuver(
            Participant.Id, targetId,
            skill, Form.SkillValue,
            ChaseActionForm.Entered(Form.Roll),
            ChaseActionForm.Entered(Form.LostActionsRoll),
            ChaseActionForm.Entered(Form.DamageRoll));
        await OnResolved.InvokeAsync(result);
    }
}
