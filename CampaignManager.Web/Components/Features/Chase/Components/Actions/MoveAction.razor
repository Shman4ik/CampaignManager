@inject ChaseService ChaseService

@* Двигаться вперёд. Панели действий рисуются внутри ChaseActionPanel — своей карточки не заводят,
   только тонированный блок, как было до разбиения панели. *@

<div class="bg-accent-50 border border-accent-200 rounded-md p-3">
    <p class="text-sm text-gray-700 mb-3">
        Перемещение с локации @Participant.CurrentLocation на @(Participant.CurrentLocation + 1).
        Стоит 1 действие перемещения.
    </p>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="Execute">
            <span>Выполнить</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        var result = ChaseService.MoveForward(Participant.Id);
        await OnResolved.InvokeAsync(result);
    }
}
