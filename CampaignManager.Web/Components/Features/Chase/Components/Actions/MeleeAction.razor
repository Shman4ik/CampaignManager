@inject ChaseService ChaseService

@* Ближний бой в погоне (стр. 136): цель в той же локации, ответ цели — по желанию Хранителя. *@

<div class="bg-error-50 border border-error-200 rounded-md p-3 space-y-3">
    <div class="text-sm font-medium text-error-800">Ближний бой — стоит 1 действие</div>
    <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2">
            <label class="text-xs text-gray-600">Цель</label>
            <select @bind="Form.TargetId" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                <option value="">— выберите цель —</option>
                @foreach (var t in Targets)
                {
                    <option value="@t.Id">@t.Name (@ChaseService.GetRoleText(t.Role))</option>
                }
            </select>
        </div>
        <SkillCheckFields SkillLabel="Навык атаки" SkillPlaceholder="Ближний бой"
                          @bind-SkillName="Form.SkillName" @bind-SkillValue="Form.SkillValue" @bind-Roll="Form.Roll"/>
        <div>
            <label class="text-xs text-gray-600">Урон (если попадание)</label>
            <input type="number" min="0" @bind="Form.DamageRoll" placeholder="0"
                   class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div class="col-span-2 border-t border-error-200 pt-2">
            <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                <input type="checkbox" @bind="Form.UseDefence" class="rounded border-gray-300" />
                Цель отвечает — контратака или уклонение
            </label>
            <p class="text-xs text-gray-400 mt-0.5">
                Правила требуют давать эту возможность всегда, сколько бы действий
                перемещения у цели ни оставалось.
            </p>
        </div>
        @if (Form.UseDefence)
        {
            <div>
                <label class="text-xs text-gray-600">Реакция</label>
                <select @bind="Form.DefenceIsFightBack" class="w-full text-sm border border-gray-300 rounded px-2 py-1.5">
                    <option value="false">Уклонение — ничья за защитника</option>
                    <option value="true">Контратака — ничья за атакующего</option>
                </select>
            </div>
            <div>
                <label class="text-xs text-gray-600">Навык защиты</label>
                <input type="text" @bind="Form.DefenceSkillName" placeholder="Уклонение"
                       class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
            </div>
            <div>
                <label class="text-xs text-gray-600">Значение навыка</label>
                <input type="number" @bind="Form.DefenceValue"
                       class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
            </div>
            <div>
                <label class="text-xs text-gray-600">Бросок защиты d100</label>
                <input type="number" min="1" max="100" @bind="Form.DefenceRoll" placeholder="01–100"
                       class="w-full text-sm border border-gray-300 rounded px-2 py-1.5" />
            </div>
        }
    </div>
    <div class="flex gap-2">
        <button type="button" class="cm-btn cm-btn-error cm-btn-sm" @onclick="Execute"
                disabled="@string.IsNullOrEmpty(Form.TargetId)">
            <span>Атаковать</span>
        </button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="OnCancel">
            <span>Отмена</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required ChaseParticipant Participant { get; set; }
    [Parameter, EditorRequired] public required ChaseActionForm Form { get; set; }

    /// <summary>Участники в той же локации.</summary>
    [Parameter, EditorRequired] public required List<ChaseParticipant> Targets { get; set; }

    [Parameter] public EventCallback<ChaseActionResult> OnResolved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Execute()
    {
        if (!Guid.TryParse(Form.TargetId, out var targetId)) return;
        var skill = string.IsNullOrWhiteSpace(Form.SkillName) ? "Ближний бой" : Form.SkillName;
        var result = ChaseService.ResolveMeleeAttack(
            Participant.Id, targetId,
            skill, Form.SkillValue,
            ChaseActionForm.Entered(Form.Roll),
            ChaseActionForm.Entered(Form.DamageRoll),
            Form.UseDefence ? (string.IsNullOrWhiteSpace(Form.DefenceSkillName) ? null : Form.DefenceSkillName) : null,
            Form.UseDefence ? Form.DefenceValue : 0,
            Form.UseDefence ? ChaseActionForm.Entered(Form.DefenceRoll) : null,
            Form.UseDefence && Form.DefenceIsFightBack);
        await OnResolved.InvokeAsync(result);
    }
}
