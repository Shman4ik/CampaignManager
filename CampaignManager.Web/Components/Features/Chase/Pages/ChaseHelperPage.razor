@page "/chase"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using CampaignManager.Web.Components.Features.Chase.Services
@using CampaignManager.Web.Components.Features.Chase.Model
@using CampaignManager.Web.Components.Features.Chase.Components
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Bestiary.Services
@using CampaignManager.Web.Components.Features.Bestiary.Model
@using CampaignManager.Web.Components.Features.Campaigns.Models
@using CampaignManager.Web.Components.Features.Campaigns.Services
@using CampaignManager.Web.Components.Features.Combat.Components
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Utilities.Services

@implements IDisposable

@inject ChaseService ChaseService
@inject ChaseSessionService ChaseSessionService
@inject CreatureService CreatureService
@inject CampaignService CampaignService
@inject IdentityService IdentityService

<PageTitle>Помощник погони</PageTitle>

<PageHeader Title="Помощник погони">
    <Actions>
        @if (_isKeeper)
        {
            <CampaignSelector OnCampaignSelected="HandleCampaignSelected" />
        }
    </Actions>
</PageHeader>

@if (!_isKeeper)
{
    <div class="max-w-7xl mx-auto px-4 py-6">
        <Alert Type="error" Title="Доступ запрещён">
            Эта страница доступна только для мастера игры.
        </Alert>
    </div>
}
else
{
<div class="max-w-7xl mx-auto px-4 py-6">
    @if (_wasRestored)
    {
        <div class="cm-card mb-4 border-accent-200">
            <div class="cm-card-body flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <span class="text-sm text-gray-700">
                    <i class="fa-solid fa-clock-rotate-left text-accent-600 mr-1"></i>
                    Восстановлена сохранённая погоня: раунд @ChaseService.CurrentRound,
                    участников @ChaseService.Participants.Count.
                </span>
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm shrink-0" @onclick="DismissRestoreNotice">
                    <span>Понятно</span>
                </button>
            </div>
        </div>
    }

    <!-- Панель раундов (только в активной фазе) -->
    @if (ChaseService.Phase == ChasePhase.Active)
    {
        var activeP = ChaseService.GetActiveParticipant();
        <div class="cm-card mb-4">
            <div class="cm-card-body flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="flex items-center gap-4 flex-wrap">
                    <span class="text-sm font-semibold text-gray-800">Раунд: @ChaseService.CurrentRound</span>
                    <span class="text-sm text-gray-500">
                        Ход: @(ChaseService.CurrentTurnIndex + 1) / @Math.Max(1, ChaseService.Participants.Count(p => p.IsActive))
                    </span>
                    @if (activeP is not null)
                    {
                        <span class="text-sm font-medium text-accent-700">→ @activeP.Name</span>
                        <span class="text-xs text-gray-500">
                            Действий: @activeP.MovementActionsRemaining / @activeP.TotalMovementActions
                        </span>
                    }
                    @if (ChaseService.IsChaseOver())
                    {
                        <span class="text-sm font-bold text-success-700">Погоня завершена!</span>
                    }
                </div>
                <div class="flex gap-2 flex-wrap">
                    <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" @onclick="NextTurn">
                        <span>Следующий ход</span>
                    </button>
                    <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="NextRound">
                        <span>Следующий раунд</span>
                    </button>
                    <button type="button" class="cm-btn cm-btn-info cm-btn-sm" @onclick="ToggleChaseLog">
                        <span>@(_showChaseLog ? "Скрыть журнал" : "Журнал погони")</span>
                    </button>
                </div>
            </div>

            <ChaseOptionalRules />
        </div>
    }

    <!-- Три колонки -->
    <div class="grid grid-cols-12 gap-4">

        <!-- Левая: Участники + Добавление -->
        <div class="col-span-12 lg:col-span-4 space-y-3">
            <!-- Список участников -->
            <div class="cm-card">
                <div class="cm-card-header">
                    <span class="cm-section-title">Участники погони</span>
                </div>
                <div class="max-h-[40vh] overflow-y-auto p-3 pr-2">
                    @if (ChaseService.Participants.Any())
                    {
                        @foreach (var participant in ChaseService.Participants)
                        {
                            <ChaseParticipantCard @key="participant.Id"
                                                   Participant="participant"
                                                   IsActive="@(participant == ChaseService.GetActiveParticipant())"
                                                   IsSetupMode="@(ChaseService.Phase == ChasePhase.Setup)"
                                                   IsChaseActive="@(ChaseService.Phase == ChasePhase.Active)"
                                                   OnRemoveCallback="RemoveParticipant"
                                                   OnRoleChanged="HandleRoleChanged"
                                                   OnLocationChanged="HandleLocationChanged" />
                        }
                    }
                    else
                    {
                        <p class="cm-empty">Нет участников</p>
                    }
                </div>
            </div>

            <!-- Добавить участника: до старта и по ходу погони (стр. 140) -->
            @if (ChaseService.Phase is ChasePhase.Setup or ChasePhase.Active)
            {
                <div class="cm-card">
                    <div class="cm-card-header">
                        <span class="cm-section-title">
                            @(ChaseService.Phase == ChasePhase.Active ? "Присоединить к погоне" : "Добавить участника")
                        </span>
                    </div>
                    <div class="cm-card-body">
                        @if (ChaseService.Phase == ChasePhase.Active)
                        {
                            <p class="text-xs text-gray-500 mb-2">
                                Присоединившийся встаёт в порядок ходов по ЛВК, а действия перемещения
                                пересчитываются для всех. Преследователь медленнее самого медленного
                                убегающего в погоне не учитывается.
                            </p>
                        }
                        <!-- Роль при добавлении -->
                        <div class="flex gap-1 mb-2">
                            <button @onclick='() => _addRole = ChaseRole.Prey'
                                    class="px-2 py-1 text-xs rounded font-medium transition-colors @(_addRole == ChaseRole.Prey ? "bg-success-100 text-success-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                                Жертва
                            </button>
                            <button @onclick='() => _addRole = ChaseRole.Pursuer'
                                    class="px-2 py-1 text-xs rounded font-medium transition-colors @(_addRole == ChaseRole.Pursuer ? "bg-error-100 text-error-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                                Преследователь
                            </button>
                        </div>

                        <!-- Транспорт из таблицы V (стр. 143) -->
                        <div class="mb-2">
                            <label class="text-xs text-gray-600 block mb-1">Транспорт</label>
                            <select @bind="_addVehicleName" class="w-full text-xs border border-gray-200 rounded px-2 py-1">
                                <option value="">Пешком</option>
                                @foreach (var category in ChaseReference.VehicleCategories)
                                {
                                    <optgroup label="@category">
                                        @foreach (var vehicle in ChaseReference.Vehicles.Where(v => v.Category == category))
                                        {
                                            <option value="@vehicle.Name">
                                                @vehicle.Name — СКО @vehicle.Speed, Компл. @vehicle.Build.ToString("0.#")
                                            </option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <!-- Вкладки -->
                        <div class="flex gap-1 mb-2">
                            <button @onclick='() => _showAddMode = "characters"'
                                    class="px-2 py-1 text-xs rounded font-medium transition-colors @(_showAddMode == "characters" ? "bg-accent-100 text-accent-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                                Персонажи
                            </button>
                            <button @onclick='() => _showAddMode = "creatures"'
                                    class="px-2 py-1 text-xs rounded font-medium transition-colors @(_showAddMode == "creatures" ? "bg-error-100 text-error-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                                Существа
                            </button>
                        </div>

                        <div class="max-h-[25vh] overflow-y-auto border border-gray-100 rounded-md">
                            @if (_showAddMode == "characters")
                            {
                                @if (_availableCharacters is null)
                                {
                                    <p class="cm-empty">@(_selectedCampaign is null ? "Выберите кампанию" : "Загрузка...")</p>
                                }
                                else if (!_availableCharacters.Any())
                                {
                                    <p class="cm-empty">Нет персонажей</p>
                                }
                                else
                                {
                                    @foreach (var chara in _availableCharacters)
                                    {
                                        <div class="flex justify-between items-center px-2 py-1.5 hover:bg-accent-50 cursor-pointer text-sm border-b border-gray-50 last:border-0"
                                             @onclick="() => AddCharacter(chara)">
                                            <span class="text-gray-800">@chara.PersonalInfo.Name</span>
                                            <span class="text-xs text-gray-400">СКО @chara.PersonalInfo.MoveSpeed</span>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                @if (_availableCreatures is null)
                                {
                                    <p class="cm-empty">Загрузка...</p>
                                }
                                else
                                {
                                    @foreach (var monster in _availableCreatures)
                                    {
                                        <div class="flex justify-between items-center px-2 py-1.5 hover:bg-error-50 cursor-pointer text-sm border-b border-gray-50 last:border-0"
                                             @onclick="() => AddMonster(monster)">
                                            <span class="text-gray-800">@monster.Name</span>
                                            <span class="text-xs text-gray-400">СКО @monster.CreatureCharacteristics.Speed</span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <button type="button" class="cm-btn cm-btn-error cm-btn-sm w-full" @onclick="ResetChase">
                <span>Сбросить погоню</span>
            </button>
        </div>

        <!-- Центральная колонка -->
        <div class="col-span-12 @(_showChaseLog ? "lg:col-span-5" : "lg:col-span-8") space-y-3">

            <!-- Трасса -->
            <ChaseTrack Locations="ChaseService.Locations"
                        Participants="ChaseService.Participants"
                        ActiveParticipantId="@(ChaseService.GetActiveParticipant()?.Id)" />

            <!-- Контакт: преследователь настиг жертву. Это ещё не поимка (стр. 135) -->
            @if (ChaseService.Phase == ChasePhase.Active && ChaseService.HasContact())
            {
                <div class="cm-card border-error-200">
                    <div class="cm-card-body space-y-2">
                        @foreach (var prey in ChaseService.Participants.Where(p => p.Role == ChaseRole.Prey && p.IsActive))
                        {
                            var catchers = ChaseService.GetPursuersInContactWith(prey);
                            if (catchers.Count == 0) { continue; }

                            <div class="flex items-center justify-between gap-3 flex-wrap">
                                <div class="text-sm text-gray-700">
                                    <i class="fa-solid fa-hand-fist text-error-600 mr-1"></i>
                                    <span class="font-medium">@prey.Name</span> настигнут на локации @prey.CurrentLocation
                                    (@string.Join(", ", catchers.Select(c => c.Name))).
                                    <span class="text-gray-500">Доступны ближний бой и боевой манёвр — поимку объявляет Хранитель.</span>
                                </div>
                                <button type="button" class="cm-btn cm-btn-error cm-btn-sm shrink-0"
                                        @onclick="() => MarkCaught((prey.Id, catchers[0].Id))">
                                    <span>Объявить пойманным</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Фаза Setup: настройка трассы -->
            @if (ChaseService.Phase == ChasePhase.Setup)
            {
                <div class="cm-card">
                    <div class="cm-card-header">
                        <span class="cm-section-title">Настройка трассы</span>
                    </div>
                    <div class="cm-card-body">
                        <div class="flex items-center gap-3 mb-2 flex-wrap">
                            <label class="text-sm text-gray-600">Количество локаций:</label>
                            <input type="number" min="3" max="30" @bind="_trackLength"
                                   class="text-sm border border-gray-200 rounded px-2 py-1 w-20" />
                            <label class="text-sm text-gray-600">Стартовый отрыв жертвы:</label>
                            <select @bind="_startGap" class="text-sm border border-gray-200 rounded px-2 py-1">
                                <option value="2">2 локации</option>
                                <option value="1">1 локация</option>
                            </select>
                            <button @onclick="SetupTrack" class="cm-btn cm-btn-primary cm-btn-sm">
                                Создать трассу
                            </button>
                        </div>
                        <p class="text-xs text-gray-400 mb-4">
                            Преследователи встают на локацию 1, жертвы — на @(1 + _startGap).
                            По правилам дистанция в начале погони не должна превышать две локации.
                        </p>

                        @if (ChaseService.Locations.Any())
                        {
                            <div class="max-h-[40vh] overflow-y-auto space-y-1">
                                @foreach (var location in ChaseService.Locations)
                                {
                                    <LocationEditor @key="location.Number" Location="location" OnLocationUpdated="HandleLocationUpdated" />
                                }
                            </div>

                            <div class="mt-4">
                                <button type="button" class="cm-btn cm-btn-success w-full"
                                        disabled="@(ChaseService.Participants.Count < 2)"
                                        @onclick="BeginSpeedChecks">
                                    <span>Начать проверку скорости →</span>
                                </button>
                                @if (ChaseService.Participants.Count < 2)
                                {
                                    <p class="text-xs text-gray-400 text-center mt-1">Добавьте минимум 2 участников</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Фаза SpeedCheck: проверка скорости -->
            @if (ChaseService.Phase == ChasePhase.SpeedCheck)
            {
                <SpeedCheckPanel OnChaseStarted="HandleChaseStarted"
                                 OnPreyEscaped="HandlePreyEscaped" />
            }

            <!-- Фаза Active: панель действий -->
            @if (ChaseService.Phase == ChasePhase.Active)
            {
                @if (ChaseService.PendingResult is not null)
                {
                    var pending = ChaseService.PendingResult;
                    <div class="cm-card">
                        <div class="cm-card-header">
                            <span class="cm-section-title">Результат действия — предпросмотр</span>
                        </div>
                        <div class="cm-card-body">
                            <div class="bg-gray-50 rounded-md p-3 mb-3">
                                <p class="text-sm text-gray-700">@pending.Summary</p>
                                @if (pending.Roll > 0)
                                {
                                    <p class="text-xs text-gray-500 mt-1">
                                        Бросок: @pending.Roll против @pending.SkillValue
                                    </p>
                                }
                                @if (pending.LocationBefore is not null && pending.LocationAfter != pending.LocationBefore)
                                {
                                    <p class="text-xs text-accent-600 mt-1">
                                        Локация: @pending.LocationBefore → @pending.LocationAfter
                                    </p>
                                }
                                @if (pending.ActorMovementActionsSpent > 0)
                                {
                                    <p class="text-xs text-gray-500 mt-1">
                                        Тратит действий перемещения: @pending.ActorMovementActionsSpent
                                    </p>
                                }
                                @if (pending.MovementActionsLost > 0)
                                {
                                    <p class="text-xs text-warning-700 mt-1">
                                        @(pending.TargetName ?? pending.ParticipantName) теряет действий: @pending.MovementActionsLost
                                    </p>
                                }
                                @if (pending.DamageDealt > 0)
                                {
                                    <p class="text-xs text-error-600 mt-1">
                                        Урон @(pending.TargetName ?? pending.ParticipantName): @pending.DamageDealt
                                        @if (pending.HpBefore.HasValue)
                                        {
                                            <span>(ОЗ: @pending.HpBefore → @pending.HpAfter)</span>
                                        }
                                    </p>
                                }
                                @if (pending.TargetBuildLoss > 0)
                                {
                                    <p class="text-xs text-error-600 mt-1">
                                        Комплекция @(pending.TargetName ?? pending.ParticipantName):
                                        −@pending.TargetBuildLoss
                                        @if (pending.TargetVehicleDamage > 0)
                                        {
                                            <span class="text-gray-500">(остаток урона: @pending.TargetVehicleDamage)</span>
                                        }
                                    </p>
                                }
                                @if (pending.ActorBuildLoss > 0)
                                {
                                    <p class="text-xs text-warning-700 mt-1">
                                        Отдача — Комплекция @pending.ParticipantName: −@pending.ActorBuildLoss
                                    </p>
                                }
                                @if (pending.PenaltyDice > 0)
                                {
                                    <p class="text-xs text-warning-700 mt-1">
                                        Штрафных костей: @pending.PenaltyDice
                                    </p>
                                }
                                @if (pending.RemovesActorFromChase)
                                {
                                    <p class="text-xs text-gray-700 mt-1">
                                        @pending.ParticipantName выбывает из погони.
                                    </p>
                                }
                                @if (pending.BarrierDamageDealt > 0)
                                {
                                    <p class="text-xs text-accent-600 mt-1">
                                        Урон преграде: @pending.BarrierDamageDealt (ПЗ осталось: @pending.BarrierHpAfter)
                                    </p>
                                }
                            </div>
                            <p class="text-xs text-gray-400 mb-2">
                                Ничего ещё не изменилось — «Отменить» вернёт всё как было.
                            </p>
                            <div class="flex gap-2">
                                <button type="button" class="cm-btn cm-btn-success cm-btn-sm" @onclick="ApplyPendingResult">
                                    <span>Применить</span>
                                </button>
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="CancelPendingResult">
                                    <span>Отменить</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <ChaseActionPanel ActiveParticipant="ChaseService.GetActiveParticipant()"
                                       Locations="ChaseService.Locations"
                                       OnActionResolved="HandleActionResolved" />
                }
            }

            <!-- Фаза Ended -->
            @if (ChaseService.Phase == ChasePhase.Ended)
            {
                <div class="cm-card text-center">
                    <div class="cm-card-body">
                        <div class="text-2xl mb-2"><i class="fa-solid fa-flag-checkered"></i></div>
                        <h3 class="text-base font-semibold text-gray-800 mb-1">Погоня завершена</h3>
                        <div class="text-sm text-gray-600 space-y-1">
                            @foreach (var prey in ChaseService.Participants.Where(p => p.Role == ChaseRole.Prey))
                            {
                                <p>
                                    @prey.Name:
                                    @if (prey.HasEscaped) { <span class="text-success-700 font-medium">Сбежал</span> }
                                    else if (prey.IsCaught) { <span class="text-error-700 font-medium">Пойман</span> }
                                    else if (prey.IsEliminated) { <span class="text-gray-700 font-medium">Выбыл</span> }
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Правая: Журнал -->
        @if (_showChaseLog)
        {
            <div class="col-span-12 lg:col-span-3">
                <ChaseLog LogEntries="ChaseService.ChaseLog" />
            </div>
        }
    </div>
</div>
}

@code {
    private bool _isKeeper;
    private string _showAddMode = "characters";
    private ChaseRole _addRole = ChaseRole.Prey;
    private string _addVehicleName = "";
    private int _trackLength = 10;
    private int _startGap = 2;
    private bool _pendingSave;
    private bool _saveEnabled;
    private bool _wasRestored;
    private Guid? _restoredCampaignId;
    private bool _showChaseLog = true;
    private Campaign? _selectedCampaign;
    private List<Character>? _availableCharacters;
    private List<Creature>? _availableCreatures;

    protected override async Task OnInitializedAsync()
    {
        _isKeeper = await IdentityService.IsKeeper();
        if (!_isKeeper) return;

        ChaseService.OnChange += HandleChaseChanged;
        _availableCreatures = await CreatureService.GetAllCreaturesAsync("", null, 1, 200);

        // Восстановить сцену после обрыва соединения или перезагрузки вкладки
        if (!ChaseService.HasContent())
        {
            var saved = await ChaseSessionService.LoadLatestAsync();
            if (saved is { } session && (session.Snapshot.Participants.Count > 0 || session.Snapshot.Locations.Count > 0))
            {
                ChaseService.RestoreSnapshot(session.Snapshot);
                _restoredCampaignId = session.CampaignId;
                _wasRestored = true;

                if (session.CampaignId is { } campaignId)
                    await LoadCampaignCharactersAsync(campaignId);
            }
        }

        _saveEnabled = true;
    }

    public void Dispose()
    {
        ChaseService.OnChange -= HandleChaseChanged;
    }

    private void HandleChaseChanged()
    {
        _pendingSave = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_saveEnabled || !_pendingSave) return;
        _pendingSave = false;
        await ChaseSessionService.SaveAsync(CurrentCampaignId, ChaseService.CreateSnapshot());
    }

    private Guid? CurrentCampaignId => _selectedCampaign?.Id ?? _restoredCampaignId;

    private async Task HandleCampaignSelected(Campaign? campaign)
    {
        _selectedCampaign = campaign;
        _wasRestored = false;

        if (campaign is not null)
        {
            _restoredCampaignId = null;
            ChaseService.SetCampaign(campaign.Id);
            await LoadCampaignCharactersAsync(campaign.Id);
        }
        else
        {
            _availableCharacters = null;
        }

        StateHasChanged();
    }

    private async Task LoadCampaignCharactersAsync(Guid campaignId)
    {
        var fullCampaign = await CampaignService.GetCampaignWithCharactersAsync(campaignId);
        _availableCharacters = fullCampaign?.Players
            .SelectMany(p => p.Characters)
            .Where(c => c.Status == CharacterStatus.Active)
            .Select(c => c.Character)
            .ToList() ?? [];
    }

    private void AddCharacter(Character character) =>
        AddParticipant(new ChaseParticipant(character) { Role = _addRole });

    private void AddMonster(Creature creature) =>
        AddParticipant(new ChaseParticipant(creature) { Role = _addRole });

    private void AddParticipant(ChaseParticipant participant)
    {
        var template = ChaseReference.FindVehicle(_addVehicleName);
        if (template is not null)
        {
            participant.IsInVehicle = true;
            participant.VehicleName = template.Name;
            participant.VehicleSpeed = template.Speed;
            participant.VehicleBuild = template.Build;
            participant.VehicleCurrentBuild = template.Build;
            participant.VehicleArmor = template.Armor;
            participant.VehicleSkillName = template.SkillName;
        }

        // Погоня уже идёт — новый участник проходит проверку скорости и меняет расклад (стр. 140)
        if (ChaseService.Phase == ChasePhase.Active)
        {
            ChaseService.JoinChase(participant, participant.Role == ChaseRole.Prey
                ? ChaseService.Locations.Count
                : 1);
            return;
        }

        ChaseService.AddParticipant(participant);
    }

    private void RemoveParticipant(ChaseParticipant participant) =>
        ChaseService.RemoveParticipant(participant);

    private void HandleRoleChanged((Guid id, ChaseRole role) args) =>
        ChaseService.SetParticipantRole(args.id, args.role);

    private void HandleLocationChanged((Guid id, int location) args) =>
        ChaseService.SetParticipantLocation(args.id, args.location);

    private void SetupTrack() => ChaseService.SetupTrack(_trackLength, _startGap);

    private void MarkCaught((Guid preyId, Guid? catcherId) args) =>
        ChaseService.MarkCaught(args.preyId, args.catcherId);

    private void HandleLocationUpdated(ChaseLocation location) =>
        ChaseService.UpdateLocation(location.Number, location);

    private void BeginSpeedChecks() => ChaseService.BeginSpeedChecks();

    private void HandleChaseStarted() => StateHasChanged();

    private void HandlePreyEscaped() => StateHasChanged();

    private void ToggleChaseLog() => _showChaseLog = !_showChaseLog;

    private void DismissRestoreNotice() => _wasRestored = false;

    private void NextTurn() => ChaseService.NextTurn();

    private void NextRound() => ChaseService.NextRound();

    private void HandleActionResolved(ChaseActionResult result) =>
        ChaseService.SetPendingResult(result);

    private void ApplyPendingResult()
    {
        if (ChaseService.PendingResult is not null)
            ChaseService.ApplyResult(ChaseService.PendingResult);
    }

    private void CancelPendingResult() => ChaseService.CancelPendingResult();

    private async Task ResetChase()
    {
        var campaignId = CurrentCampaignId;
        ChaseService.ResetChase();
        _wasRestored = false;
        _restoredCampaignId = null;
        _pendingSave = false;
        await ChaseSessionService.DeleteAsync(campaignId);
    }
}
