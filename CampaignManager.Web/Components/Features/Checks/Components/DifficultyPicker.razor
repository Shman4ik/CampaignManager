@using CampaignManager.Web.Components.Features.Checks.Services
@using CampaignManager.Web.Components.Features.Combat.Model

@* Три уровня сложности (стр. 80) кнопками, а не выпадающим списком: за столом это один тап.
   Рядом с каждым — сколько нужно выбросить, если значение уже известно. *@

<div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Сложность проверки">
    @foreach (var difficulty in SkillCheckRules.Difficulties)
    {
        var active = difficulty == Value;
        <button type="button"
                role="radio"
                aria-checked="@(active ? "true" : "false")"
                class="cm-btn cm-btn-sm @(active ? "cm-btn-primary" : "cm-btn-secondary")"
                disabled="@Disabled"
                data-testid="@($"check-difficulty-{difficulty}")"
                @onclick="() => Select(difficulty)">
            <span>@SkillCheckRules.DifficultyLabel(difficulty)@TargetSuffix(difficulty)</span>
        </button>
    }
</div>

@code {
    [Parameter] public SuccessLevel Value { get; set; } = SuccessLevel.RegularSuccess;
    [Parameter] public EventCallback<SuccessLevel> ValueChanged { get; set; }

    /// <summary>Значение навыка — тогда у кнопок появляется «≤ 27».</summary>
    [Parameter] public int? SkillValue { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private string TargetSuffix(SuccessLevel difficulty) =>
        SkillValue is { } value ? $" ≤ {SkillCheckRules.TargetNumber(value, difficulty)}" : "";

    private Task Select(SuccessLevel difficulty) => ValueChanged.InvokeAsync(difficulty);
}
