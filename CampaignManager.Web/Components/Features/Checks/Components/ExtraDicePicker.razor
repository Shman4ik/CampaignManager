@using CampaignManager.Web.Components.Features.Checks.Services

@* Бонусные и штрафные кости одним числом от −2 до +2: одна бонусная гасит одну штрафную
   (стр. 89), поэтому Хранителю нужен только итог. *@

<div>
    <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Бонусные и штрафные кости">
        @for (var net = -SkillCheckRules.MaxExtraDice; net <= SkillCheckRules.MaxExtraDice; net++)
        {
            var value = net;
            var active = value == Value;
            <button type="button"
                    role="radio"
                    aria-checked="@(active ? "true" : "false")"
                    aria-label="@SkillCheckRules.ExtraDiceLabel(value)"
                    class="cm-btn cm-btn-sm @(active ? "cm-btn-primary" : "cm-btn-secondary") extra-dice-btn"
                    disabled="@Disabled"
                    data-testid="@($"check-dice-{value}")"
                    @onclick="() => ValueChanged.InvokeAsync(value)">
                <span>@(value > 0 ? $"+{value}" : value < 0 ? $"−{-value}" : "0")</span>
            </button>
        }
    </div>
    <p class="cm-field-note mt-1">@SkillCheckRules.ExtraDiceLabel(Value)</p>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
