@using CampaignManager.Web.Components.Features.Campaigns.Models
@using CampaignManager.Web.Components.Features.Campaigns.Services
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Model
@using CampaignManager.Web.Utilities.Services
@inject CampaignService CampaignService
@inject CharacterService CharacterService
@inject IdentityService UserInformationService
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<div class="cm-section">
    <div class="cm-section-header">
        <span class="cm-section-title">Ваши кампании</span>
    </div>

    @if (!IsUserAuthenticated)
    {
        <div class="cm-info-banner">
            <i class="fa-solid fa-circle-info mr-1.5"></i>Войдите в систему, чтобы увидеть свои кампании.
        </div>
    }
    else if (UserCampaigns is null)
    {
        <p class="cm-empty"><i class="fa-solid fa-spinner fa-spin mr-1"></i>Загрузка...</p>
    }
    else if (UserCampaigns.Count == 0)
    {
        <p class="cm-empty">У вас пока нет доступных кампаний.</p>
    }
    else
    {
        <div class="campaigns-grid">
            @foreach (var campaign in UserCampaigns)
            {
                var isKeeper = CurrentUserId == campaign.KeeperEmail;
                var userCharacter = GetUserCharacter(campaign);
                var npcs = isKeeper && _isKeeper ? GetCampaignNpcs(campaign.Id) : [];

                <div class="cm-card campaign-card">
                    <div class="campaign-card-header">
                        <span class="campaign-card-name" title="@campaign.Name">@campaign.Name</span>
                        @if (isKeeper)
                        {
                            <Badge Variant="accent" Size="sm" Rounded="full" WithBorder="false">Хранитель</Badge>
                        }
                    </div>
                    <div class="campaign-card-body">
                        @* Свою же почту в роли Хранителя не повторяем — об этом говорит бейдж в шапке. *@
                        <div class="campaign-meta">
                            @if (!isKeeper)
                            {
                                <span class="campaign-meta-value" title="@campaign.KeeperEmail">@campaign.KeeperEmail</span>
                                <span class="campaign-meta-sep">·</span>
                            }
                            <span class="campaign-meta-count">Игроков: @(campaign.Players?.Count ?? 0)</span>
                        </div>

                        @if (userCharacter is not null)
                        {
                            <div class="campaign-row">
                                <span class="campaign-row-text" title="@userCharacter.CharacterName">
                                    <span class="campaign-row-name">@userCharacter.CharacterName</span>
                                    @if (!string.IsNullOrWhiteSpace(userCharacter.Character.PersonalInfo.Occupation))
                                    {
                                        <span class="campaign-row-sub">@userCharacter.Character.PersonalInfo.Occupation</span>
                                    }
                                </span>
                                <button type="button" class="cm-btn cm-btn-primary cm-btn-sm"
                                        @onclick="() => EditCharacter(userCharacter.Id)">
                                    Открыть
                                </button>
                            </div>
                        }

                        @if (userCharacter is null || (isKeeper && _isKeeper))
                        {
                            <div class="campaign-actions">
                                @if (userCharacter is null)
                                {
                                    <button type="button" class="cm-btn cm-btn-primary cm-btn-sm"
                                            @onclick="() => StartWizard(campaign.Id)">
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>Создать сыщика
                                    </button>
                                    <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm"
                                            @onclick="() => CreateNewCharacter(campaign.Id)">
                                        Пустой лист
                                    </button>
                                }
                                @if (isKeeper && _isKeeper)
                                {
                                    <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm campaign-action-wide"
                                            @onclick="() => AddNpc(campaign.Id)">
                                        <i class="fa-solid fa-plus"></i>Добавить NPC
                                    </button>
                                }
                            </div>
                        }

                        @if (isKeeper && _isKeeper && npcs.Count > 0)
                        {
                            <div class="campaign-npcs">
                                <div class="campaign-npcs-title">NPC (@npcs.Count)</div>
                                @foreach (var npc in npcs)
                                {
                                    <div class="campaign-row">
                                        <span class="campaign-row-text" title="@npc.CharacterName">
                                            <span class="campaign-row-name">@npc.CharacterName</span>
                                        </span>
                                        <button type="button" class="cm-btn cm-btn-outline-primary cm-btn-sm"
                                                @onclick="() => EditCharacter(npc.Id)">
                                            Открыть
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Campaign>? UserCampaigns;
    private bool IsUserAuthenticated => CurrentUserId is not null;
    private string? CurrentUserId;
    private bool _isKeeper;

    /// <summary>НПС по кампаниям, где текущий пользователь — Хранитель.</summary>
    private readonly Dictionary<Guid, List<CharacterStorageDto>> _campaignNpcs = [];

    protected override async Task OnInitializedAsync()
    {
        CurrentUserId = UserInformationService.GetCurrentUserEmail();
        if (IsUserAuthenticated)
        {
            UserCampaigns = await CampaignService.GetUserCampaignsAsync();
            _isKeeper = await UserInformationService.IsKeeper();

            if (_isKeeper)
            {
                foreach (var campaign in UserCampaigns?.Where(c => c.KeeperEmail == CurrentUserId) ?? [])
                {
                    var npcs = await CharacterService.GetNpcsAsync(campaign.Id);
                    _campaignNpcs[campaign.Id] = npcs.Where(n => n.CampaignId == campaign.Id).ToList();
                }
            }
        }
    }

    private CharacterStorageDto? GetUserCharacter(Campaign campaign) =>
        campaign.Players?
            .FirstOrDefault(p => p.PlayerEmail == CurrentUserId)
            ?.Characters?
            .Where(p => p.Status == CharacterStatus.Active)
            .SingleOrDefault();

    /// <summary>
    ///     НПС кампании — отдельные листы с <c>CampaignId</c>, а не персонажи в слотах игроков.
    /// </summary>
    private List<CharacterStorageDto> GetCampaignNpcs(Guid campaignId) =>
        _campaignNpcs.TryGetValue(campaignId, out var npcs) ? npcs : [];

    private void EditCharacter(Guid characterId) =>
        NavigationManager.NavigateTo($"/character/{characterId}");

    private void CreateNewCharacter(Guid campaignId) =>
        NavigationManager.NavigateTo($"/character/create/{campaignId}");

    /// <summary>Помощник ведёт игрока по шагам главы 3; пустой лист остаётся для тех, кто считает сам.</summary>
    private void StartWizard(Guid campaignId) =>
        NavigationManager.NavigateTo($"/character/wizard?campaignId={campaignId}");

    private void AddNpc(Guid campaignId) =>
        NavigationManager.NavigateTo($"/character/create/npc?campaignId={campaignId}");
}
