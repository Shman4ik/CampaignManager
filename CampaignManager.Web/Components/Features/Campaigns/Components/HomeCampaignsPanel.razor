@using CampaignManager.Web.Components.Features.Campaigns.Models
@using CampaignManager.Web.Components.Features.Campaigns.Services
@inject CampaignService CampaignService
@rendermode InteractiveServer

@* Один интерактивный остров на три блока главной. Раньше каждый блок был своим островом и
   грузил кампании сам — одни и те же данные трижды на проход. Теперь снимок читается здесь один
   раз и раздаётся параметром; блоки своего @rendermode не имеют и в базу не ходят. *@

<UserCampaignsComponent Campaigns="_campaigns"/>
<JoinCampaignComponent Campaigns="_campaigns"/>
<KeeperCharactersComponent Campaigns="_campaigns"/>

@code {
    private HomeCampaigns? _campaigns;

    protected override async Task OnInitializedAsync()
    {
        _campaigns ??= await CampaignService.GetHomeCampaignsAsync();
    }
}
