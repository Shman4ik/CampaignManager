@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
<table class="w-full text-xs">
    <thead>
    <tr class="border-b border-gray-300">
        <th class="text-left font-semibold text-xs text-gray-600 pb-1"></th>
        <th class="w-[8.5rem] text-center font-semibold text-xs text-gray-600 pb-1">Текущ.</th>
        <th class="w-14 text-center font-semibold text-xs text-gray-600 pb-1">Макс.</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var attr in _attributeRows)
    {
        var percentage = GetPercentage(attr.Attribute);
        var barColor = GetBarColor(attr.ColorClass, percentage);
        var inputClass = GetInputClass(attr.ColorClass, percentage);
        <tr class="border-b border-gray-100">
            <td class="py-1">
                <span class="text-xs font-medium text-gray-700">@attr.Label</span>
                @* Трата Удачи — необязательное правило со своей арифметикой, ей нужен диалог,
                   а не поле: платят за конкретную проверку, а не «просто списывают» (стр. 96). *@
                @if (attr.IsLuck)
                {
                    <button type="button" class="luck-spend" data-testid="luck-spend-open"
                            aria-label="Потратить Удачу на бросок"
                            @onclick="() => _showLuckModal = true">
                        <i class="fa-solid fa-coins"></i>
                    </button>
                }
            </td>
            <td class="py-1 px-0.5">
                @* Кнопки шага — штатный cm-btn-icon (36x36): за игрой их жмут пальцем каждый
                   раунд, и прежние 20x24 в тап-цель не укладывались. *@
                <div class="flex items-center gap-1">
                    <button type="button" @onclick="() => AdjustAttribute(attr, -1)"
                            aria-label="@attr.Label минус"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-secondary shrink-0">−</button>
                    @* Полю нужен пол, а не свобода сжиматься: на планшетной ширине (768px) колонка
                       ужимала его до 39px, и «40» обрезалось до «4». 2.75rem держит двузначное
                       значение целиком, а таблица от этого не растёт — запас в колонке есть. *@
                    <input type="number" class="@inputClass min-w-[2.75rem] min-h-[36px]"
                           aria-label="@attr.Label текущее"
                           value="@attr.Attribute.Value"
                           @onchange="@(e => SetAttribute(attr, e))"/>
                    <button type="button" @onclick="() => AdjustAttribute(attr, 1)"
                            aria-label="@attr.Label плюс"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-secondary shrink-0">+</button>
                </div>
            </td>
            <td class="py-1 px-0.5">
                <input type="number" class="cm-input-sm min-h-[36px]"
                       aria-label="@attr.Label максимум"
                       @bind="attr.Attribute.MaxValue"/>
            </td>
        </tr>
        <tr>
            <td colspan="3" class="pb-1.5 pt-0 px-0.5">
                <div class="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 ease-out @barColor"
                         style="width: @(percentage)%"></div>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

@* Одна атака — один бросок урона: серьёзная рана считается по нему, а не по сумме за бой (стр. 117) *@
<div class="mt-3 pt-3 border-t border-gray-200">
    @* Поле и кнопка выровнены по нижнему краю: у поля сверху подпись, у кнопки нет. *@
    <div class="flex items-end gap-2 flex-wrap">
        <div class="shrink-0">
            <label for="wound-damage" class="cm-field-label">Урон</label>
            <input id="wound-damage" type="number" min="1" class="cm-input-sm !w-16 min-h-[36px]"
                   @bind="_damage" @bind:event="oninput"/>
        </div>
        @* Кнопка красная контуром, как строчное удаление: она бьёт по сыщику, а не
           «применяет настройку», — но и не подтверждение в диалоге, чтобы быть сплошной. *@
        <button type="button" class="cm-btn cm-btn-sm cm-btn-outline-error"
                data-testid="apply-damage" @onclick="ApplyDamage">
            <i class="fa-solid fa-heart-crack mr-1.5"></i>Нанести
        </button>
    </div>
    <p class="cm-field-note">Серьёзная рана — от @_majorWoundThreshold за одну атаку.</p>

    @if (_lastHitWasMajor)
    {
        <div class="mt-2 flex gap-2 px-2.5 py-2 bg-warning-50 border border-warning-200 rounded-md text-xs text-warning-800">
            <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>
                Урон ≥ половины максимума ПЗ — <strong>серьёзная рана</strong>: сыщик падает,
                нужна проверка ВЫН, иначе он теряет сознание.
            </span>
        </div>
    }
</div>

<LuckSpendModal Character="@Character"
                IsVisible="@_showLuckModal"
                OnClose="CloseLuckModal"
                OnSpent="@OnSheetChanged"/>

@code {
    [Parameter] public required Character Character { get; set; }

    /// <summary>
    ///     Урон меняет отметки состояния, а они рисуются соседним компонентом — просим родителя перерисоваться.
    /// </summary>
    [Parameter] public EventCallback OnConditionsChanged { get; set; }

    /// <summary>
    ///     Правка задела лист за пределами этой карточки — перерисовать нужно страницу целиком.
    ///     Трата Удачи снимает с навыка отметку развития, а навыки рисует другая секция: без этого
    ///     галочка в модели снята, а на экране стоит.
    /// </summary>
    [Parameter] public EventCallback OnSheetChanged { get; set; }

    private DerivedAttributes Attributes => Character.DerivedAttributes;

    private record AttributeRow(
        string Label,
        string ColorClass,
        AttributeWithMaxValue Attribute,
        bool IsHitPoints,
        bool IsLuck = false);

    private List<AttributeRow> _attributeRows = [];
    private int _damage = 1;
    private bool _showLuckModal;
    private bool _lastHitWasMajor;
    private int _majorWoundThreshold;

    protected override void OnParametersSet()
    {
        _attributeRows =
        [
            new("ПЗ", "red", Attributes.HitPoints, true),
            new("ПМ", "blue", Attributes.MagicPoints, false),
            new("Рассудок", "purple", Attributes.Sanity, false),
            new("Удача", "green", Attributes.Luck, false, IsLuck: true)
        ];

        _majorWoundThreshold = WoundRules.MajorWoundThreshold(Attributes.HitPoints.MaxValue);
    }

    private void CloseLuckModal() => _showLuckModal = false;

    private async Task ApplyDamage()
    {
        if (_damage <= 0)
            return;

        _lastHitWasMajor = WoundRules.ApplyDamage(Character, _damage);
        await OnConditionsChanged.InvokeAsync();
    }

    private Task AdjustAttribute(AttributeRow row, int delta)
    {
        row.Attribute.Value += delta;
        return AfterAttributeChange(row);
    }

    private Task SetAttribute(AttributeRow row, ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var value))
            return Task.CompletedTask;

        row.Attribute.Value = value;
        return AfterAttributeChange(row);
    }

    /// <summary>
    ///     Правка ПЗ вручную тоже меняет состояние: 0 ПЗ без серьёзной раны — без сознания,
    ///     с раной — при смерти; выше нуля сыщик снова на ногах (стр. 118).
    /// </summary>
    private async Task AfterAttributeChange(AttributeRow row)
    {
        if (!row.IsHitPoints)
            return;

        if (row.Attribute.Value > 0)
            _lastHitWasMajor = false;

        WoundRules.UpdateConsciousness(Character);
        await OnConditionsChanged.InvokeAsync();
    }

    private static int GetPercentage(AttributeWithMaxValue attr)
    {
        if (attr.MaxValue <= 0)
            return 100;
        return Math.Clamp((int)((double)attr.Value / attr.MaxValue * 100), 0, 100);
    }

    private static string GetBarColor(string colorClass, int percentage) => colorClass switch
    {
        "red" => percentage <= 25 ? "bg-red-600" : percentage <= 50 ? "bg-yellow-500" : "bg-red-500",
        "blue" => "bg-blue-500",
        "purple" => percentage <= 25 ? "bg-red-600" : percentage <= 50 ? "bg-yellow-500" : "bg-purple-500",
        "green" => "bg-green-500",
        _ => "bg-gray-400"
    };

    private static string GetInputClass(string colorClass, int percentage)
    {
        const string baseClass = "cm-input-sm";
        if ((colorClass is "red" or "purple") && percentage <= 25)
            return $"{baseClass} !border-red-400 !bg-red-50 !text-red-700 font-semibold";
        if ((colorClass is "red" or "purple") && percentage <= 50)
            return $"{baseClass} !border-yellow-400 !bg-yellow-50 !text-yellow-700 font-medium";
        return baseClass;
    }
}
