@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Components.Features.Skills.Model
@using CampaignManager.Web.Components.Features.Skills.Services
@inject SkillService SkillService
<div class="border border-gray-200 rounded-md">
    <div class="bg-primary-50 border-l-4 border-primary-500 px-4 py-2 rounded-t-md">
        <h4 class="text-base font-semibold text-primary-800">@Group.Name</h4>
    </div>
    <div class="p-4">


        <div class="space-y-1.5">
            @{
                // Split skills: ungrouped (no ParentSkillName) vs. specialization groups
                // Exclude parent skills (those that serve as specialization containers in the DB)
                var visibleSkills = Group.Skills
                    .Where(s => !s.SkillModelId.HasValue || !_parentSkillIds.Contains(s.SkillModelId.Value))
                    .ToList();
                var ungrouped = visibleSkills.Where(s => string.IsNullOrEmpty(s.ParentSkillName)).ToList();
                var specGroups = visibleSkills
                    .Where(s => !string.IsNullOrEmpty(s.ParentSkillName))
                    .GroupBy(s => s.ParentSkillName!)
                    .OrderBy(g => g.Key)
                    .ToList();
            }

            @* Ungrouped skills *@
            @foreach (var skill in ungrouped)
            {
                <div @key="skill" class="flex flex-col gap-2 py-1 px-1 -mx-1 rounded hover:bg-gray-50 transition-colors duration-150"
                     data-testid="@($"skill-row-{skill.Name}")">
                    <div class="flex items-center gap-2 flex-grow min-w-0 pr-2">
                        <button type="button" @onclick="@(() => RemoveSkill(skill))"
                                aria-label="@($"Удалить навык {skill.Name}")"
                                class="cm-tap-target w-5 h-5 text-gray-400 hover:text-error-600 transition-colors duration-200">
                            <i class="fas fa-times text-xs" aria-hidden="true"></i>
                        </button>
                        <div class="min-w-0 flex-grow text-sm leading-snug">
                            @SkillName(skill)
                            <span class="text-xs text-gray-400 ml-0.5">(@skill.BaseValue)</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0 w-auto justify-start">
                        @* Мифы Ктулху и Средства не отмечают — им место под галочку не положено (стр. 92) *@
                        @if (DevelopmentPhaseRules.CanBeChecked(skill.Name))
                        {
                            <label class="cm-tap-target">
                                <input type="checkbox"
                                       data-testid="@($"skill-used-{skill.Name}")"
                                       aria-label="@($"{skill.Name} использован")"
                                       checked="@skill.IsUsed" @onchange="@(e => OnSkillUsedChanged(skill, e))"
                                       class="cm-checkbox"/>
                            </label>
                        }
                        else
                        {
                            <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
                        }
                        <div class="flex items-center gap-1">
                            <span class="text-[10px] text-gray-400 font-semibold">О</span>
                            <input type="number"
                                   data-testid="@($"skill-value-{skill.Name}")"
                                   aria-label="@($"{skill.Name} значение обычный")"
                                   value="@skill.Value.Regular"
                                   @onchange="@(e => OnSkillValueChanged(skill, e))"
                                   class="cm-input-sm !w-16"/>
                        </div>
                        <div class="flex items-center gap-1">
                            <span class="text-[10px] text-gray-400 font-semibold">Т</span>
                            <input type="number" value="@skill.Value.Half" disabled class="cm-input-sm !w-16"/>
                        </div>
                        <div class="flex items-center gap-1">
                            <span class="text-[10px] text-gray-400 font-semibold">Ч</span>
                            <input type="number" value="@skill.Value.Fifth" disabled class="cm-input-sm !w-16"/>
                        </div>
                    </div>
                </div>
            }

            @* Specialization groups *@
            @foreach (var specGroup in specGroups)
            {
                var allInGroup = specGroup.ToList();
                var modifiedSpecs = allInGroup.Where(IsSkillModified).ToList();
                var unmodifiedSpecs = allInGroup.Where(s => !IsSkillModified(s)).ToList();

                @* Modified specializations rendered as regular skill rows *@
                @foreach (var skill in modifiedSpecs)
                {
                    <div @key="skill" class="flex flex-col gap-2 py-1 px-1 -mx-1 rounded hover:bg-gray-50 transition-colors duration-150"
                         data-testid="@($"skill-row-{skill.Name}")">
                        <div class="flex items-center gap-2 flex-grow min-w-0 pr-2">
                            <button type="button" @onclick="@(() => RemoveSkill(skill))"
                                    aria-label="@($"Удалить навык {skill.Name}")"
                                    class="cm-tap-target w-5 h-5 text-gray-400 hover:text-error-600 transition-colors duration-200">
                                <i class="fas fa-times text-xs" aria-hidden="true"></i>
                            </button>
                            <div class="min-w-0 flex-grow text-sm leading-snug">
                                @SkillName(skill)
                                <span class="text-xs text-gray-400 ml-0.5">(@skill.BaseValue)</span>
                                @{ var specBonus = SpecializationRules.BonusFor(skill, allInGroup, specGroup.Key); }
                                @if (specBonus > 0)
                                {
                                    <span class="spec-bonus-badge"
                                          title="Смежная специализация перешла порог — этот навык поднимается на @specBonus (но не выше самого порога)">+@specBonus</span>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0 w-auto justify-start">
                            @if (DevelopmentPhaseRules.CanBeChecked(skill.Name))
                            {
                                <label class="cm-tap-target">
                                    <input type="checkbox"
                                           data-testid="@($"skill-used-{skill.Name}")"
                                           aria-label="@($"{skill.Name} использован")"
                                           checked="@skill.IsUsed"
                                           @onchange="@(e => OnSkillUsedChanged(skill, e))"
                                           class="cm-checkbox" />
                                </label>
                            }
                            else
                            {
                                <span class="w-4 flex-shrink-0" aria-hidden="true"></span>
                            }
                            <div class="flex items-center gap-1">
                                <span class="text-[10px] text-gray-400 font-semibold">О</span>
                                <input type="number"
                                       data-testid="@($"skill-value-{skill.Name}")"
                                       aria-label="@($"{skill.Name} значение обычный")"
                                       value="@skill.Value.Regular"
                                       @onchange="@(e => OnSkillValueChanged(skill, e))"
                                       class="cm-input-sm !w-16" />
                            </div>
                            <div class="flex items-center gap-1">
                                <span class="text-[10px] text-gray-400 font-semibold">Т</span>
                                <input type="number" value="@skill.Value.Half" disabled class="cm-input-sm !w-16" />
                            </div>
                            <div class="flex items-center gap-1">
                                <span class="text-[10px] text-gray-400 font-semibold">Ч</span>
                                <input type="number" value="@skill.Value.Fifth" disabled class="cm-input-sm !w-16" />
                            </div>
                        </div>
                    </div>
                }

                @* Unmodified specializations in collapsible group *@
                @if (unmodifiedSpecs.Any())
                {
                    <SpecializationGroup ParentSkillName="@specGroup.Key"
                                         Skills="@unmodifiedSpecs"
                                         AllGroupSkills="@allInGroup"
                                         OnRemove="EventCallback.Factory.Create<Skill>(this, RemoveSkill)"
                                         OnValueChanged="EventCallback.Factory.Create<SpecializationGroup.SkillChangeArgs>(this, OnSpecValueChanged)"
                                         OnUsedChanged="EventCallback.Factory.Create<SpecializationGroup.SkillChangeArgs>(this, OnSpecUsedChanged)"
                                         OnCheckRequested="@OnCheckRequested" />
                }
            }
        </div>

        @* Добавление навыка. Кнопка «+» живёт в ручном вводе SkillPicker: из справочника навык
           добавляется выбором строки, и «+» рядом с поиском раньше просто ничего не делал. *@
        <div class="mt-3 pt-3 border-t border-gray-200 flex flex-wrap items-center gap-2">
            <SkillPicker CategoryFilter="@GroupCategory"
                         OnSkillSelected="OnPickerSkillSelected" />
        </div>
    </div>
</div>

@code {
    [Parameter] public required SkillGroup Group { get; set; }

    /// <summary>Значение навыка отредактировали — лист может пересчитать зависящее от него.</summary>
    [Parameter] public EventCallback<Skill> OnSkillValueEdited { get; set; }

    /// <summary>
    ///     Проверка навыка — странице открыть диалог (Checks/SkillCheckModal). Своей кнопки в строке
    ///     у неё нет, чтобы строки оставались плотными: проверка — кнопка в справке по тапу на имя
    ///     (SkillInfoPopover), а у навыка вне справочника справки нет, и тап по имени сразу проверяет.
    /// </summary>
    [Parameter] public EventCallback<Skill> OnCheckRequested { get; set; }

    private RenderFragment SkillName(Skill skill) => __builder =>
    {
        if (skill.SkillModelId.HasValue)
        {
            <SkillInfoPopover SkillName="@skill.Name" SkillModelId="@skill.SkillModelId.Value" Value="@skill.Value.Regular"
                              OnCheck="@CheckCallback(skill)" />
        }
        else if (OnCheckRequested.HasDelegate)
        {
            <button type="button"
                    class="cm-tap-target font-medium text-primary-600 hover:text-primary-800 hover:underline"
                    aria-label="@($"Проверка: {skill.Name}")"
                    data-testid="@($"skill-check-{skill.Name}")"
                    @onclick="() => OnCheckRequested.InvokeAsync(skill)">@skill.Name</button>
        }
        else
        {
            <span class="font-medium break-normal">@skill.Name</span>
        }
    };

    private EventCallback CheckCallback(Skill skill) =>
        OnCheckRequested.HasDelegate
            ? EventCallback.Factory.Create(this, () => OnCheckRequested.InvokeAsync(skill))
            : default;

    private static readonly Dictionary<string, SkillCategory> GroupToCategory = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Решение Проблем"] = SkillCategory.ProblemSolving,
        ["Социальные"] = SkillCategory.Social,
        ["Сбор Информации"] = SkillCategory.InformationGathering,
        ["Лечение"] = SkillCategory.Healing,
        ["Знания"] = SkillCategory.Knowledge,
        ["Специальные"] = SkillCategory.Special,
        ["Сражение (общее)"] = SkillCategory.CombatGeneral,
        ["Сражение (Огнестрельное)"] = SkillCategory.CombatFirearms,
        ["Действия"] = SkillCategory.Actions,
    };

    private SkillCategory? GroupCategory =>
        GroupToCategory.TryGetValue(Group.Name, out var cat) ? cat : null;

    private void OnPickerSkillSelected(SkillPicker.NewSkillInfo info)
    {
        Group.Skills.Add(new Skill
        {
            Name = info.Name,
            BaseValue = info.BaseValue,
            Value = new AttributeValue(0),
            SkillModelId = info.SkillModelId,
            ParentSkillName = info.ParentSkillName
        });
    }

    private void RemoveSkill(Skill skill)
    {
        Group.RemoveSkill(skill);
    }

    private void OnSkillUsedChanged(Skill skill, ChangeEventArgs args)
    {
        if (args.Value is bool newValue)
        {
            skill.IsUsed = newValue;
        }
    }

    private async Task OnSkillValueChanged(Skill skill, ChangeEventArgs args)
    {
        if (args.Value is null || !int.TryParse(args.Value.ToString(), out var newValue))
            return;

        skill.Value.Regular = newValue;
        skill.Value.UpdateDerived();

        // Уклонение дублируется в боевых параметрах листа — странице нужно узнать о правке.
        await OnSkillValueEdited.InvokeAsync(skill);
    }

    private Task OnSpecValueChanged(SpecializationGroup.SkillChangeArgs args) =>
        OnSkillValueChanged(args.Skill, args.Args);

    private void OnSpecUsedChanged(SpecializationGroup.SkillChangeArgs args) =>
        OnSkillUsedChanged(args.Skill, args.Args);

    private Dictionary<Guid, int> _skillBaseValues = [];
    private HashSet<Guid> _parentSkillIds = [];

    protected override async Task OnInitializedAsync()
    {
        var skills = await SkillService.GetAllSkillsUnpagedAsync();
        _skillBaseValues = skills.ToDictionary(s => s.Id, s => s.BaseValue);
        _parentSkillIds = skills
            .Where(s => s.ParentSkillId.HasValue)
            .Select(s => s.ParentSkillId!.Value)
            .ToHashSet();
    }

    private bool IsSkillModified(Skill skill)
    {
        if (skill.SkillModelId.HasValue && _skillBaseValues.TryGetValue(skill.SkillModelId.Value, out var baseNum))
            return skill.Value.Regular != baseNum;
        return false;
    }


}