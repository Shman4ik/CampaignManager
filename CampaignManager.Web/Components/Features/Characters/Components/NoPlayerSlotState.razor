@* Вместо листа сыщика, которому некуда лечь. Лист игрока создаётся только на место игрока в
   кампании (CharacterService.CreateCharacterAsync), а сюда попадают по адресу без кампании
   (/character/wizard, /character/create/что-угодно) или по кампании, где у вошедшего места нет.
   Раньше страница давала заполнить такой лист и сохраняла его ничьим — он пропадал из всех
   списков, а читать его мог любой. *@

<EmptyState IconClass="fa-user-slash"
            Title="Лист сыщика заводится в кампании"
            Message="@Message">
    <ActionButton>
        <a href="/" class="cm-btn cm-btn-primary"><i class="fa-solid fa-house"></i><span>К кампаниям</span></a>
        @if (IsKeeper)
        {
            <a href="/character/create/pregen" class="cm-btn cm-btn-secondary"><i class="fa-solid fa-user-plus"></i><span>Новый преген</span></a>
        }
    </ActionButton>
</EmptyState>

@code {
    /// <summary>Хранителю предлагаем преген: лист без игрока — это и есть заготовка.</summary>
    [Parameter] public bool IsKeeper { get; set; }

    private string Message => IsKeeper
        ? "Здесь не выбрана кампания или у вас нет в ней места игрока. Сыщика игрок создаёт из карточки своей кампании на главной, а лист без игрока заводится как преген."
        : "Здесь не выбрана кампания или у вас нет в ней места игрока. Вступите в кампанию на главной и нажмите «Создать сыщика» в её карточке.";
}
