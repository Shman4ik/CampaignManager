@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services

<div class="sanity-panel">
    @{
        var maxSan = SanityRules.ComputeMaxSanity(Character);
        var current = Math.Clamp(Character.DerivedAttributes.Sanity.Value, 0, maxSan);
        if (current != Character.DerivedAttributes.Sanity.Value)
        {
            Character.DerivedAttributes.Sanity.Value = current;
        }
        if (Character.DerivedAttributes.Sanity.MaxValue != maxSan)
        {
            Character.DerivedAttributes.Sanity.MaxValue = maxSan;
        }
        var pct = maxSan > 0 ? Math.Clamp((int)((double)current / maxSan * 100), 0, 100) : 0;
        var barColor = pct <= 25 ? "bg-red-600" : pct <= 50 ? "bg-yellow-500" : "bg-purple-500";
        var mythos = SanityRules.GetMythosValue(Character);
        var indefThreshold = SanityRules.IndefiniteInsanityThreshold(current);
        var dayLoss = Character.State.SanityLossEpisode;
        var lastLoss = Character.State.LastSanityLoss;
        // Два разных правила с разными окнами: ИНТ — по одной причине, бессрочное — за игровой день.
        var triggersTemp = lastLoss >= SanityRules.TemporaryInsanityThreshold;
        var triggersIndef = dayLoss >= indefThreshold && dayLoss > 0;
        var permanentlyInsane = SanityRules.IsPermanentlyInsane(Character);
        var insane = Character.State.HasTemporaryInsanity || Character.State.HasIndefiniteInsanity;
        var activeConditions = Character.InsanityConditions.Count(c => c.Active);
    }

    @if (permanentlyInsane)
    {
        <Alert Type="error" Icon="fa-skull" ShowIcon Small>
            Рассудок упал до нуля — сыщик <strong>неизлечимо безумен</strong> и выбывает из игры (стр. 153).
        </Alert>
    }

    <!-- Текущий / Максимум -->
    <div class="mb-3">
        <div class="flex items-baseline justify-between mb-1">
            <span class="text-sm font-semibold text-gray-700">Рассудок</span>
            <span class="text-sm text-gray-600">
                <span class="font-bold text-purple-700">@current</span>
                <span class="text-gray-400">/ @maxSan</span>
                <span class="text-xs text-gray-400 ml-1">(99 − Мифы Ктулху @mythos)</span>
            </span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden">
            <div class="@barColor h-2.5 transition-all duration-300" style="width: @(pct)%"></div>
        </div>
    </div>

    <!-- Ручное изменение -->
    <div class="flex flex-wrap items-center gap-1.5 mb-3">
        <div class="flex items-center rounded-md border border-gray-300 overflow-hidden">
            <button type="button"
                    class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 border-r border-gray-300 text-sm transition-colors"
                    @onclick="ApplyManualLoss" title="Отнять">
                <i class="fa-solid fa-minus"></i>
            </button>
            <input type="number" min="1" max="99"
                   class="w-12 text-center text-sm py-1 focus:outline-none"
                   @bind="_manualAmount" @bind:event="oninput" />
            <button type="button"
                    class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 border-l border-gray-300 text-sm transition-colors"
                    @onclick="ApplyManualHeal" title="Прибавить">
                <i class="fa-solid fa-plus"></i>
            </button>
        </div>
        <span class="text-xs text-gray-400">кубики:</span>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => ApplyLoss(RollDice(1, 3))">−1d3</button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => ApplyLoss(RollDice(1, 4))">−1d4</button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => ApplyLoss(RollDice(1, 6))">−1d6</button>
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="() => ApplyLoss(RollDice(1, 10))">−1d10</button>
    </div>

    <!-- Потери: по одной причине и за игровой день -->
    <div class="mb-4 p-3 bg-gray-50 rounded-md border border-gray-200">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <span class="text-xs font-semibold text-gray-600 uppercase">Потери рассудка</span>
            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="ResetDay">
                <i class="fa-solid fa-rotate-left mr-1"></i>Новый день
            </button>
        </div>
        <div class="text-sm text-gray-700">
            За игровой день: <span class="font-bold text-gray-900">@dayLoss</span>
            <span class="text-xs text-gray-500">(порог бессрочного: @indefThreshold)</span>
        </div>
        <div class="text-sm text-gray-700">
            От последней причины: <span class="font-bold text-gray-900">@lastLoss</span>
            <span class="text-xs text-gray-500">(порог проверки ИНТ: @SanityRules.TemporaryInsanityThreshold)</span>
        </div>
        @if (triggersTemp)
        {
            <div class="mt-2 px-2 py-1 bg-purple-50 border border-purple-200 rounded text-xs text-purple-800">
                <div>
                    ⚠ Потеряно @lastLoss пунктов по одной причине — пройдите проверку <strong>ИНТ</strong>:
                    при успехе сыщик впадает во временное безумие (1d10 часов).
                </div>
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm mt-1.5" @onclick="ClearLastLoss">
                    Проверка пройдена
                </button>
            </div>
        }
        @if (triggersIndef)
        {
            <Alert Type="error" ShowIcon Small class="mt-2 !mb-0">
                Потеряно ≥1/5 от текущего Рассудка за игровой день — <strong>бессрочное безумие</strong>.
            </Alert>
        }
    </div>

    <!-- Состояние безумия -->
    <div class="mb-4 grid grid-cols-1 sm:grid-cols-2 gap-2">
        <label class="flex items-start gap-2 p-2 rounded-md border border-gray-200 cursor-pointer hover:bg-gray-50">
            <input type="checkbox" class="mt-0.5 w-3.5 h-3.5 accent-purple-600"
                   checked="@Character.State.HasTemporaryInsanity"
                   @onchange="@(e => ToggleTemporary(e.Value is true))" />
            <div>
                <div class="text-xs font-semibold text-gray-700">Временное безумие</div>
                @if (Character.State.HasTemporaryInsanity && Character.State.TemporaryInsanityStartedAt.HasValue)
                {
                    <div class="text-[10px] text-gray-500">с @Character.State.TemporaryInsanityStartedAt.Value.ToLocalTime().ToString("g")</div>
                }
            </div>
        </label>
        <label class="flex items-start gap-2 p-2 rounded-md border border-gray-200 cursor-pointer hover:bg-gray-50">
            <input type="checkbox" class="mt-0.5 w-3.5 h-3.5 accent-purple-700"
                   checked="@Character.State.HasIndefiniteInsanity"
                   @onchange="@(e => ToggleIndefinite(e.Value is true))" />
            <div>
                <div class="text-xs font-semibold text-gray-700">Бессрочное безумие</div>
                @if (Character.State.HasIndefiniteInsanity && Character.State.IndefiniteInsanityStartedAt.HasValue)
                {
                    <div class="text-[10px] text-gray-500">с @Character.State.IndefiniteInsanityStartedAt.Value.ToLocalTime().ToString("g")</div>
                }
            </div>
        </label>
    </div>

    <!-- Безумие от Мифов: счётчик и начисление навыка -->
    <div class="mb-4">
        <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="text-gray-700">Случаев безумия от Мифов:</span>
            <span class="font-bold text-gray-900">@Character.State.MythosInsanityCount</span>
            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="RecordMythosInsanity">
                <i class="fa-solid fa-plus mr-1"></i>Записать (+@NextMythosGain к Мифам)
            </button>
            @if (Character.State.MythosInsanityCount > 0)
            {
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" @onclick="UndoMythosInsanity"
                        title="Ошиблись — откатить последний случай">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            }
        </div>
        <p class="text-xs text-gray-500 mt-1">
            Первый случай даёт +5 к навыку «Мифы Ктулху», каждый следующий +1 (стр. 160–161);
            максимум Рассудка падает вместе с этим.
        </p>
    </div>

    <!-- Привыкание к ужасному: пределы потери по видам тварей из бестиария -->
    <div class="mb-4">
        <MythosHabituationPanel Character="@Character" OnSanityLoss="@ApplyLoss" />
    </div>

    <!-- Фобии и мании -->
    <section data-testid="insanity-conditions">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h6 class="cm-section-title">Фобии и мании</h6>
            <div class="flex flex-wrap gap-2">
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="add-phobia"
                        @onclick="() => OpenCondition(InsanityConditionKind.Phobia)">
                    <i class="fa-solid fa-plus mr-1"></i>Фобия
                </button>
                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="add-mania"
                        @onclick="() => OpenCondition(InsanityConditionKind.Mania)">
                    <i class="fa-solid fa-plus mr-1"></i>Мания
                </button>
            </div>
        </div>

        @if (Character.InsanityConditions.Count == 0)
        {
            <div class="text-xs text-primary-400 italic">Нет записей</div>
        }
        else
        {
            <div>
                @foreach (var c in Character.InsanityConditions.OrderByDescending(x => x.Active).ThenBy(x => x.AcquiredAt))
                {
                    <div @key="c.Id" class="flex flex-wrap items-center gap-x-3 gap-y-2 py-2 border-t border-t-gray-200 first:border-t-0 @(c.Active ? "" : "opacity-60")">
                        <Badge Variant="@(c.Kind == InsanityConditionKind.Phobia ? "error" : "warning")" Size="sm">
                            @(c.Kind == InsanityConditionKind.Phobia ? "Фобия" : "Мания")
                        </Badge>
                        <div class="flex-1 min-w-[10rem]">
                            <div class="text-sm font-semibold text-primary-900 @(c.Active ? "" : "line-through")">@c.Name</div>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="text-xs text-primary-600">@c.Description</div>
                            }
                            <div class="text-xs text-primary-400">
                                @c.AcquiredAt.ToLocalTime().ToString("d")@(c.Active ? "" : " · вылечено")
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm"
                                    @onclick="() => c.Active = !c.Active">
                                <i class="fa-solid @(c.Active ? "fa-check" : "fa-rotate-left") mr-1"></i>@(c.Active ? "Вылечено" : "Вернуть")
                            </button>
                            <button type="button" class="cm-btn cm-btn-outline-error cm-btn-sm"
                                    @onclick="() => Character.InsanityConditions.Remove(c)">
                                <i class="fa-solid fa-trash mr-1"></i>Удалить
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (activeConditions > 0)
        {
            <ul class="cm-field-note list-disc pl-4 mt-2 space-y-1">
                @if (insane)
                {
                    <li>
                        Пока сыщик безумен: рядом объект фобии — всё, кроме боя и бегства, со штрафной костью
                        (не для проверок Рассудка и на реальность); объект мании — штрафная кость ко всем броскам,
                        пока сыщик не утолит влечение или не уйдёт от него (стр. 157).
                    </li>
                }
                <li>
                    Лечение (стр. 165): раз в месяц игрового времени психоаналитик проходит проверку Психоанализа,
                    при успехе сыщик — проверку Рассудка; оба успеха снимают фобию или манию. Крах в любой из
                    проверок — −1d6 рассудка. Успешный Психоанализ помогает и на время справиться с приступом
                    фобии (стр. 160).
                </li>
            </ul>
        }
    </section>
</div>

<AddInsanityConditionModal Character="@Character"
                           IsVisible="@_conditionOpen"
                           Kind="@_conditionKind"
                           OnClose="CloseCondition"
                           OnAdded="CloseCondition" />

@code {
    [Parameter] public required Character Character { get; set; }

    private int _manualAmount = 1;
    private bool _conditionOpen;
    private InsanityConditionKind _conditionKind = InsanityConditionKind.Phobia;

    private static int RollDice(int count, int sides) => Dice.Roll(count, sides);

    private void ApplyManualLoss() => ApplyLoss(Math.Max(1, _manualAmount));
    private void ApplyManualHeal() => ApplyHeal(Math.Max(1, _manualAmount));

    /// <summary>
    ///     Одно нажатие — одна причина: и бросок кубика, и ручная сумма считаются единой потерей.
    /// </summary>
    private void ApplyLoss(int amount)
    {
        var maxSan = SanityRules.ComputeMaxSanity(Character);
        var current = Math.Clamp(Character.DerivedAttributes.Sanity.Value, 0, maxSan);
        var newVal = Math.Max(0, current - amount);
        var actualLoss = current - newVal;
        Character.DerivedAttributes.Sanity.Value = newVal;
        Character.State.SanityLossEpisode += actualLoss;
        Character.State.LastSanityLoss = actualLoss;
    }

    private void ApplyHeal(int amount)
    {
        var maxSan = SanityRules.ComputeMaxSanity(Character);
        Character.DerivedAttributes.Sanity.Value = Math.Min(maxSan, Character.DerivedAttributes.Sanity.Value + amount);
    }

    private void ResetDay()
    {
        Character.State.SanityLossEpisode = 0;
        Character.State.LastSanityLoss = 0;
    }

    private void ClearLastLoss() => Character.State.LastSanityLoss = 0;

    private int NextMythosGain => Character.State.MythosInsanityCount == 0 ? 5 : 1;

    private void RecordMythosInsanity() => SanityRules.RecordMythosInsanity(Character);

    /// <summary>Откат случайного нажатия: снимаем ровно ту прибавку, которую дал последний случай.</summary>
    private void UndoMythosInsanity()
    {
        if (Character.State.MythosInsanityCount == 0)
            return;

        var gain = Character.State.MythosInsanityCount == 1 ? 5 : 1;
        Character.State.MythosInsanityCount--;

        var mythos = Character.Skills.SkillGroups
            .SelectMany(g => g.Skills)
            .FirstOrDefault(s => s.Name == "Мифы Ктулху");

        if (mythos is not null)
        {
            mythos.Value.Regular = Math.Max(0, mythos.Value.Regular - gain);
            mythos.Value.UpdateDerived();
        }

        Character.DerivedAttributes.Sanity.MaxValue = SanityRules.ComputeMaxSanity(Character);
    }

    private void ToggleTemporary(bool v)
    {
        Character.State.HasTemporaryInsanity = v;
        Character.State.TemporaryInsanityStartedAt = v ? DateTime.UtcNow : null;
    }

    private void ToggleIndefinite(bool v)
    {
        Character.State.HasIndefiniteInsanity = v;
        Character.State.IndefiniteInsanityStartedAt = v ? DateTime.UtcNow : null;
    }

    private void OpenCondition(InsanityConditionKind kind)
    {
        _conditionKind = kind;
        _conditionOpen = true;
    }

    private void CloseCondition() => _conditionOpen = false;
}
