@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services

@* Приступ безумия (стр. 154–157). Таблицы VII/VIII лежат в InsanityTables, запись на лист
   делает SanityRules.RecordBout — здесь только разметка. Любой бросок можно не бросать,
   а вписать: номер строки нажимают в таблице, длительность вводят в поле.
   MaxHeight: Modal собирает класс высоты интерполяцией, а Tailwind генерирует только классы,
   записанные в разметке целиком (умолчание 70vh в сборку не попадает вовсе). Поэтому он
   назван здесь полностью — max-h-[60vh] — и тело длинного диалога прокручивается под шапкой,
   а «Записать приступ» в подвале всегда на экране. *@

<Modal IsVisible="@IsVisible" OnClose="@OnClose" Title="Приступ безумия" MaxWidth="3xl" MaxHeight="60vh">
    <ChildContent>
        <div class="cm-stack">
            <section>
                <h4 class="cm-section-title mb-2">Как разыграть</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <button type="button" class="bout-mode @(_mode == InsanityBoutMode.RealTime ? "bout-mode-active" : "")"
                            aria-pressed="@(_mode == InsanityBoutMode.RealTime ? "true" : "false")"
                            data-testid="bout-mode-realtime"
                            @onclick="() => SelectMode(InsanityBoutMode.RealTime)">
                        <span class="bout-mode-title"><i class="fa-solid fa-hourglass-half mr-1.5"></i>В реальном времени</span>
                        <span class="bout-mode-hint">Таблица VII. Рядом другие сыщики, идёт сцена или бой — приступ длится 1d10 раундов.</span>
                    </button>
                    <button type="button" class="bout-mode @(_mode == InsanityBoutMode.Summary ? "bout-mode-active" : "")"
                            aria-pressed="@(_mode == InsanityBoutMode.Summary ? "true" : "false")"
                            data-testid="bout-mode-summary"
                            @onclick="() => SelectMode(InsanityBoutMode.Summary)">
                        <span class="bout-mode-title"><i class="fa-solid fa-forward mr-1.5"></i>Сводка</span>
                        <span class="bout-mode-hint">Таблица VIII. Сыщик один или обезумели все — время проматывается, обычно на 1d10 часов.</span>
                    </button>
                </div>
            </section>

            <section>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                    <h4 class="cm-section-title">
                        Таблица @InsanityTables.TableNumeral(_mode) · 1d10 · стр. @InsanityTables.TablePage(_mode)
                    </h4>
                    <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="bout-roll"
                            @onclick="RollBout">
                        <i class="fa-solid fa-dice mr-1"></i>Бросить 1d10
                    </button>
                </div>
                <p class="cm-field-note mb-2">
                    Бросили настоящую кость или Хранитель выбирает сам — нажмите строку с этим номером.
                </p>
                <div class="bout-options" data-testid="bout-options">
                    @foreach (var option in InsanityTables.Bouts(_mode))
                    {
                        <button type="button" @key="option.Number"
                                class="bout-option @(option.Number == _roll ? "bout-option-active" : "")"
                                aria-pressed="@(option.Number == _roll ? "true" : "false")"
                                data-testid="@($"bout-option-{option.Number}")"
                                @onclick="() => SelectRoll(option.Number)">
                            <span class="bout-option-number">@option.Number</span>
                            <span class="bout-option-title">@option.Title</span>
                        </button>
                    }
                </div>
            </section>

            @if (Entry is { } entry)
            {
                <section data-testid="bout-result">
                    <div class="flex items-baseline gap-2 mb-2">
                        <span class="bout-result-number">@entry.Number</span>
                        <h4 class="cm-h6 !mb-0">@entry.Title</h4>
                        <span class="cm-field-note !mt-0">табл. @InsanityTables.TableNumeral(_mode)</span>
                    </div>

                    <p class="bout-read-aloud" data-testid="bout-read-aloud">@entry.ReadAloud</p>
                    <p class="cm-text-muted text-sm mt-2">@entry.KeeperNote</p>

                    <div class="flex flex-wrap items-end gap-3 mt-3">
                        <div>
                            <span class="cm-field-label">Длительность: 1d10 @InsanityTables.DurationUnit(_mode)</span>
                            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="bout-duration-roll"
                                    @onclick="RollDuration">
                                <i class="fa-solid fa-dice mr-1"></i>Бросить 1d10
                            </button>
                        </div>
                        <div class="w-24">
                            <label for="bout-duration" class="cm-field-label">Выпало</label>
                            <input id="bout-duration" type="number" min="1" max="99" class="cm-input"
                                   data-testid="bout-duration"
                                   value="@_duration" @onchange="SetDuration"/>
                        </div>
                        @if (_duration is { } duration)
                        {
                            <span class="text-sm font-semibold text-primary-800 mb-2" data-testid="bout-duration-text">
                                Приступ длится @InsanityTables.DurationText(_mode, duration).
                            </span>
                        }
                    </div>
                    @if (_mode == InsanityBoutMode.Summary)
                    {
                        <p class="cm-field-note mt-1">
                            Сколько сыщик пробыл не в себе, в сводке решает Хранитель — 1d10 часов лишь обычный срок.
                        </p>
                    }

                    @if (entry.Acquires is { } kind)
                    {
                        <div class="mt-3">
                            <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" data-testid="bout-acquire"
                                    @onclick="() => AcquireAsync(kind)">
                                <i class="fa-solid fa-plus mr-1"></i>
                                @(kind == InsanityConditionKind.Phobia ? "Записать приступ и выбрать фобию" : "Записать приступ и выбрать манию")
                                (табл. @InsanityTables.TableNumeral(kind))
                            </button>
                        </div>
                    }
                </section>
            }

            <section>
                <ul class="bout-rules">
                    <li>Пока длится приступ, сыщиком управляет Хранитель, а рассудок он не теряет: новые ужасы не замечает или списывает на бред (стр. 154).</li>
                    <li>Хранитель может изменить или дописать один пункт биографии — черту, идеал, значимого человека, фобию (стр. 154).</li>
                    <li>Затем — затаённое безумие: игрок снова управляет сыщиком, но любая потеря рассудка, даже в 1 пункт, вызывает новый приступ (стр. 156).</li>
                    @if (_mode == InsanityBoutMode.Summary)
                    {
                        <li>В сводке сыщик обычно покидает место, где его накрыло. Кто мог заметить его уход, получает шанс вмешаться — тогда игрок доигрывает сцену сам (стр. 156).</li>
                    }
                </ul>
            </section>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="cm-btn cm-btn-secondary" @onclick="OnClose">Закрыть</button>
        <button type="button" class="cm-btn cm-btn-primary" data-testid="bout-record"
                disabled="@(Entry is null)" @onclick="RecordAsync">
            <i class="fa-solid fa-check mr-1"></i>Записать приступ
        </button>
    </FooterContent>
</Modal>

@code {
    [Parameter] [EditorRequired] public required Character Character { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Приступ записан на лист — родитель закрывает диалог и перерисовывает панель.</summary>
    [Parameter] public EventCallback OnRecorded { get; set; }

    /// <summary>Строка дала фобию или манию: приступ уже записан, родитель открывает диалог таблицы IX/X.</summary>
    [Parameter] public EventCallback<InsanityConditionKind> OnAcquire { get; set; }

    private InsanityBoutMode _mode = InsanityBoutMode.RealTime;
    private int? _roll;
    private int? _duration;
    private bool _wasVisible;

    private InsanityTables.BoutEntry? Entry => _roll is { } roll ? InsanityTables.FindBout(_mode, roll) : null;

    protected override void OnParametersSet()
    {
        // Диалог не размонтируется, а прячется: без сброса прошлый приступ встретил бы
        // Хранителя при следующем открытии и выглядел бы как новый бросок.
        if (IsVisible && !_wasVisible)
        {
            _mode = InsanityBoutMode.RealTime;
            _roll = null;
            _duration = null;
        }

        _wasVisible = IsVisible;
    }

    private void SelectMode(InsanityBoutMode mode)
    {
        if (_mode == mode)
            return;

        // Номер строки у двух таблиц значит разное, а длительность — разные единицы.
        _mode = mode;
        _roll = null;
        _duration = null;
    }

    private void SelectRoll(int roll) => _roll = roll;

    private void RollBout() => _roll = Dice.Roll(1, InsanityTables.BoutDie);

    private void RollDuration() => _duration = Dice.Roll(1, InsanityTables.BoutDurationDie);

    private void SetDuration(ChangeEventArgs args) =>
        _duration = int.TryParse(args.Value?.ToString(), out var value) && value > 0 ? value : null;

    private async Task RecordAsync()
    {
        if (_roll is not { } roll || Entry is null)
            return;

        SanityRules.RecordBout(Character, _mode, roll, _duration);
        await OnRecorded.InvokeAsync();
    }

    private async Task AcquireAsync(InsanityConditionKind kind)
    {
        if (_roll is not { } roll)
            return;

        SanityRules.RecordBout(Character, _mode, roll, _duration);
        await OnAcquire.InvokeAsync(kind);
    }
}
