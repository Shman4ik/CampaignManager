@page "/occupations"
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Services
@using CampaignManager.Web.Extensions
@attribute [Authorize]

@inject OccupationService OccupationService
@inject ILogger<OccupationsPage> Logger
@rendermode InteractiveServer
<PageTitle>Профессии</PageTitle>

<PageHeader Title="Профессии">
    <Actions>
        <Button Variant="secondary" Size="sm" Icon="fa-book" OnClick="() => _showSyncModal = true">
            Синхронизировать с правилами
        </Button>
        <Button Variant="primary" Size="sm" Icon="fa-plus" OnClick="OpenAddModal">Добавить</Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel Title="Фильтры" @bind-IsExpanded="_isFilterVisible" OnReset="ClearFilters">
        <ChildContent>
            <div class="flex flex-col sm:flex-row gap-2">
                <div class="flex-grow">
                    <label for="searchQuery" class="cm-field-label">Поиск</label>
                    <div class="relative">
                        <input type="text" id="searchQuery"
                               class="cm-input w-full cm-input-icon-left"
                               placeholder="Поиск по названию..." @bind="_searchTerm" @bind:event="oninput" />
                        <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400 text-xs"></i>
                        </div>
                    </div>
                </div>
                <div class="w-full sm:w-56">
                    <label for="formulaFilter" class="cm-field-label">Формула очков</label>
                    <select id="formulaFilter"
                            class="cm-input w-full"
                            @bind="_selectedFormula">
                        <option value="">Все формулы</option>
                        @foreach (var formula in EnumExtensions.GetEnumTypes<OccupationSkillPointFormula>())
                        {
                            <option value="@formula">@formula.ToRussianString()</option>
                        }
                    </select>
                </div>
            </div>
        </ChildContent>
    </FilterPanel>

    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (FilteredOccupations.Count == 0)
    {
        <EmptyState IconClass="fa-briefcase"
                    Title="Профессии не найдены"
                    Message="@(!string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_selectedFormula) ? "Нет профессий, соответствующих критериям поиска." : "В базе данных нет профессий.")">
            <ActionButton>
                @if (!string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_selectedFormula))
                {
                    <button type="button" class="cm-btn cm-btn-secondary" @onclick="ClearFilters">
                        <span>Очистить фильтры</span>
                    </button>
                }
            </ActionButton>
        </EmptyState>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var occ in FilteredOccupations)
            {
                <div class="cm-card hover:shadow-md transition-shadow">
                    <div class="cm-card-header">
                        <span class="cm-card-title truncate">@occ.Name</span>
                        <div class="flex gap-1 flex-shrink-0">
                            <Button Variant="outline-primary" Size="sm" Icon="fa-edit" OnClick="() => OpenEditModal(occ)">Изменить</Button>
                            <Button Variant="outline-error" Size="sm" Icon="fa-trash-alt" OnClick="() => ConfirmDelete(occ)">Удалить</Button>
                        </div>
                    </div>
                    <div class="cm-card-body">
                        <div class="space-y-1.5 text-sm">
                            <div class="flex items-center gap-2">
                                <span class="text-gray-500 w-24 flex-shrink-0">Формула:</span>
                                <span class="font-medium text-accent-700">@occ.SkillPointFormula.ToRussianString()</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-gray-500 w-24 flex-shrink-0">Средства:</span>
                                <span class="font-medium">@occ.CreditRatingMin–@occ.CreditRatingMax%</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-gray-500 w-24 flex-shrink-0">Слоты:</span>
                                <span class="font-medium">своб. @occ.FreeSkillSlots · соц. @occ.SocialSkillSlots</span>
                            </div>
                            @{
                                var count = OccupationSkillResolver.ProfessionalSkillCount(occ);
                                var matchesBook = count == OccupationSkillResolver.RequiredSkillCount;
                            }
                            <div class="flex items-center gap-2">
                                <span class="text-gray-500 w-24 flex-shrink-0">Проф. навыков:</span>
                                <span class="font-medium @(matchesBook ? "text-success-700" : "text-warning-700")">
                                    @count / @OccupationSkillResolver.RequiredSkillCount
                                    @if (!matchesBook)
                                    {
                                        <span> — расходится с книгой</span>
                                    }
                                </span>
                            </div>
                            <div>
                                <span class="text-gray-500 text-xs">Навыки:</span>
                                <div class="flex flex-wrap gap-1 mt-1">
                                    @foreach (var skill in occ.OccupationSkills)
                                    {
                                        <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-primary-100 text-primary-700">@skill</span>
                                    }
                                    @foreach (var choice in occ.SkillChoices)
                                    {
                                        <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-accent-100 text-accent-700">
                                            @choice.Count из: @string.Join(" / ", choice.Options)
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add/Edit Modal -->
<Modal IsVisible="@_showModal" OnClose="CloseModal" Title="@(_editingOccupation is null ? "Новая профессия" : "Редактирование профессии")" MaxWidth="2xl">
    <ChildContent>
    <EditForm Model="_formModel" OnValidSubmit="SaveOccupation">
        <DataAnnotationsValidator />
        <div class="space-y-4">
            <div>
                <label class="cm-field-label">Название</label>
                <InputText @bind-Value="_formModel.Name" class="cm-input" placeholder="Название профессии" />
                <ValidationMessage For="() => _formModel.Name" class="text-red-500 text-xs mt-1" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="cm-field-label">Формула очков</label>
                    <InputSelect @bind-Value="_formModel.SkillPointFormula"
                                 class="cm-input">
                        @foreach (var f in EnumExtensions.GetEnumTypes<OccupationSkillPointFormula>())
                        {
                            <option value="@f">@f.ToRussianString()</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label class="cm-field-label">Средства мин.</label>
                    <InputNumber @bind-Value="_formModel.CreditRatingMin" class="cm-input" />
                </div>
                <div>
                    <label class="cm-field-label">Средства макс.</label>
                    <InputNumber @bind-Value="_formModel.CreditRatingMax" class="cm-input" />
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="cm-field-label">Свободные слоты навыков</label>
                    <InputNumber @bind-Value="_formModel.FreeSkillSlots" class="cm-input w-24" />
                </div>
                <div>
                    <label class="cm-field-label">Социальные слоты</label>
                    <InputNumber @bind-Value="_formModel.SocialSkillSlots" class="cm-input w-24" />
                    <p class="text-xs text-gray-400 mt-1">Запугивание, Красноречие, Обаяние или Убеждение.</p>
                </div>
            </div>
            <div>
                <label class="cm-field-label">Навыки профессии (по одному в строке)</label>
                <InputTextArea @bind-Value="_formModel.SkillsText" class="cm-input font-mono text-sm" rows="8"
                               placeholder="Оценка&#10;История&#10;Работа в библиотеке&#10;Средства" />
                <p class="text-xs text-gray-400 mt-1">
                    Имя пишется ровно как в справочнике навыков — «Язык, иностранный», а не «Языки (иностр.)»;
                    иначе слот не найдёт навык. В именах есть запятые, поэтому разделитель — перевод строки.
                </p>
            </div>
            <div>
                <label class="cm-field-label">Выбор из списка (по одной строке: «N: навык | навык | навык»)</label>
                <InputTextArea @bind-Value="_formModel.ChoicesText" class="cm-input font-mono text-sm" rows="3"
                               placeholder="1: Лазание | Плавание&#10;2: Язык, иностранный | Механика | Первая помощь" />
                <p class="text-xs text-gray-400 mt-1">
                    «Лазание либо Плавание», «любые два из…», «четыре специализации следующих навыков…».
                    Если вариант — навык с широким спектром (Ближний бой, Стрельба), игрок выберет его специализацию.
                </p>
            </div>
            <p class="cm-field-note">
                Профессиональных навыков по книге ровно @OccupationSkillResolver.RequiredSkillCount плюс Средства.
                Сейчас получается <strong>@FormSkillCount</strong>.
            </p>
        </div>
    </EditForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="cm-btn cm-btn-secondary" @onclick="CloseModal">Отмена</button>
        <button type="button" class="cm-btn cm-btn-success" @onclick="SaveOccupation">
            @(_editingOccupation is null ? "Создать" : "Сохранить")
        </button>
    </FooterContent>
</Modal>

<ConfirmationModal IsVisible="@_showSyncModal"
                   OnConfirm="SyncWithRulebook"
                   OnCancel="() => _showSyncModal = false"
                   Title="Синхронизация с книгой правил"
                   Message="Справочник будет приведён к списку «Примеры занятий» из «Зова Ктулху» 7e."
                   ConfirmText="Синхронизировать"
                   CancelText="Отмена">
    <DetailsContent>
        <ul class="text-gray-700 text-sm list-disc pl-5 space-y-1">
            <li>Книжные профессии перезапишутся: навыки, слоты, формула очков и Средства.</li>
            <li>Ваши правки книжных профессий при этом пропадут.</li>
            <li>Профессии, которых в книге нет, останутся нетронутыми — ничего не удаляется.</li>
        </ul>
    </DetailsContent>
</ConfirmationModal>

<ConfirmationModal IsVisible="@_showDeleteModal"
                   OnConfirm="DeleteOccupation"
                   OnCancel="() => _showDeleteModal = false"
                   Title="Подтверждение удаления"
                   Message="Вы уверены, что хотите удалить эту профессию? Это действие нельзя отменить."
                   ConfirmText="Удалить"
                   CancelText="Отмена">
    <DetailsContent>
        <p class="text-gray-700 text-base">
            <span class="font-semibold text-gray-900">Название:</span> @(_occupationToDelete?.Name)
        </p>
    </DetailsContent>
</ConfirmationModal>

@if (!string.IsNullOrEmpty(_notification))
{
    <div class="fixed bottom-4 right-4 z-50">
        <NotificationAlert Type="@_notificationType" Message="@_notification" OnClose="() => _notification = null" />
    </div>
}

@code {
    private List<Occupation> _occupations = [];
    private bool _loading = true;
    private string _searchTerm = "";
    private string _selectedFormula = "";
    private bool _isFilterVisible = true;

    // Modal state
    private bool _showModal;
    private Occupation? _editingOccupation;
    private OccupationFormModel _formModel = new();

    // Delete state
    private bool _showDeleteModal;
    private Occupation? _occupationToDelete;

    // Sync state
    private bool _showSyncModal;
    private bool _syncing;

    // Notification
    private string? _notification;
    private string _notificationType = "success";

    private List<Occupation> FilteredOccupations
    {
        get
        {
            var query = _occupations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                query = query.Where(o => o.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_selectedFormula) && Enum.TryParse<OccupationSkillPointFormula>(_selectedFormula, out var formula))
                query = query.Where(o => o.SkillPointFormula == formula);

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _occupations = await OccupationService.GetAllOccupationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading occupations");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _selectedFormula = "";
    }

    private void OpenAddModal()
    {
        _editingOccupation = null;
        _formModel = new OccupationFormModel();
        _showModal = true;
    }

    private void OpenEditModal(Occupation occ)
    {
        _editingOccupation = occ;
        _formModel = new OccupationFormModel
        {
            Name = occ.Name,
            SkillPointFormula = occ.SkillPointFormula,
            CreditRatingMin = occ.CreditRatingMin,
            CreditRatingMax = occ.CreditRatingMax,
            FreeSkillSlots = occ.FreeSkillSlots,
            SocialSkillSlots = occ.SocialSkillSlots,
            SkillsText = string.Join(Environment.NewLine, occ.OccupationSkills),
            ChoicesText = string.Join(Environment.NewLine,
                occ.SkillChoices.Select(c => $"{c.Count}: {string.Join(" | ", c.Options)}"))
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingOccupation = null;
    }

    private async Task SaveOccupation()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Name))
            return;

        var skills = SplitLines(_formModel.SkillsText);
        var choices = ParseChoices(_formModel.ChoicesText);

        try
        {
            if (_editingOccupation is not null)
            {
                _editingOccupation.Name = _formModel.Name.Trim();
                _editingOccupation.SkillPointFormula = _formModel.SkillPointFormula;
                _editingOccupation.CreditRatingMin = _formModel.CreditRatingMin;
                _editingOccupation.CreditRatingMax = _formModel.CreditRatingMax;
                _editingOccupation.FreeSkillSlots = _formModel.FreeSkillSlots;
                _editingOccupation.SocialSkillSlots = _formModel.SocialSkillSlots;
                _editingOccupation.OccupationSkills = skills;
                _editingOccupation.SkillChoices = choices;
                _editingOccupation.LastUpdated = DateTimeOffset.UtcNow;

                var success = await OccupationService.UpdateAsync(_editingOccupation);
                ShowNotification(success ? "Профессия обновлена" : "Ошибка при обновлении", success ? "success" : "error");
            }
            else
            {
                var occupation = new Occupation
                {
                    Name = _formModel.Name.Trim(),
                    SkillPointFormula = _formModel.SkillPointFormula,
                    CreditRatingMin = _formModel.CreditRatingMin,
                    CreditRatingMax = _formModel.CreditRatingMax,
                    FreeSkillSlots = _formModel.FreeSkillSlots,
                    SocialSkillSlots = _formModel.SocialSkillSlots,
                    OccupationSkills = skills,
                    SkillChoices = choices
                };

                var result = await OccupationService.CreateAsync(occupation);
                ShowNotification(result is not null ? "Профессия создана" : "Ошибка (возможно, дубль имени)",
                    result is not null ? "success" : "error");
            }

            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving occupation");
            ShowNotification("Ошибка при сохранении", "error");
        }
    }

    private void ConfirmDelete(Occupation occ)
    {
        _occupationToDelete = occ;
        _showDeleteModal = true;
    }

    private async Task DeleteOccupation()
    {
        if (_occupationToDelete is null) return;

        try
        {
            var success = await OccupationService.DeleteAsync(_occupationToDelete.Id);
            ShowNotification(success ? "Профессия удалена" : "Ошибка при удалении", success ? "success" : "error");
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting occupation {Id}", _occupationToDelete.Id);
            ShowNotification("Ошибка при удалении", "error");
        }
        finally
        {
            _showDeleteModal = false;
            _occupationToDelete = null;
        }
    }

    private void ShowNotification(string message, string type)
    {
        _notification = message;
        _notificationType = type;
    }

    /// <summary>
    ///     Имена навыков содержат запятые («Язык, иностранный»), поэтому разделитель здесь —
    ///     перевод строки, а в списке вариантов — вертикальная черта.
    /// </summary>
    private static List<string> SplitLines(string? text) =>
        text?.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.Trim('\r').Trim())
            .Where(line => line.Length > 0)
            .ToList() ?? [];

    private static List<OccupationSkillChoice> ParseChoices(string? text)
    {
        List<OccupationSkillChoice> choices = [];

        foreach (var line in SplitLines(text))
        {
            var separator = line.IndexOf(':');
            if (separator <= 0 || !int.TryParse(line[..separator].Trim(), out var count) || count <= 0)
                continue;

            var options = line[(separator + 1)..]
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            if (options.Count > 0)
                choices.Add(new OccupationSkillChoice { Count = count, Options = options });
        }

        return choices;
    }

    /// <summary>Сколько профессиональных навыков получится у того, что сейчас набрано в форме.</summary>
    private int FormSkillCount
    {
        get
        {
            var preview = new Occupation
            {
                Name = _formModel.Name,
                OccupationSkills = SplitLines(_formModel.SkillsText),
                SkillChoices = ParseChoices(_formModel.ChoicesText),
                FreeSkillSlots = _formModel.FreeSkillSlots,
                SocialSkillSlots = _formModel.SocialSkillSlots
            };

            return OccupationSkillResolver.ProfessionalSkillCount(preview);
        }
    }

    private async Task SyncWithRulebook()
    {
        _showSyncModal = false;
        if (_syncing) return;

        try
        {
            _syncing = true;
            var result = await OccupationService.SyncWithRulebookAsync();

            if (result.Failed)
            {
                ShowNotification("Не удалось синхронизировать справочник", "error");
                return;
            }

            await LoadData();
            ShowNotification(
                $"Синхронизировано с книгой: добавлено {result.Added}, обновлено {result.Updated}, " +
                $"без изменений {result.Unchanged}, своих не тронуто {result.Untouched}",
                "success");
        }
        finally
        {
            _syncing = false;
        }
    }

    private sealed class OccupationFormModel
    {
        [Required(ErrorMessage = "Введите название")]
        [StringLength(100)]
        public string Name { get; set; } = "";

        public OccupationSkillPointFormula SkillPointFormula { get; set; } = OccupationSkillPointFormula.Edu4;
        public int CreditRatingMin { get; set; } = 9;
        public int CreditRatingMax { get; set; } = 50;
        public int FreeSkillSlots { get; set; }
        public int SocialSkillSlots { get; set; }
        public string? SkillsText { get; set; } = "Средства";
        public string? ChoicesText { get; set; }
    }
}
