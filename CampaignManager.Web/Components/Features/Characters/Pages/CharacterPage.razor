@page "/character/create/{CampaignId:guid}"
@page "/character/create/{Kind}"
@page "/character/{CharacterId:guid}"
@using CampaignManager.Web.Components.Features.Characters.Model
@using CampaignManager.Web.Components.Features.Characters.Components
@using CampaignManager.Web.Extensions
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@(Character?.PersonalInfo.Name ?? NewCharacterTitle)</PageTitle>

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <!-- Standard page header with in-page navigation -->
        <PageHeader Title="@(Character?.PersonalInfo.Name ?? NewCharacterTitle)">
            <Actions>
                @if (CurrentKind is not CharacterKind.PlayerCharacter)
                {
                    <Badge Variant="accent" Size="sm" Rounded="full" WithBorder="false">@CurrentKind.ToRussianString()</Badge>
                }
                    <!-- Adaptive in-page navigation -->
                    <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
                        <!-- Mobile dropdown menu (visible on small screens) -->
                        <div class="relative sm:hidden">
                            <button @onclick="ToggleNavMenu" type="button"
                                    class="flex items-center justify-center p-2 text-gray-600 hover:text-blue-700 rounded-md transition-colors">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            @if (_navMenuOpen)
                            {
                                <div
                                    class="absolute right-0 top-full mt-1 bg-white shadow-lg rounded-md overflow-hidden z-20 w-36 py-1">
                                    <button @onclick='()  =>  ScrollToSection("personal")'
                                            class="w-full text-left px-3 py-2 hover:bg-blue-50 text-gray-700 flex items-center">
                                        <i class="fa-solid fa-user w-5 text-blue-500"></i>
                                        <span class="ml-2">Персонаж</span>
                                    </button>
                                    <button @onclick='() =>  ScrollToSection("skills") '
                                            class="w-full text-left px-3 py-2 hover:bg-blue-50 text-gray-700 flex items-center">
                                        <i class="fa-solid fa-graduation-cap w-5 text-blue-500"></i>
                                        <span class="ml-2">Навыки</span>
                                    </button>
                                    <button @onclick='() =>  ScrollToSection("combat")'
                                            class="w-full text-left px-3 py-2 hover:bg-blue-50 text-gray-700 flex items-center">
                                        <i class="fa-solid fa-gun w-5 text-blue-500"></i>
                                        <span class="ml-2">Бой</span>
                                    </button>
                                    <button @onclick='() =>  ScrollToSection("equipment")'
                                            class="w-full text-left px-3 py-2 hover:bg-blue-50 text-gray-700 flex items-center">
                                        <i class="fa-solid fa-suitcase w-5 text-blue-500"></i>
                                        <span class="ml-2">Снаряжение</span>
                                    </button>
                                    <button @onclick='() =>  ScrollToSection("biography")'
                                            class="w-full text-left px-3 py-2 hover:bg-blue-50 text-gray-700 flex items-center">
                                        <i class="fa-solid fa-book w-5 text-blue-500"></i>
                                        <span class="ml-2">Биография</span>
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Desktop navigation (visible on larger screens) -->
                        <div class="hidden sm:flex space-x-0.5 bg-gray-100 rounded-lg p-0.5">
                            <button type="button" @onclick='() => ScrollToSection("personal")'
                                    class="text-gray-600 hover:text-blue-700 hover:bg-white py-1 px-2 text-sm font-medium rounded-md flex items-center transition-colors">
                                <i class="fa-solid fa-user"></i>
                                <span class="ml-1 hidden lg:inline">Персонаж</span>
                            </button>
                            <button type="button" @onclick='() => ScrollToSection("skills")'
                                    class="text-gray-600 hover:text-blue-700 hover:bg-white py-1 px-2 text-sm font-medium rounded-md flex items-center transition-colors">
                                <i class="fa-solid fa-graduation-cap"></i>
                                <span class="ml-1 hidden lg:inline">Навыки</span>
                            </button>
                            <button type="button" @onclick='() => ScrollToSection("combat")'
                                    class="text-gray-600 hover:text-blue-700 hover:bg-white py-1 px-2 text-sm font-medium rounded-md flex items-center transition-colors">
                                <i class="fa-solid fa-gun"></i>
                                <span class="ml-1 hidden lg:inline">Бой</span>
                            </button>
                            <button type="button" @onclick='() => ScrollToSection("equipment")'
                                    class="text-gray-600 hover:text-blue-700 hover:bg-white py-1 px-2 text-sm font-medium rounded-md flex items-center transition-colors">
                                <i class="fa-solid fa-suitcase"></i>
                                <span class="ml-1 hidden lg:inline">Снаряжение</span>
                            </button>
                            <button type="button" @onclick='() => ScrollToSection("biography")'
                                    class="text-gray-600 hover:text-blue-700 hover:bg-white py-1 px-2 text-sm font-medium rounded-md flex items-center transition-colors">
                                <i class="fa-solid fa-book"></i>
                                <span class="ml-1 hidden lg:inline">Биография</span>
                            </button>
                        </div>

                        <div class="flex gap-1 sm:gap-2 ml-2">
                            <button type="button" class="cm-btn cm-btn-primary cm-btn-sm" data-testid="save-character-btn" aria-label="Сохранить персонажа" @onclick="SaveCharacterAsync"><i class="fa-regular fa-floppy-disk"></i></button>
                            @if (CharacterId == null || CharacterId == Guid.Empty)
                            {
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm" data-testid="generate-character-btn" @onclick="OpenGenerateModal">
                                    <span class="hidden sm:inline">Случайный</span>
                                    <i class="fa-solid fa-dice sm:hidden"></i>
                                </button>
                            }
                        </div>
                    </div>
            </Actions>
        </PageHeader>

        <!-- Main content area -->
        <div class="cm-page">
            @if (!string.IsNullOrEmpty(_notification.Message))
            {
                <NotificationAlert Type="@_notification.Type" Message="@_notification.Message"
                                   OnClose="ClearNotification"/>
            }

            @* Куда попадёт новый НПС — спрашиваем здесь, а не отдельным диалогом после создания *@
            @if (ShowOwnerPicker)
            {
                <div class="cm-card mb-4">
                    <div class="cm-card-body flex flex-wrap items-end gap-3">
                        <div>
                            <label for="npcOwner" class="block text-xs text-gray-600 mb-1">Кому принадлежит НПС</label>
                            <select id="npcOwner" class="cm-input min-w-[220px]" @bind="_ownerCampaignId">
                                <option value="">Общая библиотека</option>
                                @foreach (var campaign in _keeperCampaigns)
                                {
                                    <option value="@campaign.Id">@campaign.Name</option>
                                }
                            </select>
                        </div>
                        @if (ScenarioId is not null)
                        {
                            <p class="text-xs text-gray-500 pb-2">
                                После сохранения НПС сразу появится в сценарии.
                            </p>
                        }
                    </div>
                </div>
            }

            @if (_isLoading)
            {
                <div class="flex justify-center p-12">
                    <LoadingIndicator/>
                </div>
            }
            else if (Character != null)
            {
                <EditForm Model="Character" FormName="CharacterForm">
                    <DataAnnotationsValidator/>

                    <CharacterSection Id="personal" Title="Личные данные" Icon="fa-user"
                                      Expanded='@(_sectionVisibility["personal"])'
                                      OnToggle='() => ToggleSectionVisibility("personal")'>
                        <TitleSuffix>
                            @if (CharacterStorageDto != null)
                            {
                                <CharacterStatusChanger CharacterId="@CharacterStorageDto.Id" CurrentStatus="@CharacterStorageDto.Status"
                                                        OnStatusUpdated="@HandleStatusUpdate"/>
                            }
                        </TitleSuffix>
                        <ChildContent>
                            <UnifiedPersonalInfoCard Character="@Character"
                                                     CharacterStorageDto="@CharacterStorageDto"
                                                     OnStatusUpdated="@HandleStatusUpdate"
                                                     OnCharacteristicUpdate="@UpdateCharacteristic"
                                                     OnDerivedChanged="@RecalculateDerivedAttributes"/>
                        </ChildContent>
                    </CharacterSection>

                    <CharacterSection Id="skills" Title="Навыки" Icon="fa-graduation-cap"
                                      Expanded='@(_sectionVisibility["skills"])'
                                      OnToggle='() => ToggleSectionVisibility("skills")'>
                        <TitleSuffix>
                            <button type="button" class="cm-btn cm-btn-primary cm-btn-sm text-xs leading-tight" @onclick="OpenDevelopmentPhase">
                                <i class="fa-solid fa-dice mr-1"></i><span>Фаза развития</span>
                            </button>
                            <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm text-xs leading-tight" @onclick="ResetUsedSkills">
                                <span>Сбросить</span>
                            </button>
                        </TitleSuffix>
                        <ChildContent>
                            <!-- Поле поиска навыков -->
                            <div class="mb-4">
                                <div class="relative">
                                    <input type="text"
                                           id="skill-search"
                                           data-testid="skill-search-input"
                                           aria-label="Поиск навыков"
                                           @bind="_skillSearchQuery"
                                           @bind:event="oninput"
                                           placeholder="Поиск навыков..."
                                           class="cm-input !pl-10" />
                                    <i class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                                    @if (!string.IsNullOrWhiteSpace(_skillSearchQuery))
                                    {
                                        <button @onclick="ClearSkillSearch"
                                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            @{
                                var filteredGroups = GetFilteredSkillGroups();
                            }

                            @if (!filteredGroups.Any())
                            {
                                <div class="text-center py-8 text-gray-500">
                                    <i class="fa-solid fa-search text-3xl mb-2"></i>
                                    <p>Навыки не найдены</p>
                                </div>
                            }
                            else
                            {
                                <!-- CSS columns layout — true masonry, renders each component once -->
                                <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
                                    @foreach (var group in filteredGroups)
                                    {
                                        <div class="break-inside-avoid mb-4">
                                            <SkillGroupCard Group="@group" OnSkillValueEdited="@HandleSkillValueEdited"/>
                                        </div>
                                    }
                                </div>
                            }
                        </ChildContent>
                    </CharacterSection>

                    <CharacterSection Id="combat" Title="Оружие и заклинания" Icon="fa-gun" BodyClass="p-4 cm-stack"
                                      Expanded='@(_sectionVisibility["combat"])'
                                      OnToggle='() => ToggleSectionVisibility("combat")'>
                        <WeaponComponent Character="@Character"/>
                        <SpellComponent Character="@Character"/>
                    </CharacterSection>

                    <CharacterSection Id="equipment" Title="Снаряжение и финансы" Icon="fa-suitcase" BodyClass="p-4 cm-stack"
                                      Expanded='@(_sectionVisibility["equipment"])'
                                      OnToggle='() => ToggleSectionVisibility("equipment")'>
                        <EquipmentComponent Character="@Character"/>
                        <FinancesComponent Character="@Character"/>
                    </CharacterSection>

                    <CharacterSection Id="sanity" Title="Рассудок и безумие" Icon="fa-brain"
                                      Expanded='@(_sectionVisibility.GetValueOrDefault("sanity", true))'
                                      OnToggle='() => ToggleSectionVisibility("sanity")'>
                        <SanityPanel Character="@Character"/>
                    </CharacterSection>

                    <CharacterSection Id="biography" Title="Биография и заметки" Icon="fa-book"
                                      Expanded='@(_sectionVisibility["biography"])'
                                      OnToggle='() => ToggleSectionVisibility("biography")'>
                        <BiographyComponent Character="@Character"/>
                    </CharacterSection>
                </EditForm>

                <GenerateCharacterModal IsVisible="@_showGenerateModal"
                                        OnClose="CloseGenerateModal"
                                        OnGenerate="HandleGenerate" />

                <DevelopmentPhaseModal Character="@Character"
                                       IsVisible="@_showDevelopmentPhase"
                                       IsModern="@IsModernEra"
                                       OnClose="CloseDevelopmentPhase"
                                       OnFinished="HandleDevelopmentPhaseFinished" />

                @* Лог генерации персонажа *@
                @if (_generationLog is not null)
                {
                    <CharacterSection Id="generation-log" Title="Лог генерации" Icon="fa-scroll"
                                      Gradient="from-amber-600 to-amber-700"
                                      BodyClass="p-4 max-h-[600px] overflow-y-auto"
                                      Expanded="@_showGenerationLog" OnToggle="ToggleGenerationLog">
                        <TitleSuffix>
                            <span class="text-white/60 text-xs">(@_generationLog.Entries.Count записей)</span>
                        </TitleSuffix>
                        <HeaderActions>
                            <button type="button" @onclick="ClearGenerationLog"
                                    class="text-white/70 hover:text-white text-xs px-2 py-1 rounded border border-white/30 hover:border-white/60 transition-colors">
                                <i class="fa-solid fa-xmark mr-1"></i>Закрыть
                            </button>
                        </HeaderActions>
                        <ChildContent>
                            @{ var categories = _generationLog.Entries.Select(e => e.Category).Distinct().ToList(); }
                            @foreach (var category in categories)
                            {
                                <div class="mb-4">
                                    <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wide border-b border-gray-200 pb-1 mb-2">
                                        @category
                                    </h4>
                                    <div class="space-y-1">
                                        @foreach (var entry in _generationLog.Entries.Where(e => e.Category == category))
                                        {
                                            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-sm py-0.5 @(entry.Description.StartsWith("---") ? "mt-2" : "")">
                                                @if (entry.Description.StartsWith("---"))
                                                {
                                                    <span class="font-semibold text-gray-600 text-xs uppercase">@entry.Description.Trim('-', ' ')</span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-700 font-medium min-w-[160px]">@entry.Description</span>
                                                    @if (entry.DiceRoll is not null)
                                                    {
                                                        <code class="text-xs bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded font-mono">@entry.DiceRoll</code>
                                                    }
                                                    @if (entry.Result.HasValue)
                                                    {
                                                        <span class="font-bold text-emerald-700">= @entry.Result</span>
                                                    }
                                                    @if (entry.Details is not null)
                                                    {
                                                        <span class="text-gray-400 text-xs">@entry.Details</span>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </ChildContent>
                    </CharacterSection>
                }
            }
            else
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md">
                    <p class="cm-text-body">Не удалось загрузить или инициализировать данные персонажа.</p>
                </div>
            }
        </div>
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger">
            <p class="cm-text-body">Произошла ошибка при загрузке страницы. Пожалуйста, обновите страницу или попробуйте
                позже.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>

