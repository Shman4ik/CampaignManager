@page "/books"
@using CampaignManager.Web.Components.Features.Books.Components
@using CampaignManager.Web.Components.Features.Books.Model
@using CampaignManager.Web.Components.Features.Books.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Components.Shared.Model
@using CampaignManager.Web.Extensions
@using CampaignManager.Web.Utilities.Services
@attribute [Authorize]
@inject BookService BookService
@inject IdentityService IdentityService
@inject ILogger<BooksPage> Logger
@rendermode InteractiveServer

<PageTitle>Книги - Campaign Manager</PageTitle>

<PageHeader Title="Книги">
    <Actions>
        @if (canEdit)
        {
            <Button Variant="primary" Size="sm" Icon="fa-plus" OnClick="ShowAddModal">Добавить</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel Title="Фильтры" @bind-IsExpanded="isSearchPanelVisible" OnReset="ResetFilters">
        <ChildContent>
            <BooksFilterControls
                SearchQuery="@searchQuery"
                SearchQueryChanged="@((string value) => { searchQuery = value; ApplyFilters(); })"
                SelectedBookTypeFilter="@selectedBookTypeFilter"
                SelectedBookTypeFilterChanged="@((BookType? value) => { selectedBookTypeFilter = value; ApplyFilters(); })"
                SelectedLanguageFilter="@selectedLanguageFilter"
                SelectedLanguageFilterChanged="@((string? value) => { selectedLanguageFilter = value; ApplyFilters(); })"
                Languages="@Languages"
                OnFiltersChanged="ApplyFilters" />
        </ChildContent>
    </FilterPanel>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <Alert Type="error" Title="Ошибка">
            @errorMessage
        </Alert>
    }

    @{ var pageItems = catalog.PageItems; }
    @if (pageItems.Count == 0)
    {
        @if (canEdit)
        {
            <EmptyState
                Title="Книги не найдены"
                Message="Попробуйте изменить параметры фильтра или добавить новую книгу."
                IconClass="fa-book">
                <ActionButton>
                    <Button Variant="primary" Icon="fa-plus" OnClick="ShowAddModal">Добавить книгу</Button>
                </ActionButton>
            </EmptyState>
        }
        else
        {
            @* Справочник правят только Хранитель и администратор — игроку «добавить» не предлагаем. *@
            <EmptyState
                Title="Книги не найдены"
                Message="Попробуйте изменить параметры фильтра."
                IconClass="fa-book" />
        }
    }
    else
    {
        <BooksListView
            Books="@pageItems"
            ExpandedBookId="@catalog.ExpandedId"
            ShowType="@showType"
            ShowMythos="@showMythos"
            ShowOccultism="@showOccultism"
            CanEdit="@canEdit"
            CurrentSortField="@catalog.SortField"
            SortAscending="@catalog.SortAscending"
            OnSortChanged="catalog.ToggleSort"
            OnEdit="ShowEditModal"
            OnDelete="ShowDeleteModal"
            OnToggleExpand="catalog.ToggleExpanded" />

        <Pagination
            CurrentPage="@catalog.CurrentPage"
            TotalPages="@catalog.TotalPages"
            TotalItems="@catalog.TotalItems"
            ItemsPerPage="@catalog.PageSize"
            ItemsLabel="книг"
            OnPageChanged="catalog.GoToPage" />
    }

    <Modal IsVisible="@showModal"
           OnClose="HideModal"
           Title="@(isEditMode ? "Редактировать книгу" : "Добавить книгу")"
           MaxWidth="4xl"
           HeaderColorScheme="primary">
        <ChildContent>
            @if (!string.IsNullOrEmpty(modalErrorMessage))
            {
                <Alert Type="error" ShowIcon>
                    @modalErrorMessage
                </Alert>
            }
            <BookFormFields
                Book="@editBook"
                OnValidSubmit="HandleValidSubmit"
                FormId="book-edit-form" />
        </ChildContent>
        <FooterContent>
            <button type="button"
                    class="cm-btn cm-btn-secondary"
                    @onclick="HideModal">
                Отмена
            </button>
            <button type="submit" form="book-edit-form"
                    class="cm-btn cm-btn-primary">
                Сохранить
            </button>
        </FooterContent>
    </Modal>

    <ConfirmationModal
        IsVisible="@showDeleteModal"
        OnConfirm="ConfirmDelete"
        OnCancel="HideDeleteModal"
        Title="Подтверждение удаления"
        Message="Вы уверены, что хотите удалить эту книгу?"
        ConfirmText="Удалить"
        CancelText="Отмена"
        IconType="warning">
        <DetailsContent>
            <p class="text-gray-700 text-base">
                <span class="font-semibold text-gray-900">Название:</span> @(deleteBook?.Name)
            </p>
            <p class="text-gray-700 text-base">
                <span class="font-semibold text-gray-900">Категория:</span> @(deleteBook?.BookType.ToRussianString())
            </p>
        </DetailsContent>
    </ConfirmationModal>
</div>

@code {
    // 25 позиций на страницу: плотная строка занимает одну строку текста, и на экране
    // iPad их помещается столько же, сколько раньше помещалось шесть блочных.
    private const int booksPerPage = 25;

    // Страница, сортировка и раскрытая строка — общие у всех каталогов; здесь только фильтры.
    // Сортировка есть только у тех колонок, что остались в строке: категория и год
    // уехали из неё — категорию задаёт фильтр, год живёт в раскрытии.
    private readonly CatalogListState<Book> catalog;

    public BooksPage()
    {
        catalog = new CatalogListState<Book>(
            booksPerPage,
            FilterBooks,
            CatalogSort.By((Book b) => b.Name),
            new Dictionary<string, CatalogSort<Book>>
            {
                [nameof(Book.Language)] = CatalogSort.By((Book b) => b.Language),
                [nameof(Book.MythosRating)] = CatalogSort.By((Book b) => b.MythosRating),
                [nameof(Book.Author)] = CatalogSort.By((Book b) => b.Author)
            });
    }

    private bool isSearchPanelVisible = true;
    private bool showModal;
    private bool showDeleteModal;
    private bool isEditMode;

    // Справочник общий для всех кампаний: смотреть может любой вошедший, править — только
    // Хранитель и администратор. Сервис проверяет то же самое сам, здесь — чтобы не показывать
    // игроку кнопки, которые всё равно откажут.
    private bool canEdit;

    private List<Book>? books;
    private string searchQuery = string.Empty;
    private BookType? selectedBookTypeFilter;
    private string? selectedLanguageFilter;

    // Метка категории в строке различает книги, только когда список не сужен до одной
    // категории: при фильтре «Книга Мифов» её несёт каждая строка и она превращается в шум.
    private bool showType => selectedBookTypeFilter is null;

    // Числовые колонки: у книг по оккультизму МКН/МКП/ЗМ пусты всегда, у книг Мифов —
    // «+Оккультизм». Когда фильтр сузил список до одной категории, чужие колонки убираем.
    private bool showMythos => selectedBookTypeFilter != BookType.OccultBook;
    private bool showOccultism => selectedBookTypeFilter != BookType.MythosBook;

    private Book editBook = new() { Name = string.Empty, BookType = BookType.MythosBook };
    private Book? deleteBook;

    private string? errorMessage;
    private string? modalErrorMessage;

    private IEnumerable<string> Languages => books?
        .Where(b => !string.IsNullOrWhiteSpace(b.Language))
        .Select(b => b.Language!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(l => l, StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        canEdit = await IdentityService.IsKeeper();
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        errorMessage = null;
        try
        {
            books = await BookService.GetAllBooksAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading books");
            errorMessage = "Не удалось загрузить список книг. Пожалуйста, попробуйте позже.";
            books = [];
        }

        catalog.ResetPage();
        catalog.CollapseAll();
    }

    private void ApplyFilters()
    {
        catalog.ResetPage();
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedBookTypeFilter = null;
        selectedLanguageFilter = null;
        ApplyFilters();
    }

    private IEnumerable<Book> FilterBooks()
    {
        if (books is null)
            return [];

        IEnumerable<Book> query = books;

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var term = searchQuery.Trim();
            query = query.Where(b =>
                (!string.IsNullOrWhiteSpace(b.Name) && b.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(b.Author) && b.Author.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(b.Description) && b.Description.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                b.AlternativeNames.Any(n => n.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (selectedBookTypeFilter.HasValue)
        {
            query = query.Where(b => b.BookType == selectedBookTypeFilter.Value);
        }

        if (!string.IsNullOrWhiteSpace(selectedLanguageFilter))
        {
            query = query.Where(b => !string.IsNullOrWhiteSpace(b.Language) &&
                                     b.Language.Equals(selectedLanguageFilter, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private void ShowAddModal()
    {
        if (!canEdit) return;

        isEditMode = false;
        editBook = new Book
        {
            Name = string.Empty,
            BookType = BookType.MythosBook,
            Language = null,
            Year = null,
            Author = null,
            SanityLoss = null,
            CthulhuMythosInitial = null,
            CthulhuMythosFull = null,
            MythosRating = null,
            StudyWeeks = null,
            OccultismBonus = null,
            Description = string.Empty,
            AlternativeNames = [],
            PossibleSpells = [],
            ImageUrl = null
        };
        modalErrorMessage = null;
        showModal = true;
    }

    private void ShowEditModal(Book book)
    {
        if (!canEdit) return;

        isEditMode = true;
        // Правим полную копию, а не экземпляр из кэша справочника: новое поле Book попадает
        // в неё само. Списки из jsonb страхуем от null — форма и CleanBook ждут пустой список.
        editBook = EntityCloner.Clone(book);
        editBook.AlternativeNames ??= [];
        editBook.PossibleSpells ??= [];
        modalErrorMessage = null;
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
    }

    private async Task HandleValidSubmit()
    {
        modalErrorMessage = null;
        CleanBook(editBook);

        try
        {
            if (isEditMode)
            {
                var updated = await BookService.UpdateBookAsync(editBook);
                if (!updated)
                {
                    modalErrorMessage = "Не удалось обновить книгу.";
                    return;
                }
            }
            else
            {
                var added = await BookService.AddBookAsync(editBook);
                if (!added)
                {
                    modalErrorMessage = "Не удалось добавить книгу. Возможно, книга с таким названием уже существует.";
                    return;
                }
            }

            showModal = false;
            await LoadBooksAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving book {BookName}", editBook.Name);
            modalErrorMessage = $"Не удалось сохранить книгу: {ex.Message}";
        }
    }

    private static void CleanBook(Book book)
    {
        book.Name = book.Name.Trim();
        book.Language = string.IsNullOrWhiteSpace(book.Language) ? null : book.Language.Trim();
        book.Year = string.IsNullOrWhiteSpace(book.Year) ? null : book.Year.Trim();
        book.Author = string.IsNullOrWhiteSpace(book.Author) ? null : book.Author.Trim();
        book.SanityLoss = string.IsNullOrWhiteSpace(book.SanityLoss) ? null : book.SanityLoss.Trim();
        book.Description = (book.Description ?? string.Empty).Trim();
        book.ImageUrl = string.IsNullOrWhiteSpace(book.ImageUrl) ? null : book.ImageUrl.Trim();
        book.AlternativeNames = book.AlternativeNames
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Select(n => n.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        book.PossibleSpells = book.PossibleSpells
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ShowDeleteModal(Book book)
    {
        if (!canEdit) return;

        deleteBook = book;
        showDeleteModal = true;
    }

    private void HideDeleteModal()
    {
        showDeleteModal = false;
        deleteBook = null;
    }

    private async Task ConfirmDelete()
    {
        if (deleteBook is null) return;

        try
        {
            var deleted = await BookService.DeleteBookAsync(deleteBook.Id);
            if (!deleted)
            {
                errorMessage = "Не удалось удалить книгу.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting book {BookId}", deleteBook.Id);
            errorMessage = $"Не удалось удалить книгу: {ex.Message}";
        }
        finally
        {
            showDeleteModal = false;
            deleteBook = null;
            await LoadBooksAsync();
            ApplyFilters();
        }
    }
}
