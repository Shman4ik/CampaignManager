@using CampaignManager.Web.Components.Features.Books.Model
@using CampaignManager.Web.Components.Features.Books.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Extensions
@namespace CampaignManager.Web.Components.Features.Books.Components

<tr class="@(IsExpanded ? "bk-row-open" : null) cursor-pointer" @onclick="ToggleExpand">
    <td>
        <div class="flex items-center gap-1.5">
            <i class="fas @(IsExpanded ? "fa-caret-down" : "fa-caret-right") w-2 text-center text-primary-300"></i>
            <span class="font-semibold text-gray-900">@Book.Name</span>
            @if (ShowType)
            {
                <Badge Variant="@(Book.BookType == BookType.MythosBook ? "error" : "secondary")" Size="sm" Rounded="md">
                    @BookTypeText.Short(Book.BookType)
                </Badge>
            }
        </div>
    </td>
    <td class="bk-clip text-primary-500">@Dash(Book.Language)</td>
    <td class="bk-clip text-primary-500">@Dash(Book.Author)</td>
    <td class="tabular-nums">@Dash(Book.SanityLoss)</td>
    @if (ShowMythos)
    {
        <td class="tabular-nums">@Plus(Book.CthulhuMythosInitial)</td>
        <td class="tabular-nums">@Plus(Book.CthulhuMythosFull)</td>
        <td class="tabular-nums font-medium text-gray-900">@(Book.MythosRating?.ToString() ?? "—")</td>
    }
    @if (ShowOccultism)
    {
        <td class="tabular-nums">@(Book.OccultismBonus.HasValue ? $"+{Book.OccultismBonus}%" : "—")</td>
    }
    <td @onclick:stopPropagation="true">
        <div class="flex justify-end gap-1">
            <button type="button" aria-label="Изменить: @Book.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary"
                    @onclick="() => OnEdit.InvokeAsync(Book)">
                <i class="fas fa-pen"></i>
            </button>
            <button type="button" aria-label="Удалить: @Book.Name"
                    class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error"
                    @onclick="() => OnDelete.InvokeAsync(Book)">
                <i class="fas fa-trash-alt"></i>
            </button>
        </div>
    </td>
</tr>

@if (IsExpanded)
{
    @* Колонки строки здесь не повторяются — только то, чего в них нет. *@
    <tr class="bk-details">
        <td colspan="@ColumnCount">
            <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-primary-600">
                @if (!ShowType)
                {
                    <div>
                        <span class="bk-label">Категория</span>
                        @Book.BookType.ToRussianString()
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Book.Year))
                {
                    <div>
                        <span class="bk-label">Год / век</span>
                        @Book.Year
                    </div>
                }
                @if (Book.StudyWeeks.HasValue)
                {
                    <div>
                        <span class="bk-label">Полное изучение</span>
                        @Book.StudyWeeks нед.
                    </div>
                }
                @if (Book.AlternativeNames.Count > 0)
                {
                    <div class="basis-full">
                        <span class="bk-label">Другие названия</span>
                        <span class="flex flex-wrap gap-1">
                            @foreach (var altName in Book.AlternativeNames)
                            {
                                <Badge Variant="secondary" Size="sm" Rounded="md">@altName</Badge>
                            }
                        </span>
                    </div>
                }
                @if (Book.PossibleSpells.Count > 0)
                {
                    <div class="basis-full">
                        <span class="bk-label">Возможные заклинания</span>
                        <span class="flex flex-wrap gap-1">
                            @foreach (var spell in Book.PossibleSpells)
                            {
                                <Badge Variant="primary" Size="sm" Rounded="md">@spell</Badge>
                            }
                        </span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Book.Description))
                {
                    <div class="basis-full">
                        <span class="bk-label">Описание</span>
                        <span class="whitespace-pre-wrap">@Book.Description</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Book.ImageUrl))
                {
                    <div class="basis-full">
                        <span class="bk-label">Обложка</span>
                        <img src="@Book.ImageUrl" alt="@Book.Name" class="bk-image" />
                    </div>
                }
                @if (!HasDetails)
                {
                    <div class="text-primary-400">Всё об этой книге уже показано в строке.</div>
                }
            </div>
        </td>
    </tr>
}

@code {
    [Parameter] public Book Book { get; set; } = new() { Name = string.Empty, BookType = BookType.MythosBook };
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>Показывать метку категории: смысл есть, только когда список не сужен до одной категории.</summary>
    [Parameter] public bool ShowType { get; set; }

    /// <summary>Колонки МКН / МКП / ЗМ: у книг по оккультизму они пусты всегда.</summary>
    [Parameter] public bool ShowMythos { get; set; } = true;

    /// <summary>Колонка «+Оккультизм»: у книг Мифов она пуста всегда.</summary>
    [Parameter] public bool ShowOccultism { get; set; } = true;

    [Parameter] public EventCallback<Book> OnEdit { get; set; }
    [Parameter] public EventCallback<Book> OnDelete { get; set; }
    [Parameter] public EventCallback OnToggleExpand { get; set; }

    // Название, язык, автор, рассудок, действия — всегда; остальное по флагам.
    private int ColumnCount => 5 + (ShowMythos ? 3 : 0) + (ShowOccultism ? 1 : 0);

    private bool HasDetails =>
        !ShowType ||
        !string.IsNullOrWhiteSpace(Book.Year) ||
        Book.StudyWeeks.HasValue ||
        Book.AlternativeNames.Count > 0 ||
        Book.PossibleSpells.Count > 0 ||
        !string.IsNullOrWhiteSpace(Book.Description) ||
        !string.IsNullOrWhiteSpace(Book.ImageUrl);

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string Plus(int? value) => value.HasValue ? $"+{value}" : "—";

    private Task ToggleExpand() => OnToggleExpand.InvokeAsync();
}
