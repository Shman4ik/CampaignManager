@using CampaignManager.Web.Components.Features.Books.Model
@using CampaignManager.Web.Components.Features.Books.Services
@using CampaignManager.Web.Components.Shared
@using CampaignManager.Web.Extensions
@namespace CampaignManager.Web.Components.Features.Books.Components

<div class="cm-card overflow-hidden">
    @* Таблица — от xl (1280) и шире; уже — карточки.
       Порог как у каталога оружия: девять колонок в портрет iPad (1024) не помещаются.
       Каждое поле карточки книги — отдельная колонка, поэтому раскрытая строка
       не повторяет их, а показывает только то, чего в колонках нет. *@
    <div class="hidden xl:block overflow-x-auto bk-table">
        <table class="cm-table">
            <thead>
            <tr>
                <SortableTableHeader Title="Название" FieldName="@nameof(Book.Name)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <SortableTableHeader Title="Язык" FieldName="@nameof(Book.Language)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <SortableTableHeader Title="Автор" FieldName="@nameof(Book.Author)"
                                     CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                     OnSortChanged="OnSortChanged" />
                <th>Рассудок</th>
                @if (ShowMythos)
                {
                    <th>МКН</th>
                    <th>МКП</th>
                    <SortableTableHeader Title="ЗМ" FieldName="@nameof(Book.MythosRating)"
                                         CurrentSortField="@CurrentSortField" SortAscending="@SortAscending"
                                         OnSortChanged="OnSortChanged" />
                }
                @if (ShowOccultism)
                {
                    <th>Оккульт.</th>
                }
                <th><span class="sr-only">Действия</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var book in Books)
            {
                <BookTableRow Book="@book"
                              IsExpanded="@(ExpandedBookId == book.Id)"
                              ShowType="@ShowType"
                              ShowMythos="@ShowMythos"
                              ShowOccultism="@ShowOccultism"
                              OnEdit="OnEdit"
                              OnDelete="OnDelete"
                              OnToggleExpand="() => OnToggleExpand.InvokeAsync(book)" />
            }
            </tbody>
        </table>
    </div>

    @* Карточки ниже xl: название, язык и главное число книги в строке, остальное — по раскрытию. *@
    <div class="divide-y divide-primary-100 xl:hidden">
        @foreach (var book in Books)
        {
            <div class="px-3 py-2">
                <div class="flex items-start gap-2">
                    <div class="min-w-0 flex-1 cursor-pointer" @onclick="() => OnToggleExpand.InvokeAsync(book)">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <i class="fas @(ExpandedBookId == book.Id ? "fa-caret-down" : "fa-caret-right") w-2 text-center text-primary-300"></i>
                            <span class="font-semibold text-gray-900">@book.Name</span>
                            @if (ShowType)
                            {
                                <Badge Variant="@(book.BookType == BookType.MythosBook ? "error" : "secondary")" Size="sm" Rounded="md">
                                    @BookTypeText.Short(book.BookType)
                                </Badge>
                            }
                        </div>
                        <div class="ml-4 mt-0.5 flex flex-wrap items-center gap-x-1.5 text-xs text-primary-500">
                            <span>@Dash(book.Language)</span>
                            <span class="text-primary-300">·</span>
                            <span>@Dash(book.Author)</span>
                            @if (!string.IsNullOrWhiteSpace(book.SanityLoss))
                            {
                                <span class="text-primary-300">·</span>
                                <span class="tabular-nums">рассудок @book.SanityLoss</span>
                            }
                            @if (book.MythosRating.HasValue)
                            {
                                <span class="text-primary-300">·</span>
                                <span class="tabular-nums font-medium text-gray-900">ЗМ @book.MythosRating</span>
                            }
                            @if (book.OccultismBonus.HasValue)
                            {
                                <span class="text-primary-300">·</span>
                                <span class="tabular-nums font-medium text-gray-900">оккультизм +@(book.OccultismBonus)%</span>
                            }
                        </div>
                    </div>
                    <button type="button" aria-label="Изменить: @book.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-primary flex-shrink-0"
                            @onclick="() => OnEdit.InvokeAsync(book)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" aria-label="Удалить: @book.Name"
                            class="cm-btn cm-btn-sm cm-btn-icon cm-btn-outline-error flex-shrink-0"
                            @onclick="() => OnDelete.InvokeAsync(book)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>

                @if (ExpandedBookId == book.Id)
                {
                    <dl class="bk-card-details">
                        @if (!ShowType)
                        {
                            <dt>Категория</dt>
                            <dd>@book.BookType.ToRussianString()</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.Year))
                        {
                            <dt>Год / век</dt>
                            <dd>@book.Year</dd>
                        }
                        @if (book.CthulhuMythosInitial.HasValue || book.CthulhuMythosFull.HasValue)
                        {
                            <dt>Мифы Ктулху</dt>
                            <dd>+@(book.CthulhuMythosInitial?.ToString() ?? "—") начальное · +@(book.CthulhuMythosFull?.ToString() ?? "—") полное</dd>
                        }
                        @if (book.StudyWeeks.HasValue)
                        {
                            <dt>Полное изучение</dt>
                            <dd>@book.StudyWeeks нед.</dd>
                        }
                        @if (book.AlternativeNames.Count > 0)
                        {
                            <dt>Другие названия</dt>
                            <dd>
                                <span class="flex flex-wrap gap-1">
                                    @foreach (var altName in book.AlternativeNames)
                                    {
                                        <Badge Variant="secondary" Size="sm" Rounded="md">@altName</Badge>
                                    }
                                </span>
                            </dd>
                        }
                        @if (book.PossibleSpells.Count > 0)
                        {
                            <dt>Заклинания</dt>
                            <dd>
                                <span class="flex flex-wrap gap-1">
                                    @foreach (var spell in book.PossibleSpells)
                                    {
                                        <Badge Variant="primary" Size="sm" Rounded="md">@spell</Badge>
                                    }
                                </span>
                            </dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.Description))
                        {
                            <dt>Описание</dt>
                            <dd class="whitespace-pre-wrap">@book.Description</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.ImageUrl))
                        {
                            <dt>Обложка</dt>
                            <dd><img src="@book.ImageUrl" alt="@book.Name" class="bk-image" /></dd>
                        }
                    </dl>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Book> Books { get; set; } = [];
    [Parameter] public Guid? ExpandedBookId { get; set; }

    /// <summary>Показывать метку категории: смысл есть, только когда список не сужен до одной категории.</summary>
    [Parameter] public bool ShowType { get; set; }

    /// <summary>Колонки МКН / МКП / ЗМ: у книг по оккультизму они пусты всегда.</summary>
    [Parameter] public bool ShowMythos { get; set; } = true;

    /// <summary>Колонка «+Оккультизм»: у книг Мифов она пуста всегда.</summary>
    [Parameter] public bool ShowOccultism { get; set; } = true;

    [Parameter] public string? CurrentSortField { get; set; }
    [Parameter] public bool SortAscending { get; set; } = true;
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    [Parameter] public EventCallback<Book> OnEdit { get; set; }
    [Parameter] public EventCallback<Book> OnDelete { get; set; }
    [Parameter] public EventCallback<Book> OnToggleExpand { get; set; }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
