@namespace CampaignManager.Web.Components.Shared

@* Единственный спиннер приложения. Страницы раньше держали семь своих копий
   (`animate-spin … border-blue-500`) — и сам компонент красил кольцо сырым синим мимо палитры.
   Кольцо — акцент, как фокус полей: это «идёт работа», а не статус. *@
<div class="flex flex-col items-center justify-center gap-3 py-10 text-center" role="status" aria-live="polite">
    <span class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-accent-500 border-r-transparent"
          aria-hidden="true"></span>
    <span class="text-sm text-primary-500">@(string.IsNullOrWhiteSpace(Message) ? "Загрузка…" : Message)</span>
</div>

@code {
    [Parameter] public string? Message { get; set; }
}
