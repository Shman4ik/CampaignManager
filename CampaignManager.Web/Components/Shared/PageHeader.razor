@using CampaignManager.Web.Components.Features.KeeperScreen.Components
@using CampaignManager.Web.Components.Features.Music.Components
<div class="page-topbar">
    <span class="page-topbar-title">@Title</span>
    <div class="flex items-center gap-2 ml-auto">
        @Actions
        @* Панель плеера по умолчанию скрыта — открывает её эта кнопка (только у Хранителя). *@
        <MusicPanelButton/>
        @* Ширма Хранителя — на любой странице; кнопка сама прячется от всех, кроме Хранителя
           и администратора. Режим игры сценария тоже рисует PageHeader, так что кнопка есть и там. *@
        @if (ShowKeeperScreen)
        {
            <KeeperScreenButton/>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Выключается только на самой /reference: открывать ширму поверх ширмы незачем.</summary>
    [Parameter] public bool ShowKeeperScreen { get; set; } = true;
}
