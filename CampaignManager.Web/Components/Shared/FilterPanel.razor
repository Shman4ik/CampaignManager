@namespace CampaignManager.Web.Components.Shared

@* Фильтр — одна строка в карточке: поля, флажки и «Сбросить» в конце. Шапки «Фильтры»
   с кнопкой свернуть больше нет: она съедала полосу высотой с саму строку, а сворачивать
   однострочную панель незачем. Подписей над полями тоже нет — смысл поля несут placeholder,
   aria-label и первый пункт селекта («Все типы»).
   Содержимое — прямые элементы флекс-строки с переносом: страница задаёт им только ширину
   (поиск — flex-1 min-w-[12rem], селект — w-56 shrink-0). Блок, которому нужна своя строка
   (чипы тегов), — w-full order-last, тогда «Сбросить» остаётся в первой.
   Липнет под шапку страницы (top-14 — её 56px), а не к top: 0: под шапкой однострочная
   панель скрылась бы целиком. revealElement в js/app.js учитывает её высоту сам. *@
<div class="sticky top-14 z-10 cm-card mb-4">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3">
        @ChildContent

        @* Кнопка сброса выглядит одинаково на всех страницах с фильтрами,
           поэтому её рисует сама панель — странице достаточно передать OnReset. *@
        @if (OnReset.HasDelegate || ActionButtons is not null)
        {
            <div class="ms-auto flex shrink-0 gap-2">
                @if (OnReset.HasDelegate)
                {
                    <Button Variant="outline-primary" Size="sm" Icon="fa-undo-alt" OnClick="OnReset">Сбросить</Button>
                }
                @ActionButtons
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ActionButtons { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
}
