@namespace CampaignManager.Web.Components.Shared

@* Пустой список. Это обычная карточка дизайн-системы (`cm-card`), а не своя
   `rounded-xl shadow-md`: иначе пустое состояние выглядело на полтона иначе, чем
   соседние карточки каталога. Ставится туда, где стоял бы сам список, — не внутрь
   другой карточки. Кнопки в ActionButton: основное действие (`primary`, «+ Добавить»)
   и, если пусто из-за фильтра, `secondary` «Очистить фильтры» рядом. *@
<div class="cm-card">
    <div class="cm-card-body flex flex-col items-center justify-center px-6 py-10 text-center">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100">
            <i class="fas @IconClass text-2xl text-primary-400" aria-hidden="true"></i>
        </div>
        <h3 class="cm-h6">@Title</h3>
        <p class="cm-text-muted max-w-prose">@Message</p>
        @if (ActionButton is not null)
        {
            <div class="mt-5 flex flex-wrap justify-center gap-2">
                @ActionButton
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Нет данных";
    [Parameter] public string Message { get; set; } = "Данные не найдены";
    [Parameter] public string IconClass { get; set; } = "fa-search";
    [Parameter] public RenderFragment? ActionButton { get; set; }
}
