@using Microsoft.AspNetCore.WebUtilities
@using CampaignManager.Web.Utilities.Services
@using CampaignManager.Web.Components.Layout.Services
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IdentityService IdentityService
@inject NavigationBadgeService NavigationBadges

@* Меню — всегда рельс с подписями, как в iPadOS: под каждой иконкой короткая подпись
   (ShortLabel у SidebarItem). Развернуть его до 240px больше нельзя: на iPad широкое меню
   только отнимало место у страницы, а подписи рельса и так называют каждый пункт.
   Правила — в design-system.css, раздел «Боковое меню». *@
<div class="sidebar">
    <!-- Logo -->
    <div class="sidebar-logo">
        <div class="sidebar-logo-icon sidebar-logo-icon--cthulhu">
            <img src="/logo.svg" width="28" height="28" aria-hidden="true" alt="Campaign Manager logo" />
        </div>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav">
        <div class="sidebar-group sidebar-group--main">
            <SidebarItem Href="/" Icon="fa-house" Label="Главная"/>
            <AuthorizeView>
                <SidebarItem Href="/combat" Icon="fa-hand-fist" Label="Бой"/>
                <SidebarItem Href="/chase" Icon="fa-person-running" Label="Погоня"/>
                <SidebarItem Href="/campaigns" Icon="fa-map" Label="Кампании"/>
            </AuthorizeView>
            <AuthorizeView Policy="RequireKeeper">
                <SidebarItem Href="/scenarios" Icon="fa-masks-theater" Label="Сценарии"/>
                <SidebarItem Href="/npcs" Icon="fa-user-secret" Label="НПС"/>
                <SidebarItem Href="/music" Icon="fa-music" Label="Музыка"/>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <div class="sidebar-group sidebar-group--wiki">
                <SidebarItem Href="/weapons" Icon="fa-gun" Label="Оружие"/>
                <SidebarItem Href="/bestiary" Icon="fa-skull" Label="Существа"/>
                <SidebarItem Href="/items" Icon="fa-box" Label="Предметы"/>
                <SidebarItem Href="/occupations" Icon="fa-user-tie" Label="Профессии"/>
                <SidebarItem Href="/skills" Icon="fa-brain" Label="Навыки"/>
                <SidebarItem Href="/spells" Icon="fa-hat-wizard" Label="Заклинания"/>
                <SidebarItem Href="/books" Icon="fa-book-open" Label="Книги"/>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireAdministratorRole">
            <div class="sidebar-group sidebar-group--system">
                <SidebarItem Href="/admin/users" Icon="fa-users" Label="Пользователи" ShortLabel="Аккаунты"/>
                <SidebarItem Href="/admin/applications" Icon="fa-inbox" Label="Заявки"
                             Badge="@(_pendingCount > 0 ? _pendingCount.ToString() : null)"/>
            </div>
        </AuthorizeView>
    </nav>

    <!-- Footer / Auth -->
    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <!-- User row — вход в личный кабинет -->
                <a href="/profile" class="sidebar-item sidebar-item--footer">
                    <span class="sidebar-icon">
                        <span class="sidebar-avatar">
                            @(context.User.Identity?.Name?.Length > 0 ? char.ToUpper(context.User.Identity.Name[0]) : '?')
                        </span>
                    </span>
                    <span class="sidebar-rail-label">Кабинет</span>
                </a>
                <!-- Logout -->
                <button type="button" class="sidebar-item sidebar-item--footer sidebar-item--button"
                        @onclick="Logout">
                    <span class="sidebar-icon"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></span>
                    <span class="sidebar-rail-label">Выйти</span>
                </button>
            </Authorized>
            <NotAuthorized>
                @if (_checkingAuth)
                {
                    <div class="sidebar-item sidebar-item--footer sidebar-item--muted">
                        <span class="sidebar-icon"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i></span>
                        <span class="sidebar-rail-label">Проверка</span>
                    </div>
                }
                else
                {
                    <button type="button" class="sidebar-item sidebar-item--footer sidebar-item--button"
                            @onclick="ManualLogin">
                        @* Способ входа (Google или почта с паролем) выбирается уже на странице Auth0. *@
                        <span class="sidebar-icon"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i></span>
                        <span class="sidebar-rail-label">Войти</span>
                    </button>
                }
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool _checkingAuth = true;
    private bool _silentLoginFailed;
    private bool _accessDenied;
    private bool _loginFailed;
    private int _pendingCount;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("authStatus", out var s))
        {
            _silentLoginFailed = s == "silentFailed";
            _accessDenied      = s == "accessDenied";
            _loginFailed       = s == "failed";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Clean up authStatus from URL
        if (_silentLoginFailed || _accessDenied || _loginFailed)
        {
            if (_silentLoginFailed)
            {
                try
                {
                    var m = await JS.InvokeAsync<IJSObjectReference>("import", "/js/topbar-auth.js");
                    await m.InvokeVoidAsync("noteSilentFailure");
                }
                catch { }
            }
            Nav.NavigateTo(Nav.Uri.Split('?')[0], replace: true);
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            // Attempt silent login once
            try
            {
                var m = await JS.InvokeAsync<IJSObjectReference>("import", "/js/topbar-auth.js");
                var skip = await m.InvokeAsync<bool>("shouldSkipSilentLogin");
                if (!skip)
                {
                    await m.InvokeVoidAsync("markSilentAttempt");
                    var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
                    var hint = await m.InvokeAsync<string?>("getLoginHint");
                    var loginUrl = $"/api/account/login?mode=silent&returnUrl={Uri.EscapeDataString(returnUrl)}";
                    if (!string.IsNullOrEmpty(hint))
                        loginUrl += $"&loginHint={Uri.EscapeDataString(hint)}";
                    Nav.NavigateTo(loginUrl, true);
                    return;
                }
            }
            catch { }

            _checkingAuth = false;
            StateHasChanged();
            return;
        }

        // Authenticated — load extras. Счётчик заявок и настройки нужны и нижней навигации;
        // оба сервиса отдают ей тот же ответ, так что в базу за ними ходим один раз на circuit.
        _checkingAuth = false;
        var isAdmin = await IdentityService.IsAdministrator();
        if (isAdmin)
            _pendingCount = await NavigationBadges.GetPendingApplicationsCountAsync();

        // Save login hint
        try
        {
            var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            if (!string.IsNullOrEmpty(email))
            {
                var m = await JS.InvokeAsync<IJSObjectReference>("import", "/js/topbar-auth.js");
                await m.InvokeVoidAsync("saveLoginHint", email);
            }
        }
        catch { }

        StateHasChanged();
    }

    private async Task Logout()
    {
        try
        {
            var m = await JS.InvokeAsync<IJSObjectReference>("import", "/js/topbar-auth.js");
            await m.InvokeVoidAsync("setSkipSilentLogin");
            await m.InvokeVoidAsync("clearLoginHint");
        }
        catch { }
        Nav.NavigateTo("api/account/logout", true);
    }

    private async Task ManualLogin()
    {
        try
        {
            var m = await JS.InvokeAsync<IJSObjectReference>("import", "/js/topbar-auth.js");
            await m.InvokeVoidAsync("clearSilentFlags");
        }
        catch { }
        var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/api/account/login?mode=interactive&returnUrl={Uri.EscapeDataString(returnUrl)}", true);
    }
}
