@using CampaignManager.Web.Components.Layout
@using CampaignManager.Web.Components.Features.Music.Components
@inherits LayoutComponentBase

<div class="page">
    <Sidebar/>

    <div class="page-with-sidebar" id="main-content">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                @* Тот же каркас, что у любой страницы: шапка + cm-page + общий EmptyState.
                   Раньше здесь были сырые slate-* и бутстраповский btn-primary, которого в
                   сборке нет, — кнопка «На главную» рисовалась голой ссылкой. *@
                <PageHeader Title="Ошибка"/>
                <div class="cm-page">
                    <EmptyState IconClass="fa-triangle-exclamation"
                                Title="Что-то пошло не так"
                                Message="Произошла непредвиденная ошибка. Попробуйте обновить страницу.">
                        <ActionButton>
                            <a href="/" class="cm-btn cm-btn-primary"><i class="fa-solid fa-house"></i><span>На главную</span></a>
                        </ActionButton>
                    </EmptyState>
                </div>
            </ErrorContent>
        </ErrorBoundary>

        @* Панель плеера живёт в лэйауте, а не на странице: уход со сценария в боевой
           помощник не должен обрывать музыку. Внутри .page-with-sidebar — чтобы её
           изолированные стили могли повторить левый отступ боковой панели. *@
        <MusicPlayerBar/>
    </div>

    <MobileBottomNav/>
</div>

@* Полосу показывает сам Blazor (id и классы reload/dismiss — его, не переименовывать).
   Палитра — error, а не сырой red-600; крестик — иконка, а не эмодзи 🗙; текст — по-русски. *@
<div id="blazor-error-ui" class="fixed bottom-0 w-full bg-error-600 text-white p-3 hidden z-[70]">
    <div class="flex flex-wrap justify-between items-center gap-2">
        <p>Произошла непредвиденная ошибка.</p>
        <div class="flex items-center gap-2">
            <a href="" class="reload cm-btn cm-btn-secondary cm-btn-sm">Перезагрузить</a>
            <a class="dismiss cm-btn cm-btn-sm cm-btn-icon text-white" role="button" aria-label="Скрыть сообщение">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </div>
    </div>
</div>


