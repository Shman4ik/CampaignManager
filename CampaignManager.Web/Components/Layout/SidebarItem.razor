@rendermode InteractiveServer
@inject NavigationManager Nav
@implements IDisposable

@* Пункт бокового меню. Развёрнутое меню показывает Label справа от иконки, свёрнутый
   рельс — ShortLabel под иконкой (правила в design-system.css, раздел «Рельс»). Подпись
   рельса видна всегда: на планшете наведения нет, и title= её не заменит. ShortLabel
   обязан влезать в рельс одной строкой — около 64px при 11px, то есть не длиннее
   «Заклинания»; длиннее — задай короткий вариант. *@
<a href="@Href"
   class="sidebar-item @(IsActive ? "active" : "")"
   aria-current="@(IsActive ? "page" : null)">
    <span class="sidebar-icon"><i class="fa-solid @Icon" aria-hidden="true"></i></span>
    <span class="sidebar-label">@Label</span>
    @* Из двух подписей видна ровно одна (вторая display: none и в дерево доступности
       не попадает), поэтому скринридер читает пункт один раз в любом режиме. *@
    <span class="sidebar-rail-label">@(ShortLabel ?? Label)</span>
    @if (Badge is not null)
    {
        <span class="sidebar-badge">@Badge</span>
    }
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Icon { get; set; } = "fa-circle";
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Подпись под иконкой в свёрнутом рельсе. По умолчанию — <see cref="Label" />.</summary>
    [Parameter] public string? ShortLabel { get; set; }

    [Parameter] public string? Badge { get; set; }

    private bool IsActive =>
        Href == "/"
            ? Nav.Uri == Nav.BaseUri || Nav.Uri == Nav.BaseUri.TrimEnd('/')
            : Nav.Uri.Contains(Href, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
