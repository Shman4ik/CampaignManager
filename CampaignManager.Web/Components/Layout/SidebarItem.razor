@rendermode InteractiveServer
@inject NavigationManager Nav
@implements IDisposable

@* Пункт бокового меню: иконка и подпись под ней (правила в design-system.css, раздел
   «Боковое меню»). Подпись видна всегда: на планшете наведения нет, и title= её не
   заменит. Она обязана влезать в рельс одной строкой — около 64px при 11px, то есть не
   длиннее «Заклинания»; длиннее — задай ShortLabel. *@
<a href="@Href"
   class="sidebar-item @(IsActive ? "active" : "")"
   aria-current="@(IsActive ? "page" : null)">
    <span class="sidebar-icon"><i class="fa-solid @Icon" aria-hidden="true"></i></span>
    <span class="sidebar-rail-label">@(ShortLabel ?? Label)</span>
    @if (Badge is not null)
    {
        <span class="sidebar-badge">@Badge</span>
    }
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Icon { get; set; } = "fa-circle";
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Подпись под иконкой, если <see cref="Label" /> не влезает в рельс.</summary>
    [Parameter] public string? ShortLabel { get; set; }

    [Parameter] public string? Badge { get; set; }

    private bool IsActive =>
        Href == "/"
            ? Nav.Uri == Nav.BaseUri || Nav.Uri == Nav.BaseUri.TrimEnd('/')
            : Nav.Uri.Contains(Href, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
