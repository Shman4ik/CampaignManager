<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EF Core: CmDbContext, конфигурации и миграции схемы cm (наполняет T1.2).
    dotnet ef работает с этим проектом напрямую, без Program.cs сервера и Auth0 —
    через DesignTimeCmDbContextFactory.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Core\CampaignManager.Core.csproj" />
  </ItemGroup>

</Project>
