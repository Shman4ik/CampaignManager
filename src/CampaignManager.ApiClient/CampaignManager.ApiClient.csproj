<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HttpClient-реализации интерфейсов Contracts. Ими пользуются веб (Web.Client), мобильное
    приложение и интеграционные тесты. Безопасен для AOT и обрезки (D4).
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Contracts\CampaignManager.Contracts.csproj" />
  </ItemGroup>

</Project>
