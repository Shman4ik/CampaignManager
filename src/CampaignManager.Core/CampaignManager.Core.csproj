<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Правила книги и документы (лист, статблок, сцена). Только BCL: без EF, ASP.NET, Blazor, HTTP —
    это проверяет ArchitectureTests в Server.Tests. Общий с мобильным приложением на Avalonia (D4),
    поэтому безопасен для AOT и обрезки: анализаторы не пустят рефлексию, JSON — только через
    JsonSerializerContext. Наполняет T1.7.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
