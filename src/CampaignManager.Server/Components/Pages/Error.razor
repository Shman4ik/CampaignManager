@page "/Error"
@attribute [ExcludeFromInteractiveRouting]

@* Сюда UseExceptionHandler отправляет необработанные ошибки страниц (не API) вне Development.
   Рендерится сервером статически: при сломанном клиенте страница всё равно должна показаться. *@
<PageTitle>Ошибка</PageTitle>

<h1 class="mb-2 text-2xl font-semibold">Что-то пошло не так</h1>
<p class="mb-4">Сервер не смог обработать запрос. Обновите страницу; если ошибка повторится — сообщите номер запроса.</p>

@if (RequestId is not null)
{
    <p class="mb-4 text-slate-600">Номер запроса: <code>@RequestId</code></p>
}

<a href="" class="inline-flex min-h-11 items-center rounded-md bg-slate-600 px-4 text-white">На главную</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
