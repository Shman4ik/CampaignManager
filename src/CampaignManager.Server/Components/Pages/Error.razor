@page "/Error"
@layout StaticLayout
@attribute [ExcludeFromInteractiveRouting]

@* Сюда UseExceptionHandler отправляет необработанные ошибки страниц (не API) вне Development.
   Рендерится сервером статически: при сломанном клиенте страница всё равно должна показаться.
   Поэтому и без MainLayout: оболочке нужны службы WebAssembly (связь, диалоги), их на сервере нет.
   Разметка — классы дизайн-системы, без компонентов UI-кита с поведением. *@
<PageTitle>Ошибка</PageTitle>

<header class="cm-topbar">
    <h1 class="cm-topbar-title">Ошибка</h1>
</header>
<div class="cm-page">
    <div class="cm-card">
        <div class="cm-card-body">
            <h2 class="cm-h6 mb-1">Что-то пошло не так</h2>
            <p class="cm-text-muted">Сервер не смог обработать запрос. Обновите страницу; если ошибка повторится — сообщите номер запроса.</p>
            @if (RequestId is not null)
            {
                <p class="cm-text-muted">Номер запроса: <code class="font-mono">@RequestId</code></p>
            }
        </div>
        <div class="cm-card-footer">
            <a href="" class="cm-btn cm-btn-primary"><i class="fa-solid fa-house" aria-hidden="true"></i><span>На главную</span></a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
