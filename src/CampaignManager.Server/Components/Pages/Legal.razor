@page "/legal"
@using CampaignManager.UI.Pages
@layout StaticLayout
@attribute [ExcludeFromInteractiveRouting]

@* Рендерится сервером статически: полный текст в HTML без JS. Его читают бот Google (OAuth-клиент) и Auth0,
   поэтому страница не может ждать WebAssembly (D1: интерактивный рендер без пререндера). Общая оболочка
   (рельс, меню пользователя) тянет службы WebAssembly и на сервере не поднимается — здесь простая шапка.
   Текст — в UI (Pages/LegalContent), общий для всех клиентов. *@
<PageTitle>Правовая информация</PageTitle>

<header class="cm-topbar">
    <div class="cm-topbar-heading">
        <h1 class="cm-topbar-title">Правовая информация</h1>
    </div>
    <div class="cm-topbar-actions">
        <a href="" class="cm-btn cm-btn-secondary cm-btn-sm"><i class="fa-solid fa-house" aria-hidden="true"></i><span>На главную</span></a>
    </div>
</header>
<LegalContent />
