@page "/about"
@using CampaignManager.UI.Pages
@layout StaticLayout
@attribute [ExcludeFromInteractiveRouting]

@* Рендерится сервером статически: полный текст в HTML без JS. Его читают бот Google (OAuth-клиент) и Auth0,
   поэтому страница не может ждать WebAssembly (D1: интерактивный рендер без пререндера). Общая оболочка
   (рельс, меню пользователя) тянет службы WebAssembly и на сервере не поднимается — здесь InfoShell: те же поля,
   знак в рельсе и «← На главную» слева. Заголовок вкладки — «О сайте — Campaign Manager» (InfoShell).
   Текст — в UI (Pages/AboutContent), общий для всех клиентов. *@
<InfoShell Title="О сайте">
    <AboutContent />
</InfoShell>
