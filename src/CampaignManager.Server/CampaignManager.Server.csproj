<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ASP.NET Core: минимальные API по модулям (/api/v1/…), прикладные сервисы, хост WebAssembly.
    Program.cs только перечисляет модули; модуль — пара AddXxxModule/MapXxxApi.
  -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Minio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Core\CampaignManager.Core.csproj" />
    <ProjectReference Include="..\CampaignManager.Contracts\CampaignManager.Contracts.csproj" />
    <ProjectReference Include="..\CampaignManager.Data\CampaignManager.Data.csproj" />
    <ProjectReference Include="..\CampaignManager.UI\CampaignManager.UI.csproj" />
    <ProjectReference Include="..\CampaignManager.Web.Client\CampaignManager.Web.Client.csproj" />
  </ItemGroup>

</Project>
