<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Хост WebAssembly: регистрирует ApiClient (и позже AuthenticationStateProvider, T1.4).
    Страницы и компоненты — в UI, сервер отдаёт этот проект целиком.
  -->
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Культура интерфейса — ru-RU при любом языке браузера. По умолчанию WebAssembly грузит
      только кусок ICU под язык браузера, и в английском Safari русских месяцев бы не было.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.ApiClient\CampaignManager.ApiClient.csproj" />
    <ProjectReference Include="..\CampaignManager.UI\CampaignManager.UI.csproj" />
  </ItemGroup>

</Project>
