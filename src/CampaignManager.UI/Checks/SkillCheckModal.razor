@using CampaignManager.Core
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Checks

@* Диалог проверки — SkillCheckPanel в общем Modal. На каждое открытие панель создаётся заново (@key):
   итог прошлой проверки не должен встретить игрока в новой. Лист диалог не пишет — см. OnSheetChange. *@
@* Окно растёт вниз (выбор → бросок → исход, Удача, повтор, отметка), но не прыгает: оно привязано к верху экрана
   (cm-modal-top), поля и «Бросить» остаются на месте. Раньше — Large 768px и MinHeight 60rem: на 834×1056 окно 745×931 с
   содержимым в левой половине и пустой нижней (владелец, 2026-10-03). Medium — по ширине содержимого. *@
<Modal Open="@Open" OnClose="CloseAsync" Title="@Title" class="cm-modal-top" data-testid="skill-check-modal">
    <ChildContent>
        <SkillCheckPanel @key="_session" Sheet="@Sheet" Catalog="@Catalog" Party="@Party" InitialKey="@InitialKey"
                         InitialName="@InitialName" InitialDifficulty="@InitialDifficulty" InCombat="@InCombat"
                         OnSheetChange="@OnSheetChange" Help="@Help"
                         InitialInvestigatorId="@InitialInvestigatorId" OnInvestigatorChanged="@OnInvestigatorChanged" Details="@Details" />
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync">Закрыть</Button>
    </Footer>
</Modal>

@code {
    private int _session;
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public string Title { get; set; } = "Проверка";

    [Parameter] public CharacterSheet? Sheet { get; set; }

    [Parameter] public SkillCatalog? Catalog { get; set; }

    [Parameter] public IReadOnlyList<CheckInvestigator>? Party { get; set; }

    [Parameter] public string? InitialKey { get; set; }

    [Parameter] public string? InitialName { get; set; }

    [Parameter] public Difficulty InitialDifficulty { get; set; }

    [Parameter] public bool InCombat { get; set; }

    /// <summary>Трата Удачи и отметка — родителю: он применяет <see cref="CheckRules.Apply"/> и сохраняет лист.</summary>
    [Parameter] public EventCallback<CheckSheetChange> OnSheetChange { get; set; }

    /// <summary>Справка по цели проверки (лист) — строка «Справка по навыку» внутри окна.</summary>
    [Parameter] public RenderFragment<string>? Help { get; set; }

    /// <summary>Сыщик, выбранный в прошлой проверке: подставляется при открытии (режим состава).</summary>
    [Parameter] public Guid? InitialInvestigatorId { get; set; }

    [Parameter] public EventCallback<Guid?> OnInvestigatorChanged { get; set; }

    /// <summary>Пояснение под результатом броска (исход проверки из сценария); параметр — проверка пройдена.</summary>
    [Parameter] public RenderFragment<bool>? Details { get; set; }

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
            _session++;

        _wasOpen = Open;
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);
}
