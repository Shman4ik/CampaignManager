@using CampaignManager.Core.Checks

@* Бонусные и штрафные кости одним числом от −2 до +2: одна бонусная гасит одну штрафную,
   поэтому Хранителю нужен только итог. Общий сегментированный переключатель (Shared/Segmented): выбор не красится
   главной кнопкой. Подпись итога — сразу под сегментами, не отдельной строкой поодаль. *@
<div>
    <Segmented TValue="int" Options="Choices" Value="Value" ValueChanged="ValueChanged" Disabled="Disabled" Label="Бонусные и штрафные кости" />
    @* «Без дополнительных костей» — умолчание, его не пишут: строка занимала место окна (g4 13.9); пояснение — когда кости есть. *@
    @if (Value != 0)
    {
        <p class="cm-field-note mt-1">@CheckRules.ExtraDiceLabel(Value)</p>
    }
</div>

@code {
    private static readonly IReadOnlyList<SegmentOption<int>> Choices = Enumerable
        .Range(-CheckRules.MaxExtraDice, CheckRules.MaxExtraDice * 2 + 1)
        .Select(v => new SegmentOption<int>(v, v > 0 ? $"+{v}" : v < 0 ? $"−{-v}" : "0", CheckRules.ExtraDiceLabel(v), $"check-dice-{v}"))
        .ToList();

    [Parameter] public int Value { get; set; }

    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }
}
