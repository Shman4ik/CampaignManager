@using CampaignManager.Core.Checks

@* Бонусные и штрафные кости одним числом от −2 до +2: одна бонусная гасит одну штрафную (стр. 89),
   поэтому Хранителю нужен только итог. Кнопки квадратные — пять в ряд влезают и на телефоне. *@
<div>
    <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Бонусные и штрафные кости">
        @for (var net = -CheckRules.MaxExtraDice; net <= CheckRules.MaxExtraDice; net++)
        {
            var value = net;
            var active = value == Value;
            <Button Small="true" Variant="@(active ? ButtonVariant.Primary : ButtonVariant.Secondary)" Disabled="@Disabled"
                    role="radio" aria-checked="@(active ? "true" : "false")" aria-label="@CheckRules.ExtraDiceLabel(value)"
                    class="min-w-11 justify-center" data-testid="@($"check-dice-{value}")"
                    OnClick="() => ValueChanged.InvokeAsync(value)">
                @(value > 0 ? $"+{value}" : value < 0 ? $"−{-value}" : "0")
            </Button>
        }
    </div>
    <p class="cm-field-note mt-1">@CheckRules.ExtraDiceLabel(Value)</p>
</div>

@code {
    [Parameter] public int Value { get; set; }

    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }
}
