@using CampaignManager.Core
@using CampaignManager.Core.Checks
@using CampaignManager.Core.Dice

@* Три уровня сложности сегментами, а не выпадающим списком: за столом это один тап. Рядом с
   каждым — сколько нужно выбросить, если значение уже известно (Check.Target, Core). Выбранный — светлый с галочкой
   (Segmented), а не тёмная главная кнопка: в окне проверки и в форме проверки главная — «Добавить»/«Бросить». *@
<Segmented TValue="Difficulty" Options="Options" Value="Value" ValueChanged="ValueChanged" Disabled="Disabled" Label="Сложность проверки" />

@code {
    [Parameter] public Difficulty Value { get; set; }

    [Parameter] public EventCallback<Difficulty> ValueChanged { get; set; }

    /// <summary>Значение навыка — тогда у кнопок появляется «≤ 27».</summary>
    [Parameter] public int? SkillValue { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private IReadOnlyList<SegmentOption<Difficulty>> Options =>
        [.. CheckRules.Difficulties.Select(d => new SegmentOption<Difficulty>(d, CheckRules.DifficultyLabel(d) + TargetSuffix(d), TestId: $"check-difficulty-{d}"))];

    private string TargetSuffix(Difficulty difficulty) =>
        SkillValue is { } value ? $" ≤ {Check.Target(value, difficulty)}" : "";
}
