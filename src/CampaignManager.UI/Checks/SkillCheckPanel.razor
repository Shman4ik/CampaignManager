@using CampaignManager.Core
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Checks
@using CampaignManager.Core.Dice

@* Проверка навыка или характеристики — один компонент на всё приложение: диалог листа, проверка в
   локации сценария (SkillCheckModal) и кости в бою (InCombat). Своей карточки не рисует: его место —
   тело модалки или cm-card страницы.
   Уровень успеха считает только Check (Core), цену Удачи — LuckRules, что разрешено после броска —
   CheckRules. Здесь разметка и порядок шагов. Лист панель НЕ пишет: трата Удачи и отметка уходят
   родителю через OnSheetChange, а он применяет их CheckRules.Apply и сохраняет своим путём. *@
<div class="cm-stack" data-testid="skill-check-panel">
    <section class="flex flex-col gap-3">
        @if (IsPartyMode)
        {
            <Field Label="Кто проверяется">
                <select class="cm-input" data-testid="check-subject" disabled="@IsLocked" @onchange="SelectInvestigator">
                    <option value="" selected="@(_investigatorId is null)">— вписать значение вручную —</option>
                    @foreach (var investigator in Party!)
                    {
                        <option value="@investigator.Id" selected="@(investigator.Id == _investigatorId)">@investigator.Label</option>
                    }
                </select>
            </Field>
            @if (Party!.Count == 0)
            {
                <p class="cm-field-note">Сыщиков нет — впишите значение навыка вручную.</p>
            }
        }

        @* Цель крупно: заголовок окна называет сыщика, а что именно проверяют, было видно только в select. Строка занимает место
           и пока цель не выбрана, иначе окно подрастало бы на выборе. Справа — «Другой навык»: полный список из 90 вариантов
           не нужен, пока окно открыто с конкретным навыком, — раньше он стоял вторым блоком и троил число («Внимание 63%»,
           «Внимание (63)», «Обычная ≤ 63», g2 7.1.2). *@
        <div class="flex min-h-8 flex-wrap items-center justify-between gap-x-3">
            <div class="flex min-h-7 flex-wrap items-baseline gap-x-3" data-testid="check-subject-head">
                @if (Subject is { } head && head.Name.Length > 0)
                {
                    <span class="text-lg font-semibold text-primary-900">@head.Name</span>
                    <span class="font-mono text-lg text-primary-700">@head.Value%</span>
                }
            </div>
            @if (CurrentSheet is not null && _key.Length > 0 && !_changingTarget && !IsLocked)
            {
                <button type="button" class="sheet-link" data-testid="check-change-target" @onclick="() => _changingTarget = true">
                    <i class="fa-solid fa-repeat" aria-hidden="true"></i>Другой навык
                </button>
            }
        </div>

        @if (CurrentSheet is { } sheet)
        {
            @if (!IsLocked && (_key.Length == 0 || _changingTarget))
            {
                <Field Label="Что проверяем">
                    <select class="cm-input" data-testid="check-target" disabled="@IsLocked" @onchange="SelectTarget">
                        <option value="" selected="@(_key.Length == 0)">— навык или характеристика —</option>
                        <optgroup label="Характеристики">
                            @foreach (var subject in CheckSubjects.Characteristics(sheet))
                            {
                                <option value="@subject.Key" selected="@(subject.Key == _key)">@subject.Name (@subject.Value)</option>
                            }
                            @{ var luck = CheckSubjects.Luck(sheet); }
                            <option value="@luck.Key" selected="@(luck.Key == _key)">@luck.Name (@luck.Value)</option>
                        </optgroup>
                        @foreach (var group in CheckSubjects.SkillGroups(sheet, Catalog!))
                        {
                            <optgroup label="@group.Title">
                                @foreach (var subject in group.Subjects)
                                {
                                    <option value="@subject.Key" selected="@(subject.Key == _key)">@subject.Name (@subject.Value)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </Field>
            }
        }
        else if (!FixedSubject)
        {
            @* Цель пришла из сценария (InitialName) — она уже названа крупной строкой выше, поле «Что проверяем» её бы повторило
               (g4 13.10: цель называлась трижды); вписывают только значение. *@
            <div class="@(string.IsNullOrWhiteSpace(InitialName) ? "grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]" : "max-w-40")">
                @if (string.IsNullOrWhiteSpace(InitialName))
                {
                    <Field Label="Что проверяем">
                        <input class="cm-input" data-testid="check-target-name" placeholder="Внимание, СИЛ, Удача…"
                               disabled="@IsLocked" @bind="_manualName" @bind:event="oninput" />
                    </Field>
                }
                <Field Label="Значение">
                    <input type="number" inputmode="numeric" min="0" max="200" class="cm-input" data-testid="check-value"
                           disabled="@IsLocked" @bind="_manualValue" @bind:event="oninput" />
                </Field>
            </div>
        }

        @* Сложность и кости — условия броска: выбираются до него. «Бросок» следует сразу за ними — на 834×1056 и 1194×696 он виден
           без прокрутки окна (g2 7.1.1: раньше стоял вторым экраном, а справка — над ним). После броска условия заперты и
           итог уже называет их («Нужно ≤ 63 (обычная сложность)»): два заблокированных переключателя убираются, чтобы Удача и
           повтор — то, что делают дальше, — не уходили за край окна (g2 7.1.4). *@
        @if (!IsLocked)
        {
            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1">
                    <span class="cm-field-label">Сложность</span>
                    <DifficultyPicker @bind-Value="_difficulty" SkillValue="@Subject?.Value" Disabled="@IsLocked" />
                </div>
                <div class="flex flex-col gap-1">
                    <span class="cm-field-label">Кости</span>
                    <ExtraDicePicker @bind-Value="_netDice" Disabled="@IsLocked" />
                </div>
            </div>
        }
        else if (_netDice != 0)
        {
            <p class="cm-field-note" data-testid="check-conditions">@CheckRules.ExtraDiceLabel(CheckRules.ClampNetDice(_netDice))</p>
        }
    </section>

    <section>
        @if (_first is null)
        {
            @RollStep("first", OnFirstRollAsync)
        }
        else
        {
            <div class="flex flex-wrap items-start justify-between gap-3">
                @RenderAttempt(_first, _pushing ? "Первая проверка" : null)
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" data-testid="check-reset" OnClick="Reset">
                    Новая проверка
                </Button>
            </div>

            @if (Details is not null)
            {
                @* Исход из сценария — сразу под результатом броска, до Удачи и повтора: за столом его читают первым,
                   не прокручивая окно. Выпавший исход — сверху и выделен, остальные Details прячет сам. *@
                <div class="mt-4" data-testid="check-details">@Details(FinalOutcome is { Passed: true })</div>
            }

            @if (_luckSpent is { } spent)
            {
                <Alert Tone="Tone.Success" ShowIcon="true" Small="true" class="mt-3 mb-0" data-testid="check-luck-result">
                    Удача: @_first.Outcome.Roll → @spent.ResultingRoll, @RulesText.Of(spent.Level) за @spent.Cost п.@LuckAfterText
                </Alert>
            }

            @if (_luckSpent is null && !_pushing && (!_first.Outcome.Passed || CanRaiseByLuck))
            {
                @LuckBlock()
            }

            @if (!_first.Outcome.Passed && _luckSpent is null)
            {
                @PushBlock()
            }

            @if (FinalOutcome is { Passed: true })
            {
                @MarkBlock()
            }
        }
    </section>

    @* Справка — последним блоком: открытая, она занимала экран-два и уносила бросок с результатом (g2 7.1.3). *@
    @if (Help is not null && _key.StartsWith("skill:", StringComparison.Ordinal))
    {
        <details class="skill-help" data-testid="check-help">
            <summary class="cm-tap-row cursor-pointer font-medium text-accent-700">Справка по навыку</summary>
            <div class="pt-2">@Help(_key)</div>
        </details>
    }
</div>

@code {
    /// <summary>Лист, из которого берутся значения (диалог листа). Вместе с <see cref="Catalog"/>.</summary>
    [Parameter] public CharacterSheet? Sheet { get; set; }

    /// <summary>Справочник навыков: без него лист не читается (имена, коды, базы).</summary>
    [Parameter] public SkillCatalog? Catalog { get; set; }

    /// <summary>Сыщики на выбор (режим игры сценария). Их листы только читаются.</summary>
    [Parameter] public IReadOnlyList<CheckInvestigator>? Party { get; set; }

    /// <summary>Цель по ключу <see cref="CheckSubject.Key"/>: <c>skill:{id}</c>, <c>char:STR</c>, <c>luck</c>.</summary>
    [Parameter] public string? InitialKey { get; set; }

    /// <summary>Подпись цели для ручного ввода — «Внимание» из локации, если сыщик не выбран.</summary>
    [Parameter] public string? InitialName { get; set; }

    [Parameter] public Difficulty InitialDifficulty { get; set; }

    /// <summary>Значение цели, когда её называет вызывающий (бой: характеристика участника) — вместе с <see cref="InitialName"/> и <see cref="FixedSubject"/>.</summary>
    [Parameter] public int? InitialValue { get; set; }

    /// <summary>Цель задана снаружи (<see cref="InitialName"/> и <see cref="InitialValue"/>): полей «Что проверяем» и «Значение» нет.</summary>
    [Parameter] public bool FixedSubject { get; set; }

    /// <summary>Проверка в бою: повторять её нельзя.</summary>
    [Parameter] public bool InCombat { get; set; }

    /// <summary>
    /// Игрок решил потратить Удачу или отметить навык. Задан — у <see cref="Sheet"/> появляются кнопки;
    /// родитель применяет изменение (<see cref="CheckRules.Apply"/>) и сохраняет лист сам.
    /// </summary>
    [Parameter] public EventCallback<CheckSheetChange> OnSheetChange { get; set; }

    /// <summary>Справка по цели (лист: описание навыка из справочника) — строкой «Справка» в окне, а не отдельным шагом до проверки.</summary>
    [Parameter] public RenderFragment<string>? Help { get; set; }

    /// <summary>Сыщик, выбранный по умолчанию (режим состава): запоминается между проверками. Если его нет в <see cref="Party"/> — не выбран никто.</summary>
    [Parameter] public Guid? InitialInvestigatorId { get; set; }

    /// <summary>Выбран другой сыщик (или «вписать вручную» — <c>null</c>): родитель запоминает его для следующей проверки.</summary>
    [Parameter] public EventCallback<Guid?> OnInvestigatorChanged { get; set; }

    /// <summary>
    /// Пояснение сразу под результатом броска (в локации сценария — исходы «Успех»/«Провал»); параметр — итог проверки с учётом
    /// Удачи и повтора: <c>true</c> — пройдена. До броска не показывается.
    /// </summary>
    [Parameter] public RenderFragment<bool>? Details { get; set; }

    /// <summary>
    /// Итог проверки изменился (бросок, повторный бросок, Удача, «Новая проверка»): ключ цели и пройдена ли она с учётом
    /// Удачи и повтора; <c>Passed = null</c> — броска нет. Нужен листу: проверку ИНТ из тревоги Рассудка он закрывает сам.
    /// </summary>
    [Parameter] public EventCallback<CheckResolution> OnResolution { get; set; }

    private Guid? _investigatorId;
    private string _key = "";
    private string _manualName = "";
    private int? _manualValue;
    private Difficulty _difficulty;
    private int _netDice;

    private CheckSubject? _rolledSubject;
    private CheckAttempt? _first;
    private bool _pushing;
    private CheckAttempt? _second;
    private LuckRules.SpendOption? _luckSpent;
    private bool _marked;

    /// <summary>Выбор цели из полного списка раскрыт («Другой навык»); пока цель не выбрана, список виден сам.</summary>
    private bool _changingTarget;

    private ElementReference _resultRef;
    private bool _scrollToResult;

    private bool IsSheetMode => Sheet is not null && Catalog is not null;

    private bool IsPartyMode => !IsSheetMode && Party is not null && Catalog is not null;

    /// <summary>Лист пишет родитель: кнопки Удачи и отметки — только у листа с обработчиком.</summary>
    private bool CanChangeSheet => IsSheetMode && OnSheetChange.HasDelegate;

    /// <summary>После броска условия не меняются: иначе на экране окажется итог чужой проверки.</summary>
    private bool IsLocked => _first is not null;

    private CharacterSheet? CurrentSheet => IsSheetMode
        ? Sheet
        : IsPartyMode ? Party!.FirstOrDefault(i => i.Id == _investigatorId)?.Sheet : null;

    private CheckSubject? Subject
    {
        get
        {
            if (CurrentSheet is { } sheet)
                return _key.Length == 0 ? null : CheckSubjects.FindByKey(sheet, Catalog!, _key);

            return _manualValue is { } value and >= 0 ? CheckSubject.Manual(value, _manualName) : null;
        }
    }

    private CheckOutcome? FinalOutcome =>
        _second?.Outcome
        ?? (_luckSpent is { } spent ? new CheckOutcome(spent.ResultingRoll, spent.Level, true) : _first?.Outcome);

    /// <summary>
    /// Пройденную проверку Удачей поднимают до уровня выше — кнопки только у листа с обработчиком,
    /// и только если есть до чего поднимать: у каждого успеха иначе висел бы пустой блок.
    /// </summary>
    private bool CanRaiseByLuck => CanChangeSheet
        && _first is { Outcome.Passed: true } first
        && CheckRules.LuckBlockReason(_rolledSubject!, first.Outcome, isPushed: false) is null
        && CheckRules.LuckOptions(first.Outcome, _rolledSubject!.Value, _difficulty, Sheet!.Current.Luck).Count > 0;

    private string LuckAfterText => CanChangeSheet ? $" Удача на листе — {Sheet!.Current.Luck}." : "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToResult)
            return;

        // Фокус на результате прокручивает к нему тело окна: после броска игрок видит число и уровень, а не условия.
        _scrollToResult = false;
        try
        {
            await _resultRef.FocusAsync();
        }
        catch (Exception error) when (error is InvalidOperationException or JSException or JSDisconnectedException)
        {
            // Результат уже убрали («Новая проверка») или JS недоступен — прокрутка необязательна.
        }
    }

    protected override void OnInitialized()
    {
        _difficulty = InitialDifficulty;
        _key = InitialKey ?? "";
        _manualName = InitialName ?? "";
        if (InitialInvestigatorId is { } initial && IsPartyMode && Party!.Any(i => i.Id == initial))
            _investigatorId = initial;
        else if (IsPartyMode && Party!.Count == 1)
            _investigatorId = Party[0].Id; // единственного сыщика не выбирают: значение его навыка подставляется сразу (g4 13.12)
        _manualValue = InitialValue;
    }

    private Task SelectInvestigator(ChangeEventArgs args)
    {
        _investigatorId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        return OnInvestigatorChanged.InvokeAsync(_investigatorId);
    }

    private void SelectTarget(ChangeEventArgs args) => _key = args.Value?.ToString() ?? "";

    private Task OnFirstRollAsync(D100Roll? roll)
    {
        if (roll is null || Subject is not { } subject)
            return Task.CompletedTask;

        _rolledSubject = subject;
        _first = Attempt(roll, subject);
        _scrollToResult = true;
        return NotifyAsync();
    }

    private Task OnPushRollAsync(D100Roll? roll)
    {
        if (roll is not null && _rolledSubject is { } subject)
        {
            _second = Attempt(roll, subject);
            _scrollToResult = true;
        }

        return NotifyAsync();
    }

    private CheckAttempt Attempt(D100Roll roll, CheckSubject subject) =>
        new(roll, CheckRules.Evaluate(roll.Result, subject.Value, _difficulty));

    private Task Reset()
    {
        _first = null;
        _second = null;
        _pushing = false;
        _luckSpent = null;
        _marked = false;
        _rolledSubject = null;
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnResolution.InvokeAsync(new CheckResolution(_rolledSubject?.Key, FinalOutcome?.Passed));

    private async Task SpendLuckAsync(LuckRules.SpendOption option)
    {
        if (!CanChangeSheet || !option.Affordable || _luckSpent is not null || _rolledSubject is not { } subject)
            return;

        // Купленный успех отметки не даёт: если её поставили за этот же бросок — она снимается
        // вместе с тратой; отметку, стоявшую на листе до броска, трата не трогает.
        var change = CheckRules.LuckSpend(subject, option.Cost, markedThisRoll: _marked);
        _luckSpent = option;
        _marked = false;
        await OnSheetChange.InvokeAsync(change);
        await NotifyAsync();
    }

    private async Task MarkAsync()
    {
        if (!CanChangeSheet || _rolledSubject is not { Kind: CheckSubjectKind.Skill } subject)
            return;

        _marked = true;
        await OnSheetChange.InvokeAsync(new CheckSheetChange { Mark = subject });
    }

    /// <summary>Пояснение к итогу. Обычный успех и провал уже сказаны значком уровня — повторять их нечего.</summary>
    private string? Verdict(CheckOutcome outcome) => outcome switch
    {
        { Level: SuccessLevel.Critical } => "Цель достигнута, и сверх того случается что-то хорошее.",
        { Level: SuccessLevel.Fumble } => "Хуже простого провала: последствия наступают сразу.",
        { Passed: true } => null,
        { Level: >= SuccessLevel.Regular } => $"Для {DifficultyGenitive(_difficulty)} проверки этого мало — провал.",
        _ => null,
    };

    private static string DifficultyGenitive(Difficulty difficulty) => difficulty switch
    {
        Difficulty.Hard => "трудной",
        Difficulty.Extreme => "чрезвычайной",
        _ => "обычной",
    };

    private RenderFragment RollStep(string step, Func<D100Roll?, Task> onRoll) => __builder =>
    {
        var subject = step == "first" ? Subject : _rolledSubject;
        if (subject is null)
        {
            <p class="cm-field-note" data-testid="check-roll-hint">Сначала выберите, что проверяем, и значение.</p>
            return;
        }

        var net = CheckRules.ClampNetDice(_netDice);
        <Field Label="@(step == "first" ? "Бросок" : "Повторный бросок")" Group="true" data-testid="@($"check-roll-{step}")">
            <RollInput Value="@subject.Value" Difficulty="@_difficulty" BonusDice="@Math.Max(0, net)" PenaltyDice="@Math.Max(0, -net)"
                       Label="@subject.Name" RollChanged="@(roll => onRoll(roll))" />
        </Field>
        @if (net != 0)
        {
            <p class="cm-field-note mt-1">
                Кости со стола: с бонусной впишите меньший из вариантов десятков, со штрафной — больший.
            </p>
        }
    };

    private RenderFragment RenderAttempt(CheckAttempt attempt, string? caption) => __builder =>
    {
        var outcome = attempt.Outcome;
        var subject = _rolledSubject!;
        @* Результат — цель прокрутки после броска (_scrollToResult): окно не должно оставаться на условиях, когда выпало число.
           Последний нарисованный (повторный бросок) перекрывает ссылку первого. *@
        <div class="flex min-w-0 items-center gap-4 outline-hidden" tabindex="-1" @ref="_resultRef" data-testid="check-result">
            <div class="check-roll">@outcome.Roll.ToString("00", CultureInfo.InvariantCulture)</div>
            <div class="min-w-0">
                @if (caption is not null)
                {
                    <div class="cm-section-title">@caption</div>
                }
                <Badge Tone="@LevelText.ToneOf(outcome.Level, outcome.Passed)" Solid="@LevelText.IsSolid(outcome.Level)"
                       class="check-level" data-testid="check-level">@LevelText.Title(outcome.Level)</Badge>
                @if (Verdict(outcome) is { } verdict)
                {
                    <div class="mt-1 text-sm text-primary-700">@verdict</div>
                }
                <div class="cm-field-note">
                    Нужно ≤ @Check.Target(subject.Value, _difficulty) (@CheckRules.DifficultyLabel(_difficulty).ToLowerInvariant() сложность)@RulesText.RollDetail(attempt.Dice)
                </div>
            </div>
        </div>
    };

    private RenderFragment LuckBlock() => __builder =>
    {
        var subject = _rolledSubject!;
        var outcome = _first!.Outcome;
        // Невозможное не рисуется (правило 8, g4 13.11): «пункты Удачи на проверку Удачи не тратят» и «Удачей не дотянуть» —
        // объяснение того, чего нельзя сделать, а не действие.
        if (CheckRules.LuckBlockReason(subject, outcome, isPushed: false) is not null)
            return;

        var luck = CurrentSheet?.Current.Luck;
        var options = CheckRules.LuckOptions(outcome, subject.Value, _difficulty, luck ?? int.MaxValue);
        if (options.Count == 0)
            return;

        <div class="mt-4" data-testid="check-luck">
            <h3 class="mb-2 text-sm font-semibold text-primary-700">@(outcome.Passed ? "Поднять уровень Удачей" : "Потратить Удачу")</h3>
            @{
                if (CanChangeSheet)
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var option in options)
                        {
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-clover" Disabled="@(!option.Affordable)"
                                    data-testid="@($"check-luck-{option.Level}")" OnClick="() => SpendLuckAsync(option)">
                                @LevelText.Title(option.Level): @option.Cost@(option.Affordable ? "" : " — не хватает")
                            </Button>
                        }
                    </div>
                    @if (outcome.Passed)
                    {
                        <p class="cm-field-note mt-1" data-testid="check-luck-raise-note">
                            Удача сейчас @luck. Успех, купленный Удачей, отметки для развития не даёт@(_marked ? " — отметка за этот бросок снимется" : "").
                        </p>
                    }
                    else
                    {
                        <p class="cm-field-note mt-1">Удача сейчас @luck. Либо Удача, либо повторная проверка — не то и другое.</p>
                    }
                }
                else
                {
                    <ul class="list-disc pl-5 text-sm text-primary-700">
                        @foreach (var option in options)
                        {
                            <li>@RulesText.Of(option.Level) — @option.Cost п. Удачи (выпадет @option.ResultingRoll)@(option.Affordable ? "" : " — у сыщика столько нет")</li>
                        }
                    </ul>
                    <p class="cm-field-note mt-1">
                        @(luck is { } current ? $"Удача сыщика {current}. " : "")Списывают пункты на листе сыщика — отсюда лист не меняется.
                        Либо Удача, либо повторная проверка.
                    </p>
                }
            }
        </div>
    };

    private RenderFragment PushBlock() => __builder =>
    {
        // Повторить нельзя (бой, Удача, крах) — блока нет: объяснение невозможного не действие (правило 8, g4 13.11).
        if (CheckRules.PushBlockReason(_rolledSubject!, _first!.Outcome, InCombat) is not null)
            return;

        <div class="mt-4" data-testid="check-push">
            <h3 class="mb-2 text-sm font-semibold text-primary-700">Повторная проверка</h3>
            @if (!_pushing)
            {
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-right" data-testid="check-push-start"
                        OnClick="() => _pushing = true">Бросить повторно</Button>
                <p class="cm-field-note mt-1">Второй и последний шанс — с более тяжёлыми последствиями провала.</p>
            }
            else
            {
                <Alert Tone="Tone.Warning" ShowIcon="true" Title="Ставки выше: провал развязывает Хранителю руки" data-testid="check-push-warning">
                    Игрок объясняет, что сыщик делает иначе — тратит время, рискует, давит сильнее; навык и сложность
                    обычно прежние. Удачу на повторную проверку не тратят. При провале — урон, проверка Рассудка, потеря
                    снаряжения, разлука с группой, плен, или цель достигнута дорогой ценой.
                </Alert>

                @if (_second is null)
                {
                    @RollStep("push", OnPushRollAsync)
                    <Button Small="true" Variant="ButtonVariant.Secondary" class="mt-2" OnClick="() => _pushing = false">Не повторять</Button>
                }
                else
                {
                    @RenderAttempt(_second, "Повторная проверка")
                    @if (_second.Outcome.Passed)
                    {
                        <Alert Tone="Tone.Success" Small="true" class="mt-3 mb-0" data-testid="check-push-passed">
                            Цель достигнута, как при успехе первой проверки, — без дурных последствий.
                        </Alert>
                    }
                    else
                    {
                        <Alert Tone="Tone.Error" ShowIcon="true" Title="Провал повторной проверки" class="mt-3 mb-0" data-testid="check-push-failed">
                            Хранитель вправе обрушить серьёзные последствия: урон, проверку Рассудка, потерю снаряжения, плен.
                            Лучше последствие, которое двигает историю, чем конец игры — плен вместо смерти, сделка, обморок.
                        </Alert>
                    }
                }
            }
        </div>
    };

    private RenderFragment MarkBlock() => __builder =>
    {
        var subject = _rolledSubject!;

        // Нечего отмечать — блока нет (правило 4): характеристикам, Удаче, Мифам и Средствам отметку не ставят никогда, и абзац
        // «ставят только навыкам» про то, чего на экране нет, был лишним (g2 7.1.5).
        if (subject.Kind is CheckSubjectKind.Characteristic or CheckSubjectKind.Luck
            || subject.Kind is CheckSubjectKind.Skill && !DevelopmentPhaseRules.CanBeChecked(subject.SkillCode))
        {
            return;
        }

        var reason = CheckRules.MarkBlockReason(subject, _netDice, _luckSpent is not null);
        <div class="mt-4" data-testid="check-mark">
            <h3 class="mb-2 text-sm font-semibold text-primary-700">Отметка для фазы развития</h3>
            @if (reason is not null)
            {
                <p class="cm-field-note">@reason</p>
            }
            else if (CanChangeSheet)
            {
                var row = CheckSubjects.FindSkill(Sheet!, Catalog!, subject);
                if (_marked)
                {
                    <p class="text-sm text-success-700"><i class="fa-solid fa-check mr-1" aria-hidden="true"></i>@Names.Strong(subject.Name) отмечен.</p>
                }
                else if (row is { Checked: true })
                {
                    <p class="cm-field-note">Отметка у @Names.Strong(subject.Name) уже стоит: за навык её ставят один раз.</p>
                }
                else
                {
                    <Button Small="true" Icon="fa-check" data-testid="check-mark-skill" OnClick="MarkAsync">Отметить: @Names.Clean(subject.Name)</Button>
                }
            }
            else
            {
                <p class="cm-field-note">Успех даёт отметку навыку @Names.Strong(subject.Name) — поставьте её на листе сыщика.</p>
            }
        </div>
    };
}
