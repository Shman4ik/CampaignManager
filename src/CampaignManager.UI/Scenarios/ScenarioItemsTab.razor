@inherits ScenarioTabBase
@using CampaignManager.UI.Platform
@inject ICatalogApi<ItemDto> ItemsApi

@* «Предметы» — из справочника (ссылкой) или свой реквизит сценария (решение владельца: реквизит «Среди древних
   деревьев» перенесён так, а не в справочник). *@
<section class="cm-section">
    <div class="cm-section-header flex-wrap gap-2">
        <h2 class="cm-section-title">Предметы</h2>
        @if (CanEdit)
        {
            <div class="flex flex-wrap gap-2">
                @if (Scenario.Items.Count > 1)
                {
                    <Button Small="true" Variant="@(Reordering ? ButtonVariant.Primary : ButtonVariant.Secondary)" Icon="fa-arrow-down-up-across-line"
                            OnClick="() => Reordering = !Reordering">@(Reordering ? "Готово" : "Порядок")</Button>
                }
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-gem" data-testid="add-prop" OnClick="() => OpenForm(null)">Свой реквизит</Button>
                <Button Small="true" Icon="fa-plus" data-testid="add-item" OnClick="OpenPicker">Из справочника</Button>
            </div>
        }
    </div>
    @if (Scenario.Items.Count == 0)
    {
        <EmptyState Icon="fa-box" Title="Предметов пока нет." Message="Предмет из справочника или свой реквизит — идол, ключ, дневник." />
    }
    else
    {
        var ids = Scenario.Items.Select(i => i.Id).ToList();
        <div class="cm-card" data-testid="item-list">
            @foreach (var item in Scenario.Items)
            {
                var index = ids.IndexOf(item.Id);
                <div class="flex flex-wrap items-start gap-3 border-t border-primary-200 px-4 py-3 first:border-t-0" @key="item.Id" data-testid="item-row">
                    @if (item.ImageUrl is { } image)
                    {
                        <img src="@image" alt="" class="h-12 w-12 shrink-0 rounded-md object-cover" loading="lazy" />
                    }
                    <div class="flex min-w-48 flex-1 flex-col gap-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="font-semibold text-primary-900">@item.Name</span>
                            @if (item.ItemId is null)
                            {
                                <Badge Tone="Tone.Warning" Icon="fa-gem">реквизит</Badge>
                            }
                            else if (item.Type is { } type)
                            {
                                <Badge Tone="Tone.Stone">@type</Badge>
                            }
                        </div>
                        @if (item.Description is { } description)
                        {
                            <Markdown Text="@description" class="text-sm" />
                        }
                        @if (item.LocationNote is { } where)
                        {
                            <span class="text-sm text-primary-600"><span class="cm-meta-label">Где:</span> @where</span>
                        }
                        @if (item.Notes is { } notes)
                        {
                            <Markdown Text="@notes" class="text-sm text-primary-600" />
                        }
                    </div>
                    <PartRowActions CanEdit="CanEdit" Reordering="Reordering" Busy="Busy" CanUp="index > 0" CanDown="index < ids.Count - 1"
                                    OnUp="() => MoveAsync(ScenarioPart.Items, ids, item.Id, -1)"
                                    OnDown="() => MoveAsync(ScenarioPart.Items, ids, item.Id, 1)"
                                    OnEdit="() => OpenForm(item)" OnDelete="() => RemoveAsync(item)" DeleteLabel="Убрать" />
                </div>
            }
        </div>
    }
</section>

<CatalogPickerModal TItem="ItemDto" Open="_picking" Title="Предмет из справочника" Load="LoadItemsAsync" Key="i => i.Id" Name="i => i.Name"
                    Meta="i => i.Type" Also="i => [i.Type]" Empty="Справочник предметов пуст."
                    Busy="_adding" Error="@_addError" OnPick="AddAsync" OnClose="() => _picking = false">
    <div class="grid grid-cols-1 gap-3">
        <Field Label="Где">
            <input class="cm-input" maxlength="@ScenarioLimits.ShortTextLength" @bind="_where" placeholder="в ящике стола" />
        </Field>
        <Field Label="Заметки">
            <textarea class="cm-input" rows="2" maxlength="@ScenarioLimits.TextLength" @bind="_notes"></textarea>
        </Field>
    </div>
</CatalogPickerModal>

<ScenarioItemModal Open="_formOpen" ScenarioId="Scenario.Id" Item="_editing" OnClose="() => _formOpen = false" OnSaved="SavedFormAsync" />

@code {
    private bool _picking;
    private bool _adding;
    private string? _addError;
    private string? _where;
    private string? _notes;
    private bool _formOpen;
    private ScenarioItemDto? _editing;

    private void OpenPicker()
    {
        (_where, _notes, _addError) = (null, null, null);
        _picking = true;
    }

    private void OpenForm(ScenarioItemDto? item)
    {
        _editing = item;
        _formOpen = true;
    }

    private async Task<IReadOnlyList<ItemDto>> LoadItemsAsync(CancellationToken cancellationToken) =>
        [.. (await ItemsApi.ListAsync(cancellationToken)).Items.OrderBy(i => i.Name, StringComparer.CurrentCulture)];

    private async Task AddAsync(ItemDto item)
    {
        _adding = true;
        _addError = null;
        try
        {
            await Api.AddItemAsync(Scenario.Id, new ScenarioItemInput(item.Id, null, null, _where, _notes));
            _picking = false;
            await SavedAsync($"«{item.Name}» в сценарии.");
        }
        catch (HttpRequestException ex)
        {
            _addError = ApiErrors.Describe(ex);
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task SavedFormAsync()
    {
        var wasNew = _editing is null;
        _formOpen = false;
        await SavedAsync(wasNew ? "Реквизит добавлен." : "Предмет сохранён.");
    }

    private Task RemoveAsync(ScenarioItemDto item) =>
        DeleteAsync($"Убрать «{item.Name}» из сценария?", item.ItemId is null ? "Свой реквизит удалится." : "В справочнике предмет останется.",
            () => Api.DeleteItemAsync(Scenario.Id, item.Id), "Предмет убран.", item.ItemId is null ? "Удалить" : "Убрать");
}
