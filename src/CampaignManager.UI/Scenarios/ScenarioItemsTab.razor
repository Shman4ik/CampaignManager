@inherits ScenarioTabBase
@using CampaignManager.UI.Platform
@inject ICatalogApi<ItemDto> ItemsApi

@* «Предметы» — из справочника (ссылкой) или свой предмет сценария (решение владельца: реквизит «Среди древних
   деревьев» перенесён так, а не в справочник). Способ добавить один — «Добавить предмет» открывает над списком панель
   поиска по справочнику (правило 6): нашёлся — добавляется сразу, нет — последняя строка «Добавить «текст»» открывает
   форму нового предмета с этим названием (раньше — две кнопки «Свой реквизит» и «Из справочника», ревью g4, 10.3). *@
<section class="cm-section">
    @* Заголовка секции над одноимённой вкладкой нет (правило 5): в строке действий вкладки — порядок и добавление. *@
    @if (CanEdit)
    {
        <div class="cm-btn-row mb-3 justify-end">
            @if (Scenario.Items.Count > 1)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-down-up-across-line"
                        OnClick="() => Reordering = !Reordering">@(Reordering ? "Готово" : "Порядок")</Button>
            }
            @if (!Reordering)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="add-item" OnClick="() => _searching = !_searching">Добавить предмет</Button>
            }
        </div>
        @if (_searching && !Reordering)
        {
            <div class="cm-card mb-3" data-testid="item-search">
                <div class="cm-card-body">
                    <CatalogSearch TItem="ItemDto" Load="LoadItemsAsync" Name="i => i.Name" Meta="i => i.Type ?? string.Empty" Also="i => [i.Type ?? string.Empty]"
                                   Placeholder="Название предмета: найти в справочнике или завести новый" OnSelect="AddFromCatalogAsync" OnCustom="AddOwn"
                                   OnCancel="() => _searching = false" />
                </div>
            </div>
        }
    }
    @if (Scenario.Items.Count == 0)
    {
        <EmptyState Compact="true" Title="Нет предметов." />
    }
    else
    {
        var ids = Scenario.Items.Select(i => i.Id).ToList();
        <div class="cm-card" data-testid="item-list">
            @foreach (var item in Scenario.Items)
            {
                var index = ids.IndexOf(item.Id);
                <div class="flex flex-wrap items-start gap-3 border-t border-primary-200 px-4 py-2 first:border-t-0" @key="item.Id" data-testid="item-row">
                    @if (ImageUrls.Thumb(item.ImageUrl, 160) is { } image)
                    {
                        <img src="@image" alt="" class="h-12 w-12 shrink-0 rounded-md object-cover" loading="lazy" />
                    }
                    @{
                        var expandable = item.Description is not null || item.Notes is not null;
                        var open = _open.Contains(item.Id);
                    }
                    <div class="flex min-w-48 flex-1 flex-col gap-1">
                        @if (expandable)
                        {
                            <button type="button" class="flex min-h-11 items-center gap-2 text-left" aria-expanded="@(open ? "true" : "false")"
                                    @onclick="() => Toggle(item.Id)">
                                <i class="fa-solid @(open ? "fa-chevron-down" : "fa-chevron-right") w-3 text-xs text-primary-500" aria-hidden="true"></i>
                                @ItemTitle(item)
                            </button>
                        }
                        else
                        {
                            <div class="flex min-h-11 items-center gap-2">@ItemTitle(item)</div>
                        }
                        @if (item.LocationNote is { } where)
                        {
                            <span class="text-sm text-primary-600"><span class="cm-meta-label">Где:</span> @where</span>
                        }
                        @if (open)
                        {
                            @if (item.Description is { } description)
                            {
                                <Markdown Text="@description" class="max-w-prose text-sm" />
                            }
                            @if (item.Notes is { } notes)
                            {
                                <Markdown Text="@notes" class="max-w-prose text-sm text-primary-600" />
                            }
                        }
                    </div>
                    <PartRowActions CanEdit="CanEdit" Reordering="Reordering" Busy="Busy" CanUp="index > 0" CanDown="index < ids.Count - 1"
                                    OnUp="() => MoveAsync(ScenarioPart.Items, ids, item.Id, -1)"
                                    OnDown="() => MoveAsync(ScenarioPart.Items, ids, item.Id, 1)"
                                    OnEdit="() => OpenForm(item)" OnDelete="() => RemoveAsync(item)" DeleteLabel="@(item.ItemId is null ? "Удалить" : "Убрать")" Name="@item.Name" />
                </div>
            }
        </div>
    }
</section>

<ScenarioItemModal Open="_formOpen" ScenarioId="Scenario.Id" Item="_editing" InitialName="@_newName" OnClose="() => _formOpen = false" OnSaved="SavedFormAsync" />

@code {
    private readonly HashSet<Guid> _open = [];
    private bool _searching;
    private bool _formOpen;
    private ScenarioItemDto? _editing;
    private string? _newName;

    private void Toggle(Guid id)
    {
        if (!_open.Remove(id))
            _open.Add(id);
    }

    private RenderFragment ItemTitle(ScenarioItemDto item) => @<span class="flex flex-wrap items-center gap-2">
        <span class="font-semibold text-primary-900">@item.Name</span>
        @* Метка — только у предмета справочника (тип): «свой» у четырёх из пяти ничего не различал (правило 17). *@
        @if (item.ItemId is not null && item.Type is { } type)
        {
            <Badge Tone="Tone.Stone">@type</Badge>
        }
    </span>;

    private void OpenForm(ScenarioItemDto? item)
    {
        _editing = item;
        _newName = null;
        _formOpen = true;
    }

    /// <summary>В справочнике такого нет: форма нового предмета с вписанным названием.</summary>
    private void AddOwn(string name)
    {
        _editing = null;
        _newName = name;
        _searching = false;
        _formOpen = true;
    }

    private async Task<IReadOnlyList<ItemDto>> LoadItemsAsync() =>
        [.. (await ItemsApi.ListAsync()).Items.OrderBy(i => i.Name, StringComparer.CurrentCulture)];

    /// <summary>Предмет справочника — сразу в сценарий; «Где лежит» и заметки — потом, в «Изменить».</summary>
    private Task AddFromCatalogAsync(ItemDto item)
    {
        _searching = false;
        return RunAsync(() => Api.AddItemAsync(Scenario.Id, new ScenarioItemInput(item.Id)), $"Добавлено в сценарий: {item.Name}.");
    }

    private async Task SavedFormAsync()
    {
        var wasNew = _editing is null;
        _formOpen = false;
        await SavedAsync(wasNew ? "Предмет добавлен." : "Предмет сохранён.");
    }

    private Task RemoveAsync(ScenarioItemDto item) =>
        DeleteAsync(item.ItemId is null ? "Удалить предмет?" : "Убрать предмет из сценария?", item.Name,
            item.ItemId is null ? "Описание и заметки удалятся вместе с ним." : "В справочнике предмет останется.",
            () => Api.DeleteItemAsync(Scenario.Id, item.Id), item.ItemId is null ? "Предмет удалён." : "Предмет убран.", item.ItemId is null ? "Удалить" : "Убрать");
}
