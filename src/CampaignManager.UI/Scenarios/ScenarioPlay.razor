@using System.Globalization
@using CampaignManager.Contracts.Characters
@using CampaignManager.Core
@using CampaignManager.Core.Campaigns
@using CampaignManager.Core.Catalogs
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Checks
@using CampaignManager.Core.Music
@using CampaignManager.UI.Platform
@inject IScenariosApi Api
@inject ICharactersApi Characters
@inject ICatalogApi<SkillDto> Skills
@inject NavigationManager Navigation

@* Режим игры (T2.5b, UX-1): локации слева, открытая локация (или обзор) в центре, раздатки и факты справа. Всё, что
   открыто, — в адресе (?mode=play&location=&handout=&run=, ScenarioLinks.Play), переходы — с replace: перезагрузка
   возвращает тот же экран, «Назад» ведёт со сценария. Колонки — прямые дети .cm-play (Styles/scenario.css): каждая
   прокручивается сама, а место панели плеера внизу колонки .cm-main остаётся само. Уже lg (iPad в портрете и телефон)
   дерево локаций — выпадающий список над локацией (решение владельца: в портрете центру нужна вся ширина), правая колонка —
   выдвижная панель. Над локацией одна строка: партия (подпись, если одна; список, если их несколько) и «Бой»/«Погоня» —
   прежние два-три ряда съедали ~100px из ~620 на каждой локации.
   Проверка локации — общий диалог Checks по сыщикам кампании выбранной партии (листы только читаются: Удачу и отметку
   игрок ставит у себя); без партии — вручную. Проверки стоят над описанием локации: самое частое действие за столом.
   Раздатка игрокам — HandoutShowcase, второй экран — статическая страница сервера. *@

@if (IsEmpty)
{
    @* Пустой сценарий играть нечем: одна строка вместо трёх колонок (в шапке рабочего места «Режим игры» для него не предлагается). *@
    <div class="cm-play-center" data-testid="play-empty">
        <p class="cm-text-muted flex flex-wrap items-center gap-x-3 p-6">
            <span>В сценарии нет ни локаций, ни раздаток, ни фактов — играть пока нечем.</span>
            <a class="cm-back-link" href="@ScenarioLinks.Workspace(Scenario.Id)">Открыть рабочее место</a>
        </p>
    </div>
}
else
{
    <aside class="cm-play-side hidden w-56 border-r border-primary-200 lg:flex xl:w-64" aria-label="Локации" data-testid="play-locations">
        <p class="cm-section-title px-4 pb-1 pt-3">Локации</p>
        <nav class="flex flex-col gap-0.5 p-2">
            <button type="button" class="@NavClass(null, 0)" aria-current="@(Location is null ? "true" : null)" @onclick="() => GoLocation(null)">
                <span class="min-w-0 flex-1 font-medium">Обзор</span>
            </button>
            @foreach (var (location, depth) in LocationTree.WithDepth(Scenario.Locations))
            {
                var id = location.Id;
                <button type="button" class="@NavClass(id, depth)" aria-current="@(Location?.Id == id ? "true" : null)" @key="id"
                        data-testid="play-location" @onclick="() => GoLocation(id)">
                    @* Названия — без значка-пина перед каждым (все одинаковые): вложенность видна по отступу.
                       Целиком, с переносом: на планшете наведения нет, а обрезанное «День 2. Утёс Юджина Кле…» не прочесть. *@
                    <span class="@(depth == 0 ? "font-medium" : null) min-w-0 flex-1 break-words">@location.Name</span>
                    @if (_visited.Contains(id) && Location?.Id != id)
                    {
                        <i class="fa-solid fa-check text-xs text-success-700" aria-hidden="true"></i><span class="sr-only">уже были</span>
                    }
                    @if (HasMusic(location))
                    {
                        <i class="fa-solid fa-music text-xs text-primary-500" aria-hidden="true"></i><span class="sr-only">есть музыка</span>
                    }
                </button>
            }
        </nav>
    </aside>

    <div class="cm-play-center" data-testid="play-center">
        <div class="flex flex-col gap-4 p-4 sm:p-6">
            <div class="flex flex-wrap items-center gap-2 lg:hidden">
                <select class="cm-input w-full min-w-0 sm:w-auto sm:flex-1" aria-label="Локация" data-testid="play-location-select" @onchange="SelectLocation">
                    <option value="" selected="@(Location is null)">Обзор</option>
                    @foreach (var (location, depth) in LocationTree.WithDepth(Scenario.Locations))
                    {
                        <option value="@location.Id" selected="@(Location?.Id == location.Id)">@(new string('·', depth * 2)) @location.Name</option>
                    }
                </select>
                <Button Variant="ButtonVariant.Secondary" Icon="fa-key" data-testid="open-facts"
                        OnClick="() => _factsOpen = true">Раздатки и факты</Button>
            </div>
            @RunBar

            @if (Location is null)
            {
                @Overview
            }
            else
            {
                @LocationView(Location)
            }
        </div>
    </div>

    @* Третья колонка — с lg: на ландшафте iPad Pro 11" (1194) раздатки и факты — главное действие сцены, за кнопкой их
       не держим. На lg колонки уже (локации 224, факты 320), центру остаётся ~560px — строка текста локации. В портрете
       (уже lg) дерева и этой колонки нет: локации — выпадающий список, раздатки и факты — выдвижная панель. *@
    <aside class="cm-play-side hidden w-80 border-l border-primary-200 p-4 lg:flex xl:w-96" aria-label="Раздатки и факты">
        <PlayFactsPanel Scenario="Scenario" OnShowHandout="ShowHandout" />
    </aside>

    @* w-[30rem]: шире строки текста раздаток уходили за 100 знаков. *@
    <Modal Open="_factsOpen" OnClose="() => _factsOpen = false" Title="Раздатки и факты" Placement="ModalPlacement.Drawer" class="w-[30rem]" data-testid="facts-drawer">
        <PlayFactsPanel Scenario="Scenario" OnShowHandout="ShowHandout" />
    </Modal>
}

<SkillCheckModal Open="@(_check is not null)" OpenChanged="CheckOpenChanged"
                 Title="@(_check is null ? "Проверка" : $"Проверка: {ScenarioLabels.Target(_check)}")"
                 Party="@_party" Catalog="@_catalog"
                 InitialKey="@(_check is null ? null : CheckSubjects.KeyFor(_check.TargetKind, _check.SkillId, _check.Characteristic))"
                 InitialName="@(_check is null ? null : ScenarioLabels.Target(_check))"
                 InitialDifficulty="@(_check?.Difficulty ?? Difficulty.Regular)"
                 InitialInvestigatorId="@(_checkInvestigatorId ?? SoleInvestigatorId)" OnInvestigatorChanged="id => _checkInvestigatorId = id">
    <Details>
        @* Выпавший исход — сразу под броском, цветным блоком; второй не мешает читать первый: он свёрнут. *@
        @if (_check is not null && (_check.OnSuccess is not null || _check.OnFailure is not null))
        {
            var (hit, hitTitle, miss, missTitle) = context
                ? (_check.OnSuccess, "Успех", _check.OnFailure, "Провал")
                : (_check.OnFailure, "Провал", _check.OnSuccess, "Успех");
            <div class="flex flex-col gap-2" data-testid="check-scenario-outcomes">
                @if (hit is not null)
                {
                    <div class="@(context ? "border-success-300 bg-success-50" : "border-error-300 bg-error-50") rounded-md border px-3 py-2" data-testid="check-outcome-hit">
                        <p class="@(context ? "text-success-700" : "text-error-700") text-sm font-semibold uppercase">@hitTitle</p>
                        <Markdown Text="@hit" />
                    </div>
                }
                @if (miss is not null)
                {
                    <details data-testid="check-outcome-miss">
                        <summary class="cm-tap-row cursor-pointer text-sm text-primary-600">Если выпадет иначе: @missTitle.ToLowerInvariant()</summary>
                        <Markdown Text="@miss" class="text-sm" />
                    </details>
                }
            </div>
        }
    </Details>
</SkillCheckModal>

<HandoutShowcase Handout="ShownHandout" OnClose="HideHandout" />

<LocationMusicModal Open="_musicOpen" ScenarioId="Scenario.Id" Location="Location" OnClose="() => _musicOpen = false" OnSaved="MusicSavedAsync" />

@code {
    private readonly HashSet<Guid> _openChecks = [];
    private readonly HashSet<Guid> _visited = [];
    private IReadOnlyList<ScenarioRunDto>? _runs;
    private string? _runsError;
    private Guid? _partyCampaignId;
    private IReadOnlyList<CheckInvestigator>? _party;
    private SkillCatalog? _catalog;
    private string? _partyError;
    private ScenarioCheckDto? _check;

    // Сыщик, которого проверяли в прошлый раз: между проверками локации его не выбирают заново. Пока никого не выбирали, а в
    // партии один сыщик, — он и предвыбран (SoleInvestigatorId): окно открывается сразу со значением навыка, а не с «вписать вручную».
    private Guid? _checkInvestigatorId;
    private bool _factsOpen;
    private bool _musicOpen;

    [Parameter, EditorRequired] public ScenarioDto Scenario { get; set; } = null!;

    /// <summary>Открытая локация (<c>?location=</c>); нет или не найдена — обзор.</summary>
    [Parameter] public Guid? LocationId { get; set; }

    /// <summary>Раздатка, показанная игрокам (<c>?handout=</c>).</summary>
    [Parameter] public Guid? HandoutId { get; set; }

    /// <summary>Выбранная партия (<c>?run=</c>); нет — первая незавершённая.</summary>
    [Parameter] public Guid? RunId { get; set; }

    /// <summary>Сценарий изменился (музыка локации) — страница перечитывает его.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool IsEmpty => Scenario.Locations.Count + Scenario.Handouts.Count + Scenario.KeyFacts.Count == 0;

    private ScenarioLocationDto? Location => LocationId is { } id ? Scenario.Locations.FirstOrDefault(l => l.Id == id) : null;

    private HandoutScreenDto? ShownHandout =>
        HandoutId is { } id && Scenario.Handouts.FirstOrDefault(h => h.Id == id) is { } handout
            ? HandoutScreenDto.Of(Scenario.Id, handout, Scenario.CanEdit)
            : null;

    private Guid? SoleInvestigatorId => _party is { Count: 1 } ? _party[0].Id : null;

    /// <summary>Партии, по которым играют: завершённая не предлагается — у неё нет ни боя, ни проверок со своими сыщиками.</summary>
    private IReadOnlyList<ScenarioRunDto> ActiveRuns => [.. (_runs ?? []).Where(r => r.Status != ScenarioRunStatus.Finished)];

    private ScenarioRunDto? ActiveRun =>
        _runs is null ? null
        : RunId is { } id && ActiveRuns.FirstOrDefault(r => r.Id == id) is { } chosen ? chosen
        : ActiveRuns.FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        if (LocationId is { } opened)
            _visited.Add(opened);

        if (_runs is null && _runsError is null)
        {
            try
            {
                _runs = await Api.ListRunsAsync(Scenario.Id);
            }
            catch (HttpRequestException ex)
            {
                _runsError = ApiErrors.Describe(ex);
            }
        }

        await LoadPartyAsync(ActiveRun?.CampaignId);
    }

    /// <summary>Сыщики кампании партии с листами (только чтение) и справочник навыков — для диалога проверки.</summary>
    private async Task LoadPartyAsync(Guid? campaignId)
    {
        if (campaignId == _partyCampaignId && (_party is not null || _partyError is not null || campaignId is null))
            return;

        _partyCampaignId = campaignId;
        _party = null;
        _partyError = null;
        if (campaignId is not { } id)
            return;

        try
        {
            var investigators = await Characters.GetCampaignInvestigatorsAsync(id);
            _catalog ??= SkillCatalogs.From((await Skills.ListAsync()).Items);
            _party = [.. investigators.Select(i => new CheckInvestigator(i.CharacterId, i.Name, i.Sheet, i.PlayerName))];
        }
        catch (HttpRequestException ex)
        {
            _partyError = ApiErrors.Describe(ex);
        }
    }

    /// <summary>
    /// Одна строка над локацией: чьи сыщики идут в проверки и «Бой»/«Погоня» этой партии. Одна партия — подпись без списка
    /// (выбирать не из чего), несколько — список из названий кампаний; нет ни одной незавершённой — «проверки вручную»
    /// (список с завершённой партией показывал бы её выбранной, хотя ни сыщиков, ни боя у неё нет).
    /// </summary>
    private RenderFragment RunBar => __builder =>
    {
        if (_runsError is not null)
        {
            <Alert Tone="Tone.Error" Small="true" class="mb-0">@_runsError</Alert>
        }
        else if (_runs is not null && ActiveRuns.Count == 0)
        {
            <p class="cm-text-muted flex flex-wrap items-center gap-x-3 text-sm" data-testid="play-no-runs">
                <span>Нет партии — проверки вручную.</span>
                <a class="cm-back-link" href="@ScenarioLinks.Workspace(Scenario.Id)">Начать игру</a>
            </p>
        }
        else if (_runs is not null)
        {
            <div class="flex flex-wrap items-center gap-2" data-testid="play-run-bar">
                @if (ActiveRuns.Count == 1)
                {
                    <span class="flex min-h-11 min-w-0 flex-1 items-center gap-2 text-sm font-medium text-primary-800" data-testid="play-run">
                        <i class="fa-solid fa-dice w-4 shrink-0 text-primary-500" aria-hidden="true"></i>
                        <span class="sr-only">Партия:</span>
                        <span class="min-w-0 break-words">@RunLabel(ActiveRuns[0])</span>
                    </span>
                }
                else
                {
                    <select class="cm-input min-w-0 flex-1" aria-label="Партия: чьи сыщики в проверках" data-testid="play-run" @onchange="SelectRun">
                        @foreach (var run in ActiveRuns)
                        {
                            <option value="@run.Id" selected="@(ActiveRun?.Id == run.Id)">@RunLabel(run)</option>
                        }
                    </select>
                }
                @if (ActiveRun is { CanEdit: true } combatRun)
                {
                    @* Бой с этой партией (T2.6d): сцена стартует сразу в кампании партии, окно участника предложит её сценарий. *@
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-hand-fist" data-testid="play-combat"
                            OnClick="() => Navigation.NavigateTo(ScenarioLinks.Combat(combatRun))">Бой</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-person-running" data-testid="play-chase"
                            OnClick="() => Navigation.NavigateTo(ScenarioLinks.Chase(combatRun))">Погоня</Button>
                }
                @if (_partyError is not null)
                {
                    <Alert Tone="Tone.Error" Small="true" class="mb-0 basis-full">@_partyError</Alert>
                }
                else if (_party is { Count: 0 })
                {
                    <span class="cm-text-muted basis-full text-sm">В кампании нет активных сыщиков.</span>
                }
            </div>
        }
    };

    // Обзор — не стена текста: название сценария уже в шапке, поэтому здесь краткое описание, метки и «Текст сценария»
    // по раскрытию (длинный Markdown первым экраном уводил всё остальное вниз).
    private RenderFragment Overview => __builder =>
    {
        <section class="flex flex-col gap-3" data-testid="play-overview">
            @if (Scenario.Setting is not null || Scenario.Era is Era.Modern || Scenario.SettingDate is not null)
            {
                <div class="flex flex-wrap gap-1.5">
                    @if (Scenario.Setting is { } setting)
                    {
                        <Badge Icon="fa-map-pin" class="max-w-full whitespace-normal">@setting</Badge>
                    }
                    @if (Scenario.SettingDate is { } date)
                    {
                        <Badge Icon="fa-calendar">@date</Badge>
                    }
                    @* Эпоха — только современная: классическая в каждом сценарии ничего не различает (правило 12). *@
                    @if (Scenario.Era is Era.Modern)
                    {
                        <Badge Tone="Tone.Stone">@CatalogText.Of(Era.Modern)</Badge>
                    }
                </div>
            }
            @if (Scenario.Summary is { } summary)
            {
                <p class="whitespace-pre-line text-primary-800">@summary</p>
            }
            @if (Scenario.BodyMd is { } body)
            {
                <details class="group border-t border-primary-200 pt-2" data-testid="play-body">
                    @* Шеврон: без него раскрывающийся текст похож на жирную подпись. *@
                    <summary class="cm-tap-row cursor-pointer list-none font-semibold text-primary-800 [&::-webkit-details-marker]:hidden">
                        <i class="fa-solid fa-chevron-down w-4 text-xs text-primary-500 transition-transform group-open:rotate-180" aria-hidden="true"></i>Текст сценария
                    </summary>
                    <Markdown Text="@body" class="pt-2" />
                </details>
            }
        </section>
    };

    private RenderFragment LocationView(ScenarioLocationDto location) => __builder =>
    {
        var pool = MusicPool.Of(location.MusicTags, location.TrackIds);
        var children = Scenario.Locations.Where(l => l.ParentId == location.Id).ToList();
        <section class="flex flex-col gap-4" data-testid="play-location-detail">
            <div class="flex flex-wrap items-start gap-2">
                <div class="min-w-0 flex-1 basis-56">
                    @if (location.ParentId is not null)
                    {
                        <p class="cm-text-muted text-sm">@LocationTree.Path(Scenario.Locations, location.ParentId.Value)</p>
                    }
                    <h2 class="cm-title-serif text-2xl text-primary-900">@location.Name</h2>
                    @if (location.Address is { } address)
                    {
                        <p class="cm-text-muted text-sm"><i class="fa-solid fa-map-pin mr-1" aria-hidden="true"></i>@address</p>
                    }
                </div>
            </div>

            @* Музыка — выше описания: атмосферу включают до того, как начинают зачитывать сцену (v1). «Музыка» (настройка) —
               значок и слово рядом с «Играть музыку», а не тяжёлой кнопкой справа от заголовка: заголовок получает всю ширину. *@
            @if (!pool.IsEmpty || Scenario.CanEdit)
            {
                <div class="flex flex-wrap items-center gap-2">
                    @if (!pool.IsEmpty)
                    {
                        <MusicPoolButton Pool="pool" Label="@location.Name" />
                        @if (location.MusicTags.Count > 0)
                        {
                            <span class="cm-text-muted text-sm">@string.Join(", ", location.MusicTags)</span>
                        }
                    }
                    @if (Scenario.CanEdit)
                    {
                        <Button Variant="ButtonVariant.Secondary" Icon="fa-sliders" AriaLabel="@(pool.IsEmpty ? "Настроить музыку локации" : "Изменить музыку локации")"
                                data-testid="location-music" OnClick="() => _musicOpen = true">Музыка</Button>
                    }
                </div>
            }

            @* Проверки — над описанием: самое частое действие за столом, а длинное описание уводило их за край экрана. *@
            @if (location.Checks.Count > 0)
            {
                <div>
                    <h3 class="cm-section-title mb-1"><i class="fa-solid fa-dice-d20 mr-1 text-accent-600" aria-hidden="true"></i>Проверки</h3>
                    <div class="cm-card" data-testid="play-checks">
                        @foreach (var check in location.Checks)
                        {
                            var current = check;
                            var open = IsCheckOpen(check, location);
                            <div class="border-t border-primary-200 px-3 first:border-t-0" @key="check.Id" data-testid="play-check">
                                @* «Проверить» — рядом со строкой, а не внутри: кнопка в кнопке — невалидная разметка (v1). *@
                                @* py-1.5: кнопка 44px в строке 44px упиралась в рамку соседней проверки. *@
                                <div class="flex items-center gap-2 py-1.5">
                                    <button type="button" class="flex min-h-11 min-w-0 flex-1 flex-wrap items-center gap-2 text-left"
                                            aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleCheck(current)">
                                        <i class="fa-solid @(open ? "fa-chevron-down" : "fa-chevron-right") w-3 text-xs text-primary-500" aria-hidden="true"></i>
                                        <span class="font-semibold text-primary-900">@ScenarioLabels.Target(check)</span>
                                        @if (ScenarioLabels.Difficulty(check) is { } difficulty)
                                        {
                                            <Badge Tone="@(check.Difficulty == Difficulty.Extreme ? Tone.Error : Tone.Warning)">@difficulty</Badge>
                                        }
                                    </button>
                                    <Button Variant="ButtonVariant.Secondary" Icon="fa-dice-d20" data-testid="run-check"
                                            OnClick="() => _check = current">Проверить</Button>
                                </div>
                                @if (open)
                                {
                                    <div class="flex flex-col gap-2 pb-3 pl-5">
                                        @if (check.OnSuccess is { } success)
                                        {
                                            <div>
                                                <p class="text-sm font-semibold uppercase text-success-700">Успех</p>
                                                <Markdown Text="@success" class="text-sm" />
                                            </div>
                                        }
                                        @if (check.OnFailure is { } failure)
                                        {
                                            <div>
                                                <p class="text-sm font-semibold uppercase text-error-700">Провал</p>
                                                <Markdown Text="@failure" class="text-sm" />
                                            </div>
                                        }
                                        @if (check.OnSuccess is null && check.OnFailure is null)
                                        {
                                            <p class="cm-text-muted text-sm">Исходы не записаны.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <Markdown Text="@location.Description" />

            @if (children.Count > 0)
            {
                @* Дерево слева (с lg) вложенные показывает всегда; кнопки нужны, только пока дерева нет — в портрете и на телефоне. *@
                <div class="lg:hidden">
                    <h3 class="cm-section-title mb-2">Вложенные локации</h3>
                    <div class="cm-btn-row">
                        @foreach (var child in children)
                        {
                            var id = child.Id;
                            <Button Variant="ButtonVariant.Secondary" Icon="fa-angle-right" OnClick="() => GoLocation(id)">@child.Name</Button>
                        }
                    </div>
                </div>
            }
        </section>
    };

    private string NavClass(Guid? id, int depth) => Css.Join(
        "flex min-h-11 w-full items-center gap-2 rounded-md py-1.5 pr-2 text-left text-sm",
        depth switch { 0 => "pl-3", 1 => "pl-7", 2 => "pl-11", _ => "pl-15" },
        (id is null ? Location is null : Location?.Id == id)
            ? "bg-accent-100 font-semibold text-accent-800"
            : "text-primary-700 hover:bg-primary-100");

    private static bool HasMusic(ScenarioLocationDto location) => location.MusicTags.Count > 0 || location.TrackIds.Count > 0;

    /// <summary>Название кампании; если у двух партий оно одно — с датой (время — в поясе браузера, решение владельца).</summary>
    private string RunLabel(ScenarioRunDto run)
    {
        var same = ActiveRuns.Count(r => string.Equals(r.CampaignName, run.CampaignName, StringComparison.CurrentCultureIgnoreCase)) > 1;
        return same && run.ScheduledAt is { } at
            ? $"{run.CampaignName} · {at.ToLocalTime().ToString("d MMMM, HH:mm", CultureInfo.CurrentCulture)}"
            : run.CampaignName;
    }

    private void CheckOpenChanged(bool open)
    {
        if (!open)
            _check = null;
    }

    // Исходы раскрыты сразу у единственной проверки локации (её и играют): _openChecks хранит отступление от умолчания.
    private bool IsCheckOpen(ScenarioCheckDto check, ScenarioLocationDto location) =>
        _openChecks.Contains(check.Id) != (location.Checks.Count == 1);

    private void ToggleCheck(ScenarioCheckDto check)
    {
        if (!_openChecks.Remove(check.Id))
            _openChecks.Add(check.Id);
    }

    /// <summary>Другая локация — показ раздатки закрывается (v1, <c>GoTo</c>); партия остаётся.</summary>
    private void GoLocation(Guid? locationId) =>
        Navigation.NavigateTo(ScenarioLinks.Play(Scenario.Id, locationId, null, RunId), replace: true);

    private void SelectLocation(ChangeEventArgs e) => GoLocation(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private void SelectRun(ChangeEventArgs e) =>
        Navigation.NavigateTo(ScenarioLinks.Play(Scenario.Id, LocationId, HandoutId, Guid.TryParse(e.Value?.ToString(), out var id) ? id : null),
            replace: true);

    private void ShowHandout(Guid handoutId)
    {
        _factsOpen = false;
        Navigation.NavigateTo(ScenarioLinks.Play(Scenario.Id, LocationId, handoutId, RunId), replace: true);
    }

    private void HideHandout() => Navigation.NavigateTo(ScenarioLinks.Play(Scenario.Id, LocationId, null, RunId), replace: true);

    private async Task MusicSavedAsync()
    {
        _musicOpen = false;
        await OnChanged.InvokeAsync();
    }
}
