@* Галерея локации во весь экран (режим игры): касание обложки у названия открывает её. Окно — общий Modal с Placement Showcase
   (тёмный фон, верхний слой над шапкой и плеером, крестик и Esc закрывают); внутри — CatalogImageGallery справочников (большая
   картинка и миниатюры по касанию), вписанная в высоту экрана (cm-location-showcase, Styles/scenario.css). Это просмотр
   Хранителя, не показ раздатки: второго экрана и адреса у него нет. *@
<Modal Open="@(Location is not null)" OnClose="OnClose" Title="@(Location?.Name ?? "")" Placement="ModalPlacement.Showcase"
       data-testid="location-showcase">
    @if (Location is { Images.Count: > 0 } location)
    {
        <div class="cm-location-showcase">
            <CatalogImageGallery Images="location.Images" Alt="@location.Name" @key="location.Id" />
        </div>
    }
</Modal>

@code {
    /// <summary>Локация, чья галерея открыта; <c>null</c> — закрыто.</summary>
    [Parameter] public ScenarioLocationDto? Location { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
}
