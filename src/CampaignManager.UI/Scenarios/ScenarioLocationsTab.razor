@inherits ScenarioTabBase

@* «Локации» — дерево: вложенная локация с отступом под родителем. Касание имени раскрывает описание (Markdown) и
   проверки. «Добавить вложенную локацию» (в раскрытой строке) заводит локацию сразу внутри этой; «Изменить» — значок-карандаш,
   музыка — в «⋯» строки (ревью g4, 6.1, 6.3). Порядок — среди соседей («Порядок» → «Выше»/«Ниже»).
   Удаление уносит вложенные локации и их проверки — диалог говорит об этом. *@
<section class="cm-section">
    @* Заголовка «Локации» над вкладкой «Локации» нет (правило 5): в строке действий вкладки — порядок и добавление. *@
    @if (CanEdit)
    {
        <div class="cm-btn-row mb-3 justify-end">
            @if (Scenario.Locations.Count > 1)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-down-up-across-line"
                        OnClick="() => Reordering = !Reordering">@(Reordering ? "Готово" : "Порядок")</Button>
            }
            @if (!Reordering)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="add-location" OnClick="() => Open(null, null)">Добавить локацию</Button>
            }
        </div>
    }
    @if (Scenario.Locations.Count == 0)
    {
        <EmptyState Compact="true" Title="Нет локаций." />
    }
    else
    {
        <div class="cm-card" data-testid="location-list">
            @foreach (var (location, depth) in LocationTree.WithDepth(Scenario.Locations))
            {
                var siblings = LocationTree.Siblings(Scenario.Locations, location);
                var index = siblings.ToList().IndexOf(location.Id);
                var open = _open.Contains(location.Id);
                <div class="@Css.Join("border-t border-primary-200 py-2 pr-4 first:border-t-0", Indent(depth))" @key="location.Id"
                     data-testid="location-row">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <button type="button" class="flex min-h-11 min-w-0 flex-1 items-start gap-2 text-left" aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => Toggle(location.Id)">
                            <i class="fa-solid @(open ? "fa-chevron-down" : "fa-chevron-right") mt-1 w-3 text-xs text-primary-400" aria-hidden="true"></i>
                            <span class="flex min-w-0 flex-col">
                                <span class="font-semibold text-primary-900">
                                    @location.Name
                                </span>
                                @if (location.Address is { } address)
                                {
                                    <span class="text-sm text-primary-600">@address</span>
                                }
                            </span>
                        </button>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (Scenario.Locations.Count(l => l.ParentId == location.Id) is > 0 and var inner)
                            {
                                <Badge Icon="fa-location-dot">@ScenarioLabels.Plural(inner, "вложенная", "вложенные", "вложенных")</Badge>
                            }
                            @if (location.Checks.Count > 0)
                            {
                                <Badge Tone="Tone.Info" Icon="fa-dice-d20">@ScenarioLabels.ChecksCount(location.Checks.Count)</Badge>
                            }
                            @if (location.MusicTags.Count > 0 || location.TrackIds.Count > 0)
                            {
                                <Badge Icon="fa-music">музыка</Badge>
                            }
                            <PartRowActions CanEdit="CanEdit" Reordering="Reordering" Busy="Busy" CanUp="index > 0" CanDown="index < siblings.Count - 1"
                                            OnUp="() => MoveAsync(ScenarioPart.Locations, siblings, location.Id, -1)"
                                            OnDown="() => MoveAsync(ScenarioPart.Locations, siblings, location.Id, 1)"
                                            OnEdit="() => Open(location, null)" OnDelete="() => RemoveAsync(location)" Name="@location.Name">
                                <MenuItems>
                                    <RowMenuItem Icon="fa-sliders" Disabled="Busy" OnClick="() => _music = location">Изменить музыку</RowMenuItem>
                                </MenuItems>
                            </PartRowActions>
                        </div>
                    </div>
                    @if (open)
                    {
                        <div class="mt-1 mb-2 flex flex-col gap-3 pl-5">
                            @if (location.Description is { } description)
                            {
                                <Markdown Text="@description" class="max-w-prose" />
                            }
                            else
                            {
                                <p class="cm-text-muted">Описания нет.</p>
                            }
                            @if (location.MusicTags.Count > 0 || location.TrackIds.Count > 0)
                            {
                                <p class="text-sm text-primary-600">
                                    <i class="fa-solid fa-music mr-1 text-primary-400" aria-hidden="true"></i>
                                    @(location.MusicTags.Count > 0 ? string.Join(", ", location.MusicTags) : "без настроений")
                                    @if (location.TrackIds.Count > 0)
                                    {
                                        <span> · закреплено треков: @location.TrackIds.Count</span>
                                    }
                                </p>
                            }
                            @if (location.Checks.Count > 0)
                            {
                                @* Подзаголовок внутри карточки — жирный без капса (правило 5); исход каждой проверки — две короткие строки. *@
                                <div class="flex max-w-prose flex-col gap-2 text-sm">
                                    <p class="font-semibold text-primary-900">Исходы проверок</p>
                                    @foreach (var check in location.Checks)
                                    {
                                        <div @key="check.Id" class="flex flex-col gap-0.5">
                                            <span class="font-semibold text-primary-800">
                                                @ScenarioLabels.Target(check)
                                                @if (ScenarioLabels.Difficulty(check) is { } difficulty)
                                                {
                                                    <span class="font-normal text-warning-800"> · @difficulty</span>
                                                }
                                            </span>
                                            @if (check.OnSuccess is { } success)
                                            {
                                                <span class="text-primary-700"><span class="font-medium text-success-700">Успех:</span> @success</span>
                                            }
                                            @if (check.OnFailure is { } failure)
                                            {
                                                <span class="text-primary-700"><span class="font-medium text-error-700">Провал:</span> @failure</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            <div class="cm-btn-row">
                                @if (CanEdit)
                                {
                                    <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" Disabled="Busy" data-testid="add-nested"
                                            OnClick="() => Open(null, location.Id)">Добавить вложенную локацию</Button>
                                }
                                <Button Variant="ButtonVariant.Secondary" Icon="fa-play"
                                        Href="@ScenarioLinks.Play(Scenario.Id, location.Id)">Открыть в режиме игры</Button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

<LocationFormModal Open="_formOpen" ScenarioId="Scenario.Id" Location="_editing" Locations="Scenario.Locations" DefaultParentId="_parentId"
                   OnClose="() => _formOpen = false" OnSaved="SavedFormAsync" />

<LocationMusicModal Open="@(_music is not null)" ScenarioId="Scenario.Id" Location="_music" OnClose="() => _music = null" OnSaved="MusicSavedAsync" />

@code {
    private readonly HashSet<Guid> _open = [];
    private bool _formOpen;
    private ScenarioLocationDto? _editing;
    private Guid? _parentId;
    private ScenarioLocationDto? _music;

    private async Task MusicSavedAsync()
    {
        _music = null;
        await SavedAsync("Музыка локации сохранена.");
    }

    /// <summary>Отступ уровня дерева — целыми классами (Tailwind ищет их текстом); глубже третьего — как третий.</summary>
    private static string Indent(int depth) => depth switch
    {
        0 => "pl-4",
        1 => "pl-10",
        2 => "pl-16",
        _ => "pl-22",
    };

    private void Toggle(Guid id)
    {
        if (!_open.Remove(id))
            _open.Add(id);
    }

    private void Open(ScenarioLocationDto? location, Guid? parentId)
    {
        _editing = location;
        _parentId = parentId;
        _formOpen = true;
    }

    private async Task SavedFormAsync()
    {
        var wasNew = _editing is null;
        _formOpen = false;
        await SavedAsync(wasNew ? "Локация добавлена." : "Локация сохранена.");
    }

    private Task RemoveAsync(ScenarioLocationDto location)
    {
        var nested = CountNested(location.Id);
        var checks = location.Checks.Count;
        var message = nested > 0
            ? $"Вместе с ней удалятся вложенные локации ({nested}) и их проверки."
            : checks > 0 ? $"Вместе с ней удалятся её проверки ({checks})." : "Описание локации удалится.";
        return DeleteAsync("Удалить локацию?", location.Name, message,
            () => Api.DeleteLocationAsync(Scenario.Id, location.Id), "Локация удалена.");
    }

    private int CountNested(Guid id)
    {
        var children = Scenario.Locations.Where(l => l.ParentId == id).ToList();
        return children.Count + children.Sum(c => CountNested(c.Id));
    }
}
