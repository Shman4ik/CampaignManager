@* Кнопки строки части сценария — одни на локации, проверки, факты, раздатки, тварей и предметы. В обычном виде —
   «Изменить» значком-карандашом 32px (решение владельца по ревью g4, 6.1/7.2: двадцать подписанных кнопок на 44px подряд
   съедали экран и сжимали название; `aria-label` называет строку) и «⋯» с «Удалить» (и пунктами строки — MenuItems);
   в режиме порядка («Порядок» в шапке вкладки) — «Выше» и «Ниже»: четыре подписанные кнопки в строке на портрете iPad
   не помещались, а голые стрелки без подписи на касание ничего не объясняют. Перетаскивания нет — на iPad его не
   поймать пальцем в длинном списке. *@
@if (!CanEdit)
{
    return;
}
<div class="flex shrink-0 flex-wrap items-center gap-2">
    @if (Reordering)
    {
        <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-up" Disabled="@(!CanUp || Busy)" OnClick="OnUp">Выше</Button>
        <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-down" Disabled="@(!CanDown || Busy)" OnClick="OnDown">Ниже</Button>
    }
    else
    {
        <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" class="min-h-8 w-8" AriaLabel="@EditLabel" Disabled="Busy" OnClick="OnEdit" data-testid="part-edit" />
        @* «Удалить» — в «⋯» под линейкой: рядом с частым «Изменить» двадцать красных кнопок подряд (правило 7). *@
        <RowMenu AriaLabel="@MenuLabelText">
            <ChildContent>@MenuItems</ChildContent>
            <Danger>
                <RowMenuItem Icon="fa-trash-can" Danger="true" Disabled="Busy" OnClick="OnDelete">@DeleteLabel</RowMenuItem>
            </Danger>
        </RowMenu>
    }
</div>

@code {
    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public bool Reordering { get; set; }

    [Parameter] public bool CanUp { get; set; }

    [Parameter] public bool CanDown { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public string DeleteLabel { get; set; } = "Удалить";

    /// <summary>Что за строка: «Библиотека» — из него имена кнопок для чтеца («Изменить: Библиотека», «Действия: Библиотека»).</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Свои пункты «⋯» выше «Удалить» («Изменить музыку» у локации).</summary>
    [Parameter] public RenderFragment? MenuItems { get; set; }

    private string EditLabel => Name is { Length: > 0 } ? $"Изменить: {Name}" : "Изменить";

    private string MenuLabelText => Name is { Length: > 0 } ? $"Действия: {Name}" : "Действия строки";

    [Parameter] public EventCallback OnUp { get; set; }

    [Parameter] public EventCallback OnDown { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }
}
