@* Кнопки строки части сценария — одни на локации, проверки, факты, раздатки, тварей и предметы. В обычном виде —
   «Изменить» и «Удалить», в режиме порядка («Порядок» в шапке вкладки) — «Выше» и «Ниже»: четыре подписанные кнопки
   в строке на портрете iPad не помещались, а голые стрелки без подписи на касание ничего не объясняют. Перетаскивания
   нет — на iPad его не поймать пальцем в длинном списке. *@
@if (!CanEdit)
{
    return;
}
<div class="flex shrink-0 flex-wrap gap-2">
    @if (Reordering)
    {
        <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-up" Disabled="@(!CanUp || Busy)" OnClick="OnUp">Выше</Button>
        <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-down" Disabled="@(!CanDown || Busy)" OnClick="OnDown">Ниже</Button>
    }
    else
    {
        @Extra
        <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" Disabled="Busy" OnClick="OnEdit">Изменить</Button>
        @* «Удалить» — в «⋯» под линейкой: рядом с частым «Изменить» двадцать красных кнопок подряд (правило 7). *@
        <RowMenu AriaLabel="@MenuLabel">
            <Danger>
                <RowMenuItem Icon="fa-trash-can" Danger="true" Disabled="Busy" OnClick="OnDelete">@DeleteLabel</RowMenuItem>
            </Danger>
        </RowMenu>
    }
</div>

@code {
    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public bool Reordering { get; set; }

    [Parameter] public bool CanUp { get; set; }

    [Parameter] public bool CanDown { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public string DeleteLabel { get; set; } = "Удалить";

    /// <summary>Имя меню «⋯» для чтеца: «Действия: Библиотека».</summary>
    [Parameter] public string MenuLabel { get; set; } = "Действия строки";

    /// <summary>Своя кнопка перед «Изменить» (проверка — «В локацию»).</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    [Parameter] public EventCallback OnUp { get; set; }

    [Parameter] public EventCallback OnDown { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }
}
