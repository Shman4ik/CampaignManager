@page "/scenarios/{ScenarioId:guid}"
@page "/scenarios/{ScenarioId:guid}/edit"
@attribute [Authorize(Policy = Policies.Keeper)]
@using CampaignManager.Contracts.Scenarios
@using CampaignManager.UI.Platform
@inject IScenariosApi Api
@inject NavigationManager Navigation
@inject DialogService Dialogs
@inject ToastService Toasts

@* Рабочее место сценария: одна страница с вкладками вместо пары «просмотр + правка» v1 (там описание и журнал
   рисовались дважды, а сохранение просмотра затирало правки правки). Сценарий читается одним запросом, а пишется по
   строке: вкладка зовёт свой адрес API и просит страницу перечитать сценарий (OnChanged) — соседние вкладки и корень
   запись не трогает. Открытая вкладка — в адресе (?tab=). /scenarios/{id}/edit — старый адрес правки: ведёт на
   «Описание» с открытой формой. Режим игры — тот же адрес с ?mode=play&location=&handout=&run= (ScenarioPlay): вместо
   вкладок — три колонки во всю высоту (.cm-play), шапка та же. *@
<PageHeader Title="@(_scenario is null ? "Сценарий" : IsPlay ? $"Игра: {_scenario.Name}" : $"Сценарий: {_scenario.Name}")" Game="true">
    <Actions>
        @if (IsPlay)
        {
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-arrow-left" data-testid="leave-play"
                    Href="@ScenarioLinks.Workspace(ScenarioId)">Выйти из режима игры</Button>
        }
        else if (_scenario is not null)
        {
            @if (_scenario.Locations.Count + _scenario.Handouts.Count + _scenario.KeyFacts.Count > 0)
            {
            <Button Small="true" Icon="fa-play" data-testid="enter-play" Href="@ScenarioLinks.Play(ScenarioId)">Режим игры</Button>
            }
            <RowMenu AriaLabel="Действия со сценарием">
                <ChildContent>
                    @if (_scenario.CanEdit)
                    {
                        <RowMenuItem Icon="fa-pen" OnClick="() => _formOpen = true">Изменить сценарий</RowMenuItem>
                    }
                    @* Файл сценария (T2.5d) — тем же форматом, что принимает «Импорт JSON» на /scenarios. *@
                    <RowMenuItem Icon="fa-file-export" OnClick="ExportAsync">Экспорт JSON</RowMenuItem>
                </ChildContent>
                <Danger>
                    @if (_scenario.CanDelete)
                    {
                        <RowMenuItem Icon="fa-trash-can" Danger="true" OnClick="DeleteAsync">Удалить сценарий</RowMenuItem>
                    }
                </Danger>
            </RowMenu>
        }
    </Actions>
</PageHeader>

<div class="@(IsPlay ? "cm-play" : "cm-page")">
    @if (!IsPlay)
    {
        <a class="cm-back-link" href="@ScenarioLinks.List">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Сценарии
        </a>
    }
    <AsyncContent @ref="_content" Key="ScenarioId" Load="LoadAsync" LoadingMessage="Загружаю сценарий…" Context="loaded"
                  ErrorTitle="Сценарий недоступен">
        <Empty>
            <EmptyState Icon="fa-masks-theater" Title="Сценарий не найден." Message="Его удалили, или ссылка неверна.">
                <Actions><Button Icon="fa-arrow-left" Href="@ScenarioLinks.List">К сценариям</Button></Actions>
            </EmptyState>
        </Empty>
        <ChildContent>
            @{ var scenario = loaded!; }
            @if (IsPlay)
            {
                <ScenarioPlay Scenario="scenario" LocationId="Location" HandoutId="Handout" RunId="Run" OnChanged="ReloadAsync" />
            }
            else
            {
                <Tabs Items="TabItems(scenario)" ActiveKey="@ActiveTab" ActiveKeyChanged="SelectTab" AriaLabel="Части сценария" />
                @switch (ActiveTab)
                {
                    case ScenarioLinks.Tabs.Text:
                        <ScenarioTextTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Locations:
                        <ScenarioLocationsTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Checks:
                        <ScenarioChecksTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Facts:
                        <ScenarioFactsTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Handouts:
                        <ScenarioHandoutsTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Creatures:
                        <ScenarioCreaturesTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Items:
                        <ScenarioItemsTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Npcs:
                        <ScenarioNpcsTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    case ScenarioLinks.Tabs.Pregens:
                        <ScenarioPregensTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                    default:
                        <ScenarioDescriptionTab Scenario="scenario" OnChanged="ReloadAsync" />
                        break;
                }
            }
        </ChildContent>
    </AsyncContent>
</div>

@* Окно правки — только над загруженным сценарием: без него форма сочла бы его новым. *@
<ScenarioFormModal Open="@(_formOpen && _scenario is not null)" Scenario="_scenario" OnClose="() => _formOpen = false" OnSaved="HeaderSavedAsync" OnReload="ReloadAsync" />

@code {
    private AsyncContent<ScenarioDto?>? _content;
    private ScenarioDto? _scenario;
    private bool _formOpen;
    private bool _openFormOnLoad;

    [Parameter] public Guid ScenarioId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    /// <summary>Режим игры: <c>?mode=play</c> (<see cref="ScenarioLinks.Play"/>).</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "location")] public Guid? Location { get; set; }

    [SupplyParameterFromQuery(Name = "handout")] public Guid? Handout { get; set; }

    [SupplyParameterFromQuery(Name = "run")] public Guid? Run { get; set; }

    private bool IsPlay => string.Equals(Mode, ScenarioLinks.PlayMode, StringComparison.OrdinalIgnoreCase);

    private string ActiveTab => Tab ?? ScenarioLinks.Tabs.Description;

    protected override void OnParametersSet()
    {
        // Старый адрес правки v1: описание с открытой формой, адрес — рабочего места.
        if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].EndsWith("/edit", StringComparison.Ordinal))
        {
            _openFormOnLoad = true;
            Navigation.NavigateTo(ScenarioLinks.Workspace(ScenarioId), replace: true);
        }
    }

    /// <summary>404 — сценария нет (или он не виден): пустое место, а не ошибка.</summary>
    private async Task<ScenarioDto?> LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            _scenario = await Api.GetAsync(ScenarioId, cancellationToken);
            _formOpen |= _openFormOnLoad && _scenario.CanEdit;
            _openFormOnLoad = false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _scenario = null;
        }

        StateHasChanged(); // шапка — вне AsyncContent
        return _scenario;
    }

    private void ExportAsync() => Navigation.NavigateTo(ScenarioExchangeRoutes.Export(ScenarioId), forceLoad: true);

    private async Task DeleteAsync()
    {
        if (_scenario is not { } scenario)
            return;

        var message = scenario.RunCount > 0
            ? "Сценарий проходят в кампаниях — сервер его не удалит, пока есть партии."
            : "Локации, проверки, факты, раздатки, твари, предметы и состав НПС удалятся вместе с ним. Листы НПС и прегены останутся в библиотеке.";
        if (!await Dialogs.ConfirmDeleteAsync($"Удалить «{scenario.Name}»?", message))
            return;

        try
        {
            await Api.DeleteAsync(scenario.Id);
            Toasts.Success("Сценарий удалён.");
            Navigation.NavigateTo(ScenarioLinks.List);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
    }

    private Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;

    private async Task HeaderSavedAsync()
    {
        _formOpen = false;
        await ReloadAsync();
    }

    private void SelectTab(string key) => Navigation.NavigateTo(ScenarioLinks.Workspace(ScenarioId, key), replace: true);

    private static IReadOnlyList<Tabs.Item> TabItems(ScenarioDto s) =>
    [
        new(ScenarioLinks.Tabs.Description, "Описание", "fa-circle-info"),
        new(ScenarioLinks.Tabs.Text, "Текст", "fa-file-lines"),
        new(ScenarioLinks.Tabs.Locations, "Локации", "fa-location-dot"),
        new(ScenarioLinks.Tabs.Checks, "Проверки", "fa-dice-d20"),
        new(ScenarioLinks.Tabs.Facts, "Факты", "fa-key"),
        new(ScenarioLinks.Tabs.Handouts, "Раздатки", "fa-file-image"),
        new(ScenarioLinks.Tabs.Creatures, "Твари", "fa-skull"),
        new(ScenarioLinks.Tabs.Items, "Предметы", "fa-box"),
        new(ScenarioLinks.Tabs.Npcs, "НПС", "fa-masks-theater"),
        new(ScenarioLinks.Tabs.Pregens, "Прегены", "fa-user"),
    ];
}
