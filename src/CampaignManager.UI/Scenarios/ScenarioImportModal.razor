@using CampaignManager.Contracts.Scenarios
@using CampaignManager.UI.Platform
@using Microsoft.AspNetCore.Components.Forms
@inject IScenarioExchangeApi Api

@* Импорт сценария файлом (T2.5d) — по образцу импорта справочников: файл уходит на сервер как есть, сначала «Проверить»
   (пробный прогон с отчётом по строкам), потом «Импортировать». Импорт — одна транзакция: хоть одна строка с ошибкой —
   не записано ничего. Всегда новый сценарий; «Название копии» — чтобы экспорт, импортированный обратно, не путался с
   исходным в списке. Название уже занято — «Проверить» само ставит «(копия)» и говорит об этом одной строкой. Причина
   выключенных кнопок — над ними (FooterHint), чтобы подвал не прыгал, когда файл выбран. *@
<Modal Open="Open" Title="Импорт сценария" OnClose="CloseAsync" FooterHint="@(_file is null && _report?.Imported != true ? NeedFile : null)" data-testid="scenario-import">
    <ChildContent>
        <div class="grid gap-4">
            <div class="flex flex-col gap-2">
                <p class="cm-text-muted">Файл, скачанный кнопкой «Экспорт JSON» на странице сценария.</p>
                <FilePicker Accept=".json,application/json" FileName="@_fileName" OnChange="PickAsync" data-testid="scenario-import-file" />
            </div>
            <Field Label="Название копии" Note="@(_nameAdded ? $"Такой сценарий уже есть, поэтому к названию добавлено «{CopySuffix}»." : "Пусто — название из файла.")">
                <input class="cm-input" maxlength="@ScenarioLimits.NameLength" @bind="_name" @bind:event="oninput"
                       @bind:after="NameEdited" data-testid="scenario-import-name" />
            </Field>
            @if (_error is not null)
            {
                <Alert Tone="Tone.Error" ShowIcon="true" class="mb-0">@_error</Alert>
            }
            @if (_report is not null)
            {
                <ScenarioImportReportView Report="_report" />
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="_busy">@(_report?.Imported == true ? "Закрыть" : "Отмена")</Button>
        @if (_report?.Imported == true)
        {
            <Button Icon="fa-book-open" OnClick="OpenAsync" data-testid="scenario-import-open">Открыть сценарий</Button>
        }
        else
        {
            <Button Variant="ButtonVariant.Secondary" Icon="fa-vial" Busy="_busy" Disabled="_file is null"
                    OnClick="() => RunAsync(dryRun: true)" data-testid="scenario-import-check">Проверить</Button>
            <Button Icon="fa-file-import" Busy="_busy" Disabled="_file is null"
                    OnClick="() => RunAsync(dryRun: false)" data-testid="scenario-import-run">Импортировать</Button>
        }
    </Footer>
</Modal>

@code {
    /// <summary>Самый большой сценарий v1 с листами НПС — ~0,3 МБ; запас на тексты и прегенов.</summary>
    private const long MaxFileBytes = 10 * 1024 * 1024;

    private byte[]? _file;
    private string? _fileName;
    private string _name = "";
    private bool _busy;
    private string? _error;
    private ScenarioImportReport? _report;
    private bool _nameAdded;

    private const string CopySuffix = "(копия)";

    private static readonly RenderFragment NeedFile = builder => builder.AddContent(0, "Сначала выберите файл");

    /// <summary>Название поправили руками: прежний отчёт устарел, автоподстановка больше ни при чём.</summary>
    private void NameEdited()
    {
        _report = null;
        _nameAdded = false;
    }

    [Parameter] public bool Open { get; set; }

    /// <summary>Названия сценариев библиотеки: совпавшее название получает «(копия)» само.</summary>
    [Parameter] public IReadOnlyCollection<string> ExistingNames { get; set; } = [];

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Сценарий записан — страница перечитывает список.</summary>
    [Parameter] public EventCallback OnImported { get; set; }

    /// <summary>«Открыть сценарий» после записи.</summary>
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private async Task PickAsync(InputFileChangeEventArgs e)
    {
        _report = null;
        _error = null;
        _file = null;
        _fileName = e.File.Name;
        try
        {
            await using var stream = e.File.OpenReadStream(MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _file = buffer.ToArray();
        }
        catch (IOException)
        {
            _error = $"Файл больше {MaxFileBytes / (1024 * 1024)} МБ.";
        }
    }

    private async Task RunAsync(bool dryRun)
    {
        if (_file is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _report = await Api.ImportAsync(new MemoryStream(_file), dryRun, _name);
            if (dryRun && string.IsNullOrWhiteSpace(_name) && !_report.Imported && IsTaken(_report.ScenarioName))
            {
                // Название из файла занято: ставим «(копия)» сами и проверяем заново — отчёт должен описывать то, что запишется.
                _name = $"{_report.ScenarioName} {CopySuffix}";
                _nameAdded = true;
                _report = await Api.ImportAsync(new MemoryStream(_file), dryRun, _name);
            }

            if (_report.Imported)
            {
                await OnImported.InvokeAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            _report = null;
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool IsTaken(string name) =>
        ExistingNames.Any(n => string.Equals(n.Trim(), name.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private async Task OpenAsync()
    {
        if (_report?.ScenarioId is { } id)
        {
            Reset();
            await OnOpen.InvokeAsync(id);
        }
    }

    private async Task CloseAsync()
    {
        Reset();
        await OnClose.InvokeAsync();
    }

    private void Reset()
    {
        _file = null;
        _fileName = null;
        _name = "";
        _nameAdded = false;
        _report = null;
        _error = null;
    }
}
