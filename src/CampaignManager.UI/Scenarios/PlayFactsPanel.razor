@* Правая колонка режима игры: раздатки с «Показать игрокам» и ключевые факты — две вкладки, раздатки первыми (показ —
   второе по частоте действие за столом; факты читают реже, и раскрытыми они уводили раздатки на семь экранов вниз).
   Виды фактов свёрнуты, пока Хранитель их не раскроет («Развернуть всё»). Рисуется и колонкой (xl и шире), и в выдвижной
   панели (уже xl — iPad в портрете: три колонки там не помещаются). Своей карточки не рисует: место — колонка или тело
   окна. Пометка и заметка Хранителя здесь видны — это экран Хранителя; в показ они не уходят (HandoutScreenDto). *@
<div class="flex flex-col" data-testid="play-facts">
    @if (Scenario.KeyFacts.Count > 0 && Scenario.Handouts.Count > 0)
    {
        <Tabs Items="TabItems" ActiveKey="@ActiveTab" ActiveKeyChanged="key => _tab = key" AriaLabel="Раздатки и факты" />
    }

    @if (ActiveTab == HandoutsTab)
    {
        <div class="flex flex-col" data-testid="play-handouts">
            @foreach (var handout in Scenario.Handouts)
            {
                var current = handout;
                <div class="flex items-start gap-3 border-t border-primary-200 py-3 first:border-t-0" @key="handout.Id" data-testid="play-handout">
                    @if (handout.FileUrl is { } url)
                    {
                        <img src="@url" alt="" class="h-14 w-14 shrink-0 rounded-md border border-primary-200 object-cover" loading="lazy" />
                    }
                    <div class="flex min-w-0 flex-1 flex-col gap-1">
                        <span class="text-sm font-semibold text-primary-900">@handout.Name</span>
                        @if (handout.PlayerText is { } text)
                        {
                            <p class="line-clamp-2 whitespace-pre-line text-sm text-primary-700">@text</p>
                        }
                        @if (handout.KeeperNote is { } note)
                        {
                            <p class="text-sm text-warning-800"><i class="fa-solid fa-user-secret mr-1" aria-hidden="true"></i>Хранителю: @note</p>
                        }
                        <div>
                            <Button Variant="ButtonVariant.Secondary" Icon="fa-expand" class="mt-1" data-testid="show-handout"
                                    OnClick="() => OnShowHandout.InvokeAsync(current.Id)">Показать игрокам</Button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Scenario.KeyFacts.Count > 0)
    {
        var groups = Scenario.KeyFacts.GroupBy(f => f.Type).OrderBy(g => g.Key).ToList();
        <div class="flex flex-col" data-testid="play-key-facts">
            <div class="mb-1 flex justify-end">
                <Button Variant="ButtonVariant.Ghost" Icon="@(_expanded.Count == groups.Count ? "fa-compress" : "fa-expand")" data-testid="toggle-all-facts"
                        OnClick="() => ToggleAll(groups.Select(g => g.Key))">@(_expanded.Count == groups.Count ? "Свернуть всё" : "Развернуть всё")</Button>
            </div>
            @foreach (var group in groups)
            {
                var type = group.Key;
                var open = _expanded.Contains(type);
                <section>
                    <button type="button" class="flex min-h-11 w-full items-center gap-2 text-left" aria-expanded="@(open ? "true" : "false")"
                            @onclick="() => Toggle(type)">
                        <i class="fa-solid @(open ? "fa-chevron-down" : "fa-chevron-right") w-3 text-xs text-primary-500" aria-hidden="true"></i>
                        <Badge Tone="ScenarioLabels.FactTone(type)" Icon="@ScenarioLabels.FactIcon(type)">@ScenarioText.Of(type)</Badge>
                        <span class="cm-text-muted text-sm">@group.Count()</span>
                    </button>
                    @if (open)
                    {
                        <div class="mb-2 flex flex-col">
                            @foreach (var fact in group)
                            {
                                <div class="border-t border-primary-200 py-2 first:border-t-0" @key="fact.Id">
                                    <p class="text-sm font-semibold text-primary-900">@fact.Title</p>
                                    <Markdown Text="@fact.Content" class="mt-1 text-sm" />
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private const string HandoutsTab = "handouts";
    private const string FactsTab = "facts";

    // Раскрытые виды фактов: по умолчанию все свёрнуты.
    private readonly HashSet<KeyFactType> _expanded = [];
    private string? _tab;

    [Parameter, EditorRequired] public ScenarioDto Scenario { get; set; } = null!;

    /// <summary>«Показать игрокам»: страница ставит раздатку в адрес (?handout=).</summary>
    [Parameter] public EventCallback<Guid> OnShowHandout { get; set; }

    private string ActiveTab =>
        Scenario.Handouts.Count == 0 ? FactsTab
        : Scenario.KeyFacts.Count == 0 ? HandoutsTab
        : _tab ?? HandoutsTab;

    private IReadOnlyList<Tabs.Item> TabItems =>
    [
        new(HandoutsTab, "Раздатки", "fa-file-lines", Scenario.Handouts.Count),
        new(FactsTab, "Факты", "fa-key", Scenario.KeyFacts.Count),
    ];

    private void Toggle(KeyFactType type)
    {
        if (!_expanded.Remove(type))
            _expanded.Add(type);
    }

    private void ToggleAll(IEnumerable<KeyFactType> all)
    {
        var types = all.ToList();
        if (_expanded.Count == types.Count)
            _expanded.Clear();
        else
            _expanded.UnionWith(types);
    }
}
