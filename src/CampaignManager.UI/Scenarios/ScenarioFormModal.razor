@using CampaignManager.Contracts.Scenarios
@using CampaignManager.Core
@using CampaignManager.Contracts.Files
@using CampaignManager.UI.Catalogs
@using CampaignManager.UI.Platform
@inject IScenariosApi Api

@* Шапка сценария — одна форма на «Новый сценарий» и правку (в v1 «Основное» правилось формой, копировавшей
   девять полей дважды, а описание и журнал рисовались ещё и на странице просмотра). Правка — с версией корня:
   изменили на другом устройстве — текст в окне и «Перечитать», а не молчаливая перезапись. Анонса здесь нет:
   он у прохождения (T2.5c). Обложка — своё поле (ImagePicker: загрузка в WebP сразу, ссылку пишет «Сохранить» отдельным
   адресом …/cover после шапки: шапка — с If-Match, обложка — без него). *@
<Modal Open="Open" Title="@(Scenario is null ? "Новый сценарий" : "Изменить сценарий")" Size="ModalSize.Large" OnClose="CloseAsync" FooterHint="@(Scenario is not null && !IsChanged ? NoChanges : null)" data-testid="scenario-form">
    <ChildContent>
        <form id="scenario-form" class="flex flex-col gap-4" @onsubmit="SaveAsync">
            <Field Label="Название" Required="true" Error="@_nameError" Note="Так сценарий называется в списке и в шапке.">
                <input class="cm-input" maxlength="@ScenarioLimits.NameLength" data-testid="scenario-name" @bind="_name" @bind:event="oninput"
                       aria-invalid="@(_nameError is null ? null : "true")" placeholder="Например: «Безымянный туман»" autofocus />
            </Field>
            @* Место длинное («Беннингтон, штат Вермонт — национальный парк Грин-Маунтин»): ему две трети строки, а не половина. *@
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <Field Label="Место действия" class="sm:col-span-2">
                    <input class="cm-input" maxlength="@ScenarioLimits.ShortTextLength" @bind="_setting" placeholder="Бостон, Массачусетс" />
                </Field>
                <Field Label="Время действия">
                    <input class="cm-input" maxlength="@ScenarioLimits.ShortTextLength" @bind="_settingDate" placeholder="Июнь 1925 года" />
                </Field>
            </div>
            @* Эпоху спрашиваем, только если в библиотеке есть сценарии разных эпох (правило 12); иначе она остаётся как была. *@
            @if (AskEra)
            {
                <Field Label="Эпоха" class="sm:w-80">
                    <select class="cm-input" value="@(_era?.ToString() ?? "")" @onchange="e => _era = Enum.TryParse<Era>(e.Value?.ToString(), out var era) ? era : null">
                        <option value="">Не указана</option>
                        @foreach (var era in Enum.GetValues<Era>())
                        {
                            <option value="@era">@CampaignManager.Core.Catalogs.CatalogText.Of(era)</option>
                        }
                    </select>
                </Field>
            }
            @* «Кратко» — главное описание сценария (сотни знаков), поэтому поле высокое. Обложка — справа от него (с sm), а не строкой
               ниже: окно не растёт и «Сохранить» не уходит под сгиб на 1194×696. *@
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_auto]">
                <Field Label="Кратко" Note="Показывается в списке сценариев.">
                    <textarea class="cm-input" rows="6" maxlength="@ScenarioLimits.TextLength" @bind="_summary"></textarea>
                </Field>
                <Field Label="Обложка" Group="true" class="sm:w-40" data-testid="scenario-cover-field">
                    <ImagePicker Webp="true" FileId="_coverFileId" Url="@ImageUrls.Thumb(_coverUrl, 480)" PreviewClass="h-24 w-36"
                                 OnChanged="CoverChanged" />
                </Field>
            </div>
            @if (_error is not null)
            {
                <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0" data-testid="scenario-form-error">
                    <ChildContent>@_error</ChildContent>
                    <Actions>
                        @if (_stale)
                        {
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-right" OnClick="OnReload">Перечитать</Button>
                        }
                    </Actions>
                </Alert>
            }
            <ValidationScroll Trigger="_attempt" />
        </form>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="_saving">Отмена</Button>
        <Button Type="submit" form="scenario-form" Busy="_saving" Disabled="@(Scenario is not null && !IsChanged)" data-testid="scenario-save">@(Scenario is null ? "Создать" : "Сохранить")</Button>
    </Footer>
</Modal>

@code {
    private bool _wasOpen;
    private string _name = "";
    private string? _summary;
    private string? _setting;
    private string? _settingDate;
    private Era? _era;
    private Guid? _coverFileId;
    private string? _coverUrl;
    private string? _nameError;
    private string? _error;
    private bool _stale;
    private bool _saving;
    private int _attempt;

    // Причина выключенной «Сохранить» — строкой над кнопками (правило 8), а не прижатой к краю справа от неё.
    private static readonly RenderFragment NoChanges = builder => builder.AddContent(0, "Нет изменений");

    [Parameter] public bool Open { get; set; }

    /// <summary>Спрашивать эпоху: только если в библиотеке есть сценарии разных эпох (правило 12).</summary>
    [Parameter] public bool AskEra { get; set; }

    /// <summary>Правка этого сценария; <c>null</c> — новый.</summary>
    [Parameter] public ScenarioDto? Scenario { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Новый сценарий создан — его id.</summary>
    [Parameter] public EventCallback<Guid> OnCreated { get; set; }

    /// <summary>Шапка записана.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>«Перечитать» после конфликта: страница перечитывает сценарий, окно заполняется заново.</summary>
    [Parameter] public EventCallback OnReload { get; set; }

    protected override void OnParametersSet()
    {
        // Форма заполняется при открытии и после «Перечитать» (новая версия), а не на каждую перерисовку.
        if ((Open && !_wasOpen) || (_stale && Scenario is not null && _staleVersion != Scenario.Version))
        {
            _name = Scenario?.Name ?? "";
            _summary = Scenario?.Summary;
            _setting = Scenario?.Setting;
            _settingDate = Scenario?.SettingDate;
            _era = Scenario is null ? Era.Classic : Scenario.Era;
            _coverFileId = Scenario?.CoverFileId;
            _coverUrl = Scenario?.CoverUrl;
            _nameError = null;
            _error = null;
            _stale = false;
        }

        _wasOpen = Open;
    }

    private uint _staleVersion;

    /// <summary>Правка что-то изменила: «Сохранить» без изменений не нужна.</summary>
    private bool IsChanged => IsHeaderChanged || IsCoverChanged;

    private bool IsCoverChanged => _coverFileId != Scenario?.CoverFileId;

    private bool IsHeaderChanged =>
        Scenario is null
        || _name.Trim() != Scenario.Name
        || (_summary ?? "") != (Scenario.Summary ?? "")
        || (_setting ?? "") != (Scenario.Setting ?? "")
        || (_settingDate ?? "") != (Scenario.SettingDate ?? "")
        || _era != Scenario.Era;

    private async Task SaveAsync()
    {
        _nameError = string.IsNullOrWhiteSpace(_name) ? "Название обязательно." : null;
        if (_nameError is not null)
        {
            _attempt++; // ValidationScroll вернёт фокус в первое поле с ошибкой (правило 9)
            return;
        }

        if (_saving)
            return;

        _saving = true;
        _error = null;
        _stale = false;
        try
        {
            var input = new ScenarioInput(_name.Trim(), _summary, _setting, _era, _settingDate);
            if (Scenario is null)
            {
                var created = await Api.CreateAsync(input);
                // Файл только что загружен, отказ здесь почти невозможен; сценарий уже создан, поэтому окно уходит на рабочее
                // место в любом случае (второе «Создать» завело бы двойника), обложку тогда ставят там же «Изменить».
                if (_coverFileId is { } cover)
                    await SaveCoverAsync(created.Id, cover);
                await OnCreated.InvokeAsync(created.Id);
            }
            else
            {
                // Сначала шапка — с версией (конфликт с другим устройством ловится здесь), потом обложка: она без If-Match,
                // но меняет версию корня, и шапка после неё ушла бы с устаревшей.
                if (IsHeaderChanged)
                    await Api.UpdateAsync(Scenario.Id, input, Scenario.Version);
                if (IsCoverChanged && !await SaveCoverAsync(Scenario.Id, _coverFileId))
                {
                    await OnReload.InvokeAsync(); // шапка записана — свежая версия, а в форме остаётся только обложка
                    return;
                }

                await OnSaved.InvokeAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
            if (ex is CampaignManager.Contracts.Platform.ApiException { IsStale: true })
            {
                _stale = true;
                _staleVersion = Scenario?.Version ?? 0;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void CoverChanged(StoredFileDto? file)
    {
        _coverFileId = file?.Id;
        _coverUrl = file?.Url;
    }

    /// <summary>Поставить или убрать обложку; отказ — текстом в окне (шапка к этому моменту уже записана).</summary>
    private async Task<bool> SaveCoverAsync(Guid scenarioId, Guid? fileId)
    {
        try
        {
            if (fileId is { } id)
                await Api.SetCoverAsync(scenarioId, id);
            else
                await Api.RemoveCoverAsync(scenarioId);
            return true;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Сохранено, кроме обложки: {ApiErrors.Describe(ex)}";
            return false;
        }
    }

    private Task CloseAsync() => _saving ? Task.CompletedTask : OnClose.InvokeAsync();
}
