@inherits ScenarioTabBase
@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Platform
@inject ICharactersApi CharactersApi

@* «Готовые сыщики» — листы сценария для разовых игр. Из библиотеки готовый сыщик приходит копией (заготовка остаётся для
   других сценариев); запись на место (T2.5c) копирует уже готового сыщика сценария игроку. «Убрать» уводит его в архив
   библиотеки; записанного в незавершённой партии убрать нельзя — сначала снимают запись. Способ добавить один —
   «Добавить готового сыщика» (окно с поиском по библиотеке, в нём «Создать нового»), решение владельца по ревью g4, 12.3. *@
<section class="cm-section">
    @if (CanEdit)
    {
        <div class="cm-btn-row mb-3 justify-end">
            <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="add-pregen" OnClick="OpenPicker">Добавить готового сыщика</Button>
        </div>
    }
    @if (Scenario.Pregens.Count == 0)
    {
        <EmptyState Compact="true" Title="Нет готовых сыщиков." />
    }
    else
    {
        <div class="cm-card">
            <div class="cm-card-body cm-stack" data-testid="pregen-list">
                @foreach (var pregen in Scenario.Pregens)
                {
                    <CharacterSummaryCard @key="pregen.Character.Id" Character="pregen.Character" Framed="false" ShowPlace="false" ArchiveLabel="Убрать" Busy="Busy"
                                          OnArchive="CanEdit && !pregen.IsReserved ? RemoveCallback : default">
                        @if (pregen.IsReserved)
                        {
                            <div><Badge Tone="Tone.Warning" Icon="fa-lock">Выбран игроком</Badge></div>
                        }
                    </CharacterSummaryCard>
                }
            </div>
        </div>
    }
</section>

<CatalogPickerModal TItem="CharacterSummaryDto" Open="_picking" Title="Добавить готового сыщика" Load="LoadPregensAsync" Key="c => c.Id" Name="c => c.Name"
                    Meta="c => c.Occupation" Also="c => [c.Occupation]" Empty="В библиотеке нет готовых сыщиков-заготовок." ConfirmText="Скопировать в сценарий"
                    SelectReason="Выберите готового сыщика" Busy="_adding" Error="@_addError" OnPick="AddAsync" OnClose="() => _picking = false">
    <Extra>
        <span>Нет в списке?</span>
        <Button Variant="ButtonVariant.Secondary" Icon="fa-user-plus" class="min-h-9" Href="@CreationLinks.Create(CharacterKind.Pregen, null, Scenario.Id)">Создать нового</Button>
    </Extra>
</CatalogPickerModal>

@code {
    private bool _picking;
    private bool _adding;
    private string? _addError;

    private EventCallback<CharacterSummaryDto> RemoveCallback => EventCallback.Factory.Create<CharacterSummaryDto>(this, RemoveAsync);

    private void OpenPicker()
    {
        _addError = null;
        _picking = true;
    }

    /// <summary>Заготовки — готовые сыщики библиотеки без сценария; готовые сыщики других сценариев копируются через их сценарий.</summary>
    private async Task<IReadOnlyList<CharacterSummaryDto>> LoadPregensAsync(CancellationToken cancellationToken) =>
        [.. (await CharactersApi.ListAsync(CharacterKind.Pregen, archived: false, cancellationToken)).Where(c => c.ScenarioId is null)];

    private async Task AddAsync(CharacterSummaryDto pregen)
    {
        _adding = true;
        _addError = null;
        try
        {
            await Api.AddPregenAsync(Scenario.Id, pregen.Id);
            _picking = false;
            await SavedAsync($"Копия добавлена в сценарий: {pregen.Name}.");
        }
        catch (HttpRequestException ex)
        {
            _addError = ApiErrors.Describe(ex);
        }
        finally
        {
            _adding = false;
        }
    }

    private Task RemoveAsync(CharacterSummaryDto pregen) =>
        DeleteAsync("Убрать готового сыщика из сценария?", pregen.Name, "Он уйдёт в архив библиотеки — оттуда его можно вернуть.",
            () => Api.RemovePregenAsync(Scenario.Id, pregen.Id), "Готовый сыщик убран в архив.", "Убрать");
}
