@using CampaignManager.Core
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Platform
@inject IScenariosApi Api
@inject ICatalogApi<SkillDto> SkillsApi

@* Проверка в локации: навык справочника (ссылка, а не имя строкой — в v1 «Библиотека» и «Библиотеки» были разными
   навыками), характеристика или Удача; сложность — по книге (стр. 80); что узнают при успехе и при провале. «Что
   проверяют» и «Сложность» — один и тот же сегментный переключатель (раньше первый был рамкой с кольцом, второй —
   заливкой с галкой, находка #211); навык и сложность в одной строке, исходы (их пишут чаще всего) выше сгиба.
   Локацию спрашиваем, только если проверку добавляют сверху: из группы («+» у локации) и при правке она уже известна и
   стоит строкой над полями. В режиме игры (T2.5b) «Проверить» откроет общий диалог проверки по сыщикам кампании. *@
<Modal Open="Open" Title="@(Check is null ? "Новая проверка" : "Изменить проверку")" Size="ModalSize.Large" OnClose="CloseAsync" data-testid="check-form">
    <ChildContent>
        <form id="check-form" class="flex flex-col gap-4" @onsubmit="SaveAsync">
            @* Локация (если её спрашивают) и «Что проверяют» — в одной строке: окно умещается в экран без прокрутки. *@
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                @if (Check is null && !LocationFixed)
                {
                    <Field Label="Локация" Required="true" Error="@_locationError">
                        <select class="cm-input" data-testid="check-location" value="@(_locationId?.ToString() ?? "")" aria-invalid="@(_locationError is null ? null : "true")"
                                @onchange="e => _locationId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null">
                            <option value="">— выберите —</option>
                            @foreach (var (location, depth) in LocationTree.WithDepth(Locations))
                            {
                                <option value="@location.Id">@(new string(' ', depth * 3))@location.Name</option>
                            }
                        </select>
                    </Field>
                }
                else if (LocationName is { } place)
                {
                    <p class="text-sm text-primary-600 md:col-span-2">Локация: <strong class="font-semibold text-primary-800">@place</strong></p>
                }
                <Field Label="Что проверяют" Group="true">
                    <Segmented TValue="CheckTarget" Options="TargetOptions" Value="_target" ValueChanged="v => _target = v" Label="Что проверяют" />
                </Field>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                @if (_target is CheckTarget.Skill)
                {
                    <Field Label="Навык" Group="true" Required="true" Error="@_targetError">
                        @if (_skills is null)
                        {
                            <LoadingIndicator Message="Загружаю навыки…" />
                        }
                        else
                        {
                            <div class="flex" data-testid="check-skill"><SkillSelect Skills="_skills" @bind-Value="_skillId" Label="Навык" /></div>
                        }
                    </Field>
                }
                else if (_target is CheckTarget.Characteristic)
                {
                    <Field Label="Характеристика" Required="true" Error="@_targetError">
                        <select class="cm-input" data-testid="check-characteristic" value="@(_characteristic?.ToString() ?? "")" aria-invalid="@(_targetError is null ? null : "true")"
                                @onchange="e => _characteristic = Enum.TryParse<Characteristic>(e.Value?.ToString(), out var c) ? c : null">
                            <option value="">— выберите —</option>
                            @foreach (var info in InvestigatorCreationRules.Characteristics)
                            {
                                <option value="@info.Key">@ScenarioLabels.CharacteristicName(info.Key)</option>
                            }
                        </select>
                    </Field>
                }
                <Field Label="Сложность" Group="true" Note="Трудная — половина значения навыка, чрезвычайная — пятая часть.">
                    <DifficultyPicker @bind-Value="_difficulty" />
                </Field>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <Field Label="При успехе" Note="Текст для Хранителя: что узнают сыщики.">
                    <textarea class="cm-input" rows="5" maxlength="@ScenarioLimits.TextLength" data-testid="check-success" @bind="_onSuccess"></textarea>
                </Field>
                <Field Label="При провале" Note="Текст для Хранителя: что происходит.">
                    <textarea class="cm-input" rows="5" maxlength="@ScenarioLimits.TextLength" @bind="_onFailure"></textarea>
                </Field>
            </div>
            <ValidationScroll Trigger="_attempt" />
        </form>
    </ChildContent>
    <FooterError>
        @if (_error is not null)
        {
            <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0" data-testid="check-error">@_error</Alert>
        }
    </FooterError>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="_saving">Отмена</Button>
        <Button Type="submit" form="check-form" Busy="_saving" data-testid="check-save">@(Check is null ? "Добавить" : "Сохранить")</Button>
    </Footer>
</Modal>

@code {
    private bool _wasOpen;
    private Guid? _locationId;
    private CheckTarget _target;
    private Guid? _skillId;
    private Characteristic? _characteristic;
    private Difficulty _difficulty;
    private string? _onSuccess;
    private string? _onFailure;
    private IReadOnlyList<SkillDto>? _skills;
    private string? _error;
    private string? _locationError;
    private string? _targetError;
    private bool _saving;
    private int _attempt;

    private static readonly IReadOnlyList<SegmentOption<CheckTarget>> TargetOptions =
        [.. Enum.GetValues<CheckTarget>().Select(t => new SegmentOption<CheckTarget>(t, ScenarioText.Of(t), TestId: $"check-target-{t}"))];

    /// <summary>Локация, в которой лежит проверка: строкой над полями, если её не спрашивают.</summary>
    private string? LocationName =>
        (Check?.LocationId ?? _locationId) is { } id && Locations.Any(l => l.Id == id) ? LocationTree.Path(Locations, id) : null;

    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public Guid ScenarioId { get; set; }

    /// <summary>Правка этой проверки; <c>null</c> — новая.</summary>
    [Parameter] public ScenarioCheckDto? Check { get; set; }

    [Parameter] public IReadOnlyList<ScenarioLocationDto> Locations { get; set; } = [];

    /// <summary>Локация новой проверки по умолчанию.</summary>
    [Parameter] public Guid? DefaultLocationId { get; set; }

    /// <summary>Локация выбрана заранее («+» у группы): поле не спрашиваем, она стоит строкой над полями.</summary>
    [Parameter] public bool LocationFixed { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var opened = Open && !_wasOpen;
        _wasOpen = Open;
        if (!opened)
            return;

        _locationId = Check?.LocationId ?? DefaultLocationId;
        _target = Check?.TargetKind ?? CheckTarget.Skill;
        _skillId = Check?.SkillId;
        _characteristic = Check?.Characteristic;
        _difficulty = Check?.Difficulty ?? Difficulty.Regular;
        _onSuccess = Check?.OnSuccess;
        _onFailure = Check?.OnFailure;
        _error = null;
        _locationError = null;
        _targetError = null;

        if (_skills is null)
        {
            try
            {
                // Весь справочник, с родителями специализаций: «Язык (иностранный)» в книге проверяют и без уточнения.
                _skills = (await SkillsApi.ListAsync()).Items;
            }
            catch (HttpRequestException ex)
            {
                _skills = [];
                _error = ApiErrors.Describe(ex);
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
            return;

        _error = null;
        _locationError = Check is null && _locationId is null ? "Выберите локацию." : null;
        _targetError = _target is CheckTarget.Skill && _skillId is null ? "Выберите навык."
            : _target is CheckTarget.Characteristic && _characteristic is null ? "Выберите характеристику."
            : null;
        if (_locationError is not null || _targetError is not null)
        {
            _attempt++; // ValidationScroll вернёт фокус в первое поле с ошибкой (правило 9)
            return;
        }

        _saving = true;
        try
        {
            var input = new CheckInput(_target, _skillId, _characteristic, _difficulty, _onSuccess, _onFailure);
            if (Check is null)
                await Api.AddCheckAsync(ScenarioId, _locationId!.Value, input);
            else
                await Api.UpdateCheckAsync(ScenarioId, Check.Id, input);
            await OnSaved.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CloseAsync() => _saving ? Task.CompletedTask : OnClose.InvokeAsync();
}
