@using CampaignManager.Core.Campaigns
@using CampaignManager.UI.Platform
@inject IScenariosApi Scenarios
@inject IRunsApi Runs
@inject DialogService Dialogs
@inject ToastService Toasts

@* Партии сценария (T2.5c; в данных — прохождения) на вкладке «Описание»: «Начать игру», «Объявить разовую игру» (только если
   у сценария есть готовые сыщики — иначе записываться не на кого) и партии в кампаниях, которые ведёт Хранитель, — анонс,
   записи на места, «Играть» (режим игры с этой партией), правка одной формой, «Завершить», «Удалить». Завершённая партия —
   свёрнутая строка (правило 17): анонс и записи по раскрытию. «Играть» — secondary: единственная primary рабочего места —
   «Режим игры» в шапке (решение владельца 2026-10-03). Список — тот же GET …/runs, что у режима игры. *@
<section class="cm-section" aria-labelledby="runs-title">
    <div class="cm-section-header flex-wrap gap-2">
        <h2 id="runs-title" class="cm-section-title">Партии</h2>
        <div class="cm-btn-row">
            <Button Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="play-in-campaign"
                    OnClick="() => OpenForm(RunFormMode.PlayInCampaign, null)">Начать игру</Button>
            @if (Scenario.Pregens.Count > 0)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-bullhorn" data-testid="announce-oneshot"
                        OnClick="() => OpenForm(RunFormMode.OneShot, null)">Объявить разовую игру</Button>
            }
        </div>
    </div>
    <AsyncContent @ref="_content" Key="Scenario.Id" Load="LoadAsync" LoadingMessage="Загружаю партии…" Context="runs">
        @* Счётчик «Партий» в шапке считает все партии сценария, список — только в кампаниях, которые ведёт этот Хранитель:
           разницу называем, чтобы «Партий: 1» не стояло рядом с «Пока не проходили». *@
        @{
            var hidden = Math.Max(0, Scenario.RunCount - runs.Count);
        }
        @if (runs.Count == 0)
        {
            <EmptyState Compact="true" Title="@(hidden > 0 ? $"В ваших кампаниях не проходили. Партий в чужих кампаниях: {hidden}." : "Пока не проходили.")" />
        }
        else
        {
            <div class="cm-card">
                @foreach (var run in runs)
                {
                    var finished = run.Status == ScenarioRunStatus.Finished;
                    var hasDetails = !string.IsNullOrWhiteSpace(run.Announcement) || run.Reservations.Count > 0;
                    // Завершённая партия — одна строка; анонс и записи по раскрытию (правило 17).
                    var open = !finished || _expanded.Contains(run.Id);
                    <div class="flex flex-col gap-2 border-t border-primary-200 px-4 py-3 first:border-t-0" data-testid="run-row" @key="run.Id">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            @if (finished && hasDetails)
                            {
                                <button type="button" class="flex min-h-11 min-w-0 basis-48 flex-1 items-center gap-2 text-left" aria-expanded="@(open ? "true" : "false")"
                                        data-testid="run-toggle" @onclick="() => Toggle(run.Id)">
                                    <i class="fa-solid @(open ? "fa-chevron-down" : "fa-chevron-right") w-3 text-xs text-primary-500" aria-hidden="true"></i>
                                    <span class="break-words font-semibold text-primary-800">@run.CampaignName</span>
                                </button>
                            }
                            else
                            {
                                <a class="flex min-h-11 min-w-0 basis-48 flex-1 items-center break-words font-semibold text-primary-800 underline-offset-2 hover:underline"
                                   href="@($"campaigns/{run.CampaignId}")">@run.CampaignName</a>
                            }
                            @if (run.CampaignKind == CampaignKind.OneShot)
                            {
                                <Badge Tone="Tone.Neutral">Разовая игра</Badge>
                            }
                            <Badge Tone="ScenarioLabels.RunTone(run.Status)">@ScenarioLabels.RunStatus(run.Status)</Badge>
                            @if (run.SignupOpen)
                            {
                                <Badge Tone="Tone.Success" Icon="fa-user-check">Запись открыта</Badge>
                            }
                            @if (finished)
                            {
                                <span class="text-sm text-primary-600">@DateText(run)</span>
                            }
                            @* «Играть» — одна и на виду, но не главная: главная — «Режим игры» в шапке. У завершённой партии играть уже нечего. *@
                            @if (!finished)
                            {
                                <Button Variant="ButtonVariant.Secondary" Icon="fa-play" Href="@ScenarioLinks.Play(Scenario.Id, null, null, run.Id)" data-testid="play-run">Играть</Button>
                            }
                            else
                            {
                                <Button Variant="ButtonVariant.Secondary" Icon="fa-book-open" Href="@($"campaigns/{run.CampaignId}")">Открыть кампанию</Button>
                            }
                            @if (run.CanEdit || run.CanDelete)
                            {
                                <RowMenu AriaLabel="@("Действия: " + run.CampaignName)">
                                    <ChildContent>
                                        @if (run.CanEdit)
                                        {
                                            <RowMenuItem Icon="fa-pen" OnClick="() => OpenForm(RunFormMode.Edit, run)">Изменить анонс и запись</RowMenuItem>
                                            @if (!finished)
                                            {
                                                <RowMenuItem Icon="fa-flag-checkered" OnClick="() => FinishAsync(run)">Завершить партию</RowMenuItem>
                                            }
                                        }
                                    </ChildContent>
                                    <Danger>
                                        @if (run.CanDelete)
                                        {
                                            <RowMenuItem Icon="fa-trash-can" Danger="true" OnClick="() => DeleteAsync(run)">Удалить партию</RowMenuItem>
                                        }
                                    </Danger>
                                </RowMenu>
                            }
                        </div>
                        @if (!finished)
                        {
                            <div class="cm-meta">
                                <span>
                                    <i class="fa-regular fa-calendar mr-1" aria-hidden="true"></i>@DateText(run)
                                </span>
                            </div>
                        }
                        @if (open && !string.IsNullOrWhiteSpace(run.Announcement))
                        {
                            <Markdown Text="@run.Announcement" class="max-w-prose" />
                        }
                        @if (open && run.Reservations.Count > 0)
                        {
                            <div>
                                <h3 class="cm-field-label mb-1">Записи · @run.Reservations.Count</h3>
                                <ul>
                                    @foreach (var reservation in run.Reservations)
                                    {
                                        <li class="flex flex-wrap items-center gap-2 border-t border-primary-100 py-1.5 first:border-t-0" @key="reservation.PregenId">
                                            <span class="min-w-0 flex-1">
                                                <span class="font-semibold text-primary-800">@reservation.PregenName</span>
                                                <span class="text-primary-600"> — @(reservation.PlayerName ?? "игрок без имени")</span>
                                            </span>
                                            @if (reservation.CharacterId is { } sheet)
                                            {
                                                <Button Variant="ButtonVariant.Secondary" Icon="fa-id-card" Href="@($"character/{sheet}")">Лист</Button>
                                            }
                                            @if (reservation.CanRelease && !finished)
                                            {
                                                <Button Variant="ButtonVariant.OutlineError" Icon="fa-user-xmark" Busy="@(_busy == reservation.PregenId)"
                                                        OnClick="() => ReleaseAsync(run, reservation)">Снять запись</Button>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (hidden > 0)
            {
                <p class="cm-text-muted mt-2 text-sm" data-testid="runs-hidden">Ещё партий в чужих кампаниях: @hidden.</p>
            }
        }
    </AsyncContent>
</section>

<RunFormModal Open="_formOpen" Mode="_mode" Run="_editing" ScenarioId="Scenario.Id" ScenarioName="@Scenario.Name"
              OnClose="() => _formOpen = false" OnSaved="SavedAsync" />

@code {
    private AsyncContent<IReadOnlyList<ScenarioRunDto>>? _content;
    private bool _formOpen;
    private RunFormMode _mode;
    private ScenarioRunDto? _editing;
    private Guid? _busy;
    private readonly HashSet<Guid> _expanded = [];

    private void Toggle(Guid runId)
    {
        if (!_expanded.Remove(runId))
            _expanded.Add(runId);
    }

    private static string DateText(ScenarioRunDto run) => run.ScheduledAt is { } at ? LocalTime.DateTime(at) : "Дата не назначена";

    [Parameter, EditorRequired] public ScenarioDto Scenario { get; set; } = null!;

    /// <summary>Число прохождений сценария поменялось — странице перечитать сценарий (счётчик, удаление).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task<IReadOnlyList<ScenarioRunDto>> LoadAsync(CancellationToken cancellationToken) =>
        Scenarios.ListRunsAsync(Scenario.Id, cancellationToken);

    private void OpenForm(RunFormMode mode, ScenarioRunDto? run)
    {
        _mode = mode;
        _editing = run;
        _formOpen = true;
    }

    private async Task SavedAsync(ScenarioRunDto run)
    {
        var mode = _mode;
        _formOpen = false;
        Toasts.Success(mode switch
        {
            RunFormMode.PlayInCampaign => $"Игра началась. Кампания: {Names.Plain(run.CampaignName)}.",
            RunFormMode.OneShot => $"Разовая игра объявлена. Кампания: {Names.Plain(run.CampaignName)}, запись открыта.",
            _ => "Партия сохранена.",
        });
        await ReloadAsync(mode != RunFormMode.Edit);
    }

    private async Task FinishAsync(ScenarioRunDto run)
    {
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest("Завершить партию?", "Запись закроется, записанные места останутся в истории.")
            {
                Subject = run.CampaignName,
                ConfirmText = "Завершить",
                ConfirmVariant = ButtonVariant.Primary,
                Details = null,
            }))
        {
            return;
        }

        _busy = run.Id;
        try
        {
            await Runs.UpdateAsync(run.Id, new RunInput(ScenarioRunStatus.Finished, run.ScheduledAt, run.Announcement, false));
            Toasts.Success("Партия завершена.");
            await ReloadAsync(false);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task DeleteAsync(ScenarioRunDto run)
    {
        var message = run.Reservations.Count > 0
            ? "Записи уйдут вместе с ней; листы, которые игроки получили при записи, останутся у них в кампании. Встречи журнала потеряют ссылку."
            : "Встречи журнала потеряют ссылку на сценарий. Кампания останется.";
        if (!await Dialogs.ConfirmDeleteAsync("партию", run.CampaignName, message, reversible: false))
        {
            return;
        }

        try
        {
            await Runs.DeleteAsync(run.Id);
            Toasts.Success("Партия удалена.");
            await ReloadAsync(true);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
    }

    private async Task ReleaseAsync(ScenarioRunDto run, RunReservationDto reservation)
    {
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest("Снять запись?", "Готовый сыщик снова свободен; копия листа у игрока уйдёт в архив.")
            {
                Subject = reservation.PregenName,
                ConfirmText = "Снять запись",
                Details = null,
            }))
        {
            return;
        }

        _busy = reservation.PregenId;
        try
        {
            await Runs.ReleaseAsync(run.Id, reservation.PregenId);
            Toasts.Success("Запись снята.");
            await ReloadAsync(true);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }

    /// <param name="scenarioToo">Перечитать и сценарий: счётчик прохождений и «выбран игроком» у готовых сыщиков.</param>
    private async Task ReloadAsync(bool scenarioToo)
    {
        if (_content is not null)
        {
            await _content.ReloadAsync();
        }

        if (scenarioToo)
        {
            await OnChanged.InvokeAsync();
        }
    }
}
