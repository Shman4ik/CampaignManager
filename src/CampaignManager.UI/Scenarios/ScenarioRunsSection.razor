@using CampaignManager.Core.Campaigns
@using CampaignManager.UI.Platform
@inject IScenariosApi Scenarios
@inject IRunsApi Runs
@inject DialogService Dialogs
@inject ToastService Toasts

@* Прохождения сценария (T2.5c) на вкладке «Описание»: «Играть в кампании», «Объявить ваншот» и прохождения в кампаниях,
   которые ведёт Хранитель, — анонс, запись, брони, «Играть» (режим игры с этим прохождением), правка одной формой,
   «Завершить», «Удалить». Список — тот же GET …/runs, что у режима игры. В v1 «Использовать в кампании» копировало сценарий,
   а анонс правился прямо на странице сценария. *@
<section class="cm-section" aria-labelledby="runs-title">
    <div class="cm-section-header flex-wrap gap-2">
        <h2 id="runs-title" class="cm-section-title">Прохождения</h2>
        <div class="flex flex-wrap gap-2">
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="play-in-campaign"
                    OnClick="() => OpenForm(RunFormMode.PlayInCampaign, null)">Играть в кампании</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-bullhorn" data-testid="announce-oneshot"
                    OnClick="() => OpenForm(RunFormMode.OneShot, null)">Объявить ваншот</Button>
        </div>
    </div>
    <AsyncContent @ref="_content" Key="Scenario.Id" Load="LoadAsync" LoadingMessage="Загружаю прохождения…" Context="runs">
        @if (runs.Count == 0)
        {
            <EmptyState Icon="fa-dice" Title="Сценарий ещё не играют в ваших кампаниях."
                        Message="«Играть в кампании» — для кампании, которую вы ведёте; «Объявить ваншот» — новая кампания с записью на прегенов." />
        }
        else
        {
            <div class="cm-card">
                @foreach (var run in runs)
                {
                    <div class="flex flex-col gap-2 border-t border-primary-200 px-4 py-3 first:border-t-0" data-testid="run-row" @key="run.Id">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <a class="min-w-0 basis-48 flex-1 truncate font-semibold text-primary-800 underline-offset-2 hover:underline"
                               href="@($"campaigns/{run.CampaignId}")">@run.CampaignName</a>
                            @if (run.CampaignKind == CampaignKind.OneShot)
                            {
                                <Badge Tone="Tone.Neutral">Ваншот</Badge>
                            }
                            <Badge Tone="ScenarioLabels.RunTone(run.Status)">@ScenarioLabels.RunStatus(run.Status)</Badge>
                            @if (run.SignupOpen)
                            {
                                <Badge Tone="Tone.Success" Icon="fa-user-check">Запись открыта</Badge>
                            }
                        </div>
                        <div class="cm-meta">
                            <span>
                                <i class="fa-regular fa-calendar mr-1" aria-hidden="true"></i>@(run.ScheduledAt is { } at ? LocalTime.DateTime(at) : "Дата не назначена")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(run.Announcement))
                        {
                            <Markdown Text="@run.Announcement" class="max-h-40 overflow-y-auto" />
                        }
                        @if (run.Reservations.Count > 0)
                        {
                            <div>
                                <h3 class="cm-field-label mb-1">Брони · @run.Reservations.Count</h3>
                                <ul>
                                    @foreach (var reservation in run.Reservations)
                                    {
                                        <li class="flex flex-wrap items-center gap-2 border-t border-primary-100 py-1.5 first:border-t-0" @key="reservation.PregenId">
                                            <span class="min-w-0 flex-1">
                                                <span class="font-semibold text-primary-800">@reservation.PregenName</span>
                                                <span class="text-primary-500"> — @(reservation.PlayerName ?? "игрок без имени")</span>
                                            </span>
                                            @if (reservation.CharacterId is { } sheet)
                                            {
                                                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-id-card" Href="@($"character/{sheet}")">Лист</Button>
                                            }
                                            @if (reservation.CanRelease && run.Status != ScenarioRunStatus.Finished)
                                            {
                                                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-user-xmark" Busy="@(_busy == reservation.PregenId)"
                                                        OnClick="() => ReleaseAsync(run, reservation)">Снять бронь</Button>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <div class="flex flex-wrap gap-2">
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-play" Href="@ScenarioLinks.Play(Scenario.Id, null, null, run.Id)">Играть</Button>
                            @if (run.CanEdit)
                            {
                                <Button Small="true" Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" data-testid="edit-run"
                                        OnClick="() => OpenForm(RunFormMode.Edit, run)">Анонс и запись</Button>
                                @if (run.Status != ScenarioRunStatus.Finished)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-flag-checkered" Busy="@(_busy == run.Id)"
                                            OnClick="() => FinishAsync(run)">Завершить</Button>
                                }
                            }
                            @if (run.CanDelete)
                            {
                                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="() => DeleteAsync(run)">Удалить</Button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </AsyncContent>
</section>

<RunFormModal Open="_formOpen" Mode="_mode" Run="_editing" ScenarioId="Scenario.Id" ScenarioName="@Scenario.Name"
              PregenCount="Scenario.Pregens.Count" OnClose="() => _formOpen = false" OnSaved="SavedAsync" />

@code {
    private AsyncContent<IReadOnlyList<ScenarioRunDto>>? _content;
    private bool _formOpen;
    private RunFormMode _mode;
    private ScenarioRunDto? _editing;
    private Guid? _busy;

    [Parameter, EditorRequired] public ScenarioDto Scenario { get; set; } = null!;

    /// <summary>Число прохождений сценария поменялось — странице перечитать сценарий (счётчик, удаление).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task<IReadOnlyList<ScenarioRunDto>> LoadAsync(CancellationToken cancellationToken) =>
        Scenarios.ListRunsAsync(Scenario.Id, cancellationToken);

    private void OpenForm(RunFormMode mode, ScenarioRunDto? run)
    {
        _mode = mode;
        _editing = run;
        _formOpen = true;
    }

    private async Task SavedAsync(ScenarioRunDto run)
    {
        var mode = _mode;
        _formOpen = false;
        Toasts.Success(mode switch
        {
            RunFormMode.PlayInCampaign => $"Сценарий играют в кампании «{run.CampaignName}».",
            RunFormMode.OneShot => $"Ваншот объявлен: кампания «{run.CampaignName}», запись открыта.",
            _ => "Прохождение сохранено.",
        });
        await ReloadAsync(mode != RunFormMode.Edit);
    }

    private async Task FinishAsync(ScenarioRunDto run)
    {
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest($"Завершить прохождение в «{run.CampaignName}»?",
                "Запись на прегенов закроется, брони останутся в истории. Сыгранный сценарий отметьте во встрече журнала — там подсказка о фазе развития.")
            {
                ConfirmText = "Завершить",
                ConfirmVariant = ButtonVariant.Primary,
                Details = null,
            }))
        {
            return;
        }

        _busy = run.Id;
        try
        {
            await Runs.UpdateAsync(run.Id, new RunInput(ScenarioRunStatus.Finished, run.ScheduledAt, run.Announcement, false));
            Toasts.Success("Прохождение завершено.");
            await ReloadAsync(false);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task DeleteAsync(ScenarioRunDto run)
    {
        var message = run.Reservations.Count > 0
            ? "Брони уйдут вместе с ним; листы, которые игроки получили бронью, останутся у них в кампании. Встречи журнала потеряют ссылку."
            : "Встречи журнала потеряют ссылку на сценарий. Кампания останется.";
        if (!await Dialogs.ConfirmDeleteAsync($"Удалить прохождение в «{run.CampaignName}»?", message))
        {
            return;
        }

        try
        {
            await Runs.DeleteAsync(run.Id);
            Toasts.Success("Прохождение удалено.");
            await ReloadAsync(true);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
    }

    private async Task ReleaseAsync(ScenarioRunDto run, RunReservationDto reservation)
    {
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest($"Снять бронь «{reservation.PregenName}»?",
                "Преген снова свободен; копия листа у игрока уйдёт в архив.")
            {
                ConfirmText = "Снять бронь",
                Details = null,
            }))
        {
            return;
        }

        _busy = reservation.PregenId;
        try
        {
            await Runs.ReleaseAsync(run.Id, reservation.PregenId);
            Toasts.Success("Бронь снята.");
            await ReloadAsync(true);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }

    /// <param name="scenarioToo">Перечитать и сценарий: счётчик прохождений и «забронирован» у прегенов.</param>
    private async Task ReloadAsync(bool scenarioToo)
    {
        if (_content is not null)
        {
            await _content.ReloadAsync();
        }

        if (scenarioToo)
        {
            await OnChanged.InvokeAsync();
        }
    }
}
