@using CampaignManager.Core.Catalogs
@using CampaignManager.UI.Platform

@* «Описание» — карточка сценария: эпоха, место, время, автор, кратко и партии (ScenarioRunsSection, T2.5c).
   Правка и удаление — в меню «⋯» шапки страницы (ScenarioFormModal), «Что внутри» убрано: вкладки уже несут счётчики. *@
<section class="cm-section">
    <div class="cm-card">
        <div class="cm-card-body flex flex-col gap-3">
            <div class="flex flex-wrap gap-1.5">
                @if (Scenario.Era is { } era)
                {
                    <Badge Tone="Tone.Stone">@CatalogText.Of(era)</Badge>
                }
                @if (Scenario.SettingDate is { } date && date != (Scenario.Era is { } e2 ? CatalogText.Of(e2) : null))
                {
                    <Badge Tone="Tone.Neutral" Icon="fa-calendar" class="max-w-full whitespace-normal">@date</Badge>
                }
                @if (Scenario.Setting is { } setting)
                {
                    <Badge Tone="Tone.Info" Icon="fa-location-dot" class="max-w-full whitespace-normal">@setting</Badge>
                }
                @if (Scenario.RunCount > 0)
                {
                    <Badge Tone="Tone.Success" Icon="fa-dice">Прохождений: @Scenario.RunCount</Badge>
                }
            </div>
            @if (Scenario.SourceScenarioName is { } source)
            {
                <p class="text-sm text-primary-600">
                    Переделка сценария <a class="underline" href="@ScenarioLinks.Workspace(Scenario.SourceScenarioId!.Value)">«@source»</a>.
                </p>
            }
            @if (Scenario.Summary is { } summary)
            {
                <p class="whitespace-pre-line text-primary-800" data-testid="scenario-summary">@summary</p>
            }
            else
            {
                <p class="cm-text-muted">Описания нет@(Scenario.CanEdit ? " — его можно добавить через «⋯» → «Изменить сценарий»." : ".")</p>
            }
            <div class="cm-meta">
                <span><span class="cm-meta-label">Автор:</span> @(Scenario.AuthorName ?? "—")</span>
                <span><span class="cm-meta-label">Изменён:</span> @LocalTime.DateTime(Scenario.UpdatedAt)</span>
            </div>
        </div>
    </div>
</section>

<ScenarioRunsSection Scenario="Scenario" OnChanged="OnChanged" />

@code {
    [Parameter, EditorRequired] public ScenarioDto Scenario { get; set; } = null!;

    /// <summary>Прохождения поменялись — перечитать сценарий (счётчик, брони прегенов).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
}
