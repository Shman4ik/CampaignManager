@inherits ScenarioTabBase

@* «Раздатки» — строки одной карточки: миниатюра (только у раздатки с картинкой; `?w=` — не оригинал), в первой строке название
   (пометка Хранителя) и справа действия — «Показать игрокам» (secondary), «Изменить» значком и «⋯»; под ней начало текста для
   игроков и пометка Хранителю. Действия не отнимают у текста половину ширины на портрете (ревью g4, 9.1, 9.2).
   «Показать игрокам» — режим игры с открытым показом (ScenarioLinks.Play(…, handoutId)); оттуда же второй экран
   /scenarios/{id}/handouts/{handoutId}. *@
<section class="cm-section">
    @* Заголовка секции над одноимённой вкладкой нет (правило 5): в строке действий вкладки — порядок и добавление. *@
    @if (CanEdit)
    {
        <div class="cm-btn-row mb-3 justify-end">
            @if (Scenario.Handouts.Count > 1)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-arrow-down-up-across-line"
                        OnClick="() => Reordering = !Reordering">@(Reordering ? "Готово" : "Порядок")</Button>
            }
            @if (!Reordering)
            {
                <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="add-handout" OnClick="() => Open(null)">Добавить раздатку</Button>
            }
        </div>
    }
    @if (Scenario.Handouts.Count == 0)
    {
        <EmptyState Compact="true" Title="Нет раздаток." />
    }
    else
    {
        var ids = Scenario.Handouts.Select(h => h.Id).ToList();
        <div class="cm-card" data-testid="handout-list">
            @foreach (var handout in Scenario.Handouts)
            {
                var index = ids.IndexOf(handout.Id);
                <div class="flex items-start gap-3 border-t border-primary-200 px-4 py-2 first:border-t-0" @key="handout.Id" data-testid="handout-row">
                    @if (ImageUrls.Thumb(handout.FileUrl, 160) is { } url)
                    {
                        <img src="@url" alt="" class="mt-1 h-16 w-16 shrink-0 rounded-md border border-primary-200 object-cover" loading="lazy" />
                    }
                    <div class="flex min-w-0 flex-1 flex-col gap-1">
                        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                            <span class="min-w-0 font-semibold text-primary-900">@handout.Name</span>
                            <div class="flex shrink-0 flex-wrap items-center gap-2">
                                @if (!Reordering)
                                {
                                    <Button Variant="ButtonVariant.Secondary" Icon="fa-expand" data-testid="handout-show"
                                            Href="@ScenarioLinks.Play(Scenario.Id, null, handout.Id)" class="min-h-9">Показать игрокам</Button>
                                }
                                <PartRowActions CanEdit="CanEdit" Reordering="Reordering" Busy="Busy" CanUp="index > 0" CanDown="index < ids.Count - 1"
                                                OnUp="() => MoveAsync(ScenarioPart.Handouts, ids, handout.Id, -1)"
                                                OnDown="() => MoveAsync(ScenarioPart.Handouts, ids, handout.Id, 1)"
                                                OnEdit="() => Open(handout)" OnDelete="() => RemoveAsync(handout)" Name="@handout.Name" />
                            </div>
                        </div>
                        @if (handout.PlayerText is { } text)
                        {
                            <p class="line-clamp-3 max-w-prose whitespace-pre-line text-sm text-primary-700">@text</p>
                        }
                        @if (handout.KeeperNote is { } note)
                        {
                            <p class="max-w-prose pb-1 text-sm text-warning-800"><i class="fa-solid fa-user-secret mr-1" aria-hidden="true"></i>Хранителю: @note</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

<HandoutFormModal Open="_formOpen" ScenarioId="Scenario.Id" Handout="_editing" OnClose="() => _formOpen = false" OnSaved="SavedFormAsync" />

@code {
    private bool _formOpen;
    private HandoutDto? _editing;

    private void Open(HandoutDto? handout)
    {
        _editing = handout;
        _formOpen = true;
    }

    private async Task SavedFormAsync()
    {
        var wasNew = _editing is null;
        _formOpen = false;
        await SavedAsync(wasNew ? "Раздатка добавлена." : "Раздатка сохранена.");
    }

    private Task RemoveAsync(HandoutDto handout) =>
        DeleteAsync("Удалить раздатку?", handout.Name, "Раздатка с картинкой пропадёт из сценария.",
            () => Api.DeleteHandoutAsync(Scenario.Id, handout.Id), "Раздатка удалена.");
}
