@implements IDisposable
@using CampaignManager.Contracts.Music
@inject MusicPlayer Player

@* Полоса плеера — то, что видно всегда, пока панель открыта: ≤ 48px. Играет — слева значки «Пауза» и «Другой трек» (36px,
   как у любого плеера: подписи-плитки 44px спорили с главной кнопкой страницы), название, полоса позиции с временем и «⋯»
   («Громкость и настроения», «Скрыть плеер», «Остановить»). Перемотка — здесь, а не в развёрнутой части: за «⋯» её не
   находили. На телефоне полоса позиции уходит второй строкой. Ничего не играет — «Настроения» и «Скрыть», неактивных
   кнопок в покое нет («Другой трек» без пула не рисуется). Громкость и настроения — в развёрнутой части (MusicPlayerBar).
   Класс cm-music-start у кнопок, которые могут начать звук: модуль «расчехляет» аудио на pointerdown внутри жеста
   (иначе iPad откажет в play()). *@
<div class="@Css.Join("cm-music-strip", Player.Current is null ? null : "cm-music-strip-playing")">
    @if (Player.Current is { } track)
    {
        <div class="cm-music-controls">
            @* Ролик, который не заиграл (запрет встраивания), продолжить нельзя: кнопки нет, остаётся «Другой трек» (M6, правило 8). *@
            @if (Player.Error is null || Player.IsPlaying)
            {
                <Button Variant="ButtonVariant.Secondary" class="cm-music-start cm-music-play" Icon="@(Player.IsPlaying ? "fa-pause" : "fa-play")"
                        AriaLabel="@(Player.IsPlaying ? "Пауза" : "Продолжить")" data-testid="music-toggle-pause" OnClick="Player.TogglePause" />
            }
            @if (Player.CanRoll)
            {
                <Button Variant="ButtonVariant.Ghost" class="cm-music-start" Icon="fa-shuffle" AriaLabel="Другой трек" OnClick="() => Player.Roll()" />
            }
        </div>

        <div class="cm-music-title">
            <span class="cm-music-name" data-testid="music-current">@track.Name</span>
            @if (!string.IsNullOrWhiteSpace(Player.PoolLabel) && Player.PoolLabel != track.Name)
            {
                <span class="cm-music-pool">@Player.PoolLabel</span>
            }
        </div>

        @* Разметка полосы неизменная: значения полосы и подписей ставит модуль напрямую четыре раза в секунду, а C# эти
           элементы после первой отрисовки не патчит (полоса перерисовывается на каждое Changed плеера). Не привязывать к ним
           @bind и value с меняющимся значением — ползунок начнёт вырываться из-под пальца. *@
        <div class="cm-music-seek">
            <span class="cm-music-time" id="cm-music-elapsed">0:00</span>
            <input type="range" id="cm-music-seek" min="0" max="1000" step="1" value="0" aria-label="Позиция в треке" disabled />
            <span class="cm-music-time" id="cm-music-duration">--:--</span>
        </div>

        <RowMenu AriaLabel="Ещё: плеер">
            <ChildContent>
                <RowMenuItem Icon="@(Expanded ? "fa-chevron-down" : "fa-sliders")" OnClick="ToggleExpandedAsync">@(Expanded ? "Свернуть плеер" : ExpandLabel(track))</RowMenuItem>
                <RowMenuItem Icon="fa-xmark" OnClick="Player.ClosePanel">Скрыть плеер</RowMenuItem>
            </ChildContent>
            <Danger>
                <RowMenuItem Danger="true" Icon="fa-stop" OnClick="StopAsync">Остановить</RowMenuItem>
            </Danger>
        </RowMenu>
    }
    else
    {
        <i class="fa-solid fa-music cm-music-glyph" aria-hidden="true"></i>
        <div class="cm-music-title">
            <span class="cm-music-pool">Выберите настроение</span>
        </div>
        <div class="cm-music-controls">
            <Button Variant="ButtonVariant.Secondary" Icon="@(Expanded ? "fa-chevron-down" : "fa-chevron-up")"
                    aria-expanded="@(Expanded ? "true" : "false")" OnClick="ToggleExpandedAsync">Настроения</Button>
            <Button Variant="ButtonVariant.Ghost" Icon="fa-xmark" OnClick="Player.ClosePanel">Скрыть</Button>
        </div>
    }
</div>

@code {
    /// <summary>Развёрнута ли панель под полосой (громкость, позиция, настроения).</summary>
    [Parameter] public bool Expanded { get; set; }

    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    // Параметры у полосы не меняются, когда трек сменился, — родитель её не перерисует: следит за плеером сама.
    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Player.Changed -= OnPlayerChanged;

    // У ролика YouTube громкости нет (iPad чужой iframe не слушает) — в развёрнутой части только настроения.
    private static string ExpandLabel(MusicTrackDto track) => track.IsYouTube ? "Настроения" : "Громкость и настроения";

    private Task ToggleExpandedAsync() => ExpandedChanged.InvokeAsync(!Expanded);

    // «Остановить» сворачивает панель до полосы: в покое от плеера остаётся одна строка.
    private async Task StopAsync()
    {
        Player.Stop();
        await ExpandedChanged.InvokeAsync(false);
    }
}
