@* Настроения трека — метками. Пусто — ничего: трек без тегов играет только сам или прибитым к локации. *@
@if (Tags.Count > 0)
{
    <span class="inline-flex flex-wrap gap-1">
        @foreach (var tag in Tags)
        {
            <Badge Tone="Tone.Info">@tag</Badge>
        }
    </span>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Tags { get; set; } = [];
}
