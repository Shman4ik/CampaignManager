@using CampaignManager.Contracts.Files
@using CampaignManager.Contracts.Music
@using CampaignManager.Core.Music
@using CampaignManager.UI.Platform
@using Microsoft.AspNetCore.Components.Forms
@inject IFilesApi Files

@* Форма трека в окне справочника; правит копию (CatalogPage). Источник — ровно одно из двух: ролик YouTube
   (ссылка любой формы — сервер достанет идентификатор) или загруженный звук. Внешний адрес файла не
   предлагается: звук идёт через Web Audio, а с чужого origin он там немой. *@
@* Окно не выше экрана (правило 3, M8): название и источник — в одной строке, начало, громкость и «по кругу» — в одной, настроения
   свёрнуты в строку. Громкость трека — только у файлов: у ролика YouTube её нет и в плеере (iPad чужой iframe не слушает). *@
<div class="grid gap-4 sm:grid-cols-6">
    <Field Label="Название" Required="true" class="sm:col-span-3"><input class="cm-input" @bind="Track.Name" /></Field>

    <Field Label="Источник" Group="true" class="sm:col-span-3">
        @* Выбор из двух — Segmented, а не тёмная кнопка: главная в окне одна — «Сохранить». *@
        <Segmented TValue="bool" Options="SourceOptions" Value="_youTube" ValueChanged="v => SetSource(youTube: v)" Label="Источник" />
    </Field>

    @if (_youTube)
    {
        @* Ссылка целиком (https://www.youtube.com/watch?v=…), а не голый идентификатор: по нему не видно, что за поле, и подсказка
           повторяла его второй раз («Ролик WF8iZWrOmb0»). Сервер достаёт идентификатор из ссылки любой формы. *@
        <Field Label="Ссылка на ролик" class="sm:col-span-4" Note="@VideoNote" Error="@VideoError">
            <input class="cm-input" placeholder="https://www.youtube.com/watch?v=…" value="@_videoText" @oninput="OnVideoInput" />
        </Field>
    }
    else
    {
        <Field Label="Звуковой файл" Group="true" class="sm:col-span-4" Note="mp3, ogg, m4a, wav, flac — до 50 МБ">
            <div class="flex flex-wrap items-center gap-3">
                <label class="@Css.Join("cm-btn cm-btn-secondary cm-btn-sm", _uploading ? "pointer-events-none opacity-70" : null)">
                    <i class="fa-solid fa-upload" aria-hidden="true"></i>
                    <span>@(_uploading ? "Загружаю…" : Track.FileId is null ? "Загрузить" : "Заменить")</span>
                    <InputFile class="sr-only" accept="audio/*" OnChange="UploadAsync" disabled="@_uploading" />
                </label>
                @if (Track.FileId is not null)
                {
                    <span class="cm-meta"><i class="fa-solid fa-file-audio mr-1" aria-hidden="true"></i>@(MusicText.FileLabel(Track.FileName) ?? "загружен")</span>
                }
            </div>
            @if (_uploadError is not null)
            {
                <Alert Tone="Tone.Error" Small="true" class="mb-0 mt-2">@_uploadError</Alert>
            }
        </Field>
    }

    <Field Label="Начать с секунды" class="sm:col-span-2">
        <input class="cm-input" type="number" min="0" inputmode="numeric" @bind="Track.StartSeconds" />
    </Field>

    <Field Label="Настроения" Group="true" class="sm:col-span-4">
        @if (!_tagsOpen)
        {
            @* Свёрнуто в строку: чипы всех известных тегов уводили «Заметки» под сгиб окна (M8). *@
            <div class="flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1">
                <span data-testid="track-tags-summary" class="@(Track.Tags.Count == 0 ? "cm-text-muted" : null)">@(Track.Tags.Count == 0 ? "Не выбраны" : string.Join(", ", Track.Tags))</span>
                <button type="button" class="cm-link-btn" @onclick="() => _tagsOpen = true">@(Track.Tags.Count == 0 ? "Выбрать" : "Изменить")</button>
            </div>
        }
        else
        {
            <MusicTagPicker Values="Track.Tags" ValuesChanged="tags => Track.Tags = [.. tags]" Known="KnownTags" />
        }
    </Field>
    <label class="cm-tap-row self-start sm:col-span-2 sm:pt-7">
        <input type="checkbox" class="cm-checkbox" @bind="Track.Loop" />
        <span>По кругу</span>
    </label>

    @if (!_youTube)
    {
        <Field Label="@($"Громкость трека: {Track.Volume}%")" class="sm:col-span-6">
            <input type="range" min="0" max="100" step="5" class="w-full max-w-sm" @bind="Track.Volume" @bind:event="oninput" />
        </Field>
    }

    <Field Label="Заметки" class="sm:col-span-6">
        <textarea class="cm-input" rows="2" @bind="Track.Notes"></textarea>
    </Field>
</div>

@code {
    private static readonly IReadOnlyList<SegmentOption<bool>> SourceOptions = [new(false, "Файл"), new(true, "YouTube")];

    private bool _youTube;
    private bool _tagsOpen;
    private string _videoText = "";
    private bool _uploading;
    private string? _uploadError;
    private MusicTrackDto? _for;

    [Parameter, EditorRequired] public MusicTrackDto Track { get; set; } = null!;

    [Parameter] public IReadOnlyList<string> KnownTags { get; set; } = [];

    protected override void OnParametersSet()
    {
        // Новая копия записи (окно открыли заново) — источник берём из неё; пока правят ту же копию,
        // переключатель не сбрасывается. Новый трек по умолчанию — файл: их в фонотеке большинство.
        if (!ReferenceEquals(_for, Track))
        {
            _for = Track;
            _youTube = Track.IsYouTube;
            _tagsOpen = false;
            _videoText = Track.YoutubeId is { Length: > 0 } id ? YouTubeVideo.WatchUrl(id) : "";
            _uploadError = null;
        }
    }

    private void SetSource(bool youTube)
    {
        _youTube = youTube;
        // Ровно одно из двух: второй источник сбрасывается, иначе сервер ответит 400.
        if (youTube)
        {
            Track.FileId = null;
            Track.FileName = null;
            Track.FileUrl = null;
        }
        else
        {
            Track.YoutubeId = null;
            _videoText = "";
        }
    }

    private string? VideoNote => YouTubeVideo.TryParseId(Track.YoutubeId, out _) ? null : "Ролик с запретом встраивания (чаще всего каналы «… - Topic») играть не будет.";

    private void OnVideoInput(ChangeEventArgs e)
    {
        _videoText = e.Value?.ToString() ?? "";
        Track.YoutubeId = _videoText;
    }

    private string? VideoError => !string.IsNullOrWhiteSpace(Track.YoutubeId) && !YouTubeVideo.TryParseId(Track.YoutubeId, out _)
        ? "Не похоже на ссылку на ролик YouTube."
        : null;

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _uploadError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: MaxFileBytes);
            var file = await Files.UploadAsync(stream, e.File.Name);
            Track.FileId = file.Id;
            Track.FileUrl = file.Url;
            Track.FileName = file.OriginalName ?? e.File.Name;
            Track.YoutubeId = null;
            if (string.IsNullOrWhiteSpace(Track.Name))
            {
                Track.Name = NameFromFile(e.File.Name);
            }
        }
        catch (HttpRequestException ex)
        {
            _uploadError = ApiErrors.Describe(ex);
        }
        catch (IOException)
        {
            _uploadError = "Файл больше 50 МБ.";
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>Предел загрузки сервера (<c>Files:MaxUploadBytes</c>), как у трека в v1.</summary>
    public const long MaxFileBytes = 50L * 1024 * 1024;

    /// <summary>Название трека из имени файла — без расширения, как в v1.</summary>
    public static string NameFromFile(string fileName) => Path.GetFileNameWithoutExtension(fileName).Trim();
}
