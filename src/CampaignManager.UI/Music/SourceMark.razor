@using CampaignManager.Contracts.Music

@* Откуда звук: ролик YouTube или загруженный файл — значок перед названием, с подписью для чтения с экрана. *@
@if (Track.IsYouTube)
{
    <i class="fa-brands fa-youtube mr-1.5 text-error-600" role="img" aria-label="YouTube"></i>
}
else
{
    <i class="fa-solid fa-file-audio mr-1.5 text-primary-400" role="img" aria-label="Файл"></i>
}

@code {
    [Parameter, EditorRequired] public MusicTrackDto Track { get; set; } = null!;
}
