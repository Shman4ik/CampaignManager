@using CampaignManager.Core.Encounters

@* «Что даёт — когда положено» для костей боя. Строки — сама таблица модификаторов Core
   (AttackModifiers.Table), по которой считает бой: памятка не может с ним разойтись. Что даёт строка —
   её пример, посчитанный той же таблицей. Своей карточки нет — таблица стоит в разделе ширмы. *@
<div class="cm-table-wrap">
    <table class="cm-table">
        <tbody>
            @foreach (var rule in Rules)
            {
                <tr data-testid="modifier-row">
                    <td class="w-2/5 font-semibold">@rule.Describe(rule.Example)</td>
                    <td>@rule.When <BookRef Page="@rule.Page.ToString()" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AttackModifierRule> Rules { get; set; } = [];
}
