@using CampaignManager.Core
@using CampaignManager.Core.Checks
@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters

@* Ширма → «Стрельба» (гл. 6, стр. 110–113, 117). Дальность и кости — из таблицы модификаторов Core
   (AttackModifiers), по которой считает бой: памятка не расходится с боем. *@
<div class="cm-stack">
    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Дальность задаёт сложность <BookRef Page="110" /></h3>
        <div class="cm-table-wrap">
            <table class="cm-table" data-testid="ks-ranges">
                <thead>
                    <tr>
                        <th>Дальность</th>
                        <th>Нужен успех</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (range, distance, note) in Ranges)
                    {
                        <tr>
                            <td>@distance</td>
                            <td>
                                <span class="font-semibold">@RulesText.Of(AttackModifiers.RequiredDifficulty(range))</span>
                                @if (note is not null)
                                {
                                    <div class="cm-field-note">@note</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="cm-field-note mt-2">
            Проверка Стрельбы не встречная: от пули не уклоняются, но можно укрыться от огня <BookRef Page="110–111" />.
        </p>
    </section>

    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Бонусные и штрафные кости <BookRef Page="111–112" /></h3>
        <ModifierTable Rules="@RangedRules" />
        <p class="cm-field-note mt-2">
            Кости складываются и гасят друг друга; больше @CheckRules.MaxExtraDice в одну сторону не бывает. Боевой
            помощник учитывает их сам — таблица для случаев, когда стреляют вне него.
        </p>
    </section>

    <section>
        <h3 class="cm-card-title mb-2">Прочее</h3>
        <ul class="list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>Оружие на изготовку — +50 к ЛВК при определении порядка ходов <BookRef Page="110" />.</li>
            <li>Осечка — выпало не меньше порога оружия: выстрела нет. Починка — 1d6 раундов и успех Механики или
                Стрельбы, одна попытка за раунд <BookRef Page="117" />.</li>
            <li>Зарядить два патрона в пистолет, дробовик или винтовку — раунд, сменить магазин — раунд, ленту
                пулемёта — два <BookRef Page="111" />.</li>
        </ul>
    </section>
</div>

@code {
    /// <summary>Только строки стрельбы: внезапность общая и стоит в «Костях» у ближнего боя, как в v1.</summary>
    private static readonly IReadOnlyList<AttackModifierRule> RangedRules =
        AttackModifiers.Table.Where(r => r.Kind == AttackKind.Ranged).ToList();

    private static readonly (RangeBand Range, string Distance, string? Note)[] Ranges =
    [
        (RangeBand.Base, "в пределах базовой дальности оружия", null),
        (RangeBand.Long, "до двух базовых", null),
        (RangeBand.Extreme, "до четырёх базовых", "проникающая рана — только при 01"),
    ];
}
