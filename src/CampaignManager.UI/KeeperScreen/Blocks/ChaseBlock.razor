@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters.Chase
@using CampaignManager.Core.KeeperScreen

@* Ширма → «Погоня»: главное из главы 7 и таблицы V–VI. Данные — VehicleReference (Core), те же, что у помощника погони
   (T2.6c); правила урона транспорту — VehicleRules. Пересказ, не цитата (D5). *@
<div class="keeper-cols">
    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Ход погони <BookRef Page="130–133" /></h3>
        <ul class="list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>Проверка скорости: ВЫН пешком, Вождение за рулём. Чрезвычайный успех — +1 СКО, провал — −1 на всю погоню.</li>
            <li>Убегающий быстрее самого быстрого преследователя — сразу уходит; преследователь медленнее самого медленного убегающего — отстаёт.</li>
            <li>Действий перемещения: 1 + разница со СКО самого медленного. Ход — по ЛВК, равная ЛВК — встречная проверка.</li>
            <li>Помеха: проходят всегда; 1–2 действия — бонусные кости; провал — урон (таблица III) и 1d3 потерянных действия.</li>
            <li>Преграда: не пускает без успешной проверки или пока не сломана; транспорт бьёт 1d10 за пункт Комплекции.</li>
            <li>Одна локация с убегающим — ещё не поимка: открывает бой и манёвр. Огнестрел — на любую дистанцию.</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Таблица VI. Столкновения транспорта <BookRef Page="145" /></h3>
        <div class="cm-table-wrap">
            <table class="cm-table" data-testid="ks-crashes">
                <thead>
                    <tr><th>Авария</th><th>Комплекция</th><th>Например</th></tr>
                </thead>
                <tbody>
                    @foreach (var crash in VehicleReference.Crashes)
                    {
                        <tr>
                            <td class="font-semibold">@crash.Name</td>
                            <td class="cm-dice whitespace-nowrap font-semibold">@DiceNotation.Format(crash.BuildLoss)</td>
                            <td>@crash.Examples</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>По умолчанию: обычная помеха — мелкая авария, трудная — средняя, чрезвычайная — серьёзная. Каждому внутри — та же кость урона; плюс 1d3 потерянных действия.</li>
            <li>Урон транспорту: каждые полные 10 — минус 1 Комплекции, остаток не учитывается.</li>
            <li>Комплекция упала до половины (вниз) — поломка: штрафная кость к Вождению. Потеря за одну аварию не меньше полной Комплекции — вдребезги.</li>
            <li>Шина: броня 3, только проникающее оружие, штрафная кость за размер; 2 урона после брони — Комплекция −1.</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Преграды и их ПЗ <BookRef Page="136" /></h3>
        <div class="flex flex-wrap gap-2">
            @foreach (var barrier in VehicleReference.Barriers)
            {
                <Badge Tone="Tone.Neutral">@barrier.Name: <span class="font-mono font-semibold">@barrier.HitPoints</span></Badge>
            }
        </div>
    </section>

    <section class="keeper-wide">
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Таблица V. Транспорт <BookRef Page="143" /></h3>
        <div class="cm-table-wrap">
            <table class="cm-table" data-testid="ks-vehicles">
                <thead>
                    <tr><th>Транспорт</th><th class="text-right">СКО</th><th class="text-right">Компл.</th><th class="text-right">Броня</th><th>Мест</th></tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in VehicleReference.Vehicles)
                    {
                        <tr>
                            <td>@vehicle.Name <span class="cm-field-note">· @VehicleReference.Of(vehicle.Category)</span></td>
                            <td class="text-right font-mono">@vehicle.Speed</td>
                            <td class="text-right font-mono">@ChaseText.Build(vehicle.Build)</td>
                            <td class="text-right font-mono">@vehicle.Armor</td>
                            <td>@vehicle.Passengers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
