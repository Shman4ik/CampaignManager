@using CampaignManager.Core.Characters
@using CampaignManager.Core.Dice

@* Ширма → «Удача» (гл. 5, стр. 88 и 97). Цены в калькуляторе считает LuckRules (Core) — та же арифметика,
   что у диалога проверки; потолок Удачи — DerivedAttributeRules. Чисел в разметке нет. *@
<div class="keeper-cols">
    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Проверка Удачи <BookRef Page="88" /></h3>
        <ul class="list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>Когда исход зависит от внешних сил, а не от умений сыщика. Если подходит навык — лучше навык.</li>
            <li>Общая проверка на группу — бросает тот, у кого Удача ниже всех.</li>
            <li>Беда должна случиться с кем-то одним — достаётся тому, у кого Удача ниже.</li>
        </ul>
    </section>

    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Трата Удачи <BookRef Page="97" /></h3>
        <ul class="list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>1 пункт Удачи уменьшает выпавшее число на 1. Тратить можно сколько угодно, но не больше текущей Удачи и
                только на свой бросок.</li>
            <li><strong>Нельзя</strong>: на проверки Удачи и Рассудка, на урон и потерю рассудка, на повторную проверку.
                Критический успех, крах и осечка действуют в любом случае — и критический успех Удачей не купить.</li>
            <li>При провале — либо повторная проверка, либо Удача.</li>
            <li>Успех, купленный Удачей, отметки для развития не даёт.</li>
        </ul>

        <div class="mt-3 flex flex-wrap items-end gap-3">
            <Field Label="Выпало" class="w-24">
                <input type="number" inputmode="numeric" min="1" max="100" class="cm-input" data-testid="ks-luck-roll"
                       @bind="_roll" @bind:event="oninput" />
            </Field>
            <Field Label="Навык" class="w-24">
                <input type="number" inputmode="numeric" min="1" max="200" class="cm-input" data-testid="ks-luck-skill"
                       @bind="_skill" @bind:event="oninput" />
            </Field>
        </div>
        <p class="mt-2 text-sm text-primary-700" data-testid="ks-luck-options">@LuckSummary()</p>
    </section>

    <section>
        <h3 class="cm-card-title mb-2 flex flex-wrap items-center gap-x-2">Восстановление <BookRef Page="97" /></h3>
        <ul class="list-disc space-y-2 pl-5 text-sm text-primary-700">
            <li>После каждой игровой встречи: 1d100, и если выпало больше текущей Удачи — +1d10.</li>
            <li>Удача не бывает выше @DerivedAttributeRules.MaxLuck; стартовое значение больше нигде не нужно.</li>
            <li>Остаться в сознании за Удачу — необязательное правило боя <BookRef Page="123" />, оно в боевом помощнике.</li>
        </ul>
    </section>
</div>

@code {
    private int? _roll = 35;
    private int? _skill = 27;

    private string LuckSummary()
    {
        if (_roll is not { } roll || _skill is not { } skill || roll is < 1 or > 100 || skill < 1)
            return "Впишите выпавшее число и значение навыка.";

        var level = RulesText.Of(LuckRules.LevelOf(roll, skill));
        if (!LuckRules.CanSpendOn(roll, skill))
            return $"Выпало {roll} против {skill}: {level} — выкупить нельзя.";

        var options = LuckRules.Options(roll, skill, int.MaxValue);
        if (options.Count == 0)
            return $"Выпало {roll} против {skill}: {level} — лучше не купить.";

        var prices = string.Join("; ", options.Select(o => $"{RulesText.Of(o.Level)} — {o.Cost} (станет {o.ResultingRoll})"));
        return $"Выпало {roll} против {skill}: {level}. За Удачу: {prices}.";
    }
}
