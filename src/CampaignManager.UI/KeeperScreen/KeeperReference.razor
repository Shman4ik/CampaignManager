@using CampaignManager.UI.KeeperScreen.Blocks
@inject KeeperScreenState Screen

@* Содержимое ширмы: вкладки разделов и один раздел под ними — одно и то же в панели (KeeperScreenHost) и
   на странице /reference. Своей карточки не рисует: рамку даёт место — тело панели или cm-card страницы.
   Вкладки — общие Tabs (44px, с подписью: наведения на планшете нет): одна строка, липкая, в панели листается вбок. *@
<div class="keeper-ref">
<Tabs Items="@TabItems" ActiveKey="@KeeperScreenBlocks.Slug(ActiveBlock)" ActiveKeyChanged="SelectAsync" Href="BlockHref"
      AriaLabel="Разделы ширмы" Sticky="true" Scrolls="true" />

<div data-testid="@($"keeper-screen-block-{KeeperScreenBlocks.Slug(ActiveBlock)}")">
    @switch (ActiveBlock)
    {
        case KeeperScreenBlock.Dice:
            <DiceBlock />
            break;
        case KeeperScreenBlock.Push:
            <PushBlock />
            break;
        case KeeperScreenBlock.Luck:
            <LuckBlock />
            break;
        case KeeperScreenBlock.Damage:
            <DamageBlock />
            break;
        case KeeperScreenBlock.Firearms:
            <FirearmsBlock />
            break;
        case KeeperScreenBlock.Sanity:
            <SanityBlock />
            break;
        case KeeperScreenBlock.Chase:
            <ChaseBlock />
            break;
        case KeeperScreenBlock.GroupCheck:
            <KeeperGroupCheck />
            break;
        default:
            <ChecksBlock />
            break;
    }
</div>
</div>

@code {
    private static readonly IReadOnlyList<Tabs.Item> TabItems =
        KeeperScreenBlocks.All.Select(b => new Tabs.Item(b.Slug, b.Label, b.Icon)).ToList();

    [Parameter] public KeeperScreenBlock ActiveBlock { get; set; }

    [Parameter] public EventCallback<KeeperScreenBlock> ActiveBlockChanged { get; set; }

    /// <summary>Адрес раздела (страница <c>/reference</c>, <c>?block=</c>): вкладки — ссылки. В панели ширмы адреса нет.</summary>
    [Parameter] public Func<string, string>? BlockHref { get; set; }

    private Task SelectAsync(string slug) => ActiveBlockChanged.InvokeAsync(KeeperScreenBlocks.FromSlug(slug));
}
