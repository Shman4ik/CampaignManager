@* Ссылка на страницу книги правил — единственный способ написать «стр. N» (правило 10). Значок книги и «стр. N»
   одним касанием открывают панель: что за книга и, если нужно, на что там смотреть. В тексте подписи, заголовке
   шага, названии кнопки, абзаце, журнале и результате номеров страниц нет — они живут только здесь. На экранах
   боя и погони, на листе, в помощнике и в подписях полей BookRef не ставят вовсе; допустимо — на ширме Хранителя,
   в окне справочника (в «ⓘ»), в экспорте и печати. *@
<TouchPopover AriaLabel="@($"Книга правил, {PageLabel}")" TriggerClass="cm-bookref">
    <Trigger>
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <span>@PageLabel</span>
    </Trigger>
    <Panel>
        <strong>@Book</strong>, @PageLabel
        @if (ChildContent is not null)
        {
            <span class="mt-1 block">@ChildContent</span>
        }
    </Panel>
</TouchPopover>

@code {
    /// <summary>Номер или диапазон: «277» или «277–280».</summary>
    [Parameter, EditorRequired] public string Page { get; set; } = "";

    [Parameter] public string Book { get; set; } = "Книга правил Call of Cthulhu 7e";

    /// <summary>Что искать на странице — одна строка.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string PageLabel => $"стр. {Page}";
}
