@implements IAsyncDisposable
@inject IJSRuntime JS

@* Открытое окно Modal. Живёт ровно столько, сколько окно открыто: появился — showModal(),
   убран из дерева — снимается блокировка прокрутки и фокус возвращается туда, где был. *@
<dialog @ref="_dialog" class="@Css.Join("cm-modal", SizeClass, PlacementClass, Css.ClassOf(AdditionalAttributes))"
        aria-labelledby="@_titleId" @attributes="Css.WithoutClass(AdditionalAttributes)">
    <div class="cm-modal-header">
        <h2 id="@_titleId" class="cm-modal-title">@Title</h2>
        <Button Variant="ButtonVariant.Ghost" Icon="fa-xmark" AriaLabel="Закрыть" OnClick="OnClose" />
    </div>
    <div class="cm-modal-body" style="@BodyStyle">
        @ChildContent
    </div>
    @if (Footer is not null)
    {
        <div class="cm-modal-footer">
            @if (FooterError is not null)
            {
                <div class="cm-modal-footer-error">@FooterError</div>
            }
            @if (FooterHint is not null)
            {
                <p class="cm-modal-footer-hint" data-testid="modal-footer-hint">@FooterHint</p>
            }
            @Footer
        </div>
    }
</dialog>

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ModalWindow>? _self;

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public ModalSize Size { get; set; }

    [Parameter] public bool Dismissible { get; set; }

    [Parameter] public ModalPlacement Placement { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public RenderFragment? FooterHint { get; set; }

    [Parameter] public RenderFragment? FooterError { get; set; }

    [Parameter] public string? MinHeight { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? BodyStyle => string.IsNullOrWhiteSpace(MinHeight) ? null : $"--cm-modal-min-height: {MinHeight}";

    private string? PlacementClass => Placement switch
    {
        ModalPlacement.Sheet => "cm-modal-sheet",
        ModalPlacement.Drawer => "cm-modal-drawer",
        ModalPlacement.Showcase => "cm-modal-showcase",
        _ => null,
    };

    private string SizeClass => Size switch
    {
        ModalSize.Small => "cm-modal-sm",
        ModalSize.Large => "cm-modal-lg",
        ModalSize.ExtraLarge => "cm-modal-xl",
        _ => "cm-modal-md",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CampaignManager.UI/Shared/ModalWindow.razor.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("show", _dialog, _self, Dismissible);
        }
        else if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("setDismissible", Dismissible);
        }
    }

    /// <summary>Esc или касание подложки — решает страница через OnClose.</summary>
    [JSInvokable]
    public Task RequestClose() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("release");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Страница уже выгружается — снимать нечего.
        }

        _self?.Dispose();
    }
}
