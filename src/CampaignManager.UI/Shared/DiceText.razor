@using CampaignManager.Core.Dice
@* Кости на экране — единственная точка вывода (правило 13): 1d6 + 2, 3d6 × 5, строчная d, пробелы вокруг
   операторов. Формула хранится как её ввели, форматируется здесь; остальной текст строки (например
   «+ бонус к урону») не трогается. Не разрывается переносом внутри броска. *@
@* Перенос — только перед «бонус к урону»: «1d8 + 1/2 бонус к урону» одной строкой держал столбец урона на 180px.
   Wrap — переносить по пробелам и внутри броска: плитке галереи в 134px «1d10 + 1d3 горение» не помещалось. *@
<span class="@Css.Join("cm-dice", Css.ClassOf(AdditionalAttributes))" @attributes="Css.WithoutClass(AdditionalAttributes)">@Parts()</span>

@code {
    [Parameter] public string? Value { get; set; }

    /// <summary>Пусто — тире словаря, а не пустая ячейка.</summary>
    [Parameter] public string Empty { get; set; } = CampaignManager.Core.Terms.None;

    /// <summary>Переносить и внутри броска — для узкой плитки, где формула шире колонки.</summary>
    [Parameter] public bool Wrap { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // Сокращение «БкУ» из данных тоже приводится к словарю (Terms): кость и бонус к урону пишутся в одном месте.
    private string Formatted => string.IsNullOrWhiteSpace(Value) ? Empty : CampaignManager.Core.Terms.Normalize(DiceNotation.Format(Value.Trim()));

    private string? NoWrap => Wrap ? null : "whitespace-nowrap";

    private RenderFragment Parts() => __builder =>
    {
        var text = Formatted;
        var at = text.IndexOf(" " + CampaignManager.Core.Terms.DamageBonus, StringComparison.Ordinal);
        if (at > 0)
        {
            <span class="@NoWrap">@text[..at]</span>@(" ")<span class="@NoWrap">@text[(at + 1)..]</span>
        }
        else
        {
            <span class="@NoWrap">@text</span>
        }
    };

    /// <summary>Тот же текст без разметки — для подписей, тостов и журнала.</summary>
    public static string Format(string? value) => CampaignManager.Core.Terms.Normalize(DiceNotation.Format(value));
}
