@* Шапка страницы — 56px, липнет к верху. Есть у каждой страницы, за ней — один <div class="cm-page">.
   Действия страницы — в Actions и всегда Small. Своих шапок в обход PageHeader не заводить:
   у самодельной не будет кнопок модулей (ширма, плеер).
   Шапка не знает модулей: кнопки «Ширма» и плеера модули кладут в слоты через
   <SectionContent SectionName="@PageHeaderSlots.KeeperScreen">. В v1 PageHeader импортировал
   Music и KeeperScreen, и UI-кит зависел от фич. *@
<PageTitle>@(DocumentTitle ?? Title)</PageTitle>

<header class="cm-topbar">
    <h1 class="cm-topbar-title" tabindex="-1">@Title</h1>
    <div class="cm-topbar-actions">
        @Actions
        @if (ShowModuleButtons)
        {
            <SectionOutlet SectionName="@PageHeaderSlots.Music" />
            <SectionOutlet SectionName="@PageHeaderSlots.KeeperScreen" />
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Заголовок вкладки браузера, если он отличается от шапки.</summary>
    [Parameter] public string? DocumentTitle { get; set; }

    /// <summary>Кнопки страницы — Size Small: шапка 56px.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Выключается только там, где кнопка модуля бессмысленна: на самой ширме.</summary>
    [Parameter] public bool ShowModuleButtons { get; set; } = true;
}
