@* Кнопка или ссылка-кнопка. Рисует ровно классы cm-btn — те же, что у ручной разметки, своих
   Tailwind-классов у компонента нет. Только иконка (без текста) — квадрат 44×44 (36×36 у Small)
   и обязательный AriaLabel: на iPad нет наведения, title= ничего не объяснит.
   Small (36px) — только кнопки шапки страницы и плотные таблицы каталога; css даёт 36px лишь внутри
   .cm-topbar и .cm-table-dense, в остальных местах Small — те же 44px. Выключенная кнопка называет
   причину (DisabledReason): строка 13px рядом, aria-describedby на кнопке. *@
@if (Href is not null && !Disabled)
{
    <a href="@Href" class="@Classes" aria-label="@AriaLabel" data-replace="@(Replace ? "" : null)" @attributes="Attributes">@Content</a>
}
else
{
    <button type="@Type" class="@Classes" disabled="@(Disabled || Busy)" aria-busy="@(Busy ? "true" : null)"
            aria-label="@AriaLabel" aria-describedby="@(ShowReason ? _reasonId : null)" @onclick="OnClick" @attributes="Attributes">@Content</button>
}

@if (ShowReason)
{
    <span id="@_reasonId" class="cm-btn-reason" data-testid="disabled-reason">@DisabledReason</span>
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>36px вместо 44px — только кнопки шапки страницы (56px) и плотные таблицы каталога. Остальным не ставить: вне них css всё равно рисует 44px.</summary>
    [Parameter] public bool Small { get; set; }

    /// <summary>
    /// Иконка Font Awesome: <c>fa-plus</c> (solid), другой набор — со своим префиксом:
    /// <c>fa-brands fa-google</c>, <c>fa-regular fa-floppy-disk</c>.
    /// </summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Обязателен у кнопки без текста: «Изменить: Кольт .45».</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Ссылка вместо кнопки (переход по адресу). У выключенной кнопки ссылки нет. Любой переход — так, а не <c>OnClick</c> с
    /// <c>NavigateTo</c>: средний клик и Ctrl+клик открывают ссылку в новой вкладке, кнопку — нет.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>
    /// Переход по <see cref="Href"/> заменяет запись в истории, а не добавляет (как <c>NavigateTo(…, replace: true)</c>):
    /// для переходов внутри страницы — локация, показ раздатки. Делает это <c>Layout/ReplaceLinks</c>.
    /// </summary>
    [Parameter] public bool Replace { get; set; }

    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Почему кнопка выключена, одной строкой: «Введите название», «Выберите файл». Показывается
    /// только пока кнопка выключена (<see cref="Disabled"/>); у действия, которое невозможно в
    /// принципе, кнопку не рисуют вовсе. Идёт сразу после кнопки (справа, а если не влезает — под ней).
    /// </summary>
    [Parameter] public string? DisabledReason { get; set; }

    /// <summary>Идёт запрос: спиннер вместо иконки, кнопка выключена — двойного нажатия не будет.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _reasonId = $"btn-reason-{Guid.NewGuid():N}";

    private bool ShowReason => Disabled && !string.IsNullOrWhiteSpace(DisabledReason);

    private bool IconOnly => ChildContent is null;

    private string IconClass => Icon!.StartsWith("fa-brands ", StringComparison.Ordinal) || Icon.StartsWith("fa-regular ", StringComparison.Ordinal)
        ? Icon
        : $"fa-solid {Icon}";

    private IReadOnlyDictionary<string, object>? Attributes => Css.WithoutClass(AdditionalAttributes);

    private string Classes => Css.Join(
        "cm-btn",
        VariantClass,
        Small ? "cm-btn-sm" : null,
        IconOnly ? "cm-btn-icon" : null,
        Css.ClassOf(AdditionalAttributes));

    private string VariantClass => Variant switch
    {
        ButtonVariant.Secondary => "cm-btn-secondary",
        ButtonVariant.Success => "cm-btn-success",
        ButtonVariant.Error => "cm-btn-error",
        ButtonVariant.Warning => "cm-btn-warning",
        ButtonVariant.OutlinePrimary => "cm-btn-outline-primary",
        ButtonVariant.OutlineError => "cm-btn-outline-error",
        ButtonVariant.Ghost => "cm-btn-ghost",
        _ => "cm-btn-primary",
    };

    protected override void OnParametersSet()
    {
        if (IconOnly && string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException("Кнопке без текста нужен AriaLabel: иконка одна ничего не говорит.");
        }
    }

    private RenderFragment Content => __builder =>
    {
        if (Busy)
        {
            <span class="cm-spinner cm-spinner-sm" aria-hidden="true"></span>
        }
        else if (Icon is not null)
        {
            <i class="@IconClass" aria-hidden="true"></i>
        }

        if (ChildContent is not null)
        {
            <span>@ChildContent</span>
        }
    };
}
