@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Таблица справочника или списка: колонки — DataColumn, сортировка по заголовку, раскрытие строки.
   Своей карточки не рисует — стоит в cm-card страницы (одна карточка, никогда две).
   Широкая таблица прокручивается в своей обёртке, страница вбок не едет. На телефоне вместо
   таблицы — строки из CardTemplate, если он задан; правки и удаление в нём те же, что в таблице.
   В v1 четыре ListView повторяли это на ~80% (701 строка разметки и 604 строки CSS). *@
<CascadingValue Value="this" IsFixed="true">@Columns</CascadingValue>

@if (CardTemplate is not null)
{
    <div @ref="_cards" class="@Css.Join(CardsClass, "scroll-mt-16")">
        @* Узкий экран (портрет, телефон): заголовков с кнопками сортировки нет — порядок задаёт этот выбор: одной
           строкой, без подписи (её несёт aria-label) и только когда есть что упорядочивать (одна запись — не из чего). *@
        @if (SortableColumns.Count > 0 && _total > 1)
        {
            <div class="cm-sortbar">
                <label class="cm-sortbar-field">
                    <select class="cm-input" aria-label="Сортировка" value="@SortSelectValue" @onchange="SortSelectedAsync">
                        @foreach (var column in SortableColumns)
                        {
                            <option value="@ColumnId(column)">@column.Title</option>
                        }
                    </select>
                </label>
                <Button Variant="ButtonVariant.Secondary" Icon="@(SortedDescendingNow ? "fa-arrow-down-wide-short" : "fa-arrow-up-short-wide")"
                        AriaLabel="@(SortedDescendingNow ? "По убыванию — изменить на по возрастанию" : "По возрастанию — изменить на по убыванию")"
                        OnClick="ReverseSortAsync" />
            </div>
        }
        @if (_items.Count == 0)
        {
            <p class="px-4 py-5 text-center text-sm text-primary-500">@EmptyText</p>
        }
        @foreach (var item in _items)
        {
            var cardKey = KeyOf(item);
            <div @key="cardKey" class="border-t border-primary-200 px-4 py-3 first:border-t-0" data-open="@(_expanded.Contains(cardKey) ? "true" : null)">@CardTemplate(item)</div>
        }
    </div>
}

@* cm-table-dense — кнопки строки 36px (Small), а не 44: так строка таблицы плотная, как и задумано в ките. *@
<div @ref="_wrap" class="@Css.Join("cm-table-wrap cm-table-dense", CardTemplate is not null ? TableClass : null, Scroll ? "cm-table-scroll" : null,
                Scroll && HasToggle ? "cm-table-scroll-detail" : null)">
    <table class="cm-table" aria-label="@AriaLabel">
        <thead>
            <tr>
                @if (HasToggle)
                {
                    <th class="w-px"><span class="sr-only">Подробности</span></th>
                }
                @foreach (var column in _columns)
                {
                    <th class="@Css.Join(AlignClass(column), column.HeaderClass)" aria-sort="@AriaSort(column)">
                        @if (IsSortable(column))
                        {
                            <button type="button" class="cm-th-sort" @onclick="() => SortByAsync(column)">
                                <span>@column.Title</span>
                                <i class="fa-solid @SortIcon(column)" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            @column.Title
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (_items.Count == 0 && _columns.Count > 0)
            {
                <tr><td colspan="@ColumnCount" class="py-5 text-center text-primary-500">@EmptyText</td></tr>
            }
            @foreach (var item in _items)
            {
                var key = KeyOf(item);
                var expandable = Expandable(item);
                var expanded = expandable && _expanded.Contains(key);
                <tr @key="key" class="@Css.Join(expanded ? "cm-row-expanded" : null, Clickable(expandable) ? "cursor-pointer" : null)"
                    @onclick="() => RowClickedAsync(item, key, expandable)">
                    @if (HasToggle)
                    {
                        <td class="cm-td-toggle" @onclick:stopPropagation="true">
                            @if (expandable)
                            {
                                <Button Variant="ButtonVariant.Ghost" Small="true" Icon="@(expanded ? "fa-chevron-up" : "fa-chevron-down")"
                                        AriaLabel="@(expanded ? "Свернуть" : "Подробнее")" aria-expanded="@(expanded ? "true" : "false")"
                                        OnClick="() => Toggle(key)" />
                            }
                        </td>
                    }
                    @foreach (var column in _columns)
                    {
                        <td class="@Css.Join(AlignClass(column), column.CellClass)">@column.ChildContent?.Invoke(item)</td>
                    }
                </tr>
                @if (expanded && RowDetail is not null)
                {
                    <tr class="cm-row-detail" @key="(key, 1)">
                        <td colspan="@ColumnCount">@RowDetail(item)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly List<DataColumn<TItem>> _columns = [];
    private readonly HashSet<object> _expanded = [];
    private List<TItem> _items = [];
    private DataColumn<TItem>? _sortColumn;
    private bool _descending;
    private ElementReference _wrap;
    private ElementReference _cards;
    private IJSObjectReference? _module;
    private int _total;
    private bool _hasToggle;
    private string? _arrangement;
    private string? _shownArrangement;
    private object? _revealedKey;

    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];

    /// <summary>DataColumn — по одной на колонку.</summary>
    [Parameter, EditorRequired] public RenderFragment? Columns { get; set; }

    /// <summary>Ключ строки для @key и раскрытия; по умолчанию — сам элемент.</summary>
    [Parameter] public Func<TItem, object>? RowKey { get; set; }

    /// <summary>Содержимое раскрытой строки. Задан — в строке появляется шеврон, касание строки раскрывает её.</summary>
    [Parameter] public RenderFragment<TItem>? RowDetail { get; set; }

    /// <summary>Строка-карточка для телефона (уже md). Не задан — таблица прокручивается вбок.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>
    /// Сортировка снаружи (постраничный список с сервера): задан обработчик — таблица не сортирует
    /// сама, а сообщает ключ колонки (<see cref="DataColumn{TItem}.SortKey"/>), и порядок задаёт Items.
    /// </summary>
    [Parameter] public DataSort? Sort { get; set; }

    [Parameter] public EventCallback<DataSort> SortChanged { get; set; }

    [Parameter] public string EmptyText { get; set; } = "Ничего не найдено.";

    /// <summary>Можно ли раскрыть строку: нечего показать — ни шеврона, ни реакции на касание.</summary>
    [Parameter] public Func<TItem, bool>? CanExpand { get; set; }

    /// <summary>
    /// Страница списка (с 1) при <see cref="PageSize"/> &gt; 0: таблица сначала сортирует все строки,
    /// потом берёт страницу — иначе сортировка шла бы внутри одной страницы.
    /// </summary>
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>
    /// Строка, раскрытая снаружи (<c>?open=</c> в адресе): раскрывается, когда ключ меняется. Без
    /// <see cref="OpenKeyChanged"/> строки раскрываются и сворачиваются сами, ключ их только добавляет.
    /// </summary>
    [Parameter] public object? OpenKey { get; set; }

    /// <summary>
    /// Задан — таблица управляется снаружи: раскрыта ровно одна строка, та, что в <see cref="OpenKey"/>; касание
    /// строки не раскрывает её само, а сообщает ключ (или null — свернуть). Так состояние живёт в адресе
    /// (<c>?open=</c>): переживает F5, на него можно дать ссылку.
    /// </summary>
    [Parameter] public EventCallback<object?> OpenKeyChanged { get; set; }

    /// <summary>Строк на страницу; 0 — все.</summary>
    [Parameter] public int PageSize { get; set; }

    /// <summary>С какой ширины вместо карточек таблица: у плотного справочника — позже (замер по колонкам).</summary>
    [Parameter] public TableBreakpoint TableFrom { get; set; } = TableBreakpoint.Md;

    /// <summary>
    /// Таблица — свой скроллпорт по высоте экрана: шапка и первая колонка липнут, страница целиком
    /// не прокручивается (плотные справочники: 25 строк по восьми числовым колонкам без подписей не читаются).
    /// </summary>
    [Parameter] public bool Scroll { get; set; }

    [Parameter] public string? AriaLabel { get; set; }

    private bool ExternalSort => SortChanged.HasDelegate;

    // Снаружи сортируют по ключу запроса, в таблице — по значению колонки.
    private bool IsSortable(DataColumn<TItem> column) => ExternalSort ? column.SortKey is not null : column.SortBy is not null;

    private bool Clickable(bool expandable) => OnRowClick.HasDelegate || (RowDetail is not null && expandable);

    private bool Expandable(TItem item) => RowDetail is not null && (CanExpand?.Invoke(item) ?? true);

    // Классы целыми литералами: Tailwind ищет их в исходниках текстом.
    private string CardsClass => TableFrom switch
    {
        TableBreakpoint.Lg => "lg:hidden",
        TableBreakpoint.Xl => "xl:hidden",
        _ => "md:hidden",
    };

    private string TableClass => TableFrom switch
    {
        TableBreakpoint.Lg => "hidden lg:block",
        TableBreakpoint.Xl => "hidden xl:block",
        _ => "hidden md:block",
    };

    private int ColumnCount => _columns.Count + (HasToggle ? 1 : 0);

    internal void AddColumn(DataColumn<TItem> column)
    {
        _columns.Add(column);
        if (column.DefaultSort is { } descending && _sortColumn is null && !ExternalSort)
        {
            _sortColumn = column;
            _descending = descending;
        }

        Refresh();
    }

    internal void RemoveColumn(DataColumn<TItem> column)
    {
        _columns.Remove(column);
        Refresh();
    }

    private object? _openedKey;

    private bool Controlled => OpenKeyChanged.HasDelegate;

    /// <summary>
    /// Колонка шеврона есть, только когда на странице есть что раскрывать: у предметов раскрывается одна строка из 257,
    /// и пустая колонка слева от названия отнимала 96px у каждой остальной (X9). Считается по строкам страницы: на
    /// той единственной, где есть раскрываемая, колонка появится, на остальных — нет.
    /// </summary>
    private bool HasToggle => _hasToggle;

    protected override void OnParametersSet()
    {
        _total = Items is ICollection<TItem> all ? all.Count : Items.Count();

        if (Controlled)
        {
            _expanded.Clear();
            if (OpenKey is not null)
            {
                _expanded.Add(OpenKey);
            }
        }
        else if (OpenKey is not null && !Equals(OpenKey, _openedKey))
        {
            _expanded.Add(OpenKey);
        }

        _openedKey = OpenKey;
        _items = Arrange();
    }

    // После отрисовки: список сменился (страница, фильтр, поиск, порядок) — прокрутить таблицу к началу; раскрыли
    // строку, которой не видно (ссылка ?open= на запись с четвёртой страницы), — показать её. Без этого человек
    // листает на «2» и видит строки 6–10, а запись по ссылке лежит под нижним краем (X2, X3).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var open = _expanded.Count > 0 && OpenKey is not null && !Equals(OpenKey, _revealedKey);
        if (OpenKey is null)
        {
            _revealedKey = null;
        }

        var arranged = _arrangement != _shownArrangement;
        _shownArrangement = _arrangement;
        if (!open && !arranged)
        {
            return;
        }

        if (open)
        {
            _revealedKey = OpenKey;
        }

        if (!open && firstRender)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CampaignManager.UI/Shared/DataTable.razor.js");
            await _module.InvokeVoidAsync(open ? "revealOpen" : "scrollToStart", _wrap, CardTemplate is null ? null : (object)_cards);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void Refresh()
    {
        _items = Arrange();
        StateHasChanged();
    }

    private List<TItem> Arrange()
    {
        IEnumerable<TItem> items = Items;
        _arrangement = $"{Page}|{_sortColumn?.Title}|{_descending}|{Sort?.Key}|{Sort?.Descending}|{_total}|{(Items.FirstOrDefault() is { } first ? KeyOf(first) : null)}";
        if (!ExternalSort && _sortColumn?.SortBy is { } sortBy)
        {
            items = _descending
                ? items.OrderByDescending(sortBy, Comparer<object?>.Default)
                : items.OrderBy(sortBy, Comparer<object?>.Default);
        }

        var page = PageSize > 0
            ? items.Skip((Math.Max(1, Page) - 1) * PageSize).Take(PageSize).ToList()
            : items.ToList();
        _hasToggle = RowDetail is not null && (CanExpand is null || page.Any(Expandable));
        return page;
    }

    private object KeyOf(TItem item) => RowKey?.Invoke(item) ?? item!;

    private async Task SortByAsync(DataColumn<TItem> column, bool? forceDescending = null)
    {
        if (ExternalSort)
        {
            var descending = forceDescending ?? (Sort is { } current && current.Key == column.SortKey && !current.Descending);
            await SortChanged.InvokeAsync(new DataSort(column.SortKey!, descending));
            return;
        }

        _descending = forceDescending ?? (_sortColumn == column && !_descending);
        _sortColumn = column;
        _items = Arrange();
    }

    // ── Сортировка на узком экране: выбор вместо заголовков ──

    private List<DataColumn<TItem>> SortableColumns => [.. _columns.Where(IsSortable)];

    private string ColumnId(DataColumn<TItem> column) => _columns.IndexOf(column).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private DataColumn<TItem>? CurrentSortColumn => ExternalSort
        ? _columns.FirstOrDefault(c => c.SortKey is not null && Sort is { } sort && sort.Key == c.SortKey)
        : _sortColumn;

    private string SortSelectValue => CurrentSortColumn is { } column ? ColumnId(column) : "";

    private bool SortedDescendingNow => CurrentSortColumn is { } column && SortedDescending(column) == true;

    private Task SortSelectedAsync(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var index) && index >= 0 && index < _columns.Count
            ? SortByAsync(_columns[index], false)
            : Task.CompletedTask;

    private Task ReverseSortAsync() =>
        (CurrentSortColumn ?? SortableColumns.FirstOrDefault()) is { } column
            ? SortByAsync(column, CurrentSortColumn is null ? false : !SortedDescendingNow)
            : Task.CompletedTask;

    private bool? SortedDescending(DataColumn<TItem> column) => ExternalSort
        ? Sort is { } sort && sort.Key == column.SortKey ? sort.Descending : null
        : _sortColumn == column ? _descending : null;

    private string? AriaSort(DataColumn<TItem> column) => SortedDescending(column) switch
    {
        true => "descending",
        false => "ascending",
        null => null,
    };

    private string SortIcon(DataColumn<TItem> column) => SortedDescending(column) switch
    {
        true => "fa-sort-down",
        false => "fa-sort-up",
        null => "fa-sort text-primary-300",
    };

    private static string? AlignClass(DataColumn<TItem> column) => column.AlignEnd ? "text-right" : null;

    private void Toggle(object key)
    {
        if (Controlled)
        {
            _ = OpenKeyChanged.InvokeAsync(_expanded.Contains(key) ? null : key);
            return;
        }

        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    private async Task RowClickedAsync(TItem item, object key, bool expandable)
    {
        if (expandable)
        {
            Toggle(key);
        }

        if (OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(item);
        }
    }
}
