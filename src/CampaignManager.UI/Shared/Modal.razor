@* Диалог — единственный: свои fixed inset-0 с белой панелью не заводить, подтверждение —
   DialogService.ConfirmAsync поверх этого же компонента (в v1 было два диалога с двумя копиями
   JS и подложки). Закрытый Modal ничего не рендерит: в v1 все диалоги страницы жили в дереве
   скрытыми, и id="modal-title" повторялся.
   Окно — нативный <dialog> в верхнем слое: фокус внутрь, Esc и подложку даёт браузер,
   прокрутку страницы под ним блокирует ModalWindow.razor.js.
   Правила окна (design-system.md, п. 3): фокус открытия — в первое поле (`autofocus` или первый
   input/select/textarea тела), в окне без полей — на главную кнопку подвала, не на «Закрыть»;
   размеры — Small (подтверждение, одно поле), Medium (форма, 576px), Large (форма с таблицей, 768px),
   в одном модуле не больше двух; высота не прыгает — MinHeight по самому высокому состоянию;
   подвал: слева «Отмена» (Secondary), справа одно главное; ошибка сервера — FooterError над кнопками. *@
@if (Open)
{
    <ModalWindow Title="@Title" Size="@Size" Dismissible="@Dismissible" Placement="@Placement"
                 OnClose="OnClose" Footer="@Footer" FooterHint="@FooterHint" FooterError="@FooterError"
                 MinHeight="@MinHeight" AdditionalAttributes="@AdditionalAttributes">
        @ChildContent
    </ModalWindow>
}

@code {
    [Parameter] public bool Open { get; set; }

    /// <summary>Крестик, Esc и касание подложки. Закрывает страница: ставит Open = false.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;

    /// <summary>
    /// false — подложка и Esc не закрывают окно, остаётся только крестик. Для диалогов посреди
    /// игры, где случайное касание мимо окна не должно ничего пропускать (проверка ВЫН умирающих).
    /// </summary>
    [Parameter] public bool Dismissible { get; set; } = true;

    [Parameter] public ModalPlacement Placement { get; set; } = ModalPlacement.Center;

    /// <summary>Кнопки: «Отмена» (Secondary) слева и одно главное действие справа.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Причина, по которой главная кнопка выключена, одной строкой над кнопками: «Введите название».</summary>
    [Parameter] public RenderFragment? FooterHint { get; set; }

    /// <summary>Ошибка сервера (<c>ApiErrors</c>) — Alert над кнопками подвала, а не в начале прокручиваемого тела.</summary>
    [Parameter] public RenderFragment? FooterError { get; set; }

    /// <summary>
    /// Минимальная высота тела (CSS: <c>"28rem"</c>) для окна, чья высота иначе прыгает: результат броска,
    /// смена вкладки. Берут по самому высокому состоянию; выше экрана тело не растёт — прокручивается.
    /// </summary>
    [Parameter] public string? MinHeight { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
