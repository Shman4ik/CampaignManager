@* Список строк: связи сыщика, ключевые факты, теги. Каждая правка отдаёт новый список
   (@bind-Values) — документ листа или сценария получает новый экземпляр, а не правку на месте,
   которую не заметил бы ни трекер EF, ни сравнение черновика. Пустые строки не добавляются.
   Своей карточки не рисует; подпись — Field Group="true" вокруг. *@
<div class="@Css.Join("min-w-0", Css.ClassOf(AdditionalAttributes))" @attributes="Css.WithoutClass(AdditionalAttributes)">
    @for (var i = 0; i < Values.Count; i++)
    {
        var index = i;
        var value = Values[index];
        @* Поле растёт по содержимому (field-sizing): фраза в 60+ знаков («вы случайно выронили что-то при обыске…»)
           не прячется за краем однострочного input. «Убрать» — нейтральный крестик, а не красная корзина: правка —
           черновик формы, «Отмена» вернёт всё, а красный цвет у десяти строк подряд кричит об опасности (X10). *@
        <div class="list-row" @key="index">
            <textarea class="cm-input" rows="1" aria-label="@($"{ItemLabel} {index + 1}")" value="@value"
                      @onchange="e => ReplaceAsync(index, e.Value?.ToString())"></textarea>
            <Button Variant="ButtonVariant.Ghost" Icon="fa-xmark" AriaLabel="@($"Удалить: {value}")"
                    OnClick="() => RemoveAsync(index)" />
        </div>
    }

    @* «Добавить» появляется, когда есть что добавлять: серая кнопка рядом с пустым полем ничего не говорила (X11);
       Enter добавляет и без неё. *@
    <div class="@Css.Join("list-row", Values.Count > 0 ? "mt-2" : null)">
        <input class="cm-input" placeholder="@Placeholder" aria-label="@($"Новый: {ItemLabel}")" @bind="_draft"
               @bind:event="oninput" @onkeydown="OnKeyDownAsync" />
        @if (!string.IsNullOrWhiteSpace(_draft))
        {
            <Button Variant="ButtonVariant.Secondary" Icon="fa-plus" OnClick="AddAsync">Добавить</Button>
        }
    </div>
</div>

@code {
    private string? _draft;

    [Parameter] public IReadOnlyList<string> Values { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Как назвать строку для экранного диктора: «Связь», «Факт».</summary>
    [Parameter] public string ItemLabel { get; set; } = "Строка";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task AddAsync()
    {
        var value = _draft?.Trim();
        if (string.IsNullOrEmpty(value))
        {
            return;
        }

        _draft = null;
        await ValuesChanged.InvokeAsync([.. Values, value]);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddAsync();
        }
    }

    private Task ReplaceAsync(int index, string? value)
    {
        var trimmed = value?.ReplaceLineEndings(" ").Trim();
        var list = Values.ToList();
        if (string.IsNullOrEmpty(trimmed))
        {
            list.RemoveAt(index);
        }
        else
        {
            list[index] = trimmed;
        }

        return ValuesChanged.InvokeAsync(list);
    }

    private Task RemoveAsync(int index)
    {
        var list = Values.ToList();
        list.RemoveAt(index);
        return ValuesChanged.InvokeAsync(list);
    }
}
