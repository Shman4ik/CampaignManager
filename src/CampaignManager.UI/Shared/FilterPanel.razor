@* Фильтр страницы-списка — одна строка с переносом в карточке, с md липнет под шапку (top-14 — её
   56px). Без шапки «Фильтры», без сворачивания, «Сбросить фильтры» — одна кнопка в конце строки, неактивна, пока
   фильтров нет (CanReset; правило 4 — единственный случай неактивной кнопки без причины рядом: причина очевидна).
   Подписей над полями нет: смысл несут placeholder, aria-label и первый пункт селекта («Любой тип»).
   Поля — прямые дети строки, ширину задаёт страница: поиск — min-w-48 flex-1, селект —
   w-full sm:w-56 shrink-0. Блок, которому нужна своя строка, — w-full order-last.
   Порядок страницы-списка: FilterPanel → LoadingIndicator/EmptyState → список → Pagination. *@
<div class="cm-card z-10 mb-4 md:sticky md:top-14">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3">
        @ChildContent
        @if (OnReset.HasDelegate || Actions is not null)
        {
            <div class="ms-auto flex max-w-full shrink-0 flex-wrap justify-end gap-2">
                @if (OnReset.HasDelegate)
                {
                    <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-rotate-left" Disabled="!CanReset" OnClick="OnReset">@CampaignManager.Core.Terms.ResetFilters</Button>
                }
                @Actions
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public EventCallback OnReset { get; set; }

    /// <summary>Есть что сбрасывать. Страница, не знающая этого, оставляет кнопку активной.</summary>
    [Parameter] public bool CanReset { get; set; } = true;
}
