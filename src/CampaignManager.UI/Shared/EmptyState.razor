@* Пустой список. Сам — карточка, поэтому ставится на место списка, а не внутрь другой карточки.
   Текст — две короткие фразы, вторая подсказывает действие: «В базе нет существ.» /
   «Добавьте первое существо, чтобы начать.» Пусто из-за фильтра — «Нет существ по этим
   условиям.» и вторичная «Очистить фильтры» рядом с основным действием. *@
<div class="cm-card">
    <div class="cm-card-body flex flex-col items-center justify-center px-6 py-10 text-center">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100">
            <i class="fa-solid @Icon text-2xl text-primary-400" aria-hidden="true"></i>
        </div>
        <h2 class="cm-h6">@Title</h2>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="cm-text-muted max-w-prose">@Message</p>
        }
        @if (Actions is not null)
        {
            <div class="mt-5 flex flex-wrap justify-center gap-2">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Message { get; set; }

    [Parameter] public string Icon { get; set; } = "fa-magnifying-glass";

    /// <summary>Основное действие (Primary, «Добавить …») и, если пусто из-за фильтра, Secondary «Очистить фильтры».</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
