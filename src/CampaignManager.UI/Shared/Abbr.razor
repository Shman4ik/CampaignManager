@* Сокращение с расшифровкой по касанию — для столбца, куда полное слово не влезает (правило 11: сокращение в
   заголовке допустимо, только если расшифровка видна текстом, а не лежит в title=). Касание открывает полную
   форму под значком. Если слово влезает — пишите его целиком и Abbr не берите. *@
<TouchPopover AriaLabel="@($"{Short} — {Full}")" TriggerClass="cm-abbr">
    <Trigger><abbr>@Short</abbr></Trigger>
    <Panel><strong>@Short</strong> — @Full</Panel>
</TouchPopover>

@code {
    /// <summary>Что стоит в столбце: «МКН».</summary>
    [Parameter, EditorRequired] public string Short { get; set; } = "";

    /// <summary>Расшифровка: «Мифы: начальное чтение».</summary>
    [Parameter, EditorRequired] public string Full { get; set; } = "";
}
