@* Метка-пилюля. Бейдж ставят только если он несёт отличие: «НПС» у каждой строки списка НПС ничего не различает,
   а «редк.» у одного оружия — да (правило 17). Тон — по смыслу (Tone): Error — ошибка и опасность, а не «НПС»
   и не «пронз.» (то свойство, не ошибка — Neutral); Warning — внимание, Success — успех, Info — выделение,
   Neutral/Stone — просто признак. Solid — плотная заливка только для состояний, которые
   обязаны остановить Хранителя: Мёртв, При смерти, Бессрочное безумие. *@
<span class="@Css.Join("cm-badge", ToneClasses.Badge(Tone), Solid ? "cm-badge-solid" : null, Css.ClassOf(AdditionalAttributes))"
      @attributes="Css.WithoutClass(AdditionalAttributes)">
    @if (Icon is not null)
    {
        <i class="fa-solid @Icon" aria-hidden="true"></i>
    }
    @ChildContent
</span>

@code {
    [Parameter] public Tone Tone { get; set; } = Tone.Neutral;

    [Parameter] public bool Solid { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
