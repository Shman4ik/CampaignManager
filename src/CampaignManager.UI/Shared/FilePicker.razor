@using Microsoft.AspNetCore.Components.Forms
@* Выбор файла по-русски: своя кнопка «Выбрать файл» и имя выбранного, а не системное «Choose File / No file
   chosen» (правило 17). Настоящий <input type="file"> лежит внутри кнопки-подписи, невидим, но остаётся в порядке
   табуляции (фокус рисуется на кнопке). Нельзя выбрать — рядом одной строкой причина: «Сначала введите название»
   (правило 8; причина в title= не считается). Файл читает страница из OnChange (InputFileChangeEventArgs). *@
<div class="@Css.Join("cm-file-picker", Css.ClassOf(AdditionalAttributes))">
    <label class="@Css.Join("cm-btn cm-btn-secondary", Disabled ? "cm-file-picker-disabled" : null)">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
        <span>@Label</span>
        <InputFile class="sr-only" OnChange="OnChangedAsync" accept="@Accept" multiple="@Multiple" disabled="@Disabled"
                   autofocus="@AutoFocus" aria-describedby="@DescriptionId" />
    </label>
    <span id="@DescriptionId" class="@Css.Join("cm-file-picker-name", Disabled ? "text-primary-600" : null)">@Description</span>
</div>

@code {
    private static int _next;
    private readonly string _descriptionId = $"cm-file-{Interlocked.Increment(ref _next)}";
    private string? _chosen;

    /// <summary>Подпись кнопки. «Выбрать файл» — по умолчанию; при Multiple — «Выбрать файлы».</summary>
    [Parameter] public string? ButtonText { get; set; }

    /// <summary>Допустимые типы: «.json», «image/*».</summary>
    [Parameter] public string? Accept { get; set; }

    [Parameter] public bool Multiple { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Фокус при открытии окна — на «Выбрать файл» (в окне, где другого поля нет, он иначе падал на «Отмену»).</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Почему выбрать нельзя — показывается вместо имени файла, пока Disabled.</summary>
    [Parameter] public string? DisabledReason { get; set; }

    /// <summary>Имя выбранного файла, если его знает страница (загрузка закончилась, файл уже в записи); иначе — что выбрал пользователь.</summary>
    [Parameter] public string? FileName { get; set; }

    [Parameter] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string Label => ButtonText ?? (Multiple ? "Выбрать файлы" : "Выбрать файл");

    private string DescriptionId => _descriptionId;

    private string Description => Disabled && !string.IsNullOrWhiteSpace(DisabledReason)
        ? DisabledReason
        : FileName ?? _chosen ?? (Multiple ? "Файлы не выбраны" : "Файл не выбран");

    private async Task OnChangedAsync(InputFileChangeEventArgs e)
    {
        var names = e.GetMultipleFiles(int.MaxValue).Select(f => f.Name).ToList();
        _chosen = names.Count switch
        {
            0 => null,
            1 => names[0],
            _ => $"Выбрано файлов: {names.Count}",
        };
        await OnChange.InvokeAsync(e);
    }
}
