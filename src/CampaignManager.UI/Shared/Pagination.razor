@* Страницы списка: полоса ПОД карточкой списка, вне её (правило 17 — одинаково в таблице, галерее и профессиях;
   раньше подвал карточки, а у галереи — своя карточка). Кнопки 44px (палец), ряд переносится. Обработчик любого
   фильтра обязан сбрасывать страницу на первую — иначе с пятой страницы поиск уводит в пустоту. Одна страница —
   полосы нет. *@
@if (TotalPages > 1)
{
    <nav class="cm-pagination" aria-label="Страницы">
        <span class="cm-pagination-count">
            @StartItem–@EndItem из @TotalItems
        </span>
        <div class="flex flex-wrap items-center gap-2">
            <Button Variant="ButtonVariant.Secondary" Icon="fa-angles-left" AriaLabel="Первая страница"
                    Disabled="@(CurrentPage == 1)" OnClick="() => GoToAsync(1)" />
            <Button Variant="ButtonVariant.Secondary" Icon="fa-angle-left" AriaLabel="Предыдущая страница"
                    Disabled="@(CurrentPage == 1)" OnClick="() => GoToAsync(CurrentPage - 1)" />
            @for (var i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
            {
                var number = i;
                <Button Variant="@(number == CurrentPage ? ButtonVariant.Primary : ButtonVariant.Secondary)"
                        aria-current="@(number == CurrentPage ? "page" : null)" OnClick="() => GoToAsync(number)">@number</Button>
            }
            <Button Variant="ButtonVariant.Secondary" Icon="fa-angle-right" AriaLabel="Следующая страница"
                    Disabled="@(CurrentPage == TotalPages)" OnClick="() => GoToAsync(CurrentPage + 1)" />
            <Button Variant="ButtonVariant.Secondary" Icon="fa-angles-right" AriaLabel="Последняя страница"
                    Disabled="@(CurrentPage == TotalPages)" OnClick="() => GoToAsync(TotalPages)" />
        </div>
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;

    [Parameter] public int PageSize { get; set; } = 20;

    [Parameter] public int TotalItems { get; set; }

    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    // PageSize 0 — список без страниц (галерея предметов по типам): одна страница, полосы нет.
    private int TotalPages => PageSize > 0 ? Math.Max(1, (TotalItems + PageSize - 1) / PageSize) : 1;

    private int StartItem => Math.Min((CurrentPage - 1) * PageSize + 1, TotalItems);

    private int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private Task GoToAsync(int page) =>
        page >= 1 && page <= TotalPages && page != CurrentPage
            ? CurrentPageChanged.InvokeAsync(page)
            : Task.CompletedTask;
}
