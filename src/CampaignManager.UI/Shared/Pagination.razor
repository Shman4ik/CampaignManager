@* Постраничный список: подвал карточки со списком. Обработчик любого фильтра обязан сбрасывать
   страницу на первую — иначе с пятой страницы поиск уводит в пустоту. *@
@if (TotalPages > 1)
{
    <nav class="cm-card-footer justify-between" aria-label="Страницы">
        <span class="text-[0.8125rem] text-primary-500">
            @StartItem–@EndItem из @TotalItems
        </span>
        <div class="flex flex-wrap items-center gap-1.5">
            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-angles-left" AriaLabel="Первая страница"
                    Disabled="@(CurrentPage == 1)" OnClick="() => GoToAsync(1)" />
            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-angle-left" AriaLabel="Предыдущая страница"
                    Disabled="@(CurrentPage == 1)" OnClick="() => GoToAsync(CurrentPage - 1)" />
            @for (var i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
            {
                var number = i;
                <Button Variant="@(number == CurrentPage ? ButtonVariant.Primary : ButtonVariant.Secondary)" Small="true"
                        aria-current="@(number == CurrentPage ? "page" : null)" OnClick="() => GoToAsync(number)">@number</Button>
            }
            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-angle-right" AriaLabel="Следующая страница"
                    Disabled="@(CurrentPage == TotalPages)" OnClick="() => GoToAsync(CurrentPage + 1)" />
            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-angles-right" AriaLabel="Последняя страница"
                    Disabled="@(CurrentPage == TotalPages)" OnClick="() => GoToAsync(TotalPages)" />
        </div>
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;

    [Parameter] public int PageSize { get; set; } = 20;

    [Parameter] public int TotalItems { get; set; }

    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    private int TotalPages => Math.Max(1, (TotalItems + PageSize - 1) / PageSize);

    private int StartItem => Math.Min((CurrentPage - 1) * PageSize + 1, TotalItems);

    private int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private Task GoToAsync(int page) =>
        page >= 1 && page <= TotalPages && page != CurrentPage
            ? CurrentPageChanged.InvokeAsync(page)
            : Task.CompletedTask;
}
