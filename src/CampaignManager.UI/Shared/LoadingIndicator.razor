@* Единственный спиннер приложения: своих animate-spin на страницах не рисовать. Кольцо —
   акцент, как фокус полей: это «идёт работа», а не статус. *@
<div class="flex flex-col items-center justify-center gap-3 py-10 text-center" role="status" aria-live="polite">
    <span class="cm-spinner" aria-hidden="true"></span>
    <span class="text-sm text-primary-500">@(string.IsNullOrWhiteSpace(Message) ? "Загрузка…" : Message)</span>
</div>

@code {
    [Parameter] public string? Message { get; set; }
}
