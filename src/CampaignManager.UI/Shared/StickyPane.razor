@* Колонка действия на экранах-сценах (бой, погоня, режим игры): форма, результат, «Следующий» не уезжают из
   виду, пока прокручивают длинный список участников (правило 14). Липнет под шапку (top-14 — её 56px) с lg
   (1024 — портрет iPad уже в две колонки), если выше экрана — прокручивается внутри. Тот же стиль без компонента —
   класс cm-sticky-pane. Родитель колонки не должен иметь overflow, иначе sticky не сработает. *@
<div class="@Css.Join("cm-sticky-pane", Css.ClassOf(AdditionalAttributes))" @attributes="Css.WithoutClass(AdditionalAttributes)">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
