@* Вкладки над содержимым. Компонент ничего не хранит: открытую вкладку решает страница
   (@bind-ActiveKey), и держит её в адресе (?tab=…), чтобы на неё можно было дать ссылку.
   Содержимое вкладки страница рисует под компонентом сама. Вкладка 44px — палец на iPad.
   Sticky — липкие под шапкой (top-14) для страниц-сцен и ширмы, где вкладки нужны при прокрутке (правило 14).
   Подпись вкладки = заголовок окна создания («Факты» — «Новый факт»); счётчик нуля не рисуется. *@
<div class="@Css.Join("cm-tabs", Sticky ? "cm-tabs-sticky" : null)" role="tablist" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        var active = item.Key == ActiveKey;
        <button type="button" role="tab" class="cm-tab" aria-selected="@(active ? "true" : "false")"
                @onclick="() => SelectAsync(item.Key)">
            @if (item.Icon is not null)
            {
                <i class="fa-solid @item.Icon" aria-hidden="true"></i>
            }
            <span>@item.Label</span>
            @if (item.Count is > 0)
            {
                <span class="cm-tab-count">@item.Count</span>
            }
        </button>
    }
</div>

@code {
    /// <summary>Вкладка: ключ, подпись, иконка Font Awesome и счётчик (виден, если больше нуля).</summary>
    public sealed record Item(string Key, string Label, string? Icon = null, int? Count = null);

    [Parameter, EditorRequired] public IReadOnlyList<Item> Items { get; set; } = [];

    [Parameter] public string ActiveKey { get; set; } = "";

    [Parameter] public EventCallback<string> ActiveKeyChanged { get; set; }

    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Вкладки липнут под шапку страницы (<c>top-14</c>) — для сцен и ширмы, где страница длинная.</summary>
    [Parameter] public bool Sticky { get; set; }

    private Task SelectAsync(string key) =>
        key == ActiveKey ? Task.CompletedTask : ActiveKeyChanged.InvokeAsync(key);
}
