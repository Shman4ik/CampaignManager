@implements IDisposable
@inject DialogService Dialogs

@* Окно DialogService.ConfirmAsync. Стоит один раз в MainLayout. Фокус по умолчанию — на «Отмене»:
   Enter после случайного касания не должен удалять. *@
@if (Dialogs.Current is { } request)
{
    <Modal Open="true" Title="@request.Title" Size="ModalSize.Small" OnClose="() => Dialogs.Complete(false)">
        <ChildContent>
            <p>@request.Message</p>
            @if (!string.IsNullOrEmpty(request.Details))
            {
                <p class="mt-2 text-[0.8125rem] text-primary-500">@request.Details</p>
            }
        </ChildContent>
        <Footer>
            <Button Variant="ButtonVariant.Secondary" autofocus OnClick="() => Dialogs.Complete(false)">@request.CancelText</Button>
            <Button Variant="@request.ConfirmVariant" data-testid="confirm-dialog-ok" OnClick="() => Dialogs.Complete(true)">@request.ConfirmText</Button>
        </Footer>
    </Modal>
}

@code {
    protected override void OnInitialized() => Dialogs.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Dialogs.Changed -= OnChanged;
}
