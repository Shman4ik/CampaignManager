@typeparam TData
@implements IDisposable

@* Данные, которые грузятся: спиннер → содержимое, пусто → Empty, ошибка → Alert с «Повторить».
   Вместо @if (_isLoading) в 25 файлах v1 и самодельных try/catch вокруг каждого запроса.
   Грузит при первом показе и при смене Key (id из адреса); ReloadAsync() — после правки.
   Повторная загрузка не прячет уже показанные данные: спиннер — только на пустом месте. *@
@if (_error is not null)
{
    <Alert Tone="Tone.Error" Title="@ErrorTitle" ShowIcon="true">
        <ChildContent>@_error</ChildContent>
        <Actions>
            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-rotate-right" OnClick="ReloadAsync">Повторить</Button>
        </Actions>
    </Alert>
}
else if (!_loaded)
{
    <LoadingIndicator Message="@LoadingMessage" />
}
else if (Empty is not null && IsEmptyData(_data))
{
    @Empty
}
else
{
    @ChildContent?.Invoke(_data!)
}

@code {
    private CancellationTokenSource? _cts;
    private TData? _data;
    private bool _loaded;
    private string? _error;
    private object? _loadedKey;
    private bool _started;

    [Parameter, EditorRequired] public Func<CancellationToken, Task<TData>> Load { get; set; } = null!;

    [Parameter] public RenderFragment<TData>? ChildContent { get; set; }

    /// <summary>Что показать, если данных нет (обычно EmptyState).</summary>
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>Пусто ли. По умолчанию — null или коллекция без элементов.</summary>
    [Parameter] public Func<TData, bool>? IsEmpty { get; set; }

    /// <summary>Сменился — данные перечитываются (id сущности из адреса).</summary>
    [Parameter] public object? Key { get; set; }

    [Parameter] public string? LoadingMessage { get; set; }

    [Parameter] public string ErrorTitle { get; set; } = "Не удалось загрузить";

    /// <summary>Последние загруженные данные — для страницы, которой они нужны вне разметки.</summary>
    public TData? Data => _data;

    protected override async Task OnParametersSetAsync()
    {
        if (!_started || !Equals(Key, _loadedKey))
        {
            _started = true;
            _loaded = false;
            await ReloadAsync();
        }
    }

    public async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        _loadedKey = Key;
        _error = null;
        StateHasChanged();

        try
        {
            var data = await Load(token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            _data = data;
            _loaded = true;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode is { } status
                ? $"Сервер ответил {(int)status}. Попробуйте ещё раз; если ошибка повторится — сообщите о ней."
                : "Нет связи с сервером. Проверьте подключение и повторите.";
        }

        StateHasChanged();
    }

    private bool IsEmptyData(TData? data) => IsEmpty is not null
        ? data is not null && IsEmpty(data)
        : data is null || (data is System.Collections.IEnumerable items && !items.Cast<object>().Any());

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
