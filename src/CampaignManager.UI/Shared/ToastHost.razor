@implements IDisposable
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Стопка уведомлений ToastService снизу по центру (на телефоне — над нижней панелью): шапку и кнопки
   «Начать»/«Завершить» они не закрывают. Стоит один раз в MainLayout. Переход на другую страницу (другой путь, не только
   ?query) снимает тосты с «Отменить»: их действие правит объект ушедшей страницы. *@
<div class="cm-toasts" aria-live="polite">
    @foreach (var toast in Toasts.Messages)
    {
        <Alert @key="toast.Id" Tone="toast.Tone" Title="@toast.Title" ShowIcon="true" OnClose="() => Toasts.Dismiss(toast.Id)"
               Actions="@(toast.Action is null ? null : ActionOf(toast))">
            @toast.Lead
            @if (toast.Lead != toast.Message)
            {
                <strong data-testid="toast-subject">@toast.Subject</strong>
            }
        </Alert>
    }
</div>

@code {
    private RenderFragment ActionOf(ToastMessage toast) => __builder =>
    {
        <Button Variant="ButtonVariant.Secondary" data-testid="toast-action" OnClick="() => Toasts.RunActionAsync(toast.Id)">@toast.Action!.Label</Button>
    };

    private string _path = "";

    protected override void OnInitialized()
    {
        _path = PathOf(Navigation.Uri);
        Toasts.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var path = PathOf(e.Location);
        if (path == _path)
            return; // смена ?mode=, ?open= — та же страница, её «Отменить» по-прежнему в силе

        _path = path;
        Toasts.DropActions();
    }

    private string PathOf(string uri) => Navigation.ToBaseRelativePath(uri).Split('?', '#')[0];

    public void Dispose()
    {
        Toasts.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
