@* Корневой компонент приложения. Рендерится в WebAssembly без пререндера (D1); статически —
   только страницы с [ExcludeFromInteractiveRouting] вроде /Error сервера, их маршрут Router
   берёт у эндпоинта.
   Страница под [Authorize]: без сессии — на /login, с сессией без прав — «Нет доступа». Права
   страниц — только политиками (Policies.Keeper/Admin), см. Identity/CLAUDE.md. *@
@using CampaignManager.Core.Identity
@using CampaignManager.UI.Pages
<Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <NoAccess AdminOnly="@RequiresAdmin(routeData)"
                              IsKeeperOrAdmin="@(context.User.IsInRole(nameof(UserRole.Keeper)) || context.User.IsInRole(nameof(UserRole.Admin)))" />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <LoadingIndicator />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    /// <summary>Страница закрыта политикой администратора — по атрибуту страницы, как её проверяет и сервер.</summary>
    private static bool RequiresAdmin(RouteData routeData) =>
        routeData.PageType.GetCustomAttributes(typeof(AuthorizeAttribute), inherit: true)
            .Cast<AuthorizeAttribute>().Any(a => a.Policy == Policies.Admin);
}
