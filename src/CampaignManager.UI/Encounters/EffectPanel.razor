@using CampaignManager.Core.Catalogs
@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters
@inject IDiceRoller Dice

@* Эффект Хранителя: урон, лечение, потеря рассудка, ПМ, МОЩ — руками, по одной или по нескольким целям (падение,
   вид твари для всей группы). Тоже эффект, а не правка участника: он проходит предпросмотр и Apply и пишется в лист —
   третьего пути мимо Apply нет (AUDIT, «Сцены»). Число — с костей: формулу бросает DiceFormula (Core) отдельно для
   каждой цели, и любое число можно вписать руками. Потеря рассудка от твари — с её записью «успех/провал» и видом для
   привыкания (стр. 167). Своей карточки не рисует. *@
<div class="flex flex-col gap-3" data-testid="effect-panel">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Что меняем">
        @foreach (var kind in Kinds)
        {
            <Button Small="true" Variant="@(kind == _kind ? ButtonVariant.Primary : ButtonVariant.Secondary)" OnClick="() => SelectKind(kind)">
                @EncounterText.Of(kind)
            </Button>
        }
    </div>

    @if (_kind == EncounterEffectKind.SanityLoss && Creatures.Count > 0)
    {
        <Field Label="Откуда потеря" Note="Тварь — запись «успех/провал» и привыкание к её виду">
            <ParticipantSelect Participants="Creatures" Label="Тварь — источник потери" Placeholder="— без твари —"
                               Value="_creatureId" ValueChanged="SelectCreature" />
        </Field>
        @if (Creature?.SanityLoss is { } loss)
        {
            var parts = SanityLossFormula.Parse(loss);
            <div class="flex flex-wrap gap-2">
                <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => UseFormula(parts.OnSuccess.Text)">Успех: @parts.OnSuccess.Text</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => UseFormula(parts.OnFailure.Text)">Провал: @parts.OnFailure.Text</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => UseMax(parts.OnFailure)">Крах: @parts.OnFailure.Max</Button>
            </div>
        }
    }

    <Field Label="Цели" Group="true">
        <ParticipantSelect Participants="State.Participants" Where="TargetFilter" Multiple="true" Label="Цели эффекта"
                           Values="_targets" ValuesChanged="SetTargets" />
    </Field>

    @if (_kind is EncounterEffectKind.MagicPoints or EncounterEffectKind.Power)
    {
        <div class="flex flex-wrap gap-2" role="group" aria-label="Направление">
            <Button Small="true" Variant="@(_spend ? ButtonVariant.Primary : ButtonVariant.Secondary)" OnClick="() => _spend = true">Трата</Button>
            <Button Small="true" Variant="@(!_spend ? ButtonVariant.Primary : ButtonVariant.Secondary)" OnClick="() => _spend = false">Прибавка</Button>
        </div>
    }

    <div class="flex flex-wrap items-end gap-2">
        <Field Label="Формула или число" class="w-40" Error="@_formulaError">
            <input class="cm-input font-mono" data-testid="effect-formula" placeholder="1d6+1" value="@_formula" @onchange="SetFormula" />
        </Field>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice" Disabled="@(_targets.Count == 0)" OnClick="RollAll"
                class="mb-1">@(_targets.Count > 1 ? "Бросить каждому" : "Бросить")</Button>
    </div>

    @if (_targets.Count > 0)
    {
        <div class="flex flex-col gap-2">
            @foreach (var target in Targets)
            {
                <div class="flex flex-wrap items-center gap-2" @key="target.Id">
                    <span class="min-w-32 font-medium">@target.Name</span>
                    <input type="number" inputmode="numeric" min="0" class="cm-input cm-input-sm w-24" data-testid="effect-amount"
                           aria-label="@($"{EncounterText.Of(_kind)}: {target.Name}")"
                           value="@(_amounts.TryGetValue(target.Id, out var a) ? a.Value.ToString(CultureInfo.InvariantCulture) : "")"
                           @onchange="e => SetAmount(target.Id, e)" />
                    @if (_amounts.TryGetValue(target.Id, out var entered) && entered.Detail is { } detail)
                    {
                        <span class="cm-meta font-mono">@detail</span>
                    }
                </div>
            }
        </div>
    }

    <div>
        <Button Variant="ButtonVariant.Primary" Icon="fa-eye" Disabled="@(!CanPropose)" OnClick="ProposeAsync" data-testid="effect-preview">Предпросмотр</Button>
    </div>
</div>

@code {
    /// <summary>Число цели и откуда оно: «1d6 → 4», «вписано».</summary>
    private sealed record Amount(int Value, string? Detail);

    private static readonly EncounterEffectKind[] Kinds =
    [
        EncounterEffectKind.Damage, EncounterEffectKind.Heal, EncounterEffectKind.SanityLoss,
        EncounterEffectKind.MagicPoints, EncounterEffectKind.Power,
    ];

    private EncounterEffectKind _kind = EncounterEffectKind.Damage;
    private IReadOnlySet<Guid> _targets = new HashSet<Guid>();
    private readonly Dictionary<Guid, Amount> _amounts = [];
    private string _formula = "";
    private string? _formulaError;
    private Guid? _creatureId;
    private bool _spend = true;

    [Parameter, EditorRequired] public EncounterState State { get; set; } = null!;

    /// <summary>Готовый результат — странице на предпросмотр (<c>EncounterEngine.Propose</c>).</summary>
    [Parameter] public EventCallback<EncounterResolution> OnPropose { get; set; }

    private List<EncounterParticipant> Creatures => [.. State.Participants.Where(p => p.Kind == ParticipantKind.Creature)];

    private EncounterParticipant? Creature => _creatureId is { } id ? State.Find(id) : null;

    private List<EncounterParticipant> Targets => [.. State.Participants.Where(p => _targets.Contains(p.Id))];

    private bool CanPropose => Targets.Count > 0 && Targets.All(t => _amounts.ContainsKey(t.Id));

    /// <summary>Рассудок — только у листов; остальное — у всех.</summary>
    private Func<EncounterParticipant, bool>? TargetFilter =>
        _kind == EncounterEffectKind.SanityLoss ? p => p.Sanity is not null : null;

    private void SelectKind(EncounterEffectKind kind)
    {
        _kind = kind;
        _amounts.Clear();
        if (kind == EncounterEffectKind.SanityLoss)
            _targets = _targets.Where(id => State.Find(id)?.Sanity is not null).ToHashSet();
    }

    private void SelectCreature(Guid? creatureId)
    {
        _creatureId = creatureId;
        if (Creature?.SanityLoss is { } loss)
            UseFormula(SanityLossFormula.Parse(loss).OnFailure.Text);
    }

    private void SetTargets(IReadOnlySet<Guid> targets)
    {
        _targets = targets;
        foreach (var gone in _amounts.Keys.Where(id => !targets.Contains(id)).ToList())
            _amounts.Remove(gone);
        FillConstant();
    }

    private void SetFormula(ChangeEventArgs e) => UseFormula(e.Value?.ToString() ?? "");

    private void UseFormula(string formula)
    {
        _formula = formula.Trim();
        var parsed = DiceFormula.Parse(_formula);
        _formulaError = _formula.Length > 0 && !parsed.IsValid ? "Не разобрать: кости как «1d6+2» или «1д6»." : null;
        _amounts.Clear();
        FillConstant();
    }

    /// <summary>Крах на проверке рассудка — максимум провальной части (знание v1: «крах = максимум»).</summary>
    private void UseMax(DiceFormula formula)
    {
        _formula = formula.Max.ToString(CultureInfo.InvariantCulture);
        _formulaError = null;
        _amounts.Clear();
        foreach (var target in Targets)
            _amounts[target.Id] = new Amount(formula.Max, $"крах: максимум {formula.Text}");
    }

    /// <summary>Формула без костей — число: каждой цели то же, бросать нечего.</summary>
    private void FillConstant()
    {
        var parsed = DiceFormula.Parse(_formula);
        if (_formula.Length == 0 || !parsed.IsValid || parsed.HasDice)
            return;

        foreach (var target in Targets)
            _amounts.TryAdd(target.Id, new Amount(Math.Max(0, parsed.Constant), null));
    }

    private void RollAll()
    {
        var parsed = DiceFormula.Parse(_formula);
        if (_formula.Length == 0 || !parsed.IsValid)
        {
            _formulaError = "Впишите формулу — или числа целям прямо в поля.";
            return;
        }

        foreach (var target in Targets)
        {
            var value = Math.Max(0, parsed.Roll(Dice));
            _amounts[target.Id] = new Amount(value, parsed.HasDice ? $"{parsed.Text} → {value}" : null);
        }
    }

    private void SetAmount(Guid targetId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) && value >= 0)
            _amounts[targetId] = new Amount(value, "вписано");
        else
            _amounts.Remove(targetId);
    }

    private async Task ProposeAsync()
    {
        if (!CanPropose)
            return;

        var creature = _kind == EncounterEffectKind.SanityLoss ? Creature : null;
        var sign = _kind is EncounterEffectKind.MagicPoints or EncounterEffectKind.Power && _spend ? -1 : 1;
        var resolution = new EncounterResolution
        {
            Kind = EncounterLogKind.Effect,
            Title = $"{EncounterText.Of(_kind)}{(creature is null ? "" : $" от вида «{creature.SourceName}»")}: {string.Join(", ", Targets.Select(t => t.Name))}",
            Lines = _formula.Length > 0 ? [$"Формула: {_formula}"] : [],
            Effects =
            [
                .. Targets.Select(t => new EncounterEffect
                {
                    Kind = _kind,
                    ParticipantId = t.Id,
                    Amount = sign * _amounts[t.Id].Value,
                    Detail = _amounts[t.Id].Detail,
                    CreatureName = creature?.SourceName,
                    CreatureId = creature?.SourceCreatureId,
                    SanityLossFormula = creature?.SanityLoss,
                }),
            ],
        };
        await OnPropose.InvokeAsync(resolution);
        _amounts.Clear();
        FillConstant();
    }
}
