@using CampaignManager.Core.Encounters

@* Журнал сцены — один на бой и погоню (в v1: CombatLog и ChaseLog с тремя switch-словарями). Подпись и категория —
   EncounterText (Core), полоса слева — по категории (насилие — нейтральная: красный в системе — «ошибка», а не «ударили»).
   Запись — заголовок и одна строка итога («кто: что, было → стало»), остальное — под «Подробнее»: одна атака занимала 8–9
   строк (B35). Свежее сверху, раунд — метка у записи. Лежит на всю ширину под рабочей областью: длинная запись в узкой колонке
   портрета iPad разворачивалась на десяток строк (знание v1, Chase/CLAUDE.md). Своей карточки не рисует. *@
@if (Entries.Count == 0)
{
    <p class="cm-text-muted px-4 py-3">Записей пока нет.</p>
}
else
{
    <ol class="flex flex-col" data-testid="encounter-log">
        @foreach (var entry in Visible)
        {
            var lines = EncounterDisplay.VisibleLines(entry);
            var summary = EncounterDisplay.Summary(lines);
            var more = summary is null ? lines : [.. lines.Where(l => !l.StartsWith(summary, StringComparison.Ordinal))];
            var text = EncounterDisplay.Plain(entry.Text);
            var label = EncounterText.Of(entry.Kind);
            <li @key="entry.Id" class="@Css.Join("encounter-log-entry", CategoryClass(EncounterText.Category(entry.Kind)))">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    @if (entry.Round > 0)
                    {
                        <span class="cm-meta font-mono">Р@(entry.Round)</span>
                    }
                    @* «Вступили: …» — метка уже в тексте записи, второй раз её не пишем. *@
                    @if (!text.StartsWith(label, StringComparison.Ordinal))
                    {
                        <span class="text-sm font-semibold text-primary-700">@label</span>
                    }
                    <span class="text-primary-900">@text</span>
                </div>
                @if (summary is not null)
                {
                    <div class="mt-0.5 text-sm text-primary-700" data-testid="log-summary">@summary</div>
                }
                @if (more.Count > 0)
                {
                    <details class="encounter-more">
                        <summary class="cm-meta cursor-pointer">Подробнее (@more.Count)</summary>
                        <ul class="mt-1 flex flex-col gap-0.5 text-sm text-primary-700">
                            @foreach (var line in more)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </details>
                }
            </li>
        }
    </ol>
    @if (Entries.Count > _limit)
    {
        <div class="px-3 py-2">
            <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => _limit += PageSize">Показать ещё @Math.Min(PageSize, Entries.Count - _limit)</Button>
        </div>
    }
}

@code {
    private const int PageSize = 50;
    private int _limit = PageSize;

    [Parameter, EditorRequired] public IReadOnlyList<EncounterLogEntry> Entries { get; set; } = [];

    private IEnumerable<EncounterLogEntry> Visible => Entries.Reverse().Take(_limit);

    // Классы — целыми литералами: Tailwind и поиск по коду видят только их.
    private static string CategoryClass(EncounterLogCategory category) => category switch
    {
        EncounterLogCategory.Movement => "encounter-log-movement",
        EncounterLogCategory.Obstacle => "encounter-log-obstacle",
        EncounterLogCategory.Violence => "encounter-log-violence",
        EncounterLogCategory.Sanity => "encounter-log-sanity",
        EncounterLogCategory.Magic => "encounter-log-magic",
        EncounterLogCategory.Escaped => "encounter-log-escaped",
        EncounterLogCategory.Caught => "encounter-log-caught",
        _ => "encounter-log-system",
    };
}
