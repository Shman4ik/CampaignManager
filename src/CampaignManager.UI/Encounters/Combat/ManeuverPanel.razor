@* Манёвр (стр. 103; подписи те же, что у «Атаки»: «Кто действует», «Цель»; навык и защита — в «Дополнительно»): разоружить, сбить с ног, захват, толкнуть, вырваться, невыгодное положение; нокаут — необязательное
   правило (стр. 123). Комплекция — из снимков: разница 3+ — невозможно, меньше — штрафные кости. Правила —
   CombatRules.Maneuver. Своей карточки не рисует. *@
<div class="flex flex-col gap-3" data-testid="maneuver-panel">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Field Label="Кто действует">
            <ParticipantSelect Participants="State.Participants" Where="Alive" Label="Кто выполняет манёвр" Value="ActorId" ValueChanged="SelectActor" Grouped="true" />
        </Field>
        <Field Label="Цель">
            <ParticipantSelect Participants="State.Participants" Where="p => p.Id != ActorId && !p.Dead" Label="Цель манёвра" Value="_targetId" ValueChanged="v => _targetId = v"
                               Grouped="true" Perspective="Actor" />
        </Field>
    </div>

    <Field Label="Манёвр" Group="true">
        @* Выбор из набора — Segmented (светлый с галочкой), а не тёмная плита главного действия: «Провести манёвр» одна (B24). *@
        <Segmented TValue="ManeuverType" Options="TypeOptions" Value="_type" ValueChanged="v => _type = v" Label="Манёвр" />
    </Field>

    @if (Actor is { } actor && Target is { } target)
    {
        var gap = target.Stats.Build - actor.Stats.Build;
        if (gap >= 3)
        {
            <Alert Tone="Tone.Warning" Small="true" class="mb-0">Манёвр невозможен: @target.Name крупнее на @gap (комплекция @target.Stats.Build против @actor.Stats.Build).</Alert>
        }
        else if (gap > 0)
        {
            <p class="cm-meta">@target.Name крупнее: штрафных костей @Math.Min(gap, 2) (комплекция @target.Stats.Build против @actor.Stats.Build).</p>
        }
        <details class="encounter-rolls" data-testid="maneuver-extra">
            <summary><i class="fa-solid fa-sliders mr-2" aria-hidden="true"></i>Дополнительно</summary>
            <div class="mt-2 flex flex-wrap gap-4">
                <Field Label="Навык манёвра" Group="true">
                    <select class="cm-input" aria-label="Навык манёвра" value="@_skillKey" @onchange="e => _skillKey = e.Value?.ToString()">
                        @foreach (var attack in actor.Profile.Attacks.Where(a => a.Kind is CombatAttackKind.Melee or CombatAttackKind.Maneuver))
                        {
                            <option value="@attack.Key" selected="@(attack.Key == _skillKey)">@attack.Name — @attack.Skill%</option>
                        }
                    </select>
                </Field>
                <Field Label="Цель защищается" Group="true">
                    <Segmented TValue="DefenseReaction" Options="Reactions" Value="_reaction" ValueChanged="v => _reaction = v" Label="Цель защищается" />
                </Field>
                <Field Label="Кости Хранителя" Group="true">
                    <ExtraDicePicker Value="_net" ValueChanged="v => _net = v" />
                </Field>
            </div>
        </details>
        <details class="encounter-rolls">
            <summary><i class="fa-solid fa-dice mr-2" aria-hidden="true"></i>Вписать броски с костей</summary>
            <div class="mt-2 flex flex-col gap-3">
                <Field Label="Манёвр" Group="true">
                    <RollInput Label="Манёвр" Value="@Skill(actor)" BonusDice="@Split(_net).Bonus" PenaltyDice="@(Split(_net).Penalty + Math.Clamp(gap, 0, 2))"
                               Roll="_attackRoll" RollChanged="r => _attackRoll = r" />
                </Field>
                <Field Label="Защита цели" Group="true">
                    <RollInput Label="Защита" Value="@(_reaction == DefenseReaction.Dodge ? target.Stats.Dodge : target.Profile.FightBack)" Roll="_defenseRoll" RollChanged="r => _defenseRoll = r" />
                </Field>
            </div>
        </details>
    }

    <div>
        <Button Icon="fa-people-pulling" Disabled="@(Actor is null || Target is null)" DisabledReason="@(Actor is null ? "Выберите, кто действует" : Target is null ? "Выберите цель" : null)"
                OnClick="ResolveAsync" data-testid="maneuver-resolve">Провести манёвр</Button>
    </div>
</div>

@code {
    private Guid? _targetId;
    private ManeuverType _type = ManeuverType.KnockDown;
    private DefenseReaction _reaction;
    private int _net;
    private string? _skillKey;
    private D100Roll? _attackRoll, _defenseRoll;

    private static readonly IReadOnlyList<SegmentOption<DefenseReaction>> Reactions =
        [new(DefenseReaction.Dodge, "Уклонение"), new(DefenseReaction.FightBack, "Контратака")];

    private IReadOnlyList<SegmentOption<ManeuverType>> TypeOptions => [.. Types.Select(t => new SegmentOption<ManeuverType>(t, CombatRules.NameOf(t)))];

    private IEnumerable<ManeuverType> Types => State.Combat.CinematicKnockout
        ? Enum.GetValues<ManeuverType>()
        : Enum.GetValues<ManeuverType>().Where(t => t != ManeuverType.Knockout);

    private EncounterParticipant? Target => _targetId is { } id ? State.Find(id) : null;

    private int Skill(EncounterParticipant actor) =>
        actor.Profile.Attacks.FirstOrDefault(a => a.Key == _skillKey)?.Skill
        ?? actor.Profile.Attacks.Where(a => a.Kind is CombatAttackKind.Melee or CombatAttackKind.Maneuver).Select(a => a.Skill).DefaultIfEmpty(0).Max();

    protected override void OnActorChanged()
    {
        _skillKey = Actor?.Profile.Attacks.Where(a => a.Kind is CombatAttackKind.Melee or CombatAttackKind.Maneuver)
            .OrderByDescending(a => a.Kind == CombatAttackKind.Maneuver).ThenByDescending(a => a.Skill).FirstOrDefault()?.Key;
        _attackRoll = null;
        if (Actor is { } actor && (Target is null or { Dead: true } || Target.Id == actor.Id || Target.Side == actor.Side))
            _targetId = State.Participants.FirstOrDefault(p => p.Side != actor.Side && p.Id != actor.Id && !p.Dead)?.Id;
    }

    private async Task ResolveAsync()
    {
        if (Actor is not { } actor || Target is not { } target)
            return;

        var (bonus, penalty) = Split(_net);
        var outcome = CombatRules.Maneuver(State, new ManeuverSetup
        {
            AttackerId = actor.Id, DefenderId = target.Id, Type = _type, AttackSkill = Skill(actor), Reaction = _reaction,
            KeeperBonusDice = bonus, KeeperPenaltyDice = penalty, AttackRoll = _attackRoll, DefenseRoll = _defenseRoll,
        }, Dice);
        await ProposeAsync(outcome.Resolution);
        _attackRoll = _defenseRoll = null;
    }
}
