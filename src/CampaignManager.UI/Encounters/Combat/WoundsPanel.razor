@* Раны и лечение по схеме ширмы (стр. 119): первая помощь (умирающему — стабилизация), Медицина (умирающему — только после
   первой помощи), проверка ВЫН стабилизированного раз в час, недельное лечение серьёзной раны и отдых. Проверки ВЫН
   умирающих в конце раунда — плашкой над вкладками (CombatPanel). Правила — CombatRules (Core), раны — WoundRules, общий с
   листом; в v1 всё это жило в razor и правило участников мимо «Применить». Своей карточки не рисует. *@
<div class="flex flex-col gap-4" data-testid="wounds-panel">
    <section class="flex flex-col gap-3">
        <h3 class="font-semibold text-primary-900">Первая помощь и Медицина</h3>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <Field Label="Кто лечит">
                <ParticipantSelect Participants="State.Participants" Where="p => !p.Dead && !p.Unconscious" Label="Кто лечит" Value="ActorId" ValueChanged="SelectActor" />
            </Field>
            <Field Label="Кого">
                <ParticipantSelect Participants="State.Participants" Where="Wounded" Label="Пострадавший" Value="_patientId" ValueChanged="SelectPatient" />
            </Field>
        </div>
        @if (Actor is { } healer && Patient is { } patient)
        {
            <p class="cm-meta">
                @patient.Name: ПЗ @patient.HitPoints из @patient.MaxHitPoints@(WoundRules.StateText(EncounterParticipants.Wounds(patient)) is { } state ? $", {state}" : "")@(patient.MajorWound ? ", серьёзная рана" : "").
                Первая помощь @healer.Name — @healer.Profile.FirstAid%, Медицина — @healer.Profile.Medicine%.
            </p>
            <div class="flex flex-wrap items-start gap-4">
                <div class="flex flex-col gap-2">
                    <Field Label="Первая помощь" Group="true" Note="@(patient.Dying ? "умирающему — временная стабилизация" : "+1 ПЗ и в сознание")">
                        <RollInput Label="Первая помощь" Value="healer.Profile.FirstAid" Roll="_firstAidRoll" RollChanged="r => _firstAidRoll = r" />
                    </Field>
                    @if (CombatRules.FirstAidBlockReason(patient) is { } noFirstAid)
                    {
                        <p class="cm-meta">@noFirstAid</p>
                    }
                    <div><Button Small="true" Icon="fa-kit-medical" Disabled="@(CombatRules.FirstAidBlockReason(patient) is not null)" OnClick="FirstAidAsync" data-testid="first-aid">Первая помощь</Button></div>
                </div>
                <div class="flex flex-col gap-2">
                    <Field Label="Медицина" Group="true" Note="не меньше часа; не в тот же день — трудная">
                        <RollInput Label="Медицина" Value="healer.Profile.Medicine" Difficulty="@(_notSameDay ? Difficulty.Hard : Difficulty.Regular)" Roll="_medicineRoll" RollChanged="r => _medicineRoll = r" />
                    </Field>
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                        <label class="flex min-h-9 items-center gap-2"><input type="checkbox" class="cm-checkbox" checked="@_notSameDay" @onchange="e => _notSameDay = e.Value is true" /> Не в тот же день</label>
                        <span class="flex items-center gap-2">ПЗ 1d3 <DiceInput Count="1" Sides="3" Label="Лечение Медициной" Value="_heal" ValueChanged="v => _heal = v" /></span>
                    </div>
                    @if (CombatRules.MedicineBlockReason(patient) is { } noMedicine)
                    {
                        <p class="cm-meta">@noMedicine</p>
                    }
                    <div><Button Small="true" Icon="fa-stethoscope" Disabled="@(CombatRules.MedicineBlockReason(patient) is not null)" OnClick="MedicineAsync" data-testid="medicine">Медицина</Button></div>
                </div>
            </div>
        }
    </section>

    @if (Stabilized.Count > 0)
    {
        <section class="flex flex-col gap-2 border-t border-primary-200 pt-3">
            <h3 class="font-semibold text-primary-900">Стабилизированные: ВЫН в конце каждого часа</h3>
            <p class="cm-meta">Провал — временный ПЗ потерян, снова при смерти; успех — ждёт Медицину ещё час (стр. 119).</p>
            @foreach (var p in Stabilized)
            {
                <div class="flex flex-wrap items-center gap-2" @key="p.Id">
                    <span class="min-w-32 font-medium">@p.Name</span>
                    <RollInput Label="@($"ВЫН {p.Name}")" Value="p.Stats.Con" Roll="@_hourly.GetValueOrDefault(p.Id)" RollChanged="r => _hourly[p.Id] = r" />
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => HourlyAsync(p)">Проверка часа</Button>
                </div>
            }
        </section>
    }

    <section class="flex flex-col gap-3 border-t border-primary-200 pt-3">
        <h3 class="font-semibold text-primary-900">Выздоровление</h3>
        <Field Label="Кто">
            <ParticipantSelect Participants="State.Participants" Where="p => !p.Dead && !p.Dying && p.HitPoints < p.MaxHitPoints" Label="Кто выздоравливает" Value="_recoveryId" ValueChanged="v => _recoveryId = v" />
        </Field>
        @if (_recoveryId is { } rid && State.Find(rid) is { } r)
        {
            @if (r.MajorWound)
            {
                <p class="cm-meta">Серьёзная рана: проверка ВЫН в конце каждой недели — успех 1d3, чрезвычайный 2d3 и отметка снята (стр. 119).</p>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <label class="flex min-h-9 items-center gap-2"><input type="checkbox" class="cm-checkbox" checked="@_care" @onchange="e => _care = e.Value is true" /> Уход врача (проверка Медицины пройдена)</label>
                    <label class="flex min-h-9 items-center gap-2"><input type="checkbox" class="cm-checkbox" checked="@_rested" @onchange="e => _rested = e.Value is true" /> Отдых, покой</label>
                    <label class="flex min-h-9 items-center gap-2"><input type="checkbox" class="cm-checkbox" checked="@_poor" @onchange="e => _poor = e.Value is true" /> Плохие условия</label>
                </div>
                <div class="flex flex-wrap items-end gap-3">
                    <Field Label="@($"ВЫН {r.Stats.Con}")" Group="true">
                        <RollInput Label="Лечение раны" Value="r.Stats.Con" BonusDice="@WoundRules.RecoveryDice(_care, _rested, _poor).Bonus"
                                   PenaltyDice="@WoundRules.RecoveryDice(_care, _rested, _poor).Penalty" Roll="_recoveryRoll" RollChanged="x => _recoveryRoll = x" />
                    </Field>
                    <Field Label="Выпало на 1d3/2d3"><EnteredNumber Label="Лечение" Value="_recoveryHeal" ValueChanged="v => _recoveryHeal = v" /></Field>
                    <Button Small="true" Icon="fa-calendar-week" OnClick="() => WeekAsync(r)" class="mb-1">Неделя лечения</Button>
                </div>
            }
            else
            {
                <div class="flex flex-wrap items-end gap-3">
                    <Field Label="Дней отдыха" class="w-28" Note="1 ПЗ в день (стр. 119)">
                        <input type="number" inputmode="numeric" min="1" class="cm-input cm-input-sm" value="@_days" @onchange="e => _days = int.TryParse(e.Value?.ToString(), out var d) && d > 0 ? d : 1" />
                    </Field>
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-bed" OnClick="() => RestAsync(r)" class="mb-1">Отдых</Button>
                </div>
            }
        }
    </section>
</div>

@code {
    private Guid? _patientId;
    private Guid? _recoveryId;
    private D100Roll? _firstAidRoll, _medicineRoll, _recoveryRoll;
    private int? _heal, _recoveryHeal;
    private bool _notSameDay, _care, _rested, _poor;
    private int _days = 1;
    private readonly Dictionary<Guid, D100Roll?> _hourly = [];

    private EncounterParticipant? Patient => _patientId is { } id ? State.Find(id) : null;

    private List<EncounterParticipant> Stabilized => [.. State.Participants.Where(p => p is { Dying: true, Stabilized: true, Dead: false })];

    private static bool Wounded(EncounterParticipant p) => !p.Dead && (p.HitPoints < p.MaxHitPoints || p.Unconscious || p.Dying);

    protected override void Follow()
    {
        base.Follow();
        // Лечит тот, кто в сознании: у умирающего, чей ход, бинтовать некому — берём первого на ногах (лучшая Первая помощь).
        if (Actor is null or { Dead: true } or { Unconscious: true } or { Dying: true })
            ActorId = State.Participants.Where(p => !p.Dead && !p.Unconscious && !p.Dying)
                .OrderByDescending(p => p.Profile.FirstAid).FirstOrDefault()?.Id;
        if (Patient is null or { Dead: true })
            _patientId = State.Participants.Where(Wounded).OrderByDescending(p => p.Dying).FirstOrDefault()?.Id;
    }

    private void SelectPatient(Guid? id)
    {
        _patientId = id;
        _firstAidRoll = _medicineRoll = null;
    }

    private async Task FirstAidAsync()
    {
        if (ActorId is { } healer && _patientId is { } patient)
            await ProposeAsync(CombatRules.FirstAid(State, healer, patient, _firstAidRoll, Dice));
        _firstAidRoll = null;
    }

    private async Task MedicineAsync()
    {
        if (ActorId is { } doctor && _patientId is { } patient)
            await ProposeAsync(CombatRules.Medicine(State, doctor, patient, _medicineRoll, _notSameDay, _heal, Dice));
        _medicineRoll = null;
        _heal = null;
    }

    private async Task HourlyAsync(EncounterParticipant p)
    {
        await ProposeAsync(CombatRules.DyingCheck(State, p.Id, _hourly.GetValueOrDefault(p.Id), Dice));
        _hourly.Remove(p.Id);
    }

    private async Task WeekAsync(EncounterParticipant p)
    {
        await ProposeAsync(CombatRules.WeeklyRecovery(State, new RecoverySetup
        {
            ParticipantId = p.Id, MedicalCare = _care, Rested = _rested, PoorConditions = _poor, Roll = _recoveryRoll, HealRoll = _recoveryHeal,
        }, Dice));
        _recoveryRoll = null;
        _recoveryHeal = null;
    }

    private Task RestAsync(EncounterParticipant p) => ProposeAsync(CombatRules.NaturalRecovery(State, p.Id, _days));
}
