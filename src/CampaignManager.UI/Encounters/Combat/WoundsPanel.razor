@* Раны и лечение по схеме ширмы (стр. 119): первая помощь (умирающему — стабилизация), Медицина (умирающему — только после
   первой помощи), проверка ВЫН стабилизированного раз в час. Недельное лечение и отдых — действие между играми, не боя: оно
   в окне лечения листа (WoundRecoveryModal), здесь его нет (B26). Проверки ВЫН умирающих в конце раунда — плашкой над
   вкладками (CombatPanel). Правила — CombatRules (Core), раны — WoundRules, общий с
   листом; в v1 всё это жило в razor и правило участников мимо «Применить». Своей карточки не рисует. *@
<div class="flex flex-col gap-4" data-testid="wounds-panel">
    <section class="flex flex-col gap-3">
        <h3 class="cm-card-title">Первая помощь и Медицина</h3>
        <Field Label="Кто лечит">
            <ParticipantSelect Participants="State.Participants" Where="p => !p.Dead && !p.Unconscious" Label="Кто лечит" Value="ActorId" ValueChanged="PickHealer" />
        </Field>
        @* Раненые — кнопками с ПЗ: список, а не выпадающий выбор вслепую («— выберите —» при ранах на столе). *@
        <Field Label="Кого лечим" Group="true">
            @if (State.Participants.Where(Wounded).ToList() is { Count: > 0 } wounded)
            {
                @* Выбранный пациент — светлый сегмент с галочкой, а не тёмная плита: ниже «Оказать первую помощь» одна главная (B24). *@
                <Segmented TValue="Guid" Options="PatientOptions(wounded)"
                           Value="@(_patientId ?? Guid.Empty)" ValueChanged="v => SelectPatient(v)" Label="Кого лечим" data-testid="wounded-list" />
            }
            else
            {
                <p class="cm-meta">Раненых нет.</p>
            }
        </Field>
        @if (Actor is { } healer && Patient is { } patient)
        {
            <p class="cm-meta">
                @patient.Name: ПЗ @patient.HitPoints из @patient.MaxHitPoints@(WoundRules.StateText(EncounterParticipants.Wounds(patient)) is { } state ? $", {state}" : "")@(patient.MajorWound ? ", серьёзная рана" : "").
                Первая помощь @healer.Name — @healer.Profile.FirstAid%, Медицина — @healer.Profile.Medicine%.
            </p>
            <div class="flex flex-wrap items-start gap-4">
                <div class="flex flex-col gap-2">
                    <Field Label="Первая помощь" Group="true" Note="@(patient.Dying ? "умирающему — временная стабилизация" : "вернёт 1 ПЗ и сознание")">
                        <RollInput Label="Первая помощь" Value="healer.Profile.FirstAid" Roll="_firstAidRoll" RollChanged="r => _firstAidRoll = r" />
                    </Field>
                    @if (CombatRules.FirstAidBlockReason(patient) is { } noFirstAid)
                    {
                        <p class="cm-meta">@noFirstAid</p>
                    }
                    <div><Button Small="true" Icon="fa-kit-medical" Disabled="@(CombatRules.FirstAidBlockReason(patient) is not null)" OnClick="FirstAidAsync" data-testid="first-aid">Оказать первую помощь</Button></div>
                </div>
                <div class="flex flex-col gap-2">
                    <Field Label="Медицина" Group="true" Note="не меньше часа; не в тот же день — трудная">
                        <RollInput Label="Медицина" Value="healer.Profile.Medicine" Difficulty="@(_notSameDay ? Difficulty.Hard : Difficulty.Regular)" Roll="_medicineRoll" RollChanged="r => _medicineRoll = r" />
                    </Field>
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                        <label class="cm-tap-row"><input type="checkbox" class="cm-checkbox" checked="@_notSameDay" @onchange="e => _notSameDay = e.Value is true" /> Не в тот же день</label>
                        <span class="flex items-center gap-2">ПЗ 1d3 <DiceInput Count="1" Sides="3" Label="Лечение Медициной" Value="_heal" ValueChanged="v => _heal = v" /></span>
                    </div>
                    @if (CombatRules.MedicineBlockReason(patient) is { } noMedicine)
                    {
                        <p class="cm-meta">@noMedicine</p>
                    }
                    <div><Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-stethoscope" Disabled="@(CombatRules.MedicineBlockReason(patient) is not null)" OnClick="MedicineAsync" data-testid="medicine">Медицина</Button></div>
                </div>
            </div>
        }
    </section>

    @if (Stabilized.Count > 0)
    {
        <section class="flex flex-col gap-2 border-t border-primary-200 pt-3">
            <h3 class="cm-card-title">Стабилизированные: ВЫН в конце каждого часа</h3>
            <p class="cm-meta">Провал — временный ПЗ потерян, снова при смерти; успех — ждёт Медицину ещё час.</p>
            @foreach (var p in Stabilized)
            {
                <div class="flex flex-wrap items-center gap-2" @key="p.Id">
                    <span class="min-w-32 font-medium">@p.Name</span>
                    <RollInput Label="@($"ВЫН {p.Name}")" Value="p.Stats.Con" Roll="@_hourly.GetValueOrDefault(p.Id)" RollChanged="r => _hourly[p.Id] = r" />
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => HourlyAsync(p)">Проверка часа</Button>
                </div>
            }
        </section>
    }
</div>

@code {
    private Guid? _patientId;
    private D100Roll? _firstAidRoll, _medicineRoll;
    private int? _heal;
    private bool _notSameDay;
    private readonly Dictionary<Guid, D100Roll?> _hourly = [];

    private EncounterParticipant? Patient => _patientId is { } id ? State.Find(id) : null;

    private List<EncounterParticipant> Stabilized => [.. State.Participants.Where(p => p is { Dying: true, Stabilized: true, Dead: false })];

    private static IReadOnlyList<SegmentOption<Guid>> PatientOptions(IEnumerable<EncounterParticipant> wounded) =>
        [.. wounded.Select(w => new SegmentOption<Guid>(w.Id, $"{w.Name} · ПЗ {w.HitPoints}/{w.MaxHitPoints}{(w.Dying ? " · при смерти" : "")}"))];

    private static bool Wounded(EncounterParticipant p) => !p.Dead && (p.HitPoints < p.MaxHitPoints || p.Unconscious || p.Dying);

    protected override void Follow()
    {
        base.Follow();
        // Лечит тот, кто в сознании и умеет: ход переходит к твари без Первой помощи — берём лучшего на ногах (если Хранитель
        // не выбрал лекаря сам); у умирающего, чей ход, бинтовать некому.
        var unfit = Actor is null or { Dead: true } or { Unconscious: true } or { Dying: true };
        if (unfit || (_healerAuto && Actor is { Profile: { FirstAid: 0, Medicine: 0 } }))
        {
            _healerAuto = true;
            ActorId = State.Participants.Where(p => !p.Dead && !p.Unconscious && !p.Dying)
                .OrderByDescending(p => Math.Max(p.Profile.FirstAid, p.Profile.Medicine)).FirstOrDefault()?.Id;
        }
        if (Patient is null or { Dead: true })
            _patientId = State.Participants.Where(Wounded).OrderByDescending(p => p.Dying).FirstOrDefault()?.Id;
    }

    private bool _healerAuto = true;

    private void PickHealer(Guid? id)
    {
        _healerAuto = false;
        SelectActor(id);
    }

    private void SelectPatient(Guid id)
    {
        _patientId = id;
        _firstAidRoll = _medicineRoll = null;
    }

    private async Task FirstAidAsync()
    {
        if (ActorId is { } healer && _patientId is { } patient)
            await ProposeAsync(CombatRules.FirstAid(State, healer, patient, _firstAidRoll, Dice));
        _firstAidRoll = null;
    }

    private async Task MedicineAsync()
    {
        if (ActorId is { } doctor && _patientId is { } patient)
            await ProposeAsync(CombatRules.Medicine(State, doctor, patient, _medicineRoll, _notSameDay, _heal, Dice));
        _medicineRoll = null;
        _heal = null;
    }

    private async Task HourlyAsync(EncounterParticipant p)
    {
        await ProposeAsync(CombatRules.DyingCheck(State, p.Id, _hourly.GetValueOrDefault(p.Id), Dice));
        _hourly.Remove(p.Id);
    }
}
