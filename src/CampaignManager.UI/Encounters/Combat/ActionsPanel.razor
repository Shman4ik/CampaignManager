@* Необязательные правила сцены (инициатива, нокаут, Удача) переехали в «⋯» шапки (EncounterPage): это настройка сцены, а не действие.
   Прочие действия раунда: прицел, укрытие от огня (Уклонение, стр. 111), перезарядка, починка заклинившего оружия (стр. 113),
   бегство, огнестрел наготове (+50 к инициативе, стр. 110), Удача против обморока; броски инициативы (если правило включено). Правила — CombatRules; расстановочные переключатели пишутся сразу, остальное — через предпросмотр.
   Своей карточки не рисует. *@
<div class="flex flex-col gap-4" data-testid="actions-panel">
    <section class="flex flex-col gap-3">
        <Field Label="Кто">
            <ParticipantSelect Participants="State.Participants" Where="Alive" Label="Кто действует" Value="ActorId" ValueChanged="SelectActor" />
        </Field>
        @if (Actor is { } actor)
        {
            <div class="flex flex-wrap gap-2">
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-crosshairs" OnClick="() => ProposeAsync(CombatRules.Aim(State, actor.Id))">Прицелиться</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-person-running" OnClick="() => ProposeAsync(CombatRules.Flee(State, actor.Id))">Бежать из боя</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-gun"
                        OnClick="() => ApplyNowAsync(CombatRules.FirearmReady(State, actor.Id, !actor.Combat.FirearmReady))">
                    @(actor.Combat.FirearmReady ? "Убрать огнестрел" : "Огнестрел наготове")
                </Button>
                @if (actor.Combat.Prone)
                {
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-person" OnClick="() => StandAsync(actor)">Подняться</Button>
                }
                @if (actor.Combat.GrappledBy is not null)
                {
                    <span class="cm-meta self-center">Схвачен — «Вырваться» во вкладке «Манёвр».</span>
                }
                @if (State.Combat.LuckToStayConscious && actor.Luck is not null)
                {
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-clover" Disabled="@(CombatRules.StayConscious(State, actor.Id) is null)" OnClick="() => LuckAsync(actor)">
                        Удача: остаться в сознании (@CombatRules.LuckCostToStayConscious(actor.Combat.LuckSpentToStayConscious))
                    </Button>
                }
            </div>

            <div class="flex flex-wrap items-end gap-3 border-t border-primary-200 pt-3">
                <Field Label="@($"Укрыться от огня — Уклонение {actor.Stats.Dodge}")" Group="true" Note="успех — штрафная кость стрелкам, потеря атаки">
                    <RollInput Label="Уклонение" Value="actor.Stats.Dodge" Roll="_coverRoll" RollChanged="r => _coverRoll = r" />
                </Field>
                <Button Small="true" Icon="fa-shield-halved" OnClick="() => CoverAsync(actor)" class="mb-1">Укрыться</Button>
            </div>

            @if (actor.Profile.Attacks.Where(a => a.AmmoCapacity is not null).ToList() is { Count: > 0 } guns)
            {
                <div class="flex flex-wrap items-center gap-2 border-t border-primary-200 pt-3">
                    @foreach (var gun in guns)
                    {
                        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate" OnClick="() => ProposeAsync(CombatRules.Reload(State, actor.Id, gun.Key))">
                            Перезарядить @gun.Name (@CombatRules.AmmoLeft(actor, gun)/@gun.AmmoCapacity)
                        </Button>
                    }
                </div>
            }

            @if (actor.Combat.JammedAttack is { } jammed)
            {
                var jammedAttack = CombatRules.AttackOf(actor, jammed);
                var repairSkill = Math.Max(actor.Profile.MechanicalRepair, jammedAttack.Skill);
                <div class="flex flex-wrap items-end gap-3 border-t border-primary-200 pt-3">
                    <Field Label="@($"Починка: {jammedAttack.Name}, осталось {actor.Combat.JamRoundsLeft} р.")" Group="true" Note="Механика или Стрельба — лучшее">
                        <RollInput Label="Починка" Value="repairSkill" Roll="_repairRoll" RollChanged="r => _repairRoll = r" />
                    </Field>
                    <Button Small="true" Icon="fa-wrench" OnClick="() => RepairAsync(actor, repairSkill)" class="mb-1">Чинить</Button>
                </div>
            }
        }
    </section>

    <InitiativeBlock Divided="true" />
</div>

@code {
    private D100Roll? _coverRoll, _repairRoll;

    protected override void OnActorChanged()
    {
        _coverRoll = null;
        _repairRoll = null;
    }

    private async Task CoverAsync(EncounterParticipant actor)
    {
        await ProposeAsync(CombatRules.TakeCover(State, actor.Id, _coverRoll, Dice));
        _coverRoll = null;
    }

    private async Task RepairAsync(EncounterParticipant actor, int skill)
    {
        await ProposeAsync(CombatRules.RepairJam(State, actor.Id, skill, _repairRoll, Dice));
        _repairRoll = null;
    }

    private Task StandAsync(EncounterParticipant actor) => ApplyNowAsync(new EncounterResolution
    {
        Kind = EncounterLogKind.Action, ActorId = actor.Id, Title = $"{actor.Name} поднимается на ноги.",
        Effects = [new EncounterEffect { Kind = EncounterEffectKind.Prone, ParticipantId = actor.Id, Flag = false }],
    });

    private Task LuckAsync(EncounterParticipant actor) =>
        CombatRules.StayConscious(State, actor.Id) is { } resolution ? ProposeAsync(resolution) : Task.CompletedTask;
}
