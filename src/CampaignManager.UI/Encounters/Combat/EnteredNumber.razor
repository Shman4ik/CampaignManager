@inherits ComponentBase

@* Число с настоящих костей (урон, бонус к урону, потеря рассудка): пусто — бросит правило. Пара к RollInput для сумм
   произвольной формулы («1D10+2»), где DiceInput (NdM) не подходит. *@
<input type="number" inputmode="numeric" step="1" class="cm-input cm-input-sm w-24" placeholder="@Placeholder"
       aria-label="@Label" value="@(Value?.ToString(CultureInfo.InvariantCulture))" @onchange="SetAsync" />

@code {
    [Parameter] public int? Value { get; set; }

    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Выпало";

    [Parameter] public string Placeholder { get; set; } = "бросит";

    private Task SetAsync(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : null);
}
