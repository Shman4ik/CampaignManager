@using CampaignManager.Core.Dice
@using CampaignManager.Contracts.Catalogs
@using CampaignManager.UI.Catalogs
@using CampaignManager.UI.Characters
@using Microsoft.Extensions.DependencyInjection
@inject ToastService Toasts
@inject IServiceProvider Services
@* Атака: ближний бой или стрельба — по выбранному оружию участника (CombatProfile: оружие листа, атаки статблока, драка).
   Правила — CombatRules.Melee/Ranged (Core), кости — таблица AttackModifiers (её же читает ширма). Любой бросок можно
   вписать в «Броски со стола»; невписанное бросит правило. Результат — на предпросмотр, меняет участников только
   «Применить» (в v1 атака тратила патрон, ход и защиту цели ещё до него, F-C02). Своей карточки не рисует. *@
<div class="flex flex-col gap-3" data-testid="attack-panel">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <Field Label="Кто атакует">
            <ParticipantSelect Participants="State.Participants" Where="Alive" Label="Кто атакует" Value="ActorId" ValueChanged="SelectActor" Grouped="true" />
        </Field>
        <Field Label="Цель">
            <ParticipantSelect Participants="State.Participants" Where="p => p.Id != ActorId && !p.Dead" Label="Цель" Value="_targetId" ValueChanged="SelectTarget"
                               Grouped="true" Perspective="Actor" />
        </Field>
        <Field Label="Чем" class="sm:col-span-2">
            @* Сверху — оружие и атаки участника; ниже — его боевые навыки без оружия (выбор ведёт к оружию этого навыка из
               справочника: урон всегда из справочника); последним — «Подобрать оружие…» (всё оружие, импровизированное). *@
            <select @key="_selectVersion" class="cm-input" aria-label="Оружие или атака" data-testid="attack-weapon" @onchange="SelectAttack" disabled="@(Actor is null)">
                @foreach (var attack in Attacks)
                {
                    <option value="@attack.Key" selected="@(Attack?.Key == attack.Key)">@attack.Name — @attack.Skill%, урон @DiceText.Format(attack.Damage) (@KindText(attack))</option>
                }
                @if (SkillOptions.Count > 0)
                {
                    <optgroup label="Другое оружие — по навыку">
                        @foreach (var skill in SkillOptions)
                        {
                            <option value="@(SkillPrefix + skill.SkillId.ToString("N"))">@skill.Name — @skill.Value%</option>
                        }
                    </optgroup>
                }
                <option value="@PickAll">Подобрать оружие…</option>
            </select>
        </Field>
    </div>

    @if (Actor is { } actor && Attack is { } chosen)
    {
        @if (chosen.IsRanged)
        {
            <p class="cm-meta">
                @if (CombatRules.AmmoLeft(actor, chosen) is { } ammo)
                {
                    <span>патронов @ammo из @chosen.AmmoCapacity</span>
                }
                @if (chosen.Malfunction is { } malfunction)
                {
                    <span> · осечка @malfunction</span>
                }
                @if (chosen.BaseRangeMeters is { } range)
                {
                    <span> · дальность @range м (большая — @(range * 2), сверхдальняя — @(range * 4))</span>
                }
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(chosen.Description))
        {
            <p class="cm-meta">@chosen.Description</p>
        }
        @if ((CombatRules.AttackBlockReason(State, actor) ?? (chosen.IsRanged ? CombatRules.WeaponBlockReason(actor, chosen) : null)) is { } blocked)
        {
            <Alert Tone="Tone.Warning" Small="true" class="mb-0">@blocked</Alert>
        }
    }

    @if (Attack is { IsRanged: true })
    {
        <div class="flex flex-wrap gap-4">
            <Field Label="Дальность" Group="true" Note="Сложность, а не урезанный навык">
                <Segmented TValue="RangeBand" Options="Ranges" Value="_range" ValueChanged="v => _range = v" Label="Дальность" />
            </Field>
            <Field Label="Режим" Group="true">
                <Segmented TValue="FiringMode" Options="@(Attack.Automatic ? ModesAuto : Modes)" Value="_mode" ValueChanged="SetMode" Label="Режим" />
            </Field>
            <Field Label="Патронов" class="w-24">
                <input type="number" inputmode="numeric" min="1" class="cm-input" value="@_shots" @onchange="SetShots" />
            </Field>
        </div>
    }

    @if (Ready && AttackDiceNow() is { } diceNow && (diceNow.Reasons.Count > 0 || !string.IsNullOrEmpty(RequirementText)))
    {
        <p class="cm-meta" data-testid="attack-dice">Кости атаки: @string.Join(", ", diceNow.Reasons)@RequirementText</p>
    }

    @* Главная кнопка — над «Дополнительно»: раскрытое «Дополнительно» занимало 1100px, и кнопка самого частого действия боя
       уезжала на 480px прокрутки (B20). *@
    <div>
        <Button Icon="fa-hand-fist" Disabled="@(!Ready)" DisabledReason="@(Target is null ? "Выберите цель" : null)" OnClick="ResolveAsync" data-testid="attack-resolve">Провести атаку</Button>
    </div>

    @if (_picking)
{
    <CatalogPickerModal TItem="WeaponDto" Open="true" Title="@PickTitle" Load="LoadWeapons" Key="w => w.Id" Name="w => w.Name"
                        Meta="WeaponMeta" Also="WeaponAlso" Placeholder="Найти оружие…" Empty="Нет оружия этого навыка в справочнике."
                        ListClass="max-h-[min(22rem,calc(100dvh-28rem))]" SelectReason="Выберите оружие" Filter="InWeaponGroup"
                        ConfirmText="@(Actor is { } who && CombatProfiles.PickedWeaponGoesToSheet(who) ? "В лист и выбрать" : "Выбрать")"
                        Busy="_pickBusy" Error="@_pickError" OnPick="PickAsync" OnClose="ClosePicker">
        <ChildContent>
            @if (_pickSkillId is null)
            {
                <label class="cm-tap-row">
                    <input type="checkbox" class="cm-checkbox" checked="@_improvised" @onchange="e => _improvised = e.Value is true" />
                    <span>Импровизированное: похожее оружие из таблицы, бьют Дракой</span>
                </label>
            }
            <p class="cm-field-note">@PickWhere</p>
        </ChildContent>
        <FilterContent>
            @if (_pickSkillId is null)
            {
                <Segmented TValue="WeaponGroup" Options="WeaponGroups" Value="_weaponGroup" ValueChanged="v => _weaponGroup = v" Label="Тип оружия" />
            }
        </FilterContent>
    </CatalogPickerModal>
}

<details class="encounter-rolls" data-testid="attack-extra">
        <summary><i class="fa-solid fa-sliders mr-2" aria-hidden="true"></i>Дополнительно</summary>
        <div class="mt-2 flex flex-col gap-3">
    @if (Attack is { IsRanged: false })
    {
        <div class="flex flex-wrap gap-4">
            <Field Label="Цель защищается" Group="true">
                <Segmented TValue="DefenseReaction" Options="Reactions" Value="_reaction" ValueChanged="v => _reaction = v" Label="Цель защищается" />
            </Field>
            @SurprisePicker(includeAutoHit: true)
        </div>
    }
    else if (Attack is { IsRanged: true })
    {
        <div class="flex flex-wrap gap-4">
            @SurprisePicker(includeAutoHit: false)
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
            @Toggle("В упор", _pointBlank, v => _pointBlank = v)
            @Toggle("Целился", _aiming, v => _aiming = v)
            @Toggle("Цель укрылась", _takingCover, v => _takingCover = v)
            @Toggle("За преградой", _behindCover, v => _behindCover = v)
            @Toggle("Быстро движется", _fastMoving, v => _fastMoving = v)
            @Toggle("В гуще ближнего боя", _intoMelee, v => _intoMelee = v)
            @Toggle("Зарядил и выстрелил", _reloadAndFire, v => _reloadAndFire = v)
        </div>
    }

    <Field Label="Бонусные и штрафные кости" Group="true">
        <ExtraDicePicker Value="_net" ValueChanged="v => _net = v" />
    </Field>
    <div class="cm-field-row flex flex-wrap items-end gap-4">
        <Field Label="Броня преграды" class="w-28">
            <input type="number" inputmode="numeric" min="0" class="cm-input" value="@_coverArmor" @onchange="SetCoverArmor" />
        </Field>
        <div class="text-sm">@Toggle("Мимо брони (магия, яд)", _ignoresArmor, v => _ignoresArmor = v)</div>
    </div>

    <details class="encounter-rolls">
        <summary><i class="fa-solid fa-dice mr-2" aria-hidden="true"></i>Вписать броски с костей</summary>
        <div class="mt-2 flex flex-col gap-3">
            @if (Ready && AttackDiceNow() is { } d)
            {
                <Field Label="Атака" Group="true">
                    <RollInput Label="Атака" Value="@Skill" Difficulty="@AttackDifficulty" BonusDice="@d.BonusDice" PenaltyDice="@d.PenaltyDice"
                               Roll="_attackRoll" RollChanged="r => _attackRoll = r" />
                </Field>
                @if (Attack is { IsRanged: false } && _surprise == SurpriseMode.TargetReady && Target is { } t)
                {
                    <Field Label="@(_reaction == DefenseReaction.Dodge ? "Уклонение цели" : "Контратака цели")" Group="true">
                        <RollInput Label="Защита" Value="@(_reaction == DefenseReaction.Dodge ? t.Stats.Dodge : t.Profile.FightBack)" Roll="_defenseRoll" RollChanged="r => _defenseRoll = r" />
                    </Field>
                }
            }
            <div class="flex flex-wrap gap-3">
                <Field Label="Урон оружия"><EnteredNumber Label="Урон оружия" Value="_damage" ValueChanged="v => _damage = v" /></Field>
                <Field Label="Бонус к урону"><EnteredNumber Label="Бонус к урону" Value="_bonus" ValueChanged="v => _bonus = v" /></Field>
                <Field Label="Проникающая"><EnteredNumber Label="Проникающая" Value="_extra" ValueChanged="v => _extra = v" /></Field>
                @if (Attack is { IsRanged: true })
                {
                    <Field Label="Починка при осечке, 1d6"><EnteredNumber Label="Раунды починки" Value="_jamRounds" ValueChanged="v => _jamRounds = v" /></Field>
                }
            </div>
            @if (Target is { } target)
            {
                <Field Label="@($"ВЫН цели при серьёзной ране ({target.Stats.Con})")" Group="true">
                    <RollInput Label="ВЫН цели" Value="@target.Stats.Con" Roll="_conRoll" RollChanged="r => _conRoll = r" />
                </Field>
            }
            @if (Attack is { IsRanged: false } && _reaction == DefenseReaction.FightBack && Actor is { } a)
            {
                <div class="flex flex-wrap gap-3">
                    <Field Label="Урон контратаки"><EnteredNumber Label="Урон контратаки" Value="_counterDamage" ValueChanged="v => _counterDamage = v" /></Field>
                    <Field Label="Её бонус к урону"><EnteredNumber Label="Бонус контратаки" Value="_counterBonus" ValueChanged="v => _counterBonus = v" /></Field>
                </div>
                <Field Label="@($"ВЫН атакующего при серьёзной ране ({a.Stats.Con})")" Group="true">
                    <RollInput Label="ВЫН атакующего" Value="@a.Stats.Con" Roll="_counterConRoll" RollChanged="r => _counterConRoll = r" />
                </Field>
            }
        </div>
    </details>
        </div>
    </details>

</div>

@code {
    private string? _attackKey;
    private Guid? _targetId;
    private DefenseReaction _reaction;
    private SurpriseMode _surprise;
    private RangeBand _range;
    private FiringMode _mode;
    private int _shots = 1;
    private int _net;
    private int _coverArmor;
    private bool _ignoresArmor, _pointBlank, _aiming, _takingCover, _behindCover, _fastMoving, _intoMelee, _reloadAndFire;
    private D100Roll? _attackRoll, _defenseRoll, _conRoll, _counterConRoll;
    private int? _damage, _bonus, _extra, _jamRounds, _counterDamage, _counterBonus;

    private IReadOnlyList<CombatAttack> Attacks => Actor?.Profile.Attacks.Where(a => a.Kind is CombatAttackKind.Melee or CombatAttackKind.Ranged).ToList() ?? [];

    private CombatAttack? Attack => Actor is { } actor ? Attacks.FirstOrDefault(a => a.Key == _attackKey) ?? Attacks.FirstOrDefault() ?? CombatRules.Unarmed(actor) : null;

    private EncounterParticipant? Target => _targetId is { } id ? State.Find(id) : null;

    private int Skill => Attack?.Skill ?? 0;

    private bool Ready => Actor is not null && Target is not null && Attack is not null;

    private Difficulty AttackDifficulty => Attack is { IsRanged: true } && Ready
        ? CombatRules.DifficultyOf(CombatRules.RangedRequirement(State, RangedSetup()).Required)
        : Difficulty.Regular;

    private string RequirementText
    {
        get
        {
            if (Attack is not { IsRanged: true } || !Ready)
                return "";
            var (required, impossible) = CombatRules.RangedRequirement(State, RangedSetup());
            return impossible ? " · попадание невозможно" : required > SuccessLevel.Regular ? $" · нужен {RulesText.Of(required)}" : "";
        }
    }

    protected override void OnActorChanged()
    {
        _attackKey = null;
        _attackRoll = null;
        _shots = 1;
        _mode = FiringMode.Single;
        // Цель по умолчанию — первый живой противник (по стороне).
        if (Actor is { } actor && (Target is null or { Dead: true } || Target.Id == actor.Id || Target.Side == actor.Side))
            _targetId = State.Participants.FirstOrDefault(p => p.Side != actor.Side && p.Id != actor.Id && !p.Dead)?.Id;
    }

    private const string SkillPrefix = "skill:";
    private const string PickAll = "pick";
    private int _selectVersion;
    private bool _picking, _pickBusy, _improvised;
    private Guid? _pickSkillId;
    private string? _pickError;

    /// <summary>Боевые навыки участника без драки (она уже атака) — правило Core.</summary>
    private IReadOnlyList<CombatSkill> SkillOptions => Actor is { } actor ? CombatProfiles.CombatSkillsOf(actor.Profile, Session.Catalog) : [];

    private string PickTitle => _pickSkillId is { } id && Session.Catalog.Find(id) is { } skill ? $"Оружие: {skill.Name}" : "Подобрать оружие";

    private string PickWhere => Actor is { } actor && CombatProfiles.PickedWeaponGoesToSheet(actor)
        ? $"Оружие ляжет в лист {actor.Name} и останется после боя; убрать — в листе."
        : "Оружие будет только в этой сцене.";

    private static string WeaponMeta(WeaponDto w) => $"{CatalogText.Of(w.Type)} · {w.SkillName} · урон {DiceText.Format(w.Damage)}";

    private static IEnumerable<string?> WeaponAlso(WeaponDto w) => [w.SkillName, CatalogText.Of(w.Type)];

    /// <summary>Тип оружия для отбора в окне подбора: холодное, огнестрельное, тяжёлое и прочее.</summary>
    private enum WeaponGroup { Any, Melee, Firearm, Other }

    private static readonly IReadOnlyList<SegmentOption<WeaponGroup>> WeaponGroups =
    [
        new(WeaponGroup.Any, "Любое"), new(WeaponGroup.Melee, "Холодное"), new(WeaponGroup.Firearm, "Огнестрельное"), new(WeaponGroup.Other, "Тяжёлое и прочее"),
    ];

    private WeaponGroup _weaponGroup;

    private bool InWeaponGroup(WeaponDto w) => _weaponGroup switch
    {
        WeaponGroup.Melee => w.Type == WeaponType.Melee,
        WeaponGroup.Firearm => w.Type is WeaponType.Pistols or WeaponType.Rifles or WeaponType.Shotguns or WeaponType.AssaultRifles
            or WeaponType.SubmachineGuns or WeaponType.MachineGuns,
        WeaponGroup.Other => w.Type is WeaponType.ExplosivesAndHeavyWeapons or WeaponType.Other,
        _ => true,
    };

    private async Task<IReadOnlyList<WeaponDto>> LoadWeapons(CancellationToken cancellationToken)
    {
        var api = Services.GetRequiredService<ICatalogApi<WeaponDto>>();
        var list = await api.ListAsync(cancellationToken);
        return [.. list.Items.Where(w => _pickSkillId is not { } id || w.SkillId == id).OrderBy(w => w.Name, StringComparer.CurrentCulture)];
    }

    private void SelectAttack(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (value == PickAll || value?.StartsWith(SkillPrefix, StringComparison.Ordinal) == true)
        {
            // Выбор навыка или «Подобрать…» — не атака: открыть окно, список вернуть на текущее оружие.
            _pickSkillId = value == PickAll ? null : Guid.ParseExact(value![SkillPrefix.Length..], "N");
            _improvised = false;
            _weaponGroup = WeaponGroup.Any;
            _pickError = null;
            _picking = true;
            _selectVersion++;
            return;
        }

        _attackKey = value;
        _attackRoll = null;
        _mode = FiringMode.Single;
    }

    private void ClosePicker()
    {
        _picking = false;
        _selectVersion++;
    }

    /// <summary>
    /// Подобранное оружие: сыщику — в лист, в снаряжение (решение владельца 2026-10-03; «Отменить» в тосте убирает), НПС
    /// и твари — только в снимок сцены. Числа — из справочника; выбранное сразу стоит в «Чем».
    /// </summary>
    private async Task PickAsync(WeaponDto picked)
    {
        if (Actor is not { } actor)
            return;

        var weapon = SheetCopies.Weapon(WeaponCatalogs.Data(picked));
        if (_improvised && Session.Catalog.FindByCode(SkillCodes.Fighting + ".brawl") is { } brawl)
            weapon.SkillId = brawl.Id;

        var actorId = actor.Id;
        if (CombatProfiles.PickedWeaponGoesToSheet(actor))
        {
            _pickBusy = true;
            var error = await Session.EditSheetAsync(actorId, sheet => sheet.Weapons.Add(weapon));
            _pickBusy = false;
            if (error is not null)
            {
                _pickError = error;
                return;
            }

            Toasts.Undo($"В листе {actor.Name}: {weapon.Name}", async () =>
            {
                if (await Session.EditSheetAsync(actorId, sheet => sheet.Weapons.RemoveAll(w => w.RowId == weapon.RowId)) is { } undoError)
                    Toasts.Error(undoError);
            });
        }
        else
        {
            await Session.ChangeAsync(state =>
            {
                if (state.Find(actorId) is { } participant)
                    CombatProfiles.AddPicked(participant, weapon, Session.Catalog);
            });
        }

        _attackKey = weapon.RowId.ToString("N", System.Globalization.CultureInfo.InvariantCulture);
        _attackRoll = null;
        _mode = FiringMode.Single;
        ClosePicker();
    }

    private void SelectTarget(Guid? id)
    {
        _targetId = id;
        _defenseRoll = null;
        _conRoll = null;
    }

    private void SetMode(FiringMode mode)
    {
        _mode = mode;
        if (mode == FiringMode.Volley && Actor is { } actor)
            _shots = CombatRules.VolleySize(Skill);
        else
            _shots = 1;
    }

    private void SetShots(ChangeEventArgs e) => _shots = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : 1;

    private void SetCoverArmor(ChangeEventArgs e) => _coverArmor = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : 0;

    private AttackDice? AttackDiceNow() => Attack is { IsRanged: true } ? CombatRules.RangedDice(State, RangedSetup()) : CombatRules.MeleeDice(State, MeleeSetup());

    private MeleeAttackSetup MeleeSetup()
    {
        var (bonus, penalty) = Split(_net);
        return new MeleeAttackSetup
        {
            AttackerId = ActorId!.Value, DefenderId = _targetId!.Value, AttackKey = Attack?.Key, Reaction = _reaction, Surprise = _surprise,
            KeeperBonusDice = bonus, KeeperPenaltyDice = penalty, CoverArmor = _coverArmor, IgnoresArmor = _ignoresArmor,
            AttackRoll = _attackRoll, DefenseRoll = _defenseRoll, DamageRoll = _damage, DamageBonusRoll = _bonus, ExtraImpaleRoll = _extra,
            ConRoll = _conRoll, CounterDamageRoll = _counterDamage, CounterBonusRoll = _counterBonus, CounterConRoll = _counterConRoll,
        };
    }

    private RangedAttackSetup RangedSetup()
    {
        var (bonus, penalty) = Split(_net);
        return new RangedAttackSetup
        {
            AttackerId = ActorId!.Value, DefenderId = _targetId!.Value, AttackKey = Attack?.Key, Range = _range, Surprise = _surprise,
            KeeperBonusDice = bonus, KeeperPenaltyDice = penalty, PointBlank = _pointBlank, Aiming = _aiming, TargetTakingCover = _takingCover,
            TargetBehindCover = _behindCover, TargetFastMoving = _fastMoving, FiringIntoMelee = _intoMelee, ReloadAndFire = _reloadAndFire,
            FiringMode = _mode, ShotsFired = _shots, CoverArmor = _coverArmor, IgnoresArmor = _ignoresArmor,
            AttackRoll = _attackRoll, DamageRoll = _damage, DamageBonusRoll = _bonus, ExtraImpaleRoll = _extra, ConRoll = _conRoll, JamRounds = _jamRounds,
        };
    }

    private async Task ResolveAsync()
    {
        if (!Ready)
            return;

        var outcome = Attack is { IsRanged: true } ? CombatRules.Ranged(State, RangedSetup(), Dice) : CombatRules.Melee(State, MeleeSetup(), Dice);
        await ProposeAsync(outcome.Resolution);
        _attackRoll = _defenseRoll = _conRoll = _counterConRoll = null;
        _damage = _bonus = _extra = _jamRounds = _counterDamage = _counterBonus = null;
        _aiming = _takingCover = false;
    }

    private static string KindText(CombatAttack attack) => attack.Kind == CombatAttackKind.Ranged ? "стрельба" : "ближний бой";

    private static readonly IReadOnlyList<SegmentOption<RangeBand>> Ranges = [new(RangeBand.Base, "Базовая"), new(RangeBand.Long, "Большая"), new(RangeBand.Extreme, "Сверхдальняя")];
    private static readonly IReadOnlyList<SegmentOption<FiringMode>> Modes = [new(FiringMode.Single, "Выстрел"), new(FiringMode.PistolBurst, "Серия")];
    private static readonly IReadOnlyList<SegmentOption<FiringMode>> ModesAuto = [.. Modes, new(FiringMode.Volley, "Очередь")];
    private static readonly IReadOnlyList<SegmentOption<DefenseReaction>> Reactions = [new(DefenseReaction.Dodge, "Уклонение"), new(DefenseReaction.FightBack, "Контратака")];
    private static readonly IReadOnlyList<SegmentOption<SurpriseMode>> Surprises = [new(SurpriseMode.TargetReady, "Начеку"), new(SurpriseMode.BonusDie, "Врасплох")];
    private static readonly IReadOnlyList<SegmentOption<SurpriseMode>> SurprisesMelee = [.. Surprises, new(SurpriseMode.AutoHit, "Не защищается")];

    private RenderFragment SurprisePicker(bool includeAutoHit) =>
        @<Field Label="Цель готова" Group="true">
            <Segmented TValue="SurpriseMode" Options="@(includeAutoHit ? SurprisesMelee : Surprises)" Value="_surprise" ValueChanged="v => _surprise = v" Label="Цель готова" />
        </Field>;

    private RenderFragment Toggle(string label, bool value, Action<bool> set) =>
        @<label class="cm-tap-row">
            <input type="checkbox" class="cm-checkbox" checked="@value" @onchange="e => set(e.Value is true)" />
            <span>@label</span>
        </label>;
}
