@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Characters
@using CampaignManager.Contracts.Encounters
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Documents
@using CampaignManager.Core.Encounters
@using CampaignManager.Core.Encounters.Chase
@using CampaignManager.Core.Music
@using CampaignManager.UI.Platform
@implements IDisposable
@inject IEncountersApi Api
@inject ICampaignsApi Campaigns
@inject ICharactersApi Characters
@inject ICatalogApi<SkillDto> Skills
@inject ICatalogApi<CreatureDto> Creatures
@inject IScenariosApi Scenarios
@inject IRunsApi Runs
@inject BrowserStorage Storage
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject DialogService Dialogs
@inject IJSRuntime JS

@* Оболочка страницы сцены — одна на бой (/combat) и погоню (/chase), T2.6a. Начать или продолжить сцену, участники со
   снимком чисел, очередь, предпросмотр результата, эффект Хранителя, журнал; своё бой и погоня кладут в ChildContent
   (T2.6b/c) и получают EncounterSession каскадом. Открытая сцена — в адресе (?id=), состояние — в базе: перезагрузка
   вкладки посреди сцены возвращает всё, включая неприменённый результат и неписанные в лист эффекты (UI/Encounters/CLAUDE.md). *@
<PageHeader Title="@EncounterText.Of(Kind)" DocumentTitle="@DocumentTitle" Subtitle="@Subtitle" Game="true">
    <Actions>
        @* Одна кнопка настроения; сам плеер — слот «Плеер» шапки. Подпись — «Музыка боя», а не голое «Бой»: рядом с
           заголовком «Бой» кнопка читалась вторым заголовком. *@
        <MusicPoolButton Pool="@MusicPool.Of([MoodTag])" Label="@MoodTag" Text="@MoodButtonText" />
        @if (_scenarioLink is { } scenario)
        {
            @* Сцена идёт по прохождению сценария: назад в режим игры — одним касанием, не через «Сценарии → сценарий → партия». *@
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-scroll" Href="@scenario.Href" data-testid="to-scenario">К сценарию</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    @if (_loading)
    {
        <LoadingIndicator />
    }
    else if (_error is not null)
    {
        <Alert Tone="Tone.Error" ShowIcon="true">
            @_error
            <div class="mt-2"><Button Small="true" Variant="ButtonVariant.Secondary" OnClick="LoadAsync">Повторить</Button></div>
        </Alert>
    }
    else if (_session is null)
    {
        @Lobby()
    }
    else
    {
        @Scene(_session)
    }
</div>

@if (_session is not null)
{
    <ParticipantPicker Open="_pickerOpen" OnClose="() => _pickerOpen = false" Sources="_sources"
                       Context="@(new ParticipantPickerContext(_session.Encounter.CampaignId, _session.Catalog))"
                       UsedCharacterIds="UsedCharacterIds" OnPicked="AddParticipantsAsync"
                       RunId="_session.Encounter.RunId" OnRunChosen="SetRunAsync" />
}

@code {
    private EncounterSession? _session;
    private ElementReference _pendingRef;
    private EncounterResolution? _focusedPending;
    private IReadOnlyList<EncounterSummaryDto> _active = [];
    private IReadOnlyList<CampaignSummaryDto> _campaigns = [];
    private IReadOnlyList<IParticipantSource> _sources = [];
    private Guid? _startCampaign;
    private bool _loading = true;
    private bool _starting;
    private bool _applying;
    private bool _pickerOpen;
    private bool _effectOpen;
    private string? _error;
    private string? _notice;
    private (string Href, string Name)? _scenarioLink;
    private (uint Version, EncounterState State)? _draftChoice;
    private string _note = "";
    private Guid? _loadedFor;
    private CancellationTokenSource? _loop;
    private SkillCatalog? _catalog;

    [Parameter, EditorRequired] public EncounterKind Kind { get; set; }

    /// <summary>Открытая сцена (<c>?id=</c>) — переживает перезагрузку и даёт ссылку.</summary>
    [Parameter] public Guid? EncounterId { get; set; }

    /// <summary>Кампания (<c>?campaign=</c>): продолжить её сцену или начать в ней.</summary>
    [Parameter] public Guid? CampaignId { get; set; }

    /// <summary>
    /// Прохождение сценария (<c>?run=</c>, из режима игры): сцену в <see cref="CampaignId"/> начинают сразу с ним, а идущую
    /// без прохождения привязывают к нему.
    /// </summary>
    [Parameter] public Guid? RunId { get; set; }

    /// <summary>Панели правил боя и погоны (T2.6b/c) — получают <see cref="EncounterSession"/> каскадом.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Сцену начинает своя панель (погоня: трасса и проверка скорости, T2.6c) — оболочка не показывает «Начать» на
    /// расстановке. Дальше раунды общие: «Следующий» оболочки ведёт очередь, а погоня считает действия сама (ядро).
    /// </summary>
    [Parameter] public bool StartsItself { get; set; }

    /// <summary>Своё в строке участника (погоня: роль, локация, СКО, действия) — ChildContent строки.</summary>
    [Parameter] public RenderFragment<EncounterParticipant>? RowContent { get; set; }

    /// <summary>Своё в предпросмотре результата — решение Хранителя до «Применить» (погоня: обломки разрушенной преграды).</summary>
    [Parameter] public RenderFragment<EncounterResolution>? PendingContent { get; set; }

    /// <summary>
    /// Таких сцен в кампании может идти несколько (погоня: разделившихся ведут отдельными погонями, стр. 142, решение
    /// владельца 2026-10-02). Тогда <c>?campaign=</c> открывает сцену, только если она там одна, а у открытой сцены есть
    /// переключатель между идущими и «Новая …» — ещё одна в той же кампании. Бой — один на кампанию (индекс базы).
    /// </summary>
    [Parameter] public bool AllowsMany { get; set; }

    /// <summary>Показать список идущих сцен, а не открывать единственную (<c>?list=1</c>, пункт «Все сцены»).</summary>
    [Parameter] public bool ShowList { get; set; }

    /// <summary>
    /// Колонка действия липнет под шапкой, и в ней же результат («Применить» не уезжает за экран): бой. У погони колонка
    /// высокая (трасса, бегущие), липнет только результат.
    /// </summary>
    [Parameter] public bool StickyAction { get; set; } = true;

    private string Route => Kind == EncounterKind.Combat ? "combat" : "chase";

    private string MoodTag => Kind == EncounterKind.Combat ? "бой" : "погоня";

    private string DocumentTitle => _session?.Encounter.CampaignName is { } campaign ? $"{EncounterText.Of(Kind)} — {campaign}" : EncounterText.Of(Kind);

    /// <summary>Под заголовком: кампания и этап («Расстановка», «Раунд 2 · ходит Хелен»); статус сохранения — только если что-то не так.</summary>
    private string? Subtitle => _session is { } session
        ? string.Join(" · ", new[] { session.Encounter.CampaignName ?? "Вне кампании", session.State.Chase?.Name, StageText(session.State), SaveProblem(session) }.Where(t => !string.IsNullOrEmpty(t)))
        : null;

    private static string StageText(EncounterState state) => state.Chase is { Phase: ChasePhase.Ended } ? ChaseText.Of(ChasePhase.Ended)
        : state.Chase is { Phase: ChasePhase.SpeedCheck } ? ChaseText.Of(ChasePhase.SpeedCheck)
        : state.Round == 0 ? "Расстановка"
        : $"Раунд {state.Round}";

    private static string? SaveProblem(EncounterSession session) => session.SaveState switch
    {
        _ when session.SheetsBusy => "пишу в листы…",
        EncounterSaveState.Saved when session.State.SheetWrites.Count > 0 => $"в листы не дошло: {session.State.SheetWrites.Count}",
        EncounterSaveState.Conflict => "конфликт",
        EncounterSaveState.Failed or EncounterSaveState.Rejected => "не сохранено",
        _ => null,
    };

    private IReadOnlySet<Guid> UsedCharacterIds =>
        _session?.State.Participants.Select(p => p.SourceCharacterId).OfType<Guid>().ToHashSet() ?? [];

    protected override void OnInitialized() => _sources = ParticipantSources.Default(Characters, Creatures, Scenarios);

    protected override async Task OnParametersSetAsync()
    {
        // Смена адреса своей же навигацией (?id= после открытия) сцену не перечитывает.
        if (_session is not null && EncounterId == _session.Encounter.Id)
            return;
        if (_loadedFor is not null && _loadedFor == EncounterId && _session is null && !_loading)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        StopLoop();
        _loading = true;
        _error = null;
        _session = null;
        _loadedFor = EncounterId;
        try
        {
            if (EncounterId is { } id)
            {
                await OpenAsync(id);
                return;
            }

            _active = await Api.ListActiveAsync(Kind);
            // Несколько идущих (в кампании или всего) — выбор в «Идут сейчас», а не первая попавшаяся.
            IReadOnlyList<EncounterSummaryDto> candidates = CampaignId is { } campaignId ? [.. _active.Where(a => a.CampaignId == campaignId)] : _active;
            var match = candidates.Count == 1 && !ShowList ? candidates[0] : null;
            if (match is not null)
            {
                await OpenAsync(match.Id);
                if (RunId is { } attach && _session is { Encounter.RunId: null })
                    await SetRunAsync(attach);
                return;
            }

            if (CampaignId is { } runCampaign && RunId is not null && candidates.Count == 0)
            {
                // Из режима игры («Бой»/«Погоня» с ?run=), идущей сцены в кампании нет: сцена начинается сразу, с этим прохождением и его кампанией.
                if (await TryStartWithRunAsync(runCampaign))
                    return;
            }

            _campaigns = [.. (await Campaigns.GetCampaignsAsync()).Where(c => c.CanEdit)];
            _startCampaign = CampaignId ?? (_campaigns.Count == 1 ? _campaigns[0].Id : null);
        }
        catch (HttpRequestException error)
        {
            _error = ApiErrors.Describe(error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string RuleIcon(bool on) => on ? "fa-square-check" : "fa-square";

    private static string RuleState(bool on) => on ? "включена" : "выключена";

    private async Task SetRunAsync(Guid runId)
    {
        if (_session is null)
            return;
        await _session.SetRunAsync(runId);
        await LoadScenarioLinkAsync();
    }

    /// <summary>Ссылка «К сценарию»: сценарий и партия — из списка прохождений кампании сцены; нет прохождения — нет ссылки.</summary>
    private async Task LoadScenarioLinkAsync()
    {
        _scenarioLink = null;
        if (_session?.Encounter is not { RunId: { } runId, CampaignId: { } campaignId })
            return;
        try
        {
            if ((await Runs.ListForCampaignAsync(campaignId, runId)).FirstOrDefault(r => r.Id == runId) is { } run)
                _scenarioLink = (ScenarioLinks.Play(run.ScenarioId, runId: run.Id), run.ScenarioName);
        }
        catch (HttpRequestException)
        {
            // Ссылка — удобство: не нашлась, сцена от этого не страдает.
        }
    }

    private async Task OpenAsync(Guid encounterId)
    {
        EncounterDto encounter;
        try
        {
            encounter = await Api.GetAsync(encounterId);
        }
        catch (HttpRequestException error) when (error.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _notice = "Такой сцены нет или её ведёт другой Хранитель.";
            Navigation.NavigateTo(Route, replace: true);
            return;
        }

        if (encounter.Status != EncounterStatus.Active)
        {
            _notice = "Эта сцена уже завершена — начните новую.";
            Navigation.NavigateTo(Route, replace: true);
            return;
        }

        _catalog ??= SkillCatalogs.From((await Skills.ListAsync()).Items);
        if (AllowsMany)
            _active = await Api.ListActiveAsync(Kind);
        var session = new EncounterSession(Api, new EncounterSheetSync(Characters), Storage, Time);
        session.Start(encounter, _catalog);
        session.Changed += OnSessionChanged;
        _session = session;
        await RestoreDraftAsync(session);

        if (EncounterId != encounter.Id)
            Navigation.NavigateTo($"{Route}?id={encounter.Id}", replace: true);

        _loading = false;
        StateHasChanged();
        StartLoop();
        await LoadScenarioLinkAsync();
        await session.RefreshFromSheetsAsync();
        await session.TickAsync();
    }

    /// <summary>
    /// Черновик вкладки: совпадает с базой — стираем молча; начат на той же версии — просто не дошёл до базы, уходит
    /// сам; на старой — сцену с тех пор писала другая вкладка, спрашиваем (знание листа T2.3).
    /// </summary>
    private async Task RestoreDraftAsync(EncounterSession session)
    {
        if (await session.ReadDraftAsync(session.Encounter.Id) is not { } draft)
            return;

        if (CmJson.Serialize(draft.State) == CmJson.Serialize(session.State))
        {
            await session.DiscardDraftAsync(session.Encounter.Id);
            return;
        }

        if (draft.Version == session.Encounter.Version)
            session.Restore(draft.State);
        else
            _draftChoice = draft;
    }

    private async Task<bool> TryStartWithRunAsync(Guid campaignId)
    {
        try
        {
            var started = await Api.StartAsync(new StartEncounterRequest(Kind, campaignId, RunId));
            _loadedFor = started.Id;
            await OpenAsync(started.Id);
            return true;
        }
        catch (HttpRequestException error)
        {
            // Нельзя начать (не Хранитель кампании, чужое прохождение) — обычное «Начать» с причиной.
            _notice = ApiErrors.Describe(error);
            return false;
        }
    }

    private Task StartAsync() => StartInAsync(_startCampaign);

    private async Task StartInAsync(Guid? campaignId)
    {
        _starting = true;
        try
        {
            var started = await Api.StartAsync(new StartEncounterRequest(Kind, campaignId, campaignId == CampaignId ? RunId : null));
            Navigation.NavigateTo($"{Route}?id={started.Id}");
        }
        catch (HttpRequestException error)
        {
            Toasts.Error(ApiErrors.Describe(error));
            _active = await Api.ListActiveAsync(Kind);
        }
        finally
        {
            _starting = false;
        }
    }

    private Task Change(Action<EncounterState> change) => _session?.ChangeAsync(change) ?? Task.CompletedTask;

    private async Task AddParticipantsAsync(IReadOnlyList<EncounterParticipant> participants)
    {
        List<string> rejected = [];
        List<string> added = [];
        await Change(state =>
        {
            // Одной записью журнала на всю пачку: «Вступили: …», а не строка на каждого.
            foreach (var outcome in EncounterEngine.AddRange(state, participants, Now))
            {
                if (outcome.Rejection is { } reason)
                    rejected.Add(reason);
                else
                    added.Add(outcome.Participant!.Name);
            }
        });

        if (added.Count > 0)
            Toasts.Success($"{(added.Count > 1 ? "Добавлены" : "Добавлен")}: {string.Join(", ", added)}.");
        foreach (var reason in rejected)
            Toasts.Warning(reason);
    }

    /// <summary>Что скажет подтверждение «Убрать участника?» — без «нельзя отменить»: добавить можно снова.</summary>
    private string RemoveMessage(EncounterParticipant participant)
    {
        var writes = _session?.State.SheetWrites.Count(w => w.ParticipantId == participant.Id) ?? 0;
        return writes > 0
            ? $"Он покинет {Accusative}, добавить его можно снова. Не записанные в лист эффекты ({writes}) всё равно уйдут в лист."
            : $"Он покинет {Accusative}, добавить его можно снова. Лист и бестиарий не меняются.";
    }

    private Task RemoveAsync(EncounterParticipant participant) => Change(state => EncounterEngine.Remove(state, participant.Id, Now));

    private Task OpenSheetAsync(Guid sheetId) => JS.InvokeVoidAsync("open", $"character/{sheetId}", "_blank").AsTask();

    private Task ToggleOutAsync(EncounterParticipant participant) =>
        Change(state => EncounterEngine.Apply(state, new EncounterResolution
        {
            Kind = EncounterLogKind.Effect,
            Title = participant.IsOut ? $"{participant.Name} возвращается в очередь" : $"{participant.Name} выбывает из очереди",
            Effects = [new EncounterEffect { Kind = EncounterEffectKind.Out, ParticipantId = participant.Id, Flag = !participant.IsOut }],
        }, Now));

    private Task SetSideAsync(EncounterParticipant participant, EncounterSide side) =>
        Change(state => EncounterEngine.SetSide(state, participant.Id, side));

    private Task ProposeAsync(EncounterResolution resolution) => Change(state => EncounterEngine.Propose(state, resolution));

    private async Task ApplyAsync()
    {
        _applying = true;
        try
        {
            await Change(state => EncounterEngine.Apply(state, Now));
        }
        finally
        {
            _applying = false;
        }
    }

    private Task CancelAsync() => Change(EncounterEngine.Cancel);

    private Task NextAsync() => Change(state => EncounterQueue.Next(state, Now));

    private Task DelayAsync() => Change(state => EncounterQueue.Delay(state, null, Now));

    private async Task NoteAsync()
    {
        var text = _note;
        _note = "";
        await Change(state => EncounterEngine.Note(state, text, Now));
    }

    private Task SheetWriteAsync((Guid WriteId, bool Retry) decision) =>
        Change(state =>
        {
            if (decision.Retry)
                EncounterEngine.RetrySheetWrite(state, decision.WriteId);
            else
                EncounterEngine.DropSheetWrite(state, decision.WriteId, Now);
        });

    private async Task FinishAsync()
    {
        if (_session is not { } session)
            return;

        var pending = session.State.SheetWrites.Count;
        var message = pending > 0
            ? $"Не записано в листы: {pending}. После завершения эти эффекты в листы не попадут."
            : Kind == EncounterKind.Chase ? "Погоня закроется, журнал останется в базе. Новую можно начать сразу." : "Бой закроется, журнал останется в базе. Новый можно начать сразу.";
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest($"Завершить {FinishWord}?", message) { ConfirmText = $"Завершить {FinishWord}" }))
            return;

        await session.ChangeAsync(state => EncounterEngine.Log(state, new EncounterLogEntry { Kind = EncounterLogKind.Finished, Text = Finished, At = Now }));
        try
        {
            await Api.FinishAsync(session.Encounter.Id, session.Encounter.Version);
            await session.DiscardDraftAsync(session.Encounter.Id);
            StopLoop();
            _session = null;
            _notice = Finished;
            Navigation.NavigateTo(Route, replace: true);
        }
        catch (HttpRequestException error)
        {
            Toasts.Error(ApiErrors.Describe(error));
        }
    }

    private async Task ReloadAsync()
    {
        if (_session is { } session)
            await session.DiscardDraftAsync(session.Encounter.Id);
        _draftChoice = null;
        await LoadAsync();
    }

    private async Task OverwriteAsync()
    {
        if (_session is null)
            return;

        try
        {
            await _session.OverwriteAsync();
            Toasts.Success("Сцена этой вкладки записана поверх.");
        }
        catch (HttpRequestException error)
        {
            Toasts.Error(ApiErrors.Describe(error));
        }
    }

    private async Task RestoreChoiceAsync()
    {
        if (_session is null || _draftChoice is not { } draft)
            return;

        _draftChoice = null;
        _session.Restore(draft.State);
        await _session.ChangeAsync(_ => { });
    }

    private async Task DiscardChoiceAsync()
    {
        _draftChoice = null;
        if (_session is not null)
            await _session.DiscardDraftAsync(_session.Encounter.Id);
    }

    /// <summary>«Завершить бой» / «Завершить погоню» — винительный падеж, имена здесь не склоняются, только вид сцены.</summary>
    private string FinishWord => Kind == EncounterKind.Combat ? "бой" : "погоню";

    private static string StageLabel(int round, bool ended) => ended ? "окончена" : round == 0 ? "расстановка" : $"раунд {round}";

    private string NewWord => Kind == EncounterKind.Combat ? "Новый бой" : "Новая погоня";

    private string MoodButtonText => Kind == EncounterKind.Combat ? "Музыка боя" : "Музыка погони";

    private string StartWord => Kind == EncounterKind.Combat ? "Начать бой" : "Начать погоню";

    private DateTimeOffset Now => Time.GetUtcNow();

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void StartLoop()
    {
        _loop = new CancellationTokenSource();
        _ = RunLoopAsync(_loop.Token);
    }

    private void StopLoop()
    {
        _loop?.Cancel();
        _loop?.Dispose();
        _loop = null;
        if (_session is not null)
            _session.Changed -= OnSessionChanged;
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(EncounterSession.Interval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_session is { } session)
                    await InvokeAsync(session.TickAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose() => StopLoop();

    private RenderFragment Lobby() => __builder =>
    {
        @if (_notice is not null)
        {
            <Alert Tone="Tone.Info" OnClose="() => _notice = null">@_notice</Alert>
        }
        @* Лобби — маленькая форма: карточка по содержимому (max-w-xl), идущие сцены — рядом с lg, а не под ней.
           Во всю колонку селект и «Начать» занимали левую четверть пустой карточки. *@
        <div class="grid items-start gap-x-7 lg:grid-cols-[minmax(0,36rem)_minmax(0,1fr)]">
            <section class="cm-section max-w-xl">
                <div class="cm-section-header"><h2 class="cm-section-title">@NewWord</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body flex flex-wrap items-end gap-3">
                        <Field Label="Кампания" class="w-full sm:w-80">
                            <select class="cm-input" data-testid="start-campaign" value="@(_startCampaign?.ToString() ?? "")"
                                    @onchange="e => _startCampaign = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null">
                                <option value="">— вне кампании —</option>
                                @foreach (var campaign in _campaigns)
                                {
                                    <option value="@campaign.Id">@campaign.Name</option>
                                }
                            </select>
                        </Field>
                        <Button Icon="fa-play" Busy="_starting" OnClick="StartAsync" data-testid="start-encounter">@StartWord</Button>
                    </div>
                </div>
            </section>
            @if (_active.Count > 0)
            {
                <section class="cm-section max-w-2xl">
                    <div class="cm-section-header"><h2 class="cm-section-title">Идут сейчас</h2></div>
                    <div class="cm-card">
                        @foreach (var active in _active)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-primary-200 px-4 py-3 first:border-t-0">
                                <div>
                                    <div class="font-medium">@(active.CampaignName ?? "Вне кампании")</div>
                                    @if (active.ParticipantNames.Count > 0)
                                    {
                                        <div class="text-sm text-primary-700">@string.Join(", ", active.ParticipantNames)</div>
                                    }
                                    <div class="cm-meta">
                                        @(active.Round == 0 ? "расстановка" : $"раунд {active.Round}") · участников: @active.ParticipantCount ·
                                        @LocalTime.DateTime(active.UpdatedAt)
                                    </div>
                                </div>
                                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-arrow-right" Href="@($"{Route}?id={active.Id}")">Продолжить</Button>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    };

    private RenderFragment Scene(EncounterSession session) => __builder =>
    {
        var state = session.State;
        var active = state.Active;
        var queue = state.Round > 0 ? state.TurnOrder.Select(state.Find).OfType<EncounterParticipant>().Concat(state.Participants.Where(p => !state.TurnOrder.Contains(p.Id))).ToList()
                                    : EncounterQueue.Order(state).Select(state.Find).OfType<EncounterParticipant>().ToList();
        // Мёртвые — серыми строками в конце списка: действий у них нет, а место они не отнимают.
        var order = queue.Where(p => !p.Dead).Concat(queue.Where(p => p.Dead)).ToList();
        var pending = state.Pending;

        @if (session.SaveState == EncounterSaveState.Conflict)
        {
            <Alert Tone="Tone.Warning" ShowIcon="true">
                Сцену изменили в другой вкладке или на другом устройстве — правки отсюда не сохранены.
                <div class="mt-2 flex flex-wrap gap-2">
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="ReloadAsync">Перечитать</Button>
                    <Button Small="true" Variant="ButtonVariant.OutlineError" OnClick="OverwriteAsync">Записать мои поверх</Button>
                </div>
            </Alert>
        }
        else if (session.SaveState is EncounterSaveState.Failed or EncounterSaveState.Rejected && session.Error is not null)
        {
            <Alert Tone="@(session.SaveState == EncounterSaveState.Rejected ? Tone.Error : Tone.Warning)" Small="true">
                Сцена не сохранена: @session.Error @(session.SaveState == EncounterSaveState.Failed ? "Повторю сам." : "")
            </Alert>
        }
        @if (_draftChoice is not null)
        {
            <Alert Tone="Tone.Warning" ShowIcon="true">
                На этой вкладке есть несохранённые ходы, а сцену с тех пор записали в другом месте.
                <div class="mt-2 flex flex-wrap gap-2">
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="RestoreChoiceAsync">Восстановить мои</Button>
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="DiscardChoiceAsync">Отбросить</Button>
                </div>
            </Alert>
        }

        <section class="cm-section">
            <div class="cm-card">
                @* На телефоне «⋯» — справа от строки раунда, а не отдельной строкой под кнопками (#213, 390×844). *@
                <div class="cm-card-body grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 sm:flex sm:flex-wrap">
                    <div class="min-w-0 sm:flex-1" data-testid="round-status">
                        <div class="font-semibold">@(state.Round == 0 ? StageText(state) : $"Раунд {state.Round} · ходит {active?.Name ?? "—"}")</div>
                    </div>
                    <div class="cm-btn-row col-span-2">
                        @if (state.Chase is { Phase: ChasePhase.Ended })
                        {
                            <Button Icon="fa-flag-checkered" OnClick="FinishAsync" data-testid="finish-encounter">Завершить @FinishWord</Button>
                        }
                        else if (state.Round == 0)
                        {
                            @if (!StartsItself)
                            {
                                <Button Icon="fa-play" Disabled="@(state.Participants.Count == 0)" DisabledReason="Сначала добавьте участников"
                                        OnClick="NextAsync" data-testid="start-round">@StartWord</Button>
                            }
                        }
                        else
                        {
                            <Button Variant="ButtonVariant.Secondary" Icon="fa-hourglass-half" Disabled="@(active is null)" OnClick="DelayAsync">Отложить ход</Button>
                            <Button Icon="fa-forward-step" OnClick="NextAsync" data-testid="next-turn">Следующий ход</Button>
                        }
                    </div>
                    <div class="col-start-2 row-start-1">
                        @* «Завершить» — не рядом с «Следующим»: нажатие мимо закрывает сцену. Только в меню, под линейкой. *@
                        <RowMenu AriaLabel="Действия сцены">
                            <ChildContent>
                                @if (AllowsMany)
                                {
                                    <RowMenuItem Icon="fa-code-branch" OnClick="() => StartInAsync(session.Encounter.CampaignId)">Новая @FinishWord (разделились)</RowMenuItem>
                                }
                                @if (Kind == EncounterKind.Combat)
                                {
                                    @* Необязательные правила — настройка сцены, а не действие персонажа: живут здесь, а не во вкладке «Прочее». *@
                                    <RowMenuItem Icon="@RuleIcon(state.Combat.InitiativeRolls)" OnClick="() => Change(s => s.Combat.InitiativeRolls = !s.Combat.InitiativeRolls)">Инициатива броском ЛВК: @RuleState(state.Combat.InitiativeRolls)</RowMenuItem>
                                    <RowMenuItem Icon="@RuleIcon(state.Combat.CinematicKnockout)" OnClick="() => Change(s => s.Combat.CinematicKnockout = !s.Combat.CinematicKnockout)">Нокаут манёвром: @RuleState(state.Combat.CinematicKnockout)</RowMenuItem>
                                    <RowMenuItem Icon="@RuleIcon(state.Combat.LuckToStayConscious)" OnClick="() => Change(s => s.Combat.LuckToStayConscious = !s.Combat.LuckToStayConscious)">Удача против обморока: @RuleState(state.Combat.LuckToStayConscious)</RowMenuItem>
                                }
                                <RowMenuItem Icon="fa-list" OnClick="@(() => Navigation.NavigateTo($"{Route}?list=1"))">@(Kind == EncounterKind.Chase ? "Все погони" : "Все бои")</RowMenuItem>
                            </ChildContent>
                            <Danger>
                                <RowMenuItem Danger="true" Icon="fa-flag-checkered" OnClick="FinishAsync">Завершить @FinishWord</RowMenuItem>
                            </Danger>
                        </RowMenu>
                    </div>
                </div>
                @if (AllowsMany)
                {
                    @Siblings(session)
                }
            </div>
        </section>

        <div class="grid grid-cols-1 gap-4 lg:grid-cols-12 lg:items-start">
            <section class="cm-section lg:col-span-5">
                @* «Участник» — у списка, а не в шапке: в шапке настроение и плеер. Пустая сцена — только эта кнопка. *@
                @* «Добавить» — вторичная: главная кнопка на экране одна (действие); заголовок той же высоты, что «Действие» (B1, B2). *@
                <div class="cm-section-header encounter-head">
                    <h2 class="cm-section-title">Участники</h2>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-user-plus" class="ml-auto" OnClick="() => _pickerOpen = true" data-testid="add-participant">Добавить</Button>
                </div>
                @if (order.Count > 0)
                {
                    @* Сторона — точкой у имени; подпись цветов — здесь, наведения на iPad нет (B8). *@
                    <p class="encounter-legend" data-testid="side-legend">
                        @foreach (var side in order.Select(p => p.Side).Distinct().Order())
                        {
                            <span><i class="@Css.Join("fa-solid fa-circle text-[0.625rem]", SideDotClass(side))" aria-hidden="true"></i> @EncounterText.Of(side)</span>
                        }
                    </p>
                    <div class="cm-card">
                        @foreach (var participant in order)
                        {
                            <ParticipantRow @key="participant.Id" Participant="participant" Active="@(participant.Id == state.ActiveParticipantId)" Round="state.Round"
                                            HideOutBadge="@(state.Chase is not null && ChaseRules.StatusOf(state, participant.Id) != ChaseStatus.Running)"
                                            Writes="@state.SheetWrites.Where(w => w.ParticipantId == participant.Id).ToList()"
                                            OnSheetWrite="SheetWriteAsync">
                                <Actions>
                                    <RowMenu AriaLabel="@($"Действия: {Names.Plain(participant.Name)}")">
                                        <ChildContent>
                                            @if (!participant.Dead)
                                            {
                                                @foreach (var side in Enum.GetValues<EncounterSide>().Where(side => side != participant.Side))
                                                {
                                                    var target = side;
                                                    <RowMenuItem Icon="fa-people-arrows" OnClick="() => SetSideAsync(participant, target)">Сторона: @EncounterText.Of(side)</RowMenuItem>
                                                }
                                            }
                                            @if (!participant.Dead || participant.IsOut)
                                            {
                                                <RowMenuItem Icon="@(participant.IsOut ? "fa-rotate-left" : "fa-person-walking-arrow-right")" OnClick="() => ToggleOutAsync(participant)">
                                                    @(participant.IsOut ? "Вернуть в очередь" : "Выбыл из очереди")
                                                </RowMenuItem>
                                            }
                                            @if (participant.SourceCharacterId is { } sheetId)
                                            {
                                                <RowMenuItem Icon="fa-id-card" OnClick="() => OpenSheetAsync(sheetId)">Открыть лист</RowMenuItem>
                                            }
                                        </ChildContent>
                                        <Danger>
                                            <RowMenuItem Danger="true" Icon="fa-user-minus" OnClick="() => RemoveAsync(participant)"
                                                         ConfirmTitle="Убрать участника?" ConfirmMessage="@($"{Names.Plain(participant.Name)}: {RemoveMessage(participant)}")"
                                                         ConfirmText="@($"Убрать из {Genitive}")">Убрать из @Genitive</RowMenuItem>
                                        </Danger>
                                    </RowMenu>
                                </Actions>
                                <ChildContent>
                                    @if (RowContent is not null)
                                    {
                                        <CascadingValue Value="session" IsFixed="true">@RowContent(participant)</CascadingValue>
                                    }
                                </ChildContent>
                            </ParticipantRow>
                        }
                    </div>
                }
            </section>

            @if (order.Count > 0)
            {
                @* На узком экране действие (форма, ход погони, результат) — над списком участников (#213, 390×844). *@
                <div class="order-first flex flex-col gap-4 lg:order-none lg:col-span-7">
                    @if (StickyAction && !_effectOpen)
                    {
                        @* Колонка действия липнет под шапку: форма, результат и «Применить» всегда на виду. Пока есть
                           результат, форма и эффект спрятаны (hidden, не снесены — введённое остаётся): «Применить»
                           стоит там, где была кнопка действия, и страница не сдвигается. *@
                        <StickyPane data-testid="action-pane">
                            @if (pending is not null)
                            {
                                @PendingBlock(session, pending)
                            }
                            <div class="@(pending is not null ? "hidden" : "flex flex-col gap-4")">
                                <CascadingValue Value="session" IsFixed="true">@ChildContent</CascadingValue>
                                @EffectBlock(state)
                            </div>
                        </StickyPane>
                    }
                    else
                    {
                        @* Открытый «Эффект Хранителя» снимает липкость боя: у колонки нет своей прокрутки внутри страницы (#213). *@
                        @if (pending is not null)
                        {
                            @if (StickyAction)
                            {
                                <div data-testid="action-pane">@PendingBlock(session, pending)</div>
                            }
                            else
                            {
                                <StickyPane data-testid="action-pane">@PendingBlock(session, pending)</StickyPane>
                            }
                        }

                        <div class="@(pending is not null && StickyAction ? "hidden" : "flex flex-col gap-4")">
                            <CascadingValue Value="session" IsFixed="true">@ChildContent</CascadingValue>
                            @EffectBlock(state)
                        </div>
                    }
                </div>
            }
        </div>

        @if (state.Log.Count > 0)
        {
            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Журнал</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body flex flex-wrap items-end gap-2 border-b border-primary-200">
                        <Field Label="Заметка в журнал" class="min-w-48 flex-1">
                            <input class="cm-input" value="@_note" @oninput="e => _note = e.Value?.ToString() ?? string.Empty" placeholder="Что произошло" />
                        </Field>
                        <Button Variant="ButtonVariant.Secondary" Icon="fa-pen" Disabled="@string.IsNullOrWhiteSpace(_note)" DisabledReason="Впишите текст" OnClick="NoteAsync">Записать</Button>
                    </div>
                    <EncounterLog Entries="state.Log" />
                </div>
            </section>
        }
    };

    private RenderFragment PendingBlock(EncounterSession session, EncounterResolution pending) => __builder =>
    {
        <section class="cm-section focus:outline-hidden" data-testid="pending-block" tabindex="-1" @ref="_pendingRef">
            <div class="cm-section-header"><h2 class="cm-section-title">Результат</h2></div>
            <div class="cm-card"><div class="cm-card-body">
                <ResolutionPreview State="session.State" Resolution="pending" OnApply="ApplyAsync" OnCancel="CancelAsync" Busy="_applying">
                    @if (PendingContent is not null)
                    {
                        <CascadingValue Value="session" IsFixed="true">@PendingContent(pending)</CascadingValue>
                    }
                </ResolutionPreview>
            </div></div>
        </section>
    };

    /// <summary>Эффект Хранителя — свёрнут: раскрывается по касанию, чтобы не занимать колонку ради редкой правки.</summary>
    private RenderFragment EffectBlock(EncounterState state) => __builder =>
    {
        if (state.Chase is { Phase: ChasePhase.Ended })
            return;

        <section class="cm-section" data-testid="effect-section">
            @* Заголовок-переключатель: подпись не обрезается («Урон, лечение, рассудок…» читалась обрезанной, B9). *@
            <div class="cm-section-header encounter-head">
                <h2 class="cm-section-title">Эффект Хранителя</h2>
                <Button Variant="ButtonVariant.Secondary" Icon="@(_effectOpen ? "fa-chevron-up" : "fa-chevron-down")" class="ml-auto"
                        OnClick="() => _effectOpen = !_effectOpen" aria-expanded="@(_effectOpen ? "true" : "false")" data-testid="effect-toggle">@(_effectOpen ? "Свернуть" : "Открыть")</Button>
            </div>
            @if (!_effectOpen)
            {
                <p class="cm-meta -mt-1">Урон, лечение, рассудок, ПМ и МОЩ руками — по одной или нескольким целям.</p>
            }
            @if (_effectOpen)
            {
                <div class="cm-card"><div class="cm-card-body">
                    <EffectPanel State="state" OnPropose="ProposeAsync" />
                </div></div>
            }
        </section>
    };

    /// <summary>
    /// Новый результат — фокус на его блок: на узком экране «Применить» оказывалось на 300px выше видимой области (#213);
    /// видимый блок фокус не сдвигает.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var pending = _session?.State.Pending;
        if (pending is not null && !ReferenceEquals(pending, _focusedPending) && _pendingRef.Context is not null)
        {
            _focusedPending = pending;
            try
            {
                await _pendingRef.FocusAsync(preventScroll: false);
            }
            catch (InvalidOperationException)
            {
                // Блок ушёл из разметки до фокуса — ничего страшного.
            }
        }
        else if (pending is null)
        {
            _focusedPending = null;
        }
    }

    // Слово сцены на экране — «погоня» или «бой», не «сцена» (#213, образец владельца п. 1).
    private string Accusative => Kind == EncounterKind.Chase ? "погоню" : "бой";

    private string Genitive => Kind == EncounterKind.Chase ? "погони" : "боя";

    private string Finished => Kind == EncounterKind.Chase ? "Погоня завершена." : "Бой завершён.";

    private static string SideDotClass(EncounterSide side) => side switch
    {
        EncounterSide.Investigators => "text-success-600",
        EncounterSide.Enemies => "text-error-600",
        _ => "text-primary-400",
    };

    /// <summary>
    /// Идущие сцены этого вида (погони разделившихся): открытая отмечена, остальные — переход по <c>?id=</c>; «Новая …» —
    /// ещё одна в той же кампании. Список читается при открытии сцены (переход между ними перечитывает).
    /// </summary>
    private RenderFragment Siblings(EncounterSession session) => __builder =>
    {
        var current = session.Encounter;
        var all = _active.Where(a => a.CampaignId == current.CampaignId).ToList();
        var others = all.Where(a => a.Id != current.Id).ToList();
        if (others.Count == 0)
            return;

        // Вкладки погонь: у каждой номер и состав; открытая отмечена, остальные — ссылки по ?id=.
        <div class="cm-card-body flex flex-wrap items-center gap-2 border-t border-primary-200" data-testid="encounter-siblings">
            @for (var i = 0; i < all.Count; i++)
            {
                var number = i + 1;
                var item = all[i];
                @if (item.Id == current.Id)
                {
                    @* Открытая — не кнопка: переходить некуда. Вид кнопки — чтобы ряд читался одним переключателем. *@
                    <span class="cm-btn cm-btn-primary cursor-default" aria-current="true" data-testid="sibling-current">
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <span>Погоня @number: @SceneLabel(current.CampaignId, current.CampaignName, session.State.Chase?.Name, [.. session.State.Participants.Select(p => p.Name)]) · @StageLabel(session.State.Round, session.State.Chase is { Phase: ChasePhase.Ended })</span>
                    </span>
                }
                else
                {
                    <Button Variant="ButtonVariant.Secondary" Href="@($"{Route}?id={item.Id}")" data-testid="sibling">
                        Погоня @number: @SceneLabel(item.CampaignId, item.CampaignName, item.Name, item.ParticipantNames) · @StageLabel(item.Round, item.Ended)
                    </Button>
                }
            }
        </div>
    };

    /// <summary>Подпись сцены в переключателе: кто в ней (первые трое), кампания — если она не та, что у открытой.</summary>
    private string SceneLabel(Guid? campaignId, string? campaignName, string? name, IReadOnlyList<string> names)
    {
        var who = !string.IsNullOrWhiteSpace(name) ? name
            : names.Count == 0 ? "без участников" : string.Join(", ", names.Take(3)) + (names.Count > 3 ? $" и ещё {names.Count - 3}" : "");
        return campaignId == _session?.Encounter.CampaignId ? who : $"{campaignName ?? "Вне кампании"}: {who}";
    }

}
