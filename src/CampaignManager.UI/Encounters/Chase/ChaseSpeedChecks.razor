@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters
@using CampaignManager.Core.Encounters.Chase
@inject IDiceRoller Dice

@* Проверка скорости (стр. 130): ВЫН пешком, навык управления за рулём (½ ЛВК, если навыка нет; поломка — штрафная кость).
   Чрезвычайный успех — +1 СКО на всю погоню, провал — −1. Бросок вписывают или бросают; «Записать» сразу применяет
   результат правилом Core (эффект через Apply, запись в журнал); «Бросить за всех» бросает кости у тех, кому бросок не
   вписан, и записывает всех сразу. Пассажиры проверку не проходят (стр. 139). Посреди погони
   здесь те, кто присоединился или пересел (стр. 140–141). Своей карточки не рисует. *@
<div data-testid="chase-speed-checks">
    @if (Rows.Count(x => !x.Runner.SpeedChecked) > 1)
    {
        <div class="flex justify-end border-b border-primary-200 px-3 py-2">
            <Button Variant="ButtonVariant.Secondary" Icon="fa-dice" OnClick="RecordAllAsync" data-testid="speed-record-all">Бросить за всех</Button>
        </div>
    }
    @foreach (var (participant, runner) in Rows)
    {
        var skill = ChaseRules.SpeedSkill(participant, runner);
        @* Три колонки: кто, бросок или итог, кнопка. Итог — той же строкой, что имя (бейдж рядом, не в своей ячейке выше
           или ниже), всё по центру: строка 56px, у записанных и ждущих одной высоты, список не прыгает (H7). *@
        <div @key="participant.Id" class="@Css.Join("grid gap-x-3 gap-y-2 border-t border-primary-200 px-3 py-2 first:border-t-0 md:grid-cols-[minmax(10rem,1fr)_minmax(0,2fr)_9rem]",
                                                runner.SpeedChecked ? "items-center" : "items-end")">
            <div>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="font-semibold text-primary-900">@participant.Name</span>
                    @if (runner.SpeedChecked)
                    {
                        <Badge Tone="@(runner.SpeedModifier switch { > 0 => Tone.Success, < 0 => Tone.Warning, _ => Tone.Neutral })" Icon="fa-check">
                            @(runner.SpeedModifier switch { > 0 => "+1 к СКО", < 0 => "−1 к СКО", _ => "без поправки" })
                        </Badge>
                    }
                </div>
                <div class="cm-meta">
                    @ChaseText.Of(runner.Role) · СКО @ChaseRules.BaseMove(participant, runner)
                    @if (runner.SpeedChecked)
                    {
                        <span> → <b>@ChaseRules.Move(participant, runner)</b></span>
                    }
                </div>
            </div>
            @if (runner.SpeedChecked)
            {
                <div class="hidden md:block"></div>
                @if (!PendingOnly)
                {
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" OnClick="() => ReopenAsync(participant.Id)" data-testid="speed-reopen">Исправить</Button>
                }
            }
            else
            {
                @* Ячейка броска — высотой в две строки: бейдж уровня после «Бросить» переносится внутри неё, строка не растёт
                   и «Бросить» нижних строк не уезжает из-под пальца (#213). *@
                <Field Label="@($"{skill.Label} {skill.Value}")" Group="true" class="speed-cell">
                    <RollInput Value="skill.Value" PenaltyDice="skill.PenaltyDice" Label="@($"Скорость: {participant.Name}")"
                               Roll="RollOf(participant.Id)" RollChanged="r => _rolls[participant.Id] = r" />
                </Field>
                <Button Variant="ButtonVariant.Secondary" Icon="fa-check" OnClick="() => RecordAsync(participant.Id)" data-testid="speed-record">Записать</Button>
            }
        </div>
    }
</div>

@code {
    private readonly Dictionary<Guid, D100Roll?> _rolls = [];

    [CascadingParameter] public EncounterSession Session { get; set; } = null!;

    /// <summary>Только те, кому проверка ещё нужна (посреди погони); иначе — все, кроме пассажиров.</summary>
    [Parameter] public bool PendingOnly { get; set; }

    private List<(EncounterParticipant Participant, ChaseRunner Runner)> Rows =>
    [
        .. ChaseRules.InChase(Session.State)
            .Where(x => !x.Runner.IsPassenger && (!PendingOnly || !x.Runner.SpeedChecked)),
    ];

    private D100Roll? RollOf(Guid id) => _rolls.GetValueOrDefault(id);

    private Task ReopenAsync(Guid participantId) => Session.ChangeAsync(state => ChaseRules.ReopenSpeedCheck(state, participantId));

    /// <summary>Записать всем, у кого проверки ещё нет: вписанный бросок берётся как есть, остальным бросают кости.</summary>
    private async Task RecordAllAsync()
    {
        var pending = Rows.Where(x => !x.Runner.SpeedChecked).Select(x => x.Participant.Id).ToList();
        var rolls = pending.ToDictionary(id => id, id => RollOf(id)?.Result);
        foreach (var id in pending)
            _rolls.Remove(id);
        await Session.ChangeAsync(state =>
        {
            foreach (var id in pending)
                EncounterEngine.Apply(state, ChaseActions.SpeedCheck(state, id, rolls[id], Dice).Resolution, Session.Now);
        });
    }

    private async Task RecordAsync(Guid participantId)
    {
        var roll = RollOf(participantId)?.Result;
        _rolls.Remove(participantId);
        await Session.ChangeAsync(state => EncounterEngine.Apply(state, ChaseActions.SpeedCheck(state, participantId, roll, Dice).Resolution, Session.Now));
    }
}
