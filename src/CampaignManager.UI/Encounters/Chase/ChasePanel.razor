@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters
@using CampaignManager.Core.Encounters.Chase
@implements IDisposable
@inject ICharactersApi Characters
@inject IDiceRoller Dice

@* Погоня (T2.6c) в оболочке сцены: этап за этапом главы 7 — трасса и бегущие, проверка скорости, раунды (трасса, ход,
   бегущие, часть 5), конец. Состояние — EncounterState.Chase в документе сцены: перезагрузка вкладки посреди погони
   возвращает всё (автосохранение оболочки). Правила — Core (ChaseRules, ChaseActions), разметка их не считает.
   Получает EncounterSession каскадом; перерисовывается по её Changed (своих параметров у панели нет). *@
@if (Chase is null)
{
    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Трасса</h2></div>
        <div class="cm-card"><div class="cm-card-body flex flex-col gap-3">
            <p class="cm-meta">Локации — смысловые отрезки погони (стр. 131). Помехи и преграды ставятся в локацию, в которую входят.</p>
            @TrackControls("Создать трассу")
        </div></div>
    </section>
}
else
{
    var chase = Chase;
    @if (chase.Phase == ChasePhase.Ended)
    {
        <Alert Tone="Tone.Info" ShowIcon="true" Icon="fa-flag-checkered">
            <b>Погоня окончена.</b>
            @foreach (var (participant, runner) in Prey)
            {
                <span class="mr-3">@participant.Name — @Status(participant)</span>
            }
            <div class="mt-1 cm-meta">Итоги уже в листах (урон — через «Применить»). Сцену закрывает «Завершить» вверху.</div>
        </Alert>
    }

    <section class="cm-section">
        <div class="cm-section-header">
            <h2 class="cm-section-title">Трасса · @ChaseText.Of(chase.Phase)</h2>
        </div>
        <div class="cm-card"><div class="cm-card-body flex flex-col gap-3">
            <ChaseTrack State="Session.State" OnEdit="number => _editing = number" />
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 cm-meta">
                <span><i class="fa-solid fa-bolt text-warning-600" aria-hidden="true"></i> помеха</span>
                <span><i class="fa-solid fa-road-barrier text-accent-600" aria-hidden="true"></i> преграда</span>
                <span>Номер локации — изменить её.</span>
                @if (chase.Phase == ChasePhase.Active)
                {
                    <span>Самая медленная СКО: @chase.SlowestMove</span>
                }
            </div>
            @foreach (var (prey, pursuers) in ChaseRules.Contacts(Session.State))
            {
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-error-200 bg-error-50 px-3 py-2" @key="prey.Id">
                    <span>
                        <i class="fa-solid fa-hand-fist text-error-700" aria-hidden="true"></i>
                        <b>@prey.Name</b> настигнут (@string.Join(", ", pursuers.Select(p => p.Name))): можно драться и проводить манёвр — поимку объявляет Хранитель (стр. 135).
                    </span>
                    <Button Small="true" Variant="ButtonVariant.Error" Icon="fa-handcuffs" OnClick="() => CatchAsync(prey.Id, pursuers[0].Id)" data-testid="chase-catch">Пойман</Button>
                </div>
            }
            @if (chase.Phase == ChasePhase.Setup)
            {
                @TrackControls("Изменить трассу")
            }
            else if (chase.Phase == ChasePhase.Active)
            {
                <div class="flex flex-wrap gap-2">
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" Disabled="@(chase.LastLocation >= ChaseRules.MaxLocations)"
                            OnClick="() => Session.ChangeAsync(s => ChaseRules.Resize(s.Chase!, s.Chase!.LastLocation + 1))">Локация в конец</Button>
                </div>
            }
        </div></div>
    </section>

    @switch (chase.Phase)
    {
        case ChasePhase.Setup:
            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Бегущие</h2></div>
                <div class="cm-card">
                    @if (Session.State.Participants.Count == 0)
                    {
                        <p class="cm-text-muted px-3 py-3">Добавьте участников кнопкой «Участник».</p>
                    }
                    else
                    {
                        <ChaseRunners Skills="_skills" />
                    }
                    <div class="cm-card-footer flex flex-wrap items-center gap-2">
                        <Button Small="true" Icon="fa-gauge-high" Disabled="@(ChaseRules.SpeedChecksRejection(Session.State) is not null)"
                                OnClick="BeginSpeedChecksAsync" data-testid="chase-speed">Проверка скорости</Button>
                        @if (ChaseRules.SpeedChecksRejection(Session.State) is { } reason)
                        {
                            <span class="cm-meta">@reason</span>
                        }
                    </div>
                </div>
            </section>
            break;
        case ChasePhase.SpeedCheck:
            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Проверка скорости</h2></div>
                <div class="cm-card">
                    <p class="cm-meta px-3 pt-3">Убегающий быстрее самого быстрого преследователя сразу отрывается; преследователь медленнее самого медленного убегающего отстаёт (стр. 130, 145).</p>
                    <ChaseSpeedChecks />
                    @DexTies()
                    <div class="cm-card-footer flex flex-wrap items-center gap-2">
                        <Button Small="true" Icon="fa-flag" Disabled="@(ChaseRules.StartRejection(Session.State) is not null)" OnClick="StartAsync"
                                data-testid="chase-start">Начать погоню</Button>
                        <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => Session.ChangeAsync(ChaseRules.BackToSetup)">К трассе</Button>
                        @if (ChaseRules.StartRejection(Session.State) is { } notReady)
                        {
                            <span class="cm-meta">@notReady</span>
                        }
                    </div>
                </div>
            </section>
            break;
        case ChasePhase.Active:
            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Ход</h2></div>
                <div class="cm-card"><div class="cm-card-body">
                    <ChaseActionPanel Skills="_skills" />
                </div></div>
            </section>
            @if (ChaseRules.InChase(Session.State).Any(x => !x.Runner.SpeedChecked && !x.Runner.IsPassenger))
            {
                <section class="cm-section">
                    <div class="cm-section-header"><h2 class="cm-section-title">Присоединились: проверка скорости</h2></div>
                    <div class="cm-card"><ChaseSpeedChecks PendingOnly="true" /></div>
                </section>
            }
            @if (ChaseRules.DexTies(Session.State).Count > 0)
            {
                <section class="cm-section">
                    <div class="cm-card">@DexTies()</div>
                </section>
            }
            break;
    }

    @if (chase.Phase is ChasePhase.Active or ChasePhase.Ended)
    {
        <section class="cm-section">
            <div class="cm-section-header">
                <h2 class="cm-section-title">Бегущие</h2>
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="@(_runnersOpen ? "fa-chevron-up" : "fa-sliders")" OnClick="() => _runnersOpen = !_runnersOpen">
                    @(_runnersOpen ? "Свернуть" : "Настроить")
                </Button>
            </div>
            <div class="cm-card"><ChaseRunners Skills="_skills" Editable="_runnersOpen" /></div>
        </section>
    }

    @if (chase.Phase is ChasePhase.Active)
    {
        <section class="cm-section">
            <div class="cm-section-header"><h2 class="cm-section-title">Часть 5: необязательные правила</h2></div>
            <div class="cm-card"><div class="cm-card-body"><ChaseOptions /></div></div>
        </section>
    }

    <ChaseLocationEditor Location="@(_editing is { } n ? chase.Location(n) : null)" OnClose="() => _editing = null" OnSave="SaveLocationAsync" />
}

@code {
    private ChaseSkills _skills = null!;
    private int _length = 8;
    private int _gap = 2;
    private int? _editing;
    private bool _runnersOpen;
    private readonly Dictionary<(Guid, Guid), (D100Roll? A, D100Roll? B)> _ties = [];

    [CascadingParameter] public EncounterSession Session { get; set; } = null!;

    private ChaseState? Chase => Session.State.Chase;

    private IEnumerable<(EncounterParticipant Participant, ChaseRunner Runner)> Prey =>
        Session.State.Participants.Select(p => (p, Chase!.Runner(p.Id))).Where(x => x.Item2 is { Role: ChaseRole.Prey }).Select(x => (x.p, x.Item2!));

    protected override void OnInitialized()
    {
        _skills = new ChaseSkills(Characters);
        Session.Changed += OnChanged;
        if (Chase is { } chase)
        {
            _length = chase.LastLocation;
            _gap = chase.StartGap;
        }
    }

    protected override async Task OnInitializedAsync() => await _skills.LoadAsync(Session.State);

    private void OnChanged() => InvokeAsync(async () =>
    {
        await _skills.LoadAsync(Session.State);
        StateHasChanged();
    });

    public void Dispose() => Session.Changed -= OnChanged;

    private string Status(EncounterParticipant participant) =>
        ChaseRules.StatusOf(Session.State, participant.Id) is var status && status != ChaseStatus.Running
            ? ChaseText.Of(status)
            : participant.IsOut ? "выбыл" : "в погоне";

    private Task CreateTrackAsync() => Session.ChangeAsync(state =>
    {
        var fresh = state.Chase is null;
        ChaseRules.Begin(state, _length, _gap);
        EncounterEngine.Log(state, new EncounterLogEntry
        {
            Kind = EncounterLogKind.ChaseStart,
            Text = fresh
                ? $"Трасса: {ChaseText.Locations(state.Chase!.LastLocation)}, отрыв {state.Chase.StartGap}."
                : $"Трасса изменена: {ChaseText.Locations(state.Chase!.LastLocation)}, отрыв {state.Chase.StartGap}.",
            At = Session.Now,
        });
    });

    private Task BeginSpeedChecksAsync() => Session.ChangeAsync(state => ChaseRules.BeginSpeedChecks(state));

    private Task StartAsync() => Session.ChangeAsync(state => ChaseRules.Start(state, Session.Now));

    private Task CatchAsync(Guid preyId, Guid catcherId) => Session.ChangeAsync(state =>
    {
        if (ChaseRules.Catch(state, preyId, catcherId) is { } caught)
            EncounterEngine.Apply(state, caught, Session.Now);
    });

    private async Task SaveLocationAsync(ChaseLocation location)
    {
        _editing = null;
        await Session.ChangeAsync(state => ChaseRules.SetLocation(state.Chase!, location));
    }

    private RenderFragment TrackControls(string action) => __builder =>
    {
        <div class="flex flex-wrap items-end gap-2">
            <Field Label="Локаций" class="w-24">
                <input type="number" inputmode="numeric" min="@ChaseRules.MinLocations" max="@ChaseRules.MaxLocations" class="cm-input" value="@_length"
                       @onchange="e => _length = int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : _length" />
            </Field>
            <Field Label="Отрыв убегающих" Note="обычно 2, бывает 1 (стр. 131)" class="w-40">
                <select class="cm-input" value="@_gap" @onchange="SetGap">
                    <option value="2">2 локации</option>
                    <option value="1">1 локация</option>
                </select>
            </Field>
            <Button Small="true" Icon="fa-route" class="mb-1" OnClick="CreateTrackAsync" data-testid="chase-track-create">@action</Button>
        </div>
    };

    private RenderFragment DexTies() => __builder =>
    {
        foreach (var (first, second) in ChaseRules.DexTies(Session.State))
        {
            var key = (first.Id, second.Id);
            var rolls = _ties.GetValueOrDefault(key);
            <div class="flex flex-col gap-2 border-t border-primary-200 px-3 py-3" @key="key">
                <div><b>Равная ЛВК (@first.Stats.Dex):</b> @first.Name и @second.Name — встречная проверка ЛВК, победитель ходит первым (стр. 132).</div>
                <div class="flex flex-wrap items-end gap-3">
                    <Field Label="@first.Name" Group="true">
                        <RollInput Value="first.Stats.Dex" Label="@($"ЛВК: {first.Name}")" Roll="rolls.A" RollChanged="r => _ties[key] = (r, _ties.GetValueOrDefault(key).B)" />
                    </Field>
                    <Field Label="@second.Name" Group="true">
                        <RollInput Value="second.Stats.Dex" Label="@($"ЛВК: {second.Name}")" Roll="rolls.B" RollChanged="r => _ties[key] = (_ties.GetValueOrDefault(key).A, r)" />
                    </Field>
                    <Button Small="true" Icon="fa-scale-balanced" class="mb-1" OnClick="() => ResolveTieAsync(first.Id, second.Id)">Решить</Button>
                </div>
            </div>
        }
    };

    private void SetGap(ChangeEventArgs e) => _gap = e.Value?.ToString() == "1" ? 1 : 2;

    private async Task ResolveTieAsync(Guid first, Guid second)
    {
        var rolls = _ties.GetValueOrDefault((first, second));
        _ties.Remove((first, second));
        await Session.ChangeAsync(state => ChaseRules.ResolveDexTie(state, first, second, rolls.A?.Result, rolls.B?.Result, Dice, Session.Now));
    }
}
