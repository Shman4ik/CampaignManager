@using CampaignManager.Core
@using CampaignManager.Core.Dice
@using CampaignManager.Core.Encounters.Chase
@using CampaignManager.Core.KeeperScreen

@* Правка локации трассы: название, помеха или преграда. Помеха — сложность и урон при провале (таблица III, стр. 122 —
   одна копия в Core/KeeperScreen), преграда — сложность и ПЗ (примеры книги, стр. 136; 0 — сломать нельзя). Помеха и
   преграда лежат в той локации, в которую входят. Правка уходит странице целиком — новый экземпляр локации. *@
<Modal Open="Location is not null" Title="@($"Изменить локацию {Location?.Number}")" OnClose="OnClose">
    <ChildContent>
        @if (_draft is not null)
        {
            <div class="flex flex-col gap-3">
                <Field Label="Название локации">
                    <input class="cm-input" placeholder="Рынок" value="@_draft.Name" @onchange="e => _draft.Name = Text(e)" />
                </Field>
                @* Выбор — Segmented, а не тёмная кнопка: главная в окне одна — «Сохранить». *@
                <Field Label="Что мешает войти" Group="true">
                    <Segmented TValue="int" Options="KindOptions" Value="_kind" ValueChanged="k => _kind = k" Label="Что мешает войти" />
                </Field>
                @if (_kind == 1)
                {
                    <Field Label="Название помехи">
                        <input class="cm-input" value="@_hazard.Name" @onchange="SetHazardName" />
                    </Field>
                    <Field Label="Сложность" Group="true">
                        <DifficultyPicker Value="_hazard.Difficulty" ValueChanged="d => _hazard.Difficulty = d" />
                    </Field>
                    <Field Label="Урон при провале">
                        <select class="cm-input" value="@(_hazard.Damage ?? "")" @onchange="e => _hazard.Damage = Text(e)">
                            <option value="">— без урона —</option>
                            @foreach (var tier in OtherDamageReference.Tiers)
                            {
                                <option value="@tier.Formula">@tier.Name — @DiceText.Format(tier.Formula)</option>
                            }
                        </select>
                    </Field>
                }
                else if (_kind == 2)
                {
                    <Field Label="Название преграды">
                        <input class="cm-input" value="@_barrier.Name" @onchange="SetBarrierName" />
                    </Field>
                    <Field Label="Сложность" Group="true">
                        <DifficultyPicker Value="_barrier.Difficulty" ValueChanged="d => _barrier.Difficulty = d" />
                    </Field>
                    <div class="flex flex-wrap items-end gap-2">
                        <Field Label="ПЗ" Note="0 — не сломать" class="w-32">
                            <input type="number" inputmode="numeric" min="0" class="cm-input" value="@_barrier.HitPoints"
                                   @onchange="e => _barrier.HitPoints = Number(e)" />
                        </Field>
                        <Field Label="Пример" class="w-full sm:w-72">
                            <select class="cm-input" value="" @onchange="SelectPreset">
                                <option value="">— выберите —</option>
                                @foreach (var preset in VehicleReference.Barriers)
                                {
                                    <option value="@preset.HitPoints">@preset.Name — @preset.HitPoints ПЗ</option>
                                }
                            </select>
                        </Field>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="OnClose">Отмена</Button>
        <Button Icon="fa-check" OnClick="SaveAsync" data-testid="location-save">Сохранить</Button>
    </Footer>
</Modal>

@code {
    private static readonly IReadOnlyList<SegmentOption<int>> KindOptions =
        [new(0, "Свободно"), new(1, "Помеха"), new(2, "Преграда")];

    private ChaseLocation? _draft;
    private ChaseHazard _hazard = new();
    private ChaseBarrier _barrier = new();
    private int _kind;
    private int? _for;

    /// <summary>Какую локацию правим; null — окно закрыто.</summary>
    [Parameter] public ChaseLocation? Location { get; set; }

    [Parameter] public EventCallback<ChaseLocation> OnSave { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        if (Location is null)
        {
            _for = null;
            _draft = null;
            return;
        }

        if (_for == Location.Number && _draft is not null)
            return;

        _for = Location.Number;
        _draft = Location with { Hazard = null, Barrier = null };
        _hazard = Location.Hazard is { } hazard ? hazard with { } : new ChaseHazard();
        _barrier = Location.Barrier is { } barrier ? barrier with { } : new ChaseBarrier();
        _kind = Location.Barrier is not null ? 2 : Location.Hazard is not null ? 1 : 0;
    }

    private async Task SaveAsync()
    {
        if (_draft is null)
            return;

        var saved = _draft with
        {
            Hazard = _kind == 1 ? _hazard with { } : null,
            Barrier = _kind == 2 ? _barrier with { HitPointsLeft = Location?.Barrier is { } old && old.HitPoints == _barrier.HitPoints ? old.HitPointsLeft : _barrier.HitPoints } : null,
        };
        await OnSave.InvokeAsync(saved);
    }

    private void SelectPreset(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var hp))
        {
            _barrier.HitPoints = hp;
            var preset = VehicleReference.Barriers.FirstOrDefault(b => b.HitPoints == hp);
            if (preset is not null && (string.IsNullOrWhiteSpace(_barrier.Name) || _barrier.Name == "Преграда"))
                _barrier.Name = preset.Name;
        }
    }

    private void SetHazardName(ChangeEventArgs e) => _hazard.Name = Text(e) ?? "Помеха";

    private void SetBarrierName(ChangeEventArgs e) => _barrier.Name = Text(e) ?? "Преграда";

    private static string? Text(ChangeEventArgs e) => string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim();

    private static int Number(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? Math.Max(0, value) : 0;
}
