@using CampaignManager.Core.Encounters

@* Строка участника — одна на бой и погоню (в v1 CombatantCard и ChaseParticipantCard повторяли шапку, удаление, полосы
   и бейджи). Всегда внутри карточки «Участники»: своей карточки не рисует, только линейку сверху и полосу-акцент у того,
   чей ход. Полосы — StatBar с цифрами; состояние — бейджами с подписью (смысл не держится на title, наведения нет).
   Действия строки — кнопки с подписью, переносятся рядом. Своё бой и погоня кладут в ChildContent (оружие, локация). *@
<div class="@Css.Join("encounter-row", Active ? "encounter-row-active" : null, Participant.IsOut || Participant.Dead ? "encounter-row-out" : null)"
     data-testid="participant-row" aria-current="@(Active ? "step" : null)">
    @* Одна строка: имя и сторона, ПЗ, меню «⋯». Остальное (ПМ, Рассудок, числа) — по касанию имени, редкое действие — в меню. *@
    <div class="flex items-center gap-2">
        <button type="button" class="encounter-row-name" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open">
            @if (Active)
            {
                <i class="fa-solid fa-play text-xs text-accent-700" aria-hidden="true"></i>
                <span class="sr-only">Ходит:</span>
            }
            <span class="truncate font-semibold text-primary-900" data-testid="participant-name">@Participant.Name</span>
            <Badge Tone="@SideTone">@EncounterText.Of(Participant.Side)</Badge>
            <i class="@Css.Join("fa-solid text-xs text-primary-500", _open ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
        </button>
        <div class="ml-auto w-36 shrink-0">
            <StatBar Label="ПЗ" Value="Participant.HitPoints" Max="Participant.MaxHitPoints" Kind="StatKind.HitPoints" TestId="stat-hp" />
        </div>
        @if (Actions is not null)
        {
            <div class="flex shrink-0 items-center gap-1">@Actions</div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Participant.Note))
    {
        <p class="cm-meta">@Participant.Note</p>
    }

    @if (HasState)
    {
        <div class="mt-1 flex flex-wrap gap-1">
            @if (Participant.Dead)
            {
                <Badge Tone="Tone.Error" Solid="true" Icon="fa-cross">мёртв</Badge>
            }
            else if (Participant.Dying)
            {
                <Badge Tone="Tone.Error" Solid="true" Icon="fa-heart-crack">@(Participant.Stabilized ? "при смерти, стабилизирован" : "при смерти")</Badge>
            }
            else if (Participant.Unconscious)
            {
                <Badge Tone="Tone.Error" Icon="fa-bed">без сознания</Badge>
            }
            @if (Participant.MajorWound)
            {
                <Badge Tone="Tone.Warning" Icon="fa-droplet">серьёзная рана</Badge>
            }
            @* Состояние боя (T2.6b) — словами: прицел, укрытие, захват, заклинившее оружие, сотворение. *@
            @foreach (var (tone, icon, text) in CombatBadges)
            {
                <Badge Tone="tone" Icon="@icon">@text</Badge>
            }
            @if (Participant.IsOut)
            {
                <Badge Tone="Tone.Neutral" Icon="fa-person-walking-arrow-right">выбыл</Badge>
            }
            @foreach (var write in Writes)
            {
                <Badge Tone="@(write.Blocked ? Tone.Error : Tone.Warning)" Icon="fa-file-pen">
                    @(write.Error is null ? "пишется в лист" : "не записано в лист")
                </Badge>
            }
        </div>
    }

    @if (_open)
    {
        <div class="encounter-stats mt-2">
            <div class="encounter-stats-grid">
                @if (Participant.MaxMagicPoints > 0)
                {
                    <StatBar Label="ПМ" Value="Participant.MagicPoints" Max="Participant.MaxMagicPoints" Kind="StatKind.MagicPoints" TestId="stat-mp" />
                }
                @if (Participant.Sanity is { } sanity)
                {
                    <StatBar Label="Рассудок" Value="sanity" Max="@(Participant.MaxSanity ?? 99)" Kind="StatKind.Sanity" TestId="stat-san" />
                }
            </div>
            <p class="cm-meta mt-1">
                @EncounterText.Of(Participant.Kind), инициатива @Participant.Initiative ·
                СИЛ @Participant.Stats.Str · ЛВК @Participant.Stats.Dex · МОЩ @Participant.Stats.Pow ·
                бонус к урону <DiceText Value="@Participant.Stats.DamageBonus" /> · Комплекция @Participant.Stats.Build@(Participant.Luck is { } luck ? $" · Удача {luck}" : "")@(Participant.Stats.Armor > 0 ? $" · Броня {Participant.Stats.Armor}" : "")
            </p>
        </div>
    }

    @foreach (var write in Writes.Where(w => w.Error is not null))
    {
        <Alert Tone="@(write.Blocked ? Tone.Error : Tone.Warning)" Small="true" class="mt-2 mb-0">
            «@write.Title» не записано в лист: @write.Error
            @if (OnSheetWrite.HasDelegate)
            {
                <div class="mt-2 flex flex-wrap gap-2">
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate" OnClick="() => OnSheetWrite.InvokeAsync((write.Id, true))">Повторить</Button>
                    <Button Small="true" Variant="ButtonVariant.OutlineError" OnClick="() => OnSheetWrite.InvokeAsync((write.Id, false))">Не записывать</Button>
                </div>
            }
        </Alert>
    }

    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public EncounterParticipant Participant { get; set; } = null!;

    [Parameter] public bool Active { get; set; }

    /// <summary>Записи этого участника в лист, которые ещё не дошли.</summary>
    [Parameter] public IReadOnlyList<SheetWrite> Writes { get; set; } = [];

    /// <summary>Решение по застрявшей записи в лист: (id записи, true — повторить, false — не записывать).</summary>
    [Parameter] public EventCallback<(Guid WriteId, bool Retry)> OnSheetWrite { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Раунд сцены — для отметок одного раунда (укрытие).</summary>
    [Parameter] public int Round { get; set; }

    private bool _open;

    private bool HasState =>
        Participant.Dead || Participant.Dying || Participant.Unconscious || Participant.MajorWound || Participant.IsOut
        || Writes.Count > 0 || CombatBadges.Any();

    /// <summary>Отметки боя участника (T2.6b).</summary>
    private IEnumerable<(Tone Tone, string Icon, string Text)> CombatBadges
    {
        get
        {
            var c = Participant.Combat;
            if (c.Prone)
                yield return (Tone.Warning, "fa-person-falling", "лежит");
            if (c.GrappledBy is not null)
                yield return (Tone.Warning, "fa-hands-bound", "схвачен");
            if (c.Disarmed)
                yield return (Tone.Warning, "fa-hand", "разоружён");
            if (c.Disadvantage)
                yield return (Tone.Neutral, "fa-arrow-down", "невыгодное положение");
            if (c.Aiming)
                yield return (Tone.Info, "fa-crosshairs", "целится");
            if (c.CoverRound == Round)
                yield return (Tone.Info, "fa-shield-halved", "укрылся от огня");
            if (c.AttackBlockedRound is { } blocked && blocked >= Round && Round > 0)
                yield return (Tone.Neutral, "fa-ban", $"без атаки в раунде {blocked}");
            if (c.FirearmReady)
                yield return (Tone.Info, "fa-gun", "огнестрел наготове");
            if (c.JammedAttack is not null)
                yield return (Tone.Warning, "fa-wrench", $"оружие заклинило ({c.JamRoundsLeft} р.)");
            if (c.Casting is { } casting)
                yield return (casting.Disrupted ? Tone.Warning : Tone.Stone, "fa-hat-wizard",
                    casting.Disrupted ? $"сотворение «{casting.SpellName}» сорвано" : $"творит «{casting.SpellName}» до раунда {casting.CompletesInRound}");
            if (c.InitiativeLevel is { } level)
                yield return (Tone.Neutral, "fa-dice-d20", $"инициатива: {Core.Dice.RulesText.Of(level)}");
        }
    }

    private Tone SideTone => Participant.Side switch
    {
        EncounterSide.Investigators => Tone.Success,
        EncounterSide.Enemies => Tone.Error,
        _ => Tone.Neutral,
    };
}
