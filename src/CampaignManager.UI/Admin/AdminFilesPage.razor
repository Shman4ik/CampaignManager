@page "/admin/files"
@attribute [Authorize(Policy = Policies.Admin)]
@using CampaignManager.Contracts.Files
@using CampaignManager.UI.Platform
@inject IFilesApi FilesApi
@inject DialogService Dialogs
@inject ToastService Toasts

@* Неиспользуемые файлы («сироты» в коде и API) — строки cm.files, на которые ничто не ссылается (старше суток). Сначала отчёт, удаление —
   отдельной кнопкой и только того, что в отчёте: сервер повторяет условие в самом DELETE, и файл, на
   который сослались после отчёта, уйдёт в «пропущено». Перенесено с /dev/files (T1.5). API — модуль
   файлов (Server/Files/CLAUDE.md, «Сироты»). *@
<PageHeader Title="Файлы" />

<div class="cm-page">
    @* Пока отчёта нет, в карточке кнопка и строка — карточка по содержимому; с отчётом её ширину берёт таблица. *@
    <section class="@Css.Join("cm-section", _report is { Files.Count: > 0 } ? null : "max-w-2xl")" aria-labelledby="orphans-title">
        <div class="cm-card">
            <SectionHeader Title="Неиспользуемые файлы" />
            <div class="cm-card-body cm-stack">
                @* Сначала действие, потом пояснение: первым на экране была абзац-справка. *@
                <div class="cm-btn-row">
                    <Button Icon="fa-magnifying-glass" Busy="_busy" OnClick="LoadAsync">
                        @(_report is null ? "Найти неиспользуемые" : "Искать заново")
                    </Button>
                    @if (_report is { Files.Count: > 0 } report)
                    {
                        <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" Disabled="_busy" OnClick="DeleteAsync">
                            Удалить @report.Files.Count (@FormatSize(report.TotalBytes))
                        </Button>
                    }
                </div>

                @if (_error is not null)
                {
                    <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0">@_error</Alert>
                }

                @if (_deleted is { } deleted)
                {
                    <Alert Tone="Tone.Success" Small="true" class="mb-0">
                        Удалено: @deleted.Deleted.Count. Пропущено (уже используются): @deleted.Skipped.Count.
                        @if (deleted.ObjectsNotDeleted.Count > 0)
                        {
                            <span>Хранилище не удалило объекты: @string.Join(", ", deleted.ObjectsNotDeleted).</span>
                        }
                    </Alert>
                }

                @if (_report is { Files.Count: 0 })
                {
                    <Alert Tone="Tone.Success" Small="true" ShowIcon="true" class="mb-0">Неиспользуемых файлов нет.</Alert>
                }

                <p class="text-sm text-primary-600">Картинки и треки старше суток, на которые ничто не ссылается.</p>
            </div>

            @if (_report is { Files.Count: > 0 } orphans)
            {
                <div class="border-t border-primary-200">
                    <DataTable Items="orphans.Files" RowKey="f => f.Id" AriaLabel="Неиспользуемые файлы">
                        <Columns>
                            <DataColumn TItem="StoredFileDto" Title="Файл" SortBy="f => f.OriginalName ?? f.ExternalUrl">
                                <span class="break-all">@(context.OriginalName ?? context.ExternalUrl)</span>
                            </DataColumn>
                            <DataColumn TItem="StoredFileDto" Title="Тип">@context.ContentType</DataColumn>
                            <DataColumn TItem="StoredFileDto" Title="Размер" AlignEnd="true" SortBy="f => f.SizeBytes ?? 0">
                                <span class="whitespace-nowrap">@(context.SizeBytes is { } size ? FormatSize(size) : "—")</span>
                            </DataColumn>
                            <DataColumn TItem="StoredFileDto" Title="Загружен" SortBy="f => f.CreatedAt" DefaultSort="false">
                                <span class="whitespace-nowrap">@LocalTime.DateTime(context.CreatedAt)</span>
                            </DataColumn>
                        </Columns>
                        <CardTemplate>
                            <div class="break-all font-semibold text-primary-800">@(context.OriginalName ?? context.ExternalUrl)</div>
                            <div class="cm-meta">
                                <span>@context.ContentType</span>
                                <span>@(context.SizeBytes is { } size ? FormatSize(size) : "—")</span>
                                <span>@LocalTime.DateTime(context.CreatedAt)</span>
                            </div>
                        </CardTemplate>
                    </DataTable>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private OrphanFilesReport? _report;
    private DeleteOrphansResponse? _deleted;
    private string? _error;
    private bool _busy;

    private Task LoadAsync() => RunAsync(async () =>
    {
        _deleted = null;
        _report = await FilesApi.GetOrphansAsync();
    });

    private async Task DeleteAsync()
    {
        if (_report is not { Files.Count: > 0 } report
            || !await Dialogs.ConfirmDeleteAsync("Удалить неиспользуемые файлы?", $"Файлов: {report.Files.Count}, {FormatSize(report.TotalBytes)}. Строки и объекты в хранилище."))
        {
            return;
        }

        await RunAsync(async () =>
        {
            _deleted = await FilesApi.DeleteOrphansAsync([.. report.Files.Select(f => f.Id)]);
            _report = await FilesApi.GetOrphansAsync();
            Toasts.Success($"Удалено файлов: {_deleted.Deleted.Count}.");
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} МБ",
        >= 1024 => $"{bytes / 1024.0:0} КБ",
        _ => $"{bytes} Б",
    };
}
