@page "/admin/users"
@attribute [Authorize(Policy = Policies.Admin)]
@implements IDisposable
@using CampaignManager.Contracts.Admin
@using CampaignManager.Core.Identity
@using CampaignManager.UI.Platform
@inject IAdminApi Api
@inject AdminBadges Badges
@inject DialogService Dialogs
@inject ToastService Toasts
@inject IUserSession Session
@inject NavigationManager Navigation

@* Пользователи и смена роли. Список целиком одним запросом (людей десятки) — поиск, фильтр и страницы на
   клиенте. Роль меняется сразу и видна человеку со следующего запроса: роль сервер читает из базы
   на каждый запрос, кэша claims v1 больше нет. Знание — Admin/CLAUDE.md. *@
<PageHeader Title="Пользователи" Subtitle="@(_users.Count > 0 ? UsersCount(_users.Count) : null)">
    <Actions>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-inbox" Href="@AdminPages.Applications">
            Заявки
            @if (Pending > 0)
            {
                <span class="cm-count-badge">@Pending</span>
            }
        </Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    @* «Сбросить фильтры» активна, только когда есть что сбрасывать (A2). Липкость панели — решение FilterPanel (владелец F6a): для
       списка в десятки строк она не нужна, и фильтр уйдёт вместе с прокруткой, когда её снимут в самом компоненте. *@
    <FilterPanel OnReset="ResetFilters" CanReset="@(!string.IsNullOrWhiteSpace(_search) || _role is not null)">
        <input type="search" class="cm-input min-w-48 flex-1" placeholder="Имя или почта…" aria-label="Поиск по имени или почте"
               @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
        <select class="cm-input w-full shrink-0 sm:w-56" aria-label="Роль" @bind="_role" @bind:after="ResetPage">
            <option value="">Все роли</option>
            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <option value="@role">@RoleLabels.Role(role)</option>
            }
        </select>
    </FilterPanel>

    @if (UserFilter is not null)
    {
        @* Одна строка со ссылкой, а не плашка с кнопкой на 92px ради одного перехода. *@
        <p class="flex flex-wrap items-center gap-x-3 text-sm text-primary-600" data-testid="user-filter-note">
            <span>Показан один пользователь — из заявки.</span>
            <a href="@AdminPages.Users" class="inline-flex min-h-11 items-center underline hover:no-underline">Показать всех</a>
        </p>
    }

    <AsyncContent Load="LoadAsync" LoadingMessage="Загружаю пользователей…" Context="loaded">
        @{
            var shown = Filter(_users);
        }
        <div class="cm-card">
            <DataTable Items="shown" RowKey="u => u.Id" TableFrom="TableBreakpoint.Lg" AriaLabel="Пользователи" EmptyText="Нет пользователей по этим условиям."
                       Page="_page" PageSize="PageSize">
                <Columns>
                    <DataColumn TItem="AdminUserDto" Title="Пользователь" SortBy="u => u.DisplayName" DefaultSort="false">
                        <div class="font-semibold text-primary-800">@context.DisplayName</div>
                        <div class="text-sm text-primary-500">@context.Email</div>
                        @if (context.IsMe || context.HasPendingApplication)
                        {
                            <div class="mt-1">@Notes(context)</div>
                        }
                    </DataColumn>
                    <DataColumn TItem="AdminUserDto" Title="Роль" SortBy="u => u.Role" HeaderClass="w-52">
                        @RoleSelect(context)
                    </DataColumn>
                    <DataColumn TItem="AdminUserDto" Title="Кампании" SortBy="u => u.CampaignCount">
                        @context.CampaignCount
                    </DataColumn>
                    <DataColumn TItem="AdminUserDto" Title="Листы" SortBy="u => u.CharacterCount">
                        @context.CharacterCount
                    </DataColumn>
                    <DataColumn TItem="AdminUserDto" Title="Регистрация" SortBy="u => u.RegisteredAt ?? DateTimeOffset.MinValue">
                        <span class="whitespace-nowrap">@(context.RegisteredAt is { } registered ? LocalTime.ShortDate(registered) : "—")</span>
                    </DataColumn>
                    <DataColumn TItem="AdminUserDto" Title="Последний вход" SortBy="u => u.LastLoginAt ?? DateTimeOffset.MinValue">
                        <span class="whitespace-nowrap">@(context.LastLoginAt is { } at ? LocalTime.ShortDate(at) : NeverSignedIn)</span>
                    </DataColumn>
                </Columns>
                <CardTemplate>
                    <div class="flex flex-wrap items-start gap-x-3 gap-y-2">
                        <div class="min-w-0 flex-1 basis-48">
                            <div class="truncate font-semibold text-primary-800">@context.DisplayName</div>
                            <div class="truncate text-sm text-primary-500">@context.Email</div>
                            <div class="text-sm text-primary-500">
                                Кампаний: @context.CampaignCount · листов: @context.CharacterCount
                            </div>
                            <div class="text-sm text-primary-500">
                                @(context.RegisteredAt is { } registered ? $"Зарегистрирован {LocalTime.Date(registered)} · " : "")вход: @(context.LastLoginAt is { } at ? LocalTime.DateTime(at) : NeverSignedIn)
                            </div>
                            <div class="mt-1">@Notes(context)</div>
                        </div>
                        <div class="w-full sm:w-48">@RoleSelect(context)</div>
                    </div>
                </CardTemplate>
            </DataTable>
        </div>
        <Pagination CurrentPage="_page" CurrentPageChanged="p => _page = p" PageSize="PageSize" TotalItems="shown.Count" />
    </AsyncContent>
</div>

@code {
    private const int PageSize = 20;

    private List<AdminUserDto> _users = [];
    private string? _search;
    private UserRole? _role;
    private int _page = 1;
    private Guid? _busyUser;
    // Отменённая смена роли: select уже показывает выбранное, разметка — нет. Новый ключ пересоздаёт его.
    private int _selectGeneration;

    /// <summary>Перенесённые из v1 входили до переключения, а дата входа заполняется только новым входом: «не входил» без пояснения читалось бы как «мёртвая учётка» — поэтому прочерк, а не слово (п. 11: «2.0» в интерфейсе нет).</summary>
    private const string NeverSignedIn = "—";

    /// <summary>Ссылка из заявки: показать одного пользователя (<c>?user=id</c>; почту в адрес не кладём).</summary>
    [SupplyParameterFromQuery(Name = "user")] public Guid? UserFilter { get; set; }

    private int Pending => Badges.Counts.GetValueOrDefault(AdminPages.Applications);

    // Счётчик в шапке: при прямой загрузке страницы сводку оболочка дочитывает уже после первой отрисовки.
    protected override void OnInitialized() => Badges.Changed += OnBadgesChanged;

    private void OnBadgesChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Badges.Changed -= OnBadgesChanged;

    private async Task<List<AdminUserDto>> LoadAsync(CancellationToken cancellationToken)
    {
        _users = [.. await Api.GetUsersAsync(cancellationToken)];
        StateHasChanged(); // счётчик в подзаголовке — в шапке, вне AsyncContent
        return _users;
    }

    private RenderFragment RoleSelect(AdminUserDto user) =>
        @<select class="cm-input min-w-44" aria-label="@($"Роль: {user.DisplayName}")" value="@user.Role" disabled="@(_busyUser == user.Id)"
                 @key="(user.Id, user.Role, _selectGeneration)"
                 @onchange="e => ChangeRoleAsync(user, e.Value?.ToString())">
            @foreach (var role in Enum.GetValues<UserRole>())
            {
                <option value="@role" selected="@(role == user.Role)">@RoleLabels.Role(role)</option>
            }
        </select>;

    private static RenderFragment Notes(AdminUserDto user) =>
        @<div class="flex flex-wrap gap-1.5">
            @if (user.IsMe)
            {
                <Badge Tone="Tone.Neutral">Это вы</Badge>
            }
            @if (user.HasPendingApplication)
            {
                <a href="@AdminPages.Applications" class="inline-flex min-h-11 items-center no-underline"><Badge Tone="Tone.Warning" Icon="fa-hourglass-half">Заявка ждёт</Badge></a>
            }
        </div>;

    private List<AdminUserDto> Filter(IEnumerable<AdminUserDto> users)
    {
        var search = _search?.Trim();
        return
        [
            .. users.Where(u => (UserFilter is null || u.Id == UserFilter)
                                && (_role is null || u.Role == _role)
                                && (string.IsNullOrEmpty(search)
                                    || u.DisplayName.Contains(search, StringComparison.CurrentCultureIgnoreCase)
                                    || u.Email.Contains(search, StringComparison.OrdinalIgnoreCase))),
        ];
    }

    private void ResetPage() => _page = 1;

    private void ResetFilters()
    {
        _search = null;
        _role = null;
        _page = 1;
    }

    private static string UsersCount(int count) =>
        $"{count} {(count % 100 is >= 11 and <= 14 ? "пользователей" : (count % 10) switch { 1 => "пользователь", >= 2 and <= 4 => "пользователя", _ => "пользователей" })}";

    private static string ConfirmTitle(UserRole role) => role switch
    {
        UserRole.Admin => "Назначить администратором?",
        UserRole.Keeper => "Назначить Хранителем?",
        _ => "Сделать игроком?",
    };

    private async Task ChangeRoleAsync(AdminUserDto user, string? value)
    {
        if (!Enum.TryParse<UserRole>(value, out var role) || role == user.Role)
        {
            return;
        }

        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            ConfirmTitle(role),
            $"Роль сменится с «{RoleLabels.Role(user.Role)}» на «{RoleLabels.Role(role)}». {RoleLabels.RoleDescription(role)}")
        {
            Subject = user.DisplayName,
            ConfirmText = "Сменить роль",
            ConfirmVariant = ButtonVariant.Primary,
            Details = user.IsMe ? "Это ваша собственная роль." : null,
        });
        if (!confirmed)
        {
            _selectGeneration++;
            return;
        }

        _busyUser = user.Id;
        try
        {
            var updated = await Api.ChangeRoleAsync(user.Id, role);
            _users[_users.FindIndex(u => u.Id == user.Id)] = updated;
            Toasts.Success($"Роль изменена: {RoleLabels.Role(updated.Role).ToLowerInvariant()},", subject: updated.DisplayName);
            if (updated.IsMe)
            {
                // Снял с себя администратора — меню должно спрятать админку сразу.
                await Session.RefreshAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            _selectGeneration++;
            Toasts.Error(ApiErrors.Describe(ex), "Роль не изменена");
        }
        finally
        {
            _busyUser = null;
        }
    }
}
