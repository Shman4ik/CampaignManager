@page "/character/create/{CampaignId:guid}"
@page "/character/create/{Kind}"
@attribute [Authorize]
@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Platform
@inject ICharactersApi Api
@inject ICatalogApi<SkillDto> SkillsApi
@inject NavigationManager Navigation

@* «Новый лист» (T2.4): куда он ляжет и три способа — помощник главы 3, случайный сыщик (тот же помощник с
   RandomDraft, открытый на «Итоге»), чистый лист; у НПС ещё быстрый НПС. Чистый лист создаётся только по кнопке:
   переход по ссылке ничего не пишет, иначе перезагрузка заводила бы двойников. Все способы собирают лист одним
   SheetBuilder (Core). Место проверяется до выбора — знание v1: иначе отказ приходил только на «Создать».
   Игрок сюда не выбирает способ (решение 58 ревью g3): адрес сыщика сразу ведёт в помощник, «Случайный сыщик» — ссылка на
   его первом шаге, «Пустой лист» — адрес с ?blank=1 (кнопка на главной) и одна карточка с именем. *@
<PageHeader Title="@(IsBlankOnly ? "Пустой лист" : CreationLinks.NewTitle(CreationKind))" Subtitle="@(_context is null ? null : CreationLinks.PlaceText(_context))">
    <Actions>
        <Button Small="true" Variant="ButtonVariant.Secondary" Href="@CreationLinks.Back(CreationKind, ScenarioId)">Назад</Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    @if (!_redirecting)
    {
    <AsyncContent Key="@LoadKey" Load="LoadAsync" LoadingMessage="Проверяю, куда ляжет лист…" Context="context">
        <ChildContent>
            @if (!context.CanCreate)
            {
                <Alert Tone="Tone.Warning" ShowIcon="true" Title="Лист здесь не завести" data-testid="create-refused">
                    <ChildContent>@context.Reason</ChildContent>
                    <Actions>
                        @if (context.ActiveCharacterId is { } active)
                        {
                            <Button Icon="fa-id-card" Href="@($"character/{active}")">Открыть текущего сыщика</Button>
                        }
                    </Actions>
                </Alert>
            }
            else
            {
                @if (_error is not null)
                {
                    <Alert Tone="Tone.Error" ShowIcon="true" OnClose="() => _error = null">@_error</Alert>
                }

                @* У НПС способов четыре: в три колонки cm-grid-cards четвёртая падала одна во второй ряд — поэтому 2 × 2. *@
                <div class="@(IsBlankOnly ? "max-w-xl" : CreationKind is CharacterKind.Npc ? "grid gap-3 md:grid-cols-2" : "cm-grid-cards")" data-testid="create-options">
                    @if (!IsBlankOnly)
                    {
                    <div class="cm-card">
                        <div class="cm-card-body flex h-full flex-col gap-3">
                            <h2 class="cm-card-title"><i class="fa-solid fa-wand-magic-sparkles mr-2 text-accent-600" aria-hidden="true"></i>Пошаговый помощник</h2>
                            <p class="cm-text-muted flex-1">
                                Семь шагов: способ, характеристики, профессия, навыки, биография, снаряжение и итог. Любой бросок
                                можно сделать здесь или вписать с настоящих костей.
                            </p>
                            <Button Icon="fa-wand-magic-sparkles" Href="@CreationLinks.Wizard(CreationKind, CampaignOrNull, ScenarioId)"
                                    data-testid="create-wizard">Начать создание</Button>
                        </div>
                    </div>
                    <div class="cm-card">
                        <div class="cm-card-body flex h-full flex-col gap-3">
                            <h2 class="cm-card-title"><i class="fa-solid fa-dice mr-2 text-accent-600" aria-hidden="true"></i>@CreationLinks.RandomTitle(CreationKind)</h2>
                            <p class="cm-text-muted flex-1">
                                Кости бросит сам помощник — по тем же правилам. Откроется итог: любой шаг можно переиграть до создания.
                            </p>
                            <Button Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="create-random"
                                    Href="@CreationLinks.Wizard(CreationKind, CampaignOrNull, ScenarioId, random: true)">Создать случайного</Button>
                        </div>
                    </div>
                    @if (CreationKind is CharacterKind.Npc)
                    {
                        <div class="cm-card">
                            <div class="cm-card-body flex h-full flex-col gap-3">
                                <h2 class="cm-card-title"><i class="fa-solid fa-bolt mr-2 text-accent-600" aria-hidden="true"></i>Быстрый НПС</h2>
                                <p class="cm-text-muted flex-1">
                                    Встречный констебль за полминуты: типаж, пара чисел, боевой навык 25/40/70% и имя под эпоху.
                                </p>
                                <Button Variant="ButtonVariant.Secondary" Icon="fa-bolt" data-testid="create-quick"
                                        OnClick="() => _quickOpen = true">Заполнить форму</Button>
                            </div>
                        </div>
                    }
                    }
                    <div class="cm-card">
                        <div class="cm-card-body flex h-full flex-col gap-3">
                            <h2 class="cm-card-title"><i class="fa-solid fa-file mr-2 text-accent-600" aria-hidden="true"></i>Чистый лист</h2>
                            <Field Label="Имя" Required="@(CreationKind is not CharacterKind.Player)">
                                <input class="cm-input" maxlength="@CharacterLimits.NameLength" data-testid="blank-name" @bind="_blankName" />
                            </Field>
                            <p class="cm-text-muted flex-1">Пустой бланк: всё заполняете на листе сами — например, переносите бумажный лист.</p>
                            <Button Variant="ButtonVariant.Secondary" Icon="fa-file-circle-plus" Busy="_busy" data-testid="create-blank" class="@(IsBlankOnly ? "self-start" : null)"
                                    Disabled="@(CreationKind is not CharacterKind.Player && string.IsNullOrWhiteSpace(_blankName))"
                                    DisabledReason="Впишите имя"
                                    OnClick="() => CreateBlankAsync(context)">Создать чистый лист</Button>
                        </div>
                    </div>
                </div>

                @if (_quickOpen)
                {
                    <QuickNpcModal Open="true" Era="context.Era" CampaignId="CampaignOrNull" ScenarioId="ScenarioId"
                                   OnClose="() => _quickOpen = false" OnCreated="OpenCreated" />
                }
            }
        </ChildContent>
    </AsyncContent>
    }
</div>

@code {
    private CreationContextDto? _context;
    private string _blankName = "";
    private string? _error;
    private bool _busy;
    private bool _quickOpen;

    /// <summary>Кампания игрока (маршрут <c>/character/create/{campaignId}</c>).</summary>
    [Parameter] public Guid? CampaignId { get; set; }

    [Parameter] public string? Kind { get; set; }

    /// <summary>Кампания-владелец НПС (<c>?campaignId=</c>) — у маршрута с видом.</summary>
    [SupplyParameterFromQuery(Name = "campaignId")] public Guid? QueryCampaignId { get; set; }

    [SupplyParameterFromQuery(Name = "scenarioId")] public Guid? ScenarioId { get; set; }

    /// <summary>«Пустой лист» игрока: без этого адрес сыщика ведёт сразу в помощник.</summary>
    [SupplyParameterFromQuery(Name = "blank")] public string? Blank { get; set; }

    private bool _redirecting;

    private bool IsBlankOnly => CreationKind is CharacterKind.Player;

    protected override void OnParametersSet()
    {
        if (CreationKind is CharacterKind.Player && Blank is not ("1" or "true"))
        {
            _redirecting = true;
            Navigation.NavigateTo(CreationLinks.Wizard(CreationKind, CampaignOrNull, ScenarioId), replace: true);
        }
    }

    private CharacterKind CreationKind => CampaignId is not null ? CharacterKind.Player : CreationLinks.KindFromRoute(Kind);

    /// <summary>Преген живёт в сценарии или библиотеке — кампании у него нет.</summary>
    private Guid? CampaignOrNull => CreationKind is CharacterKind.Pregen ? null : CampaignId ?? QueryCampaignId;

    private string LoadKey => $"{CreationKind}:{CampaignOrNull}:{ScenarioId}";

    private async Task<CreationContextDto> LoadAsync(CancellationToken cancellationToken)
    {
        var context = await Api.GetCreationContextAsync(CreationKind, CampaignOrNull, ScenarioId, cancellationToken);
        _context = context;
        StateHasChanged();
        return context;
    }

    private async Task CreateBlankAsync(CreationContextDto context)
    {
        _busy = true;
        _error = null;
        try
        {
            var skills = await SkillsApi.ListAsync();
            var sheet = SheetBuilder.Blank(SkillCatalogs.From(skills.Items), _blankName);
            var created = await Api.CreateAsync(new CreateCharacterRequest
            {
                Kind = CreationKind,
                CampaignId = CampaignOrNull,
                ScenarioId = CreationKind is CharacterKind.Pregen ? ScenarioId : null,
                Cast = CreationKind is CharacterKind.Npc && ScenarioId is { } scenario ? new NpcCastRequest(scenario) : null,
                Sheet = sheet,
            });
            // Чистый лист заполняют — он открывается в режиме «Лист», а не «Игра» (там пока нечего показывать).
            Navigation.NavigateTo(CharacterPage.SheetModeHref(created.Id), replace: true);
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenCreated(Guid id) => Navigation.NavigateTo($"character/{id}", replace: true);
}
