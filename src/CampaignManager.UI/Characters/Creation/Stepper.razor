@* «− значение +» для раскладки пунктов (вычет за возраст, экстра-класс). Кнопки — cm-btn-sm 36px: тап-цель на iPad.
   Пределы решает правило Core, которое вызывает страница: кнопка просто просит шаг ±1. *@
<span class="inline-flex items-center gap-1">
    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-minus" AriaLabel="@($"{Label}: меньше")" Disabled="@(Value <= 0)"
            OnClick="() => OnStep.InvokeAsync(-1)" />
    <span class="w-9 text-center tabular-nums">@(Value == 0 ? "0" : $"{Prefix}{Value}")</span>
    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" AriaLabel="@($"{Label}: больше")" OnClick="() => OnStep.InvokeAsync(1)" />
</span>

@code {
    [Parameter] public int Value { get; set; }

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Знак перед ненулевым значением: «−5» у вычета, «+3» у экстра-класса.</summary>
    [Parameter] public string Prefix { get; set; } = "";

    [Parameter] public EventCallback<int> OnStep { get; set; }
}
