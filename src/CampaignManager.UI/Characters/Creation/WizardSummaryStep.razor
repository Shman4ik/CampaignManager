@using CampaignManager.Core
@using CampaignManager.Core.Characters

@* «Итог»: ровно то, что уйдёт в базу, — лист собирает тот же SheetBuilder.FromDraft, что и кнопка «Создать». Сюда
   же открывается случайный сыщик: у каждого блока «Изменить» ведёт на свой шаг. *@
<div class="cm-stack" data-testid="wizard-summary">
    <section>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="cm-h4" data-testid="summary-name">@(string.IsNullOrWhiteSpace(_sheet.Personal.Name) ? "Без имени" : _sheet.Personal.Name)</h3>
        </div>
        <div class="cm-meta mt-1">
            <span>@Terms.Years(_sheet.Personal.Age)</span>
            @if (!string.IsNullOrWhiteSpace(_sheet.Personal.Gender))
            {
                <span>@_sheet.Personal.Gender</span>
            }
            <span>@(string.IsNullOrWhiteSpace(_sheet.Personal.Occupation) ? "без профессии" : _sheet.Personal.Occupation)</span>
            @if (!string.IsNullOrWhiteSpace(_sheet.Personal.Birthplace))
            {
                <span>родом из: @_sheet.Personal.Birthplace</span>
            }
        </div>
    </section>

    <section>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="cm-section-title">Характеристики</h3>
            <Button Small="true" Variant="ButtonVariant.Ghost" Icon="fa-pen" AriaLabel="Изменить: Характеристики" OnClick="() => OnGoTo.InvokeAsync(CreationStep.Characteristics)">Изменить</Button>
        </div>
        <dl class="mb-3 grid grid-cols-4 gap-2 lg:grid-cols-8" data-testid="summary-characteristics">
            @foreach (var info in InvestigatorCreationRules.Characteristics)
            {
                var value = _sheet.Characteristics[info.Key];
                <div class="rounded-md border border-primary-200 px-2 py-1 text-center" @key="info.Key">
                    <dt class="text-xs text-primary-500">@info.Abbreviation</dt>
                    <dd class="text-lg font-semibold text-primary-800">@value</dd>
                    <dd class="text-xs text-primary-500">@CharacteristicMath.Half(value) / @CharacteristicMath.Fifth(value)</dd>
                </div>
            }
        </dl>
        <DerivedTiles Derived="_derived" Luck="_sheet.Current.Luck" Sanity="_sheet.Current.Sanity" />
    </section>

    <section>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="cm-section-title">Навыки выше базы</h3>
            <Button Small="true" Variant="ButtonVariant.Ghost" Icon="fa-pen" AriaLabel="Изменить: Навыки" OnClick="() => OnGoTo.InvokeAsync(CreationStep.Skills)">Изменить</Button>
        </div>
        @if (_improved.Count == 0)
        {
            <p class="text-primary-700">Пункты навыков ещё никуда не вложены.</p>
        }
        else
        {
            <div class="grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-2 xl:grid-cols-3" data-testid="summary-skills">
                @foreach (var line in _improved)
                {
                    <div class="flex items-baseline justify-between gap-2 border-b border-primary-100 py-1" @key="line.Key">
                        <span class="min-w-0 truncate">@line.Name</span>
                        <strong>@line.Value%</strong>
                    </div>
                }
            </div>
        }
    </section>

    <section>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="cm-section-title">Деньги и снаряжение</h3>
            <Button Small="true" Variant="ButtonVariant.Ghost" Icon="fa-pen" AriaLabel="Изменить: Деньги и снаряжение" OnClick="() => OnGoTo.InvokeAsync(CreationStep.Gear)">Изменить</Button>
        </div>
        <div class="cm-meta">
            <span><span class="cm-meta-label">Наличные:</span> $@FinanceRules.Format(_sheet.Finances.Cash ?? 0)</span>
            <span><span class="cm-meta-label">Карманные:</span> $@FinanceRules.Format(_sheet.Finances.PocketMoney ?? 0)</span>
            <span><span class="cm-meta-label">Активы:</span> @_sheet.Finances.Assets</span>
        </div>
        @if (_sheet.Equipment.Count > 0)
        {
            <p class="mt-2 text-primary-700"><span class="cm-meta-label">Снаряжение:</span> @string.Join(", ", _sheet.Equipment.Select(e => e.Name))</p>
        }
    </section>

    <section>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="cm-section-title">Биография</h3>
            <Button Small="true" Variant="ButtonVariant.Ghost" Icon="fa-pen" AriaLabel="Изменить: Биография" OnClick="() => OnGoTo.InvokeAsync(CreationStep.Biography)">Изменить</Button>
        </div>
        @if (BiographyTables.FilledCount(_sheet.Biography) == 0)
        {
            <p class="text-primary-700">Графы не заполнены — их можно дописать на листе.</p>
        }
        else
        {
            <dl class="flex flex-col gap-2">
                @foreach (var section in BiographyTables.Sections.Where(s => !string.IsNullOrWhiteSpace(s.Read(_sheet.Biography))))
                {
                    <div @key="section.Key">
                        <dt class="text-sm font-semibold text-primary-700">
                            @section.Title
                            @if (Plan.Draft.KeyConnectionSection == section.Key)
                            {
                                <Badge Tone="Tone.Stone" class="ml-1">ключевая связь</Badge>
                            }
                        </dt>
                        <dd class="whitespace-pre-line text-primary-800">@section.Read(_sheet.Biography)</dd>
                    </div>
                }
            </dl>
        }
    </section>
</div>

@code {
    private CharacterSheet _sheet = new();
    private DerivedStats _derived = null!;
    private List<SkillLine> _improved = [];

    [Parameter, EditorRequired] public CreationPlan Plan { get; set; } = null!;

    [Parameter] public EventCallback<CreationStep> OnGoTo { get; set; }

    protected override void OnParametersSet()
    {
        _sheet = SheetBuilder.FromDraft(Plan);
        _derived = DerivedAttributeRules.Compute(_sheet, Plan.Catalog);
        _improved =
        [
            .. _sheet.Skills
                .Select(entry => SheetSkillLayout.Line(_sheet, Plan.Catalog, entry))
                .Where(l => l.Value > l.BaseValue)
                .OrderByDescending(l => l.Value)
                .ThenBy(l => l.Name, StringComparer.CurrentCulture),
        ];
    }
}
