@page "/character/wizard"
@attribute [Authorize]
@using System.Text.Json
@using CampaignManager.Contracts.Characters
@using CampaignManager.Core
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Dice
@using CampaignManager.Core.Documents
@using CampaignManager.UI.Platform
@inject ICharactersApi Api
@inject ICatalogApi<SkillDto> SkillsApi
@inject ICatalogApi<OccupationDto> OccupationsApi
@inject BrowserStorage Storage
@inject DialogService Dialogs
@inject IDiceRoller Dice
@inject NavigationManager Navigation
@inject ToastService Toasts

@* Помощник создания сыщика (T2.4): способ и пять шагов главы 3 плюс «Итог». Черновик — InvestigatorDraft в
   localStorage (переживает перезагрузку и уход со страницы), правила — Core: правки шагов — методы черновика,
   профессия, слоты, бюджеты и проверки шагов — CreationPlan (слоты собирает он, шаги только показывают), лист —
   SheetBuilder.FromDraft, тот же, что у быстрого НПС и импорта. «Случайный сыщик» (?random=1 или ссылка на первом
   шаге) — тот же помощник с SheetBuilder.RandomDraft, открытый на «Итоге» (D6.4). Любой бросок можно вписать
   (RollInput / DiceInput).
   Раскладка (ревью g3): степпер — одна строка, подпись только у текущего шага; подвал — в один ряд (причина слева, кнопки
   справа), причина бывает «жёсткой» (не пускает дальше) и «мягкой» (подсказка, не блокирует): очки не вложены, графы
   биографии. Вводимые значения уходят в черновик на каждое нажатие, а не при потере фокуса: на iPad касание кнопки не
   снимает фокус с поля. *@
<PageHeader Title="@Title" Subtitle="@Subtitle">
    <Actions>
        @if (_context is { CanCreate: false })
        {
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-arrow-left" Href="@CreationLinks.Back(CreationKind, ScenarioId)" data-testid="wizard-cancel">Назад</Button>
        }
        else if (_catalog is not null)
        {
            @* «Начать заново» на телефоне — в «⋯»: два соседних значка без подписей путали (находка g3, п. 3–4). *@
            <Button class="max-md:hidden" Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" OnClick="RestartAsync" data-testid="wizard-restart">Начать заново</Button>
            <span class="md:hidden">
                <RowMenu AriaLabel="Ещё: помощник создания">
                    <RowMenuItem Icon="fa-rotate-left" OnClick="RestartAsync">Начать заново</RowMenuItem>
                </RowMenu>
            </span>
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-xmark" OnClick="ExitAsync" data-testid="wizard-cancel">Выйти</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <AsyncContent Key="@LoadKey" Load="LoadAsync" LoadingMessage="Готовлю помощник…" Context="context">
        <ChildContent>
            @if (!context.CanCreate)
            {
                <Alert Tone="Tone.Warning" ShowIcon="true" Title="Лист здесь не завести" data-testid="create-refused">
                    <ChildContent>@context.Reason</ChildContent>
                    <Actions>
                        @if (context.ActiveCharacterId is { } active)
                        {
                            <Button Small="true" Icon="fa-id-card" Href="@($"character/{active}")">Открыть активного сыщика</Button>
                        }
                    </Actions>
                </Alert>
            }
            else if (_catalog is not null)
            {
                var plan = Plan;
                var step = CurrentStep;
                var validation = plan.Validate(step);
                var summaryInvalid = step == CreationStep.Summary ? plan.FirstInvalidStep() : null;
                var soft = validation is null && summaryInvalid is null ? SoftHint(plan, step) : null;

                <p class="mb-1 text-[0.8125rem] text-primary-700 sm:hidden" data-testid="wizard-step-caption">Шаг @((int)step + 1) из @((int)CreationStep.Summary + 1) — @Steps[step].Title</p>
                <nav class="wizard-steps mb-3" aria-label="Шаги создания сыщика" data-testid="wizard-steps">
                    @foreach (var item in Enum.GetValues<CreationStep>())
                    {
                        var target = item;
                        var reachable = CanGoTo(plan, target);
                        var current = target == step;
                        var done = target < step;
                        @* Текущий шаг — рамка и подпись, пройденный — с галочкой, остальные — номер: главная кнопка кадра одна, «Далее». *@
                        <button type="button" class="@(done ? "wizard-chip wizard-chip-done" : "wizard-chip")" data-testid="@($"wizard-step-{(int)target}")"
                                aria-current="@(current ? "step" : null)" aria-label="@($"Шаг {(int)target + 1}: {Steps[target].Title}")"
                                disabled="@(!reachable)" @onclick="() => GoToAsync(target)">
                            @if (done)
                            {
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                            }
                            @if (current)
                            {
                                <span class="sm:hidden" aria-hidden="true">@((int)target + 1)</span>
                                <span class="max-sm:hidden" aria-hidden="true">@((int)target + 1). @Steps[target].Title</span>
                            }
                            else
                            {
                                <span class="wizard-chip-number" aria-hidden="true">@((int)target + 1)</span>
                            }
                        </button>
                    }
                </nav>

                <div class="cm-card" data-testid="@($"wizard-{step}")">
                    <div class="cm-card-body wizard-step">
                        @if (Steps[step].Hint is { } hint)
                        {
                            <p class="mb-4 text-primary-700">@hint</p>
                        }
                        @switch (step)
                        {
                            case CreationStep.Method:
                                <WizardMethodStep Plan="plan" Kind="CreationKind" OnChanged="ChangedAsync" OnRandom="() => RandomAsync(true)" />
                                break;
                            case CreationStep.Characteristics:
                                <WizardCharacteristicsStep Plan="plan" OnChanged="ChangedAsync" />
                                break;
                            case CreationStep.Occupation:
                                <WizardOccupationStep Plan="plan" Occupations="_occupationDtos" OnChanged="ChangedAsync" />
                                break;
                            case CreationStep.Skills:
                                <WizardSkillsStep Plan="plan" OnChanged="ChangedAsync" />
                                break;
                            case CreationStep.Biography:
                var filled = BiographyTables.FilledCount(_draft.Biography);
                var total = BiographyTables.Sections.Count;
                return BiographyTables.Find(_draft.KeyConnectionSection) is null
                    ? $"Заполнено {filled} из {total} граф, ключевая связь не выбрана"
                    : $"Заполнено {filled} из {total} граф";

            default:
                return null;
        }
    }

    /// <summary>Назад — всегда; вперёд — если все шаги до цели проходят проверку.</summary>
    private static bool CanGoTo(CreationPlan plan, CreationStep target) =>
        target <= (CreationStep)plan.Draft.StepIndex || Enum.GetValues<CreationStep>().Where(s => s < target).All(s => plan.Validate(s) is null);

    private async Task GoToAsync(CreationStep target)
    {
        if (target < CreationStep.Method || target > CreationStep.Summary || !CanGoTo(Plan, target))
            return;

        if (target > CurrentStep && CurrentStep == CreationStep.Skills && !await ConfirmUnspentAsync())
            return;

        _draft.StepIndex = (int)target;
        _error = null;
        await SaveDraftAsync();
    }

    /// <summary>Очки, оставшиеся на шаге «Навыки», при создании сгорают — предупреждаем до перехода. true — идти дальше.</summary>
    private Task<bool> ConfirmUnspentAsync()
    {
        if (_draft.Method is CreationMethod.Blitz)
            return Task.FromResult(true);

        var plan = Plan;
        var occupation = plan.OccupationBudget - _draft.SpentOccupationPoints;
        var personal = plan.PersonalBudget - _draft.SpentPersonalPoints;
        if (occupation <= 0 && personal <= 0)
            return Task.FromResult(true);

        _unspentText = string.Join(" и ", new[]
        {
            occupation > 0 ? $"{occupation} очков профессии" : null,
            personal > 0 ? $"{personal} личных очков" : null,
        }.Where(t => t is not null));
        _unspent = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        return _unspent.Task;
    }

    private void ResolveUnspent(bool goOn)
    {
        var pending = _unspent;
        _unspent = null;
        pending?.TrySetResult(goOn);
    }

    private async Task RestartAsync()
    {
        if (!IsDraftEmpty
            && !await Dialogs.ConfirmAsync(new ConfirmRequest("Начать заново?", "Черновик помощника на этом устройстве сотрётся.") { ConfirmText = "Начать заново", Details = null }))
            return;

        _draft = new InvestigatorDraft { Era = _era };
        _error = null;
        await SaveDraftAsync();
    }

    /// <summary>
    /// Выйти без создания. Черновик остаётся на этом устройстве — об этом тост, иначе «отмена» ничего не отменяла бы
    /// молча (находка g3, п. 4).
    /// </summary>
    private async Task ExitAsync()
    {
        if (!IsDraftEmpty)
            Toasts.Info($"Черновик сохранён — продолжить можно {CreationLinks.ResumeHint(CreationKind, ScenarioId)}.");
        else
            await Storage.RemoveAsync(DraftKey);

        Navigation.NavigateTo(CreationLinks.Back(CreationKind, ScenarioId));
    }

    /// <summary>Случайный сыщик: черновик бросается заново и открывается на «Итоге». Введённое при этом пропадает — спросить.</summary>
    private async Task RandomAsync(bool fromMethodStep)
    {
        if (_catalog is null)
            return;

        var request = fromMethodStep
            ? new ConfirmRequest("Бросить случайного?", "Введённое в помощнике сотрётся.")
            : new ConfirmRequest("Бросить заново?", "Текущий сыщик пропадёт, кости бросятся ещё раз.");
        if ((!fromMethodStep || !IsDraftEmpty)
            && !await Dialogs.ConfirmAsync(request with { ConfirmText = "Бросить", ConfirmVariant = ButtonVariant.Primary, Details = null }))
            return;

        _draft = SheetBuilder.RandomDraft(_catalog, _occupations, _era, Dice);
        _draft.Era = _era;
        _error = null;
        await ChangedAsync();
    }

    private async Task CreateAsync(CreationContextDto context)
    {
        var plan = Plan;
        if (_busy || plan.FirstInvalidStep() is not null)
            return;

        _busy = true;
        _error = null;
        try
        {
            var sheet = SheetBuilder.FromDraft(plan);
            var created = await Api.CreateAsync(new CreateCharacterRequest
            {
                Kind = CreationKind,
                CampaignId = CampaignOrNull,
                ScenarioId = CreationKind is CharacterKind.Pregen ? ScenarioId : null,
                Cast = CreationKind is CharacterKind.Npc && ScenarioId is { } scenario ? new NpcCastRequest(scenario) : null,
                Sheet = sheet,
            });
            await Storage.RemoveAsync(DraftKey);
            Toasts.Success(string.IsNullOrWhiteSpace(sheet.Personal.Name) ? "Лист создан." : $"Лист создан: {sheet.Personal.Name}.");
            Navigation.NavigateTo($"character/{created.Id}", replace: true);
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
