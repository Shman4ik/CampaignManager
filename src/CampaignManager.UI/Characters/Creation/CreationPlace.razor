@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Characters

@* Куда ляжет новый лист: вид, кампания или сценарий, эпоха (по ней имена и столбец таблицы II). Строка меты над
   содержимым страницы создания и помощника. *@
<div class="cm-meta mb-3" data-testid="creation-place">
    <Badge Tone="@(Context.Kind is CharacterKind.Npc ? Tone.Error : Context.Kind is CharacterKind.Pregen ? Tone.Stone : Tone.Info)">
        @CreationLinks.KindTitle(Context.Kind)
    </Badge>
    @if (Context.CampaignName is { } campaign)
    {
        <span><span class="cm-meta-label">Кампания:</span> @campaign</span>
    }
    @if (Context.ScenarioName is { } scenario)
    {
        <span><span class="cm-meta-label">Сценарий:</span> @scenario</span>
    }
    @if (Context.CampaignName is null && Context.ScenarioName is null && Context.Kind is not CharacterKind.Player)
    {
        <span><span class="cm-meta-label">Куда:</span> библиотека НПС и прегенов</span>
    }
    <span><span class="cm-meta-label">Эпоха:</span> @CreationLinks.EraTitle(Context.Era)</span>
</div>

@code {
    [Parameter, EditorRequired] public CreationContextDto Context { get; set; } = null!;
}
