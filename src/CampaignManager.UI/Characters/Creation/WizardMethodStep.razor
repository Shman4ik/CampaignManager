@using CampaignManager.Core.Characters

@* Шаг «Способ»: способ определения характеристик, возраст, необязательные правила. Эпоха —
   у кампании или сценария (строка над помощником): от неё столбец таблицы II и имена. *@
<div class="cm-stack">
    <section>
        <h3 class="cm-section-title mb-2">Способ определения характеристик</h3>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            @foreach (var option in Methods)
            {
                var selected = Draft.Method == option.Method;
                <button type="button" data-testid="@($"method-{option.Method}")" aria-pressed="@(selected ? "true" : "false")"
                        class="@($"flex flex-col gap-1 rounded-md border p-3 text-left {(selected ? "border-accent-600 bg-accent-50 ring-1 ring-accent-600" : "border-primary-200 bg-white")}")"
                        @onclick="() => SelectAsync(option.Method)">
                    <span class="font-semibold text-primary-800">@option.Title</span>
                    <span class="text-sm text-primary-600">@option.Description</span>
                </button>
            }
        </div>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Возраст</h3>
        <div class="flex flex-wrap items-start gap-4">
            <Field Label="Лет" class="w-28" Note="15–90">
                <input type="number" class="cm-input" data-testid="wizard-age" min="@InvestigatorCreationRules.MinAge"
                       max="@InvestigatorCreationRules.MaxAge" value="@Draft.Age" @onchange="SetAgeAsync" />
            </Field>
            <div class="min-w-60 flex-1">
                <p class="text-primary-800"><strong>@Band.Name</strong> (@Band.Range лет)</p>
                <ul class="mt-1 list-disc pl-5 text-sm text-primary-600">
                    @foreach (var line in AgeEffects)
                    {
                        <li>@line</li>
                    }
                </ul>
                @if (Draft.Age > Band.MaxAge)
                {
                    <p class="cm-field-note mt-1">Строки для 90 лет в таблице нет — берётся последняя, «80–89».</p>
                }
            </div>
        </div>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Необязательные правила</h3>
        <label class="mb-2 flex min-h-11 items-start gap-2">
            <input type="checkbox" class="cm-checkbox mt-1" checked="@(Draft.SkillCap is not null)" @onchange="ToggleCapAsync" />
            <span>
                Лимит начальных значений навыков — @InvestigatorCreationRules.OptionalSkillCap%.
                <span class="cm-field-note block">Ни один навык при создании не поднимется выше.</span>
            </span>
        </label>
        <label class="flex min-h-11 items-start gap-2">
            <input type="checkbox" class="cm-checkbox mt-1" checked="@Draft.ExtraClass" data-testid="extra-class" @onchange="ToggleExtraAsync" />
            <span>
                Сыщик экстра-класса — вариант 6.
                <span class="cm-field-note block">1d10 − 1 пунктов (0–9) разложите по характеристикам.</span>
            </span>
        </label>
    </section>
</div>

@code {
    // Номеров страниц книги в помощнике нет (правило 10): плитка — название и одна фраза.
    private sealed record MethodOption(CreationMethod Method, string Title, string Description);

    private static readonly IReadOnlyList<MethodOption> Methods =
    [
        new(CreationMethod.Standard, "Стандартный",
            "Каждая характеристика бросается своей формулой: 3d6 × 5 для СИЛ, ВЫН, ЛВК, НАР и МОЩ, (2d6 + 6) × 5 для ИНТ, ТЕЛ и ОБР."),
        new(CreationMethod.AssignRolls, "Разложить броски",
            "Пять бросков 3d6 и три 2d6 + 6, умноженные на 5, раскладываете по характеристикам как захотите."),
        new(CreationMethod.PointBuy, "Покупка характеристик",
            $"{InvestigatorCreationRules.PointBuyBudget} пунктов между восемью характеристиками, каждой от {InvestigatorCreationRules.PointBuyMin} до {InvestigatorCreationRules.PointBuyMax}."),
        new(CreationMethod.Blitz, "Блиц",
            "Готовые наборы: 80, 70, 60, 60, 50, 50, 50, 40 для характеристик и 70/60/60/50/50/50/40/40/40 для навыков профессии и Средств."),
    ];

    [Parameter, EditorRequired] public CreationPlan Plan { get; set; } = null!;

    [Parameter] public EventCallback OnChanged { get; set; }

    private InvestigatorDraft Draft => Plan.Draft;

    private AgeBand Band => Plan.Band;

    private IEnumerable<string> AgeEffects
    {
        get
        {
            var band = Band;
            if (band.EducationPenalty > 0)
                yield return $"−{band.EducationPenalty} к ОБР";
            if (band.StrengthSizePenalty > 0)
                yield return $"−{band.StrengthSizePenalty} суммарно из СИЛ и/или ТЕЛ (распределите сами)";
            if (band.PhysicalPenalty > 0)
                yield return $"−{band.PhysicalPenalty} суммарно из СИЛ, ВЫН и/или ЛВК (распределите сами)";
            if (band.AppearancePenalty > 0)
                yield return $"−{band.AppearancePenalty} к НАР";
            if (band.EducationChecks > 0)
                yield return $"проверок улучшения ОБР: {band.EducationChecks}";
            if (band.LuckRolls > 1)
                yield return $"Удача бросается {band.LuckRolls} раза, берётся лучший результат";
            if (band.MovePenalty > 0)
                yield return $"−{band.MovePenalty} к Скорости";
            if (band is { EducationPenalty: 0, AppearancePenalty: 0, PhysicalPenalty: 0, StrengthSizePenalty: 0, MovePenalty: 0 })
                yield return "штрафов к характеристикам нет";
        }
    }

    private Task SelectAsync(CreationMethod method)
    {
        Draft.SetMethod(method);
        return OnChanged.InvokeAsync();
    }

    private Task SetAgeAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var age))
            return Task.CompletedTask;

        Draft.SetAge(age);
        return OnChanged.InvokeAsync();
    }

    private Task ToggleCapAsync(ChangeEventArgs e)
    {
        Draft.SkillCap = e.Value is true ? InvestigatorCreationRules.OptionalSkillCap : null;
        return OnChanged.InvokeAsync();
    }

    private Task ToggleExtraAsync(ChangeEventArgs e)
    {
        Draft.SetExtraClass(e.Value is true);
        return OnChanged.InvokeAsync();
    }
}
