@using CampaignManager.Core.Characters
@using CampaignManager.Core

@* Шаг «Способ»: имя, способ определения характеристик, возраст, необязательные правила. Имя спрашивается здесь, а не
   на пятом шаге (находка g3, п. 42): оно же уходит в подзаголовок шапки. «Случайный сыщик» — ссылка рядом с именем.
   Эпоха — у кампании или сценария (подзаголовок помощника): от неё столбец таблицы II и имена. *@
<div class="cm-stack">
    <section class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
        <Field Label="Имя" Required="true" class="w-full max-w-md">
            <input class="cm-input" maxlength="200" data-testid="investigator-name" value="@Draft.Personal.Name"
                   @oninput="e => SetAsync(() => Draft.Personal.Name = Text(e))" />
        </Field>
        <Button Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="create-random" OnClick="OnRandom">@CreationLinks.RandomTitle(Kind)</Button>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Способ определения характеристик</h3>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var option in Methods)
            {
                var selected = Draft.Method == option.Method;
                <button type="button" class="wizard-tile" data-testid="@($"method-{option.Method}")" aria-pressed="@(selected ? "true" : "false")"
                        @onclick="() => SelectAsync(option.Method)">
                    <span class="font-semibold text-primary-800">@option.Title</span>
                    <span class="text-[0.8125rem] text-primary-700">@option.Description</span>
                </button>
            }
        </div>
    </section>

    <section>
        <h3 class="cm-section-title mb-2">Возраст</h3>
        <div class="flex flex-wrap items-start gap-4">
            <Field Label="Лет" class="w-28" Note="15–90">
                <NumberInput Value="Draft.Age" ValueChanged="SetAgeAsync" Min="InvestigatorCreationRules.MinAge"
                             Max="InvestigatorCreationRules.MaxAge" data-testid="wizard-age" />
            </Field>
            <div class="min-w-60 flex-1">
                <p class="text-primary-800"><strong>@Band.Name</strong> (@Band.Range лет)</p>
                <ul class="mt-1 list-disc pl-5 text-[0.8125rem] text-primary-700">
                    @foreach (var line in AgeEffects)
                    {
                        <li>@line</li>
                    }
                </ul>
                @if (Draft.Age > Band.MaxAge)
                {
                    <p class="cm-field-note mt-1">Строки для 90 лет в таблице нет — берётся последняя, «80–89».</p>
                }
            </div>
        </div>
    </section>

    <section>
        <h3 class="cm-section-title mb-1">Необязательные правила</h3>
        <label class="cm-tap-row">
            <input type="checkbox" class="cm-checkbox" checked="@(Draft.SkillCap is not null)" @onchange="ToggleCapAsync" />
            <span>Предел навыка при создании: @InvestigatorCreationRules.OptionalSkillCap%</span>
        </label>
        <label class="cm-tap-row">
            <input type="checkbox" class="cm-checkbox" checked="@Draft.ExtraClass" data-testid="extra-class" @onchange="ToggleExtraAsync" />
            <span>Сыщик экстра-класса: до 9 пунктов сверху</span>
        </label>
    </section>
</div>

@code {
    // Номеров страниц книги в помощнике нет (правило 10): плитка — название и одна короткая фраза; формулы бросков стоят
    // у каждой строки следующего шага и здесь не повторяются.
    private sealed record MethodOption(CreationMethod Method, string Title, string Description);

    private static readonly IReadOnlyList<MethodOption> Methods =
    [
        new(CreationMethod.Standard, "Стандартный", "Бросок по формулам"),
        new(CreationMethod.AssignRolls, "Разложить броски", "Восемь бросков, раскладываете сами"),
        new(CreationMethod.PointBuy, "Покупка характеристик",
            $"{InvestigatorCreationRules.PointBuyBudget} пунктов, каждая {InvestigatorCreationRules.PointBuyMin}–{InvestigatorCreationRules.PointBuyMax}"),
        new(CreationMethod.Blitz, "Готовый набор", "Значения готовы, бросать не нужно"),
    ];

    [Parameter, EditorRequired] public CreationPlan Plan { get; set; } = null!;

    [Parameter] public CharacterKind Kind { get; set; } = CharacterKind.Player;

    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>«Случайный сыщик» — бросить черновик целиком (страница спрашивает, если введено что-то своё).</summary>
    [Parameter] public EventCallback OnRandom { get; set; }

    private InvestigatorDraft Draft => Plan.Draft;

    private AgeBand Band => Plan.Band;

    private IEnumerable<string> AgeEffects
    {
        get
        {
            var band = Band;
            if (band.EducationPenalty > 0)
                yield return $"−{band.EducationPenalty} к ОБР";
            if (band.StrengthSizePenalty > 0)
                yield return $"−{band.StrengthSizePenalty} суммарно из СИЛ и/или ТЕЛ (распределите сами)";
            if (band.PhysicalPenalty > 0)
                yield return $"−{band.PhysicalPenalty} суммарно из СИЛ, ВЫН и/или ЛВК (распределите сами)";
            if (band.AppearancePenalty > 0)
                yield return $"−{band.AppearancePenalty} к НАР";
            if (band.EducationChecks > 0)
                yield return $"проверок улучшения ОБР: {band.EducationChecks}";
            if (band.LuckRolls > 1)
                yield return $"Удача бросается {band.LuckRolls} раза, берётся лучший результат";
            if (band.MovePenalty > 0)
                yield return $"−{band.MovePenalty} к Скорости";
            if (band is { EducationPenalty: 0, AppearancePenalty: 0, PhysicalPenalty: 0, StrengthSizePenalty: 0, MovePenalty: 0 })
                yield return "штрафов к характеристикам нет";
        }
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private Task SetAsync(Action change)
    {
        change();
        return OnChanged.InvokeAsync();
    }

    private Task SelectAsync(CreationMethod method) => SetAsync(() => Draft.SetMethod(method));

    /// <summary>Возраст вне 15–90 при наборе пропускается (набирают «3», потом «35»); поле само вернётся к прежнему при выходе из него.</summary>
    private Task SetAgeAsync(int age) =>
        age is >= InvestigatorCreationRules.MinAge and <= InvestigatorCreationRules.MaxAge ? SetAsync(() => Draft.SetAge(age)) : Task.CompletedTask;

    private Task ToggleCapAsync(ChangeEventArgs e) =>
        SetAsync(() => Draft.SkillCap = e.Value is true ? InvestigatorCreationRules.OptionalSkillCap : null);

    private Task ToggleExtraAsync(ChangeEventArgs e) => SetAsync(() => Draft.SetExtraClass(e.Value is true));
}
