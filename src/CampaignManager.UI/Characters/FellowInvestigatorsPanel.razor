@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Characters
@inject ICharactersApi Api

@* «Знакомые сыщики» — рядом с биографией. Строки — соседи по столу из API (имя, профессия и
   игрок — из живых листов) плюс вписанные руками; убрать можно только вписанные. Заметка о соседе заводит
   строку в документе лишь в момент, когда её напишут, со слепком имени — иначе открытие листа меняло бы
   документ и дёргало автосохранение, а при уходе соседа заметка осталась бы без адресата (знание v1). *@
<section data-testid="fellows">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h3 class="cm-card-title">Знакомые сыщики</h3>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" OnClick="AddManual">Добавить знакомого</Button>
    </div>
    @if (_party is null)
    {
        <p class="cm-field-note">Загружаю состав…</p>
    }
    else if (_party.Count == 0 && Sheet.FellowInvestigators.Count == 0)
    {
        <EmptyState Compact="true" Title="Соседей по столу нет — знакомого можно добавить вручную." />
    }
    else
    {
        @* Поле заметки — по касанию имени (g2 6.2): три одинаковых пустых поля подряд были стеной. У знакомого с заметкой она
           видна текстом под именем. *@
        @foreach (var member in _party)
        {
            var note = EntryFor(member.CharacterId)?.Note ?? "";
            var open = _open == member.CharacterId;
            <div class="border-t border-primary-200 first:border-t-0" @key="member.CharacterId" data-testid="fellow-row">
                <button type="button" class="flex min-h-8 w-full items-start justify-between gap-2 py-1 text-left" aria-expanded="@(open ? "true" : "false")"
                        aria-label="@($"Заметка о знакомом: {member.Name}")" data-testid="fellow-toggle" @onclick="() => Toggle(member.CharacterId)">
                    <span class="min-w-0">
                        <span class="font-semibold text-primary-900">@member.Name</span>
                        @if (Meta(member) is { Length: > 0 } meta)
                        {
                            <span class="ml-1 text-sm text-primary-600">· @meta</span>
                        }
                        @if (!open && note.Length > 0)
                        {
                            <span class="block text-sm text-primary-700">@note</span>
                        }
                    </span>
                    <i class="@Css.Join("fa-solid mt-1.5 shrink-0 text-xs text-primary-500", open ? "fa-chevron-up" : "fa-pen")" aria-hidden="true"></i>
                </button>
                @if (open)
                {
                    <input class="cm-input mb-2" @ref="_noteInput" placeholder="Что сыщик думает о нём" aria-label="@($"Заметка: {member.Name}")"
                           value="@note" @onchange="e => SetNote(member, e)" />
                }
            </div>
        }
        @foreach (var entry in Manual)
        {
            <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2 border-t border-primary-200 py-2 first:border-t-0 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,2fr)_auto]">
                <input class="cm-input" placeholder="Имя" aria-label="Имя знакомого" @bind="entry.Name" @bind:after="Context.Changed" />
                <input class="cm-input" placeholder="Игрок" aria-label="Игрок" @bind="entry.PlayerName" />
                <input class="cm-input col-span-2 sm:col-span-1" placeholder="Заметка" aria-label="Заметка" @bind="entry.Note" />
                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" AriaLabel="@($"Убрать: {entry.Name}")"
                        class="col-start-2 row-start-1 sm:col-start-auto sm:row-start-auto" OnClick="() => Remove(entry)" />
            </div>
        }
    }
</section>

@code {
    private IReadOnlyList<PartyMemberDto>? _party;
    private Guid? _open;

    private static string Meta(PartyMemberDto member) =>
        string.Join(" · ", new[] { member.PlayerName, member.Occupation }.Where(p => !string.IsNullOrWhiteSpace(p)));
    private ElementReference _noteInput;
    private bool _focusNote;

    /// <summary>Касание имени открывает заметку (одну за раз) и ставит в неё курсор; повторное — закрывает.</summary>
    private void Toggle(Guid id)
    {
        _open = _open == id ? null : id;
        _focusNote = _open is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusNote)
            return;

        _focusNote = false;
        await _noteInput.FocusAsync();
    }

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    private CharacterSheet Sheet => Context.Sheet;

    /// <summary>Вписанные руками и осиротевшие (сосед ушёл из кампании — заметка о нём осталась).</summary>
    private IEnumerable<FellowInvestigator> Manual
    {
        get
        {
            var known = _party?.Select(p => p.CharacterId).ToHashSet() ?? [];
            return Sheet.FellowInvestigators.Where(e => e.CharacterId is not { } id || !known.Contains(id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _party = await Api.GetPartyAsync(Context.Character.Id);
        }
        catch (HttpRequestException)
        {
            _party = [];
        }
    }

    private FellowInvestigator? EntryFor(Guid characterId) =>
        Sheet.FellowInvestigators.FirstOrDefault(e => e.CharacterId == characterId);

    /// <summary>Заметка заводит строку и снимает слепок имени; пустая заметка строку убирает.</summary>
    private void SetNote(PartyMemberDto member, ChangeEventArgs e)
    {
        var note = e.Value?.ToString()?.Trim() ?? "";
        var entry = EntryFor(member.CharacterId);
        if (note.Length == 0)
        {
            if (entry is not null)
                Sheet.FellowInvestigators.Remove(entry);
        }
        else if (entry is null)
        {
            Sheet.FellowInvestigators.Add(new FellowInvestigator
            {
                CharacterId = member.CharacterId,
                Name = member.Name,
                PlayerName = member.PlayerName ?? "",
                Note = note,
            });
        }
        else
        {
            entry.Note = note;
            entry.Name = member.Name;
        }

        Context.Changed();
    }

    private void AddManual()
    {
        Sheet.FellowInvestigators.Add(new FellowInvestigator());
        Context.Changed();
    }

    private void Remove(FellowInvestigator entry)
    {
        Sheet.FellowInvestigators.Remove(entry);
        Context.Changed();
    }
}
