@using CampaignManager.Core.Catalogs
@using CampaignManager.Core.Characters

@* Навыки по группам бланка (раскладка — Core/SheetSkillLayout). Строки размечены @key: без него Blazor
   переиспользует поле соседнего навыка, когда список перетасовывается (навык уехал из свёрнутых), и
   показывает чужое значение (знание v1). Порядок — «Частые», затем алфавит (Core/SheetSkillLayout.Sections); две колонки — явное деление списка пополам, не CSS columns.
   Свёрнутые специализации на базе стоят в алфавите строкой на месте родителя. *@
@* Поиск липнет под меню секций, пока идёт список (g2 3.5). Кнопки добавления — рядом с ним; на телефоне липкая только строка
   поиска, а кнопки идут под ней (две строки липкой полосы съедали бы шестую часть экрана). *@
<div class="sheet-skill-search" data-testid="skill-tools">
    <div class="flex flex-wrap items-center gap-2">
        <input type="search" class="cm-input min-w-48 flex-1" placeholder="Поиск навыка…" aria-label="Поиск навыка"
               data-testid="skill-search" @bind="_search" @bind:event="oninput" />
        <div class="flex flex-wrap gap-2 max-md:hidden">@AddButtons("")</div>
    </div>
</div>
<div class="mb-3 flex flex-wrap gap-2 md:hidden">@AddButtons("phone-")</div>
<p class="cm-field-note mb-3">
    Касание названия — проверка. (N) — база навыка; галочка — отметка для фазы развития.
</p>

@if (_adding == Adding.Specialization)
{
    <div class="sheet-skill-form mb-3 flex flex-wrap items-end gap-2 border-y border-primary-200 py-3">
        <Field Label="Навык" class="w-full sm:w-56">
            <select class="cm-input" @ref="_parentSelect" @bind="_parentId">
                <option value="">— выберите —</option>
                @foreach (var parent in Parents)
                {
                    <option value="@parent.Id">@parent.Name</option>
                }
            </select>
        </Field>
        <Field Label="Специализация" class="min-w-48 flex-1">
            <input class="cm-input" list="spec-options" placeholder="латынь, химия, пистолет…" data-testid="specialization-name"
                   @bind="_name" @bind:event="oninput" />
            <datalist id="spec-options">
                @foreach (var option in SpecializationOptions)
                {
                    <option value="@option"></option>
                }
            </datalist>
        </Field>
        @* «Добавить · Отмена» — один ряд; почему «Добавить» недоступна — отдельной строкой под ним, а не зажатой между кнопками. *@
        <div class="flex gap-2">
            <Button Small="true" Icon="fa-plus" Disabled="@(_parentId is null || string.IsNullOrWhiteSpace(_name))" data-testid="specialization-add"
                    OnClick="AddSpecialization">Добавить</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="CancelAdd">Отмена</Button>
        </div>
        @if (_parentId is null || string.IsNullOrWhiteSpace(_name))
        {
            <p class="cm-field-note w-full" data-testid="specialization-reason">@(_parentId is null ? "Выберите навык." : "Впишите специализацию.")</p>
        }
        <p class="cm-field-note w-full">Нет в справочнике — база ближайшей по смыслу, иначе 1%.</p>
    </div>
}
else if (_adding == Adding.Own)
{
    <div class="sheet-skill-form mb-3 flex flex-wrap items-end gap-2 border-y border-primary-200 py-3">
        <Field Label="Название" class="min-w-48 flex-1">
            <input class="cm-input" @ref="_nameInput" data-testid="own-skill-name" @bind="_name" @bind:event="oninput" />
        </Field>
        <Field Label="Значение" class="w-24">
            <input type="number" inputmode="numeric" min="0" max="99" class="cm-input" @bind="_value" />
        </Field>
        <div class="flex gap-2">
            <Button Small="true" Icon="fa-plus" Disabled="@string.IsNullOrWhiteSpace(_name)" data-testid="own-skill-add" OnClick="AddOwn">Добавить</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="CancelAdd">Отмена</Button>
        </div>
        @if (string.IsNullOrWhiteSpace(_name))
        {
            <p class="cm-field-note w-full">Впишите название.</p>
        }
        <p class="cm-field-note w-full">Только на этом листе, в справочник не попадёт.</p>
    </div>
}

@{ var sections = Filtered(); }
@if (sections.Frequent.Count == 0 && sections.Others.Count == 0 && sections.Folds.Count == 0)
{
    <p class="py-6 text-center text-sm text-primary-500">Навыки не найдены.</p>
}
else
{
    @if (sections.Frequent.Count > 0)
    {
        <section class="skill-group" data-testid="skills-frequent">
            <h3 class="skill-block-title">Частые</h3>
            @Halves(sections.Frequent)
        </section>
    }
    @if (sections.Others.Count > 0 || sections.Folds.Count > 0)
    {
        <section class="skill-group" data-testid="skills-others">
            <h3 class="skill-block-title">@(sections.Frequent.Count > 0 ? "Остальные по алфавиту" : "По алфавиту")</h3>
            @Halves(Alphabetic(sections))
        </section>
    }
}

@code {
    private RenderFragment Row(SkillLine line) => @<SkillRow @key="line.Key" Line="line" OnValue="v => SetValue(line, v)" OnChecked="v => SetChecked(line, v)"
                                                           OnRemove="() => Remove(line)" OnOpen="() => Open(line)" />;

    /// <summary>
    /// Свёрнутые специализации — строкой на месте родителя в алфавите («Наука» между «Механикой» и «Оккультизмом»),
    /// а не стеной кнопок «Наука: показать ещё 13» после всего списка: так их ищут глазами там же, где остальные навыки.
    /// </summary>
    private static IReadOnlyList<object> Alphabetic(SkillSections sections) =>
        [.. sections.Others.Cast<object>().Concat(sections.Folds)
            .OrderBy(item => SheetSkillLayout.AlphabeticKey(item is SpecializationFold fold ? fold.ParentName : ((SkillLine)item).Name), StringComparer.Ordinal)];

    private RenderFragment Item(object item) => item switch
    {
        SpecializationFold fold => Fold(fold),
        SkillLine line => Row(line),
        _ => _ => { },
    };

    private RenderFragment Fold(SpecializationFold fold) =>
        @<details class="skill-fold" @key="fold.ParentId" open="@(_search.Length > 0)" data-testid="skill-fold">
            <summary><i class="fa-solid fa-chevron-right skill-fold-icon" aria-hidden="true"></i><span><span class="skill-fold-name">@fold.ParentName</span><span class="skill-fold-count">· ещё @fold.Lines.Count</span></span></summary>
            @foreach (var line in fold.Lines)
            {
                @Row(line)
            }
        </details>;

    /// <summary>Список ровно пополам: первая половина — левая колонка сверху вниз, вторая — правая (с 768px); уже — одна колонка в том же порядке.</summary>
    private RenderFragment Halves(IReadOnlyList<SkillLine> lines) => Halves(lines.Cast<object>().ToList());

    private RenderFragment Halves(IReadOnlyList<object> lines)
    {
        var (left, right) = SheetSkillLayout.SplitInHalf(lines);
        return @<div class="skill-halves">
            <div class="skill-half" data-testid="skills-left">
                <div class="skill-labels" aria-hidden="true"><span class="skill-col">знач.</span><span class="skill-col">½</span><span class="skill-col">⅕</span></div>
                @foreach (var line in left)
                {
                    @Item(line)
                }
            </div>
            @if (right.Count > 0)
            {
                <div class="skill-half" data-testid="skills-right">
                    <div class="skill-labels skill-labels-second" aria-hidden="true"><span class="skill-col">знач.</span><span class="skill-col">½</span><span class="skill-col">⅕</span></div>
                    @foreach (var line in right)
                    {
                        @Item(line)
                    }
                </div>
            }
        </div>;
    }

    private RenderFragment AddButtons(string idPrefix) =>
        @<text>
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="@($"{idPrefix}add-specialization")"
                    OnClick="() => OpenForm(Adding.Specialization)">Специализация</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" data-testid="@($"{idPrefix}add-own-skill")"
                    OnClick="() => OpenForm(Adding.Own)">Свой навык</Button>
        </text>;

    private enum Adding { None, Specialization, Own }

    private ElementReference _parentSelect;
    private ElementReference _nameInput;
    private bool _focusForm;

    /// <summary>Форма открывается между поиском и списком — на телефоне ниже сгиба: фокус в первое поле заодно прокручивает к ней (g2 3.6).</summary>
    private void OpenForm(Adding adding)
    {
        _adding = adding;
        _focusForm = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusForm)
            return;

        _focusForm = false;
        if (_adding == Adding.Specialization)
            await _parentSelect.FocusAsync();
        else if (_adding == Adding.Own)
            await _nameInput.FocusAsync();
    }

    private string _search = "";
    private Adding _adding;
    private Guid? _parentId;
    private string _name = "";
    private int _value = 1;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    private IEnumerable<SkillDefinition> Parents =>
        Context.Catalog.Skills.Where(s => Context.Catalog.IsParent(s.Id)).OrderBy(s => s.Name, StringComparer.CurrentCulture);

    /// <summary>Подсказки: специализации родителя из справочника — частью в скобках.</summary>
    private IEnumerable<string> SpecializationOptions => _parentId is { } parent
        ? Context.Catalog.Children(parent).Select(c => Inner(c.Name)).Where(n => n.Length > 0)
        : [];

    private static string Inner(string name)
    {
        var open = name.IndexOf('(', StringComparison.Ordinal);
        var close = name.LastIndexOf(')');
        return open >= 0 && close > open ? name[(open + 1)..close].Trim() : "";
    }

    private SkillSections Filtered()
    {
        var sections = SheetSkillLayout.Sections(Context.Sheet, Context.Catalog);
        var query = CatalogCodeTable.NormalizeName(_search);
        if (query.Length == 0)
            return sections;

        bool Matches(SkillLine line) => CatalogCodeTable.NormalizeName(line.Name).Contains(query, StringComparison.Ordinal);

        return new SkillSections(
            [.. sections.Frequent.Where(Matches)],
            [.. sections.Others.Where(Matches)],
            [.. sections.Folds.Select(f => f with { Lines = [.. f.Lines.Where(Matches)] }).Where(f => f.Lines.Count > 0)]);
    }

    private void SetValue(SkillLine line, int value)
    {
        SheetSkillLayout.SetValue(Context.Sheet, Context.Catalog, line, value);
        Context.Changed();
    }

    private void SetChecked(SkillLine line, bool value)
    {
        SheetSkillLayout.SetChecked(Context.Sheet, line, value);
        Context.Changed();
    }

    private void Remove(SkillLine line)
    {
        SheetSkillLayout.Remove(Context.Sheet, line);
        Context.Changed();
    }

    /// <summary>Касание имени — сразу проверка навыка; справка лежит в самом окне проверки.</summary>
    private void Open(SkillLine line) => Context.Check(line.Key);

    private void AddSpecialization()
    {
        if (_parentId is not { } parent)
            return;

        SheetSkillLayout.AddSpecialization(Context.Sheet, Context.Catalog, parent, _name);
        _search = "";
        CancelAdd();
        Context.Changed();
    }

    private void AddOwn()
    {
        SheetSkillLayout.AddOwn(Context.Sheet, _name, _value);
        CancelAdd();
        Context.Changed();
    }

    private void CancelAdd()
    {
        _adding = Adding.None;
        _parentId = null;
        _name = "";
        _value = 1;
    }
}
