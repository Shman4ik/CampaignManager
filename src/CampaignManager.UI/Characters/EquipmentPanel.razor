@using CampaignManager.Contracts.Catalogs
@using CampaignManager.Core.Characters
@inject ToastService Toasts

@* Снаряжение — список «название + описание»; из справочника предметов берётся копия текста. Магические
   предметы — тоже сюда: текстовой графы «Магические предметы» в 2.0 нет (решение владельца 2026-10-02). *@
<section data-testid="equipment">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h3 class="cm-card-title">Снаряжение</h3>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" AriaLabel="Добавить предмет" data-testid="equipment-add"
                OnClick="() => _adding = true">Добавить</Button>
    </div>
    @if (_adding)
    {
        <div class="mb-3">
            <CatalogSearch TItem="ItemDto" Load="Context.Catalogs.ItemsAsync" Name="i => i.Name" Placeholder="Найти предмет или вписать новый…"
                           Meta="i => i.Type ?? string.Empty" OnSelect="Add" OnCustom="AddNamed" OnCancel="() => _adding = false" />
        </div>
    }
    @if (Sheet.Equipment.Count == 0)
    {
        <EmptyState Compact="true" Title="@Terms.Empty("предметов")" />
    }
    @if (Sheet.Equipment.Count > 0)
    {
        @* Шапка столбцов: два поля без подписей читались как таблица без заголовков (g2 4.6). Названию — больше места, чем
           описанию: «Фотоаппарат «Кодак № 1» с…» обрезался на 450px, а описание в 650px занимало 12 знаков. *@
        <div class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1fr)_2.75rem] gap-2 border-b border-primary-200 pb-1 text-[0.8125rem] font-semibold text-primary-600 sm:grid" aria-hidden="true">
            <span>Предмет</span><span>Описание</span><span></span>
        </div>
    }
    @for (var i = 0; i < Sheet.Equipment.Count; i++)
    {
        var item = Sheet.Equipment[i];
        <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-2 border-t border-primary-200 py-2 first:border-t-0 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_2.75rem]"
             data-testid="equipment-row">
            <input class="cm-input" placeholder="Предмет" aria-label="Предмет" @bind="item.Name" />
            <input class="cm-input col-span-2 row-start-2 sm:col-span-1 sm:row-start-auto" placeholder="Описание" aria-label="@($"{item.Name}: описание")"
                   @bind="item.Description" />
            <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" AriaLabel="@($"Убрать: {item.Name}")"
                    OnClick="() => Remove(item)" />
        </div>
    }
</section>

@code {
    private bool _adding;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    private CharacterSheet Sheet => Context.Sheet;

    private void Add(ItemDto item) => Append(new EquipmentItem { Name = item.Name, Description = item.Description ?? "" });

    private void AddNamed(string name) => Append(new EquipmentItem { Name = name });

    private void Append(EquipmentItem item)
    {
        Sheet.Equipment.Add(item);
        _adding = false;
        Context.Changed();
    }

    /// <summary>Убирает сразу; вернуть можно из тоста 8 секунд.</summary>
    private void Remove(EquipmentItem item)
    {
        var index = Sheet.Equipment.IndexOf(item);
        Sheet.Equipment.Remove(item);
        Context.Changed();
        Toasts.Removed(string.IsNullOrWhiteSpace(item.Name) ? "предмет" : Names.Plain(item.Name), () =>
        {
            Sheet.Equipment.Insert(Math.Min(Math.Max(index, 0), Sheet.Equipment.Count), item);
            Context.Changed();
            return Task.CompletedTask;
        });
    }
}
