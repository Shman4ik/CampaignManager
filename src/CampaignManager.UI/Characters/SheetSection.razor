@* Секция листа — одна карточка: шапка со свёрткой и тело. Блоки внутри своих карточек не заводят
   (одна карточка, никогда две): соседние блоки секции разделяет линейка (BodyClass="cm-stack").
   Раскрытие хранит страница: секция только показывает (Expanded + OnToggle). Действия в шапке (Actions)
   свёртку не трогают. *@
<section id="@SheetSections.Anchor(Info)" class="cm-section sheet-section" data-testid="@($"section-{Info.Id}")">
    <div class="cm-card">
        <div class="cm-card-header">
            <button type="button" class="sheet-section-toggle" aria-expanded="@(Expanded ? "true" : "false")"
                    data-testid="@($"section-toggle-{Info.Id}")" @onclick="OnToggle">
                <i class="fa-solid @Info.Icon text-primary-400" aria-hidden="true"></i>
                <h2 class="cm-card-title">@Info.Title</h2>
                <i class="fa-solid @(Expanded ? "fa-chevron-up" : "fa-chevron-down") text-primary-400 text-xs" aria-hidden="true"></i>
            </button>
            @if (Actions is not null)
            {
                <div class="flex flex-wrap items-center gap-2">@Actions</div>
            }
        </div>
        @if (Expanded)
        {
            @* Только для чтения — fieldset disabled: все поля и кнопки блока разом, без проверки в каждом. *@
            <fieldset class="cm-card-body min-w-0 @BodyClass" disabled="@ReadOnly">@ChildContent</fieldset>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SheetSectionInfo Info { get; set; } = null!;

    [Parameter] public bool Expanded { get; set; } = true;

    [Parameter] public EventCallback OnToggle { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string BodyClass { get; set; } = "";

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
