@using CampaignManager.Core
@using CampaignManager.Core.Characters
@using CampaignManager.Core.Dice
@inject IDiceRoller Dice

@* Лечение вне боя: без отметки «Серьёзная рана» — отдых, 1 ПЗ в день; с отметкой — проверка ВЫН в
   конце недели с костями за уход врача, отдых и плохие условия, успех +1d3, чрезвычайный +2d3 и отметка снята. Считает
   только WoundRules (тот же конвейер, что у боя); окно пишет лист на месте и зовёт Context.Changed — в базу правку
   уносит автосохранение листа с If-Match, своего пути записи нет. Любой бросок можно вписать: d100 — RollInput,
   1d3/2d3 — DiceInput (пусто — бросит правило). *@
<Modal Open="@Open" OnClose="CloseAsync" Title="@($"Лечение вне боя — {Sheet.Personal.Name}")" data-testid="recovery-modal">
    <ChildContent>
        @{
            var status = WoundRules.Read(Sheet);
            var max = DerivedAttributeRules.MaxHitPoints(Sheet);
        }
        <div class="flex flex-col gap-3">
            <p class="text-sm" data-testid="recovery-status">
                <span class="font-semibold">ПЗ @status.HitPoints из @max</span>@(status.MajorWound ? " · серьёзная рана" : "")@(WoundRules.StateText(status) is { } state ? $" · {state}" : "")
            </p>

            @if (_last is { } last)
            {
                <Alert Tone="@(last.Refusal is not null ? Tone.Warning : last.After.HitPoints > last.Before.HitPoints ? Tone.Success : Tone.Info)"
                       ShowIcon="true" Small="true" class="!mb-0" data-testid="recovery-result">
                    @_lastCaption@(last.Refusal ?? last.Text).
                </Alert>
            }

            @if (status.Dead)
            {
                <p class="cm-field-note">Мёртвого не лечат.</p>
            }
            else if (status.Dying)
            {
                <p class="cm-field-note">
                    При смерти: сначала первая помощь (временная стабилизация), потом Медицина — тогда «при смерти» снимается и
                    начинается недельное лечение серьёзной раны.
                </p>
            }
            else if (status.MajorWound)
            {
                var (bonus, penalty) = WoundRules.RecoveryDice(_care, _rested, _poor);
                var con = Sheet.Characteristics[Characteristic.CON];
                <p class="cm-field-note">
                    Пока стоит отметка, ПЗ сами не прибывают: в конце каждой недели — проверка ВЫН. Успех +1d3, чрезвычайный +2d3 и
                    отметка снята, провал — неделя без выздоровления.
                </p>
                <div class="flex flex-col" role="group" aria-label="Условия недели">
                    @Condition("Уход врача: его проверка Медицины пройдена (+1 кость)", _care, v => _care = v, "recovery-care")
                    @Condition("Отдых в комфортной обстановке (+1 кость)", _rested, v => _rested = v, "recovery-rest")
                    @Condition("Плохие условия (−1 кость)", _poor, v => _poor = v, "recovery-poor")
                </div>
                <Field Label="@($"Проверка ВЫН {con}")" Group="true" data-testid="recovery-roll">
                    <RollInput Label="Лечение раны" Value="@con" BonusDice="@bonus" PenaltyDice="@penalty"
                               Roll="@_roll" RollChanged="SetRoll" />
                </Field>
                @if (bonus != penalty)
                {
                    <p class="cm-field-note -mt-2">
                        Кости со стола: с бонусной впишите меньший из вариантов десятков, со штрафной — больший.
                    </p>
                }
                @if (_roll is { } roll && WoundRules.RecoveryDiceCount(Check.Evaluate(roll.Result, con)) is var count and > 0)
                {
                    <Field Label="@($"ПЗ: {count}d{WoundRules.HealDieSides}")" Group="true" Note="пусто — бросит правило">
                        <DiceInput Count="@count" Sides="@WoundRules.HealDieSides" Label="Лечение раны" Value="@_heal" ValueChanged="v => _heal = v" />
                    </Field>
                }
            }
            else if (status.HitPoints >= max && !status.Unconscious)
            {
                <p class="cm-field-note">Сыщик не ранен: ПЗ полные.</p>
            }
            else
            {
                <p class="cm-field-note">Без серьёзной раны сыщик восстанавливает 1 ПЗ в день.</p>
                <div class="flex flex-wrap items-end gap-3">
                    <Field Label="Дней отдыха" class="w-28">
                        <input type="number" inputmode="numeric" min="1" max="999" class="cm-input" data-testid="recovery-days"
                               value="@_days" @onchange="SetDays" />
                    </Field>
                    <span class="pb-2 text-sm text-primary-700" data-testid="recovery-preview">
                        → ПЗ @WoundRules.NaturalRecovery(status, max, _days).After.HitPoints из @max
                    </span>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync">Закрыть</Button>
        @if (WoundRules.Read(Sheet) is { Dead: false, Dying: false } current)
        {
            @if (current.MajorWound)
            {
                <Button Icon="fa-calendar-week" Disabled="@(_roll is null)" DisabledReason="Сначала бросьте или впишите проверку Выносливости" data-testid="recovery-week" OnClick="Week">Записать неделю</Button>
            }
            else if (current.HitPoints < DerivedAttributeRules.MaxHitPoints(Sheet) || current.Unconscious)
            {
                <Button Icon="fa-bed" data-testid="recovery-rest-apply" OnClick="Rest">Записать отдых</Button>
            }
        }
    </Footer>
</Modal>

@code {
    private bool _care, _rested, _poor;
    private D100Roll? _roll;
    private int? _heal;
    private int _days = 1;
    private HealOutcome? _last;
    private string _lastCaption = "";
    private bool _wasOpen;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private CharacterSheet Sheet => Context.Sheet;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _care = _rested = _poor = false;
            _roll = null;
            _heal = null;
            _days = 1;
            _last = null;
        }

        _wasOpen = Open;
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    /// <summary>Новый бросок — новое число костей лечения (1d3 или 2d3): вписанное прежде к нему не относится.</summary>
    private void SetRoll(D100Roll? roll)
    {
        _roll = roll;
        _heal = null;
    }

    private void SetDays(ChangeEventArgs e) =>
        _days = int.TryParse(e.Value?.ToString(), out var days) ? Math.Clamp(days, 1, 999) : 1;

    private void Week()
    {
        if (_roll is not { } roll)
            return;

        var check = WoundRules.ApplyWeeklyRecovery(Sheet, roll, _heal, Dice);
        _last = check.Outcome;
        _lastCaption = $"ВЫН: {roll.Result} — {RulesText.Of(check.Level)}"
                       + (check.Amount > 0 ? $", {WoundRules.RecoveryDiceCount(check.Level)}d3 → {check.Amount}" : "") + ". ";
        _roll = null;
        _heal = null;
        Context.Changed();
    }

    private void Rest()
    {
        _last = WoundRules.ApplyNaturalRecovery(Sheet, _days);
        _lastCaption = $"Отдых {_days} дн.: ";
        Context.Changed();
    }

    private RenderFragment Condition(string label, bool value, Action<bool> set, string testId) =>
        @<label class="flex min-h-10 items-center gap-2 text-sm">
            <input type="checkbox" class="cm-checkbox" data-testid="@testId" checked="@value" disabled="@(_roll is not null)"
                   @onchange="e => set(e.Value is true)" />
            <span>@label</span>
        </label>;
}
