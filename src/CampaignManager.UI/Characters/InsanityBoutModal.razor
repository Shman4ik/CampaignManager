@using CampaignManager.Core.Characters
@using CampaignManager.Core.Dice
@inject IDiceRoller Dice

@* Приступ безумия. Таблицы VII/VIII — InsanityTables, запись — SanityRules.RecordBout; текст
   приступа в лист не копируется — по номеру его отдают таблицы. Десять строк — кнопки: их нажимают и после
   броска настоящей костью, и когда Хранитель выбирает строку сам. Длительность — своя пара «бросить / вписать».
   Закрытый Modal ничего не рендерит, а открывают его заново — поэтому прошлый приступ новое открытие не
   встречает (в v1 — флаги _wasVisible). *@
@* У верхнего края: после выбора строки результат и длительность растут вниз, окно не прыгает. *@
<Modal Open="@Open" OnClose="CloseAsync" Title="Приступ безумия" Size="ModalSize.Large" class="cm-modal-top">
    <ChildContent>
        <div class="cm-stack">
            <section>
                <h3 class="cm-section-title mb-2">Как разыграть</h3>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    @foreach (var mode in Modes)
                    {
                        <button type="button" class="@Css.Join("bout-mode", _mode == mode ? "bout-mode-active" : null)" aria-pressed="@(_mode == mode ? "true" : "false")"
                                data-testid="@($"bout-mode-{mode}")" @onclick="() => SelectMode(mode)">
                            <span class="font-semibold">@(mode == InsanityBoutMode.RealTime ? "В реальном времени" : "Сводка")</span>
                            <span class="text-xs text-primary-500">
                                @(mode == InsanityBoutMode.RealTime
                                    ? "Таблица VII. Рядом другие сыщики, идёт сцена или бой — приступ длится 1d10 раундов."
                                    : "Таблица VIII. Сыщик один или обезумели все — время проматывается, обычно на 1d10 часов.")
                            </span>
                        </button>
                    }
                </div>
            </section>
            <section>
                <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
                    <h3 class="cm-section-title">Таблица @InsanityTables.TableNumeral(_mode) · 1d10</h3>
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="bout-roll"
                            OnClick="() => _roll = Dice.Roll(1, InsanityTables.BoutDie)">Бросить 1d10</Button>
                </div>
                <p class="cm-field-note mb-2">Бросили настоящую кость или Хранитель выбирает сам — нажмите строку с этим номером.</p>
                <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
                    @foreach (var option in InsanityTables.Bouts(_mode))
                    {
                        <button type="button" @key="option.Number" class="@Css.Join("bout-option", option.Number == _roll ? "bout-option-active" : null)"
                                aria-pressed="@(option.Number == _roll ? "true" : "false")" data-testid="@($"bout-option-{option.Number}")"
                                @onclick="() => _roll = option.Number">
                            <span class="bout-option-number">@option.Number</span>
                            <span>@option.Title</span>
                        </button>
                    }
                </div>
            </section>
            @if (Entry is { } entry)
            {
                <section data-testid="bout-result">
                    <h3 class="mb-2 text-base font-semibold text-primary-900">@entry.Number. @entry.Title</h3>
                    <p class="border-l-4 border-secondary-300 pl-3 text-sm italic text-primary-800">@entry.ReadAloud</p>
                    <p class="mt-2 text-sm text-primary-600">@entry.KeeperNote</p>
                    <div class="mt-3 flex flex-wrap items-end gap-3">
                        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice"
                                OnClick="() => _duration = Dice.Roll(1, InsanityTables.BoutDurationDie)">Длительность 1d10</Button>
                        <Field Label="Выпало" class="w-24">
                            <input type="number" inputmode="numeric" min="1" max="99" class="cm-input" data-testid="bout-duration" @bind="_duration" />
                        </Field>
                        @if (_duration is > 0 and var duration)
                        {
                            <span class="mb-2 text-sm font-semibold text-primary-800">Приступ длится @InsanityTables.DurationText(_mode, duration).</span>
                        }
                    </div>
                    @if (entry.Acquires is { } kind)
                    {
                        <Button Small="true" Icon="fa-plus" class="mt-3" data-testid="bout-acquire" OnClick="() => AcquireAsync(kind)">
                            Записать приступ и выбрать @(kind == InsanityConditionKind.Phobia ? "фобию" : "манию") (табл. @InsanityTables.TableNumeral(kind))
                        </Button>
                    }
                </section>
            }
            <section>
                <ul class="cm-field-note list-disc space-y-1 pl-4">
                    <li>Пока длится приступ, сыщиком управляет Хранитель, а рассудок он не теряет.</li>
                    <li>Хранитель может изменить или дописать один пункт биографии.</li>
                    <li>Затем — затаённое безумие: любая потеря рассудка, даже в 1 пункт, вызывает новый приступ.</li>
                </ul>
            </section>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync">Закрыть</Button>
        <Button Icon="fa-check" Disabled="@(Entry is null)" DisabledReason="Выберите строку таблицы" data-testid="bout-record" OnClick="RecordAsync">Записать приступ</Button>
    </Footer>
</Modal>

@code {
    private static readonly InsanityBoutMode[] Modes = [InsanityBoutMode.RealTime, InsanityBoutMode.Summary];

    private InsanityBoutMode _mode;
    private int? _roll;
    private int? _duration;
    private bool _wasOpen;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Строка дала фобию или манию: приступ уже записан, родитель открывает таблицу IX/X.</summary>
    [Parameter] public EventCallback<InsanityConditionKind> OnAcquire { get; set; }

    private InsanityTables.BoutEntry? Entry => _roll is { } roll ? InsanityTables.FindBout(_mode, roll) : null;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _mode = InsanityBoutMode.RealTime;
            _roll = null;
            _duration = null;
        }

        _wasOpen = Open;
    }

    /// <summary>Номер строки у двух таблиц значит разное, а длительность — разные единицы.</summary>
    private void SelectMode(InsanityBoutMode mode)
    {
        if (_mode == mode)
            return;

        _mode = mode;
        _roll = null;
        _duration = null;
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private async Task RecordAsync()
    {
        if (_roll is not { } roll || Entry is null)
            return;

        SanityRules.RecordBout(Context.Sheet, _mode, roll, _duration is > 0 ? _duration : null);
        Context.Changed();
        await CloseAsync();
    }

    private async Task AcquireAsync(InsanityConditionKind kind)
    {
        if (_roll is not { } roll)
            return;

        SanityRules.RecordBout(Context.Sheet, _mode, roll, _duration is > 0 ? _duration : null);
        Context.Changed();
        await OnAcquire.InvokeAsync(kind);
    }
}
