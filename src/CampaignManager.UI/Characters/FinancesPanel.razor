@using CampaignManager.Core
@using CampaignManager.Core.Catalogs
@using CampaignManager.Core.Characters

@* Финансы: деньги числами (в v1 — строка в трёх форматах), активы словами. Достаток и образ жизни — по
   Средствам и эпохе кампании из таблицы II и раздела «Достаток»: подсказка, не правка. *@
<section data-testid="finances">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h3 class="cm-card-title">Финансы</h3>
        @if (!Context.ReadOnly && IsEmpty)
        {
            <Button Variant="ButtonVariant.Secondary" Icon="fa-wand-magic-sparkles" data-testid="finances-fill" OnClick="FillFromCredit">Заполнить по Средствам</Button>
        }
    </div>
    @{
        var credit = Sheet.Value(Context.Catalog, SkillCodes.CreditRating);
        var tier = FinanceRules.GetTier(credit, Context.Era);
        var lifestyle = FinanceRules.GetLifestyle(credit);
    }
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <Field Label="Наличные, $">
            <input type="number" inputmode="decimal" step="0.01" min="0" class="cm-input" data-testid="cash" @bind="Sheet.Finances.Cash" />
        </Field>
        <Field Label="Карманные, $">
            <input type="number" inputmode="decimal" step="0.01" min="0" class="cm-input" @bind="Sheet.Finances.PocketMoney" />
        </Field>
        <Field Label="Активы, $" class="col-span-2"><input class="cm-input" @bind="Sheet.Finances.Assets" /></Field>
    </div>
    <Field Label="Заметка" class="mt-2"><input class="cm-input" @bind="Sheet.Finances.Note" /></Field>
    @* Одна строка (g2 4.7): итог по Средствам — только пока поля пусты (то, что вставит «Заполнить по Средствам»); жильё и транспорт —
       по касанию. Ни эпохи, ни «таблицы II» на листе: это кухня правил. *@
    <p class="cm-field-note mt-2 flex flex-wrap items-center gap-x-3">
        <span data-testid="finances-hint">
            Средства @credit% — @tier.Name@if (IsEmpty)
            {
                <text>: наличные $@tier.CashText, карманные $@tier.PocketMoneyText, активы @tier.AssetsText</text>
            }
        </span>
        <TouchPopover AriaLabel="Образ жизни: жильё и транспорт" TriggerClass="sheet-link">
            <Trigger><i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>Образ жизни</Trigger>
            <Panel><strong>Жильё:</strong> @lifestyle.Housing <strong>Транспорт:</strong> @lifestyle.Transport</Panel>
        </TouchPopover>
    </p>
</section>

@code {
    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    private CharacterSheet Sheet => Context.Sheet;

    private bool IsEmpty => Sheet.Finances.Cash is null && Sheet.Finances.PocketMoney is null
        && string.IsNullOrWhiteSpace(Sheet.Finances.Assets);

    /// <summary>У перенесённых листов деньги пусты; значения таблицы II по Средствам — та же формула, что у помощника.</summary>
    private void FillFromCredit()
    {
        var credit = Sheet.Value(Context.Catalog, SkillCodes.CreditRating);
        var fresh = FinanceRules.ForNewInvestigator(credit, Context.Era);
        Sheet.Finances.Cash = fresh.Cash;
        Sheet.Finances.PocketMoney = fresh.PocketMoney;
        Sheet.Finances.Assets = fresh.Assets;
        Context.Changed();
    }
}
