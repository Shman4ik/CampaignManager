@using CampaignManager.Core.Characters
@using CampaignManager.Core.Dice
@inject IDiceRoller Dice

@* Новая фобия или мания. Бросок или вписанный номер только подставляет название
   и описание в поля — в запись уходит то, что осталось после правки Хранителя. Описания таблиц — пересказ (D5). *@
<Modal Open="@Open" OnClose="CloseAsync" Title="@(_kind == InsanityConditionKind.Phobia ? "Новая фобия" : "Новая мания")">
    <ChildContent>
        <div class="flex flex-col gap-3">
            @* Segmented, а не тёмная кнопка: главная в окне одна — «Записать». Номеров таблиц в подписях нет (g2 5.5). *@
            <Segmented TValue="InsanityConditionKind" Options="KindOptions" Value="_kind" ValueChanged="SelectKind" Label="Фобия или мания" />
            <div class="flex flex-wrap items-end gap-3">
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="condition-roll"
                        OnClick="() => Fill(Dice.Roll(1, InsanityTables.ConditionDie))">Бросить 1d100</Button>
                <Field Label="Выпало" class="w-24">
                    <input type="number" inputmode="numeric" min="1" max="100" class="cm-input" data-testid="condition-roll-value"
                           value="@_roll" @onchange="SetRoll" />
                </Field>
            </div>
            @* Строка из книги — поиском по названию или номеру, а не слепой прокруткой списка из ста строк (g2 7.4.4). *@
            <Field Label="Или найти по названию" Group="true">
                <CatalogSearch @key="_searchKey" TItem="InsanityTables.ConditionEntry" Load="LoadEntries" Name="EntryLabel"
                               Placeholder="@(_kind == InsanityConditionKind.Phobia ? "Название фобии или номер…" : "Название мании или номер…")"
                               OnSelect="e => Fill(e.Number)" />
            </Field>
            <Field Label="Название"><input class="cm-input" data-testid="condition-name" @bind="_name" @bind:event="oninput" /></Field>
            <Field Label="Описание" Hint="— и при каких обстоятельствах появилась">
                <textarea class="cm-input" rows="2" @bind="_description" @bind:event="oninput"></textarea>
            </Field>
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync">Отмена</Button>
        <Button Icon="fa-check" Disabled="@string.IsNullOrWhiteSpace(_name)" DisabledReason="Впишите название" data-testid="condition-save" OnClick="SaveAsync">Записать</Button>
    </Footer>
</Modal>

@code {
    private IReadOnlyList<SegmentOption<InsanityConditionKind>> KindOptions =>
        [.. Kinds.Select(k => new SegmentOption<InsanityConditionKind>(k, k == InsanityConditionKind.Phobia ? "Фобия" : "Мания"))];

    private int _searchKey;

    private static string EntryLabel(InsanityTables.ConditionEntry entry) => $"{entry.Number}. {entry.Name}";

    private Task<IReadOnlyList<InsanityTables.ConditionEntry>> LoadEntries() =>
        Task.FromResult<IReadOnlyList<InsanityTables.ConditionEntry>>([.. InsanityTables.Conditions(_kind)]);

    private static readonly InsanityConditionKind[] Kinds = [InsanityConditionKind.Phobia, InsanityConditionKind.Mania];

    private InsanityConditionKind _kind;
    private int? _roll;
    private string _name = "";
    private string _description = "";
    private bool _wasOpen;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public InsanityConditionKind Kind { get; set; }

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _kind = Kind;
            _roll = null;
            _name = "";
            _description = "";
        }

        _wasOpen = Open;
    }

    /// <summary>Тот же номер в другой таблице — другая строка: поля заполняются заново.</summary>
    private void SelectKind(InsanityConditionKind kind)
    {
        _kind = kind;
        if (_roll is { } roll)
            Fill(roll);
    }

    private void SetRoll(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var roll))
            Fill(roll);
        else
            _roll = null;
    }

    private void Fill(int roll)
    {
        if (InsanityTables.FindCondition(_kind, roll) is not { } entry)
        {
            _roll = null;
            return;
        }

        _roll = roll;
        _name = entry.Name;
        _description = entry.Description;
        _searchKey++;
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
            return;

        Context.Sheet.InsanityConditions.Add(new InsanityCondition
        {
            Kind = _kind,
            Name = _name.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            AcquiredAt = DateTimeOffset.UtcNow,
        });
        Context.Changed();
        await CloseAsync();
    }
}
