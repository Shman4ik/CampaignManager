@page "/npcs"
@attribute [Authorize(Policy = Policies.Keeper)]
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Characters
@using CampaignManager.Core.Campaigns
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Characters.Creation
@using CampaignManager.UI.Platform
@inject ICharactersApi Api
@inject ICampaignsApi CampaignsApi
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Библиотека НПС и прегенов (T2.4) — Хранителю. Вкладка и архив — в адресе (?tab=pregen&archived=true). НПС не
   копируется: один лист живёт в библиотеке или в кампании, в сценарии он появляется связью (T2.5a: «В сценарий» —
   CastNpcDialog с ролью и количеством), поэтому правка листа видна во всех сценариях. «Удалить» — архив (статус
   листа с If-Match), безвозвратно отсюда ничего не пропадает.
   Чужие НПС кампаний сюда не попадают — список фильтрует сервер правилом листа (AccessPolicy.ForCharacter). *@
@* Заголовок = подпись пункта рельса (правило 5); готовые сыщики — вторая вкладка. F3b (ревью g3, 72–81, 86): «Сбросить фильтры»
   активна только при фильтре, селект «Любое место» не пропадает, «Только архив», пустой результат — строка, подзаголовок со
   склонением, тосты называют объект (одно подтверждение), на телефоне фильтр — поиск и кнопка «Фильтры», по 12 карточек,
   «Быстрый НПС» оставляет в библиотеке с тостом «Создан: … — Открыть». *@
<PageHeader Title="НПС" Subtitle="@CountText">
    <Actions>
        @if (Kind is CharacterKind.Npc)
        {
            @* «Быстрый НПС» делает НПС, а не готового сыщика — на вкладке прегенов его нет. *@
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-bolt" data-testid="open-quick-npc" OnClick="OpenQuickAsync">Быстрый НПС</Button>
        }
        <Button Small="true" Icon="fa-plus" Href="@CreationLinks.Create(Kind, null, null)" data-testid="npc-add">@(Kind is CharacterKind.Npc ? "Добавить НПС" : "Добавить готового сыщика")</Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    <Tabs Items="Items" ActiveKey="@ActiveTab" Href="key => Url(key, ShowArchived)" AriaLabel="Вид листа" />
    <FilterPanel OnReset="ResetFilters" CanReset="@CanReset">
        <input type="search" class="cm-input min-w-48 flex-1" placeholder="Поиск по имени, профессии, месту…" aria-label="Поиск"
               data-testid="npc-search" @bind="_search" @bind:event="oninput" />
        @* На телефоне — поиск и «Фильтры» (место и архив прячутся, пока не нужны): четыре ряда фильтра отнимали ≈200px из 651. *@
        <button type="button" class="cm-btn cm-btn-secondary cm-btn-icon relative sm:hidden" aria-label="Фильтры" aria-expanded="@(_filtersOpen ? "true" : "false")"
                data-testid="npc-filters-toggle" @onclick="() => _filtersOpen = !_filtersOpen">
            <i class="fa-solid fa-sliders" aria-hidden="true"></i>
            @if (_place.Length > 0 || ShowArchived)
            {
                <span class="absolute right-1 top-1 h-2 w-2 rounded-full bg-accent-600" aria-hidden="true"></span>
            }
        </button>
        <div class="@(_filtersOpen ? "flex" : "hidden") w-full flex-wrap items-center gap-x-3 gap-y-2 sm:contents">
            <select class="cm-input w-full shrink-0 sm:w-56" aria-label="Сценарий или кампания" data-testid="npc-place" value="@_place" disabled="@(_places.Count == 0)" @onchange="SelectPlace">
                <option value="">Любое место</option>
                @foreach (var place in _places)
                {
                    <option value="@place">@place</option>
                }
            </select>
            <label class="flex min-h-11 items-center gap-2 text-sm text-primary-700">
                <input type="checkbox" class="cm-checkbox" checked="@ShowArchived" data-testid="show-archived" @onchange="ToggleArchived" />
                Только архив
            </label>
        </div>
    </FilterPanel>

    <AsyncContent @ref="_content" Key="@LoadKey" Load="LoadAsync" LoadingMessage="Загружаю библиотеку…" Context="items">
        <ChildContent>
            @{
                var found = Filter(items);
                var pageCount = Math.Max(1, (found.Count + PageSize - 1) / PageSize);
                var page = Math.Clamp(_page, 1, pageCount);
            }
            @if (found.Count == 0)
            {
                @* Кнопка добавления — в шапке, «Сбросить» — в строке фильтров: второй копии здесь нет; пустое — одна строка (правило 4). *@
                <EmptyState Compact="true" Title="@EmptyTitle(items)" />
            }
            else
            {
                @* Заглушка портрета — только когда портреты в списке вообще есть (у НПС — часть, у готовых сыщиков — ни одного). *@
                var portraits = items.Any(c => c.PortraitUrl is not null);
                <div class="cm-grid-cards" data-testid="library">
                    @foreach (var character in found.Skip((page - 1) * PageSize).Take(PageSize))
                    {
                        <CharacterSummaryCard @key="character.Id" Character="character" PortraitSlot="portraits" Busy="@(_busy == character.Id)"
                                              OnArchive="ArchiveAsync" OnRestore="RestoreAsync" OnCast="c => _casting = c" />
                    }
                </div>
                <Pagination CurrentPage="page" PageSize="PageSize" TotalItems="found.Count" CurrentPageChanged="p => _page = p" />
            }
        </ChildContent>
    </AsyncContent>
</div>

@if (_quickOpen)
{
    <QuickNpcModal Open="true" Campaigns="_keeperCampaigns" OnClose="() => _quickOpen = false" OnCreatedNamed="QuickCreatedAsync" />
}

<CastNpcDialog Open="_casting is not null" Character="_casting" OnClose="() => _casting = null" OnCastSaved="CastAsync" />

@code {
    private const string PregenTab = "pregen";
    private const int PageSize = 12;
    private string _place = "";
    private int _page = 1;
    private IReadOnlyList<string> _places = [];
    private AsyncContent<IReadOnlyList<CharacterSummaryDto>>? _content;
    private string _search = "";
    private Guid? _busy;
    private bool _quickOpen;
    private bool _filtersOpen;
    private int? _count;
    private IReadOnlyList<CampaignSummaryDto> _keeperCampaigns = [];
    private CharacterSummaryDto? _casting;

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "archived")] public bool? Archived { get; set; }

    private string ActiveTab => Tab == PregenTab ? PregenTab : "npc";

    private CharacterKind Kind => ActiveTab == PregenTab ? CharacterKind.Pregen : CharacterKind.Npc;

    private bool ShowArchived => Archived is true;

    private string LoadKey => $"{Kind}:{ShowArchived}";

    private static readonly IReadOnlyList<Tabs.Item> Items =
    [
        new("npc", "НПС", "fa-masks-theater"),
        new(PregenTab, "Готовые сыщики", "fa-user"),
    ];

    private async Task<IReadOnlyList<CharacterSummaryDto>> LoadAsync(CancellationToken cancellationToken)
    {
        var items = await Api.ListAsync(Kind, ShowArchived, cancellationToken);
        _count = items.Count;
        // «Где лист»: кампании и сценарии, которые есть в списке, — Хранитель ищет НПС своей партии, а не по имени.
        _places = [.. items.SelectMany(c => new[] { c.CampaignName, c.ScenarioName }.Concat(c.CastIn))
            .Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!).Distinct().Order(StringComparer.CurrentCulture)];
        if (_place.Length > 0 && !_places.Contains(_place))
            _place = "";
        StateHasChanged();
        return items;
    }

    private List<CharacterSummaryDto> Filter(IReadOnlyList<CharacterSummaryDto> items)
    {
        if (_place.Length > 0)
            items = [.. items.Where(c => c.CampaignName == _place || c.ScenarioName == _place || c.CastIn.Contains(_place))];

        if (string.IsNullOrWhiteSpace(_search))
            return [.. items];

        var needle = CampaignManager.Core.Catalogs.CatalogCodeTable.NormalizeName(_search);
        return
        [
            .. items.Where(c => new[] { c.Name, c.Occupation, c.CampaignName, c.ScenarioName }.Concat(c.CastIn)
                .Any(text => text is not null && CampaignManager.Core.Catalogs.CatalogCodeTable.NormalizeName(text).Contains(needle, StringComparison.Ordinal))),
        ];
    }

    private bool CanReset => _search.Length > 0 || _place.Length > 0 || ShowArchived;

    private string EmptyTitle(IReadOnlyList<CharacterSummaryDto> items)
    {
        var plural = Kind is CharacterKind.Npc ? "НПС" : "готовых сыщиков";
        return items.Count > 0 ? EmptyState.NoneByFilter(plural) : EmptyState.None(plural + (ShowArchived ? " в архиве" : ""));
    }

    /// <summary>«32 листа» / «3 готовых сыщика» — со склонением; «32 НПС» повторяло заголовок.</summary>
    private string? CountText => _count is { } count
        ? Kind is CharacterKind.Npc
            ? $"{count} {Plural(count, "лист", "листа", "листов")}{(ShowArchived ? " в архиве" : "")}"
            : $"{count} {Plural(count, "готовый сыщик", "готовых сыщика", "готовых сыщиков")}{(ShowArchived ? " в архиве" : "")}"
        : null;

    private static string Plural(int n, string one, string few, string many) => (n % 100 is >= 11 and <= 14 ? 0 : n % 10) switch
    {
        1 => one,
        2 or 3 or 4 => few,
        _ => many,
    };

    private string Url(string tab, bool archived)
    {
        List<string> query = [];
        if (tab == PregenTab)
            query.Add("tab=pregen");
        if (archived)
            query.Add("archived=true");
        return query.Count == 0 ? "npcs" : "npcs?" + string.Join("&", query);
    }


    private void ToggleArchived(ChangeEventArgs e) => Navigation.NavigateTo(Url(ActiveTab, e.Value is true), replace: true);

    private void SelectPlace(ChangeEventArgs e)
    {
        _place = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _place = "";
        _page = 1;
        if (ShowArchived)
            Navigation.NavigateTo(Url(ActiveTab, false), replace: true);
    }

    private async Task OpenQuickAsync()
    {
        try
        {
            _keeperCampaigns = [.. (await CampaignsApi.GetCampaignsAsync()).Where(c => c.MyRole == CampaignRole.Keeper && c.CanEdit)];
        }
        catch (HttpRequestException)
        {
            _keeperCampaigns = []; // без списка кампаний НПС уйдёт в библиотеку
        }

        _quickOpen = true;
    }

    /// <summary>Тост называет НПС, сценарий, роль и количество — «сценарий» без названия ничего не подтверждал (ревью g3, 78).</summary>
    private async Task CastAsync(NpcCastSaved saved)
    {
        var role = CampaignManager.Core.Scenarios.ScenarioText.Of(saved.Role).ToLowerInvariant() + (saved.Count > 1 ? $" ×{saved.Count}" : "");
        Toasts.Success($"{Names.Plain(_casting?.Name ?? "НПС")} занят в сценарии:", subject: $"{saved.ScenarioName} · {role}");
        _casting = null;
        if (_content is not null)
            await _content.ReloadAsync();
    }

    /// <summary>
    /// Быстрый НПС из библиотеки остаётся в библиотеке: лист — «Открыть» в тосте; несколько НПС подряд не возвращают сюда каждый
    /// раз (решение оркестратора по ревью g3, 86).
    /// </summary>
    private async Task QuickCreatedAsync((Guid Id, string Name) created)
    {
        var (id, name) = created;
        _quickOpen = false;
        Toasts.Show(Tone.Success, "Создан:", action: new ToastAction("Открыть", () =>
        {
            Navigation.NavigateTo($"character/{id}");
            return Task.CompletedTask;
        }), subject: name);
        if (_content is not null)
            await _content.ReloadAsync();
    }

    private async Task ArchiveAsync(CharacterSummaryDto character)
    {
        // Обратимое действие — кнопка подтверждения обычная, не красная (ревью g3, 80).
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest("Убрать в архив?", "Вернуть можно через «Только архив».")
            {
                Subject = character.Name,
                ConfirmText = "В архив",
                ConfirmVariant = ButtonVariant.Primary,
                Details = null,
            }))
            return;

        await SetStatusAsync(character, CharacterStatus.Archived, "В архиве:");
    }

    private Task RestoreAsync(CharacterSummaryDto character) => SetStatusAsync(character, CharacterStatus.Active, "Вернулся из архива:");

    private async Task SetStatusAsync(CharacterSummaryDto character, CharacterStatus status, string done)
    {
        _busy = character.Id;
        try
        {
            await Api.SetStatusAsync(character.Id, status, character.Version);
            Toasts.Success(done, subject: character.Name);
            if (_content is not null)
                await _content.ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }
}
