@using CampaignManager.Contracts.Files
@using CampaignManager.Core
@using CampaignManager.Core.Characters

@* «Личные данные» — три колонки бланка: анкета с портретом, характеристики с производными, состояние.
   Своей карточки нет: блок всегда в секции листа. Знание v1 о вёрстке под iPad:
   - три колонки — с lg (1024px), а не с md: на 768px «Состоянию» оставалось 240px, и «Макс.» обрезало «11» до «1».
     Ниже lg блоки идут в столбик, колонки характеристик и состояния упираются в max-w-md;
   - подписи полей анкеты — над полями, а не слева: слева подпись съедала 70px, и имя ужималось до «Дж»;
   - «Труд.» и «Чрез.» — текст, а не поля; Б.К.У., Комплекция, Скорость и Уклонение — под характеристиками,
     только для чтения: их считает Core (в v1 их можно было править, и пересчёт молча затирал правку). *@
<div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_0.85fr_1.15fr] lg:divide-x lg:divide-primary-200">
    <div class="flex flex-col gap-3 max-lg:order-3">
        <h3 class="cm-section-title border-b border-primary-200 pb-1">Анкета</h3>
        <div class="flex items-center gap-3">
            <CharacterPortrait Url="@Context.Character.PortraitUrl" ReadOnly="Context.ReadOnly" OnChanged="OnPortraitChanged" />
            <div class="flex min-w-0 flex-1 flex-col gap-2">
                <Field Label="Имя"><input class="cm-input" data-testid="sheet-name" @bind="Sheet.Personal.Name" @bind:after="Context.Changed" /></Field>
                <Field Label="Профессия"><input class="cm-input" @bind="Sheet.Personal.Occupation" /></Field>
            </div>
        </div>
        @if (Context.Character.PlayerName is { } player)
        {
            <div class="text-sm"><span class="cm-meta-label">Игрок:</span> @player</div>
        }
        @if (Context.Character.CampaignName is { } campaign)
        {
            <div class="text-sm">
                <span class="cm-meta-label">Кампания:</span>
                <a class="text-accent-700 underline" href="@($"campaigns/{Context.Character.CampaignId}")">@campaign</a>
            </div>
        }
        <div class="grid grid-cols-2 gap-2">
            <Field Label="Возраст">
                <input type="number" inputmode="numeric" min="0" max="999" class="cm-input" aria-label="Возраст" @bind="Sheet.Personal.Age" @bind:after="Recalculate" />
            </Field>
            <Field Label="Пол"><input class="cm-input" @bind="Sheet.Personal.Gender" /></Field>
        </div>
        <Field Label="Место рождения"><input class="cm-input" @bind="Sheet.Personal.Birthplace" /></Field>
        <Field Label="Место жительства"><input class="cm-input" @bind="Sheet.Personal.Residence" /></Field>
    </div>

    <div class="max-w-md max-lg:order-2 lg:max-w-none lg:pl-4">
        <h3 class="cm-section-title mb-2 border-b border-primary-200 pb-1">Характеристики</h3>
        <table class="sheet-chars">
            <thead>
                <tr><th></th><th>Обычный</th><th>Трудный</th><th>Предельный</th></tr>
            </thead>
            <tbody>
                @foreach (var info in InvestigatorCreationRules.Characteristics)
                {
                    var value = Sheet.Characteristics[info.Key];
                    <tr @key="info.Key">
                        <td>
                            @* Тап по сокращению — проверка этой характеристики. *@
                            <button type="button" class="sheet-chip" aria-label="@($"Проверка: {info.Name}")"
                                    data-testid="@($"char-check-{info.Key}")" @onclick="() => Context.Check(CheckKey(info.Key))">
                                @info.Abbreviation
                            </button>
                        </td>
                        <td>
                            <input type="number" inputmode="numeric" min="0" max="999" class="cm-input cm-input-sm"
                                   aria-label="@($"{info.Name}: значение")" data-testid="@($"char-{info.Key}")"
                                   value="@value" @onchange="e => SetCharacteristic(info.Key, e)" />
                        </td>
                        <td class="sheet-derived">@CharacteristicMath.Half(value)</td>
                        <td class="sheet-derived">@CharacteristicMath.Fifth(value)</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="cm-section-title mt-3 border-t border-primary-200 pt-3">Производные</h4>
        @{ var derived = DerivedAttributeRules.Compute(Sheet, Context.Catalog); }
        <dl class="sheet-derived-grid" data-testid="sheet-derived">
            <div><dt>Бонус к урону</dt><dd>@derived.DamageBonus.ToLowerInvariant()</dd></div>
            <div><dt>Комплекция</dt><dd>@derived.Build</dd></div>
            <div><dt>Скорость</dt><dd>@derived.Move</dd></div>
            <div><dt>Уклонение</dt><dd>@derived.Dodge</dd></div>
        </dl>
        <p class="cm-field-note mt-1">
            Считаются по характеристикам и возрасту; Уклонение — навык, его значение — в «Навыках».
            @if (HasOverrides)
            {
                <text>Часть значений — из книги (НПС).</text>
            }
        </p>
    </div>

    <div class="max-w-md max-lg:order-1 lg:max-w-none lg:pl-4">
        <h3 class="cm-section-title mb-2 border-b border-primary-200 pb-1">Состояние</h3>
        <table class="sheet-current">
            <thead><tr><th></th><th>Сейчас</th><th>Максимум</th></tr></thead>
            <tbody>
                @foreach (var row in Rows(derived))
                {
                    <tr @key="row.Label">
                        <td>
                            @if (row.Label == "Удача")
                            {
                                <button type="button" class="sheet-chip" aria-label="Проверка Удачи" @onclick='() => Context.Check("luck")'><i class="fa-solid fa-dice mr-1" aria-hidden="true"></i>Удача</button>
                            }
                            else
                            {
                                <span class="text-sm font-medium text-primary-700">@row.Label</span>
                            }
                        </td>
                        <td>
                            @* Шаг — штатная кнопка 36×36 с shrink-0: без него узкая колонка сжимала её до 21px. *@
                            <div class="flex items-center gap-1">
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm cm-btn-icon shrink-0"
                                        aria-label="@($"{row.Label}: минус один")" @onclick="() => Adjust(row, -1)">−</button>
                                <input type="number" inputmode="numeric" class="@Css.Join("cm-input cm-input-sm min-w-[2.75rem]", row.Get() > row.Max ? "cm-input-invalid" : null)"
                                       aria-label="@($"{row.Label}: текущее")" data-testid="@($"current-{row.Key}")"
                                       value="@row.Get()" @onchange="e => Set(row, e)" />
                                <button type="button" class="cm-btn cm-btn-secondary cm-btn-sm cm-btn-icon shrink-0"
                                        aria-label="@($"{row.Label}: плюс один")" @onclick="() => Adjust(row, 1)">+</button>
                            </div>
                        </td>
                        <td class="sheet-derived" data-testid="@($"max-{row.Key}")">@row.Max</td>
                    </tr>
                    <tr class="sheet-bar-row">
                        <td colspan="3"><div class="sheet-bar"><div class="@BarClass(row)" style="width: @Percent(row)%"></div></div></td>
                    </tr>
                }
            </tbody>
        </table>

        @* Одна атака — один бросок урона: серьёзная рана считается по нему, а не по сумме за бой. *@
        <div class="mt-3 flex flex-wrap items-end gap-2 border-t border-primary-200 pt-3">
            <Field Label="Урон" class="w-20">
                <input type="number" inputmode="numeric" min="1" class="cm-input cm-input-sm" aria-label="Урон" data-testid="damage" @bind="_damage" />
            </Field>
            <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-heart-crack" data-testid="apply-damage" OnClick="ApplyDamage">Нанести</Button>
            @if (!Context.ReadOnly && NeedsHealing)
            {
                @* Лечение вне боя (T2.3b): отдых по дням или недельная проверка серьёзной раны — окно под тем же корнем.
                   При полных ПЗ и без раны лечить нечего — кнопки нет. *@
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-kit-medical" data-testid="open-recovery"
                        OnClick="() => _recoveryOpen = true">Лечение</Button>
            }
        </div>
        @if (_lastHit is { InstantDeath: true })
        {
            <Alert Tone="Tone.Error" ShowIcon="true" Small="true" class="mt-2 mb-0" Icon="fa-skull">
                Урон одной атаки не меньше максимума ПЗ — <strong>мгновенная смерть</strong>.
            </Alert>
        }
        else if (_lastHit is { MajorWound: true })
        {
            <Alert Tone="Tone.Warning" ShowIcon="true" Small="true" class="mt-2 mb-0">
                <ChildContent>
                    <strong>Серьёзная рана:</strong> сыщик падает. Нужна проверка Выносливости — провал значит потерю сознания (отметка «Без сознания» ниже).@(Sheet.Condition.Dying ? " ПЗ на нуле — при смерти: первая помощь в этом раунде или проверка Выносливости в конце следующего." : "")
                </ChildContent>
                <Actions>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="check-con" OnClick='() => Context.Check("char:CON")'>Проверка Выносливости</Button>
                </Actions>
            </Alert>
        }
        else
        {
            <p class="cm-field-note">
                Серьёзная рана — от @WoundRules.MajorWoundThreshold(derived.MaxHitPoints) урона за одну атаку, смерть — от @Math.Max(1, derived.MaxHitPoints).
            </p>
        }

        @* Колонки отметок — группы, а не половинки списка: слева тело (рана решает, чем обернётся ноль ПЗ), справа
           рассудок. Встают рядом по @container — ширине блока, а не окна (знание v1). Отметки безумия здесь ставятся
           мимо SanityRules и флаг приступа не трогают — приступ ведёт панель рассудка. *@
        <div class="sheet-conditions mt-3 border-t border-primary-200 pt-2">
            <h4 class="text-sm font-semibold text-primary-600">Отметки</h4>
            <div class="sheet-conditions-list">
                <div class="flex flex-col">
                    @ConditionRow("Серьёзная рана", "fa-heart-crack", Sheet.Condition.MajorWound, v => { Sheet.Condition.MajorWound = v; WoundRules.UpdateConsciousness(Sheet); })
                    @ConditionRow("Без сознания", "fa-moon", Sheet.Condition.Unconscious, v => Sheet.Condition.Unconscious = v)
                    @ConditionRow("При смерти", "fa-skull", Sheet.Condition.Dying, v => { Sheet.Condition.Dying = v; if (!v) Sheet.Condition.Stabilized = false; })
                    @ConditionRow("Стабилизирован", "fa-kit-medical", Sheet.Condition.Stabilized, v => Sheet.Condition.Stabilized = v)
                    @ConditionRow("Мёртв", "fa-cross", Sheet.Condition.Dead, v => Sheet.Condition.Dead = v)
                </div>
                <div class="flex flex-col">
                    @ConditionRow("Временное безумие", "fa-brain", Sheet.Condition.TemporaryInsanity, v => Sheet.Condition.TemporaryInsanity = v)
                    @ConditionRow("Бессрочное безумие", "fa-brain", Sheet.Condition.IndefiniteInsanity, v => Sheet.Condition.IndefiniteInsanity = v)
                </div>
            </div>
        </div>
        <WoundRecoveryModal @bind-Open="_recoveryOpen" />
    </div>
</div>

@code {
    private sealed record CurrentRow(string Key, string Label, int Max, Func<int> Get, Action<int> Put, bool Warns);

    private int _damage = 1;
    private DamageOutcome? _lastHit;
    private bool _recoveryOpen;

    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    [Parameter] public EventCallback<StoredFileDto?> OnPortraitChanged { get; set; }

    private CharacterSheet Sheet => Context.Sheet;

    /// <summary>Лечить есть что: ПЗ не полные, есть серьёзная рана или сыщик без сознания / при смерти.</summary>
    private bool NeedsHealing => Sheet.Current.HitPoints < DerivedAttributeRules.Compute(Sheet, Context.Catalog).MaxHitPoints
        || Sheet.Condition.MajorWound || Sheet.Condition.Unconscious || Sheet.Condition.Dying;

    private bool HasOverrides => Sheet.Overrides is { MaxHitPoints: not null } or { MaxMagicPoints: not null } or { MaxSanity: not null }
        or { DamageBonus: not null } or { Build: not null } or { Move: not null };

    private static string CheckKey(Characteristic key) => $"char:{key}";

    private IEnumerable<CurrentRow> Rows(DerivedStats derived) =>
    [
        new("hp", "ПЗ", derived.MaxHitPoints, () => Sheet.Current.HitPoints, v => Sheet.Current.HitPoints = v, true),
        new("mp", "ПМ", derived.MaxMagicPoints, () => Sheet.Current.MagicPoints, v => Sheet.Current.MagicPoints = v, false),
        new("san", "Рассудок", derived.MaxSanity, () => Sheet.Current.Sanity, v => Sheet.Current.Sanity = v, true),
        new("luck", "Удача", derived.MaxLuck, () => Sheet.Current.Luck, v => Sheet.Current.Luck = v, false),
    ];

    private void SetCharacteristic(Characteristic key, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            return;

        Sheet.Characteristics[key] = Math.Clamp(value, 0, 999);
        Recalculate();
    }

    /// <summary>Характеристика или возраст изменились: текущие прижимаются к новым максимумам (правило Core).</summary>
    private void Recalculate()
    {
        DerivedAttributeRules.Normalize(Sheet, Context.Catalog);
        Context.Changed();
    }

    private void Adjust(CurrentRow row, int delta) => Put(row, row.Get() + delta);

    private void Set(CurrentRow row, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
            Put(row, value);
    }

    /// <summary>Не ниже нуля и не выше максимума. Правка ПЗ меняет состояние: 0 ПЗ — без сознания или при смерти.</summary>
    private void Put(CurrentRow row, int value)
    {
        row.Put(Math.Clamp(value, 0, Math.Max(0, row.Max)));
        if (row.Key == "hp")
        {
            if (Sheet.Current.HitPoints > 0)
                _lastHit = null;
            WoundRules.UpdateConsciousness(Sheet);
        }

        Context.Changed();
    }

    private void ApplyDamage()
    {
        if (_damage <= 0)
            return;

        _lastHit = WoundRules.ApplyDamage(Sheet, _damage);
        Context.Changed();
    }

    private static int Percent(CurrentRow row) => StatBar.Percent(row.Get(), row.Max);

    /// <summary>Цвет полосы — одна копия правила с полосами участников сцены (<see cref="StatBar.FillClass"/>).</summary>
    private static string BarClass(CurrentRow row) => StatBar.FillClass(row.Key switch
    {
        "hp" => StatKind.HitPoints,
        "mp" => StatKind.MagicPoints,
        "san" => StatKind.Sanity,
        _ => StatKind.Luck,
    }, Percent(row));

    private RenderFragment ConditionRow(string label, string icon, bool value, Action<bool> set) =>
        @<label class="@Css.Join("sheet-condition", value ? "sheet-condition-on" : null)">
            <input type="checkbox" class="cm-checkbox" checked="@value" @onchange="e => { set(e.Value is true); Context.Changed(); }" />
            @if (value)
            {
                <i class="fa-solid @icon text-xs" aria-hidden="true"></i>
            }
            <span>@label</span>
        </label>;
}
