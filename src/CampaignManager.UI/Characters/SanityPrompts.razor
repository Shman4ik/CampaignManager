@using CampaignManager.Core.Characters

@* Что рассудок требует сделать сейчас: проверка ИНТ после потери от 5 по одной причине, бессрочное безумие за день,
   положенный приступ. Одна разметка для блока «Рассудок» листа и полосы режима «Игра»; считает только SanityRules
   (Status, ResolveIntCheck, SetIndefiniteInsanity, DismissBout). Приступ бросает окно хозяина — OnBout.
   Тревога — одна строка с кнопками (g2 1.6, 1.7): первой — «Проверка ИНТ» (окно проверки; закрытое после броска, оно само
   отмечает исход), два исхода для кубиков со стола — одинаковые, ни один не главный: «безумие» не должно быть умолчанием. *@
@{ var status = SanityRules.Status(Context.Sheet, Context.Catalog); }
@if (status.NeedsIntCheck)
{
    <Alert Tone="Tone.Warning" ShowIcon="true" Small="true" class="@AlertClass" data-testid="int-check-prompt">
        <div class="sheet-alert-row">
            <span class="sheet-alert-text">Потеряно <strong>@status.LastLoss</strong> по одной причине — проверка <strong>ИНТ</strong>.</span>
            <div class="sheet-alert-actions">
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice" data-testid="int-check" OnClick="CheckInt">Проверка ИНТ</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" data-testid="int-success" OnClick="IntSucceededAsync">Успех — безумие</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" data-testid="int-failure" OnClick="IntFailed">Провал — в своём уме</Button>
            </div>
        </div>
    </Alert>
}
@if (status.IndefiniteLoss)
{
    <Alert Tone="Tone.Error" ShowIcon="true" Small="true" class="@AlertClass" data-testid="indefinite-prompt">
        <div class="sheet-alert-row">
            <span class="sheet-alert-text">Потеряно ≥ ⅕ Рассудка за игровой день — <strong>бессрочное безумие</strong>@(Context.Sheet.Condition.IndefiniteInsanity ? ": отмечено." : ".")</span>
            @if (!Context.Sheet.Condition.IndefiniteInsanity)
            {
                <div class="sheet-alert-actions">
                    <Button Small="true" Variant="ButtonVariant.Secondary" data-testid="indefinite-mark" OnClick="MarkIndefiniteAsync">Отметить и бросить приступ</Button>
                </div>
            }
        </div>
    </Alert>
}
@if (status.BoutDue)
{
    <Alert Tone="Tone.Warning" ShowIcon="true" Small="true" class="@AlertClass" data-testid="bout-due">
        <div class="sheet-alert-row">
            <span class="sheet-alert-text">Положен <strong>приступ безумия</strong>.</span>
            <div class="sheet-alert-actions">
                <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => OnBout.InvokeAsync()">Бросить приступ</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" data-testid="bout-dismiss" OnClick="DismissBout">Без броска</Button>
            </div>
        </div>
    </Alert>
}

@code {
    [CascadingParameter] public SheetContext Context { get; set; } = null!;

    /// <summary>Открыть окно приступа хозяина.</summary>
    [Parameter] public EventCallback OnBout { get; set; }

    [Parameter] public string AlertClass { get; set; } = "mt-3 mb-0";

    /// <summary>Окно проверки ИНТ: исход страница отметит сама, когда окно закроют после броска.</summary>
    private void CheckInt()
    {
        Context.IntCheckPending = true;
        Context.Check("char:INT");
    }

    private async Task IntSucceededAsync()
    {
        SanityRules.ResolveIntCheck(Context.Sheet, succeeded: true);
        Context.Changed();
        await OnBout.InvokeAsync();
    }

    private void IntFailed()
    {
        SanityRules.ResolveIntCheck(Context.Sheet, succeeded: false);
        Context.Changed();
    }

    private async Task MarkIndefiniteAsync()
    {
        SanityRules.SetIndefiniteInsanity(Context.Sheet, true);
        Context.Changed();
        await OnBout.InvokeAsync();
    }

    private void DismissBout()
    {
        SanityRules.DismissBout(Context.Sheet);
        Context.Changed();
    }
}
