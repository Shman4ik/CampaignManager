@page "/login"
@using CampaignManager.Contracts.Identity
@using CampaignManager.Core.Identity
@inject NavigationManager Navigation
@inject UiEnvironment Environment

@* Выбор способа входа. Сам вход — на сервере (OIDC через Auth0), сюда клиент и сервер только
   приводят: сервер — с прямой загрузки страницы под [Authorize], клиент — RedirectToLogin. *@
<PageHeader Title="Вход" />

<div class="cm-page">
    @if (AuthStatus == "accessDenied")
    {
        <Alert Tone="Tone.Error" ShowIcon="true" Title="Вход закрыт">
            Почта этой учётки не подтверждена или её нет в списке приглашённых.
        </Alert>
    }
    else if (AuthStatus == "failed")
    {
        <Alert Tone="Tone.Warning" ShowIcon="true">Вход не удался. Попробуйте ещё раз.</Alert>
    }
    else if (AuthStatus == "unavailable")
    {
        <Alert Tone="Tone.Warning" ShowIcon="true">Вход через Auth0 на этом сервере не настроен — доступен только тестовый вход.</Alert>
    }

    @if (SafeReturnUrl != "/" && AuthStatus is null)
    {
        <AuthorizeView>
            <NotAuthorized>
                <Alert Tone="Tone.Info" ShowIcon="true">Войдите, чтобы открыть эту страницу: после входа вы вернётесь на неё.</Alert>
            </NotAuthorized>
        </AuthorizeView>
    }

    <div class="cm-card max-w-lg">
        <AuthorizeView>
            <Authorized>
                <div class="cm-card-body">
                    <p>Вы вошли как <strong>@context.User.Identity?.Name</strong>.</p>
                </div>
                <div class="cm-card-footer">
                    <Button Href="@SafeReturnUrl.TrimStart('/')" Icon="fa-arrow-right">Продолжить</Button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="cm-card-body cm-stack">
                    <div class="flex items-center gap-3">
                        <img src="_content/CampaignManager.UI/logo-mark.svg" alt="" width="40" height="40" />
                        <div>
                            <div class="font-semibold text-primary-800">Campaign Manager</div>
                            <div class="text-sm text-primary-500">Зов Ктулху: кампании, сыщики, сценарии</div>
                        </div>
                    </div>
                    @* Два способа — две кнопки сразу, пояснения мелким текстом под ними (а не абзац перед действием). *@
                    <div class="flex flex-col gap-1">
                        <Button Icon="fa-brands fa-google" class="w-full" OnClick="() => Login(LoginMethods.Google)">Войти через Google</Button>
                        <p class="text-sm text-primary-500">Быстрее всего: в следующий раз вы войдёте автоматически.</p>
                    </div>
                    <div class="flex flex-col gap-1">
                        <Button Variant="ButtonVariant.Secondary" Icon="fa-envelope" class="w-full" OnClick="() => Login(LoginMethods.Email)">Войти по почте и паролю</Button>
                        <p class="text-sm text-primary-500">Только для заранее заведённых учётных записей — их создаёт администратор.</p>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <InfoLinks Class="mt-4" />

    @* Только Development: на сервере вне его адреса /dev/login нет (404), кнопки здесь — лишь подсказка. *@
    @if (Environment.IsDevelopment)
    {
        <div class="cm-card mt-4" data-testid="dev-login">
            <div class="cm-card-body">
                <h2 class="cm-h6 mb-1">Тестовый вход</h2>
                <p class="cm-text-muted">Только в Development, без Auth0: пользователь dev-…@@cm.test с выбранной ролью.</p>
            </div>
            <div class="cm-card-footer">
                @foreach (var (role, label) in DevRoles)
                {
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-user-secret" OnClick="() => DevLogin(role)">Войти как @label</Button>
                }
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = IdentityRoutes.ReturnUrlParameter)]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "authStatus")]
    public string? AuthStatus { get; set; }

    // Сервер всё равно сверит адрес возврата со своим хостом; здесь — только не уйти со страницы входа на неё же.
    private string SafeReturnUrl =>
        string.IsNullOrEmpty(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith(IdentityRoutes.LoginPage)
            ? "/"
            : ReturnUrl;

    private static readonly (UserRole Role, string Label)[] DevRoles =
        [(UserRole.Player, "игрок"), (UserRole.Keeper, "Хранитель"), (UserRole.Admin, "администратор")];

    private void DevLogin(UserRole role) =>
        Navigation.NavigateTo(IdentityRoutes.DevLoginUrl(role.ToString().ToLowerInvariant(), SafeReturnUrl).TrimStart('/'), forceLoad: true);

    // Полная загрузка: вход — серверный адрес, клиентский роутер его не знает.
    private void Login(string method) =>
        Navigation.NavigateTo(IdentityRoutes.LoginUrl(method, SafeReturnUrl).TrimStart('/'), forceLoad: true);
}
