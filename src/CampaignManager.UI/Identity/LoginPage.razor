@page "/login"
@using CampaignManager.Contracts.Identity
@inject NavigationManager Navigation

@* Выбор способа входа. Сам вход — на сервере (OIDC через Auth0), сюда клиент и сервер только
   приводят: сервер — с прямой загрузки страницы под [Authorize], клиент — RedirectToLogin. *@
<PageHeader Title="Вход" />

<div class="cm-page">
    @if (AuthStatus == "accessDenied")
    {
        <Alert Tone="Tone.Error" ShowIcon="true" Title="Вход закрыт">
            Почта этой учётки не подтверждена или её нет в списке приглашённых.
        </Alert>
    }
    else if (AuthStatus == "failed")
    {
        <Alert Tone="Tone.Warning" ShowIcon="true">Вход не удался. Попробуйте ещё раз.</Alert>
    }

    <div class="cm-card">
        <AuthorizeView>
            <Authorized>
                <div class="cm-card-body">
                    <p>Вы вошли как <strong>@context.User.Identity?.Name</strong>.</p>
                </div>
                <div class="cm-card-footer">
                    <Button Href="@SafeReturnUrl.TrimStart('/')" Icon="fa-arrow-right">Продолжить</Button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="cm-card-body">
                    <h2 class="cm-h6 mb-1">Как войти</h2>
                    <p class="cm-text-muted">Через Google — если вы входили так раньше, второй раз это произойдёт само.</p>
                    <p class="cm-text-muted">Учётки с паролем заводит администратор.</p>
                </div>
                <div class="cm-card-footer">
                    <Button Icon="fa-brands fa-google" OnClick="() => Login(LoginMethods.Google)">Войти через Google</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-envelope" OnClick="() => Login(LoginMethods.Email)">Войти по почте и паролю</Button>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = IdentityRoutes.ReturnUrlParameter)]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "authStatus")]
    public string? AuthStatus { get; set; }

    // Сервер всё равно сверит адрес возврата со своим хостом; здесь — только не уйти со страницы входа на неё же.
    private string SafeReturnUrl =>
        string.IsNullOrEmpty(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith(IdentityRoutes.LoginPage)
            ? "/"
            : ReturnUrl;

    // Полная загрузка: вход — серверный адрес, клиентский роутер его не знает.
    private void Login(string method) =>
        Navigation.NavigateTo(IdentityRoutes.LoginUrl(method, SafeReturnUrl).TrimStart('/'), forceLoad: true);
}
