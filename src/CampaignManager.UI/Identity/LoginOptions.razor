@using CampaignManager.Contracts.Identity
@inject NavigationManager Navigation

@* Вход — одна кнопка: способ (Google, passkey, почта и пароль) человек выбирает на странице Auth0,
   приложение её не обходит. Общая у /login и главной гостя: гость входит с главной одним нажатием,
   без промежуточного экрана. Кнопка по своей ширине (не меньше 12rem), а не во всю колонку: плита на 384px
   перевешивала всё остальное. Подсказка — одна строка (правило 2): что Google входит сам и кто заводит
   учётки с паролем, гостю до входа знать незачем. *@
<div class="flex flex-col items-start gap-2" data-testid="login">
    <Button Icon="fa-right-to-bracket" class="min-w-48" OnClick="Login">Войти</Button>
    <p class="text-sm text-primary-600">Через Google, passkey или почту с паролем.</p>
</div>

@code {
    /// <summary>Куда вернуться после входа; сервер всё равно сверит адрес со своим хостом.</summary>
    [Parameter] public string ReturnUrl { get; set; } = "/";

    // Полная загрузка: вход — серверный адрес, клиентский роутер его не знает.
    private void Login() =>
        Navigation.NavigateTo(IdentityRoutes.LoginUrl(ReturnUrl).TrimStart('/'), forceLoad: true);
}
