@inject NavigationManager Navigation

@* Ссылки на статические страницы сервера /about и /legal: подвал листа «Ещё» и страница входа. Адреса — с v1.
   Страницы не часть WebAssembly-приложения, его роутер их не знает: обычный якорь он перехватил бы и показал
   «не найдено», поэтому переход — полной загрузкой. Якорь остаётся якорем (адрес виден, «открыть в новой вкладке»
   работает). *@
<nav class="@Css.Join("flex flex-wrap gap-x-4 gap-y-1 text-sm", Class)" aria-label="О проекте" data-testid="info-links">
    <a href="about" class="underline hover:no-underline" @onclick='() => Go("about")' @onclick:preventDefault>О сайте</a>
    <a href="legal" class="underline hover:no-underline" @onclick='() => Go("legal")' @onclick:preventDefault>Правовая информация</a>
</nav>

@code {
    [Parameter] public string? Class { get; set; }

    private void Go(string address) => Navigation.NavigateTo(address, forceLoad: true);
}
