@using CampaignManager.Contracts.Identity
@inject NavigationManager Navigation

@* Клиентский переход на страницу под [Authorize] без сессии. Прямую загрузку такой страницы
   сервер сам уводит на /login (или сразу в автовход). *@
@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"{IdentityRoutes.LoginPage.TrimStart('/')}?{IdentityRoutes.ReturnUrlParameter}={Uri.EscapeDataString(returnUrl)}",
            replace: true);
    }
}
