@page "/campaigns/{CampaignId:guid}/journal"
@attribute [Authorize]
@using System.Globalization
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.UI.Platform
@inject ICampaignsApi Api
@inject DialogService Dialogs
@inject ToastService Toasts

@* Журнал встреч кампании. Читают участники, пишет Хранитель кампании (и администратор). Заметки
   Хранителя игроку не приходят вовсе — их вырезает сервер, разметка только рисует то, что пришло.
   Нет кампании и нет доступа сервер не различает (404) — страница тоже. *@
<PageHeader Title="@(_journal is null ? "Журнал встреч" : $"Журнал: {_journal.CampaignName}")">
    <Actions>
        <Button Small="true" Variant="ButtonVariant.Ghost" Icon="fa-arrow-left" Href="@($"campaigns/{CampaignId}")">Кампания</Button>
        @if (_journal?.CanEdit == true)
        {
            <Button Small="true" Icon="fa-calendar-plus" OnClick="() => OpenEditor(null)">Новая встреча</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <AsyncContent @ref="_content" Key="CampaignId" Load="LoadAsync" LoadingMessage="Загружаю журнал…" Context="loaded">
        <Empty>
            <EmptyState Icon="fa-book-open" Title="Журнал недоступен."
                        Message="Кампании нет, или вы не Хранитель и не игрок этой кампании.">
                <Actions><Button Href="" Icon="fa-house">На главную</Button></Actions>
            </EmptyState>
        </Empty>
        <ChildContent>
            @{
                var journal = loaded!;
            }
            @if (journal.Sessions.Count == 0)
            {
                @* Кнопка «Новая встреча» одна — в шапке; здесь только строка, без копии кнопки. *@
                <EmptyState Compact="true"
                            Title="@(journal.CanEdit ? "Нет встреч." : "Хранитель ещё не вёл журнал этой кампании.")" />
            }
            else
            {
                <section class="cm-section" aria-label="Встречи">
                    <div class="cm-card">
                        <SectionHeader Title="Встречи" Count="journal.Sessions.Count" />
                        @foreach (var session in journal.Sessions)
                        {
                            var isLatest = session.Id == journal.Sessions[0].Id;
                            var open = _open.Contains(session.Id);
                            var hasMore = IsLong(session.Summary) || !string.IsNullOrWhiteSpace(session.KeeperNotes);
                            <article class="flex flex-col gap-3 border-t border-primary-200 px-4 py-4 first:border-t-0" @key="session.Id"
                                     aria-labelledby="@($"session-{session.Id}")">
                                <div class="flex items-start gap-x-4 gap-y-2">
                                    <div class="min-w-0 flex-1">
                                        <div id="@($"session-{session.Id}")" class="cm-meta">
                                            <span class="font-semibold text-primary-700">Встреча №@session.Number</span>
                                            <time datetime="@session.SessionDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                                @LocalTime.Date(session.SessionDate)
                                            </time>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(session.Title))
                                        {
                                            @* h2, а не h3: «##» в хронике — тоже h2 (уровни задаёт общий Markdown и сдвигать их он не умеет), и h2 под h3 переворачивал бы структуру. *@
                                            <h2 class="cm-h4 cm-title-serif mt-1">@session.Title</h2>
                                        }
                                    </div>
                                    @if (journal.CanEdit)
                                    {
                                        <RowMenu AriaLabel="@($"Действия: встреча №{session.Number}")">
                                            <ChildContent>
                                                <RowMenuItem Icon="fa-pen" OnClick="() => OpenEditor(session)">Изменить</RowMenuItem>
                                            </ChildContent>
                                            <Danger>
                                                <RowMenuItem Icon="fa-trash-can" Danger="true" OnClick="() => DeleteAsync(session)">Удалить</RowMenuItem>
                                            </Danger>
                                        </RowMenu>
                                    }
                                </div>

                                @if (session.ScenarioName is not null || session.ScenarioCompleted)
                                {
                                    <div class="flex flex-wrap items-center gap-2">
                                        @if (session.ScenarioName is not null)
                                        {
                                            @if (journal.CanEdit && session.ScenarioId is { } scenarioId)
                                            {
                                                <a href="@($"scenarios/{scenarioId}")" class="cm-btn cm-btn-secondary cm-btn-sm">
                                                    <i class="fa-solid fa-scroll" aria-hidden="true"></i><span>@session.ScenarioName</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <Badge Tone="Tone.Info" Icon="fa-scroll">@session.ScenarioName</Badge>
                                            }
                                        }
                                        @if (session.ScenarioCompleted)
                                        {
                                            <Badge Tone="Tone.Success" Icon="fa-flag-checkered">Сценарий завершён</Badge>
                                        }
                                    </div>
                                }

                                @* Запись свёрнута до трёх строк, «Читать полностью» раскрывает хронику и заметки: три встречи
                                   не должны быть тремя экранами прокрутки. Заголовки внутри хроники мельче заголовка встречи. *@
                                <Markdown Text="@session.Summary" class="@Css.Join(MarkdownHeadings, "max-w-prose", open ? null : "line-clamp-3")" />

                                @if (open && !string.IsNullOrWhiteSpace(session.KeeperNotes))
                                {
                                    <div class="border-l-4 border-secondary-300 bg-secondary-50 py-2 pr-3 pl-3">
                                        <div class="mb-1 text-sm font-semibold text-secondary-700">
                                            <i class="fa-solid fa-lock mr-1" aria-hidden="true"></i>Заметки Хранителя
                                        </div>
                                        <Markdown Text="@session.KeeperNotes" class="@Css.Join(MarkdownHeadings, "max-w-prose")" />
                                    </div>
                                }

                                @if (hasMore)
                                {
                                    <div>
                                        <button type="button" class="cm-btn cm-btn-ghost cm-btn-sm" aria-expanded="@(open ? "true" : "false")"
                                                data-testid="session-toggle" @onclick="() => Toggle(session.Id)">
                                            <i class="fa-solid @(open ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                                            <span>@(open ? "Свернуть" : "Читать полностью")</span>
                                        </button>
                                    </div>
                                }

                                @* Подсказка о фазе развития — только у последней встречи: когда записана следующая,
                                   момент прошёл. Сама фаза проводится в листе, журнал ничего не считает. *@
                                @if (session.ScenarioCompleted && isLatest)
                                {
                                    <Alert Tone="Tone.Info" Small="true" Icon="fa-graduation-cap" class="mb-0"
                                           Title="Фаза развития сыщиков">
                                        <p>
                                            Откройте лист сыщика и проведите фазу развития: проверки отмеченных навыков,
                                            Рассудок за навыки от 90%, самолечение, Средства. <BookRef Page="92" />
                                        </p>
                                        @if (journal.Investigators.Count > 0)
                                        {
                                            <div class="cm-btn-row mt-2">
                                                @foreach (var investigator in journal.Investigators)
                                                {
                                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-user"
                                                            Href="@($"character/{investigator.CharacterId}")">@InvestigatorLabel(investigator)</Button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="mt-1">В кампании нет активных листов сыщиков.</p>
                                        }
                                    </Alert>
                                }
                            </article>
                        }
                    </div>
                </section>
            }
        </ChildContent>
    </AsyncContent>
</div>

@if (_journal is { CanEdit: true } editable)
{
    <SessionEditorModal Open="_editorOpen" CampaignId="CampaignId" Session="_editing" NextNumber="editable.NextNumber"
                        Runs="editable.Runs" OnClose="() => _editorOpen = false" OnSaved="SavedAsync" />
}

@code {
    [Parameter] public Guid CampaignId { get; set; }

    private AsyncContent<CampaignJournalDto?>? _content;
    private CampaignJournalDto? _journal;
    private bool _editorOpen;
    private CampaignSessionDto? _editing;
    private readonly HashSet<Guid> _open = [];

    /// <summary>Markdown-заголовки хроники мельче заголовка встречи и без книжной гарнитуры: иначе «Что было» спорит с названием.</summary>
    private const string MarkdownHeadings =
        "[&_h1]:font-sans [&_h1]:text-base [&_h1]:font-semibold [&_h2]:font-sans [&_h2]:text-base [&_h2]:font-semibold [&_h3]:font-sans [&_h3]:text-sm [&_h3]:font-semibold";

    /// <summary>
    /// Запись длиннее трёх строк: «Читать полностью» только там, где текст реально обрезан. Строк на экране отсюда не
    /// посчитать, поэтому берём запас — длина или перевод строки (абзац, список), как у других сворачиваемых текстов.
    /// </summary>
    private static bool IsLong(string? summary) =>
        !string.IsNullOrWhiteSpace(summary) && (summary.Length > 180 || summary.AsSpan().Count((char)10) >= 2);

    private void Toggle(Guid id)
    {
        if (!_open.Remove(id))
        {
            _open.Add(id);
        }
    }

    private static string InvestigatorLabel(JournalInvestigator investigator) =>
        investigator.PlayerName is { } player ? $"{investigator.Name} ({player})" : investigator.Name;

    private async Task<CampaignJournalDto?> LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            _journal = await Api.GetJournalAsync(CampaignId, cancellationToken);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _journal = null;
        }

        // Шапка с названием и «Новая встреча» — вне AsyncContent.
        StateHasChanged();
        return _journal;
    }

    private void OpenEditor(CampaignSessionDto? session)
    {
        _editing = session;
        _editorOpen = true;
    }

    private async Task SavedAsync(CampaignSessionDto session)
    {
        _editorOpen = false;
        Toasts.Success($"Встреча №{session.Number} записана.");
        await ReloadAsync();
    }

    private async Task DeleteAsync(CampaignSessionDto session)
    {
        var title = string.IsNullOrWhiteSpace(session.Title) ? $"Встреча №{session.Number}" : $"Встреча №{session.Number}: {session.Title}";
        if (!await Dialogs.ConfirmDeleteAsync("запись журнала", title, "Удалится вместе с хроникой и заметками.", reversible: false))
        {
            return;
        }

        try
        {
            await Api.DeleteSessionAsync(CampaignId, session.Id);
            Toasts.Success("Запись удалена.");
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
        }
    }

    private Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;
}
