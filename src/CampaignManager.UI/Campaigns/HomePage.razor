@page "/"
@attribute [Authorize]
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Identity
@using CampaignManager.Core.Campaigns
@using CampaignManager.UI.Platform
@inject ICampaignsApi Api
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject UiEnvironment Environment

@* Главная — только для вошедших: гостя сервер сразу уводит на страницу входа Auth0 (своей витрины с «Войти» нет,
   v1 к тому же отдавал анониму названия и почты Хранителей). Один GET /api/v1/home: открытые ваншоты, свои кампании (Хранителю — с
   игроками, листами и НПС), доступные для вступления. Почт нет нигде: люди — по имени в кампании.
   Порядок — по важности за столом: свои кампании (там «Открыть лист»), затем открытая запись на ваншоты и «Можно
   вступить». Раскладка (решение оркестратора, H2): слева «Ваши кампании», справа с lg (aside, 1:2) — «Ваншоты — открыта
   запись» и «Можно вступить»; без них кампании идут во всю колонку в две колонки потоком. Завершённые кампании —
   строки в одной карточке под активными. Вступление («Вступить») — сразу, с именем профиля, без окна: имя в кампании
   меняется потом в «⋯ → Имя в кампании» (JN2). *@
<PageHeader Title="Главная" />

<div class="cm-page">
    <AuthorizeView>
        <Authorized>
            <AsyncContent @ref="_home" Load="Api.GetHomeAsync" LoadingMessage="Загружаю кампании…" Context="home">
                @{
                    var current = home.Mine.Where(c => !HomeCampaignCard.IsCompleted(c)).ToList();
                    var finished = home.Mine.Where(HomeCampaignCard.IsCompleted).ToList();
                    var hasAside = home.OneShots.Count > 0 || home.Available.Count > 0;
                }
                <div class="@Css.Join("grid items-start gap-x-7", hasAside ? "lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]" : null)">
                <div class="min-w-0">
                <section class="cm-section" aria-labelledby="home-mine">
                    <div class="cm-section-header">
                        <h2 id="home-mine" class="cm-section-title">Ваши кампании</h2>
                        <AuthorizeView Policy="@Policies.Keeper" Context="keeper">
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" OnClick="() => _creating = true">Новая кампания</Button>
                        </AuthorizeView>
                    </div>
                    @if (home.Mine.Count == 0)
                    {
                        <EmptyState Icon="fa-map" Title="Вы пока ни в одной кампании."
                                    Message="@(home.Available.Count > 0 || home.OneShots.Count > 0 ? "Вступите в кампанию — Хранитель увидит вас среди игроков." : "Когда Хранитель заведёт кампанию, она появится здесь.")" />
                    }
                    else
                    {
                        @if (current.Count > 0)
                        {
                            @* Колонки потоком, а не сетка: карточки разной высоты ложатся без пустот под короткими и не тянутся на высоту
                               соседа. С правой колонкой (aside) кампании — одним столбцом: ширины в 2/3 колонки на две карточки не хватает. *@
                            <div class="@Css.Join("[&>article]:mb-3 [&>article]:break-inside-avoid", hasAside ? null : "lg:columns-2 lg:gap-3")">
                                @foreach (var campaign in current)
                                {
                                    <HomeCampaignCard Campaign="campaign" @key="campaign.Id" />
                                }
                            </div>
                        }

                        @if (finished.Count > 0)
                        {
                            <div class="@Css.Join("cm-section-header", current.Count > 0 ? "mt-6" : null)">
                                <h3 class="cm-section-title">Завершённые · @finished.Count</h3>
                            </div>
                            <div class="cm-card">
                                @foreach (var campaign in finished)
                                {
                                    <HomeCampaignCard Campaign="campaign" @key="campaign.Id" />
                                }
                            </div>
                        }
                    }
                </section>
                </div>

                @if (hasAside)
                {
                <aside class="min-w-0" aria-label="Куда можно вступить">
                @if (home.OneShots.Count > 0)
                {
                    <section class="cm-section" aria-labelledby="home-oneshots">
                        <div class="cm-section-header"><h2 id="home-oneshots" class="cm-section-title">Ваншоты — открыта запись</h2></div>
                        <div class="grid grid-cols-1 items-start gap-3">
                            @foreach (var run in home.OneShots)
                            {
                                <OneShotCard Run="run" StartCollapsed="true" OnChanged="ReloadAsync" @key="run.RunId" />
                            }
                        </div>
                    </section>
                }

                @if (home.Available.Count > 0)
                {
                    <section class="cm-section" aria-labelledby="home-available">
                        <div class="cm-section-header"><h2 id="home-available" class="cm-section-title">Можно вступить</h2></div>
                        <div class="grid grid-cols-1 items-start gap-3">
                            @foreach (var campaign in home.Available)
                            {
                                <div class="cm-card flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3" @key="campaign.Id">
                                    <div class="min-w-0 flex-1 basis-32">
                                        @* Те же правила шапки, что у «Ваших кампаний»: название, под ним бейджи, потом сведения. *@
                                        <div class="font-semibold text-primary-800">@campaign.Name</div>
                                        <div class="mt-1 flex flex-wrap items-center gap-1.5">
                                            @if (campaign.Kind == CampaignKind.OneShot)
                                            {
                                                <Badge Tone="Tone.Neutral">Ваншот</Badge>
                                            }
                                            <Badge Tone="CampaignLabels.StatusTone(campaign.Status)">@CampaignLabels.Status(campaign.Status)</Badge>
                                        </div>
                                        @if (campaign.KeeperName is { } keeperName)
                                        {
                                            <div class="cm-meta mt-1"><span><span class="cm-meta-label">Хранитель:</span> @keeperName</span></div>
                                        }
                                    </div>
                                    <Button Small="true" Icon="fa-right-to-bracket" Busy="@(_joiningId == campaign.Id)" Disabled="@(_joiningId is not null)"
                                            data-testid="join" OnClick="() => JoinAsync(campaign)">Вступить</Button>
                                </div>
                            }
                        </div>
                    </section>
                }
                </aside>
                }
                </div>
            </AsyncContent>

            <CampaignFormModal Open="_creating" OnClose="() => _creating = false" OnSaved="CreatedAsync" />
        </Authorized>
    </AuthorizeView>

    @if (Environment.IsDevelopment)
    {
        <section class="cm-section">
            <div class="cm-section-header"><h2 class="cm-section-title">Разработка</h2></div>
            <div class="flex flex-wrap gap-2">
                <Button Href="dev/ping" Small="true" Variant="ButtonVariant.Secondary" Icon="fa-heart-pulse">Проверка связи</Button>
                <Button Href="dev/files" Small="true" Variant="ButtonVariant.Secondary" Icon="fa-file-arrow-up">Проверка файлов</Button>
                <Button Href="dev/ui" Small="true" Variant="ButtonVariant.Secondary" Icon="fa-swatchbook">UI-кит</Button>
                <Button Href="dev/checks" Small="true" Variant="ButtonVariant.Secondary" Icon="fa-dice-d20">Проверки</Button>
            </div>
        </section>
    }
</div>

@code {
    private AsyncContent<HomeDto>? _home;
    private Guid? _joiningId;
    private bool _creating;

    /// <summary>Вступить сразу, с именем профиля (пустой псевдоним): имя в этой кампании меняется потом в «⋯ → Имя в кампании».</summary>
    private async Task JoinAsync(HomeAvailableCampaignDto campaign)
    {
        _joiningId = campaign.Id;
        try
        {
            await Api.JoinAsync(campaign.Id, new JoinCampaignRequest(""));
            Toasts.Success("Вы в кампании:", subject: campaign.Name);
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось вступить");
        }
        finally
        {
            _joiningId = null;
        }
    }

    private void CreatedAsync(CampaignSummaryDto campaign)
    {
        _creating = false;
        Toasts.Success("Кампания создана:", subject: campaign.Name);
        Navigation.NavigateTo($"campaigns/{campaign.Id}");
    }

    private Task ReloadAsync() => _home?.ReloadAsync() ?? Task.CompletedTask;
}
