@page "/join/{CampaignId:guid}"
@attribute [Authorize]
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.UI.Platform
@inject ICampaignsApi Api
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Ссылка-приглашение («Пригласить» на странице кампании). Вошедшему показывает, куда его зовут, и даёт вступить;
   участнику сразу открывает кампанию. Не вошедшего приложение отправит на вход и вернёт сюда. Кампании нет или она
   завершена — 404 сервера: «приглашение недействительно». Вступление — тот же JoinAsync, что и на главной, и тоже сразу, с
   именем профиля (одно касание вместо двух; имя в кампании меняется потом в «⋯ → Имя в кампании», JN2). Название кампании — только
   в карточке, шапка просто «Приглашение» (JN1: длинное название стояло и в шапке, и в карточке, и в заголовке окна). *@
<PageHeader Title="Приглашение" />

<div class="cm-page">
        <AsyncContent Key="CampaignId" Load="LoadAsync" LoadingMessage="Открываю приглашение…" Context="invite" ErrorTitle="Приглашение недоступно">
            <Empty>
                @* Одна строка и кнопка: заголовок страницы уже говорит «Приглашение», второй заголовок и абзац об одном — лишние. *@
                <Alert Tone="Tone.Warning" ShowIcon="true" Actions="@HomeAction" data-testid="invite-invalid">
                    Приглашение недействительно: кампании нет или она уже завершена. Попросите Хранителя прислать новую ссылку.
                </Alert>
            </Empty>
            <ChildContent>
                <section class="cm-section max-w-xl" aria-label="Приглашение">
                    <div class="cm-card">
                        <div class="cm-card-body flex flex-col gap-3">
                            <div>
                                <h2 class="cm-card-title" data-testid="invite-name">@invite!.Name</h2>
                                <p class="text-sm text-primary-500">
                                    @CampaignLabels.Kind(invite.Kind) · @CampaignLabels.Status(invite.Status)
                                </p>
                            </div>
                            <div class="cm-meta">
                                @if (invite.KeeperName is { } keeper)
                                {
                                    <span><span class="cm-meta-label">Хранитель:</span> @keeper</span>
                                }
                                <span><span class="cm-meta-label">Игроков:</span> @invite.PlayerCount</span>
                            </div>
                            <p class="text-sm text-primary-600">Вас пригласили в эту кампанию. Вступив, вы увидите журнал и сможете завести сыщика.</p>
                            @if (_error is not null)
                            {
                                <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0">@_error</Alert>
                            }
                            <div class="cm-btn-row">
                                <Button Icon="fa-right-to-bracket" Busy="_busy" OnClick="JoinAsync">Вступить</Button>
                                <Button Variant="ButtonVariant.Secondary" Href="">Не сейчас</Button>
                            </div>
                        </div>
                    </div>
                </section>
            </ChildContent>
        </AsyncContent>
</div>

@code {
    [Parameter] public Guid CampaignId { get; set; }

    private CampaignInviteDto? _invite;

    private RenderFragment HomeAction => @<Button Href="" Variant="ButtonVariant.Secondary" Icon="fa-house" Small="true">На главную</Button>;

    private bool _busy;
    private string? _error;

    /// <summary>
    /// Участнику страница не нужна — уходим в кампанию. Закрытая (404) приглашением не является — пустое место, не ошибка.
    /// Вступить нельзя, хотя кампания видна (CanJoin = false без членства) — бывает только у завершённой, её сервер не отдаёт.
    /// </summary>
    private async Task<CampaignInviteDto?> LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            var invite = await Api.GetInviteAsync(CampaignId, cancellationToken);
            if (invite.IsMember)
            {
                Navigation.NavigateTo($"campaigns/{CampaignId}", replace: true);
                return null;
            }

            _invite = invite;
            return invite;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            return null;
        }
    }

    private async Task JoinAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Пустой псевдоним — участник идёт за именем профиля.
            await Api.JoinAsync(CampaignId, new JoinCampaignRequest(""));
            Toasts.Success("Вы в кампании:", subject: _invite?.Name);
            Navigation.NavigateTo($"campaigns/{CampaignId}");
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
