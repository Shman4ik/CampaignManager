@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Scenarios
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Characters.Creation
@using CampaignManager.UI.Platform
@inject IRunsApi Runs
@inject ICampaignsApi Campaigns
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Анонс разовой игры с открытой записью — приглашение игроку, поэтому во всю колонку главной (владелец 2026-10-04): слева
   анонс (дата, Хранитель, текст), справа с lg — готовые сыщики сразу, без кнопки-раскрытия, и «Создать своего сыщика».
   Заголовок — название игры, под которым её объявил Хранитель (кампания), а не сценария: так же она зовётся в «Ваших кампаниях».
   Запись на место (T2.5c; в коде и API — бронь): «Занять» у свободного сыщика, пока можно (CanReserve), — вторичной кнопкой:
   тёмная кнопка в каждой строке давала до четырёх primary на экране (H5). У своего — «Лист» и «Снять запись»; ведущий
   снимает любую (CanRelease). Флаги — с сервера, решает он же. «Создать своего сыщика» вступает в кампанию игры (если ещё не
   участник) и открывает помощник; черновик помощника — тот же, что у «Создать сыщика» в карточке кампании. *@
<article class="cm-card" aria-labelledby="@($"run-{Run.RunId}")" data-testid="one-shot">
    <div class="cm-card-header">
        <h3 id="@($"run-{Run.RunId}")" class="cm-card-title min-w-0 flex-1 basis-48">@Run.CampaignName</h3>
        @if (Run.IsMine)
        {
            <Badge Tone="Tone.Info" Icon="fa-book-skull">Вы ведёте</Badge>
        }
    </div>
    <div class="cm-card-body grid items-start gap-x-8 gap-y-5 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div class="min-w-0 max-w-prose">
            <div class="cm-meta">
                @if (Run.ScheduledAt is { } when)
                {
                    <span><i class="fa-regular fa-calendar mr-1" aria-hidden="true"></i>@LocalTime.DateTime(when)</span>
                }
                else
                {
                    <span>Дата ещё не назначена</span>
                }
                @if (!Run.IsMine && Run.KeeperName is { } keeperName)
                {
                    <span><span class="cm-meta-label">Хранитель:</span> @keeperName</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Run.Announcement))
            {
                @* Анонс целиком с md; на телефоне — четыре строки и «Подробнее», иначе текст уводит готовых сыщиков и «Занять» за сгиб
                   (вложенной прокрутки нет: на тач-экране она ловила жест страницы). *@
                <div class="mt-2">
                    <Markdown Text="@Run.Announcement" class="@AnnouncementClass" />
                    <button type="button" class="cm-link-btn md:hidden"
                            aria-expanded="@(_announcementOpen ? "true" : "false")"
                            data-testid="announcement-toggle" @onclick="() => _announcementOpen = !_announcementOpen">
                        @(_announcementOpen ? "Свернуть описание" : "Подробнее")
                        <i class="fa-solid @(_announcementOpen ? "fa-chevron-up" : "fa-chevron-down") text-xs" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>

        @* В портрете колонка одна — список той же ширины, что текст: «Занять» не уезжает от имени на другой край карточки. *@
        <div class="min-w-0 max-w-prose">
            <h4 class="mb-1 text-sm font-semibold text-primary-800">
                Готовые сыщики
                @if (Run.Pregens.Count > 0)
                {
                    <span class="font-normal text-primary-600">· свободно @Run.Pregens.Count(p => !p.IsReserved) из @Run.Pregens.Count</span>
                }
            </h4>
            @if (Run.Pregens.Count == 0)
            {
                <p class="cm-text-muted">Хранитель ещё не добавил готовых сыщиков.</p>
            }
            else
            {
                <ul>
                    @foreach (var pregen in Run.Pregens)
                    {
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-primary-200 py-2 first:border-t-0" @key="pregen.Id">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-100 font-semibold text-primary-600"
                                  aria-hidden="true">@Initial(pregen.Name)</span>
                            <span class="min-w-0 flex-1 basis-32">
                                <span class="block truncate font-semibold text-primary-800">@pregen.Name</span>
                                @if (pregen.Occupation is not null)
                                {
                                    <span class="block truncate text-sm text-primary-500">@pregen.Occupation</span>
                                }
                            </span>
                            @if (pregen.IsMine)
                            {
                                <Badge Tone="Tone.Success">Ваш</Badge>
                            }
                            else if (pregen.IsReserved)
                            {
                                <Badge Tone="Tone.Neutral" class="max-w-full whitespace-normal">Занят@(pregen.ReservedBy is { } by ? $": {by}" : "")</Badge>
                            }
                            else if (!Run.CanReserve)
                            {
                                <Badge Tone="Tone.Info">Свободен</Badge>
                            }
                            <span class="ml-auto flex flex-wrap justify-end gap-2">
                                @if (pregen.MyCharacterId is { } sheet)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-id-card" Href="@($"character/{sheet}")">Лист</Button>
                                }
                                @if (!pregen.IsReserved && Run.CanReserve)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-hand" Busy="@(_busy == pregen.Id)" Disabled="@(_busy is not null)"
                                            data-testid="reserve" OnClick="() => ReserveAsync(pregen)">Занять</Button>
                                }
                                @if (pregen.CanRelease)
                                {
                                    <ReleaseReservationButton RunId="Run.RunId" Pregen="pregen" OnChanged="OnChanged" />
                                }
                            </span>
                        </li>
                    }
                </ul>
            }

            @if (Run.CanReserve)
            {
                <div class="mt-2 border-t border-primary-200 pt-3">
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-wand-magic-sparkles" Busy="_creating" Disabled="@(_busy is not null || _creating)"
                            data-testid="create-own" OnClick="CreateOwnAsync">Создать своего сыщика</Button>
                </div>
            }
        </div>
    </div>
</article>

@code {
    private Guid? _busy;
    private bool _creating;
    private bool _announcementOpen;

    [Parameter, EditorRequired] public HomeOneShotDto Run { get; set; } = null!;

    /// <summary>Бронь взята или снята — главной перечитать себя (игра появится среди моих кампаний).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Я уже участник кампании этой игры: «Создать своего сыщика» сразу открывает помощник, без вступления.</summary>
    [Parameter] public bool IsMember { get; set; }

    private string? AnnouncementClass => _announcementOpen ? null : "max-md:line-clamp-4";

    private async Task ReserveAsync(HomePregenDto pregen)
    {
        _busy = pregen.Id;
        try
        {
            await Runs.ReserveAsync(Run.RunId, pregen.Id);
            Toasts.Success("Вы заняли:", subject: pregen.Name);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = null;
        }
    }

    /// <summary>Свой сыщик вместо готового: вступить с именем профиля (как «Вступить», JN2) и открыть помощник этой кампании.</summary>
    private async Task CreateOwnAsync()
    {
        _creating = true;
        try
        {
            if (!IsMember)
            {
                await Campaigns.JoinAsync(Run.CampaignId, new JoinCampaignRequest(""));
            }

            Navigation.NavigateTo(CreationLinks.Wizard(CharacterKind.Player, Run.CampaignId, null));
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось вступить");
            _creating = false;
        }
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
