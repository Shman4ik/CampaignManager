@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Scenarios
@using CampaignManager.UI.Platform
@inject IRunsApi Runs
@inject DialogService Dialogs
@inject ToastService Toasts

@* Прохождение с открытой записью: сценарий, дата, Хранитель, анонс и готовые сыщики — кто какого занял.
   Запись на место (T2.5c; в коде и API — бронь): «Занять» у свободного сыщика, пока у меня нет места в этой игре и я её не
   веду (CanReserve), — вторичной кнопкой: тёмная кнопка в каждой строке давала до четырёх primary на экране, главная
   здесь одна — «Вступить» (H5). У своего — «Лист» (копия сыщика у меня в кампании) и «Снять запись»; ведущий снимает любую
   (CanRelease). Флаги — с сервера, решает он же. Анонс сжат до трёх строк («Подробнее»), сыщики — за кнопкой «Выбрать сыщика»
   (StartCollapsed). *@
<article class="cm-card flex flex-col" aria-labelledby="@($"run-{Run.RunId}")">
    <div class="cm-card-header">
        <h3 id="@($"run-{Run.RunId}")" class="cm-card-title min-w-0 flex-1 basis-48">@Run.ScenarioName</h3>
        @if (Run.IsMine)
        {
            <Badge Tone="Tone.Info" Icon="fa-book-skull">Вы ведёте</Badge>
        }
    </div>
    <div class="cm-card-body cm-stack flex-1">
        <div>
            <div class="cm-meta">
                @if (Run.ScheduledAt is { } when)
                {
                    <span><i class="fa-regular fa-calendar mr-1" aria-hidden="true"></i>@LocalTime.DateTime(when)</span>
                }
                else
                {
                    <span>Дата ещё не назначена</span>
                }
                @if (!Run.IsMine && Run.KeeperName is { } keeperName)
                {
                    <span><span class="cm-meta-label">Хранитель:</span> @keeperName</span>
                }
                <span>Свободно @Run.Pregens.Count(p => !p.IsReserved) из @Run.Pregens.Count</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Run.Announcement))
            {
                @* Анонс сжат до трёх строк: вложенной прокрутки нет (на тач-экране она ловила жест страницы). *@
                <div class="mt-2">
                    <Markdown Text="@Run.Announcement" class="@(_announcementOpen ? null : "line-clamp-3")" />
                    <button type="button" class="cm-link-btn" aria-expanded="@(_announcementOpen ? "true" : "false")"
                            data-testid="announcement-toggle" @onclick="() => _announcementOpen = !_announcementOpen">
                        @(_announcementOpen ? "Свернуть описание" : "Подробнее")
                        <i class="fa-solid @(_announcementOpen ? "fa-chevron-up" : "fa-chevron-down") text-xs" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>

        @if (_collapsed)
        {
            <div>
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-users" data-testid="pregens-open"
                        OnClick="() => _collapsed = false">Выбрать сыщика</Button>
            </div>
        }
        else
        {
        <div>
            <h4 class="mb-1 text-sm font-semibold text-primary-800">Готовые сыщики</h4>
            @if (Run.Pregens.Count == 0)
            {
                <p class="cm-text-muted">Хранитель ещё не добавил готовых сыщиков.</p>
            }
            else
            {
                <ul>
                    @foreach (var pregen in Run.Pregens)
                    {
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-primary-200 py-2 first:border-t-0" @key="pregen.Id">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-100 font-semibold text-primary-600"
                                  aria-hidden="true">@Initial(pregen.Name)</span>
                            <span class="min-w-0 flex-1 basis-32">
                                <span class="block truncate font-semibold text-primary-800">@pregen.Name</span>
                                @if (pregen.Occupation is not null)
                                {
                                    <span class="block truncate text-sm text-primary-500">@pregen.Occupation</span>
                                }
                            </span>
                            @if (pregen.IsMine)
                            {
                                <Badge Tone="Tone.Success">Ваш</Badge>
                            }
                            else if (pregen.IsReserved)
                            {
                                <Badge Tone="Tone.Neutral" class="max-w-full whitespace-normal">Занят@(pregen.ReservedBy is { } by ? $": {by}" : "")</Badge>
                            }
                            else if (!Run.CanReserve)
                            {
                                <Badge Tone="Tone.Info">Свободен</Badge>
                            }
                            <span class="ml-auto flex flex-wrap justify-end gap-2">
                                @if (pregen.MyCharacterId is { } sheet)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-id-card" Href="@($"character/{sheet}")">Лист</Button>
                                }
                                @if (!pregen.IsReserved && Run.CanReserve)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-hand" Busy="@(_busy == pregen.Id)" Disabled="@(_busy is not null)"
                                            data-testid="reserve" OnClick="() => ReserveAsync(pregen)">Занять</Button>
                                }
                                @if (pregen.CanRelease)
                                {
                                    <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-user-xmark" Busy="@(_busy == pregen.Id)"
                                            Disabled="@(_busy is not null)" data-testid="release" OnClick="() => ReleaseAsync(pregen)">Снять запись</Button>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>
        }
    </div>
</article>

@code {
    private Guid? _busy;
    private bool _collapsed;
    private bool _announcementOpen;

    [Parameter, EditorRequired] public HomeOneShotDto Run { get; set; } = null!;

    /// <summary>Бронь взята или снята — главной перечитать себя (ваншот появится среди моих кампаний).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>На главной карточка сложена до строки с кнопкой «Выбрать сыщика»: объявление не вытесняет «Открыть лист».</summary>
    [Parameter] public bool StartCollapsed { get; set; }

    protected override void OnInitialized() => _collapsed = StartCollapsed;

    private async Task ReserveAsync(HomePregenDto pregen)
    {
        _busy = pregen.Id;
        try
        {
            await Runs.ReserveAsync(Run.RunId, pregen.Id);
            Toasts.Success("Вы заняли:", subject: pregen.Name);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task ReleaseAsync(HomePregenDto pregen)
    {
        var whose = pregen.IsMine ? "Ваша копия листа" : $"Копия листа у игрока{(pregen.ReservedBy is { } by ? $" {by}" : "")}";
        if (!await Dialogs.ConfirmAsync(new ConfirmRequest("Снять запись?",
                $"Готовый сыщик снова свободен. {whose} уйдёт в архив.")
            {
                Subject = pregen.Name,
                ConfirmText = "Снять запись",
                Details = null,
            }))
        {
            return;
        }

        _busy = pregen.Id;
        try
        {
            await Runs.ReleaseAsync(Run.RunId, pregen.Id);
            Toasts.Success("Запись снята:", subject: pregen.Name);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex));
        }
        finally
        {
            _busy = null;
        }
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
}
