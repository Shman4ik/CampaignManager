@using CampaignManager.Contracts.Characters
@using CampaignManager.UI.Characters.Creation
@using CampaignManager.UI.Platform
@inject TimeProvider Time

@* Хранителю — что игрок создаёт сыщика в помощнике и где остановился: «Создаёт сыщика: шаг 4 из 7 — Навыки · 2 часа назад».
   Черновик лежит на сервере (character_drafts), строка — без документа, из главной и страницы кампании. *@
<div class="flex items-start gap-1.5 text-sm text-primary-600" data-testid="draft-progress">
    <i class="fa-solid fa-wand-magic-sparkles mt-0.5 text-xs" aria-hidden="true"></i>
    <span>Создаёт сыщика: @CreationLinks.StepText(Draft.Step) · @LocalTime.Ago(Draft.UpdatedAt, Time.GetUtcNow())</span>
</div>

@code {
    [Parameter, EditorRequired] public CharacterDraftSummaryDto Draft { get; set; } = null!;
}
