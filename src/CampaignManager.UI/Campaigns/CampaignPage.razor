@page "/campaigns/{CampaignId:guid}"
@attribute [Authorize]
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Core.Campaigns
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Platform
@using CampaignManager.UI.Scenarios
@inject ICampaignsApi Api
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Кампания и её участники. В v1 этого адреса не было, хотя на него вели ссылки из сценария и помощника
   создания (AUDIT, «Битая ссылка»). Здесь — имя в кампании (псевдоним), выход игрока, исключение
   игрока Хранителем. Кнопки — по флагам из API; права решает сервер. *@
@* Название в шапке переносится до двух строк (WrapTitle), а не обрезается и не повторяется вторым заголовком в теле (P4). *@
<PageHeader Title="@(_details?.Campaign.Name ?? "Кампания")" Subtitle="@Subtitle" Game="true" WrapTitle="true"
            DocumentTitle="@(_details is null ? "Кампания" : $"Кампания: {_details.Campaign.Name}")">
    <Actions>
        @* Главное действие одно: пустой кампании — позвать игроков («Пригласить»), идущей игре — «Играть» в строке прохождения;
           журнал — главное, когда ни того ни другого нет. Это чтение: значок книги, перо — только у «Новая встреча». *@
        <Button Small="true" Variant="@(JournalIsMain ? ButtonVariant.Primary : ButtonVariant.Secondary)" Icon="fa-book-open" Href="@($"campaigns/{CampaignId}/journal")">Журнал</Button>
        @if (_details is { Campaign: { CanEdit: true, Status: not CampaignStatus.Completed } })
        {
            <Button Small="true" Variant="@(NeedsPlayers ? ButtonVariant.Primary : ButtonVariant.Secondary)" Icon="fa-user-plus" OnClick="() => _inviting = true">Пригласить</Button>
        }
        @if (_details?.Campaign.CanEdit == true)
        {
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-pen" OnClick="() => _formOpen = true">Изменить</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <AsyncContent @ref="_content" Key="CampaignId" Load="LoadAsync" LoadingMessage="Загружаю кампанию…" Context="loaded"
                  ErrorTitle="Кампания недоступна">
        <Empty>
            <EmptyState Icon="fa-map" Title="Кампания не найдена."
                        Message="Её удалили, или вы в ней не состоите. Вступить можно с главной.">
                <Actions><Button Href="" Icon="fa-house">На главную</Button></Actions>
            </EmptyState>
        </Empty>
        <ChildContent>
        @{
            var details = loaded!;
            var campaign = details.Campaign;
            var active = campaign.Status != CampaignStatus.Completed;
        }
        @* Название, статус и роль — в шапке; ни строки «Вид · Эпоха» (эпоху по п. 12 не показываем), ни пересказа приглашения
           Alert-ом (кнопка «Пригласить» в шапке и так главная) тут нет — P4, P6. *@

        @* Игроку страница — это «что было в прошлый раз»: карточка последней встречи над списком, а не строка мелким серым внизу
           (P7, решение оркестратора, вариант A). *@
        @if (!campaign.CanEdit && details.LastSession is { } lastForPlayer)
        {
            <section class="cm-section max-w-3xl" aria-labelledby="last-session-title" data-testid="last-session">
                <div class="cm-section-header"><h2 id="last-session-title" class="cm-section-title">Последняя встреча</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body flex flex-col gap-2">
                        <div class="cm-meta">
                            <span class="font-semibold text-primary-700">Встреча №@lastForPlayer.Number</span>
                            <span>@LocalTime.Date(lastForPlayer.SessionDate)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(lastForPlayer.Title))
                        {
                            <h3 class="cm-title-serif text-lg">@lastForPlayer.Title</h3>
                        }
                        @if (lastForPlayer.Excerpt is { } excerpt)
                        {
                            <p class="max-w-prose text-primary-700">@excerpt</p>
                        }
                        <div>
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-book-open" Href="@($"campaigns/{CampaignId}/journal")">Читать журнал</Button>
                        </div>
                    </div>
                </div>
            </section>
        }

        @* Ландшафт: участники слева, прохождения и НПС — колонкой справа (3:2: в 1:3 «Добавить НПС» не влезало в строку заголовка, P5). Во всю колонку строка участника
           держала «⋯» в ~1000px от имени, а короткие секции пустовали. Игроку правой колонки нет — список по содержимому. *@
        <div class="@(campaign.CanEdit ? "grid items-start gap-x-7 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]" : "max-w-3xl")">
            <div class="min-w-0">
                <section class="cm-section" aria-label="Участники">
                    <div class="cm-card">
                        <SectionHeader Title="Участники" Count="details.Members.Count" />
                        @foreach (var member in details.Members)
                        {
                            <div class="flex items-center gap-3 border-t border-primary-200 px-4 py-3 first:border-t-0" @key="member.UserId">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="font-semibold text-primary-800">@CampaignLabels.Person(member.Name)</span>
                                        @if (member.Role == CampaignRole.Keeper)
                                        {
                                            <Badge Tone="Tone.Info" Icon="fa-book-skull">Хранитель</Badge>
                                        }
                                        @if (member.IsMe)
                                        {
                                            <Badge Tone="Tone.Neutral">Вы</Badge>
                                        }
                                    </div>
                                    @* Сыщики игрока: Хранителю — все листы, игроку — его активный. У Хранителя листов нет. *@
                                    @if (member.Role == CampaignRole.Player)
                                    {
                                        @if (member.Characters.Count > 0)
                                        {
                                            <div class="mt-2 flex flex-wrap gap-2">
                                                @foreach (var character in member.Characters)
                                                {
                                                    <CharacterChip Character="character" @key="character.Id" />
                                                }
                                            </div>
                                        }
                                        @if (member.Draft is { } draft)
                                        {
                                            @* Черновик помощника: Хранителю — где игрок остановился, самому игроку — продолжить. *@
                                            @if (member.IsMe && member.Characters.Count == 0)
                                            {
                                                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-wand-magic-sparkles" class="mt-2"
                                                        Href="@CreationLinks.Wizard(CharacterKind.Player, CampaignId, null)" data-testid="continue-draft">
                                                    Продолжить создание (шаг @(Math.Clamp(draft.Step, 0, CreationLinks.StepCount - 1) + 1) из @CreationLinks.StepCount)
                                                </Button>
                                            }
                                            else if (!member.IsMe)
                                            {
                                                <div class="mt-1"><DraftProgress Draft="draft" /></div>
                                            }
                                        }
                                        else if (member.Characters.Count == 0 && (campaign.CanEdit || member.IsMe))
                                        {
                                            <div class="mt-1 text-sm text-primary-500">Листа пока нет</div>
                                        }
                                    }
                                </div>
                                @{
                                    var canRemove = member.CanRemove && !member.IsMe && active;
                                }
                                @if (member.CanRename || canRemove)
                                {
                                    <RowMenu AriaLabel="@($"Действия: {CampaignLabels.Person(member.Name)}")">
                                        <ChildContent>
                                            @if (member.CanRename)
                                            {
                                                <RowMenuItem Icon="fa-signature" OnClick="() => StartRename(member)">Имя в кампании</RowMenuItem>
                                            }
                                        </ChildContent>
                                        <Danger>
                                            @if (canRemove)
                                            {
                                                <RowMenuItem Icon="fa-user-minus" Danger="true" OnClick="() => RemoveAsync(member)">Исключить</RowMenuItem>
                                            }
                                        </Danger>
                                    </RowMenu>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>

            @if (campaign.CanEdit)
            {
                <div class="min-w-0">
                    @* Завершённой кампании без игр секция ничего не скажет — не рисуем (правило 4). *@
                    @if (active || details.Runs.Count > 0)
                    {
                        <section class="cm-section" aria-label="Прохождения">
                            <div class="cm-card">
                                <SectionHeader Title="Прохождения" Count="details.Runs.Count">
                                    <Actions>
                                        @if (active)
                                        {
                                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-scroll" Href="@ScenarioLinks.List">К сценариям</Button>
                                        }
                                    </Actions>
                                </SectionHeader>
                                @if (details.Runs.Count == 0 && active)
                                {
                                    <p class="cm-empty-compact border-t border-primary-200 px-4 py-3 first:border-t-0">Нет прохождений.</p>
                                }
                                @foreach (var run in details.Runs)
                                {
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-primary-200 px-4 py-3 first:border-t-0"
                                         @key="run.RunId" data-testid="campaign-run">
                                        <div class="min-w-0 flex-1 basis-56">
                                            <a href="@ScenarioLinks.Workspace(run.ScenarioId)" class="inline-flex min-h-11 items-center font-semibold text-primary-800 hover:underline">@run.ScenarioName</a>
                                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-primary-500">
                                                <Badge Tone="ScenarioLabels.RunTone(run.Status)">@ScenarioLabels.RunStatus(run.Status)</Badge>
                                                @if (run.SignupOpen && run.Status != ScenarioRunStatus.Finished)
                                                {
                                                    <Badge Tone="Tone.Info">Запись открыта</Badge>
                                                }
                                                @if (run.ScheduledAt is { } at)
                                                {
                                                    <span>@LocalTime.DateTime(at)</span>
                                                }
                                            </div>
                                        </div>
                                        @* «Играть» тёмной — только у идущего прохождения; у запланированного и объявленного — «Начать» вторичной
                                           (P2: три тёмные кнопки на экране, включая «Играть» у запланированного). *@
                                        @if (run.Status == ScenarioRunStatus.Running)
                                        {
                                            <Button Small="true" Icon="fa-play" Href="@ScenarioLinks.Play(run.ScenarioId, runId: run.RunId)">Играть</Button>
                                        }
                                        else if (run.Status != ScenarioRunStatus.Finished)
                                        {
                                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-play" Href="@ScenarioLinks.Play(run.ScenarioId, runId: run.RunId)">Начать</Button>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* Завершённой кампании НПС не добавляют (решение владельца №8): секция только там, где они уже есть. *@
                    @if (active || details.Npcs.Count > 0)
                    {
                    <section class="cm-section" aria-label="НПС кампании">
                        <div class="cm-card">
                            <SectionHeader Title="НПС кампании" Count="details.Npcs.Count">
                                <Actions>
                                    @if (active)
                                    {
                                        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus" Href="@($"character/create/npc?campaignId={CampaignId}")">Добавить НПС</Button>
                                    }
                                </Actions>
                            </SectionHeader>
                            @if (details.Npcs.Count == 0)
                            {
                                <p class="cm-empty-compact border-t border-primary-200 px-4 py-3 first:border-t-0">Нет НПС.</p>
                            }
                            else
                            {
                                <div class="flex flex-wrap gap-2 border-t border-primary-200 px-4 py-3 first:border-t-0">
                                    @foreach (var npc in details.Npcs)
                                    {
                                        <CharacterChip Character="npc" @key="npc.Id" />
                                    }
                                </div>
                            }
                        </div>
                    </section>
                    }
                </div>
            }

            @* Редкое и необратимое — внизу, а не первым на экране (правило 7). *@
            @* Выйти из завершённой кампании не предлагаем: журнал — архив, который игрок потерял бы. *@
            @{
                var canLeave = details.CanLeave && active;
            }
            @if (campaign.CanDelete || canLeave)
            {
                <section class="cm-section min-w-0 lg:col-start-1" aria-label="Опасная зона">
                    <div class="cm-card">
                        <SectionHeader Title="Опасная зона" />
                        @if (canLeave)
                        {
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-primary-200 px-4 py-3 first:border-t-0">
                                <p class="min-w-0 flex-1 basis-64 text-sm text-primary-700">Журнал станет вам недоступен, лист останется у вас без кампании.</p>
                                <Button Variant="ButtonVariant.OutlineError" Icon="fa-right-from-bracket"
                                        OnClick="() => RemoveAsync(details.Members.First(m => m.IsMe))">Выйти из кампании</Button>
                            </div>
                        }
                        @if (campaign.CanDelete)
                        {
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-primary-200 px-4 py-3 first:border-t-0">
                                <p class="min-w-0 flex-1 basis-64 text-sm text-primary-700">Удалится вместе с журналом встреч и прохождениями.</p>
                                <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="DeleteAsync">Удалить кампанию</Button>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        @* Хранителю — одна строка внизу со ссылкой на последнюю встречу; игроку то же сказано карточкой над списком. *@
        @if (campaign.CanEdit && details.LastSession is { } last)
        {
            <p class="cm-text-muted">
                <a href="@($"campaigns/{CampaignId}/journal")" class="inline-flex min-h-8 items-center underline hover:no-underline">Последняя встреча №@last.Number@(string.IsNullOrWhiteSpace(last.Title) ? "" : $": {last.Title}"), @LocalTime.Date(last.SessionDate)</a>
            </p>
        }

        </ChildContent>
    </AsyncContent>
</div>

<InviteModal Open="_inviting" Link="@InviteLink" OnClose="() => _inviting = false" />
<CampaignFormModal Open="_formOpen" Campaign="_details?.Campaign" OnClose="() => _formOpen = false" OnSaved="SavedAsync" />
<MemberNameModal Open="_renaming is not null" ForSelf="@(_renaming?.IsMe ?? true)"
                 Title="@(_renaming?.IsMe == true ? "Ваше имя в кампании" : $"Имя в кампании: {CampaignLabels.Person(_renaming?.Name)}")"
                 Value="@_renaming?.Alias" ProfileName="@(_renaming?.Alias is null ? _renaming?.Name : null)"
                 Busy="_busy" Error="@_renameError" OnSave="RenameAsync" OnClose="() => _renaming = null" />

@code {
    [Parameter] public Guid CampaignId { get; set; }

    private AsyncContent<CampaignDetailsDto?>? _content;
    private CampaignDetailsDto? _details;
    private bool _formOpen;
    private bool _inviting;

    /// <summary>Ссылка-приглашение — страница <c>/join/{id}</c> абсолютным адресом: её отправляют в мессенджер.</summary>
    private string InviteLink => Navigation.ToAbsoluteUri($"join/{CampaignId}").ToString();
    private CampaignMemberDto? _renaming;
    private string? _renameError;
    private bool _busy;

    /// <summary>Активной кампании без игроков нужно приглашение: оно главное действие страницы.</summary>
    private bool NeedsPlayers => _details?.Campaign is { CanEdit: true, PlayerCount: 0, Status: not CampaignStatus.Completed };

    /// <summary>Идёт игра: главное действие — «Играть» в строке прохождения, журнал в шапке уступает.</summary>
    private bool HasRunningRun => _details?.Runs.Any(r => r.Status == ScenarioRunStatus.Running) == true;

    private bool JournalIsMain => !NeedsPlayers && !HasRunningRun;

    /// <summary>
    /// Статус, вид (только «Ваншот»: кампания — норма, её словом не помечают) и моя роль. Подзаголовок короткий и помещается
    /// рядом с кнопками даже на телефоне; эпоху (п. 12) не показываем.
    /// </summary>
    private string? Subtitle => _details?.Campaign is { } c
        ? string.Join(" · ", new[]
        {
            CampaignLabels.Status(c.Status),
            c.Kind == CampaignKind.OneShot ? CampaignLabels.Kind(c.Kind) : null,
            c.MyRole is { } role ? $"вы — {CampaignLabels.Role(role)}" : null,
        }.Where(part => part is not null))
        : null;

    /// <summary>404 — кампании нет или я в ней не состою (сервер их не различает): пустое место, а не ошибка.</summary>
    private async Task<CampaignDetailsDto?> LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            _details = await Api.GetCampaignAsync(CampaignId, cancellationToken);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _details = null;
        }

        // Шапка страницы показывает название — она вне AsyncContent и сама не перерисуется.
        StateHasChanged();
        return _details;
    }

    private async Task SavedAsync(CampaignSummaryDto saved)
    {
        _formOpen = false;
        Toasts.Success("Кампания сохранена:", subject: saved.Name);
        await ReloadAsync();
    }

    private void StartRename(CampaignMemberDto member)
    {
        _renameError = null;
        _renaming = member;
    }

    private async Task RenameAsync(string displayName)
    {
        if (_renaming is not { } member)
        {
            return;
        }

        _busy = true;
        _renameError = null;
        try
        {
            await Api.UpdateMemberAsync(CampaignId, member.UserId, new UpdateMemberRequest(displayName));
            _renaming = null;
            Toasts.Success("Имя в кампании сохранено.");
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _renameError = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(CampaignMemberDto member)
    {
        var self = member.IsMe;
        var confirmed = await Dialogs.ConfirmAsync(self
            ? new ConfirmRequest("Выйти из кампании?", "Журнал кампании станет вам недоступен. Ваш лист останется у вас — без кампании.")
            {
                ConfirmText = "Выйти",
                Details = "Вернуться можно, вступив снова с главной.",
            }
            : new ConfirmRequest("Исключить игрока?", "Он потеряет доступ к журналу. Его лист останется у него — без кампании.")
            {
                Subject = CampaignLabels.Person(member.Name),
                ConfirmText = "Исключить",
                Details = "Можно вернуть: игрок вступит снова с главной.",
            });
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.RemoveMemberAsync(CampaignId, member.UserId);
            if (self)
            {
                Toasts.Success("Вы вышли из кампании:", subject: _details?.Campaign.Name);
                Navigation.NavigateTo("");
                return;
            }

            Toasts.Success("Игрок исключён:", subject: CampaignLabels.Person(member.Name));
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), self ? "Не удалось выйти" : "Не удалось исключить");
        }
    }

    private async Task DeleteAsync()
    {
        if (_details?.Campaign is not { } campaign)
        {
            return;
        }

        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Удалить кампанию?",
            "Удалится вместе с журналом встреч и прохождениями. Листы игроков останутся у них, НПС кампании вернутся в библиотеку.")
        {
            Subject = campaign.Name,
            ConfirmText = "Удалить кампанию",
        });
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCampaignAsync(campaign.Id);
            Toasts.Success("Кампания удалена:", subject: campaign.Name);
            Navigation.NavigateTo("campaigns");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
        }
    }

    private Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;
}
