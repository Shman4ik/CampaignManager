@page "/campaigns/{CampaignId:guid}"
@attribute [Authorize]
@using System.Globalization
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Core.Campaigns
@using CampaignManager.UI.Platform
@inject ICampaignsApi Api
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Кампания и её участники. В v1 этого адреса не было, хотя на него вели ссылки из сценария и помощника
   создания (AUDIT, «Битая ссылка»). Здесь — имя в кампании (псевдоним), выход игрока, исключение
   игрока Хранителем. Кнопки — по флагам из API; права решает сервер. *@
<PageHeader Title="@(_details?.Campaign.Name ?? "Кампания")">
    <Actions>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-book-open" Href="@($"campaigns/{CampaignId}/journal")">Журнал</Button>
        @if (_details?.Campaign.CanEdit == true)
        {
            <Button Small="true" Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" OnClick="() => _formOpen = true">Изменить</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <AsyncContent @ref="_content" Key="CampaignId" Load="LoadAsync" LoadingMessage="Загружаю кампанию…" Context="loaded"
                  ErrorTitle="Кампания недоступна">
        <Empty>
            <EmptyState Icon="fa-map" Title="Кампания не найдена."
                        Message="Её удалили, или вы в ней не состоите. Вступить можно с главной.">
                <Actions><Button Href="" Icon="fa-house">На главную</Button></Actions>
            </EmptyState>
        </Empty>
        <ChildContent>
        @{
            var details = loaded!;
            var campaign = details.Campaign;
        }
        <section class="cm-section">
            <div class="cm-card">
                <div class="cm-card-body">
                    <div class="mb-3 flex flex-wrap items-center gap-1.5">
                        <Badge Tone="CampaignLabels.StatusTone(campaign.Status)">@CampaignLabels.Status(campaign.Status)</Badge>
                        <Badge Tone="Tone.Neutral">@CampaignLabels.Kind(campaign.Kind)</Badge>
                        <Badge Tone="Tone.Stone">@CampaignLabels.Era(campaign.Era)</Badge>
                        @if (campaign.MyRole is { } role)
                        {
                            <Badge Tone="Tone.Info">Вы: @CampaignLabels.Role(role)</Badge>
                        }
                    </div>
                    <div class="cm-meta">
                        <span><span class="cm-meta-label">Создана:</span> @campaign.CreatedAt.ToLocalTime().ToString("d MMMM yyyy", Russian)</span>
                        <span><span class="cm-meta-label">Игроков:</span> @campaign.PlayerCount</span>
                    </div>
                </div>
                @if (campaign.CanDelete || details.CanLeave)
                {
                    <div class="cm-card-footer">
                        @if (details.CanLeave)
                        {
                            <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-right-from-bracket"
                                    OnClick="() => RemoveAsync(details.Members.First(m => m.IsMe))">Выйти из кампании</Button>
                        }
                        @if (campaign.CanDelete)
                        {
                            <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="DeleteAsync">Удалить кампанию</Button>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="cm-section" aria-labelledby="members-title">
            <div class="cm-section-header"><h2 id="members-title" class="cm-section-title">Участники (@details.Members.Count)</h2></div>
            <div class="cm-card">
                @foreach (var member in details.Members)
                {
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-primary-200 px-4 py-3 first:border-t-0" @key="member.UserId">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-semibold text-primary-800">@CampaignLabels.Person(member.Name)</span>
                                @if (member.Role == CampaignRole.Keeper)
                                {
                                    <Badge Tone="Tone.Info" Icon="fa-book-skull">Хранитель</Badge>
                                }
                                @if (member.IsMe)
                                {
                                    <Badge Tone="Tone.Neutral">Вы</Badge>
                                }
                            </div>
                            <div class="text-sm text-primary-500">
                                @(member.Alias is null ? "Имя из профиля" : "Имя в этой кампании") · с @member.JoinedAt.ToLocalTime().ToString("d MMMM yyyy", Russian)
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @if (member.CanRename)
                            {
                                <Button Small="true" Variant="ButtonVariant.OutlinePrimary" Icon="fa-signature" OnClick="() => StartRename(member)">Имя в кампании</Button>
                            }
                            @if (member.CanRemove && !member.IsMe)
                            {
                                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-user-minus" OnClick="() => RemoveAsync(member)">Исключить</Button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
        </ChildContent>
    </AsyncContent>
</div>

<CampaignFormModal Open="_formOpen" Campaign="_details?.Campaign" OnClose="() => _formOpen = false" OnSaved="SavedAsync" />
<MemberNameModal Open="_renaming is not null"
                 Title="@(_renaming?.IsMe == true ? "Ваше имя в кампании" : $"Имя в кампании: {CampaignLabels.Person(_renaming?.Name)}")"
                 Value="@_renaming?.Alias" ProfileName="@(_renaming?.Alias is null ? _renaming?.Name : null)"
                 Busy="_busy" Error="@_renameError" OnSave="RenameAsync" OnClose="() => _renaming = null" />

@code {
    private static readonly CultureInfo Russian = CultureInfo.GetCultureInfo("ru-RU");

    [Parameter] public Guid CampaignId { get; set; }

    private AsyncContent<CampaignDetailsDto?>? _content;
    private CampaignDetailsDto? _details;
    private bool _formOpen;
    private CampaignMemberDto? _renaming;
    private string? _renameError;
    private bool _busy;

    /// <summary>404 — кампании нет или я в ней не состою (сервер их не различает): пустое место, а не ошибка.</summary>
    private async Task<CampaignDetailsDto?> LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            _details = await Api.GetCampaignAsync(CampaignId, cancellationToken);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _details = null;
        }

        // Шапка страницы показывает название — она вне AsyncContent и сама не перерисуется.
        StateHasChanged();
        return _details;
    }

    private async Task SavedAsync(CampaignSummaryDto _)
    {
        _formOpen = false;
        Toasts.Success("Сохранено.");
        await ReloadAsync();
    }

    private void StartRename(CampaignMemberDto member)
    {
        _renameError = null;
        _renaming = member;
    }

    private async Task RenameAsync(string displayName)
    {
        if (_renaming is not { } member)
        {
            return;
        }

        _busy = true;
        _renameError = null;
        try
        {
            await Api.UpdateMemberAsync(CampaignId, member.UserId, new UpdateMemberRequest(displayName));
            _renaming = null;
            Toasts.Success("Имя в кампании сохранено.");
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _renameError = ApiErrors.Describe(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(CampaignMemberDto member)
    {
        var self = member.IsMe;
        var confirmed = await Dialogs.ConfirmAsync(self
            ? new ConfirmRequest("Выйти из кампании?", "Журнал кампании станет вам недоступен. Ваш лист останется у вас — без кампании.")
            {
                ConfirmText = "Выйти",
                Details = "Вернуться можно, вступив снова с главной.",
            }
            : new ConfirmRequest($"Исключить {CampaignLabels.Person(member.Name)}?",
                "Игрок потеряет доступ к журналу. Его лист останется у него — без кампании.")
            {
                ConfirmText = "Исключить",
            });
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.RemoveMemberAsync(CampaignId, member.UserId);
            if (self)
            {
                Toasts.Success("Вы вышли из кампании.");
                Navigation.NavigateTo("");
                return;
            }

            Toasts.Success("Игрок исключён.");
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), self ? "Не удалось выйти" : "Не удалось исключить");
        }
    }

    private async Task DeleteAsync()
    {
        if (_details?.Campaign is not { } campaign)
        {
            return;
        }

        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Удалить кампанию?",
            $"«{campaign.Name}» удалится вместе с журналом встреч и прохождениями. Листы игроков останутся у них, НПС кампании вернутся в библиотеку."));
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCampaignAsync(campaign.Id);
            Toasts.Success($"Кампания «{campaign.Name}» удалена.");
            Navigation.NavigateTo("campaigns");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
        }
    }

    private Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;
}
