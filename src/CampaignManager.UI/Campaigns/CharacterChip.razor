@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Core.Characters

@* Лист одной кнопкой-ссылкой: имя, профессия и — если лист не активен — его статус. Тап-цель
   cm-btn-sm: на iPad голое имя-ссылка была бы слишком мелкой. *@
<a href="@($"character/{Character.Id}")" class="cm-btn cm-btn-secondary cm-btn-sm max-w-full">
    <i class="fa-solid @(Character.Kind == CharacterKind.Npc ? "fa-user-secret" : "fa-user") shrink-0" aria-hidden="true"></i>
    <span class="truncate">@Character.Name</span>
    @if (Character.Occupation is not null)
    {
        <span class="hidden truncate font-normal text-primary-500 sm:inline">· @Character.Occupation</span>
    }
    @if (Character.Status != CharacterStatus.Active)
    {
        <Badge Tone="CampaignLabels.CharacterStatusTone(Character.Status)">@CampaignLabels.CharacterStatus(Character.Status)</Badge>
    }
</a>

@code {
    [Parameter, EditorRequired] public HomeCharacterDto Character { get; set; } = null!;
}
