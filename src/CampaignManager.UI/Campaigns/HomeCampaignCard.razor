@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Core.Campaigns
@using CampaignManager.Core.Characters
@using CampaignManager.UI.Characters.Creation

@* Кампания на главной. Игроку — одно главное действие: открыть своего сыщика или завести его.
   Хранителю — игроки со всеми листами (в v1 это была отдельная таблица-аккордеон «Персонажи в
   ваших кампаниях») и НПС кампании. Второстепенное — журнал (читать: книга, не перо) — в подвале.
   Завершённая кампания (правило 17) — строка, а не карточка: имя, статус, «Журнал» (и «Открыть лист», если он есть);
   «Создать сыщика», «+ НПС» и список игроков ей не нужны. Строки завершённых стоят в одной карточке главной
   (HomePage), поэтому сама строка рамки не рисует. *@
@if (Completed)
{
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-primary-200 px-4 py-2 first:border-t-0"
         data-testid="home-completed">
        <a href="@($"campaigns/{Campaign.Id}")" class="inline-flex min-h-11 min-w-0 flex-1 basis-48 items-center font-semibold text-primary-800 hover:underline">@Campaign.Name</a>
        <div class="flex flex-wrap items-center gap-1.5">
            @if (Campaign.Kind == CampaignKind.OneShot)
            {
                <Badge Tone="Tone.Neutral">Ваншот</Badge>
            }
            <Badge Tone="CampaignLabels.StatusTone(Campaign.Status)">@CampaignLabels.Status(Campaign.Status)</Badge>
        </div>
        <div class="cm-btn-row">
            @if (Campaign.MyCharacter is { } mine && !Kept)
            {
                <Button Small="true" Variant="ButtonVariant.Secondary" Href="@($"character/{mine.Id}")" Icon="fa-id-card">Открыть лист</Button>
            }
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-book-open" Href="@($"campaigns/{Campaign.Id}/journal")">Журнал</Button>
        </div>
    </div>
}
else
{
    <article class="cm-card flex flex-col" aria-labelledby="@($"campaign-{Campaign.Id}")">
        @* Вся шапка — ссылка. Название и бейджи в одной строке (бейджи справа, не влезают — переносятся под название):
           шапка в 50px вместо 100px, и «Открыть лист» не уезжает за сгиб на телефоне (H1). *@
        <a href="@($"campaigns/{Campaign.Id}")" class="cm-card-header rounded-t-lg no-underline hover:bg-primary-50">
            <span id="@($"campaign-{Campaign.Id}")" class="cm-card-title min-w-0 flex-1 basis-40">@Campaign.Name</span>
            <span class="flex flex-wrap items-center justify-end gap-1.5">
                @if (Kept)
                {
                    <Badge Tone="Tone.Info" Icon="fa-book-skull">Хранитель</Badge>
                }
                @if (Campaign.Kind == CampaignKind.OneShot)
                {
                    <Badge Tone="Tone.Neutral">Ваншот</Badge>
                }
                <Badge Tone="CampaignLabels.StatusTone(Campaign.Status)">@CampaignLabels.Status(Campaign.Status)</Badge>
            </span>
        </a>

        <div class="cm-card-body flex-1">
            @if (!Kept)
            {
                <div class="cm-meta mb-3">
                    @if (Campaign.KeeperName is { } keeperName)
                    {
                        <span><span class="cm-meta-label">Хранитель:</span> @keeperName</span>
                    }
                    <span><span class="cm-meta-label">Игроков:</span> @Campaign.PlayerCount</span>
                </div>

                @if (Campaign.MyCharacter is { } mine)
                {
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="truncate font-semibold text-primary-800">@mine.Name</div>
                            @if (mine.Occupation is not null)
                            {
                                <div class="truncate text-sm text-primary-500">@mine.Occupation</div>
                            }
                        </div>
                        <Button Href="@($"character/{mine.Id}")" Icon="fa-id-card">Открыть лист</Button>
                    </div>
                }
                else
                {
                    <p class="cm-text-muted mb-3">Своего сыщика в этой кампании у вас пока нет.</p>
                    <div class="cm-btn-row">
                        <Button Href="@($"character/wizard?campaignId={Campaign.Id}")" Icon="fa-wand-magic-sparkles">Создать сыщика</Button>
                        <Button Variant="ButtonVariant.Secondary" Href="@CreationLinks.Blank(Campaign.Id)">Пустой лист</Button>
                    </div>
                }
            }
            else
            {
                @* Нулевые секции («Игроки (0)», «НПС (0)») не рисуются: пустота ради заголовка — шум. *@
                @if (Campaign.Players.Count == 0)
                {
                    <p class="cm-text-muted">Игроков пока нет.</p>
                }
                else
                {
                    <h3 class="mb-1 text-sm font-semibold text-primary-800">Игроки (@Campaign.PlayerCount)</h3>
                    <ul>
                        @foreach (var player in Campaign.Players)
                        {
                            <li class="border-t border-primary-200 py-2 first:border-t-0" @key="player.UserId">
                                <div class="text-sm font-semibold text-primary-700">@CampaignLabels.Person(player.Name)</div>
                                @if (player.Characters.Count == 0)
                                {
                                    <div class="text-sm text-primary-500">Листа пока нет</div>
                                }
                                else
                                {
                                    <div class="mt-1 flex flex-wrap gap-2">
                                        @foreach (var character in player.Characters)
                                        {
                                            <CharacterChip Character="character" @key="character.Id" />
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (Campaign.Npcs.Count > 0)
                {
                    <div class="cm-section-divided">
                        <h3 class="mb-2 text-sm font-semibold text-primary-800">НПС кампании (@Campaign.Npcs.Count)</h3>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var npc in Campaign.Npcs)
                            {
                                <CharacterChip Character="npc" @key="npc.Id" />
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="cm-card-footer">
            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-book-open" Href="@($"campaigns/{Campaign.Id}/journal")">Журнал</Button>
            @if (Kept)
            {
                <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-plus"
                        Href="@($"character/create/npc?campaignId={Campaign.Id}")">Добавить НПС</Button>
            }
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired] public HomeCampaignDto Campaign { get; set; } = null!;

    private bool Kept => Campaign.MyRole == CampaignRole.Keeper;

    /// <summary>Завершённая кампания рисуется строкой (правило 17).</summary>
    public static bool IsCompleted(HomeCampaignDto campaign) => campaign.Status == CampaignStatus.Completed;

    private bool Completed => IsCompleted(Campaign);
}
