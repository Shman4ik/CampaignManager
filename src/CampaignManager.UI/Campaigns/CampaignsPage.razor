@page "/campaigns"
@attribute [Authorize]
@using CampaignManager.Contracts.Campaigns
@using CampaignManager.Contracts.Identity
@using CampaignManager.Core
@using CampaignManager.Core.Campaigns
@using CampaignManager.UI.Platform
@inject ICampaignsApi Api
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation

@* Кампании, где я участник (администратору — все: он правит и чужие). В v1 страница была только для
   Хранителя; здесь игрок видит свои кампании с журналом, а кнопки правки приходят флагами из API.
   Вступление — на главной, в «Можно вступить».
   Карточка: одна главная кнопка «Открыть», «Журнал» и меню «⋯» (изменить и — внизу, красным — удалить): «Удалить»
   не стоит на виду у каждой карточки. Поиск и статус нужны, когда кампаний много (FilterThreshold) — три
   карточки помещаются на экране и без липкой панели. *@
<PageHeader Title="Кампании">
    <Actions>
        <AuthorizeView Policy="@Policies.Keeper">
            <Button Small="true" Icon="fa-plus" OnClick="() => OpenForm(null)">Новая кампания</Button>
        </AuthorizeView>
    </Actions>
</PageHeader>

<div class="cm-page">
    <AsyncContent @ref="_list" Load="Api.GetCampaignsAsync" LoadingMessage="Загружаю кампании…" Context="campaigns">
        @{
            var shown = Filter(campaigns);
        }
        @if (campaigns.Count > FilterThreshold)
        {
            <FilterPanel OnReset="ResetFilters" CanReset="@(_search.Length > 0 || _status.Length > 0)">
                <input type="search" class="cm-input min-w-48 flex-1" placeholder="Поиск по названию…" aria-label="Поиск по названию"
                       @bind="_search" @bind:event="oninput" />
                <select class="cm-input w-full shrink-0 sm:w-56" aria-label="Статус" @bind="_status">
                    <option value="">Любой статус</option>
                    @foreach (var status in Enum.GetValues<CampaignStatus>())
                    {
                        <option value="@status">@CampaignLabels.Status(status)</option>
                    }
                </select>
            </FilterPanel>
        }

        @if (campaigns.Count == 0)
        {
            <EmptyState Icon="fa-map" Title="Кампаний пока нет."
                        Message="Хранитель заводит кампанию здесь, игрок вступает в неё на главной.">
                <Actions>
                    <Button Variant="ButtonVariant.Secondary" Href="" Icon="fa-house">На главную</Button>
                </Actions>
            </EmptyState>
        }
        else if (shown.Count == 0)
        {
            <EmptyState Title="@Terms.EmptyFiltered("кампаний")" Compact="true" />
        }
        else
        {
            @* auto-fit, а не auto-fill общего cm-grid-cards: две-три карточки растягиваются на всю строку, а не жмутся слева с пустыми колонками. *@
            <div class="grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]" data-testid="campaigns-grid">
                @foreach (var campaign in shown)
                {
                    <article class="cm-card flex flex-col" @key="campaign.Id" aria-labelledby="@($"campaign-{campaign.Id}")">
                        <div class="cm-card-header flex-col items-start gap-1">
                            <a id="@($"campaign-{campaign.Id}")" href="@($"campaigns/{campaign.Id}")" class="cm-card-title inline-flex min-h-11 items-center hover:underline">@campaign.Name</a>
                            <div class="flex flex-wrap items-center gap-1.5">
                                <Badge Tone="CampaignLabels.StatusTone(campaign.Status)">@CampaignLabels.Status(campaign.Status)</Badge>
                            </div>
                        </div>
                        <div class="cm-card-body flex-1">
                            @* Одна таблица «подпись — значение»: строки не переносятся по-разному у разных карточек. *@
                            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                                @if (campaign.MyRole is { } role)
                                {
                                    <dt class="cm-meta-label">Вы</dt>
                                    <dd>@CampaignLabels.Role(role)</dd>
                                }
                                @if (campaign.MyRole != CampaignRole.Keeper && campaign.KeeperName is { } keeperName)
                                {
                                    <dt class="cm-meta-label">Хранитель</dt>
                                    <dd>@keeperName</dd>
                                }
                                <dt class="cm-meta-label">Игроков</dt>
                                <dd>@campaign.PlayerCount</dd>
                                <dt class="cm-meta-label">Вид</dt>
                                <dd>@CampaignLabels.Kind(campaign.Kind) · @CampaignLabels.Era(campaign.Era)</dd>
                                <dt class="cm-meta-label">Создана</dt>
                                <dd>@LocalTime.Date(campaign.CreatedAt)</dd>
                            </dl>
                        </div>
                        <div class="cm-card-footer">
                            <Button Small="true" Icon="fa-arrow-right" Href="@($"campaigns/{campaign.Id}")">Открыть</Button>
                            <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-pen-nib" Href="@($"campaigns/{campaign.Id}/journal")">Журнал</Button>
                            @if (campaign.CanEdit || campaign.CanDelete)
                            {
                                <span class="ml-auto">
                                    <RowMenu AriaLabel="@($"Действия: {campaign.Name}")">
                                        <ChildContent>
                                            @if (campaign.CanEdit)
                                            {
                                                <RowMenuItem Icon="fa-pen" OnClick="() => OpenForm(campaign)">Изменить</RowMenuItem>
                                            }
                                        </ChildContent>
                                        <Danger>
                                            @if (campaign.CanDelete)
                                            {
                                                <RowMenuItem Icon="fa-trash-can" Danger="true" OnClick="() => DeleteAsync(campaign)">Удалить</RowMenuItem>
                                            }
                                        </Danger>
                                    </RowMenu>
                                </span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </AsyncContent>
</div>

<CampaignFormModal Open="_formOpen" Campaign="_editing" OnClose="() => _formOpen = false" OnSaved="SavedAsync" />

@code {
    /// <summary>Панель поиска и статуса появляется, когда кампаний больше этого: меньше — они и так видны целиком.</summary>
    private const int FilterThreshold = 6;

    private AsyncContent<IReadOnlyList<CampaignSummaryDto>>? _list;
    private string _search = "";
    private string _status = "";
    private bool _formOpen;
    private CampaignSummaryDto? _editing;

    private List<CampaignSummaryDto> Filter(IReadOnlyList<CampaignSummaryDto> campaigns) =>
    [
        .. campaigns
            .Where(c => string.IsNullOrWhiteSpace(_search) || c.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(c => _status.Length == 0 || c.Status.ToString() == _status),
    ];

    private void ResetFilters()
    {
        _search = "";
        _status = "";
    }

    private void OpenForm(CampaignSummaryDto? campaign)
    {
        _editing = campaign;
        _formOpen = true;
    }

    private async Task SavedAsync(CampaignSummaryDto campaign)
    {
        var created = _editing is null;
        _formOpen = false;
        if (created)
        {
            Toasts.Success($"Кампания «{campaign.Name}» создана.");
            Navigation.NavigateTo($"campaigns/{campaign.Id}");
            return;
        }

        Toasts.Success("Сохранено.");
        await ReloadAsync();
    }

    private async Task DeleteAsync(CampaignSummaryDto campaign)
    {
        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Удалить кампанию?",
            "Удалится вместе с журналом встреч и прохождениями. Листы игроков останутся у них, НПС кампании вернутся в библиотеку.")
        {
            Subject = campaign.Name,
            ConfirmText = "Удалить кампанию",
        });
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCampaignAsync(campaign.Id);
            Toasts.Success($"Кампания «{campaign.Name}» удалена.");
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
        }
    }

    private Task ReloadAsync() => _list?.ReloadAsync() ?? Task.CompletedTask;
}
