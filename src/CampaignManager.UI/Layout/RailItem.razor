@* Пункт рельса. 46px в высоту — тап-цель. Активный подсвечивает NavLink (класс active). *@
<NavLink class="cm-rail-item" href="@Item.Href" Match="@(Item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
    <span class="cm-rail-icon"><i class="fa-solid @Item.Icon" aria-hidden="true"></i></span>
    <span class="cm-rail-label">@Item.RailLabel</span>
    @if (Badge is { } count)
    {
        <span class="cm-nav-badge">@count<span class="sr-only"> новых</span></span>
    }
</NavLink>

@code {
    [Parameter, EditorRequired] public NavItem Item { get; set; } = null!;

    [Parameter] public int? Badge { get; set; }
}
