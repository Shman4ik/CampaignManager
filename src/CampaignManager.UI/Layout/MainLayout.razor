@inherits LayoutComponentBase

@* Оболочка приложения: рельс (планшет), нижняя панель (телефон), колонка страницы и общие
   хосты — диалог подтверждения, уведомления, индикатор связи. Страница внутри — PageHeader
   и один <div class="cm-page">. Кнопки модулей в шапке (ширма, плеер) их компоненты кладут
   отсюда в PageHeaderSlots. *@
<div class="cm-shell">
    <NavRail Items="_items" />

    <div class="cm-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <PageHeader Title="Ошибка" />
                <div class="cm-page">
                    <EmptyState Icon="fa-triangle-exclamation" Title="Что-то пошло не так"
                                Message="На странице произошла ошибка. Обновите её; если повторится — сообщите, что делали.">
                        <Actions>
                            <Button Href="" Icon="fa-house">На главную</Button>
                        </Actions>
                    </EmptyState>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>

    <BottomNav Items="_items" />
</div>

<DialogHost />
<ToastHost />
<ConnectionIndicator />

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss" aria-label="Скрыть сообщение"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    // Права на пункты меню проверит вход (T1.4): пока пользователя нет, видно всё.
    private readonly IReadOnlyList<NavItem> _items = NavMenu.VisibleTo(_ => true).ToList();

    // Ошибка на одной странице не должна запирать всё приложение: переход на другую её сбрасывает.
    protected override void OnParametersSet() => _errorBoundary?.Recover();
}
