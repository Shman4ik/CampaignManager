@inherits LayoutComponentBase

@* Временная оболочка каркаса. Настоящую (рельс, нижняя навигация, PageHeader) делает T1.6. *@
<div class="cm-shell min-h-screen bg-stone-50 text-slate-800">
    <header class="flex h-14 items-center border-b border-slate-200 bg-white px-4">
        <a href="" class="text-lg font-semibold text-slate-700">CampaignManager 2.0</a>
    </header>
    <main class="p-4">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss" aria-label="Закрыть">✕</button>
</div>
