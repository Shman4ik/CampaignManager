@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using CampaignManager.Contracts.Admin
@using CampaignManager.UI.Admin
@inject AdminBadges Badges
@inject IAdminApi AdminApi

@* Оболочка приложения: рельс (планшет), нижняя панель (телефон), колонка страницы и общие
   хосты — диалог подтверждения, уведомления, индикатор связи. Страница внутри — PageHeader
   и один <div class="cm-page">. Кнопки модулей в шапке (ширма, плеер) их компоненты кладут
   отсюда в PageHeaderSlots. *@
<div class="cm-shell">
    <NavRail Items="_items" Badges="Badges.Counts">
        <Footer><UserMenu Placement="UserMenuPlacement.Rail" /></Footer>
    </NavRail>

    <div class="cm-main">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <PageHeader Title="Ошибка" />
                <div class="cm-page">
                    <EmptyState Icon="fa-triangle-exclamation" Title="Что-то пошло не так"
                                Message="На странице произошла ошибка. Обновите её; если повторится — сообщите, что делали.">
                        <Actions>
                            <Button Href="" Icon="fa-house">На главную</Button>
                        </Actions>
                    </EmptyState>
                </div>
            </ErrorContent>
        </ErrorBoundary>

        @* Последним в колонке: панель плеера липнет к низу экрана и место под собой занимает сама. *@
        <MusicPlayerHost />
    </div>

    <BottomNav Items="_items" Badges="Badges.Counts">
        <Account><UserMenu Placement="UserMenuPlacement.Sheet" /></Account>
        <Footer>
            <div class="cm-sheet-section">О проекте</div>
            <InfoLinks Class="px-3 py-2" />
        </Footer>
    </BottomNav>
</div>

<KeeperScreenHost />
<DialogHost />
<ToastHost />
<ConnectionIndicator />
<PaletteSwitch />

<div id="blazor-error-ui" data-nosnippet>
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss" aria-label="Скрыть сообщение"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private IReadOnlyList<NavItem> _items = NavMenu.VisibleTo(new ClaimsPrincipal());
    private bool _badgesLoaded;

    // Кто вошёл — из /api/v1/me (MeAuthenticationStateProvider): меню прячет чужие разделы.
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override void OnInitialized() => Badges.Changed += OnBadgesChanged;

    protected override async Task OnParametersSetAsync()
    {
        // Ошибка на одной странице не должна запирать всё приложение: переход на другую её сбрасывает.
        _errorBoundary?.Recover();

        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            _items = NavMenu.VisibleTo(user);

            // Счётчик заявок у пункта «Заявки» — администратору, один раз на загрузку; дальше его
            // обновляет страница заявок после одобрения и отказа.
            if (!_badgesLoaded && NavMenu.CanSee(NavAudience.Admin, user))
            {
                _badgesLoaded = true;
                await Badges.RefreshAsync(AdminApi);
            }
        }
    }

    private void OnBadgesChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Badges.Changed -= OnBadgesChanged;
}
