@* Рельс меню планшета: иконка и подпись 11px под ней, видна всегда (как в iPadOS) — наведения
   на iPad нет. Развернуть нельзя: на столе широкое меню только отнимало ширину у страницы.
   Пункты — NavMenu, тот же список, что у нижней панели телефона. Группы подписаны («Справочники», «Система»):
   одной линейкой семнадцать пунктов в одну колонку читались как сплошная лента. *@
<nav class="cm-rail" aria-label="Разделы">
    <div class="cm-rail-logo">
        <img src="_content/CampaignManager.UI/logo-mark.svg" alt="" width="34" height="34" />
    </div>

    <div class="cm-rail-nav">
        @foreach (var group in Items.GroupBy(i => i.Group))
        {
            <div class="cm-rail-group">
                @if (group.Key != NavGroup.Main)
                {
                    <div class="cm-rail-group-title">@NavMenu.Title(group.Key)</div>
                }
                @foreach (var item in group)
                {
                    <RailItem Item="item" Badge="@BadgeOf(item)" />
                }
            </div>
        }
    </div>

    @if (Footer is not null)
    {
        <div class="cm-rail-footer">@Footer</div>
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavItem> Items { get; set; } = [];

    /// <summary>Счётчики на пунктах (заявки): адрес пункта → число.</summary>
    [Parameter] public IReadOnlyDictionary<string, int>? Badges { get; set; }

    /// <summary>Подвал рельса: кабинет, «Войти»/«Выйти» (UserMenu).</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    private int? BadgeOf(NavItem item) =>
        Badges is not null && Badges.TryGetValue(item.Href, out var count) && count > 0 ? count : null;
}
