@page "/not-found"
@inject NavigationManager Navigation

@* Один заголовок (в шапке) и пояснение без карточки-заглушки ради одной кнопки. Адрес показан: опечатку видно сразу.
   Серверный 404 приходит через /not-found (адрес потерян) — тогда строки с адресом нет. *@
<PageHeader Title="Страница не найдена" />

<div class="cm-page">
    @* Не cm-stack: его линейки — для блоков внутри карточки, а здесь рисовали три линии через всю колонку под двумя строками. *@
    <div class="flex flex-col items-start gap-3">
        <p class="text-primary-700">Возможно, ссылка устарела.</p>
        @if (Address is { } address)
        {
            <p class="text-sm text-primary-500" data-testid="missing-address">Адрес: <span class="break-all font-mono">@address</span></p>
        }
        <div class="cm-btn-row">
            <Button Href="" Icon="fa-house">На главную</Button>
        </div>
    </div>
</div>

@code {
    private string? Address
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return path is "/" or "/not-found" ? null : path;
        }
    }
}
