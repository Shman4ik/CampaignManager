@page "/not-found"
@inject NavigationManager Navigation

@* Заглушка (архетип «заглушка»): один заголовок в шапке и EmptyState — иконка, «Такой страницы нет», адрес подписью и вторичная
   «На главную». Адрес показан: опечатку видно сразу. Серверный 404 приходит через /not-found (адрес потерян) — тогда строки с
   адресом нет. *@
<PageHeader Title="Страница не найдена" />

<div class="cm-page">
    <EmptyState Icon="fa-link-slash" Title="Такой страницы нет" Message="@(Address is { } address ? $"Адрес: {address}" : null)">
        <Actions>
            <Button Href="" Variant="ButtonVariant.Secondary" Icon="fa-house">На главную</Button>
        </Actions>
    </EmptyState>
</div>

@code {
    private string? Address
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return path is "/" or "/not-found" ? null : path;
        }
    }
}
