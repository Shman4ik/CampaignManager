@page "/"
@inject UiEnvironment Environment

@* Заглушка каркаса. Главную (кампании) делает T2.2. *@
<PageHeader Title="Главная" DocumentTitle="CampaignManager 2.0" />

<div class="cm-page">
    <section class="cm-section">
        <div class="cm-card">
            <div class="cm-card-body">
                <h2 class="cm-h6 mb-1">CampaignManager 2.0</h2>
                <p class="cm-text-muted">Каркас решения. Разделы появятся в волне 2 (docs/v2/TASKS.md).</p>
            </div>
            <div class="cm-card-footer">
                <Button Href="dev/ping" Variant="ButtonVariant.Secondary" Icon="fa-heart-pulse">Проверка связи</Button>
                <Button Href="dev/files" Variant="ButtonVariant.Secondary" Icon="fa-file-arrow-up">Проверка файлов</Button>
                @if (Environment.IsDevelopment)
                {
                    <Button Href="dev/ui" Variant="ButtonVariant.Secondary" Icon="fa-swatchbook">UI-кит</Button>
                    <Button Href="dev/checks" Variant="ButtonVariant.Secondary" Icon="fa-dice-d20">Проверки</Button>
                }
            </div>
        </div>
    </section>
</div>
