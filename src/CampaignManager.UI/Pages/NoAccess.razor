@* «Нет доступа»: текст по политике страницы. Страницы администратора закрыты и Хранителю — заявка на роль Хранителя их
   не откроет, поэтому «подайте заявку» только там, где она помогает (страницы Хранителя, игроку). Показывает его
   Routes.razor, когда вошедшему не хватает роли. *@
<PageHeader Title="Нет доступа" />

<div class="cm-page">
    <div class="cm-stack">
        @* Одна фраза и «На главную»; ссылка на заявку — в одной строке с кнопкой, не вторым абзацем (P1). *@
        @if (AdminOnly)
        {
            <p class="text-primary-700" data-testid="no-access-text">Эта страница — только для администратора.</p>
        }
        else if (IsKeeperOrAdmin)
        {
            <p class="text-primary-700" data-testid="no-access-text">Эта страница вам недоступна.</p>
        }
        else
        {
            <p class="text-primary-700" data-testid="no-access-text">Эта страница открыта только Хранителям и администратору.</p>
        }
        <div class="cm-btn-row items-center gap-x-4">
            <Button Href="" Icon="fa-house">На главную</Button>
            @if (!AdminOnly && !IsKeeperOrAdmin)
            {
                <a href="profile" class="cm-link-btn"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Подать заявку в личном кабинете</a>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Страница под политикой администратора.</summary>
    [Parameter] public bool AdminOnly { get; set; }

    /// <summary>Пользователь уже Хранитель или администратор: заявка ему не поможет.</summary>
    [Parameter] public bool IsKeeperOrAdmin { get; set; }
}
