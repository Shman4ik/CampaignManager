@page "/dev/ping"
@using CampaignManager.Contracts.Platform
@inject IPingApi PingApi

@* Сквозная проверка каркаса: страница → ApiClient → GET /api/v1/ping → Data → Postgres. *@
<PageHeader Title="Проверка связи">
    <Actions>
        <Button Small="true" Icon="fa-rotate-right" Busy="@_loading" OnClick="PingAsync">Проверить ещё раз</Button>
    </Actions>
</PageHeader>

<div class="cm-page">
    <p class="cm-text-muted mb-4">Страница → ApiClient → GET /api/v1/ping → Data → Postgres.</p>

    @if (_error is not null)
    {
        <Alert Tone="Tone.Error" Title="Сервер не ответил" ShowIcon="true">@_error</Alert>
    }

    @if (_response is { } response)
    {
        <div class="cm-card">
            <dl class="cm-card-body grid grid-cols-[auto_1fr] gap-x-6 gap-y-2" data-testid="ping-result">
                <dt class="text-primary-500">Время сервера</dt>
                <dd>@Format(response.ServerTime)</dd>
                <dt class="text-primary-500">Время базы</dt>
                <dd>@Format(response.DatabaseTime)</dd>
                <dt class="text-primary-500">Запрос к базе</dt>
                <dd>@response.DatabaseLatencyMs.ToString("0.0") мс</dd>
                <dt class="text-primary-500">Весь ответ</dt>
                <dd>@_roundTrip.TotalMilliseconds.ToString("0") мс</dd>
                <dt class="text-primary-500">Сервер</dt>
                <dd>@response.ServerVersion, @response.Environment</dd>
            </dl>
        </div>
    }
    else if (_loading)
    {
        <LoadingIndicator Message="Проверяю…" />
    }
</div>

@code {
    private PingResponse? _response;
    private string? _error;
    private bool _loading;
    private TimeSpan _roundTrip;

    protected override Task OnInitializedAsync() => PingAsync();

    private async Task PingAsync()
    {
        _loading = true;
        _error = null;
        var started = Stopwatch.GetTimestamp();
        try
        {
            _response = await PingApi.PingAsync();
            _roundTrip = Stopwatch.GetElapsedTime(started);
        }
        catch (HttpRequestException ex)
        {
            _response = null;
            _error = ex.StatusCode is { } status ? $"{(int)status} {status}" : ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Format(DateTimeOffset time) =>
        time.ToLocalTime().ToString("d MMMM yyyy, HH:mm:ss.fff", CultureInfo.CurrentCulture);
}
