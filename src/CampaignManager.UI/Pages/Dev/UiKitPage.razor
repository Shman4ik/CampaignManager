@page "/dev/ui"
@using CampaignManager.Core
@using CampaignManager.Core.Dice
@using CampaignManager.UI.Platform
@inject UiEnvironment Environment
@inject DialogService Dialogs
@inject ToastService Toasts
@inject ApiActivity Activity

@* Все компоненты UI-кита на одном экране — только в Development. Здесь их проверяют на iPad
   Pro 11" (1194×696, 834×1056) и iPhone (393×651) после правки дизайн-системы. Новый компонент кита —
   сюда же. Данные выдуманы, на сервер страница не ходит. *@
@if (!Environment.IsDevelopment)
{
    <PageHeader Title="Страница не найдена" />
    <div class="cm-page">
        <EmptyState Icon="fa-map-signs" Title="По этому адресу ничего нет" />
    </div>
    return;
}

<PageHeader Title="UI-кит" Subtitle="Подзаголовок: контекст страницы, 13px" Game="true">
    <Actions>
        <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" OnClick="ResetDemo">Сбросить</Button>
        <Button Small="true" Icon="fa-plus" OnClick="() => _modalOpen = true">Окно</Button>
    </Actions>
</PageHeader>

@* Game="true": «Ширма» и плеер в шапке (их кладут KeeperScreenHost и MusicPlayerBar из MainLayout через
   слоты PageHeaderSlots) видны здесь, если войти Хранителем; без Game их в шапке нет. Диалог проверки и ширма вживую — /dev/checks. *@

<div class="cm-page">
    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Цвета</h2></div>
        <div class="cm-card">
            <div class="cm-card-body cm-stack">
                @foreach (var (name, swatches) in Palettes)
                {
                    <div>
                        <div class="cm-field-label mb-2">@name</div>
                        <div class="grid grid-cols-6 gap-1 sm:grid-cols-11">
                            @foreach (var (shade, css) in swatches)
                            {
                                <div class="min-w-0">
                                    <div class="@($"h-8 rounded-md border border-primary-200 {css}")"></div>
                                    <div class="mt-0.5 text-[0.6875rem] text-primary-500">@shade</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Текст</h2></div>
        <div class="cm-card">
            <div class="cm-card-body">
                <div class="cm-title-serif mb-2 text-3xl">Маски Ньярлатотепа</div>
                <div class="cm-h4 mb-1">Заголовок раздела (cm-h4)</div>
                <div class="cm-h6 mb-2">Заголовок карточки (cm-h6)</div>
                <p class="mb-2">Обычный текст 14px. Вычитается из физического урона, но не из урона от магии, яда и утопления (стр. 106).</p>
                <p class="cm-text-muted">Приглушённый текст карточки — пояснения и пересказ правил.</p>
                <p class="cm-meta mt-2"><span><span class="cm-meta-label">Эпоха:</span> 1920-е</span><span>·</span><span><span class="cm-meta-label">Источник:</span> Книга Хранителя</span></p>
                <p class="cm-dice mt-2">1d6+БкУ · 2D6+3 · 1д100</p>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Кнопки</h2></div>
        <div class="cm-card">
            <div class="cm-card-body cm-stack">
                <div class="flex flex-wrap items-center gap-2">
                    <Button Icon="fa-floppy-disk">Сохранить</Button>
                    <Button Variant="ButtonVariant.Secondary">Отмена</Button>
                    <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen">Изменить</Button>
                    <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can">Удалить</Button>
                    <Button Variant="ButtonVariant.Error">Удалить навсегда</Button>
                    <Button Variant="ButtonVariant.Success" Icon="fa-check">Одобрить</Button>
                    <Button Variant="ButtonVariant.Warning">Внимание</Button>
                    <Button Variant="ButtonVariant.Ghost">Без фона</Button>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    @* Small вне шапки и плотной таблицы (.cm-table-dense) — те же 44px; 36px только в .cm-topbar. *@
                    <Button Small="true" Icon="fa-plus">Small вне шапки</Button>
                    <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" AriaLabel="Изменить: Кольт .45" />
                    <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" AriaLabel="Удалить: Кольт .45" />
                    <Button Icon="fa-dice-d20" AriaLabel="Бросить кости" />
                    <Button Busy="_busy" Icon="fa-floppy-disk" OnClick="SimulateBusyAsync">@(_busy ? "Сохраняю" : "Долгое действие")</Button>
                    <Button Disabled="@string.IsNullOrWhiteSpace(_name)" DisabledReason="Введите имя сыщика" Icon="fa-user-plus">Создать сыщика</Button>
                    <Button Href="dev/ping" Variant="ButtonVariant.Secondary" Icon="fa-link">Ссылка-кнопка</Button>
                </div>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Метки</h2></div>
        <div class="cm-card">
            <div class="cm-card-body flex flex-wrap items-center gap-2">
                <Badge>Черновик</Badge>
                <Badge Tone="Tone.Info">Отряд</Badge>
                <Badge Tone="Tone.Success" Icon="fa-check">Пройдено</Badge>
                <Badge Tone="Tone.Warning">Серьёзная рана</Badge>
                <Badge Tone="Tone.Error">Без сознания</Badge>
                <Badge Tone="Tone.Stone">Временное безумие</Badge>
                <Badge Tone="Tone.Error" Solid="true">При смерти</Badge>
                <Badge Tone="Tone.Neutral" Solid="true">Мёртв</Badge>
                <Badge Tone="Tone.Stone" Solid="true">Бессрочное безумие</Badge>
                <span class="cm-card-title">НПС сценария<span class="cm-card-count">4</span></span>
                <Button Small="true" Variant="ButtonVariant.Secondary">Заявки<span class="cm-count-badge">3</span></Button>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Сообщения</h2></div>
        <Alert Tone="Tone.Info" Title="Необязательное правило">Книга помечает эти правила как необязательные, поэтому по умолчанию они выключены.</Alert>
        <Alert Tone="Tone.Success" ShowIcon="true">Первая помощь дала 1 временный ПЗ.</Alert>
        <Alert Tone="Tone.Warning" ShowIcon="true" Title="Серьёзная рана">Проверка ВЫН, иначе потеря сознания (стр. 120).</Alert>
        @if (_showClosable)
        {
            <Alert Tone="Tone.Error" ShowIcon="true" Title="Не удалось сохранить" OnClose="() => _showClosable = false">
                <ChildContent>Лист изменён на другом устройстве.</ChildContent>
                <Actions>
                    <Button Small="true" Variant="ButtonVariant.Secondary" Icon="fa-rotate-right">Перечитать</Button>
                </Actions>
            </Alert>
        }
        <Alert Tone="Tone.Stone" Small="true" Icon="fa-brain">Плотный вид для панелей листа.</Alert>
        <Alert Tone="Tone.Neutral" Small="true" class="mb-0">Нейтральное, без нижнего отступа (class="mb-0").</Alert>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Поля</h2></div>
        <div class="cm-card">
            <div class="cm-card-body grid gap-4 md:grid-cols-2">
                <Field Label="Имя сыщика">
                    <input class="cm-input" @bind="_name" placeholder="Харви Уолтерс" />
                </Field>
                <Field Label="Имя обязательное" Required="true" Error="@(string.IsNullOrWhiteSpace(_name) ? "Введите имя сыщика." : null)">
                    <input class="cm-input" @bind="_name" @bind:event="oninput" placeholder="Очистите поле, чтобы увидеть ошибку" />
                </Field>
                <Field Label="Профессия">
                    <select class="cm-input" @bind="_occupation">
                        <option value="">— Выберите —</option>
                        <option>Антиквар</option>
                        <option>Журналист</option>
                        <option>Частный детектив</option>
                    </select>
                </Field>
                <Field Label="СИЛ" Note="От 15 до 90: 3d6 × 5 (стр. 32)." Error="@(_strength is < 15 or > 90 ? "Вне диапазона книги." : null)" class="w-40">
                    <input type="number" class="cm-input cm-input-sm" @bind="_strength" />
                </Field>
                <Field Label="Биография">
                    <textarea class="cm-input" rows="3" placeholder="Родился в Аркхеме…"></textarea>
                </Field>
                <Field Label="Связи" Group="true" Note="Каждая правка отдаёт новый список.">
                    <StringListEditor @bind-Values="_connections" ItemLabel="Связь" Placeholder="Кто или что дорого сыщику" />
                </Field>
                <Field Label="Опции" Group="true">
                    <label class="flex min-h-11 items-center gap-2">
                        <input type="checkbox" class="cm-checkbox" @bind="_optional" />
                        <span>Необязательные правила</span>
                    </label>
                    <div class="flex items-center gap-3">
                        <label class="cm-tap-target" aria-label="Отметка развития"><input type="checkbox" class="cm-checkbox" /></label>
                        <span class="text-[0.8125rem]">Галочка навыка в плотной строке (cm-tap-target)</span>
                    </div>
                </Field>
                <Field Label="Поиск" Inline="true">
                    <input type="search" class="cm-input" placeholder="Поиск по названию…" />
                </Field>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Бросок</h2></div>
        <div class="cm-card">
            <div class="cm-card-body grid gap-4 md:grid-cols-2">
                <Field Label="@($"Скрытность {_skill}%")" Group="true" Note="Вписанное число с настоящих костей — то же, что бросок.">
                    <RollInput Value="_skill" Difficulty="_difficulty" BonusDice="_bonus" PenaltyDice="_penalty"
                               @bind-Roll="_roll" Label="Скрытность" />
                </Field>
                <Field Label="@($"Сумма 2d6: {(_dice?.ToString(CultureInfo.InvariantCulture) ?? "бросит правило")}")" Group="true" Note="DiceInput — сумма NdM: бросить или вписать.">
                    <DiceInput Count="2" Sides="6" Label="Рассудок за 90%" @bind-Value="_dice" />
                </Field>
                <Field Label="Полосы запаса" Group="true" Note="StatBar — участник сцены и лист: цифры всегда, жёлтая на половине, красная на четверти.">
                    <div class="grid grid-cols-2 gap-3">
                        <StatBar Label="ПЗ" Value="11" Max="13" Kind="StatKind.HitPoints" />
                        <StatBar Label="ПЗ" Value="3" Max="13" Kind="StatKind.HitPoints" />
                        <StatBar Label="ПМ" Value="8" Max="14" Kind="StatKind.MagicPoints" />
                        <StatBar Label="Рассудок" Value="40" Max="94" Kind="StatKind.Sanity" />
                    </div>
                </Field>
                <div class="flex flex-wrap items-end gap-3">
                    <Field Label="Сложность" class="w-44">
                        <select class="cm-input" @bind="_difficulty">
                            <option value="@Difficulty.Regular">Обычная</option>
                            <option value="@Difficulty.Hard">Трудная</option>
                            <option value="@Difficulty.Extreme">Чрезвычайная</option>
                        </select>
                    </Field>
                    <Field Label="Бонусные" class="w-24"><input type="number" min="0" max="2" class="cm-input" @bind="_bonus" /></Field>
                    <Field Label="Штрафные" class="w-24"><input type="number" min="0" max="2" class="cm-input" @bind="_penalty" /></Field>
                </div>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Список с фильтром</h2></div>
        <FilterPanel OnReset="ResetFilter">
            <input type="search" class="cm-input min-w-48 flex-1" placeholder="Поиск по названию…" aria-label="Поиск"
                   @bind="_search" @bind:event="oninput" @bind:after="() => _page = 1" />
            <select class="cm-input w-full shrink-0 sm:w-56" aria-label="Навык" @bind="_skillFilter" @bind:after="() => _page = 1">
                <option value="">Все навыки</option>
                @foreach (var skill in Weapons.Select(w => w.Skill).Distinct())
                {
                    <option>@skill</option>
                }
            </select>
        </FilterPanel>

        <Tabs Items="_tabs" @bind-ActiveKey="_tab" AriaLabel="Вид списка" />

        @if (FilteredWeapons.Count == 0)
        {
            <EmptyState Icon="fa-gun" Title="@EmptyState.NoneByFilter("оружия")">
                <Actions>
                    <Button Variant="ButtonVariant.Secondary" OnClick="ResetFilter">Сбросить фильтры</Button>
                </Actions>
            </EmptyState>
        }
        else
        {
            <div class="cm-card">
                @if (_tab == "table")
                {
                    <DataTable Items="PageOfWeapons" RowKey="w => w.Name" AriaLabel="Оружие" @bind-Sort="_sort">
                        <Columns>
                            <DataColumn Title="Название" SortKey="name" Context="w">
                                <span class="font-semibold text-primary-800">@w.Name</span>
                            </DataColumn>
                            <DataColumn Title="Навык" SortKey="skill" Context="w">@w.Skill</DataColumn>
                            <DataColumn Title="Урон" Context="w"><span class="cm-dice">@w.Damage</span></DataColumn>
                            <DataColumn Title="Дальность" SortKey="range" AlignEnd="true" Context="w">@w.Range м</DataColumn>
                            <DataColumn Title="Цена" SortKey="price" AlignEnd="true" Context="w">$@w.Price</DataColumn>
                            <DataColumn Title="" CellClass="w-px whitespace-nowrap" Context="w">
                                <div class="flex justify-end gap-1">
                                    <Button Small="true" Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" AriaLabel="@($"Изменить: {w.Name}")" />
                                    <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" AriaLabel="@($"Удалить: {w.Name}")"
                                            OnClick="() => DeleteAsync(w)" />
                                </div>
                            </DataColumn>
                        </Columns>
                        <RowDetail Context="w">
                            <p class="cm-text-muted">@w.Name: @w.Skill, урон <span class="cm-dice">@w.Damage</span>. Раскрытая строка — подробности без перехода на другую страницу.</p>
                        </RowDetail>
                        <CardTemplate Context="w">
                            <div class="flex items-center gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="font-semibold text-primary-800">@w.Name</div>
                                    <div class="cm-meta"><span>@w.Skill</span><span class="cm-dice">@w.Damage</span><span>@w.Range м</span></div>
                                </div>
                                <Button Small="true" Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" AriaLabel="@($"Изменить: {w.Name}")" />
                                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" AriaLabel="@($"Удалить: {w.Name}")"
                                        OnClick="() => DeleteAsync(w)" />
                            </div>
                        </CardTemplate>
                    </DataTable>
                }
                else
                {
                    @foreach (var weapon in PageOfWeapons)
                    {
                        <div class="flex items-center gap-3 border-t border-primary-200 px-4 py-3 first:border-t-0">
                            <i class="fa-solid fa-gun text-primary-400" aria-hidden="true"></i>
                            <span class="flex-1 font-semibold text-primary-800">@weapon.Name</span>
                            <Badge>@weapon.Skill</Badge>
                        </div>
                    }
                }
            </div>
            <Pagination TotalItems="FilteredWeapons.Count" PageSize="PageSize" @bind-CurrentPage="_page" />
        }
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Загрузка</h2></div>
        <div class="cm-card">
            <div class="cm-card-header">
                <span class="cm-card-title">AsyncContent</span>
                <div class="flex flex-wrap gap-2">
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => ReloadWith(LoadMode.Data)">Данные</Button>
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => ReloadWith(LoadMode.Empty)">Пусто</Button>
                    <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="() => ReloadWith(LoadMode.Failure)">Ошибка</Button>
                </div>
            </div>
            <div class="cm-card-body">
                <AsyncContent @ref="_async" Load="LoadDemoAsync" LoadingMessage="Загружаю сыщиков…" Context="names">
                    <ChildContent>
                        <ul>
                            @foreach (var name in names)
                            {
                                <li class="border-t border-primary-200 py-2 first:border-t-0">@name</li>
                            }
                        </ul>
                    </ChildContent>
                    <Empty>
                        <p class="text-center text-primary-500">В кампании нет сыщиков.</p>
                    </Empty>
                </AsyncContent>
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Текст в Markdown</h2></div>
        <div class="cm-card">
            <div class="cm-card-body">
                <Markdown Text="@MarkdownDemo" />
            </div>
        </div>
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Пустые состояния</h2></div>
        <div class="cm-card">
            <div class="cm-card-body cm-stack">
                <EmptyState Compact="true" Title="@EmptyState.None("книг")" />
                <EmptyState Compact="true" Title="@EmptyState.NoneByFilter("книг")" />
            </div>
        </div>
        <EmptyState Icon="fa-book-open" Title="@EmptyState.None("книг")" />
    </section>

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Диалоги, уведомления, связь</h2></div>
        <div class="cm-card">
            <div class="cm-card-body cm-stack">
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-window-maximize" OnClick="() => _modalOpen = true">Окно</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-hand" OnClick="() => _strictOpen = true">Окно без закрытия мимо</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-table-columns" OnClick="() => _footerOpen = true">Окно с подвалом</Button>
                    <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="ConfirmDeleteAsync">Подтвердить удаление</Button>
                    <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="ConfirmObjectAsync">Удалить с объектом</Button>
                </div>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Secondary" OnClick="@(() => Toasts.Success("Лист сохранён."))">Toast: успех</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="@(() => Toasts.Info("Игрок присоединился к кампании."))">Toast: информация</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="@(() => Toasts.Warning("Навык выше 99 — проверьте лист."))">Toast: внимание</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="@(() => Toasts.Error("Не удалось удалить кампанию.", "Ошибка"))">Toast: ошибка (8 с)</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="@(() => Toasts.Removed("Кольт .45", () => { Toasts.Success("Возвращено: Кольт .45"); return Task.CompletedTask; }))">Toast: «Отменить»</Button>
                </div>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-cloud-arrow-up" OnClick="SimulateSaveAsync">Имитировать запись</Button>
                    <Button Variant="ButtonVariant.Secondary" Icon="fa-plug-circle-xmark" OnClick="Activity.ReportUnreachable">Имитировать обрыв</Button>
                </div>
                <div>
                    <LoadingIndicator Message="Единственный спиннер приложения" />
                </div>
            </div>
        </div>
    </section>

    <UiKitNewParts />
</div>

<Modal Open="_modalOpen" Title="Изменить оружие" Size="ModalSize.Medium" OnClose="() => _modalOpen = false">
    <ChildContent>
        <div class="grid gap-4">
            <Field Label="Название"><input class="cm-input" value="Кольт .45 автоматический" /></Field>
            <Field Label="Урон" Note="Формула костей: 1d10+2, «д» тоже можно."><input class="cm-input cm-dice" value="1d10+2" /></Field>
            @for (var i = 1; i <= 8; i++)
            {
                <p class="cm-text-muted">Длинное содержимое прокручивает тело окна, а шапка и подвал с кнопками остаются на экране (строка @i).</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => _modalOpen = false">Отмена</Button>
        <Button OnClick="SaveModal">Сохранить</Button>
    </Footer>
</Modal>

<Modal Open="_footerOpen" Title="Новая раздатка" Size="ModalSize.Medium" MinHeight="22rem" OnClose="() => _footerOpen = false">
    <ChildContent>
        <div class="grid gap-4">
            <Field Label="Название" Required="true" Error="@(_footerName.Length == 0 && _footerTried ? "Введите название." : null)">
                <input class="cm-input" @bind="_footerName" @bind:event="oninput" />
            </Field>
            <p class="cm-text-muted">Фокус открытия — в первое поле, а не на «Закрыть». Высота тела зарезервирована: MinHeight.</p>
        </div>
    </ChildContent>
    <FooterError>
        <Alert Tone="Tone.Error" Small="true">Сервер ответил отказом: имя занято.</Alert>
    </FooterError>
    <FooterHint>@(_footerName.Length == 0 ? "Введите название" : null)</FooterHint>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="() => _footerOpen = false">Отмена</Button>
        <Button Disabled="@(_footerName.Length == 0)" OnClick="() => { _footerTried = true; _footerOpen = _footerName.Length == 0; }">Создать</Button>
    </Footer>
</Modal>

<Modal Open="_strictOpen" Title="Проверка ВЫН умирающего" Size="ModalSize.Small" Dismissible="false" OnClose="() => _strictOpen = false">
    <ChildContent>
        <p>Касание мимо окна и Esc его не закрывают — только крестик или кнопка.</p>
    </ChildContent>
    <Footer>
        <Button OnClick="() => _strictOpen = false">Готово</Button>
    </Footer>
</Modal>

@code {
    private const int PageSize = 5;
    private bool _footerOpen;
    private bool _footerTried;
