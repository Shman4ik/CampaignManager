    private IEnumerable<DemoWeapon> Weapons => _weapons;

    // Список постраничный, поэтому сортирует страница (как сделал бы API), а таблица только
    // сообщает колонку: @bind-Sort. Непостраничной таблице хватит SortBy у колонки.
    private List<DemoWeapon> FilteredWeapons
    {
        get
        {
            var filtered = _weapons
                .Where(w => string.IsNullOrWhiteSpace(_search) || w.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
                .Where(w => _skillFilter.Length == 0 || w.Skill == _skillFilter);
            Func<DemoWeapon, object> key = _sort.Key switch
            {
                "skill" => w => w.Skill,
                "range" => w => w.Range,
                "price" => w => w.Price,
                _ => w => w.Name,
            };
            return (_sort.Descending ? filtered.OrderByDescending(key) : filtered.OrderBy(key)).ToList();
        }
    }

    private IEnumerable<DemoWeapon> PageOfWeapons => FilteredWeapons.Skip((_page - 1) * PageSize).Take(PageSize);

    private void ResetFilter()
    {
        _search = null;
        _skillFilter = "";
        _page = 1;
    }

    private void ResetDemo()
    {
        ResetFilter();
        _weapons.Clear();
        _weapons.AddRange(AllWeapons);
        _showClosable = true;
        _roll = null;
        Toasts.Info("Пример сброшен.");
    }

    private async Task SimulateBusyAsync()
    {
        _busy = true;
        await Task.Delay(1500);
        _busy = false;
    }

    private async Task SimulateSaveAsync()
    {
        using (Activity.BeginWrite())
        {
            await Task.Delay(1200);
        }

        Activity.ReportReachable(saved: true);
    }

    private async Task DeleteAsync(DemoWeapon weapon)
    {
        if (await Dialogs.ConfirmDeleteAsync("Удалить оружие?", $"«{weapon.Name}» будет удалено из справочника."))
        {
            _weapons.Remove(weapon);
            _page = Math.Min(_page, Math.Max(1, (FilteredWeapons.Count + PageSize - 1) / PageSize));
            Toasts.Success($"«{weapon.Name}» удалено.");
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        var confirmed = await Dialogs.ConfirmDeleteAsync("Удалить кампанию?", "«Маски Ньярлатотепа» и журнал встреч будут удалены.");
        Toasts.Show(confirmed ? Tone.Success : Tone.Info, confirmed ? "Подтверждено." : "Отменено.");
    }

    private async Task ConfirmObjectAsync()
    {
        var confirmed = await Dialogs.ConfirmDeleteAsync("оружие", "«Кольт .45 автоматический»", "Пропадёт из справочника и со всех листов.", reversible: false);
        Toasts.Show(confirmed ? Tone.Success : Tone.Info, confirmed ? "Подтверждено." : "Отменено.");
    }

    private void SaveModal()
    {
        _modalOpen = false;
        Toasts.Success("Оружие сохранено.");
    }

    private Task ReloadWith(LoadMode mode)
    {
        _loadMode = mode;
        return _async?.ReloadAsync() ?? Task.CompletedTask;
    }

    private async Task<IReadOnlyList<string>> LoadDemoAsync(CancellationToken cancellationToken)
    {
        await Task.Delay(800, cancellationToken);
        return _loadMode switch
        {
            LoadMode.Failure => throw new HttpRequestException("Нет связи"),
            LoadMode.Empty => [],
            _ => ["Харви Уолтерс", "Нора Флинн", "Ли Чан"],
        };
    }

    private enum LoadMode
    {
        Data,
        Empty,
        Failure,
    }

