@page "/dev/files"
@using CampaignManager.Contracts.Files
@using Microsoft.AspNetCore.Components.Forms
@inject IFilesApi FilesApi

@*
    Проверка модуля файлов (T1.5): загрузка через ApiClient, отдача картинки и звука со своего
    origin, перемотка трека (Range) и отчёт о сиротах. Настоящие экраны — у модулей (фонотека T2.8,
    админка T2.9); здесь только сквозная проверка, как /dev/ping.
*@
<PageTitle>Проверка файлов</PageTitle>

<h1 class="mb-2 text-2xl font-semibold">Проверка файлов</h1>
<p class="mb-4 text-slate-600">
    Загрузка → <code>POST @FilesRoutes.Upload</code> → MinIO; отдача — <code>GET /api/v1/files/{id}</code> с Range.
</p>

@if (_error is not null)
{
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-red-800" role="alert">@_error</div>
}

<section class="mb-6 rounded-md border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-lg font-semibold">Загрузить</h2>
    <div class="flex flex-wrap items-center gap-3">
        <label class="inline-flex min-h-11 cursor-pointer items-center rounded-md bg-slate-600 px-4 text-white">
            @(_busy ? "Загружаю…" : "Выбрать файлы")
            <InputFile class="sr-only" multiple accept="image/*,audio/*" OnChange="UploadAsync" disabled="@_busy" />
        </label>
        <span class="text-sm text-slate-500">Картинки и звук, до 50 МБ. Тот же файл второй раз даст ту же строку.</span>
    </div>

    <form class="mt-4 flex flex-wrap items-center gap-3" @onsubmit="AddExternalAsync">
        <input class="min-h-11 min-w-0 flex-1 rounded-md border border-slate-300 px-3" type="url"
               placeholder="https://… — картинка снаружи" @bind="_externalUrl" />
        <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-slate-300 px-4"
                disabled="@_busy">Добавить адрес</button>
    </form>
</section>

@if (_files.Count > 0)
{
    <section class="mb-6 rounded-md border border-slate-200 bg-white p-4" data-testid="uploaded-files">
        <h2 class="mb-3 text-lg font-semibold">Загружено</h2>
        @foreach (var file in _files)
        {
            <div class="border-t border-t-slate-200 py-3 first:border-t-0" data-file-id="@file.Id">
                <div class="mb-2 flex flex-wrap gap-x-4 text-sm">
                    <span class="font-medium">@(file.OriginalName ?? file.ExternalUrl)</span>
                    <span class="text-slate-500">@file.ContentType</span>
                    @if (file.SizeBytes is { } size)
                    {
                        <span class="text-slate-500">@FormatSize(size)</span>
                    }
                    <a class="text-slate-700 underline" href="@file.Url" target="_blank">@file.Url</a>
                </div>
                @if (file.ContentType?.StartsWith("audio/", StringComparison.Ordinal) == true)
                {
                    <audio class="w-full" controls preload="metadata" src="@file.Url"></audio>
                }
                else
                {
                    <img class="max-h-64 max-w-full rounded-md" src="@file.Url" alt="@file.OriginalName" />
                }
            </div>
        }
    </section>
}

<section class="mb-6 rounded-md border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-lg font-semibold">Сироты</h2>
    <p class="mb-3 text-sm text-slate-600">
        Файлы старше суток, на которые никто не ссылается. Сначала отчёт, удаление — отдельной кнопкой
        и только того, что в отчёте.
    </p>
    <div class="flex flex-wrap gap-3">
        <button type="button" class="inline-flex min-h-11 items-center rounded-md border border-slate-300 px-4"
                disabled="@_busy" @onclick="LoadOrphansAsync">Найти сирот</button>
        @if (_orphans is { Files.Count: > 0 } report)
        {
            <button type="button" class="inline-flex min-h-11 items-center rounded-md bg-red-700 px-4 text-white"
                    disabled="@_busy" @onclick="DeleteOrphansAsync">
                Удалить @report.Files.Count (@FormatSize(report.TotalBytes))
            </button>
        }
    </div>

    @if (_orphans is { } orphans)
    {
        @if (orphans.Files.Count == 0)
        {
            <p class="mt-3 text-slate-600">Сирот нет.</p>
        }
        else
        {
            <div class="mt-3 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="text-slate-500"><th class="py-2 pr-4">Файл</th><th class="py-2 pr-4">Тип</th><th class="py-2 pr-4">Размер</th><th class="py-2">Загружен</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var file in orphans.Files)
                        {
                            <tr class="border-t border-t-slate-200">
                                <td class="py-2 pr-4">@(file.OriginalName ?? file.ExternalUrl)</td>
                                <td class="py-2 pr-4">@file.ContentType</td>
                                <td class="py-2 pr-4">@(file.SizeBytes is { } size ? FormatSize(size) : "—")</td>
                                <td class="py-2">@file.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm", CultureInfo.CurrentCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (_deleted is { } deleted)
    {
        <p class="mt-3 text-slate-600">
            Удалено: @deleted.Deleted.Count. Пропущено (уже не сироты): @deleted.Skipped.Count.
            @if (deleted.ObjectsNotDeleted.Count > 0)
            {
                <span>Объекты не удалились: @string.Join(", ", deleted.ObjectsNotDeleted).</span>
            }
        </p>
    }
</section>

@code {
    private const long MaxUploadBytes = 50L * 1024 * 1024;

    private readonly List<StoredFileDto> _files = [];
    private OrphanFilesReport? _orphans;
    private DeleteOrphansResponse? _deleted;
    private string? _externalUrl;
    private string? _error;
    private bool _busy;

    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        foreach (var browserFile in e.GetMultipleFiles(maximumFileCount: 20))
        {
            await using var stream = browserFile.OpenReadStream(MaxUploadBytes);
            Add(await FilesApi.UploadAsync(stream, browserFile.Name));
        }
    });

    private Task AddExternalAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_externalUrl))
        {
            return;
        }

        Add(await FilesApi.AddExternalAsync(_externalUrl));
        _externalUrl = null;
    });

    private Task LoadOrphansAsync() => RunAsync(async () =>
    {
        _deleted = null;
        _orphans = await FilesApi.GetOrphansAsync();
    });

    private Task DeleteOrphansAsync() => RunAsync(async () =>
    {
        if (_orphans is null)
        {
            return;
        }

        _deleted = await FilesApi.DeleteOrphansAsync([.. _orphans.Files.Select(f => f.Id)]);
        _orphans = await FilesApi.GetOrphansAsync();
    });

    private void Add(StoredFileDto file)
    {
        _files.RemoveAll(f => f.Id == file.Id);
        _files.Insert(0, file);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} МБ",
        >= 1024 => $"{bytes / 1024.0:0} КБ",
        _ => $"{bytes} Б",
    };
}
