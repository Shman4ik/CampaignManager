@page "/dev/files"
@using CampaignManager.Contracts.Files
@using Microsoft.AspNetCore.Components.Forms
@inject IFilesApi FilesApi

@*
    Проверка модуля файлов (T1.5): загрузка через ApiClient, отдача картинки и звука со своего
    origin, перемотка трека (Range). Настоящие экраны — у модулей (фонотека T2.8); сироты — в админке,
    /admin/files (T2.9). Здесь только сквозная проверка, как /dev/ping.
*@
<PageHeader Title="Проверка файлов" />

<div class="cm-page">
    <p class="cm-text-muted mb-4">
        Загрузка → <code class="font-mono">POST @FilesRoutes.Upload</code> → MinIO; отдача — <code class="font-mono">GET /api/v1/files/{id}</code> с Range.
        Сироты — в админке: <a class="text-accent-700 underline" href="admin/files">Файлы</a>.
    </p>

    @if (_error is not null)
    {
        <Alert Tone="Tone.Error" ShowIcon="true" OnClose="() => _error = null">@_error</Alert>
    }

    <section class="cm-section">
        <div class="cm-section-header"><h2 class="cm-section-title">Загрузить</h2></div>
        <div class="cm-card">
            <div class="cm-card-body cm-stack">
                <div class="flex flex-wrap items-center gap-3">
                    @* InputFile прячется под подписью-кнопкой: у самого поля нет тап-цели. *@
                    <label class="@Css.Join("cm-btn cm-btn-primary", _busy ? "pointer-events-none opacity-70" : null)">
                        <i class="fa-solid fa-upload" aria-hidden="true"></i>
                        <span>@(_busy ? "Загружаю…" : "Выбрать файлы")</span>
                        <InputFile class="sr-only" multiple accept="image/*,audio/*" OnChange="UploadAsync" disabled="@_busy" />
                    </label>
                    <span class="text-[0.8125rem] text-primary-500">Картинки и звук, до 50 МБ. Тот же файл второй раз даст ту же строку.</span>
                </div>

                <form class="flex flex-wrap items-center gap-3" @onsubmit="AddExternalAsync">
                    <input class="cm-input min-w-48 flex-1" type="url" aria-label="Адрес картинки"
                           placeholder="https://… — картинка снаружи" @bind="_externalUrl" />
                    <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="fa-link" Disabled="@_busy">Добавить адрес</Button>
                </form>
            </div>
        </div>
    </section>

    @if (_files.Count > 0)
    {
        <section class="cm-section">
            <div class="cm-section-header"><h2 class="cm-section-title">Загружено</h2></div>
            <div class="cm-card" data-testid="uploaded-files">
                @foreach (var file in _files)
                {
                    <div class="border-t border-primary-200 px-4 py-3 first:border-t-0" data-file-id="@file.Id">
                        <div class="cm-meta mb-2">
                            <span class="font-semibold text-primary-800">@(file.OriginalName ?? file.ExternalUrl)</span>
                            <span>@file.ContentType</span>
                            @if (file.SizeBytes is { } size)
                            {
                                <span>@FormatSize(size)</span>
                            }
                            <a class="break-all" href="@file.Url" target="_blank">@file.Url</a>
                        </div>
                        @if (file.ContentType?.StartsWith("audio/", StringComparison.Ordinal) == true)
                        {
                            <audio class="w-full" controls preload="metadata" src="@file.Url"></audio>
                        }
                        else
                        {
                            <img class="max-h-64 max-w-full rounded-md" src="@file.Url" alt="@file.OriginalName" />
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private const long MaxUploadBytes = 50L * 1024 * 1024;

    private readonly List<StoredFileDto> _files = [];
    private string? _externalUrl;
    private string? _error;
    private bool _busy;

    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        foreach (var browserFile in e.GetMultipleFiles(maximumFileCount: 20))
        {
            await using var stream = browserFile.OpenReadStream(MaxUploadBytes);
            Add(await FilesApi.UploadAsync(stream, browserFile.Name));
        }
    });

    private Task AddExternalAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_externalUrl))
        {
            return;
        }

        Add(await FilesApi.AddExternalAsync(_externalUrl));
        _externalUrl = null;
    });

    private void Add(StoredFileDto file)
    {
        _files.RemoveAll(f => f.Id == file.Id);
        _files.Insert(0, file);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} МБ",
        >= 1024 => $"{bytes / 1024.0:0} КБ",
        _ => $"{bytes} Б",
    };
}
