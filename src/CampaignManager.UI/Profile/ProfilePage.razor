@page "/profile"
@attribute [Authorize]
@using CampaignManager.Contracts.Profile
@using CampaignManager.Core.Identity
@using CampaignManager.UI.Platform
@inject IProfileApi Api
@inject IUserSession Session
@inject ToastService Toasts
@inject DialogService Dialogs

@* Личный кабинет: имя, роль и заявка на Хранителя. Его видит и игрок — проверять и на телефоне. Данные только свои:
   сервер берёт пользователя из сессии. Архетип «форма страницей»: одна колонка max-w-2xl у левого края (справа ничего:
   «Мои игры» и абзац «Мои данные» убраны — PR1, PR2). Знание — Profile/CLAUDE.md. *@
<PageHeader Title="Кабинет" />

<div class="cm-page">
    <AsyncContent @ref="_content" Load="LoadAsync" LoadingMessage="Загружаю кабинет…" Context="loaded">
        @{
            var profile = _profile ?? loaded;
        }
        @* Формы — колонкой по содержимому (max-w-2xl) у левого края: во всю колонку поле имени тянулось на ~1000px. *@
        <div>
            <div class="max-w-2xl">
                <section class="cm-section" aria-labelledby="profile-title">
                    <div class="cm-section-header"><h2 id="profile-title" class="cm-section-title">Профиль</h2></div>
                    <div class="cm-card">
                        <div class="cm-card-body cm-stack">
                            @* Имя — только полем ниже, без заголовка-дубля (PR4); здесь — почта и роль. *@
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="cm-avatar cm-avatar-lg" aria-hidden="true">@Initial(profile.DisplayName)</span>
                                <div class="min-w-0 flex-1 basis-40">
                                    <div class="truncate text-primary-700" data-testid="profile-email">@profile.Email</div>
                                </div>
                                <Badge Tone="RoleLabels.RoleTone(profile.Role)">@RoleLabels.Role(profile.Role)</Badge>
                            </div>

                            <form class="flex flex-col gap-3" @onsubmit="SaveNameAsync">
                                <Field Label="Отображаемое имя" Note="Так вас видят в меню и в кампаниях, где у вас нет своего имени.">
                                    <input class="cm-input" maxlength="@ProfileLimits.DisplayNameLength" autocomplete="nickname"
                                           data-testid="profile-name" @bind="_name" @bind:event="oninput" />
                                </Field>

                                @if (profile.AliasCount > 0)
                                {
                                    <label class="cm-tap-row">
                                        <input type="checkbox" class="cm-checkbox" @bind="_replaceAliases" data-testid="replace-aliases" />
                                        <span class="text-sm">
                                            <span class="block text-primary-800">
                                                Применить ко всем кампаниям
                                                <span class="text-primary-500">(в @AliasCampaigns(profile.AliasCount) сейчас своё имя)</span>
                                            </span>
                                        </span>
                                    </label>
                                }

                                @if (_nameError is not null)
                                {
                                    <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0">@_nameError</Alert>
                                }

                                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                                    <Button Type="submit" Icon="fa-floppy-disk" Busy="_savingName" Disabled="@(!NameChanged(profile))" DisabledReason="Измените имя, чтобы сохранить">Сохранить имя</Button>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>

                @* «Роль» нужна, только пока человек может подать заявку на Хранителя; иначе роль уже названа бейджем профиля. *@
                @if (profile.Role is UserRole.Player)
                {
                    <section class="cm-section" aria-labelledby="role-title">
                        <div class="cm-section-header"><h2 id="role-title" class="cm-section-title">Заявка на роль Хранителя</h2></div>
                        <div class="cm-card">
                            <div class="cm-card-body cm-stack">
                                @if (profile.LatestApplication is { } application)
                                {
                                    <div data-testid="application-status">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <Badge Tone="RoleLabels.StatusTone(application.Status)">@ApplicationLabel(application.Status)</Badge>
                                            <span class="text-sm text-primary-500">от @LocalTime.Date(application.CreatedAt)</span>
                                            @* «Отозвать» — отдельно от «Сохранить текст»: две кнопки с опасной в одной строке слипались на 8px (PR3). *@
                                            @if (application.Status is KeeperApplicationStatus.Pending)
                                            {
                                                <Button Small="true" Variant="ButtonVariant.OutlineError" Icon="fa-rotate-left" Disabled="_applying" class="ml-auto"
                                                        data-testid="withdraw" OnClick="WithdrawAsync">Отозвать заявку</Button>
                                            }
                                        </div>
                                        @if (application.Status is KeeperApplicationStatus.Rejected && application.ReviewComment is { } comment)
                                        {
                                            <p class="mt-2 text-sm text-primary-700"><span class="cm-meta-label">Комментарий:</span> @comment</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-sm text-primary-600">Хранитель ведёт кампании и сценарии. Хотите вести игры — подайте заявку, администратор её рассмотрит.</p>
                                }

                                @if (profile.LatestApplication is { Status: KeeperApplicationStatus.Pending })
                                {
                                    <form class="flex flex-col gap-3" @onsubmit="UpdateApplicationAsync" data-testid="application-edit">
                                        <Field Label="Сообщение администратору" Note="Что хотите вести, с кем играете.">
                                            <textarea class="cm-input" rows="3" maxlength="@ProfileLimits.ApplicationMessageLength"
                                                      @bind="_pendingMessage" @bind:event="oninput"></textarea>
                                        </Field>
                                        @if (_applyError is not null)
                                        {
                                            <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0">@_applyError</Alert>
                                        }
                                        <div class="cm-btn-row">
                                            <Button Type="submit" Icon="fa-floppy-disk" Busy="_applying"
                                                    Disabled="@(string.Equals(_pendingMessage?.Trim() ?? "", profile.LatestApplication.Message, StringComparison.Ordinal))"
                                                    DisabledReason="Измените текст, чтобы сохранить">Сохранить текст</Button>
                                        </div>
                                    </form>
                                }

                                @if (profile.CanApply)
                                {
                                    <form class="flex flex-col gap-3" @onsubmit="ApplyAsync">
                                        <Field Label="Сообщение администратору" Note="Что хотите вести, с кем играете.">
                                            <textarea class="cm-input" rows="3" maxlength="@ProfileLimits.ApplicationMessageLength"
                                                      @bind="_message"></textarea>
                                        </Field>
                                        @if (_applyError is not null)
                                        {
                                            <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0">@_applyError</Alert>
                                        }
                                        <div class="cm-btn-row">
                                            <Button Type="submit" Icon="fa-paper-plane" Busy="_applying">
                                                @(profile.LatestApplication is null ? "Подать заявку на Хранителя" : "Подать заявку снова")
                                            </Button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>

            @* Что хранится о человеке — на странице «Правовая информация», а не абзацем в кабинете (PR1). *@
            <p class="cm-text-muted text-sm">
                <a href="legal" class="inline-flex min-h-8 items-center underline hover:no-underline" data-testid="legal-link">Подробнее о ваших данных — в правовой информации</a>
            </p>
        </div>
    </AsyncContent>
</div>

@code {
    /// <summary>«1 кампании», «2 кампаниях», «5 кампаниях»: предложный падеж после «в».</summary>
    private static string AliasCampaigns(int count) =>
        count % 10 == 1 && count % 100 != 11 ? $"{count} кампании" : $"{count} кампаниях";

    private AsyncContent<ProfileDto>? _content;
    private ProfileDto? _profile;
    private string _name = "";
    // Выключено намеренно: имена в кампаниях нарочно разные («Дима» в одной, полное имя в другой),
    // и смена имени в кабинете не должна молча их выравнивать.
    private bool _replaceAliases;
    private string? _message;
    private string? _pendingMessage;
    private string? _nameError;
    private string? _applyError;
    private bool _savingName;
    private bool _applying;

    private async Task<ProfileDto> LoadAsync(CancellationToken cancellationToken)
    {
        Show(await Api.GetProfileAsync(cancellationToken));
        return _profile!;
    }

    private void Show(ProfileDto profile)
    {
        _profile = profile;
        _name = profile.DisplayName;
        _pendingMessage = profile.LatestApplication is { Status: KeeperApplicationStatus.Pending } pending ? pending.Message : null;
        _replaceAliases = false;
    }

    // Сохранять есть что: новое имя или сброс имён в кампаниях (его можно сделать и со старым именем).
    private bool NameChanged(ProfileDto profile) =>
        (!string.IsNullOrWhiteSpace(_name) && !string.Equals(_name.Trim(), profile.DisplayName, StringComparison.Ordinal))
        || _replaceAliases;

    private async Task SaveNameAsync()
    {
        if (_profile is null || _savingName)
        {
            return;
        }

        _savingName = true;
        _nameError = null;
        try
        {
            var replaced = _replaceAliases ? _profile.AliasCount : 0;
            Show(await Api.UpdateDisplayNameAsync(new UpdateDisplayNameRequest(_name, _replaceAliases)));
            Toasts.Success(replaced > 0 ? $"Имя сохранено. Своё имя сброшено в кампаниях: {replaced}." : "Имя сохранено:", subject: replaced > 0 ? null : _profile?.DisplayName);
            // Меню показывает имя из /api/v1/me — перечитать, без перезагрузки приложения.
            await Session.RefreshAsync();
        }
        catch (HttpRequestException ex)
        {
            _nameError = ApiErrors.Describe(ex);
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (_applying)
        {
            return;
        }

        _applying = true;
        _applyError = null;
        try
        {
            Show(await Api.SubmitKeeperApplicationAsync(new SubmitKeeperApplicationRequest(_message)));
            _message = null;
            Toasts.Success("Заявка отправлена — администратор её рассмотрит.");
        }
        catch (HttpRequestException ex)
        {
            _applyError = ApiErrors.Describe(ex);
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task UpdateApplicationAsync()
    {
        if (_applying)
        {
            return;
        }

        _applying = true;
        _applyError = null;
        try
        {
            Show(await Api.UpdateKeeperApplicationAsync(new SubmitKeeperApplicationRequest(_pendingMessage)));
            Toasts.Success("Текст заявки сохранён.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // Заявку успели рассмотреть: форма над ней больше не нужна.
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось сохранить");
            Show(await Api.GetProfileAsync());
        }
        catch (HttpRequestException ex)
        {
            _applyError = ApiErrors.Describe(ex);
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task WithdrawAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Отозвать заявку?", "Администратор её не увидит. Подать новую можно в любой момент.")
        {
            ConfirmText = "Отозвать",
        });
        if (!confirmed || _applying)
        {
            return;
        }

        _applying = true;
        _applyError = null;
        try
        {
            Show(await Api.WithdrawKeeperApplicationAsync());
            Toasts.Success("Заявка отозвана.");
        }
        catch (HttpRequestException ex)
        {
            // Администратор успел решить: покажем актуальное состояние, а не оставим форму над рассмотренной заявкой.
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось отозвать");
            Show(await Api.GetProfileAsync());
        }
        finally
        {
            _applying = false;
        }
    }

    private static string ApplicationLabel(KeeperApplicationStatus status) => status switch
    {
        KeeperApplicationStatus.Pending => "Заявка на рассмотрении",
        KeeperApplicationStatus.Approved => "Заявка одобрена",
        _ => "Заявка отклонена",
    };

    private static string Initial(string name) =>
        name.Length > 0 ? char.ToUpper(name[0], CultureInfo.CurrentCulture).ToString() : "?";

    // Выход — серверный адрес: полная загрузка, после неё приложение стартует уже без сессии.
}
