<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Razor-компоненты и страницы, дизайн-система (Tailwind), JS-модули. Ходит только в интерфейсы
    Contracts и в Core — ни в Data, ни в Server (проверяет ArchitectureTests в Server.Tests).
  -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Core\CampaignManager.Core.csproj" />
    <ProjectReference Include="..\CampaignManager.Contracts\CampaignManager.Contracts.csproj" />
  </ItemGroup>

  <!--
    Tailwind v4: токены — @theme в Styles/theme.css, конфига tailwind.config.js нет. Пакеты —
    в package.json рядом, версии закреплены package-lock.json: v4 тянет нативные модули
    (oxide, lightningcss), и `@import "tailwindcss"` должен разрешаться из node_modules проекта.
    npm ci ставит их один раз — заново, только если поменялся lock-файл.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;package-lock.json" />
  </ItemGroup>

  <ItemGroup>
    <Watch Include="./Styles/*.css" Exclude="./wwwroot/**/*;obj/**/*;bin/**/*" />
  </ItemGroup>

  <!--
    wwwroot/styles.css собирается Tailwind на каждой сборке и в git не лежит; сервер отдаёт его
    как _content/CampaignManager.UI/styles.css. Таргет перенесён из v1 со всеми его оговорками
    (корневой CLAUDE.md, «Tailwind CSS»):
    - генерация обязана пройти до ResolveProjectStaticWebAssets — он питается @(Content) и сам
      висит на BeforeTargets="AssignTargetPaths";
    - файл добавляется в @(Content) руками: глоб wwwroot/** раскрывается при вычислении проекта,
      и файл, созданный позже, до статических ассетов не доходит — сборка и деплой проходят,
      а сайт отдаёт 404 на стили;
    - и он же убирается из глоба при вычислении: со второй сборки файл уже на диске, глоб его
      подбирает, Include в таргете добавляет вторую копию, и статические ассеты падают с
      «Two assets found targeting the same path». Убирать внутри таргета поздно.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\styles.css" />
  </ItemGroup>

  <!--
    Нативные модули ставятся под платформу из настройки npm `os`. Если она задана глобально
    (в ~/.npmrc владельца стоит os=linux), на Windows приезжают модули Linux и сборка CSS падает
    с «Cannot find module lightningcss.win32-x64-msvc.node» — поэтому на Windows платформа
    указывается явно. Вывод npm в предупреждения MSBuild не превращается: решает код возврата.
  -->
  <PropertyGroup>
    <NpmEnvironment Condition="$([MSBuild]::IsOSPlatform('Windows'))">npm_config_os=win32</NpmEnvironment>
  </PropertyGroup>

  <Target Name="TailwindInstall"
          Inputs="package-lock.json"
          Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" EnvironmentVariables="$(NpmEnvironment)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="Tailwind" DependsOnTargets="TailwindInstall" BeforeTargets="ResolveProjectStaticWebAssets">
    <Exec Condition="'$(Configuration)' != 'Release'"
          Command="npx --no -- tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/styles.css"
          IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="'$(Configuration)' == 'Release'"
          Command="npx --no -- tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/styles.css --minify"
          IgnoreStandardErrorWarningFormat="true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/styles.css')"
           Text="Tailwind did not produce wwwroot/styles.css." />
    <ItemGroup>
      <Content Remove="wwwroot\styles.css" />
      <Content Include="wwwroot\styles.css" />
    </ItemGroup>
  </Target>

</Project>
