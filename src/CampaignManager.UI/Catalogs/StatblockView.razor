@using CampaignManager.Core.Catalogs

@* Статблок твари как в книге (гл. 14, стр. 277–280). Короткие числа (СИЛ…МОЩ, ПЗ, ПМ) — сеткой,
   число колонок считает ширина (auto-fill); строки с оговорками (бонус к урону, скорость, атаки за
   раунд, броня, уклонение, потеря рассудка) — каждая во всю ширину: длинные оговорки рвали
   двухколоночную сетку. Своей карточки не рисует.

   Пустой статблок (игроку сервер его не отдаёт — решение владельца 2026-10-03: игроку название, картинка, описание)
   не рисуется вовсе: ни «Характеристик» с нулями, ни «Броня: нет», ни «Ср. комплекция: 0». Секция без содержимого
   тоже не рисуется (правило 4). Подписи — из словаря Terms. *@
@if (!IsBlank(Statblock))
{
<div class="grid gap-4 text-sm">
    @if (ShortStats.Any())
    {
    <section>
        <h3 class="cm-section-title mb-1">Характеристики</h3>
        <dl class="grid grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))] gap-2">
            @foreach (var (label, value, dice) in ShortStats)
            {
                <div class="rounded-md border border-primary-200 px-2 py-1 text-center">
                    <dt class="text-[0.6875rem] font-bold tracking-wide text-primary-500">@label</dt>
                    <dd class="text-base font-semibold text-primary-800">@value</dd>
                    @if (dice is not null)
                    {
                        <dd class="cm-dice text-[0.6875rem] leading-tight text-primary-500 [overflow-wrap:anywhere]">@dice</dd>
                    }
                </div>
            }
        </dl>
    </section>
    }

    <dl class="grid gap-0.5">
        @foreach (var (label, value, note) in Lines)
        {
            @* Оговорка книги («не погибает, а уходит…») — своей строкой под числом: в одной строке она рвала сетку. *@
            <div>
                <dt class="cm-meta-label inline">@label: </dt><dd class="inline">@value</dd>
                @if (!string.IsNullOrWhiteSpace(note))
                {
                    <dd class="block text-primary-600">@note</dd>
                }
            </div>
        }
    </dl>

    @if (Statblock.Attacks.Count > 0)
    {
        <section>
            <h3 class="cm-section-title mb-1">Атаки</h3>
            <ul class="grid gap-1">
                @foreach (var attack in Statblock.Attacks)
                {
                    @* Строка как в книге: «Когти 60% (30/12), урон 2d6 + БкУ» (стр. 278). *@
                    <li>
                        <span class="font-semibold">@attack.Name</span>@(" ")
                        @if (attack.SkillValue > 0)
                        {
                            <span class="text-primary-600">@($"{attack.SkillValue}% ({attack.SkillValue / 2}/{attack.SkillValue / 5}), урон ")<span class="cm-dice">@CatalogText.Damage(attack)</span></span>
                        }
                        else
                        {
                            <span class="text-primary-600">— без броска, см. описание</span>
                        }
                        @if (attack.Kind != CreatureAttackKind.Melee)
                        {
                            <Badge Tone="Tone.Stone" class="ml-1">@CatalogText.Of(attack.Kind)</Badge>
                        }
                        @if (!string.IsNullOrWhiteSpace(attack.Description))
                        {
                            <span class="ml-4 block text-primary-500">@attack.Description</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (Statblock.SpecialAbilities.Count > 0)
    {
        <section>
            <h3 class="cm-section-title mb-1">Особые умения</h3>
            @foreach (var ability in Statblock.SpecialAbilities)
            {
                <p class="mb-1"><span class="font-semibold">@ability.Name:</span> @ability.Text</p>
            }
        </section>
    }

    @if (Statblock.Skills.Count > 0)
    {
        <section>
            <h3 class="cm-section-title mb-1">Навыки</h3>
            <p>@string.Join(", ", Statblock.Skills.Select(s => string.IsNullOrWhiteSpace(s.Note) ? $"{s.Name} {s.Value}%" : $"{s.Name} {s.Value}% ({s.Note})"))</p>
        </section>
    }
</div>
}

@code {
    [Parameter, EditorRequired] public Statblock Statblock { get; set; } = null!;

    /// <summary>
    /// Статблок без единого значения — так выглядит то, что игроку не отдали (или тварь, которую ещё не заполнили).
    /// Показывать нечего: нули и «нет» ввели бы в заблуждение.
    /// </summary>
    public static bool IsBlank(Statblock s) =>
        s.Str.Value <= 0 && s.Con.Value <= 0 && s.Siz.Value <= 0 && s.Dex.Value <= 0 && s.Int.Value <= 0 && s.Pow.Value <= 0
        && s.HitPoints <= 0 && s.MagicPoints <= 0 && s.Armor <= 0 && string.IsNullOrWhiteSpace(s.ArmorNote)
        && s.Dodge <= 0 && s.Initiative <= 0 && string.IsNullOrWhiteSpace(s.SanityLoss) && (string.IsNullOrWhiteSpace(s.DamageBonus) || s.DamageBonus == "0") && s.Build <= 0
        && s.Attacks.Count == 0 && s.SpecialAbilities.Count == 0 && s.Skills.Count == 0 && Speed(s.Speed) is null;

    private IEnumerable<(string Label, int Value, string? Dice)> ShortStats
    {
        get
        {
            var s = Statblock;
            (string, StatValue)[] stats = [("СИЛ", s.Str), ("ВЫН", s.Con), ("ТЕЛ", s.Siz), ("ЛВК", s.Dex), ("ИНТ", s.Int), ("МОЩ", s.Pow)];
            foreach (var (label, stat) in stats.Where(x => x.Item2.Value > 0))
            {
                yield return (label, stat.Value, stat.Dice);
            }

            if (s.HitPoints > 0)
            {
                yield return ("ПЗ", s.HitPoints, null);
            }

            if (s.MagicPoints > 0)
            {
                yield return ("ПМ", s.MagicPoints, null);
            }
        }
    }

    private IEnumerable<(string Label, string Value, string? Note)> Lines
    {
        get
        {
            var s = Statblock;
            yield return (Terms.DamageBonusTitle, string.IsNullOrWhiteSpace(s.DamageBonus) ? "0" : s.DamageBonus, null);
            yield return (Terms.Build, s.Build.ToString(System.Globalization.CultureInfo.CurrentCulture), null);
            if (Speed(s.Speed) is { } speed)
            {
                yield return (Terms.Speed, speed, null);
            }

            yield return (Terms.AttacksPerRound, $"{s.AttacksPerRound}", s.AttacksPerRoundNote);
            yield return ("Броня", s.Armor > 0 ? $"{s.Armor}" : Terms.None, s.ArmorNote);
            if (s.Dodge > 0)
            {
                yield return (Terms.Dodge, $"{s.Dodge}%", null);
            }

            if (!string.IsNullOrWhiteSpace(s.SanityLoss))
            {
                yield return (Terms.SanityLoss, s.SanityLoss, null);
            }

            if (s.Initiative > 0)
            {
                yield return ("Инициатива", $"{s.Initiative}", null);
            }
        }
    }

    // Книга пишет скорость по способам передвижения: «8 / плавание 10», «6 / полёт 20» (стр. 280).
    // Пустое плавание — половина обычной скорости, пустой полёт — летать не умеет (стр. 141).
    private static string? Speed(CreatureSpeed speed)
    {
        if (!string.IsNullOrWhiteSpace(speed.Note))
        {
            return speed.Note;
        }

        if (speed.Move <= 0 && speed.Swim is null && speed.Fly is null)
        {
            return null;
        }

        List<string> parts = [speed.Move.ToString(System.Globalization.CultureInfo.CurrentCulture)];
        if (speed.Swim is { } swim) parts.Add($"плавание {swim}");
        if (speed.Fly is { } fly) parts.Add($"полёт {fly}");
        return string.Join(" / ", parts);
    }

    /// <summary>На плитке места для оговорки нет, но и «нет» там, где тварь регенерирует, соврало бы: «особая».</summary>
    public static string TileArmor(Statblock s) =>
        s.Armor > 0 ? $"{s.Armor}" : string.IsNullOrWhiteSpace(s.ArmorNote) ? Terms.None : "особая";
}
