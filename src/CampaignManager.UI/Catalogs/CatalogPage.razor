@typeparam TItem where TItem : CatalogItemDto
@using System.Text.Json
@using System.Text.Json.Serialization.Metadata
@using CampaignManager.Contracts.Catalogs
@using CampaignManager.UI.Platform
@using CampaignManager.Contracts.Platform
@using CampaignManager.Core
@using CampaignManager.Core.Catalogs
@inject ICatalogApi<TItem> Api
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Страница справочника — одна на все семь (в v1 четыре плотных каталога совпадали на 83–88%).
   Список приходит целиком (справочники маленькие), поиск, фильтры, сортировка и страницы — здесь,
   у всех справочников одинаково. Своё у справочника — колонки (Columns), строки плитки (Tile) или текст карточки
   (Cards), сведения раскрытой записи (Details), форма. Кнопки правки — только при CanEdit из API; защищает сервер
   (403), здесь они просто не рисуются.

   Иллюстрации — одна система на все справочники (выбор владельца 2026-10-09, Styles/catalog.css): рамка 4:5 или 3:2 (Art),
   справочник с плиткой открывается галереей по группам без страниц, таблица — вторым видом (?view=table, «Галерея / Таблица»
   в панели фильтров); профессии и артефакты — карточки «обложка слева». Раскрытая запись одна на всех: во всю ширину сетки,
   картинка слева (CatalogImageGallery), сведения справа; в таблице — то же тело в раскрытой строке. Страница прокручивает к
   раскрытой карточке (CatalogPage.razor.js).

   Общий каркас (UX-0b, правила 4, 11, 12, 17): раскрытая запись всегда в адресе (?open=), у всех справочников;
   одна кнопка «Сбросить фильтры» (неактивна, пока фильтров нет); эпоха — только когда записи из разных эпох;
   пагинация под списком, вне карточки; в строке одна иконка «Изменить», «Удалить» — в окне правки; название и тип
   не обрезаются; пустое — одной строкой («Нет книг.» / «Нет книг по этим условиям.»); уход с несохранённой
   формы — один вопрос. *@
<PageHeader Title="@Title">
    <Actions>
        @if (_canEdit)
        {
            @* Вторая кнопка справочника (фонотека: «Загрузить файлы») — рядом с «Добавить», а не в «⋯». *@
            @HeaderActions
            <Button Small="true" Icon="fa-plus" Href="@EditHref?.Invoke(null)" OnClick="AddAsync">@AddLabel</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    @* Липнет только у раскладки без своего скроллпорта (галерея, карточки): таблица прокручивается сама. *@
    <FilterPanel OnReset="ResetFilters" CanReset="HasFilters" Sticky="!IsTable" CompactReset="HasViews || ShowSorts">
        <ChildContent>
            @* min-w-32 на телефоне: поиск, «Фильтры» и «⋯» помещаются в одну строку (393px − поля). *@
            <input class="cm-input min-w-32 flex-1 md:min-w-48" type="search" placeholder="@SearchPlaceholder" aria-label="Поиск"
                   value="@_search" @oninput="OnSearch" />
            @if (HasExtraFilters)
            {
                @* На телефоне фильтры, порядок и флажки прячутся за одной кнопкой (панель занимала 300–380px из 844); с md
                   обёртка display: contents — поля остаются прямыми детьми строки FilterPanel. *@
                <Button Variant="ButtonVariant.Secondary" Icon="fa-sliders" class="md:hidden" aria-expanded="@(_filtersOpen ? "true" : "false")"
                        OnClick="() => _filtersOpen = !_filtersOpen">@(ActiveExtra > 0 ? $"Фильтры ({ActiveExtra})" : "Фильтры")</Button>
            }
            <div class="@(_filtersOpen ? "contents" : "hidden md:contents")">
                @foreach (var filter in Filters)
                {
                    var current = filter;
                    <select class="cm-input w-full sm:w-52 shrink-0" aria-label="@current.AllLabel"
                            value="@(_filters.GetValueOrDefault(current.Key) ?? "")" @onchange="e => SetFilter(current.Key, e.Value?.ToString())">
                        <option value="">@current.AllLabel</option>
                        @foreach (var option in current.Options)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                }
                @if (ErasVary || _era is not null)
                {
                    <select class="cm-input w-full sm:w-44 shrink-0" aria-label="Эпоха" value="@(_era?.ToString() ?? "")" @onchange="SetEra">
                        <option value="">@Terms.AnyEra</option>
                        @foreach (var era in Enum.GetValues<Era>())
                        {
                            <option value="@era">@CatalogText.Of(era)</option>
                        }
                    </select>
                }
                @if (ShowSorts)
                {
                    <select class="cm-input w-full sm:w-48 shrink-0" aria-label="Сортировка" value="@SortKey" @onchange="e => { _sortKey = e.Value?.ToString(); SetPage(1); }">
                        @foreach (var sort in Sorts)
                        {
                            <option value="@sort.Key">@sort.Label</option>
                        }
                    </select>
                }
                @foreach (var toggle in Toggles)
                {
                    var current = toggle;
                    <label class="flex min-h-9 shrink-0 items-center gap-2 text-sm text-primary-700">
                        <input type="checkbox" class="cm-checkbox" checked="@_toggles.Contains(current.Key)" @onchange="e => SetToggle(current.Key, e.Value is true)" />
                        <span>@current.Label</span>
                    </label>
                }
                @if (HasViews)
                {
                    @* Вид — в адресе, как поиск и раскрытая запись; на телефоне — за кнопкой «Фильтры» (поиск, «Фильтры» и «⋯» —
                       одной строкой). *@
                    <Segmented TValue="bool" Options="ViewOptions" Value="IsTable" ValueChanged="SetTableView" Label="Вид" class="shrink-0" />
                }
                @FilterExtras
            </div>
        </ChildContent>
        <Actions>
            @ToolbarActions
            @if (_canEdit)
            {
                @* Импорт, экспорт и «С правилами» — редкие действия: одно «⋯», а не ряд из трёх кнопок (на телефоне он рвался). *@
                <RowMenu AriaLabel="@MenuLabel">
                    @MenuItems
                    @if (CoverOf is not null)
                    {
                        <RowMenuItem Icon="fa-images" OnClick="() => _coversOpen = true">Загрузить картинки</RowMenuItem>
                    }
                    <RowMenuItem Icon="fa-file-import" OnClick="() => _importOpen = true">Импорт</RowMenuItem>
                    <RowMenuItem Icon="fa-file-export" OnClick="ExportAsync">Экспорт</RowMenuItem>
                    @if (Sync)
                    {
                        <RowMenuItem Icon="fa-rotate" Disabled="_syncing" OnClick="SyncAsync">Сверить с книгой правил</RowMenuItem>
                    }
                </RowMenu>
            }
        </Actions>
    </FilterPanel>

    <AsyncContent @ref="_content" TData="CatalogList<TItem>" Load="LoadAsync" IsEmpty="_ => false" LoadingMessage="Загрузка справочника…">
        @{
            var view = View();
        }
        @if (_items.Count == 0)
        {
            @* Большая карточка — только когда пуста вся страница и в шапке нет «Добавить» (правило 4). *@
            @if (_canEdit)
            {
                <p class="cm-empty-line">@Terms.Empty(Plural)</p>
            }
            else
            {
                <EmptyState Title="@Terms.Empty(Plural)" Message="Хранитель ещё ничего сюда не добавил." Icon="@Icon" />
            }
        }
        else if (view.Filtered.Count == 0)
        {
            <p class="cm-empty-line">
                <span>@Terms.EmptyFiltered(Plural)</span>
                <Button Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" OnClick="ResetFilters">@Terms.ResetFilters</Button>
            </p>
        }
        else if (IsGallery)
        {
            @* Галерея — без страниц: тип и поиск сужают её сами, весь справочник — одна прокрутка. Группы — по типу справочника. *@
            <div class="grid gap-7">
                @foreach (var group in Groups(view.Filtered))
                {
                    <section aria-label="@(group.Title ?? Title)" @key="group.Title">
                        @if (group.Title is not null)
                        {
                            <h2 class="cm-section-title mb-3">@group.Title · @group.Items.Count</h2>
                        }
                        <div class="@CatalogArtCss.Tiles(Art)">
                            @foreach (var item in group.Items)
                            {
                                @if (OpenId == item.Id)
                                {
                                    @RecordOf(item)
                                }
                                else
                                {
                                    @TileOf(item)
                                }
                            }
                        </div>
                    </section>
                }
            </div>
        }
        else if (IsCards)
        {
            <div class="cm-wide-grid">
                @foreach (var item in view.Page)
                {
                    @if (OpenId == item.Id)
                    {
                        @RecordOf(item)
                    }
                    else
                    {
                        @WideOf(item)
                    }
                }
            </div>
            <Pagination CurrentPage="_page" PageSize="PageSize" TotalItems="view.Filtered.Count" CurrentPageChanged="SetPage" />
        }
        else
        {
            <div class="cm-card">
                @* Ключ — фильтры, которые прячут колонки и метки: ячейки DataColumn таблица рисует раньше, чем
                   колонки получат новый вид, и без пересоздания метка эпохи отставала бы на один рендер. *@
                <DataTable @key="ColumnsKey" TItem="TItem" Items="view.Filtered" RowKey="i => i.Id" Page="_page" PageSize="PageSize"
                           TableFrom="TableFrom" Scroll="Scroll" StickyHead="StickyHead" RowDetail="TableDetail" CanExpand="CanExpand"
                           OpenKey="(object?)OpenId" OpenKeyChanged="SetOpenKey"
                           CardTemplate="CardTemplate is null ? null : Card" AriaLabel="@Title">
                    <Columns>
                        @Columns?.Invoke(view)
                        @if (_canEdit)
                        {
                            <DataColumn TItem="TItem" Title="" CellClass="w-px whitespace-nowrap text-right" Context="item">
                                @RowActions(item)
                            </DataColumn>
                        }
                    </Columns>
                </DataTable>
            </div>
            @* Страницы — под карточкой, вне её (правило 17). *@
            <Pagination CurrentPage="_page" PageSize="PageSize" TotalItems="view.Filtered.Count" CurrentPageChanged="SetPage" />
        }
    </AsyncContent>
</div>

@if (Form is not null)
{
    <UnsavedChangesGuard @ref="_guard" Dirty="IsDirty" />
    <Modal Open="_editing is not null" Title="@FormTitle" Size="FormSize" OnClose="CloseFormAsync">
        <ChildContent>
            @if (_editing is not null)
            {
                _state.ErasVary = ErasVary;
                if (_state.Attempted)
                {
                    _state.Set(Check(_editing)); // после первой попытки ошибки гаснут по мере правки
                }

                @Form(_editing)
                @* «Удалить» — не в строке, а здесь (правило 7): рядом с частым действием опасного не ставим. *@
                @if (!_isNew && _canEdit)
                {
                    <div class="cm-danger-zone">
                        <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="DeleteEditingAsync">Удалить @Noun</Button>
                    </div>
                }
            }
        </ChildContent>
        <FooterHint>
            @* Все ошибки полей сразу и рядом с кнопкой; страница прокручивается к первой (правило 9). *@
            <FormErrors Errors="_state.Messages" Attempt="_state.Attempt" />
        </FooterHint>
        <FooterError>
            @if (_formUsage is not null && _editing is not null)
            {
                <Alert Tone="Tone.Error" ShowIcon="true" class="mb-0">
                    Нельзя удалить. <CatalogUsageText Usage="_formUsage" Query="@_editing.Name" /> Сначала уберите ссылки.
                </Alert>
            }
            else if (_formError is not null)
            {
                <Alert Tone="Tone.Error" ShowIcon="true" class="mb-0">
                    <ChildContent>@_formError</ChildContent>
                    <Actions>
                        @if (_stale)
                        {
                            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-rotate-right" OnClick="RereadAsync">Перечитать</Button>
                        }
                    </Actions>
                </Alert>
            }
        </FooterError>
        <Footer>
            <Button Variant="ButtonVariant.Secondary" OnClick="CloseFormAsync">Отмена</Button>
            <Button Icon="fa-floppy-disk" Busy="_saving" OnClick="SaveAsync">Сохранить</Button>
        </Footer>
    </Modal>
}

@if (CoverOf is not null && _coversOpen)
{
    @* Только открытым: каждое открытие — с чистой пачкой, а страницам без загрузки не нужны файлы. *@
    <CatalogImagesBulkModal TItem="TItem" Open="true" Items="_items" CoverOf="CoverOf" OnSaved="ReplaceItem"
                            OnClose="() => _coversOpen = false" />
}

<CatalogImportModal TItem="TItem" Open="_importOpen" Title="@($"Импорт: {Title.ToLowerInvariant()}")"
                    OnClose="() => _importOpen = false" OnImported="ReloadAsync" />

<Modal Open="_syncReport is not null" Title="Сверка с книгой правил" OnClose="() => _syncReport = null">
    <ChildContent>
        @if (_syncReport is not null)
        {
            <CatalogReportView Report="_syncReport" />
        }
    </ChildContent>
    <Footer>
        <Button OnClick="() => _syncReport = null">Готово</Button>
    </Footer>
</Modal>

@code {
    private static readonly JsonTypeInfo<TItem> ItemType =
        (JsonTypeInfo<TItem>)CampaignManager.Contracts.ContractsJsonContext.Default.GetTypeInfo(typeof(TItem))!;

    private AsyncContent<CatalogList<TItem>>? _content;
    private List<TItem> _items = [];
    private bool _canEdit;
    private string _search = "";
    private readonly Dictionary<string, string> _filters = [];
    private readonly HashSet<string> _toggles = [];
    private Era? _era;
    private int _page = 1;
    private TItem? _editing;
    private bool _isNew;
    private bool _saving;
    private string? _formError;
    private CatalogUsage? _formUsage; // отказ в удалении: держатели рисуются с жирными именами и ссылкой «ещё N» (S5)
    private bool _stale;
    private bool _importOpen;
    private bool _coversOpen;
    private string? _initialJson;
    private UnsavedChangesGuard? _guard;
    private bool _syncing;
    private bool _filtersOpen;
    private CatalogImportReport? _syncReport;
    private Guid? _pagedTo;
    private CatalogFormState _ownState = new();

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Иконка пустого справочника — та же, что у пункта меню.</summary>
    [Parameter] public string Icon { get; set; } = "fa-book";

    /// <summary>
    /// Свои поля панели фильтров — после селектов и порядка, и на телефоне вместе с ними за кнопкой «Фильтры» (вид предметов
    /// «Таблица / Галерея»): поиск, «Фильтры» и «⋯» там должны оставаться одной строкой.
    /// </summary>
    [Parameter] public RenderFragment? FilterExtras { get; set; }

    /// <summary>
    /// Свои кнопки страницы в панели фильтров, перед «Импорт» (фонотека: «Загрузить файлы»). Не в шапке: на
    /// телефоне в ней помещаются две подписанные кнопки, а там уже «Добавить» и кнопки модулей. Права — на странице.
    /// </summary>
    [Parameter] public RenderFragment? ToolbarActions { get; set; }

    /// <summary>«Добавить оружие».</summary>
    [Parameter, EditorRequired] public string AddLabel { get; set; } = "Добавить";

    /// <summary>«оружие», «навык» — в подтверждении удаления.</summary>
    [Parameter, EditorRequired] public string Noun { get; set; } = "";

    /// <summary>«оружия», «книг» — для пустого состояния: «Нет книг.» / «Нет книг по этим условиям.»</summary>
    [Parameter] public string Plural { get; set; } = "записей";

    /// <summary>«Поиск», а не «Поиск по названию»: ищет и по другим названиям, а на телефоне (поле 128px) подсказка обрезалась до «Поиск по на».</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Поиск";

    /// <summary>Что ещё искать, кроме названия: другие названия, автор.</summary>
    [Parameter] public Func<TItem, IEnumerable<string?>>? SearchAlso { get; set; }

    [Parameter] public IReadOnlyList<CatalogFilter<TItem>> Filters { get; set; } = [];

    [Parameter] public IReadOnlyList<CatalogToggle<TItem>> Toggles { get; set; } = [];

    /// <summary>Порядок для своей раскладки без заголовков таблицы (карточки профессий): выбор в панели фильтров.</summary>
    [Parameter] public IReadOnlyList<CatalogSort<TItem>> Sorts { get; set; } = [];

    /// <summary>Эпохи записи — у справочника с эпохой появляется фильтр по ней.</summary>
    [Parameter] public Func<TItem, IReadOnlyList<Era>>? ErasOf { get; set; }

    [Parameter] public int PageSize { get; set; } = 25;

    /// <summary>Колонки таблицы (DataColumn); получают вид — чтобы прятать то, что фиксирует фильтр.</summary>
    [Parameter] public RenderFragment<CatalogView<TItem>>? Columns { get; set; }

    /// <summary>Рамка иллюстраций справочника: миниатюры, плитки, обложки карточек и картинка раскрытой записи (Styles/catalog.css).</summary>
    [Parameter] public CatalogArt Art { get; set; }

    /// <summary>
    /// Строки сведений плитки под названием (цена, урон, база). Задана — справочник открывается галереей по группам без страниц,
    /// а таблица (<see cref="Columns"/>) становится вторым видом: «Галерея / Таблица» в панели фильтров, <c>?view=table</c>.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? Tile { get; set; }

    /// <summary>Текст карточки «обложка слева» под названием (профессии — навыки, артефакты — правило): вместо таблицы.</summary>
    [Parameter] public RenderFragment<TItem>? Cards { get; set; }

    /// <summary>Группа записи в галерее (тип предмета, категория навыка): заголовок «Тип · N», группы по алфавиту, без группы — последней.</summary>
    [Parameter] public Func<TItem, string?>? GroupOf { get; set; }

    /// <summary>Заголовок группы записей без группы.</summary>
    [Parameter] public string Ungrouped { get; set; } = "Без типа";

    /// <summary>Картинки записи для раскрытия (первая — обложка); справочник с одной картинкой отдаёт список из неё.</summary>
    [Parameter] public Func<TItem, IReadOnlyList<CatalogImageDto>>? ImagesOf { get; set; }

    /// <summary>Метки у названия раскрытой записи галереи и карточек (необычный, редк., из Лавкрафта).</summary>
    [Parameter] public RenderFragment<TItem>? Badges { get; set; }

    /// <summary>
    /// Сведения раскрытой записи — справа от картинки (картинку рисует каркас по <see cref="ImagesOf"/>). <c>InTable</c> —
    /// раскрытая строка таблицы: колонки уже видны и не повторяются. Без него — <see cref="RowDetail"/> (фонотека: таблица без картинок).
    /// </summary>
    [Parameter] public RenderFragment<CatalogDetails<TItem>>? Details { get; set; }

    /// <summary>У Хранителя на телефоне сведения раскрытой записи — выше картинки (статблок твари, B5).</summary>
    [Parameter] public bool DetailsFirstOnPhone { get; set; }

    /// <summary>Строка-карточка на узком экране (кнопки правки страница добавит сама).</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    [Parameter] public RenderFragment<TItem>? RowDetail { get; set; }

    [Parameter] public Func<TItem, bool>? CanExpand { get; set; }

    [Parameter] public TableBreakpoint TableFrom { get; set; } = TableBreakpoint.Md;

    /// <summary>Плотный справочник: таблица — свой скроллпорт с липкими шапкой и названием.</summary>
    [Parameter] public bool Scroll { get; set; } = true;

    /// <summary>
    /// Таблица прокручивается вместе со страницей (не вложенной прокруткой), шапка столбцов липнет под шапку страницы:
    /// для справочника с широкими строками и тремя-четырьмя колонками (фонотека), где «первая колонка липнет» не нужна.
    /// Вместе с <c>Scroll="false"</c>.
    /// </summary>
    [Parameter] public bool StickyHead { get; set; }

    /// <summary>Кнопка шапки рядом с «Добавить» (фонотека — «Загрузить файлы»).</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>
    /// Обложка записи (адрес) — у справочника с картинками: в «⋯» появляется «Загрузить картинки» (пачка рисунков, файл → запись
    /// по коду или названию, <see cref="CatalogImagesBulkModal{TItem}"/>).
    /// </summary>
    [Parameter] public Func<TItem, string?>? CoverOf { get; set; }

    /// <summary>Свои пункты в меню «⋯» панели фильтров, перед «Импорт» и «Экспорт» (фонотека — «Настроения плеера»).</summary>
    [Parameter] public RenderFragment? MenuItems { get; set; }

    /// <summary>Заголовок окна создания, если он не совпадает с подписью кнопки («Новый трек» при кнопке «Добавить трек»).</summary>
    [Parameter] public string? NewTitle { get; set; }

    /// <summary>
    /// Проверка формы до отправки: поле → текст ошибки (все сразу, правило 9). Название проверяется всегда; страница
    /// добавляет своё обязательное (урон и навык оружия, тип заклинания). Остальное проверяет сервер.
    /// </summary>
    [Parameter] public Func<TItem, IReadOnlyDictionary<string, string>>? Validate { get; set; }

    /// <summary>Ошибки формы по полям: страница читает их в <c>Form</c> (<see cref="CatalogFormState.For"/>); не задан — свой.</summary>
    [Parameter] public CatalogFormState? State { get; set; }

    private CatalogFormState _state => State ?? _ownState;

    /// <summary>Форма записи в окне; получает копию — отмена ничего не портит.</summary>
    [Parameter] public RenderFragment<TItem>? Form { get; set; }

    [Parameter] public ModalSize FormSize { get; set; } = ModalSize.Medium;

    /// <summary>Новая запись для формы.</summary>
    [Parameter, EditorRequired] public Func<TItem> New { get; set; } = null!;

    /// <summary>Правка на своей странице (статблок не помещается в окно): адрес; null — новая.</summary>
    [Parameter] public Func<TItem?, string>? EditHref { get; set; }

    /// <summary>Форма открывается — странице пора загрузить то, что нужно только форме (навыки для оружия).</summary>
    [Parameter] public EventCallback OnFormOpening { get; set; }

    /// <summary>Есть сид книги — кнопка «С правилами».</summary>
    [Parameter] public bool Sync { get; set; }

    /// <summary>Список загружен или изменился — странице, которой нужны имена (родители навыков).</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnLoaded { get; set; }

    // Заголовок — имя на момент открытия: пока его правят, окно не должно переименовываться.
    private string FormTitle => _isNew ? NewTitle ?? AddLabel : $"Изменить: {_editingName}";

    private string? _editingName;

    // Адрес хранит то, что человек видит: ?q= (поиск; заклинание книги ведёт на справочник заклинаний с ним),
    // ?page= (страница) и ?open= (раскрытая запись) — F5 и «назад» возвращают туда же, а не на первую страницу (X4).
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ReadQuery();
    }

    // Адрес меняют и переход по ссылке, и «назад»: страница перерисовывается по смене адреса, а не по своим кликам.
    // Свои записи в адрес (WriteUrl) приходят сюда тоже, и в WebAssembly — позже, чем человек успел ввести ещё
    // букву: прочитанный из них поиск откатил бы набранное. Поэтому свои адреса помнятся и не читаются.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_written.Remove(e.Location))
        {
            if (_written.Count == 0)
            {
                _intended = null;
            }
        }
        else
        {
            _written.Clear();
            _intended = null;
            ReadQuery();
        }

        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private readonly HashSet<string> _written = [];
    private string? _intended;
    private Guid? _open;

    private bool _table;
    private IJSObjectReference? _module;
    private Guid? _revealed;

    /// <summary>Раскрытая запись — из адреса (<c>?open=</c>).</summary>
    private Guid? OpenId => _open;

    /// <summary>Два вида одной выдачи: галерея (или карточки) и таблица.</summary>
    private bool HasViews => Columns is not null && (Tile is not null || Cards is not null);

    private bool IsTable => Columns is not null && (_table || (Tile is null && Cards is null));

    private bool IsGallery => !IsTable && Tile is not null;

    private bool IsCards => !IsTable && Tile is null && Cards is not null;

    /// <summary>Порядок выбором — у раскладки без заголовков столбцов; у таблицы его задают заголовки.</summary>
    private bool ShowSorts => Sorts.Count > 1 && !IsTable;

    /// <summary>Галерея — без страниц (тип и поиск сужают её сами); таблица и карточки — по <see cref="PageSize"/>.</summary>
    private int ActivePageSize => IsGallery ? 0 : PageSize;

    private static readonly IReadOnlyList<SegmentOption<bool>> ViewOptions =
        [new(false, "Галерея", TestId: "catalog-view-gallery"), new(true, "Таблица", TestId: "catalog-view-table")];

    private void ReadQuery()
    {
        var search = "";
        var page = 1;
        var table = false;
        Guid? open = null;
        foreach (var part in new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            switch (part.Split('=', 2))
            {
                case ["q", var value]:
                    search = Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
                    break;
                case ["page", var value] when int.TryParse(value, out var number) && number > 1:
                    page = number;
                    break;
                case ["open", var value] when Guid.TryParse(Uri.UnescapeDataString(value), out var id):
                    open = id;
                    break;
                case ["view", "table"]:
                    table = true;
                    break;
            }
        }

        _search = search;
        _page = page;
        _table = table;
        if (open != _open)
        {
            _open = open;
            _pagedTo = null; // запись по новой ссылке — на свою страницу
        }
    }

    private void WriteUrl()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = _search.Length > 0 ? _search : null,
            ["page"] = _page > 1 ? _page : null,
            ["open"] = _open,
            ["view"] = _table && HasViews ? "table" : null,
        });
        if (uri == (_intended ?? Navigation.Uri))
        {
            return;
        }

        _intended = uri;
        _written.Add(uri);
        Navigation.NavigateTo(uri, replace: true);
    }

    // Вид — в адресе (F5 и «назад» возвращают туда же); у таблицы и галереи страницы свои — с первой.
    private void SetTableView(bool table)
    {
        _table = table;
        _page = 1;
        _pagedTo = null;
        WriteUrl();
    }

    private Task SetOpenKey(object? key)
    {
        _open = key is Guid id ? id : null;
        _pagedTo = _open;
        WriteUrl();
        return Task.CompletedTask;
    }

    private async Task<CatalogList<TItem>> LoadAsync(CancellationToken cancellationToken)
    {
        var list = await Api.ListAsync(cancellationToken);
        _items = [.. list.Items];
        _canEdit = list.CanEdit;
        _pagedTo = null;
        await OnLoaded.InvokeAsync(_items);
        // Права пришли со списком: шапке и панели фильтров (они вне AsyncContent) нужен свой рендер.
        StateHasChanged();
        return list;
    }

    /// <summary>Запись сохранили мимо формы (обложка из пачки картинок) — заменить её в списке, не перечитывая весь.</summary>
    private void ReplaceItem(TItem saved)
    {
        var index = _items.FindIndex(i => i.Id == saved.Id);
        if (index >= 0)
        {
            _items[index] = saved;
        }
    }

    /// <summary>Права из ответа API — шаблонам страницы, которым нужно знать их и в плитке (сводка статблока твари только Хранителю).</summary>
    public bool CanEdit => _canEdit;

    /// <summary>Перечитать список (после того, что страница записала мимо формы: пачка файлов).</summary>
    public Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;

    private CatalogView<TItem> View()
    {
        var filtered = Order(_items.Where(Matches)).ToList();
        // Раскрытая по адресу запись — на своей странице, а не «где-то дальше».
        var pageSize = ActivePageSize;
        if (OpenId is { } open && _pagedTo != open && pageSize > 0)
        {
            var index = filtered.FindIndex(i => i.Id == open);
            if (index >= 0)
            {
                _page = index / pageSize + 1;
            }

            _pagedTo = open;
        }

        // Страница из ссылки (?page=) могла устареть: записей стало меньше — последняя, а не пустота.
        _page = Math.Clamp(_page, 1, Math.Max(1, TotalPages(filtered.Count)));
        var page = pageSize > 0 ? filtered.Skip((_page - 1) * pageSize).Take(pageSize).ToList() : filtered;
        return new CatalogView<TItem>
        {
            All = _items,
            Filtered = filtered,
            Page = page,
            CanEdit = _canEdit,
            Filters = _filters,
            Era = _era,
            ErasVary = ErasVary,
            Actions = RowActions,
            Edit = EditAsync,
            Delete = DeleteAsync,
            Open = OpenId,
            ToggleOpen = ToggleOpenAsync,
        };
    }

    private string SortKey => _sortKey is not null && Sorts.Any(s => s.Key == _sortKey) ? _sortKey : Sorts.FirstOrDefault()?.Key ?? "";

    private string? _sortKey;

    private IEnumerable<TItem> Order(IEnumerable<TItem> items)
    {
        var sort = Sorts.FirstOrDefault(s => s.Key == SortKey);
        if (sort is null)
        {
            return items.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);
        }

        var ordered = sort.Descending
            ? items.OrderByDescending(sort.By, Comparer<object?>.Default)
            : items.OrderBy(sort.By, Comparer<object?>.Default);
        return ordered.ThenBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    private bool Matches(TItem item)
    {
        if (_search.Length > 0)
        {
            var needle = CatalogCodeTable.NormalizeName(_search);
            var haystack = (SearchAlso?.Invoke(item) ?? []).Prepend(item.Name);
            if (!haystack.Any(text => text is not null && CatalogCodeTable.NormalizeName(text).Contains(needle, StringComparison.Ordinal)))
            {
                return false;
            }
        }

        foreach (var filter in Filters)
        {
            if (_filters.TryGetValue(filter.Key, out var value) && !filter.Matches(item, value))
            {
                return false;
            }
        }

        foreach (var toggle in Toggles)
        {
            if (_toggles.Contains(toggle.Key) && !toggle.Matches(item))
            {
                return false;
            }
        }

        return _era is not { } era || ErasOf is null || ErasOf(item).Contains(era);
    }

    /// <summary>
    /// Эпоха различает записи, только если они из разных эпох. Перенос оставил одну классику (современная
    /// эпоха не переносится, решение владельца 2026-10-02) — тогда ни фильтра, ни меток: «1920-е» в каждой
    /// строке ничего не различает. Появится запись другой эпохи — появятся и они.
    /// </summary>
    private bool ErasVary => ErasOf is not null
        && _items.Select(i => string.Join(",", ErasOf(i).Order())).Distinct().Skip(1).Any();

    /// <summary>Есть что сбрасывать: «Сбросить фильтры» неактивна, пока поиск и фильтры пусты (правило 4).</summary>
    private bool HasFilters => _search.Length > 0 || _filters.Count > 0 || _toggles.Count > 0 || _era is not null;

    private string ColumnsKey => $"{_era}|{string.Join(",", _filters.OrderBy(f => f.Key).Select(f => $"{f.Key}={f.Value}"))}";

    private string MenuLabel => "Ещё: " + string.Join(", ", new[] { CoverOf is null ? null : "картинки", "импорт", "экспорт", Sync ? "сверка с книгой правил" : null }.OfType<string>());

    private bool HasExtraFilters => Filters.Count > 0 || Toggles.Count > 0 || ShowSorts || HasViews || ErasVary || _era is not null || FilterExtras is not null;

    /// <summary>Сколько из спрятанных на телефоне фильтров включено — на кнопке «Фильтры (2)».</summary>
    private int ActiveExtra => _filters.Count + _toggles.Count + (_era is null ? 0 : 1);

    // Экспорт — ссылка на API с «download»: из меню — переход, браузер скачивает и страницу не покидает.
    private void ExportAsync() => Navigation.NavigateTo(Api.Route.Export, forceLoad: true);

    private int TotalPages(int count) => ActivePageSize > 0 ? (count + ActivePageSize - 1) / ActivePageSize : 1;

    // Любой фильтр возвращает на первую страницу: иначе с пятой страницы поиск уводит в пустоту.
    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString()?.Trim() ?? "";
        SetPage(1);
    }

    private void SetFilter(string key, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            _filters.Remove(key);
        }
        else
        {
            _filters[key] = value;
        }

        SetPage(1);
    }

    private void SetToggle(string key, bool on)
    {
        if (on)
        {
            _toggles.Add(key);
        }
        else
        {
            _toggles.Remove(key);
        }

        SetPage(1);
    }

    private void SetEra(ChangeEventArgs e)
    {
        _era = Enum.TryParse<Era>(e.Value?.ToString(), out var era) ? era : null;
        SetPage(1);
    }

    private void ResetFilters()
    {
        _search = "";
        _filters.Clear();
        _toggles.Clear();
        _era = null;
        SetPage(1);
    }

    private void SetPage(int page)
    {
        _page = page;
        WriteUrl();
    }

    private Task ToggleOpenAsync(TItem item)
    {
        return SetOpenKey(OpenId == item.Id ? null : item.Id);
    }

    // ── Строка ──

    // В строке каталога одна иконка «Изменить» (правило 7): «Удалить» — в окне правки. Иконка 36px — плотная
    // таблица справочника, где это допустимо; в карточке на узком экране — полная кнопка 44px.
    private RenderFragment<TItem> RowActions => item => __builder =>
    {
        if (!_canEdit)
        {
            return;
        }

        <div class="inline-flex gap-2" @onclick:stopPropagation="true">
            <Button Variant="ButtonVariant.OutlinePrimary" Small="true" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(item.Name)}")"
                    Href="@EditHref?.Invoke(item)" OnClick="() => EditAsync(item)" />
        </div>
    };

    // Раскрыть можно всю карточку, а не отдельную строку «Подробнее» под ней (X7): название и сведения — кнопка, шеврон
    // справа; иконка «Изменить» стоит рядом и раскрытия не вызывает. Не раскрываемая запись — просто карточка.
    private RenderFragment<TItem> Card => item => __builder =>
    {
        var expandable = TableDetail is not null && (CanExpand?.Invoke(item) ?? true);
        var open = OpenId == item.Id;
        <div class="flex items-start gap-3">
            @if (expandable)
            {
                <button type="button" class="flex min-w-0 flex-1 cursor-pointer items-start gap-3 text-left" aria-expanded="@(open ? "true" : "false")"
                        @onclick="() => ToggleOpenAsync(item)">
                    <span class="block min-w-0 flex-1">
                        @CardTemplate!(item)
                        @if (ErasOf is not null && ErasVary && _era is null)
                        {
                            <EraBadges Values="ErasOf(item)" />
                        }
                    </span>
                    <i class="@($"fa-solid {(open ? "fa-chevron-up" : "fa-chevron-down")} mt-1 shrink-0 text-primary-500")" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <div class="min-w-0 flex-1">
                    @CardTemplate!(item)
                    @if (ErasOf is not null && ErasVary && _era is null)
                    {
                        <EraBadges Values="ErasOf(item)" />
                    }
                </div>
            }
            @if (_canEdit)
            {
                <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(item.Name)}")"
                        Href="@EditHref?.Invoke(item)" OnClick="() => EditAsync(item)" />
            }
        </div>
        @if (expandable && open)
        {
            <div class="mt-2 rounded-md bg-primary-50 p-3">@TableDetail!(item)</div>
        }
    };

    // ── Иллюстрации: плитка, карточка, раскрытая запись ──

    private static string RecordId(Guid id) => $"record-{id}";

    // Группы галереи по алфавиту, без группы — последней; без GroupOf — одна группа без заголовка.
    private IEnumerable<(string? Title, List<TItem> Items)> Groups(IReadOnlyList<TItem> items) =>
        GroupOf is null
            ? [(null, [.. items])]
            : items.GroupBy(i => GroupOf(i) ?? "")
                .OrderBy(g => g.Key.Length == 0)
                .ThenBy(g => g.Key, StringComparer.CurrentCulture)
                .Select(g => ((string?)(g.Key.Length == 0 ? Ungrouped : g.Key), g.ToList()));

    /// <summary>Сведения раскрытой строки таблицы и карточки телефона — с картинкой слева, как в галерее.</summary>
    private RenderFragment<TItem>? TableDetail =>
        Details is null && ImagesOf is null ? RowDetail : item => RecordBody(item, inTable: true);

    // Пока картинок нет ни у одной записи, у карточек нет и места под обложку: двадцать одинаковых заглушек ничего не различают.
    private bool AnyCover => CoverOf is not null && _items.Any(i => CoverOf(i) is not null);

    private RenderFragment Eras(TItem item) => __builder =>
    {
        @if (ErasOf is not null && ErasVary && _era is null)
        {
            <EraBadges Values="ErasOf(item)" />
        }
    };

    // Одна иконка «Изменить» 32px — в углу карточки и в шапке раскрытой записи (правило 7); в строке таблицы — RowActions.
    private RenderFragment EditButton(TItem item) => __builder =>
    {
        <Button Variant="ButtonVariant.OutlinePrimary" Small="true" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(item.Name)}")"
                Href="@EditHref?.Invoke(item)" OnClick="() => EditAsync(item)" />
    };

    private RenderFragment Cover(TItem item, string css) => __builder =>
    {
        var cover = CoverOf?.Invoke(item);
        <span class="@Css.Join(CatalogArtCss.Frame(Art), css)">
            @if (cover is not null)
            {
                @* 240px — обложка не шире 112px при плотности 2. *@
                <img src="@ImageUrls.Thumb(cover, 240)" alt="" loading="lazy" decoding="async" />
            }
            else
            {
                <i class="@($"fa-solid {Icon}")" aria-hidden="true"></i>
            }
        </span>
    };

    // Плитка — рисунок, название и строки сведений страницы; вся — кнопка раскрытия (X7). «Изменить» — в шапке раскрытой записи,
    // как у бестиария: карандаш на каждой из 30 плиток экрана поверх рисунков — шум, а правят справочник реже, чем листают.
    private RenderFragment TileOf(TItem item) => __builder =>
    {
        var count = ImagesOf?.Invoke(item).Count ?? 0;
        <article id="@RecordId(item.Id)" class="cm-card cm-tile" @key="item.Id">
            <button type="button" class="cm-tile-button" aria-expanded="false" @onclick="() => ToggleOpenAsync(item)">
                <span class="@Css.Join(CatalogArtCss.Frame(Art), "cm-tile-media")">
                    @if (CoverOf?.Invoke(item) is { } cover)
                    {
                        <img src="@ImageUrls.Thumb(cover)" alt="" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <i class="@($"fa-solid {Icon}")" aria-hidden="true"></i>
                    }
                    @if (count > 1)
                    {
                        <span class="cm-tile-count" aria-label="@($"Картинок: {count}")"><i class="fa-solid fa-images" aria-hidden="true"></i> @count</span>
                    }
                </span>
                <span class="cm-tile-body">
                    <span class="cm-tile-name">@item.Name</span>
                    <span class="cm-tile-meta">@Tile!(item)@Eras(item)</span>
                </span>
            </button>
        </article>
    };

    // Карточка — обложка слева, название с шевроном, текст страницы; раскрывает касание в любом месте (растянутая кнопка-название).
    private RenderFragment WideOf(TItem item) => __builder =>
    {
        <article id="@RecordId(item.Id)" class="@Css.Join("cm-card cm-wide", _canEdit ? "cm-wide-editable" : null)" @key="item.Id">
            @if (AnyCover)
            {
                @Cover(item, "cm-wide-cover")
            }
            <div class="cm-wide-text">
                <div class="cm-wide-head">
                    @* Название и метки переносятся между собой; шеврон остаётся в первой строке у правого края. *@
                    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1">
                        <button type="button" class="cm-wide-toggle" aria-expanded="false" @onclick="() => ToggleOpenAsync(item)">@item.Name</button>
                        @Badges?.Invoke(item)
                    </div>
                    <i class="fa-solid fa-chevron-down mt-1 shrink-0 text-sm text-primary-400" aria-hidden="true"></i>
                </div>
                @Cards!(item)
                @Eras(item)
            </div>
            @if (_canEdit)
            {
                <div class="cm-wide-edit cm-compact">@EditButton(item)</div>
            }
        </article>
    };

    // Раскрытая запись галереи и карточек — во всю ширину сетки: шапка (шеврон-название, метки, «Изменить»), картинка слева, сведения справа.
    private RenderFragment RecordOf(TItem item) => __builder =>
    {
        <article id="@RecordId(item.Id)" class="cm-card cm-record" @key="item.Id">
            <div class="cm-card-header gap-3">
                <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1">
                    <button type="button" class="flex min-h-9 min-w-0 items-center gap-2 text-left" aria-expanded="true"
                            @onclick="() => ToggleOpenAsync(item)">
                        <i class="fa-solid fa-chevron-up shrink-0 text-sm text-primary-400" aria-hidden="true"></i>
                        <span class="cm-card-title min-w-0 break-words">@item.Name</span>
                    </button>
                    @Badges?.Invoke(item)
                    @Eras(item)
                </div>
                @if (_canEdit)
                {
                    <div class="cm-compact shrink-0">@EditButton(item)</div>
                }
            </div>
            <div class="cm-card-body">@RecordBody(item, inTable: false)</div>
        </article>
    };

    private RenderFragment RecordBody(TItem item, bool inTable) => __builder =>
    {
        var images = ImagesOf?.Invoke(item) ?? [];
        <div class="@Css.Join("cm-record-body", DetailsFirstOnPhone && _canEdit ? "cm-record-details-first" : null)">
            @if (images.Count > 0)
            {
                <div class="@CatalogArtCss.Figure(Art)">
                    <CatalogImageGallery @key="item.Id" Images="images" Alt="@item.Name" />
                </div>
            }
            <div class="cm-record-text">
                @if (Details is not null)
                {
                    @Details(new CatalogDetails<TItem>(item, inTable))
                }
                else
                {
                    @RowDetail?.Invoke(item)
                }
            </div>
        </div>
    };

    // Раскрытая карточка встаёт во всю ширину сетки своим рядом и уезжает от места касания — прокрутить к ней. Свернули —
    // забыть: та же запись, раскрытая снова, опять встанет не там, где её коснулись. Таблица показывает раскрытую строку сама.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsTable || OpenId is not { } open || _items.Count == 0)
        {
            if (OpenId is null)
            {
                _revealed = null;
            }

            return;
        }

        if (open == _revealed)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CampaignManager.UI/Catalogs/CatalogPage.razor.js");
            if (await _module.InvokeAsync<bool>("reveal", RecordId(open)))
            {
                _revealed = open;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // ── Правка ──

    private async Task AddAsync()
    {
        await OnFormOpening.InvokeAsync();
        if (EditHref is not null)
        {
            Navigation.NavigateTo(EditHref(null));
            return;
        }

        _isNew = true;
        _editing = New();
        _initialJson = Serialize(_editing);
        _state.Reset();
        _formError = null;
        _formUsage = null;
        _stale = false;
    }

    private async Task EditAsync(TItem item)
    {
        await OnFormOpening.InvokeAsync();
        if (EditHref is not null)
        {
            Navigation.NavigateTo(EditHref(item));
            return;
        }

        _isNew = false;
        _editing = Copy(item);
        _initialJson = Serialize(_editing);
        _editingName = item.Name;
        _state.Reset();
        _formError = null;
        _formUsage = null;
        _stale = false;
    }

    // Отмена и крестик спрашивают, если форму успели изменить; сохранение закрывает окно без вопроса.
    private async Task CloseFormAsync()
    {
        if (_guard is not null && !await _guard.ConfirmLeaveAsync())
        {
            return;
        }

        CloseForm();
    }

    private bool IsDirty => _editing is not null && Serialize(_editing) != _initialJson;

    private void CloseForm()
    {
        _editing = null;
        _state.Reset();
        _formError = null;
        _formUsage = null;
        _stale = false;
    }

    private IReadOnlyDictionary<string, string> Check(TItem item)
    {
        var errors = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            errors["name"] = "Нужно название.";
        }

        if (Validate is not null)
        {
            foreach (var (key, message) in Validate(item))
            {
                errors.TryAdd(key, message);
            }
        }

        return errors;
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }

        var errors = Check(_editing);
        if (errors.Count > 0)
        {
            _state.Set(errors);
            _state.Attempted = true;
            _state.Attempt++;
            _formError = null;
        _formUsage = null;
            return;
        }

        _saving = true;
        _formError = null;
        _formUsage = null;
        _stale = false;
        try
        {
            var saved = _isNew ? await Api.CreateAsync(_editing) : await Api.UpdateAsync(_editing);
            var index = _items.FindIndex(i => i.Id == saved.Id);
            if (index >= 0)
            {
                _items[index] = saved;
            }
            else
            {
                _items.Add(saved);
            }

            Toasts.Success($"Сохранено: {Names.Plain(saved.Name)}.");
            _editing = null;
            await OnLoaded.InvokeAsync(_items);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
            _stale = ex.IsStale;
        }
        catch (HttpRequestException ex)
        {
            _formError = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Запись изменили на другом устройстве: перечитать список и открыть свежую копию.</summary>
    private async Task RereadAsync()
    {
        var id = _editing?.Id;
        await ReloadAsync();
        _editing = _items.FirstOrDefault(i => i.Id == id) is { } fresh ? Copy(fresh) : null;
        _initialJson = _editing is null ? null : Serialize(_editing);
        _formError = _editing is null ? null : "Это свежая версия записи — ваши правки нужно внести заново.";
        _stale = false;
    }

    private Task<bool> DeleteAsync(TItem item) => DeleteAsync(item, fromForm: false);

    /// <summary>Из окна правки отказ — Alert над кнопками окна: тост рисуется под окном и там не виден.</summary>
    private async Task<bool> DeleteAsync(TItem item, bool fromForm)
    {
        // Кто держит запись, говорим до вопроса: навык у профессий не удалить — вопрос об этом лишний; оружие в листах
        // удалить можно, но Хранитель должен знать, что там останется (X13, W10).
        var consequence = "Пропадёт из справочника.";
        try
        {
            var usage = await Api.UsageAsync(item.Id);
            if (usage.Count > 0)
            {
                var shown = usage.Examples.Take(3).ToList(); // три имени и «ещё N»: вопрос не должен быть абзацем
                var more = usage.Count > shown.Count ? $" и ещё {usage.Count - shown.Count}" : "";
                var holders = $"Используется: {string.Join(", ", shown)}{more}.";
                if (usage.Blocks)
                {
                    var refusal = $"Нельзя удалить. {holders} Сначала уберите ссылки.";
                    if (fromForm)
                    {
                        _formUsage = usage;
                        _formError = null;
                        _stale = false;
                    }
                    else
                    {
                        Toasts.Error(refusal, "Не удалось удалить");
                    }

                    return false;
                }

                consequence = $"Пропадёт из справочника. {holders}{(usage.Note is null ? "" : " " + usage.Note)}";
            }
        }
        catch (HttpRequestException)
        {
            // Без сведений — обычное подтверждение; сервер всё равно откажет, если запись занята.
        }

        var confirmed = await Dialogs.ConfirmDeleteAsync(Noun, Names.Plain(item.Name), consequence, reversible: false);
        if (!confirmed)
        {
            return false;
        }

        try
        {
            await Api.DeleteAsync(item.Id);
            _items.RemoveAll(i => i.Id == item.Id);
            Toasts.Success($"Удалено: {Names.Plain(item.Name)}.");
            await OnLoaded.InvokeAsync(_items);
            return true;
        }
        catch (HttpRequestException ex)
        {
            if (fromForm)
            {
                _formError = ApiErrors.Describe(ex);
                _stale = false;
            }
            else
            {
                Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
            }

            return false;
        }
    }

    /// <summary>«Удалить» из окна правки: подтверждение, удаление и закрытие окна без вопроса о правках.</summary>
    private async Task DeleteEditingAsync()
    {
        if (_editing is { } item && await DeleteAsync(item, fromForm: true))
        {
            CloseForm();
        }
    }

    private async Task SyncAsync()
    {
        // Без «сида» и «кода» (O3). Кнопка красная, а значит фокус — на «Отмене»: подтверждение стирает ручные правки
        // книжных записей, и Enter после случайного касания не должен их стирать.
        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Сверить с книгой правил?",
            "Записи из книги правил обновятся, недостающие добавятся. Ваши записи не изменятся.")
        {
            ConfirmText = "Сверить",
            Details = "Ваши правки книжных записей пропадут. Нельзя отменить.",
        });
        if (!confirmed)
        {
            return;
        }

        _syncing = true;
        try
        {
            _syncReport = await Api.SyncAsync(dryRun: false);
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Сверка не удалась");
        }
        finally
        {
            _syncing = false;
        }
    }

    /// <summary>Копия записи для формы — через тот же сгенерированный JSON, что и API: новое поле копируется само.</summary>
    private static TItem Copy(TItem item) => JsonSerializer.Deserialize(Serialize(item), ItemType)!;

    private static string Serialize(TItem item) => JsonSerializer.Serialize(item, ItemType);
}
