@typeparam TItem where TItem : CatalogItemDto
@using System.Text.Json
@using System.Text.Json.Serialization.Metadata
@using CampaignManager.Contracts.Catalogs
@using CampaignManager.UI.Platform
@using CampaignManager.Contracts.Platform
@using CampaignManager.Core
@using CampaignManager.Core.Catalogs
@inject ICatalogApi<TItem> Api
@inject DialogService Dialogs
@inject ToastService Toasts
@inject NavigationManager Navigation
@implements IDisposable

@* Страница справочника — одна на все семь (в v1 четыре плотных каталога совпадали на 83–88%).
   Список приходит целиком (справочники маленькие), поиск, фильтры, сортировка и страницы — здесь,
   у всех справочников одинаково. Своё у справочника — колонки (Columns) или своя раскладка (Body:
   карточки профессий, галерея бестиария), раскрытие, форма. Кнопки правки — только при CanEdit из
   API; защищает сервер (403), здесь они просто не рисуются.

   Общий каркас (UX-0b, правила 4, 11, 12, 17): раскрытая запись всегда в адресе (?open=), у всех справочников;
   одна кнопка «Сбросить фильтры» (неактивна, пока фильтров нет); эпоха — только когда записи из разных эпох;
   пагинация под списком, вне карточки; в строке одна иконка «Изменить», «Удалить» — в окне правки; название и тип
   не обрезаются; пустое — одной строкой («Нет книг.» / «Нет книг по этим условиям.»); уход с несохранённой
   формы — один вопрос. *@
<PageHeader Title="@Title">
    <Actions>
        @if (_canEdit)
        {
            <Button Small="true" Icon="fa-plus" OnClick="AddAsync">@AddLabel</Button>
        }
    </Actions>
</PageHeader>

<div class="cm-page">
    <FilterPanel OnReset="ResetFilters" CanReset="HasFilters">
        <ChildContent>
            <input class="cm-input min-w-48 flex-1" type="search" placeholder="@SearchPlaceholder" aria-label="Поиск"
                   value="@_search" @oninput="OnSearch" />
            @if (HasExtraFilters)
            {
                @* На телефоне фильтры, порядок и флажки прячутся за одной кнопкой (панель занимала 300–380px из 844); с md
                   обёртка display: contents — поля остаются прямыми детьми строки FilterPanel. *@
                <Button Variant="ButtonVariant.Secondary" Icon="fa-sliders" class="md:hidden" aria-expanded="@(_filtersOpen ? "true" : "false")"
                        OnClick="() => _filtersOpen = !_filtersOpen">@(ActiveExtra > 0 ? $"Фильтры ({ActiveExtra})" : "Фильтры")</Button>
            }
            <div class="@(_filtersOpen ? "contents" : "hidden md:contents")">
                @foreach (var filter in Filters)
                {
                    var current = filter;
                    <select class="cm-input w-full sm:w-56 shrink-0" aria-label="@current.AllLabel"
                            value="@(_filters.GetValueOrDefault(current.Key) ?? "")" @onchange="e => SetFilter(current.Key, e.Value?.ToString())">
                        <option value="">@current.AllLabel</option>
                        @foreach (var option in current.Options)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                }
                @if (ErasVary || _era is not null)
                {
                    <select class="cm-input w-full sm:w-44 shrink-0" aria-label="Эпоха" value="@(_era?.ToString() ?? "")" @onchange="SetEra">
                        <option value="">@Terms.AnyEra</option>
                        @foreach (var era in Enum.GetValues<Era>())
                        {
                            <option value="@era">@CatalogText.Of(era)</option>
                        }
                    </select>
                }
                @if (Sorts.Count > 1)
                {
                    <select class="cm-input w-full sm:w-52 shrink-0" aria-label="Сортировка" value="@SortKey" @onchange="e => { _sortKey = e.Value?.ToString(); _page = 1; }">
                        @foreach (var sort in Sorts)
                        {
                            <option value="@sort.Key">@sort.Label</option>
                        }
                    </select>
                }
                @foreach (var toggle in Toggles)
                {
                    var current = toggle;
                    <label class="flex min-h-9 shrink-0 items-center gap-2 text-sm text-primary-700">
                        <input type="checkbox" class="cm-checkbox" checked="@_toggles.Contains(current.Key)" @onchange="e => SetToggle(current.Key, e.Value is true)" />
                        <span>@current.Label</span>
                    </label>
                }
            </div>
        </ChildContent>
        <Actions>
            @ToolbarActions
            @if (_canEdit)
            {
                @* Импорт, экспорт и «С правилами» — редкие действия: одно «⋯», а не ряд из трёх кнопок (на телефоне он рвался). *@
                <RowMenu AriaLabel="@(Sync ? "Ещё: импорт, экспорт, синхронизация" : "Ещё: импорт, экспорт")">
                    <RowMenuItem Icon="fa-file-import" OnClick="() => _importOpen = true">Импорт</RowMenuItem>
                    <RowMenuItem Icon="fa-file-export" OnClick="ExportAsync">Экспорт</RowMenuItem>
                    @if (Sync)
                    {
                        <RowMenuItem Icon="fa-rotate" Disabled="_syncing" OnClick="SyncAsync">С правилами</RowMenuItem>
                    }
                </RowMenu>
            }
        </Actions>
    </FilterPanel>

    <AsyncContent @ref="_content" TData="CatalogList<TItem>" Load="LoadAsync" IsEmpty="_ => false" LoadingMessage="Загрузка справочника…">
        @{
            var view = View();
        }
        @if (_items.Count == 0)
        {
            @* Большая карточка — только когда пуста вся страница и в шапке нет «Добавить» (правило 4). *@
            @if (_canEdit)
            {
                <p class="cm-empty-line">@Terms.Empty(Plural)</p>
            }
            else
            {
                <EmptyState Title="@Terms.Empty(Plural)" Message="Хранитель ещё ничего сюда не добавил." Icon="@Icon" />
            }
        }
        else if (view.Filtered.Count == 0)
        {
            <p class="cm-empty-line">
                <span>@Terms.EmptyFiltered(Plural)</span>
                <Button Variant="ButtonVariant.Secondary" Icon="fa-rotate-left" OnClick="ResetFilters">@Terms.ResetFilters</Button>
            </p>
        }
        else if (Body is not null)
        {
            @Body(view)
            <Pagination CurrentPage="_page" PageSize="PageSize" TotalItems="view.Filtered.Count" CurrentPageChanged="SetPage" />
        }
        else
        {
            <div class="cm-card">
                @* Ключ — фильтры, которые прячут колонки и метки: ячейки DataColumn таблица рисует раньше, чем
                   колонки получат новый вид, и без пересоздания метка эпохи отставала бы на один рендер. *@
                <DataTable @key="ColumnsKey" TItem="TItem" Items="view.Filtered" RowKey="i => i.Id" Page="_page" PageSize="PageSize"
                           TableFrom="TableFrom" Scroll="Scroll" RowDetail="RowDetail" CanExpand="CanExpand"
                           OpenKey="(object?)OpenId" OpenKeyChanged="SetOpenKey"
                           CardTemplate="CardTemplate is null ? null : Card" AriaLabel="@Title">
                    <Columns>
                        @Columns?.Invoke(view)
                        @if (_canEdit)
                        {
                            <DataColumn TItem="TItem" Title="" CellClass="w-px whitespace-nowrap text-right" Context="item">
                                @RowActions(item)
                            </DataColumn>
                        }
                    </Columns>
                </DataTable>
            </div>
            @* Страницы — под карточкой, вне её (правило 17). *@
            <Pagination CurrentPage="_page" PageSize="PageSize" TotalItems="view.Filtered.Count" CurrentPageChanged="SetPage" />
        }
    </AsyncContent>
</div>

@if (Form is not null)
{
    <UnsavedChangesGuard @ref="_guard" Dirty="IsDirty" />
    <Modal Open="_editing is not null" Title="@FormTitle" Size="FormSize" OnClose="CloseFormAsync">
        <ChildContent>
            @if (_editing is not null)
            {
                _state.ErasVary = ErasVary;
                if (_state.Attempted)
                {
                    _state.Set(Check(_editing)); // после первой попытки ошибки гаснут по мере правки
                }

                @Form(_editing)
                @* «Удалить» — не в строке, а здесь (правило 7): рядом с частым действием опасного не ставим. *@
                @if (!_isNew && _canEdit)
                {
                    <div class="cm-danger-zone">
                        <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="DeleteEditingAsync">Удалить @Noun</Button>
                    </div>
                }
            }
        </ChildContent>
        <FooterHint>
            @* Все ошибки полей сразу и рядом с кнопкой; страница прокручивается к первой (правило 9). *@
            <FormErrors Errors="_state.Messages" Attempt="_state.Attempt" />
        </FooterHint>
        <FooterError>
            @if (_formError is not null)
            {
                <Alert Tone="Tone.Error" ShowIcon="true" class="mb-0">
                    <ChildContent>@_formError</ChildContent>
                    <Actions>
                        @if (_stale)
                        {
                            <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-rotate-right" OnClick="RereadAsync">Перечитать</Button>
                        }
                    </Actions>
                </Alert>
            }
        </FooterError>
        <Footer>
            <Button Variant="ButtonVariant.Secondary" OnClick="CloseFormAsync">Отмена</Button>
            <Button Icon="fa-floppy-disk" Busy="_saving" OnClick="SaveAsync">Сохранить</Button>
        </Footer>
    </Modal>
}

<CatalogImportModal TItem="TItem" Open="_importOpen" Title="@($"Импорт: {Title.ToLowerInvariant()}")"
                    OnClose="() => _importOpen = false" OnImported="ReloadAsync" />

<Modal Open="_syncReport is not null" Title="Синхронизация с правилами" Size="ModalSize.Large" OnClose="() => _syncReport = null">
    <ChildContent>
        @if (_syncReport is not null)
        {
            <CatalogReportView Report="_syncReport" />
        }
    </ChildContent>
    <Footer>
        <Button OnClick="() => _syncReport = null">Готово</Button>
    </Footer>
</Modal>

@code {
    private static readonly JsonTypeInfo<TItem> ItemType =
        (JsonTypeInfo<TItem>)CampaignManager.Contracts.ContractsJsonContext.Default.GetTypeInfo(typeof(TItem))!;

    private AsyncContent<CatalogList<TItem>>? _content;
    private List<TItem> _items = [];
    private bool _canEdit;
    private string _search = "";
    private readonly Dictionary<string, string> _filters = [];
    private readonly HashSet<string> _toggles = [];
    private Era? _era;
    private int _page = 1;
    private TItem? _editing;
    private bool _isNew;
    private bool _saving;
    private string? _formError;
    private bool _stale;
    private bool _importOpen;
    private string? _initialJson;
    private UnsavedChangesGuard? _guard;
    private bool _syncing;
    private bool _filtersOpen;
    private CatalogImportReport? _syncReport;
    private Guid? _pagedTo;
    private CatalogFormState _ownState = new();

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Иконка пустого справочника — та же, что у пункта меню.</summary>
    [Parameter] public string Icon { get; set; } = "fa-book";

    /// <summary>
    /// Свои кнопки страницы в панели фильтров, перед «Импорт» (фонотека: «Загрузить файлы»). Не в шапке: на
    /// телефоне в ней помещаются две подписанные кнопки, а там уже «Добавить» и кнопки модулей. Права — на странице.
    /// </summary>
    [Parameter] public RenderFragment? ToolbarActions { get; set; }

    /// <summary>«Добавить оружие».</summary>
    [Parameter, EditorRequired] public string AddLabel { get; set; } = "Добавить";

    /// <summary>«оружие», «навык» — в подтверждении удаления.</summary>
    [Parameter, EditorRequired] public string Noun { get; set; } = "";

    /// <summary>«оружия», «книг» — для пустого состояния: «Нет книг.» / «Нет книг по этим условиям.»</summary>
    [Parameter] public string Plural { get; set; } = "записей";

    [Parameter] public string SearchPlaceholder { get; set; } = "Поиск по названию";

    /// <summary>Что ещё искать, кроме названия: другие названия, автор.</summary>
    [Parameter] public Func<TItem, IEnumerable<string?>>? SearchAlso { get; set; }

    [Parameter] public IReadOnlyList<CatalogFilter<TItem>> Filters { get; set; } = [];

    [Parameter] public IReadOnlyList<CatalogToggle<TItem>> Toggles { get; set; } = [];

    /// <summary>Порядок для своей раскладки без заголовков таблицы (карточки профессий): выбор в панели фильтров.</summary>
    [Parameter] public IReadOnlyList<CatalogSort<TItem>> Sorts { get; set; } = [];

    /// <summary>Эпохи записи — у справочника с эпохой появляется фильтр по ней.</summary>
    [Parameter] public Func<TItem, IReadOnlyList<Era>>? ErasOf { get; set; }

    [Parameter] public int PageSize { get; set; } = 25;

    /// <summary>Колонки таблицы (DataColumn); получают вид — чтобы прятать то, что фиксирует фильтр.</summary>
    [Parameter] public RenderFragment<CatalogView<TItem>>? Columns { get; set; }

    /// <summary>Своя раскладка вместо таблицы: карточки профессий, галерея бестиария.</summary>
    [Parameter] public RenderFragment<CatalogView<TItem>>? Body { get; set; }

    /// <summary>Строка-карточка на узком экране (кнопки правки страница добавит сама).</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    [Parameter] public RenderFragment<TItem>? RowDetail { get; set; }

    [Parameter] public Func<TItem, bool>? CanExpand { get; set; }

    [Parameter] public TableBreakpoint TableFrom { get; set; } = TableBreakpoint.Md;

    /// <summary>Плотный справочник: таблица — свой скроллпорт с липкими шапкой и названием.</summary>
    [Parameter] public bool Scroll { get; set; } = true;

    /// <summary>
    /// Проверка формы до отправки: поле → текст ошибки (все сразу, правило 9). Название проверяется всегда; страница
    /// добавляет своё обязательное (урон и навык оружия, тип заклинания). Остальное проверяет сервер.
    /// </summary>
    [Parameter] public Func<TItem, IReadOnlyDictionary<string, string>>? Validate { get; set; }

    /// <summary>Ошибки формы по полям: страница читает их в <c>Form</c> (<see cref="CatalogFormState.For"/>); не задан — свой.</summary>
    [Parameter] public CatalogFormState? State { get; set; }

    private CatalogFormState _state => State ?? _ownState;

    /// <summary>Форма записи в окне; получает копию — отмена ничего не портит.</summary>
    [Parameter] public RenderFragment<TItem>? Form { get; set; }

    [Parameter] public ModalSize FormSize { get; set; } = ModalSize.Large;

    /// <summary>Новая запись для формы.</summary>
    [Parameter, EditorRequired] public Func<TItem> New { get; set; } = null!;

    /// <summary>Правка на своей странице (статблок не помещается в окно): адрес; null — новая.</summary>
    [Parameter] public Func<TItem?, string>? EditHref { get; set; }

    /// <summary>Форма открывается — странице пора загрузить то, что нужно только форме (навыки для оружия).</summary>
    [Parameter] public EventCallback OnFormOpening { get; set; }

    /// <summary>Есть сид книги — кнопка «С правилами».</summary>
    [Parameter] public bool Sync { get; set; }

    /// <summary>
    /// Раскрытая запись, если страница сама разбирает адрес. Не нужен: каркас читает <c>?open=</c> сам и следит за
    /// его сменой — параметр остался для страниц, которым запись нужна и у себя (галерея бестиария).
    /// </summary>
    [Parameter] public Guid? Open { get; set; }

    /// <summary>Список загружен или изменился — странице, которой нужны имена (родители навыков).</summary>
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnLoaded { get; set; }

    // Заголовок — имя на момент открытия: пока его правят, окно не должно переименовываться.
    private string FormTitle => _isNew ? AddLabel : $"Изменить: {_editingName}";

    private string? _editingName;

    // ?q= — поиск из ссылки (заклинание книги ведёт на справочник заклинаний).
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var query = new Uri(Navigation.Uri).Query;
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair is ["q", var value])
            {
                _search = Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
            }
        }
    }

    // ?open= меняют и переход по ссылке, и «назад»: страница перерисовывается по смене адреса, а не по своим кликам.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <summary>Раскрытая запись: из адреса (<c>?open=</c>), иначе — переданная страницей.</summary>
    private Guid? OpenId => OpenFromQuery() ?? Open;

    private Guid? OpenFromQuery()
    {
        foreach (var part in new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.Split('=', 2) is ["open", var value] && Guid.TryParse(Uri.UnescapeDataString(value), out var id))
            {
                return id;
            }
        }

        return null;
    }

    private Task SetOpenKey(object? key)
    {
        var open = key is Guid id ? (Guid?)id : null;
        _pagedTo = open;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("open", open), replace: true);
        return Task.CompletedTask;
    }

    private async Task<CatalogList<TItem>> LoadAsync(CancellationToken cancellationToken)
    {
        var list = await Api.ListAsync(cancellationToken);
        _items = [.. list.Items];
        _canEdit = list.CanEdit;
        _pagedTo = null;
        await OnLoaded.InvokeAsync(_items);
        // Права пришли со списком: шапке и панели фильтров (они вне AsyncContent) нужен свой рендер.
        StateHasChanged();
        return list;
    }

    /// <summary>Перечитать список (после того, что страница записала мимо формы: пачка файлов).</summary>
    public Task ReloadAsync() => _content?.ReloadAsync() ?? Task.CompletedTask;

    private CatalogView<TItem> View()
    {
        var filtered = Order(_items.Where(Matches)).ToList();
        // Раскрытая по адресу запись — на своей странице, а не «где-то дальше».
        if (OpenId is { } open && _pagedTo != open && PageSize > 0)
        {
            var index = filtered.FindIndex(i => i.Id == open);
            if (index >= 0)
            {
                _page = index / PageSize + 1;
            }

            _pagedTo = open;
        }

        var page = PageSize > 0 ? filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList() : filtered;
        return new CatalogView<TItem>
        {
            All = _items,
            Filtered = filtered,
            Page = page,
            CanEdit = _canEdit,
            Filters = _filters,
            Era = _era,
            ErasVary = ErasVary,
            Actions = RowActions,
            Edit = EditAsync,
            Delete = DeleteAsync,
            Open = OpenId,
            ToggleOpen = ToggleOpenAsync,
        };
    }

    private string SortKey => _sortKey is not null && Sorts.Any(s => s.Key == _sortKey) ? _sortKey : Sorts.FirstOrDefault()?.Key ?? "";

    private string? _sortKey;

    private IEnumerable<TItem> Order(IEnumerable<TItem> items)
    {
        var sort = Sorts.FirstOrDefault(s => s.Key == SortKey);
        if (sort is null)
        {
            return items.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);
        }

        var ordered = sort.Descending
            ? items.OrderByDescending(sort.By, Comparer<object?>.Default)
            : items.OrderBy(sort.By, Comparer<object?>.Default);
        return ordered.ThenBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    private bool Matches(TItem item)
    {
        if (_search.Length > 0)
        {
            var needle = CatalogCodeTable.NormalizeName(_search);
            var haystack = (SearchAlso?.Invoke(item) ?? []).Prepend(item.Name);
            if (!haystack.Any(text => text is not null && CatalogCodeTable.NormalizeName(text).Contains(needle, StringComparison.Ordinal)))
            {
                return false;
            }
        }

        foreach (var filter in Filters)
        {
            if (_filters.TryGetValue(filter.Key, out var value) && !filter.Matches(item, value))
            {
                return false;
            }
        }

        foreach (var toggle in Toggles)
        {
            if (_toggles.Contains(toggle.Key) && !toggle.Matches(item))
            {
                return false;
            }
        }

        return _era is not { } era || ErasOf is null || ErasOf(item).Contains(era);
    }

    /// <summary>
    /// Эпоха различает записи, только если они из разных эпох. Перенос оставил одну классику (современная
    /// эпоха не переносится, решение владельца 2026-10-02) — тогда ни фильтра, ни меток: «1920-е» в каждой
    /// строке ничего не различает. Появится запись другой эпохи — появятся и они.
    /// </summary>
    private bool ErasVary => ErasOf is not null
        && _items.Select(i => string.Join(",", ErasOf(i).Order())).Distinct().Skip(1).Any();

    /// <summary>Есть что сбрасывать: «Сбросить фильтры» неактивна, пока поиск и фильтры пусты (правило 4).</summary>
    private bool HasFilters => _search.Length > 0 || _filters.Count > 0 || _toggles.Count > 0 || _era is not null;

    private string ColumnsKey => $"{_era}|{string.Join(",", _filters.OrderBy(f => f.Key).Select(f => $"{f.Key}={f.Value}"))}";

    private bool HasExtraFilters => Filters.Count > 0 || Toggles.Count > 0 || Sorts.Count > 1 || ErasVary || _era is not null;

    /// <summary>Сколько из спрятанных на телефоне фильтров включено — на кнопке «Фильтры (2)».</summary>
    private int ActiveExtra => _filters.Count + _toggles.Count + (_era is null ? 0 : 1);

    // Экспорт — ссылка на API с «download»: из меню — переход, браузер скачивает и страницу не покидает.
    private void ExportAsync() => Navigation.NavigateTo(Api.Route.Export, forceLoad: true);

    private int TotalPages(int count) => PageSize > 0 ? (count + PageSize - 1) / PageSize : 1;

    // Любой фильтр возвращает на первую страницу: иначе с пятой страницы поиск уводит в пустоту.
    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString()?.Trim() ?? "";
        _page = 1;
    }

    private void SetFilter(string key, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            _filters.Remove(key);
        }
        else
        {
            _filters[key] = value;
        }

        _page = 1;
    }

    private void SetToggle(string key, bool on)
    {
        if (on)
        {
            _toggles.Add(key);
        }
        else
        {
            _toggles.Remove(key);
        }

        _page = 1;
    }

    private void SetEra(ChangeEventArgs e)
    {
        _era = Enum.TryParse<Era>(e.Value?.ToString(), out var era) ? era : null;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _filters.Clear();
        _toggles.Clear();
        _era = null;
        _page = 1;
    }

    private void SetPage(int page) => _page = page;

    private Task ToggleOpenAsync(TItem item)
    {
        return SetOpenKey(OpenId == item.Id ? null : item.Id);
    }

    // ── Строка ──

    // В строке каталога одна иконка «Изменить» (правило 7): «Удалить» — в окне правки. Иконка 36px — плотная
    // таблица справочника, где это допустимо; в карточке на узком экране — полная кнопка 44px.
    private RenderFragment<TItem> RowActions => item => __builder =>
    {
        if (!_canEdit)
        {
            return;
        }

        <div class="inline-flex gap-2" @onclick:stopPropagation="true">
            <Button Variant="ButtonVariant.OutlinePrimary" Small="true" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(item.Name)}")"
                    OnClick="() => EditAsync(item)" />
        </div>
    };

    private RenderFragment<TItem> Card => item => __builder =>
    {
        <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
                @CardTemplate!(item)
                @if (ErasOf is not null && ErasVary && _era is null)
                {
                    <EraBadges Values="ErasOf(item)" />
                }
            </div>
            @if (_canEdit)
            {
                <Button Variant="ButtonVariant.OutlinePrimary" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(item.Name)}")"
                        OnClick="() => EditAsync(item)" />
            }
        </div>
        @if (RowDetail is not null && (CanExpand?.Invoke(item) ?? true))
        {
            var open = OpenId == item.Id;
            @* px-0 — на общей левой линии карточки; зону касания добирает высота, а не боковые поля. *@
            <Button Variant="ButtonVariant.Ghost" class="mt-1 px-0" Icon="@(open ? "fa-chevron-up" : "fa-chevron-down")"
                    aria-expanded="@(open ? "true" : "false")" OnClick="() => ToggleOpenAsync(item)">@(open ? "Свернуть" : "Подробнее")</Button>
            @if (open)
            {
                <div class="mt-2 rounded-md bg-primary-50 p-3">@RowDetail(item)</div>
            }
        }
    };

    // ── Правка ──

    private async Task AddAsync()
    {
        await OnFormOpening.InvokeAsync();
        if (EditHref is not null)
        {
            Navigation.NavigateTo(EditHref(null));
            return;
        }

        _isNew = true;
        _editing = New();
        _initialJson = Serialize(_editing);
        _state.Reset();
        _formError = null;
        _stale = false;
    }

    private async Task EditAsync(TItem item)
    {
        await OnFormOpening.InvokeAsync();
        if (EditHref is not null)
        {
            Navigation.NavigateTo(EditHref(item));
            return;
        }

        _isNew = false;
        _editing = Copy(item);
        _initialJson = Serialize(_editing);
        _editingName = item.Name;
        _state.Reset();
        _formError = null;
        _stale = false;
    }

    // Отмена и крестик спрашивают, если форму успели изменить; сохранение закрывает окно без вопроса.
    private async Task CloseFormAsync()
    {
        if (_guard is not null && !await _guard.ConfirmLeaveAsync())
        {
            return;
        }

        CloseForm();
    }

    private bool IsDirty => _editing is not null && Serialize(_editing) != _initialJson;

    private void CloseForm()
    {
        _editing = null;
        _state.Reset();
        _formError = null;
        _stale = false;
    }

    private IReadOnlyDictionary<string, string> Check(TItem item)
    {
        var errors = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            errors["name"] = "Нужно название.";
        }

        if (Validate is not null)
        {
            foreach (var (key, message) in Validate(item))
            {
                errors.TryAdd(key, message);
            }
        }

        return errors;
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            return;
        }

        var errors = Check(_editing);
        if (errors.Count > 0)
        {
            _state.Set(errors);
            _state.Attempted = true;
            _state.Attempt++;
            _formError = null;
            return;
        }

        _saving = true;
        _formError = null;
        _stale = false;
        try
        {
            var saved = _isNew ? await Api.CreateAsync(_editing) : await Api.UpdateAsync(_editing);
            var index = _items.FindIndex(i => i.Id == saved.Id);
            if (index >= 0)
            {
                _items[index] = saved;
            }
            else
            {
                _items.Add(saved);
            }

            Toasts.Success($"Сохранено: {Names.Plain(saved.Name)}.");
            _editing = null;
            await OnLoaded.InvokeAsync(_items);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
            _stale = ex.IsStale;
        }
        catch (HttpRequestException ex)
        {
            _formError = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Запись изменили на другом устройстве: перечитать список и открыть свежую копию.</summary>
    private async Task RereadAsync()
    {
        var id = _editing?.Id;
        await ReloadAsync();
        _editing = _items.FirstOrDefault(i => i.Id == id) is { } fresh ? Copy(fresh) : null;
        _initialJson = _editing is null ? null : Serialize(_editing);
        _formError = _editing is null ? null : "Это свежая версия записи — ваши правки нужно внести заново.";
        _stale = false;
    }

    private Task<bool> DeleteAsync(TItem item) => DeleteAsync(item, fromForm: false);

    /// <summary>Из окна правки отказ — Alert над кнопками окна: тост рисуется под окном и там не виден.</summary>
    private async Task<bool> DeleteAsync(TItem item, bool fromForm)
    {
        var confirmed = await Dialogs.ConfirmDeleteAsync(Noun, Names.Plain(item.Name), "Пропадёт из справочника.", reversible: false);
        if (!confirmed)
        {
            return false;
        }

        try
        {
            await Api.DeleteAsync(item.Id);
            _items.RemoveAll(i => i.Id == item.Id);
            Toasts.Success($"Удалено: {Names.Plain(item.Name)}.");
            await OnLoaded.InvokeAsync(_items);
            return true;
        }
        catch (HttpRequestException ex)
        {
            if (fromForm)
            {
                _formError = ApiErrors.Describe(ex);
                _stale = false;
            }
            else
            {
                Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
            }

            return false;
        }
    }

    /// <summary>«Удалить» из окна правки: подтверждение, удаление и закрытие окна без вопроса о правках.</summary>
    private async Task DeleteEditingAsync()
    {
        if (_editing is { } item && await DeleteAsync(item, fromForm: true))
        {
            CloseForm();
        }
    }

    private async Task SyncAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync(new ConfirmRequest(
            "Синхронизировать с правилами?",
            "Книжные записи обновятся по сиду книги (по коду), недостающие добавятся. Самодельные записи не изменятся.")
        {
            ConfirmText = "Синхронизировать",
            ConfirmVariant = ButtonVariant.Primary,
            Details = "Правки книжных записей, сделанные вручную, перезапишутся.",
        });
        if (!confirmed)
        {
            return;
        }

        _syncing = true;
        try
        {
            _syncReport = await Api.SyncAsync(dryRun: false);
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Синхронизация не удалась");
        }
        finally
        {
            _syncing = false;
        }
    }

    /// <summary>Копия записи для формы — через тот же сгенерированный JSON, что и API: новое поле копируется само.</summary>
    private static TItem Copy(TItem item) => JsonSerializer.Deserialize(Serialize(item), ItemType)!;

    private static string Serialize(TItem item) => JsonSerializer.Serialize(item, ItemType);
}
