@page "/bestiary"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs

@* Бестиарий — галерея общей системы справочников (CatalogPage, Styles/catalog.css; выбор владельца 2026-10-09 — плитка как у
   всех): рисунок 4:5 целиком (раньше его резали в квадрат и писали имя поверх затемнения), под ним имя и у Хранителя — ПЗ, броня
   и потеря Рассудка; группы по типу, без страниц. Касание раскрывает полный статблок во всю ширину сетки: картинки слева (на
   телефоне у Хранителя — после статблока, B5), статблок и описание справа. Правка — своя страница: статблок в окно не помещается.
   Игроку (CanEdit = false) сервер статблок не отдаёт вовсе (#175): на плитке только имя, в раскрытии — картинки и «Описание».
   Пустой статблок за «нулевую» тварь не принимать — смотреть на права. *@
<CatalogPage @ref="_catalog" TItem="CreatureDto" Title="Бестиарий" Icon="fa-skull" AddLabel="Добавить существо" Noun="существо" Plural="существ"
             Filters="Filters" SearchAlso="c => [c.Description]" CoverOf="c => c.Images.FirstOrDefault()?.Url"
             Art="CatalogArt.Portrait" ImagesOf="c => c.Images" GroupOf="c => CatalogText.Of(c.Type)" Tile="Tile" Badges="Badges"
             Details="Details" DetailsFirstOnPhone="true" New="() => new CreatureDto()" EditHref="EditHref" />

@code {
    private static readonly IReadOnlyList<CatalogFilter<CreatureDto>> Filters =
        [CatalogFilter<CreatureDto>.ForEnum<CreatureType>("type", Terms.AnyType, CatalogText.Of, c => c.Type)];

    private CatalogPage<CreatureDto>? _catalog;

    private bool Keeper => _catalog?.CanEdit == true;

    private static string EditHref(CreatureDto? creature) =>
        creature is null ? "bestiary/creatures/edit" : $"bestiary/creatures/edit/{creature.Id}";

    // Сводка под рисунком — то, за чем Хранитель открывает бестиарий: ПЗ, броня, потеря Рассудка — по строке на показатель
    // («ПЗ 90 · Броня особая» в плитку 164px не входит, и сводки соседних плиток вставали то в две строки, то в три).
    private RenderFragment<CreatureDto> Tile => creature => __builder =>
    {
        @if (Keeper && !StatblockView.IsBlank(creature.Statblock))
        {
            <span>ПЗ @(creature.Statblock.HitPoints > 0 ? creature.Statblock.HitPoints : "—")</span>
            <span>Броня @StatblockView.TileArmor(creature.Statblock)</span>
            <span>Рассудок @(StatblockView.SanityOf(creature.Statblock) ?? "—")</span>
        }
    };

    private static RenderFragment<CreatureDto> Badges => creature => __builder =>
    {
        <Badge Tone="Tone.Info">@CatalogText.Of(creature.Type)</Badge>
    };

    private RenderFragment<CatalogDetails<CreatureDto>> Details => d => __builder =>
    {
        var creature = d.Item;
        @if (Keeper)
        {
            <StatblockView Statblock="creature.Statblock" />
        }
        <section class="@(Keeper ? "mt-4 text-sm" : "text-sm")">
            <h3 class="cm-section-title mb-1">Описание</h3>
            <p class="cm-text-muted whitespace-pre-line">@(string.IsNullOrWhiteSpace(creature.Description) ? "Описания нет." : creature.Description)</p>
            @if (creature.Source is not null)
            {
                <p class="cm-meta mt-2">Источник: @creature.Source</p>
            }
        </section>
    };
}
