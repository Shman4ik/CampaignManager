@page "/artifacts"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs
@implements IAsyncDisposable
@inject ICatalogApi<WeaponDto> WeaponsApi
@inject IJSRuntime JS

@* ВРЕМЕННО: два варианта раскладки с иллюстрациями для выбора владельцем — ?layout=tiles (плитки) и без флага (карточки). *@
<CatalogPage TItem="ArtifactDto" Title="Артефакты" Icon="fa-gem" AddLabel="Добавить артефакт" Noun="артефакт" Plural="артефактов"
             Filters="_filters" Sorts="Sorts" SearchAlso="a => a.UsedBy" OnLoaded="Loaded" State="_state" Open="Open"
             New="() => new ArtifactDto()" Form="Form">
    <Body Context="view">
        <div class="@(Tiles ? "ar-tiles" : "ar-cards")">
            @foreach (var a in view.Page)
            {
                @if (view.Open == a.Id)
                {
                    @Opened(view, a)
                }
                else if (Tiles)
                {
                    @Tile(view, a)
                }
                else
                {
                    @Card(view, a)
                }
            }
        </div>
    </Body>
</CatalogPage>

@code {
    private static readonly IReadOnlyList<CatalogSort<ArtifactDto>> Sorts =
    [
        new("name", "По названию", a => a.Name),
        new("kind", "По виду", a => CatalogText.Of(a.Kind)),
        new("owner", "По владельцам", a => Owners(a)),
    ];

    private IReadOnlyList<CatalogFilter<ArtifactDto>> _filters = [];
    private IReadOnlyList<string> _owners = [];
    private IReadOnlyList<WeaponDto> _weapons = [];
    private bool _anyImages;
    private IJSObjectReference? _module;
    private Guid? _revealed;

    private readonly CatalogFormState _state = new();

    [SupplyParameterFromQuery(Name = "open")] public Guid? Open { get; set; }

    [SupplyParameterFromQuery(Name = "layout")] public string? Layout { get; set; }

    private bool Tiles => Layout == "tiles";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _weapons = (await WeaponsApi.ListAsync()).Items;
        }
        catch (HttpRequestException)
        {
            // Без справочника оружия раскрытие обходится без строки «В бою».
        }
    }

    // Раскрытая карточка встаёт во всю ширину сетки отдельным рядом — прокрутить к ней, когда она уже в разметке.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open is not { } open || open == _revealed)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/CampaignManager.UI/Catalogs/Pages/ArtifactsPage.razor.js");
            if (await _module.InvokeAsync<bool>("reveal", $"artifact-{open}"))
            {
                _revealed = open;
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void Loaded(IReadOnlyList<ArtifactDto> artifacts)
    {
        _anyImages = artifacts.Any(a => a.Images.Count > 0);
        _owners = [.. artifacts.SelectMany(a => a.UsedBy).Distinct(StringComparer.CurrentCultureIgnoreCase).Order(StringComparer.CurrentCulture)];
        _filters =
        [
            CatalogFilter<ArtifactDto>.ForEnum("kind", Terms.AnyKind, CatalogText.Of, a => a.Kind),
            new("owner", Terms.AnyOwner, [.. _owners.Select(o => new CatalogOption(o, Capitalized(o)))],
                (artifact, owner) => artifact.UsedBy.Contains(owner, StringComparer.CurrentCultureIgnoreCase)),
        ];
    }

    private static string Owners(ArtifactDto a) => a.UsedBy.Count == 0 ? Terms.None : Capitalized(string.Join(", ", a.UsedBy));

    private static string Meta(ArtifactDto a) => CatalogText.Of(a.Kind) + (a.UsedBy.Count > 0 ? $" · {Owners(a)}" : "");

    // «Используют» книги пишется со строчной («ми-го», «кто угодно»); в начале ячейки и пункта выбора — с заглавной.
    private static string Capitalized(string text) => text.Length == 0 ? text : char.ToUpper(text[0], System.Globalization.CultureInfo.CurrentCulture) + text[1..];

    // Оружие для боя — запись справочника оружия с тем же названием (без регистра и «ё»), только у вида «Оружие».
    private WeaponDto? WeaponOf(ArtifactDto a) =>
        a.Kind == ArtifactKind.Weapon
            ? _weapons.FirstOrDefault(w => CatalogCodeTable.NormalizeName(w.Name) == CatalogCodeTable.NormalizeName(a.Name))
            : null;

    private RenderFragment Cover(ArtifactDto a) => __builder =>
    {
        @if (a.Images.FirstOrDefault() is { } cover)
        {
            <img src="@ImageUrls.Thumb(cover.Url)" alt="" loading="lazy" decoding="async" />
        }
        else
        {
            <i class="fa-solid fa-gem" aria-hidden="true"></i>
        }
    };

    private RenderFragment EditButton(CatalogView<ArtifactDto> view, ArtifactDto a) => __builder =>
    {
        @if (view.CanEdit)
        {
            <div class="cm-compact shrink-0">
                <Button Variant="ButtonVariant.OutlinePrimary" Small="true" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(a.Name)}")"
                        OnClick="() => view.Edit(a)" />
            </div>
        }
    };

    // Вариант «Карточки»: обложка 4:5 слева, название, вид и владельцы, правило; вся карточка — кнопка раскрытия.
    private RenderFragment Card(CatalogView<ArtifactDto> view, ArtifactDto a) => __builder =>
    {
        <article id="@($"artifact-{a.Id}")" class="cm-card ar-card" @key="a.Id">
            <button type="button" class="ar-card-button" aria-expanded="false" @onclick="() => view.ToggleOpen(a)">
                @if (_anyImages)
                {
                    <span class="ar-cover">@Cover(a)</span>
                }
                <span class="min-w-0 flex-1">
                    <span class="flex items-start gap-2">
                        <span class="min-w-0 flex-1 font-semibold text-primary-800">@a.Name</span>
                        <i class="fa-solid fa-chevron-down mt-1 shrink-0 text-sm text-primary-400" aria-hidden="true"></i>
                    </span>
                    <span class="cm-meta mt-0.5 block">@Meta(a)</span>
                    @if (a.Rule is { } rule)
                    {
                        <span class="mt-2 block text-sm text-primary-700">@rule</span>
                    }
                </span>
            </button>
            @EditButton(view, a)
        </article>
    };

    // Вариант «Плитки»: картинка 4:5 сверху во всю ширину плитки, под ней название, вид и владельцы, правило.
    private RenderFragment Tile(CatalogView<ArtifactDto> view, ArtifactDto a) => __builder =>
    {
        <article id="@($"artifact-{a.Id}")" class="cm-card ar-tile" @key="a.Id">
            <button type="button" class="ar-tile-button" aria-expanded="false" @onclick="() => view.ToggleOpen(a)">
                <span class="ar-tile-media">@Cover(a)</span>
                <span class="ar-tile-text">
                    <span class="block font-semibold text-primary-800">@a.Name</span>
                    <span class="cm-meta mt-0.5 block">@Meta(a)</span>
                    @if (a.Rule is { } rule)
                    {
                        <span class="mt-2 block text-sm text-primary-700">@rule</span>
                    }
                </span>
            </button>
        </article>
    };

    // Раскрытая запись — во всю ширину сетки: картинка слева (на телефоне сверху), справа правило, бой, описание, источник.
    private RenderFragment Opened(CatalogView<ArtifactDto> view, ArtifactDto a) => __builder =>
    {
        var weapon = WeaponOf(a);
        <article id="@($"artifact-{a.Id}")" class="cm-card ar-open col-span-full" @key="a.Id">
            <div class="cm-card-header gap-3">
                <button type="button" class="flex min-h-9 min-w-0 flex-1 items-center gap-2 text-left" aria-expanded="true"
                        @onclick="() => view.ToggleOpen(a)">
                    <i class="fa-solid fa-chevron-up shrink-0 text-sm text-primary-400" aria-hidden="true"></i>
                    <span class="cm-title-serif min-w-0 break-words text-lg">@a.Name</span>
                </button>
                @EditButton(view, a)
            </div>
            <div class="cm-card-body flex flex-col gap-4 md:flex-row md:items-start md:gap-6">
                @if (a.Images.Count > 0)
                {
                    <div class="ar-open-media">
                        <CatalogImageGallery @key="a.Id" Images="a.Images" Alt="@a.Name" />
                    </div>
                }
                <div class="grid min-w-0 flex-1 content-start gap-3 text-sm">
                    <p class="cm-meta">@Meta(a)</p>
                    @if (a.Rule is { } rule)
                    {
                        <p class="max-w-prose font-medium text-primary-800"><span class="cm-meta-label">В игре: </span>@rule</p>
                    }
                    @if (weapon is not null)
                    {
                        <p class="max-w-prose">
                            <span class="cm-meta-label">В бою: </span>оружие
                            <a class="text-accent-700 underline" href="@($"weapons?open={weapon.Id}")">@weapon.Name</a>
                            — урон <DiceText Value="@weapon.Damage" />, навык @(weapon.SkillName ?? Terms.None); выбирается в атаке через «Подобрать оружие…».
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(a.Description))
                    {
                        <p class="max-w-prose whitespace-pre-line text-primary-700">@a.Description</p>
                    }
                    else
                    {
                        <p class="cm-text-muted">Описания нет.</p>
                    }
                    @if (a.Source is not null)
                    {
                        <p class="cm-meta">Источник: @a.Source</p>
                    }
                </div>
            </div>
        </article>
    };

    private RenderFragment<ArtifactDto> Form => a => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-2">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-2">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="a.Name" />
            </Field>
            <Field Label="Вид">
                <select class="cm-input" value="@a.Kind" @onchange="e => a.Kind = Enum.Parse<ArtifactKind>(e.Value?.ToString() ?? nameof(ArtifactKind.Other))">
                    @foreach (var kind in Enum.GetValues<ArtifactKind>())
                    {
                        <option value="@kind">@CatalogText.Of(kind)</option>
                    }
                </select>
            </Field>
            <Field Label="Источник" Note="Книга и страница."><input class="cm-input" @bind="a.Source" /></Field>
            <Field Label="Используют" Group="true" class="sm:col-span-2" Note="Кто создаёт и применяет: ми-го, йитиане, кто угодно.">
                <StringListEditor Values="a.UsedBy" ValuesChanged="v => a.UsedBy = [.. v]" Chips="true" ItemLabel="Владелец" Placeholder="Например, ми-го" />
            </Field>
            <Field Label="В игре" class="sm:col-span-2" Note="Главное правило одной строкой: проверка, урон, цена.">
                <input class="cm-input" placeholder="Броня 8; снять — −1 ПЗ" @bind="a.Rule" />
            </Field>
            <Field Label="Описание" class="sm:col-span-2"><textarea class="cm-input" rows="8" @bind="a.Description"></textarea></Field>
            <Field Label="Иллюстрации" Group="true" class="sm:col-span-2">
                <CatalogImagesEditor Images="a.Images" Hint="Первая картинка — обложка в строке справочника." />
            </Field>
        </div>
    };
}
