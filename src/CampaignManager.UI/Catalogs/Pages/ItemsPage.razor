@page "/items"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs

@* Предметы — прайс-лист 1920-х с рисунком у каждого (гравюры 3:2 из items-art, у всех 257). Иллюстрации — общая система
   справочников (CatalogPage, Styles/catalog.css): галерея группами по типу без страниц, плитка — рисунок, название и цена;
   таблица — вторым видом (?view=table: найти и сравнить цену), Название · Тип · Цена, описание строкой под названием.
   Раскрытая запись — рисунок слева, цена и тип, описание, источник справа (в таблице — без цены и типа: они в колонках). *@
<CatalogPage TItem="ItemDto" Title="Предметы" Icon="fa-box" AddLabel="Добавить предмет" Noun="предмет" Plural="предметов"
             Filters="_filters" ErasOf="i => i.Eras" SearchAlso="i => [i.Type, i.Description]" CoverOf="i => i.ImageUrl"
             Art="CatalogArt.Landscape" ImagesOf="i => CatalogImages.Single(i.ImageFileId, i.ImageUrl)" GroupOf="i => i.Type" Sorts="Sorts"
             Tile="Tile" Details="Details" CanExpand="HasMore" New="() => new ItemDto()" OnLoaded="Loaded" OnFormOpening="OnOpening" State="_state">
    <Columns Context="view">
        <DataColumn TItem="ItemDto" Title="Название" SortBy="i => i.Name" DefaultSort="false" HeaderClass="w-[58%]" Context="item">
            <div class="flex items-center gap-3">
                <CatalogThumb Url="@item.ImageUrl" Art="CatalogArt.Landscape" Icon="fa-box" />
                <div class="min-w-0">
                    <span class="font-medium text-primary-800">@item.Name</span>
                    @if (view.ShowEra)
                    {
                        <EraBadges Values="item.Eras" />
                    }
                    @* Описание — строкой под названием, а не своим столбцом. Длинное — в раскрытии. *@
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="cm-meta line-clamp-2">@item.Description</p>
                    }
                </div>
            </div>
        </DataColumn>
        @if (!view.IsFixed("type"))
        {
            <DataColumn TItem="ItemDto" Title="Тип" SortBy="i => i.Type" HeaderClass="w-[16%]" Context="item">@item.Type</DataColumn>
        }
        <DataColumn TItem="ItemDto" Title="Цена" SortBy="i => i.Price ?? decimal.MaxValue" HeaderClass="w-[14%] whitespace-nowrap" CellClass="whitespace-nowrap" AlignEnd="true" Context="item">@PriceText.Format(item.Price)</DataColumn>
    </Columns>
    <CardTemplate Context="item">
        <span class="flex items-start gap-3">
            <CatalogThumb Url="@item.ImageUrl" Art="CatalogArt.Landscape" Icon="fa-box" Large="true" />
            <span class="min-w-0">
                <span class="block font-medium text-primary-800">@item.Name</span>
                <span class="cm-meta block">@item.Type@(item.Price is null ? "" : (string.IsNullOrEmpty(item.Type) ? "" : " · ") + PriceText.Format(item.Price))</span>
                @if (!string.IsNullOrEmpty(item.Description))
                {
                    <span class="mt-1 line-clamp-2 block text-sm text-primary-600">@item.Description</span>
                }
            </span>
        </span>
    </CardTemplate>
    <Form Context="item">
        <div class="grid gap-4 sm:grid-cols-2">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-2">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="item.Name" />
            </Field>
            <Field Label="Тип">
                @* Список — стрелкой и выбором (поле с datalist не показывало, что варианты есть); новый тип — «Другой тип…» (I3). *@
                <select class="cm-input" value="@TypeChoice(item)" @onchange="e => ChooseType(item, e.Value?.ToString())">
                    <option value="">— без типа —</option>
                    @foreach (var type in _types)
                    {
                        <option value="@type">@type</option>
                    }
                    <option value="@OtherType">Другой тип…</option>
                </select>
                @if (_otherType)
                {
                    <input class="cm-input mt-2" placeholder="Название типа" aria-label="Название нового типа" @bind="item.Type" @bind:event="oninput" />
                }
            </Field>
            <Field Label="Цена" Hint="($)" Note="Пусто — цена не указана.">
                <input class="cm-input" type="number" inputmode="decimal" min="0" step="0.01" placeholder="9,50" @bind="item.Price" />
            </Field>
            <Field Label="Источник" Note="Книга и страница."><input class="cm-input" @bind="item.Source" /></Field>
            <div class="sm:col-span-2"><EraPicker Show="_state.ErasVary" @bind-Values="item.Eras" /></div>
            <Field Label="Описание" class="sm:col-span-2"><textarea class="cm-input" rows="4" @bind="item.Description"></textarea></Field>
            <Field Label="Картинка" Group="true" class="sm:col-span-2">
                <ImagePicker Webp="true" FileId="item.ImageFileId" Url="@item.ImageUrl"
                             OnChanged="file => { item.ImageFileId = file?.Id; item.ImageUrl = file?.Url; }" />
            </Field>
        </div>
    </Form>
</CatalogPage>

@code {
    /// <summary>Столько описания входит под названием в две строки : длиннее — в раскрытие.</summary>
    private const int VisibleDescription = 80;

    // Заголовков столбцов у галереи нет — порядок выбором в панели. Без цены — в конце группы, а не в начале.
    private static readonly IReadOnlyList<CatalogSort<ItemDto>> Sorts =
    [
        new("name", "По названию", i => i.Name),
        new("price", "Дешевле", i => i.Price ?? decimal.MaxValue),
        new("price-desc", "Дороже", i => i.Price ?? -1m, Descending: true),
    ];

    private readonly CatalogFormState _state = new();
    private IReadOnlyList<CatalogFilter<ItemDto>> _filters = [];
    private IReadOnlyList<string> _types = [];

    // Тип — свободный текст: варианты фильтра — те, что есть в справочнике.
    private void Loaded(IReadOnlyList<ItemDto> items)
    {
        _types = [.. items.Select(i => i.Type).OfType<string>().Distinct(StringComparer.CurrentCultureIgnoreCase).Order()];
        _filters = [new("type", Terms.AnyType, [.. _types.Select(t => new CatalogOption(t, t))], (item, type) => item.Type == type)];
    }

    private const string OtherType = "other";
    private bool _otherType;

    // Тип записи, которого нет в списке, — «Другой»: поле для названия появляется при выборе и у такой записи.
    private string TypeChoice(ItemDto item) =>
        _otherType || (!string.IsNullOrEmpty(item.Type) && !_types.Contains(item.Type, StringComparer.CurrentCultureIgnoreCase)) ? OtherType : item.Type ?? "";

    private void OnOpening() => _otherType = false;

    private void ChooseType(ItemDto item, string? value)
    {
        _otherType = value == OtherType;
        item.Type = value is null or OtherType ? null : value;
    }

    // Раскрыть строку таблицы есть смысл, когда есть картинка (крупно) или длинное описание.
    private static bool HasMore(ItemDto item) =>
        item.ImageUrl is not null || item.Description?.Length > VisibleDescription;

    // Плитка: цена (без цены — прочерк); тип — заголовок группы.
    private static RenderFragment<ItemDto> Tile => item => __builder =>
    {
        <span class="font-semibold text-primary-700">@(PriceText.Format(item.Price) ?? "—")</span>
    };

    // Справа от рисунка: цена и тип (в таблице они в колонках), описание, источник.
    private static RenderFragment<CatalogDetails<ItemDto>> Details => d => __builder =>
    {
        var item = d.Item;
        <div class="grid content-start gap-2 text-sm">
            @if (!d.InTable)
            {
                <p>
                    <span class="font-semibold text-primary-800">@(PriceText.Format(item.Price) ?? "Цена не указана")</span>
                    @if (item.Type is not null)
                    {
                        <span class="text-primary-600"> · @item.Type</span>
                    }
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(item.Description))
            {
                <p class="max-w-prose whitespace-pre-line text-primary-700">@item.Description</p>
            }
            @if (item.Source is not null)
            {
                <p class="cm-meta">Источник: @item.Source</p>
            }
        </div>
    };
}
