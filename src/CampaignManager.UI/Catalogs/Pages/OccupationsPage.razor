@page "/occupations"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs
@using CampaignManager.Core.Characters
@inject ICatalogApi<SkillDto> SkillsApi

@* Профессии — единственный справочник на карточках, а не таблицей: формула, Средства и до десятка
   навыков чипами в строку таблицы не сжать. Профессий три десятка — страницы по 12. «Изменить» — иконка-карандаш в
   шапке карточки (O1: кнопка 232×44 с подписью занимала четверть карточки). Счётчик «навыков: N из 8» — проверка
   правила книги (стр. 37), он же у Хранителя в форме. «Сверить с книгой правил» — синхронизация с сидом книги.
   Картинки — как у бестиария и оружия (пользовательские файлы, первая — обложка): обложка 4:5 слева от сведений, без
   картинок — заглушка того же размера. Касание обложки или названия раскрывает карточку: в альбоме на две колонки из
   трёх (во всю ширину справа от картинки пустовало бы — статблока, как у твари, у профессии нет), в портрете и на
   телефоне — во всю ширину; dense подтягивает соседей в дыру. Галерея слева, сведения справа, на телефоне — галерея
   сверху. Раскрытая одна, в адресе (?open=). Раскрывается только профессия с картинками — без них показывать нечего. *@
<CatalogPage TItem="OccupationDto" Title="Профессии" Icon="fa-user-tie" AddLabel="Добавить профессию" Noun="профессию" Plural="профессий"
             Filters="Filters" Toggles="Toggles" ErasOf="o => o.Eras" SearchAlso="SlotNames" PageSize="12" Sorts="Sorts" Sync="true" State="_state" Validate="Validate"
             New="NewOccupation" OnFormOpening="EnsureSkillsAsync" Form="Form" FormSize="ModalSize.Large">
    <Body Context="view">
        <div class="@Css.Join("cm-grid-cards", view.Open is not null ? "grid-flow-row-dense" : null)">
            @foreach (var occupation in view.Page)
            {
                var expandable = occupation.Images.Count > 0;
                var open = expandable && view.Open == occupation.Id;
                <article id="@($"occupation-{occupation.Id}")" class="@Css.Join("cm-card oc-card flex flex-col", open ? "oc-open col-span-full lg:col-span-2" : null)" @key="occupation.Id">
                    <div class="cm-card-header flex-wrap gap-y-1">
                        @if (expandable)
                        {
                            @* Название — кнопка раскрытия, шеврон слева, как у раскрытой твари бестиария. *@
                            <button type="button" class="flex min-h-8 min-w-0 flex-1 items-center gap-2 text-left" aria-expanded="@(open ? "true" : "false")"
                                    @onclick="() => view.ToggleOpen(occupation)">
                                <i class="@($"fa-solid {(open ? "fa-chevron-up" : "fa-chevron-down")} shrink-0 text-sm text-primary-400")" aria-hidden="true"></i>
                                <h2 class="cm-card-title min-w-0 break-words">@occupation.Name</h2>
                            </button>
                        }
                        else
                        {
                            <h2 class="cm-card-title min-w-0 flex-1">@occupation.Name</h2>
                        }
                        @if (occupation.IsLovecraftian)
                        {
                            <Badge Tone="Tone.Info">@Terms.FromLovecraft</Badge>
                        }
                        @if (view.ShowEra)
                        {
                            <EraBadges Values="occupation.Eras" />
                        }
                        @if (view.CanEdit)
                        {
                            @* «Удалить» — в окне правки (правило 7). Иконка 32px рядом с названием, как в таблицах. *@
                            <div class="cm-compact shrink-0">
                                <Button Variant="ButtonVariant.OutlinePrimary" Small="true" Icon="fa-pen" AriaLabel="@($"Изменить: {Names.Plain(occupation.Name)}")"
                                        OnClick="() => view.Edit(occupation)" />
                            </div>
                        }
                    </div>
                    <div class="cm-card-body flex-1 text-sm">
                        @if (open)
                        {
                            <div class="flex flex-col gap-4 md:flex-row md:items-start md:gap-6">
                                <div class="oc-open-media">
                                    <CatalogImageGallery @key="occupation.Id" Images="occupation.Images" Alt="@occupation.Name" />
                                </div>
                                <div class="min-w-0 flex-1">
                                    @Details(occupation)
                                    @if (occupation.Source is not null)
                                    {
                                        <p class="cm-meta mt-3">Источник: @occupation.Source</p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-start gap-3">
                                @if (occupation.Images.FirstOrDefault() is { } cover)
                                {
                                    <button type="button" class="oc-cover" aria-label="@($"{Names.Plain(occupation.Name)}: иллюстрации")" aria-expanded="false"
                                            @onclick="() => view.ToggleOpen(occupation)">
                                        <img src="@ImageUrls.Thumb(cover.Url, 240)" alt="" loading="lazy" decoding="async" />
                                    </button>
                                }
                                else
                                {
                                    <span class="oc-cover oc-cover-empty" aria-hidden="true"><i class="fa-solid fa-user-tie"></i></span>
                                }
                                <div class="min-w-0 flex-1">@Details(occupation)</div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </Body>
</CatalogPage>

@code {
    private static readonly IReadOnlyList<CatalogFilter<OccupationDto>> Filters =
        [CatalogFilter<OccupationDto>.ForEnum<SkillPointsFormula>("formula", Terms.AnySkillPoints, CatalogText.Of, o => o.SkillPointsFormula)];

    // Карточки без заголовков таблицы: порядок — выбором в панели фильтров (решение владельца 2026-10-03: страницы по 12).
    private static readonly IReadOnlyList<CatalogSort<OccupationDto>> Sorts =
    [
        new("name", "По названию", o => o.Name),
        new("credit", "По Средствам, больше сверху", o => o.CreditRatingMax, Descending: true),
        new("formula", "По очкам навыков", o => CatalogText.Of(o.SkillPointsFormula)),
    ];

    private static readonly IReadOnlyList<CatalogToggle<OccupationDto>> Toggles =
        [new("lovecraft", Terms.FromLovecraft, o => o.IsLovecraftian)];

    private readonly CatalogFormState _state = new();
    private IReadOnlyList<SkillDto> _skills = [];

    private static IReadOnlyDictionary<string, string> Validate(OccupationDto o) =>
        o.CreditRatingMin > o.CreditRatingMax
            ? new Dictionary<string, string> { ["credit"] = "Нижняя граница Средств больше верхней." }
            : new Dictionary<string, string>();

    // Сведения карточки — одни и те же в свёрнутой и раскрытой: формула, Средства, навыки чипами, счёт навыков.
    private static RenderFragment Details(OccupationDto occupation) => __builder =>
    {
        var count = occupation.ProfessionalSkillCount;
        <p class="cm-meta mb-2">
            <span><span class="cm-meta-label">Очки навыков:</span> @Formula(occupation.SkillPointsFormula)</span>
            <span><span class="cm-meta-label">Средства:</span> @occupation.CreditRatingMin–@occupation.CreditRatingMax</span>
        </p>
        <div class="flex flex-wrap gap-1.5">
            @foreach (var (slot, times) in Grouped(occupation.Slots))
            {
                @* Длинный выбор («4 из: …») переносится внутри чипа — иначе на телефоне страница уезжает вбок.
                   Одинаковые слоты подряд — одним чипом «любой навык ×4»; слоты «со словами» (выбор, любой, социальный)
                   отличаются тоном от названного навыка. *@
                <Badge Tone="@(slot.Kind is OccupationSlotKind.Skill or OccupationSlotKind.Specialization ? Tone.Neutral : Tone.Info)"
                       class="max-w-full whitespace-normal">@SlotLabel(slot)@(times > 1 ? $" ×{times}" : "")</Badge>
            }
        </div>
        @if (count != OccupationRules.RequiredSkillCount)
        {
            <Alert Tone="Tone.Warning" Small="true" class="mb-0 mt-2">Навыков @count из @OccupationRules.RequiredSkillCount — по книге ровно восемь плюс Средства.</Alert>
        }
    };

    private static IEnumerable<(OccupationSlotDto Slot, int Times)> Grouped(IEnumerable<OccupationSlotDto> slots)
    {
        List<(OccupationSlotDto Slot, int Times)> result = [];
        foreach (var slot in slots)
        {
            if (result.Count > 0 && SlotLabel(result[^1].Slot) == SlotLabel(slot))
            {
                result[^1] = (result[^1].Slot, result[^1].Times + 1);
            }
            else
            {
                result.Add((slot, 1));
            }
        }

        return result;
    }

    // ОБР, ЛВК, СИЛ… — сокращения характеристик: касанием расшифровываются (правило 11).
    private static readonly Dictionary<string, string> Characteristics = new()
    {
        ["ОБР"] = "Образование", ["ЛВК"] = "Ловкость", ["СИЛ"] = "Сила", ["НАР"] = "Внешность", ["МОЩ"] = "Мощь",
    };

    private static RenderFragment Formula(SkillPointsFormula formula) => __builder =>
    {
        foreach (var part in System.Text.RegularExpressions.Regex.Split(CatalogText.Of(formula), "(ОБР|ЛВК|СИЛ|НАР|МОЩ)"))
        {
            if (Characteristics.TryGetValue(part, out var full))
            {
                <Abbr Short="@part" Full="@full" />
            }
            else
            {
                @part
            }
        }
    };

    private async Task EnsureSkillsAsync()
    {
        if (_skills.Count > 0)
        {
            return;
        }

        try
        {
            _skills = [.. (await SkillsApi.ListAsync()).Items];
        }
        catch (HttpRequestException)
        {
            // Без связи редактор слотов пуст; сохранить всё равно не выйдет — скажет сервер.
        }
    }

    private static OccupationDto NewOccupation() => new()
    {
        CreditRatingMin = 9,
        CreditRatingMax = 40,
        Slots = [.. Enumerable.Range(0, 8).Select(_ => new OccupationSlotDto { Kind = OccupationSlotKind.Free })],
    };

    private static IEnumerable<string?> SlotNames(OccupationDto occupation) =>
        occupation.Slots.Select(s => s.SkillName).Concat(occupation.Slots.SelectMany(s => s.OptionNames));

    /// <summary>Чип слота словами книги: «Стрельба (любая)», «2 из: Лазание, Плавание».</summary>
    private static string SlotLabel(OccupationSlotDto slot) => slot.Kind switch
    {
        OccupationSlotKind.Skill => slot.SkillName ?? "?",
        OccupationSlotKind.Specialization => $"{slot.SkillName} ({slot.Specialization})",
        OccupationSlotKind.AnySpecialization => $"{slot.SkillName} (любая)",
        OccupationSlotKind.Choice => $"{slot.ChooseCount} из: {string.Join(", ", slot.OptionNames)}",
        OccupationSlotKind.Social => "социальный навык",
        _ => "любой навык",
    };

    private RenderFragment<OccupationDto> Form => o => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-6">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-3">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="o.Name" />
            </Field>
            <Field Label="Очки навыков" class="sm:col-span-3" Note="Если формула даёт выбор, берётся выбранная характеристика.">
                <select class="cm-input" @bind="o.SkillPointsFormula">
                    @foreach (var formula in Enum.GetValues<SkillPointsFormula>())
                    {
                        <option value="@formula">@CatalogText.Of(formula)</option>
                    }
                </select>
            </Field>
            @* «Средства» — одна подпись и два поля «от — до» (O4): прежние «Средства от» и «Средства до» переносились на вторую
               строку подписи, а флажок «Из Лавкрафта» стоял под своей подписью «Особенности» на другой линии. *@
            <Field Label="Средства" Group="true" Error="@_state.For("credit")" class="sm:col-span-2">
                <div class="flex items-center gap-2">
                    <label class="flex items-center gap-2 text-sm text-primary-700">от
                        <input class="cm-input w-20" type="number" min="0" max="99" aria-label="Средства от" aria-invalid="@_state.Invalid("credit")" @bind="o.CreditRatingMin" />
                    </label>
                    <label class="flex items-center gap-2 text-sm text-primary-700">до
                        <input class="cm-input w-20" type="number" min="0" max="99" aria-label="Средства до" @bind="o.CreditRatingMax" />
                    </label>
                </div>
            </Field>
            <Field Label="Источник" Note="Книга и страница." class="sm:col-span-2"><input class="cm-input" @bind="o.Source" /></Field>
            <div class="cm-field sm:col-span-2">
                <span class="cm-field-label max-sm:hidden" aria-hidden="true">&nbsp;</span>
                <label class="cm-tap-row"><input type="checkbox" class="cm-checkbox" @bind="o.IsLovecraftian" /><span>@Terms.FromLovecraft</span></label>
            </div>
            <div class="sm:col-span-6"><EraPicker Show="_state.ErasVary" @bind-Values="o.Eras" /></div>
            <Field Label="Навыки профессии" Group="true" class="sm:col-span-6"
                   Note="Ровно восемь навыков; Средства — выше, диапазоном.">
                <OccupationSlotsEditor Slots="o.Slots" SlotsChanged="v => o.Slots = v" Skills="_skills" />
            </Field>
            <Field Label="Иллюстрации" Group="true" class="sm:col-span-6">
                <CatalogImagesEditor Images="o.Images" Hint="Первая картинка — обложка карточки." />
            </Field>
            <Field Label="Теги" Group="true" class="sm:col-span-6" Note="Для взвешенного выбора навыков в случайном черновике сыщика.">
                <StringListEditor Values="o.Tags" ValuesChanged="v => o.Tags = [.. v]" ItemLabel="Тег" Chips="true" Placeholder="Научная, Боевая…" />
            </Field>
        </div>
    };
}
