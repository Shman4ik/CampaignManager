@page "/bestiary/creatures/edit/{Id:guid?}"
@attribute [Authorize(Policy = Policies.Keeper)]
@using System.Text.Json
@using CampaignManager.UI.Platform
@using CampaignManager.Contracts.Identity
@using CampaignManager.Contracts.Platform
@using CampaignManager.Core.Catalogs
@inject ICatalogApi<CreatureDto> Api
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject DialogService Dialogs

@* Правка твари — своя страница, а не окно: статблок (гл. 14, стр. 277–280) в окно не помещается.
   Форма — по документу Statblock: характеристики «значение + кости», ПЗ, ПМ, бонус к урону к УРОНУ
   (не к попаданию), комплекция, скорости (пустое плавание — половина обычной, пустой полёт — не
   летает), атак за раунд у твари, а не у атаки, броня с оговоркой, уклонение, потеря рассудка,
   инициатива (0 — по ЛВК). Ссылка на страницу защищена политикой Keeper; запись — сервером.

   g6 (F6b): «Сохранить» и «К бестиарию» спрашивали «Выйти?» после успешной записи — страница выставляла флаг, а
   NavigationLock читал параметр прошлого рендера (E1); теперь перед переходом зовётся UnsavedChangesGuard.Allow().
   Заголовок — имя на момент открытия, а не живое поле (E6); у новой твари фокус в «Названии» (E9).

   UX-1 U5 (#176): панель «Отмена / Сохранить» липнет к низу (страница в 2000+ px), ошибка названия — у поля,
   сводка «Проверьте поля: N» у кнопки и прокрутка к первому полю; уход с несохранённого спрашивает; «0» там, где
   значения нет, — пустое поле; «Удалить» — внизу страницы (на карточке бестиария его нет). *@
<PageHeader Title="@_title">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-arrow-left" OnClick="LeaveAsync">К бестиарию</Button>
    </Actions>
</PageHeader>

<UnsavedChangesGuard @ref="_guard" Dirty="IsDirty" />

<div class="cm-page cr-edit">
    <AsyncContent TData="CreatureDto" Load="LoadAsync" Key="Id" IsEmpty="_ => false">
        @if (_creature is { } c)
        {
            var s = c.Statblock;
            var errors = Check(c);
            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Основное</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                        <FocusOnRender Target="() => _nameInput" When="Id is null" />
                        <Field Label="Название" Required="true" Error="@ErrorOf(errors, "name")" class="sm:col-span-2">
                            <input @ref="_nameInput" class="cm-input" aria-invalid="@(errors.ContainsKey("name") && _attempt > 0 ? "true" : null)" @bind="c.Name" />
                        </Field>
                        <Field Label="Тип">
                            <select class="cm-input" @bind="c.Type">
                                @foreach (var type in Enum.GetValues<CreatureType>())
                                {
                                    <option value="@type">@CatalogText.Of(type)</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Источник" Note="Книга и страница."><input class="cm-input" @bind="c.Source" /></Field>
                        <Field Label="Описание" Note="Его видят и игроки — вместе с названием и картинкой; статблок им не отдаётся." class="sm:col-span-2 lg:col-span-4">
                            <textarea class="cm-input" rows="4" @bind="c.Description"></textarea>
                        </Field>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Характеристики</h2></div>
                <div class="cm-card">
                    @* Шесть в ряд уже в портрете (поля ~100px) и по три на телефоне (E7); у каждого поля видимая подпись —
                       «Среднее» и «Кости» (E3: второй ряд полей был без слова, а подсказка пропадала после ввода). *@
                    <div class="cm-card-body grid grid-cols-3 gap-3 md:grid-cols-6 md:gap-4">
                        @foreach (var (label, stat, index) in Stats(s))
                        {
                            var current = stat;
                            <Field Label="@label" Group="true">
                                <label class="cr-sub"><span>Среднее</span><OptionalNumber AriaLabel="@($"{label}, среднее")" @bind-Value="current.Value" /></label>
                                <label class="cr-sub"><span>Кости</span><input class="cm-input cm-dice" placeholder="@(index == 0 ? "3d6 × 5" : null)" aria-label="@($"{label}, кости")" @bind="current.Dice" /></label>
                            </Field>
                        }
                    </div>
                    <div class="cm-card-body grid grid-cols-2 gap-4 border-t border-primary-200 sm:grid-cols-3 lg:grid-cols-6">
                        <Field Label="ПЗ"><OptionalNumber AriaLabel="ПЗ" @bind-Value="s.HitPoints" /></Field>
                        <Field Label="ПМ"><OptionalNumber AriaLabel="ПМ" @bind-Value="s.MagicPoints" /></Field>
                        <Field Label="Бонус к урону" Note="К урону, не к попаданию. Пусто — 0.">
                            <input class="cm-input cm-dice" placeholder="+1d4" aria-label="Бонус к урону" value="@(s.DamageBonus == "0" ? "" : s.DamageBonus)"
                                   @onchange="e => s.DamageBonus = BonusOf(e.Value?.ToString())" />
                        </Field>
                        <Field Label="Комплекция" Note="Пусто — 0."><OptionalNumber Min="null" AriaLabel="Комплекция" @bind-Value="s.Build" /></Field>
                        <Field Label="Уклонение" Hint="(%)"><OptionalNumber Max="100" AriaLabel="Уклонение, %" @bind-Value="s.Dodge" /></Field>
                        <Field Label="Инициатива" Note="Пусто — по ЛВК."><OptionalNumber AriaLabel="Инициатива" @bind-Value="s.Initiative" /></Field>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Движение, броня, рассудок</h2></div>
                <div class="cm-card">
                    @* Шесть колонок в альбоме (три ряда вместо четырёх), четыре в портрете, одна на телефоне (E7). *@
                    <div class="cm-card-body grid gap-4 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6">
                        <Field Label="Скорость"><OptionalNumber AriaLabel="Скорость" @bind-Value="s.Speed.Move" /></Field>
                        <Field Label="Плавание" Note="Пусто — ½ скорости."><input class="cm-input" type="number" min="0" @bind="s.Speed.Swim" /></Field>
                        <Field Label="Полёт" Note="Пусто — не летает."><input class="cm-input" type="number" min="0" @bind="s.Speed.Fly" /></Field>
                        <Field Label="Скорость словами" Note="Если в книге так." class="sm:col-span-2 lg:col-span-3"><input class="cm-input" placeholder="перекатывание 10" @bind="s.Speed.Note" /></Field>
                        <Field Label="@Terms.AttacksPerRound" Note="У твари, не у атаки.">
                            <input class="cm-input" type="number" min="0" @bind="s.AttacksPerRound" />
                        </Field>
                        <Field Label="Оговорка к атакам" class="sm:col-span-2 md:col-span-3 lg:col-span-5">
                            <textarea class="cm-input" rows="2" @bind="s.AttacksPerRoundNote"></textarea>
                        </Field>
                        <Field Label="Броня"><OptionalNumber AriaLabel="Броня" @bind-Value="s.Armor" /></Field>
                        <Field Label="Оговорка к броне" Note="Например: огнестрел — минимальный урон." class="sm:col-span-2 md:col-span-3">
                            <textarea class="cm-input" rows="2" @bind="s.ArmorNote"></textarea>
                        </Field>
                        <Field Label="Потеря Рассудка" Note="@SanityNote(s.SanityLoss)" class="sm:col-span-2 md:col-span-4 lg:col-span-2">
                            <input class="cm-input cm-dice" placeholder="1/1d8" @bind="s.SanityLoss" @bind:event="oninput" />
                        </Field>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Атаки</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body grid gap-3">
                        @for (var i = 0; i < s.Attacks.Count; i++)
                        {
                            var attack = s.Attacks[i];
                            var index = i;
                            <div class="grid gap-2 border-t border-primary-100 pt-3 first:border-t-0 first:pt-0" @key="attack">
                                @* «Вид» стоит в ряду с названием, а не падает на свою строку (E7: в портрете ряд не влезал, и корзина уезжала
                                   вместе с «Видом»); корзина — рядом с описанием, во второй строке. *@
                                <div class="cm-field-row flex flex-wrap items-end gap-2">
                                    <Field Label="Атака" class="min-w-28 flex-1"><input class="cm-input" @bind="attack.Name" /></Field>
                                    <Field Label="Навык" Hint="(%)" class="w-20"><input class="cm-input" type="number" min="0" @bind="attack.SkillValue" /></Field>
                                    <Field Label="Урон" class="w-28" Note="@DamageNote(attack)"><input class="cm-input cm-dice" @bind="attack.Damage" @bind:event="oninput" /></Field>
                                    <Field Label="Бонус к урону" class="w-40">
                                        <select class="cm-input" @bind="attack.DamageBonusMode">
                                            @foreach (var mode in Enum.GetValues<CreatureDamageBonusMode>())
                                            {
                                                <option value="@mode">@CatalogText.Of(mode)</option>
                                            }
                                        </select>
                                    </Field>
                                    <Field Label="Вид" class="w-36">
                                        <select class="cm-input" @bind="attack.Kind">
                                            @foreach (var kind in Enum.GetValues<CreatureAttackKind>())
                                            {
                                                <option value="@kind">@CatalogText.Of(kind)</option>
                                            }
                                        </select>
                                    </Field>
                                </div>
                                <div class="flex items-start gap-2">
                                    <textarea class="cm-input min-w-0 flex-1" rows="2" placeholder="Описание атаки (как в бестиарии)" aria-label="@($"Описание атаки: {attack.Name}")"
                                              @bind="attack.Description"></textarea>
                                    <Button Variant="ButtonVariant.Ghost" Icon="fa-trash-can" AriaLabel="@($"Убрать атаку: {attack.Name}")"
                                            OnClick="() => RemoveWithUndo(s.Attacks, index, attack.Name)" />
                                </div>
                            </div>
                        }
                        <div><Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-plus" OnClick="() => s.Attacks.Add(new CreatureAttack())">Добавить атаку</Button></div>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Навыки</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body grid gap-2">
                        @for (var i = 0; i < s.Skills.Count; i++)
                        {
                            var skill = s.Skills[i];
                            var index = i;
                            <div class="flex flex-wrap items-center gap-2" @key="skill">
                                <input class="cm-input min-w-40 flex-1" aria-label="Навык" placeholder="Внимание" @bind="skill.Name" />
                                <input class="cm-input w-24" type="number" min="0" aria-label="Значение навыка, %" @bind="skill.Value" />
                                <input class="cm-input min-w-32 flex-1" aria-label="Оговорка навыка" placeholder="оговорка книги" @bind="skill.Note" />
                                <Button Variant="ButtonVariant.Ghost" Icon="fa-trash-can" AriaLabel="@($"Убрать навык: {skill.Name}")" OnClick="() => RemoveWithUndo(s.Skills, index, skill.Name)" />
                            </div>
                        }
                        <div><Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-plus" OnClick="() => s.Skills.Add(new CreatureSkill())">Добавить навык</Button></div>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Особые умения</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body grid gap-3">
                        @for (var i = 0; i < s.SpecialAbilities.Count; i++)
                        {
                            var ability = s.SpecialAbilities[i];
                            var index = i;
                            <div class="flex flex-wrap items-start gap-2" @key="ability">
                                <input class="cm-input w-full sm:w-56" aria-label="Умение" placeholder="Регенерация" @bind="ability.Name" />
                                <textarea class="cm-input min-w-48 flex-1" rows="3" aria-label="@($"Описание: {ability.Name}")" @bind="ability.Text"></textarea>
                                <Button Variant="ButtonVariant.Ghost" Icon="fa-trash-can" AriaLabel="@($"Убрать умение: {ability.Name}")" OnClick="() => RemoveWithUndo(s.SpecialAbilities, index, ability.Name)" />
                            </div>
                        }
                        <div><Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-plus" OnClick="() => s.SpecialAbilities.Add(new SpecialAbility())">Добавить особое умение</Button></div>
                    </div>
                </div>
            </section>

            <section class="cm-section">
                <div class="cm-section-header"><h2 class="cm-section-title">Иллюстрации</h2></div>
                <div class="cm-card">
                    <div class="cm-card-body">
                        <CatalogImagesEditor Images="c.Images" Hint="Первая картинка — обложка плитки." />
                    </div>
                </div>
            </section>

            @if (Id is not null)
            {
                @* «Удалить» — здесь, а не на раскрытой карточке бестиария (правило 7): статблок открывают за столом. *@
                <div class="cm-danger-zone">
                    <Button Variant="ButtonVariant.OutlineError" Icon="fa-trash-can" OnClick="DeleteAsync">Удалить существо</Button>
                </div>
            }

            @* Панель сохранения липнет к низу: страница в два экрана, а «Сохранить» только внизу не показывал ни ошибки, ни реакции. *@
            <div class="cr-savebar">
                @if (_error is not null)
                {
                    <Alert Tone="Tone.Error" ShowIcon="true" class="mb-0 w-full">
                        <ChildContent>@_error</ChildContent>
                        <Actions>
                            @if (_stale)
                            {
                                <Button Variant="ButtonVariant.Secondary" Small="true" Icon="fa-rotate-right" OnClick="RereadAsync">Перечитать</Button>
                            }
                        </Actions>
                    </Alert>
                }
                <div class="flex flex-wrap items-center justify-end gap-2 sm:gap-3">
                    @if (_attempt > 0)
                    {
                        <FormErrors Errors="[.. errors.Values]" Attempt="_attempt" Container=".cr-edit" />
                    }
                    <Button Variant="ButtonVariant.Ghost" Icon="fa-eye" AriaLabel="Как будет в бестиарии" OnClick="() => _preview = true"><span class="hidden sm:inline">Как будет в бестиарии</span></Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="LeaveAsync">Отмена</Button>
                    <Button Icon="fa-floppy-disk" Busy="_saving" OnClick="SaveAsync">Сохранить</Button>
                </div>
            </div>
        }
    </AsyncContent>
</div>

@* Предпросмотр — тот же StatblockView, что на раскрытой карточке бестиария, по несохранённому статблоку формы. *@
<Modal Open="_preview" Title="@(_creature?.Name is { Length: > 0 } name ? name : "Новое существо")" Size="ModalSize.Large" OnClose="() => _preview = false">
    <ChildContent>
        @if (_creature is { } previewed)
        {
            @if (StatblockView.IsBlank(previewed.Statblock))
            {
                <p class="cm-text-muted">Статблок пока пуст — заполните характеристики.</p>
            }
            else
            {
                <StatblockView Statblock="previewed.Statblock" />
            }
        }
    </ChildContent>
    <Footer>
        <Button OnClick="() => _preview = false">Закрыть</Button>
    </Footer>
</Modal>

@code {
    private bool _preview;

    /// <summary>
    /// Убрать строку списка твари и дать вернуть её: корзина без вопроса, зато тост «Убрано: … — Отменить» (8 с). Диалог
    /// на каждую атаку замедлял бы правку статблока, а несохранённую страницу и так можно закрыть без записи.
    /// </summary>
    private void RemoveWithUndo<T>(List<T> list, int index, string? name)
    {
        var item = list[index];
        var what = item switch { CreatureAttack => "атака", CreatureSkill => "навык", _ => "умение" };
        list.RemoveAt(index);
        Toasts.Removed(string.IsNullOrWhiteSpace(name) ? what : name, () =>
        {
            list.Insert(Math.Min(index, list.Count), item);
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private static readonly System.Text.Json.Serialization.Metadata.JsonTypeInfo<CreatureDto> CreatureJson =
        (System.Text.Json.Serialization.Metadata.JsonTypeInfo<CreatureDto>)CampaignManager.Contracts.ContractsJsonContext.Default.GetTypeInfo(typeof(CreatureDto))!;

    private CreatureDto? _creature;
    private string _title = "Существо";
    private ElementReference _nameInput;
    private UnsavedChangesGuard? _guard;
    private string? _initialJson;
    private bool _saving;
    private bool _stale;
    private bool _leaving;
    private int _attempt;
    private string? _error;

    [Parameter] public Guid? Id { get; set; }

    private bool IsDirty => !_leaving && _creature is not null && _initialJson is not null && JsonSerializer.Serialize(_creature, CreatureJson) != _initialJson;

    private async Task<CreatureDto> LoadAsync(CancellationToken cancellationToken)
    {
        _error = null;
        _stale = false;
        _attempt = 0;
        if (Id is not { } id)
        {
            _creature = new CreatureDto();
            _initialJson = JsonSerializer.Serialize(_creature, CreatureJson);
            _title = "Новое существо";
            return _creature;
        }

        // Своей ручки «одна тварь» нет: бестиарий маленький и браузер держит его по ETag.
        var list = await Api.ListAsync(cancellationToken);
        _creature = list.Items.FirstOrDefault(c => c.Id == id);
        if (_creature is null)
        {
            _error = "Такого существа нет — возможно, его удалили.";
        }
        else
        {
            _initialJson = JsonSerializer.Serialize(_creature, CreatureJson);
        }

        // Имя в заголовке — на момент открытия: пока название правят (или стёрли), «Существо: » с пустым хвостом не мигает (E6).
        _title = _creature is { Name: { Length: > 0 } name } ? $"Существо: {name}" : "Существо";
        StateHasChanged(); // имя — в шапке, она вне AsyncContent

        return _creature ?? new CreatureDto();
    }

    private static IEnumerable<(string Label, StatValue Stat, int Index)> Stats(Statblock s) =>
        [("СИЛ", s.Str, 0), ("ВЫН", s.Con, 1), ("ТЕЛ", s.Siz, 2), ("ЛВК", s.Dex, 3), ("ИНТ", s.Int, 4), ("МОЩ", s.Pow, 5)];

    // Все ошибки сразу (правило 9); красными они становятся после первой попытки сохранить и гаснут по мере правки.
    private static Dictionary<string, string> Check(CreatureDto creature) =>
        string.IsNullOrWhiteSpace(creature.Name) ? new() { ["name"] = "Нужно название." } : [];

    private string? ErrorOf(Dictionary<string, string> errors, string key) => _attempt > 0 ? errors.GetValueOrDefault(key) : null;

    // Бой бросает только то, что понимает DiceFormula: «1d6» и «1d6 + бонус к урону» — да, «см. описание» — нет.
    // Это предупреждение, а не запрет: такой урон сохранится текстом.
    private static string? DamageNote(CreatureAttack attack) =>
        attack.DamageBonusMode == CreatureDamageBonusMode.OnlyBonus || string.IsNullOrWhiteSpace(attack.Damage)
        || Core.Dice.DiceFormula.Parse(attack.Damage).IsValid
            ? null
            : "Бой этот урон не бросит.";

    // Предел привыкания (стр. 167) — максимум провальной части, тем же разбором, что и бросок.
    private static string? SanityNote(string? sanityLoss) =>
        string.IsNullOrWhiteSpace(sanityLoss)
            ? "Успех/провал: 0/1d6."
            : $"Предел привыкания — {SanityLossFormula.MaxLoss(sanityLoss)}.";

    // Свой переход: вопроса «Выйти?» не будет ни после «Сохранить», ни после ответа «Выйти без сохранения» (E1, E8).
    // Одного _leaving мало — NavigationLock читает Dirty прошлого рендера, а NavigateTo зовёт его сразу.
    private void GoTo(string uri)
    {
        _leaving = true;
        _guard?.Allow();
        Navigation.NavigateTo(uri);
    }

    // Пусто — «0»: бонус к урону хранится строкой книги, а «0» в форме выглядел введённым (E5).
    private static string BonusOf(string? text) => string.IsNullOrWhiteSpace(text) ? "0" : text.Trim();

    private async Task LeaveAsync()
    {
        if (_guard is null || await _guard.ConfirmLeaveAsync())
        {
            GoTo(Id is { } id ? $"bestiary?open={id}" : "bestiary");
        }
    }

    private async Task SaveAsync()
    {
        if (_creature is null)
        {
            return;
        }

        if (Check(_creature).Count > 0)
        {
            _attempt++;
            _error = null;
            return;
        }

        _saving = true;
        _error = null;
        _stale = false;
        try
        {
            var saved = Id is null ? await Api.CreateAsync(_creature) : await Api.UpdateAsync(_creature);
            Toasts.Success($"Сохранено: {Names.Plain(saved.Name)}.");
            GoTo($"bestiary?open={saved.Id}");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _stale = ex.IsStale;
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_creature is not { } creature || Id is not { } id
            || !await Dialogs.ConfirmDeleteAsync("существо", Names.Plain(creature.Name), "Пропадёт из бестиария.", reversible: false))
        {
            return;
        }

        try
        {
            await Api.DeleteAsync(id);
            Toasts.Success($"Удалено: {Names.Plain(creature.Name)}.");
            GoTo("bestiary");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(ApiErrors.Describe(ex), "Не удалось удалить");
        }
    }

    private async Task RereadAsync()
    {
        _creature = await LoadAsync(CancellationToken.None);
        _error = "Это свежая версия существа — ваши правки нужно внести заново.";
    }
}
