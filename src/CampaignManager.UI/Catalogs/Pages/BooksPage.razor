@page "/books"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs
@inject ICatalogApi<SpellDto> SpellsApi

@* Книги: Название · Язык · Автор · Рассудок · МКН · МКП · ЗМ · Оккульт. Таблица с lg: её естественная ширина ~700px —
   на ландшафте iPad Pro 11" (колонка ~1064) влезает с запасом, в портрете (~690) нет (замер 2026-10-03). Фильтр категории убирает чужие колонки: у оккультных
   книг МКН/МКП/ЗМ пусты всегда, у книг Мифов — «+Оккультизм»; метка категории у названия — только без
   фильтра. Язык и автор в раскрытии не повторяются — с ячеек снимается обрезка. *@
<CatalogPage TItem="BookDto" Title="Книги" Icon="fa-book-open" AddLabel="Добавить книгу" Noun="книгу" Plural="книг"
             Filters="Filters" SearchAlso="b => b.AltNames.Append(b.Author)" TableFrom="TableBreakpoint.Lg" State="_state"
             New="() => new BookDto()" OnFormOpening="EnsureSpellsAsync" RowDetail="Detail" Form="Form">
    <Columns Context="view">
        <DataColumn TItem="BookDto" Title="Название" SortBy="b => b.Name" DefaultSort="false" HeaderClass="w-[26%]" Context="b">
            <span class="font-medium text-primary-800">@b.Name</span>
            @if (!view.IsFixed("type"))
            {
                <Badge Tone="@(b.BookType == BookType.MythosBook ? Tone.Info : Tone.Stone)" class="ml-1.5 align-middle">@CatalogText.Short(b.BookType)</Badge>
            }
        </DataColumn>
        <DataColumn TItem="BookDto" Title="Язык" SortBy="b => b.Language" HeaderClass="w-[12%]" Context="b">@Dash(b.Language)</DataColumn>
        <DataColumn TItem="BookDto" Title="Автор" SortBy="b => b.Author" HeaderClass="w-[16%]" Context="b">@Dash(b.Author)</DataColumn>
        <DataColumn TItem="BookDto" Title="@Terms.SanityLoss" HeaderClass="whitespace-normal" Context="b"><DiceText Value="@b.SanityLoss" /></DataColumn>
        @* Четыре числовых столбца были пусты у 70–90% книг и отнимали треть ширины: одно «Числа» — только то, что есть. *@
        @if (ShowNumbers(view))
        {
            <DataColumn TItem="BookDto" Title="Мифы (чтение, значение) / Оккультизм" HeaderClass="w-[26%] whitespace-normal" SortBy="b => b.MythosRating ?? b.OccultismBonus" Context="b">@Numbers(b)</DataColumn>
        }
    </Columns>
    <CardTemplate Context="b">
        <p class="font-medium text-primary-800">@b.Name <Badge Tone="@(b.BookType == BookType.MythosBook ? Tone.Info : Tone.Stone)" class="ml-1 align-middle">@CatalogText.Short(b.BookType)</Badge></p>
        <p class="cm-meta">@string.Join(" · ", new[] { b.Language, b.Author }.Where(x => !string.IsNullOrEmpty(x)))</p>
        <p class="mt-1 text-sm text-primary-600">
            Потеря Рассудка: @(b.SanityLoss ?? "—")
            @* Пустое не рисуем: у большинства книг Мифов этих чисел нет, три прочерка в каждой карточке ничего не говорят. *@
            @if (b.BookType == BookType.MythosBook)
            {
                @if (b.MythosInitial is not null) { <text> · Мифы (начальное) @Plus(b.MythosInitial)</text> }
                @if (b.MythosFull is not null) { <text> · Мифы (полное) @Plus(b.MythosFull)</text> }
                @if (b.MythosRating is not null) { <text> · Значение Мифов @b.MythosRating</text> }
            }
            else if (b.OccultismBonus is not null)
            {
                <text> · Оккультизм @Plus(b.OccultismBonus)</text>
            }
        </p>
    </CardTemplate>
</CatalogPage>

@code {
    private static readonly IReadOnlyList<CatalogFilter<BookDto>> Filters =
        [CatalogFilter<BookDto>.ForEnum<BookType>("type", Terms.AnyCategory, CatalogText.Of, b => b.BookType)];

    private Dictionary<Guid, SpellDto> _spells = [];

    protected override Task OnInitializedAsync() => EnsureSpellsAsync();

    private async Task EnsureSpellsAsync()
    {
        if (_spells.Count > 0)
        {
            return;
        }

        try
        {
            _spells = (await SpellsApi.ListAsync()).Items.ToDictionary(s => s.Id);
        }
        catch (HttpRequestException)
        {
            // Без списка заклинаний книги показываются строками книги — как записано.
        }
    }

    private readonly CatalogFormState _state = new();

    // Столбец без данных не рисуем (ни одной книги в выдаче с числами); внутри — только то, что у книги есть.
    private static bool ShowNumbers(CatalogView<BookDto> view) =>
        view.Filtered.Any(b => b.MythosInitial is not null || b.MythosFull is not null || b.MythosRating is not null || b.OccultismBonus is not null);

    private static string Numbers(BookDto b)
    {
        List<string> parts = [];
        if (b.MythosInitial is not null) parts.Add($"начальное {Plus(b.MythosInitial)}");
        if (b.MythosFull is not null) parts.Add($"полное {Plus(b.MythosFull)}");
        if (b.MythosRating is not null) parts.Add($"значение {b.MythosRating}");
        if (b.OccultismBonus is not null) parts.Add($"Оккультизм {Plus(b.OccultismBonus)}");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private static string Dash(string? text) => string.IsNullOrWhiteSpace(text) ? "—" : text;

    private static string? Plus(int? value) => value is { } v ? $"+{v}" : null;

    private RenderFragment<BookDto> Detail => b => __builder =>
    {
        <div class="flex flex-wrap items-start gap-4 text-sm">
            @if (b.ImageUrl is not null)
            {
                <img src="@b.ImageUrl" alt="@b.Name" class="max-h-48 rounded-md" loading="lazy" />
            }
            <dl class="grid min-w-0 flex-1 gap-1">
                @if (b.Year is not null)
                {
                    <div><dt class="cm-meta-label inline">Год, век: </dt><dd class="inline">@b.Year</dd></div>
                }
                @if (b.StudyWeeks is not null)
                {
                    <div><dt class="cm-meta-label inline">Полное изучение: </dt><dd class="inline">@b.StudyWeeks нед.</dd></div>
                }
                @if (b.AltNames.Count > 0)
                {
                    <div><dt class="cm-meta-label inline">Другие названия: </dt><dd class="inline">@string.Join(", ", b.AltNames)</dd></div>
                }
                @if (b.Spells.Count > 0)
                {
                    <div>
                        <dt class="cm-meta-label inline">Заклинания: </dt>
                        <dd class="inline">
                            @for (var i = 0; i < b.Spells.Count; i++)
                            {
                                var spell = b.Spells[i];
                                @(i > 0 ? ", " : "")
                                @if (spell.SpellId is { } id && _spells.TryGetValue(id, out var linked))
                                {
                                    <a class="text-accent-700 underline" href="@($"spells?q={Uri.EscapeDataString(linked.Name)}")">@spell.RawName</a>
                                }
                                else
                                {
                                    <span>@spell.RawName</span>
                                }
                            }
                        </dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(b.Description))
                {
                    <p class="mt-1 max-w-prose whitespace-pre-line text-primary-700">@b.Description</p>
                }
                @if (b.Source is not null)
                {
                    <p class="cm-meta">Источник: @b.Source</p>
                }
            </dl>
        </div>
    };

    private RenderFragment<BookDto> Form => b => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-2">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-2">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="b.Name" />
            </Field>
            <Field Label="Категория">
                <select class="cm-input" @bind="b.BookType">
                    @foreach (var type in Enum.GetValues<BookType>())
                    {
                        <option value="@type">@CatalogText.Of(type)</option>
                    }
                </select>
            </Field>
            <Field Label="Язык"><input class="cm-input" @bind="b.Language" /></Field>
            <Field Label="Автор"><input class="cm-input" @bind="b.Author" /></Field>
            <Field Label="Год, век"><input class="cm-input" placeholder="ок. 730 г. н. э." @bind="b.Year" /></Field>
            <Field Label="Потеря Рассудка"><input class="cm-input cm-dice" placeholder="1d10" @bind="b.SanityLoss" /></Field>
            @if (b.BookType == BookType.MythosBook)
            {
                <Field Label="Мифы (начальное)" Note="За начальное чтение."><input class="cm-input" type="number" min="0" max="99" @bind="b.MythosInitial" /></Field>
                <Field Label="Мифы (полное)" Note="За полное изучение."><input class="cm-input" type="number" min="0" max="99" @bind="b.MythosFull" /></Field>
                <Field Label="Значение Мифов" Note="Значение Мифов самой книги."><input class="cm-input" type="number" min="0" max="99" @bind="b.MythosRating" /></Field>
            }
            else
            {
                <Field Label="Прибавка к Оккультизму"><input class="cm-input" type="number" min="0" max="99" @bind="b.OccultismBonus" /></Field>
            }
            <Field Label="Недель на изучение" Hint="(полное)"><input class="cm-input" type="number" min="0" @bind="b.StudyWeeks" /></Field>
            <Field Label="Другие названия" Group="true" class="sm:col-span-2">
                <StringListEditor Values="b.AltNames" ValuesChanged="v => b.AltNames = [.. v]" ItemLabel="Название" Placeholder="Как ещё называют книгу" />
            </Field>
            <Field Label="Возможные заклинания" Group="true" class="sm:col-span-2"
                   Note="Как записано в книге. Связь со справочником сервер находит сам по точному имени или другому названию; не нашлось — выберите руками.">
                <BookSpellsEditor Spells="b.Spells" SpellsChanged="v => b.Spells = v" Catalog="_spells.Values" />
            </Field>
            <Field Label="Описание" class="sm:col-span-2"><textarea class="cm-input" rows="4" @bind="b.Description"></textarea></Field>
            <Field Label="Обложка" Group="true" class="sm:col-span-2">
                <ImagePicker FileId="b.ImageFileId" Url="@b.ImageUrl" OnChanged="file => { b.ImageFileId = file?.Id; b.ImageUrl = file?.Url; }" />
            </Field>
            <Field Label="Источник" Hint="(страница книги)" class="sm:col-span-2"><input class="cm-input" @bind="b.Source" /></Field>
        </div>
    };
}
