@page "/skills"
@attribute [Authorize]
@using CampaignManager.Core.Catalogs

@* Навыки: галерея общей системы справочников (CatalogPage, Styles/catalog.css) — гравюры 4:5 «сыщик за делом» группами по
   категории, плитка — база; таблица — вторым видом (?view=table): Название · База · Категория. Раскрытый навык — иллюстрация
   слева (у специализации без своей — родителя), справа детали (тот же SkillDetails, что в справке листа, без своей картинки);
   правка — окно. Раскрытый навык держится в адресе (?open=): на него можно дать ссылку, старые /skills/detail/{id} ведут сюда же. *@
<CatalogPage TItem="SkillDto" CoverOf="s => s.ImageUrl" Title="Навыки" Icon="fa-brain" AddLabel="Добавить навык" Noun="навык" Plural="навыков"
             Filters="Filters" Toggles="Toggles" ErasOf="s => s.Eras" SearchAlso="s => [ParentName(s)]" TableFrom="TableBreakpoint.Md"
             Art="CatalogArt.Portrait" ImagesOf="Images" GroupOf="s => CatalogText.Of(s.Category)" Tile="Tile" Details="Detail"
             State="_state" New="() => new SkillDto { BaseValue = 1 }" OnLoaded="Loaded" Form="Form">
    <Columns Context="view">
        <DataColumn TItem="SkillDto" Title="Название" SortBy="s => s.Name" DefaultSort="false" HeaderClass="w-[56%]" Context="s">
            <div class="flex items-center gap-3">
                <CatalogThumb Url="@s.ImageUrl" Art="CatalogArt.Portrait" Icon="fa-brain" />
                <span class="min-w-0">
                    <span class="font-medium text-primary-800">@s.Name</span>
                    @if (s.IsUncommon)
                    {
                        <Badge Tone="Tone.Warning" class="ml-1.5 align-middle">Необычный</Badge>
                    }
                    @if (view.ShowEra)
                    {
                        <EraBadges Values="s.Eras" />
                    }
                </span>
            </div>
        </DataColumn>
        <DataColumn TItem="SkillDto" Title="База" SortBy="s => s.BaseValue" HeaderClass="w-[12%]" CellClass="whitespace-nowrap" Context="s">@SkillDetails.BaseOf(s)</DataColumn>
        @if (!view.IsFixed("category"))
        {
            @* ~220px (S3): девять категорий по 9–30 знаков занимали 305px, а названию не хватало места. *@
            <DataColumn TItem="SkillDto" Title="Категория" SortBy="s => CatalogText.Of(s.Category)" HeaderClass="w-56" Context="s">@CatalogText.Of(s.Category)</DataColumn>
        }
    </Columns>
    <CardTemplate Context="s">
        <div class="flex items-start gap-3">
            <CatalogThumb Url="@s.ImageUrl" Art="CatalogArt.Portrait" Icon="fa-brain" Large="true" />
            <div class="min-w-0">
                <p class="font-medium text-primary-800">@s.Name</p>
                <p class="cm-meta">@CatalogText.Of(s.Category) · база @SkillDetails.BaseOf(s)</p>
            </div>
        </div>
    </CardTemplate>
</CatalogPage>

@code {
    private static readonly IReadOnlyList<CatalogFilter<SkillDto>> Filters =
        [CatalogFilter<SkillDto>.ForEnum<SkillCategory>("category", Terms.AnyCategory, CatalogText.Of, s => s.Category)];

    private static readonly IReadOnlyList<CatalogToggle<SkillDto>> Toggles =
    [
        new("uncommon", "Необычные", s => s.IsUncommon),
        new("specializations", "Специализации", s => s.ParentId is not null),
    ];

    private readonly CatalogFormState _state = new();
    private IReadOnlyList<SkillDto> _skills = [];

    private void Loaded(IReadOnlyList<SkillDto> skills) => _skills = [.. skills];

    private string? ParentName(SkillDto skill) =>
        skill.ParentId is { } id ? _skills.FirstOrDefault(s => s.Id == id)?.Name : null;

    // Плитка и миниатюра — своя картинка навыка (у специализаций без своей — заглушка: семь одинаковых «Стрельб» подряд ничего
    // не различают); раскрытие — своя или родителя.
    private IReadOnlyList<CatalogImageDto> Images(SkillDto s) =>
        s.ImageUrl is not null
            ? CatalogImages.Single(s.ImageFileId, s.ImageUrl)
            : _skills.FirstOrDefault(p => p.Id == s.ParentId) is { ImageUrl: { } url } parent ? CatalogImages.Single(parent.ImageFileId, url) : [];

    // Плитка: база (категория — заголовок группы) и «необычный».
    private static RenderFragment<SkillDto> Tile => s => __builder =>
    {
        <span>База @SkillDetails.BaseOf(s)@(s.IsUncommon ? " · необычный" : "")</span>
    };

    // В раскрытой строке таблицы база, категория и «необычный» уже в колонках (InRow); в галерее SkillDetails показывает их сам.
    private RenderFragment<CatalogDetails<SkillDto>> Detail => d => __builder =>
    {
        <SkillDetails Skill="d.Item" Catalog="_skills" InRow="d.InTable" ShowImage="false" ShowEra="_skills.Any(o => !o.Eras.SequenceEqual(d.Item.Eras))" />
    };

    // Родителем может быть только навык без родителя: у специализаций одна ступень.
    private IEnumerable<SkillDto> Parents(SkillDto skill) =>
        _skills.Where(s => s.ParentId is null && s.Id != skill.Id).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase);

    // Порядок полей — по тому, что заполняют чаще (S4): название, категория, база, особенности; «Специализация» —
    // у редких записей (58% навыков самостоятельные), поэтому ниже, рядом с источником.
    private RenderFragment<SkillDto> Form => s => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-2">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-2" Note="Специализация пишется с родителем в скобках: Наука (химия).">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="s.Name" />
            </Field>
            <Field Label="Категория">
                <select class="cm-input" @bind="s.Category">
                    @foreach (var category in Enum.GetValues<SkillCategory>())
                    {
                        <option value="@category">@CatalogText.Of(category)</option>
                    }
                </select>
            </Field>
            <Field Label="База" Hint="(%)" Note="Число, ½ ЛВК или ОБР.">
                <div class="flex gap-2">
                    <select class="cm-input w-36 shrink-0" aria-label="Формула базы" value="@(s.BaseFormula ?? "")"
                            @onchange="e => s.BaseFormula = e.Value is string { Length: > 0 } formula ? formula : null">
                        <option value="">число</option>
                        <option value="DEX/2">½ ЛВК</option>
                        <option value="EDU">ОБР</option>
                    </select>
                    @if (s.BaseFormula is null)
                    {
                        <input class="cm-input" type="number" min="0" max="99" aria-label="База, %" @bind="s.BaseValue" />
                    }
                </div>
            </Field>
            <Field Label="Особенности" Group="true">
                <label class="cm-tap-row"><input type="checkbox" class="cm-checkbox" @bind="s.IsUncommon" /><span>Необычный навык</span></label>
                <label class="cm-tap-row"><input type="checkbox" class="cm-checkbox" @bind="s.CanRetry" /><span>Проверку можно повторить</span></label>
            </Field>
            <Field Label="Время" Note="Сколько занимает проверка."><input class="cm-input" placeholder="1 час" @bind="s.TimeRequired" /></Field>
            <div class="sm:col-span-2"><EraPicker Show="_state.ErasVary" @bind-Values="s.Eras" /></div>
            <Field Label="Описание" class="sm:col-span-2"><textarea class="cm-input" rows="5" @bind="s.Description"></textarea></Field>
            <Field Label="Примеры применения" Group="true" class="sm:col-span-2">
                <StringListEditor Values="s.UsageExamples" ValuesChanged="v => s.UsageExamples = [.. v]" ItemLabel="Пример" />
            </Field>
            <Field Label="Последствия провала" Group="true" class="sm:col-span-2">
                <StringListEditor Values="s.FailureConsequences" ValuesChanged="v => s.FailureConsequences = [.. v]" ItemLabel="Последствие" />
            </Field>
            <Field Label="Встречные навыки" Group="true">
                <StringListEditor Values="s.OpposingSkills" ValuesChanged="v => s.OpposingSkills = [.. v]" ItemLabel="Навык" />
            </Field>
            <div class="grid content-start gap-4">
                <Field Label="Специализация навыка" Note="Пусто — самостоятельный навык.">
                    <select class="cm-input" @bind="s.ParentId">
                        <option value="">—</option>
                        @foreach (var parent in Parents(s))
                        {
                            <option value="@parent.Id">@parent.Name</option>
                        }
                    </select>
                </Field>
                <Field Label="Источник" Note="Книга и страница."><input class="cm-input" @bind="s.Source" /></Field>
            </div>
            <Field Label="Иллюстрация" Group="true" class="sm:col-span-2" Note="@(ParentName(s) is { } parent ? $"Пусто — показывается иллюстрация навыка «{parent}»." : null)">
                <ImagePicker Webp="true" FileId="s.ImageFileId" Url="@s.ImageUrl" OnChanged="file => { s.ImageFileId = file?.Id; s.ImageUrl = file?.Url; }" />
            </Field>
        </div>
    };
}
