@page "/skills/detail/{Id:guid}"
@page "/skills/edit/{Id:guid}"
@page "/skills/edit"
@attribute [Authorize]
@inject NavigationManager Navigation

@* Адреса v1 (паритет): деталей и правки навыка как отдельных страниц больше нет — навык
   раскрывается в справочнике (?open=), правка — окно там же. Закладки и ссылки ведут туда. *@

@code {
    [Parameter] public Guid? Id { get; set; }

    protected override void OnInitialized() =>
        Navigation.NavigateTo(Id is { } id ? $"skills?open={id}" : "skills", replace: true);
}
