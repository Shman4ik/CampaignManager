@page "/spells"
@attribute [Authorize]
@using System.Text.RegularExpressions
@using CampaignManager.Core.Catalogs
@inject ICatalogApi<BookDto> BooksApi

@* Заклинания: Название · Тип · Стоимость · Время сотворения. Колонок пять — таблица с lg (портрет
   iPad её вмещает, замер v1). Стоимость и время — длинный свободный текст: в строке обрезаны и
   разворачиваются на месте; в раскрытии — только то, чего в колонках нет (другие названия, описание).
   При фильтре по типу колонка типа уходит, её ширина достаётся стоимости. В раскрытии — «В книгах: …» ссылками на
   раскрытую книгу (P4): за столом нужно знать, где искать заклинание. *@
<CatalogPage TItem="SpellDto" Title="Заклинания" Icon="fa-hat-wizard" AddLabel="Добавить заклинание" Noun="заклинание" Plural="заклинаний"
             Filters="_filters" SearchAlso="s => s.AltNames" TableFrom="TableBreakpoint.Md" OnLoaded="Loaded" State="_state" Validate="Validate"
             New="() => new SpellDto()" OnFormOpening="OnOpening" RowDetail="Detail" Form="Form">
    <Columns Context="view">
        <DataColumn TItem="SpellDto" Title="Название" SortBy="s => s.Name" DefaultSort="false" HeaderClass="w-[28%]" CellClass="font-medium text-primary-800" Context="s">@s.Name</DataColumn>
        @if (!view.IsFixed("type"))
        {
            <DataColumn TItem="SpellDto" Title="Тип" SortBy="s => s.SpellType" HeaderClass="w-[14%]" Context="s">@s.SpellType</DataColumn>
        }
        <DataColumn TItem="SpellDto" Title="Стоимость" HeaderClass="@(view.IsFixed("type") ? "w-[44%]" : "w-[34%]")" Context="s">@Cost(s.Cost)</DataColumn>
        <DataColumn TItem="SpellDto" Title="Время сотворения" Context="s">@s.CastingTime</DataColumn>
    </Columns>
    <CardTemplate Context="s">
        <p class="font-medium text-primary-800">@s.Name</p>
        <p class="cm-meta">@s.SpellType · Время: @s.CastingTime</p>
        <p class="mt-1 text-sm text-primary-600">@Cost(s.Cost)</p>
    </CardTemplate>
</CatalogPage>

@code {
    private IReadOnlyList<CatalogFilter<SpellDto>> _filters = [];
    private IReadOnlyList<string> _types = [];

    private IReadOnlyList<BookDto> _books = [];
    private IReadOnlyList<SpellData> _spellData = [];
    private Dictionary<Guid, List<BookDto>> _booksBySpell = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _books = (await BooksApi.ListAsync()).Items;
            Link();
        }
        catch (HttpRequestException)
        {
            // Без книг раскрытие обходится без строки «В книгах».
        }
    }

    // Заклинание ↔ книги: связь, записанная у книги, или то же точное совпадение имени, что ищет сервер.
    private void Link()
    {
        Dictionary<Guid, List<BookDto>> map = [];
        foreach (var book in _books)
        {
            foreach (var entry in book.Spells)
            {
                var id = entry.SpellId ?? SpellMatcher.Match(_spellData, entry.RawName)?.Id;
                if (id is { } spellId)
                {
                    var list = map.TryGetValue(spellId, out var known) ? known : map[spellId] = [];
                    if (!list.Contains(book))
                    {
                        list.Add(book);
                    }
                }
            }
        }

        _booksBySpell = map;
    }

    private void Loaded(IReadOnlyList<SpellDto> spells)
    {
        _spellData = [.. spells.Select(sp => new SpellData(sp.Id, sp.Name) { AlternativeNames = sp.AltNames })];
        Link();
        _types = [.. spells.Select(s => s.SpellType).Where(t => t.Length > 0).Distinct(StringComparer.CurrentCultureIgnoreCase).Order()];
        // Составной тип («Атака/Проклятие») — несколько тегов: фильтр по тегу находит и его, иначе 28 значений не сужают список.
        var tags = spells.SelectMany(s => Tags(s.SpellType)).Distinct(StringComparer.CurrentCultureIgnoreCase).Order().ToList();
        _filters = [new("type", Terms.AnyType, [.. tags.Select(t => new CatalogOption(t, t))],
            (spell, type) => Tags(spell.SpellType).Contains(type, StringComparer.CurrentCultureIgnoreCase))];
    }

    private readonly CatalogFormState _state = new();

    private const string OtherType = "other";
    private bool _otherType;

    // Тип записи, которого нет в списке, — «Другой»: поле для названия появляется при выборе и у такой записи.
    private string TypeChoice(SpellDto s) =>
        _otherType || (s.SpellType.Length > 0 && !_types.Contains(s.SpellType, StringComparer.CurrentCultureIgnoreCase)) ? OtherType : s.SpellType;

    private void OnOpening() => _otherType = false;

    private void ChooseType(SpellDto s, string? value)
    {
        _otherType = value == OtherType;
        s.SpellType = value is null or OtherType ? "" : value;
    }

    private static IReadOnlyList<string> Tags(string type) =>
        [.. type.Split('/', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)];

    // «>=» из переноса — «≥» (правило 11); единицы стоимости переносятся данными, не интерфейсом.
    private static string Cost(string? cost) => (cost ?? "").Replace(">=", "≥", StringComparison.Ordinal).Replace("<=", "≤", StringComparison.Ordinal);

    private static IReadOnlyDictionary<string, string> Validate(SpellDto s) =>
        string.IsNullOrWhiteSpace(s.SpellType)
            ? new Dictionary<string, string> { ["type"] = "Выберите тип заклинания." }
            : new Dictionary<string, string>();

    // Остаток переноса: составной тип «Атака/Проклятие» оставил один тип, остальные — строкой «Также: Проклятие.» в конце
    // описания. В тексте её не показываем — это тип, а не описание; выводим отдельной строкой «Также относится к».
    private static readonly Regex AlsoTail = new(@"\s*Также:\s*(?<also>[^\n]+?)\.?\s*$", RegexOptions.CultureInvariant);

    private static (string Text, string? Also) SplitAlso(string? description)
    {
        var text = description ?? "";
        var match = AlsoTail.Match(text);
        return match.Success ? (text[..match.Index].TrimEnd(), match.Groups["also"].Value) : (text, null);
    }

    private RenderFragment<SpellDto> Detail => s => __builder =>
    {
        var (description, also) = SplitAlso(s.Description);
        var books = _booksBySpell.GetValueOrDefault(s.Id) ?? [];
        <div class="grid gap-2 text-sm">
            @if (s.AltNames.Count > 0)
            {
                <p><span class="cm-meta-label">Другие названия: </span>@string.Join(", ", s.AltNames)</p>
            }
            @if (also is not null)
            {
                <p><span class="cm-meta-label">Также относится к: </span>@also</p>
            }
            @if (books.Count > 0)
            {
                <p>
                    <span class="cm-meta-label">В книгах: </span>
                    @for (var i = 0; i < books.Count; i++)
                    {
                        @(i > 0 ? ", " : "")
                        <a class="text-accent-700 underline" href="@($"books?open={books[i].Id}")">@books[i].Name</a>
                    }
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(description))
            {
                <p class="max-w-prose whitespace-pre-line text-primary-700">@description</p>
            }
            else
            {
                <p class="cm-text-muted">Описания нет.</p>
            }
            @if (s.Source is not null)
            {
                <p class="cm-meta">Источник: @s.Source</p>
            }
        </div>
    };

    private RenderFragment<SpellDto> Form => s => __builder =>
    {
        <div class="grid gap-4 sm:grid-cols-2">
            <Field Label="Название" Required="true" Error="@_state.For("name")" class="sm:col-span-2">
                <input class="cm-input" aria-invalid="@_state.Invalid("name")" @bind="s.Name" />
            </Field>
            <Field Label="Тип" Required="true" Error="@_state.For("type")">
                @* Список — стрелкой и выбором (поле с datalist не показывало, что варианты есть); новый тип — «Другой…». *@
                <select class="cm-input" aria-invalid="@_state.Invalid("type")" value="@TypeChoice(s)" @onchange="e => ChooseType(s, e.Value?.ToString())">
                    <option value="">— выберите —</option>
                    @foreach (var type in _types)
                    {
                        <option value="@type">@type</option>
                    }
                    <option value="@OtherType">Другой тип…</option>
                </select>
                @if (_otherType)
                {
                    <input class="cm-input mt-2" placeholder="Название типа" aria-label="Название нового типа" @bind="s.SpellType" @bind:event="oninput" />
                }
            </Field>
            <Field Label="Источник" Note="Книга и страница."><input class="cm-input" @bind="s.Source" /></Field>
            <Field Label="Стоимость" class="sm:col-span-2" Note="@CostHint(s.Cost)">
                <input class="cm-input" placeholder="8 ПМ, 1d6 рассудка" @bind="s.Cost" @bind:event="oninput" />
            </Field>
            <Field Label="Время сотворения" class="sm:col-span-2" Note="@TimeHint(s.CastingTime)">
                <input class="cm-input" placeholder="1 раунд" @bind="s.CastingTime" @bind:event="oninput" />
            </Field>
            <Field Label="Другие названия" Group="true" class="sm:col-span-2"
                   Note="Как называют заклинание в книгах.">
                <StringListEditor Values="s.AltNames" ValuesChanged="v => s.AltNames = [.. v]" ItemLabel="Название" Placeholder="Как ещё называют" />
            </Field>
            <Field Label="Описание" class="sm:col-span-2"><textarea class="cm-input" rows="6" @bind="s.Description"></textarea></Field>
        </div>
    };

    // Подсказка для боя — не правда, а то, что поймёт помощник: неразобранное Хранитель подтвердит сам.
    private static readonly Regex Variable = new(@"[≥≤]|>=|<=|\bс\s+(?:человека|цели|участника)|за\s+каждого|варьир|от\s+\d", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);

    private static string? CostHint(string? cost)
    {
        var estimate = SpellStatsReader.ParseCost(cost);
        if (string.IsNullOrWhiteSpace(cost))
        {
            return null;
        }

        // «≥1 ПМ с человека», «варьирует»: стоимость не фиксированная — подсказка «спишется ПМ 1» обманула бы Хранителя.
        if (estimate.IsEmpty || Variable.IsMatch(cost))
        {
            return "В бою стоимость не посчитается сама — впишите её при сотворении.";
        }

        List<string> parts = [];
        if (estimate.MagicPoints is { } mp) parts.Add($"ПМ {mp}");
        if (estimate.Sanity is { } san) parts.Add($"рассудок {san}");
        if (estimate.Power is { } pow) parts.Add($"МОЩ {pow}");
        if (estimate.HitPoints is { } hp) parts.Add($"ПЗ {hp}");
        return "В бою спишется: " + string.Join(", ", parts);
    }

    private static string? TimeHint(string? time)
    {
        var estimate = SpellStatsReader.ParseCastingTime(time);
        return estimate switch
        {
            _ when string.IsNullOrWhiteSpace(time) => null,
            { IsInstant: true } => "В бою: мгновенно.",
            { Rounds: { } rounds } => $"В бою раундов: {rounds}{(estimate.MentionsLongerUnits ? ", в тексте есть и минуты/часы" : "")}.",
            { RoundsFormula: { } formula } => $"В бою раундов: {formula}.",
            { MentionsLongerUnits: true } => "В бою не творится: минуты, часы или дни.",
            _ => "В бою время не посчитается само — решите сами.",
        };
    }
}
