@typeparam TItem
@using CampaignManager.Core.Catalogs
@using CampaignManager.UI.Platform

@* Выбор записи справочника в окне — один на тварей и предметы сценария, НПС и прегенов из библиотеки (в v1 —
   почти одинаковые AddCreatureModal, AddItemModal, AddNpcModal со своими копиями поиска). Список приходит целиком
   (Load), поиск — без регистра, «ё» и лишних пробелов; выбранная строка подсвечена, под списком — свои поля
   страницы (ChildContent: количество, где, заметки; FieldsAlways — стоят выключенными с самого начала, чтобы окно не росло
   и не сдвигалось после выбора строки). Запись делает страница в OnPick: ошибка (Error) остаётся в окне, окно не
   закрывается; пока идёт запись (Busy), кнопки выключены; «Добавить» выключена с причиной (SelectReason). Extra — «Нет в списке?
   Создать нового» под списком. Строка списка — в одну линию (название, справа тип или занятие). Окно декларативное: Open. *@
@* Список без полей под ним (навык оружия, заклинание книги) — повыше: 28vh из 696px показывали три записи; с полями под ним — по высоте
   экрана за вычетом полей, не выше 22rem. *@
@* У верхнего края: после выбора строки поля «Сколько/Где» растут вниз, окно не прыгает. *@
<Modal Open="Open" Title="@Title" OnClose="CloseAsync" class="cm-modal-top" data-testid="catalog-picker">
    <ChildContent>
        <div class="flex flex-col gap-3">
            <input type="search" class="cm-input" placeholder="@Placeholder" aria-label="@Placeholder" data-testid="picker-search"
                   @bind="_query" @bind:event="oninput" />
            @FilterContent
            @if (_items is null && _error is null)
            {
                <LoadingIndicator Message="Загружаю…" />
            }
            else if (_error is not null)
            {
                <Alert Tone="Tone.Error" Small="true" class="mb-0">@_error</Alert>
            }
            else
            {
                var found = Found();
                @if (found.Count == 0)
                {
                    <p class="cm-field-note py-2">@(string.IsNullOrWhiteSpace(_query) ? Empty : "Ничего не найдено.")</p>
                }
                else
                {
                    @* Список целиком (владелец 2026-10-04: каждая запись должна быть достижима без поиска); при длинном списке над
                       рамкой — сколько в нём записей: полосы прокрутки на iPad не видно. *@
                    @if (found.Count > 7)
                    {
                        <p class="cm-field-note" data-testid="picker-count">Записей: @found.Count — листайте список</p>
                    }
                    <div class="@Css.Join(ListClass ?? (ChildContent is null ? "max-h-[46vh]" : "max-h-[min(calc(100dvh-30rem),22rem)] min-h-24"), "overflow-y-auto rounded-md border border-primary-200")" role="listbox" aria-label="@Title">
                        @foreach (var item in found)
                        {
                            var selected = _selected is not null && Equals(Key(_selected), Key(item));
                            <button type="button" role="option" aria-selected="@(selected ? "true" : "false")" data-testid="picker-row"
                                    class="@Css.Join("flex min-h-10 w-full flex-wrap items-baseline justify-between gap-x-3 border-t border-primary-200 px-3 py-1.5 text-left first:border-t-0",
                                               selected ? "bg-accent-50" : "hover:bg-primary-50")"
                                    @onclick="() => _selected = item">
                                <span class="flex min-w-0 items-center gap-2 font-medium text-primary-900">
                                    @if (selected)
                                    {
                                        <i class="fa-solid fa-check text-accent-600" aria-hidden="true"></i>
                                    }
                                    @Name(item)
                                </span>
                                @if (Meta?.Invoke(item) is { Length: > 0 } meta)
                                {
                                    <span class="text-[0.8125rem] text-primary-600">@meta</span>
                                }
                            </button>
                        }
                    </div>
                }
            }
            @if (Extra is not null)
            {
                <div class="flex flex-wrap items-center gap-2 text-sm text-primary-600" data-testid="picker-extra">@Extra</div>
            }
            @if (ChildContent is not null && (_selected is not null || FieldsAlways))
            {
                <div class="border-t border-primary-200 pt-3">
                    <fieldset class="contents" disabled="@(_selected is null)">@ChildContent(_selected!)</fieldset>
                </div>
            }
            @if (Error is not null)
            {
                <Alert Tone="Tone.Error" Small="true" ShowIcon="true" class="mb-0" data-testid="picker-error">@Error</Alert>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="Busy">Отмена</Button>
        <Button Icon="@ConfirmIcon" Busy="Busy" Disabled="@(_selected is null)" DisabledReason="@(_selected is null ? SelectReason : null)" data-testid="picker-confirm" OnClick="PickAsync">@ConfirmText</Button>
    </Footer>
</Modal>

@code {
    private string _query = "";
    private IReadOnlyList<TItem>? _items;
    private string? _error;
    private TItem? _selected;
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public Func<CancellationToken, Task<IReadOnlyList<TItem>>> Load { get; set; } = null!;

    [Parameter, EditorRequired] public Func<TItem, object> Key { get; set; } = null!;

    [Parameter, EditorRequired] public Func<TItem, string> Name { get; set; } = null!;

    /// <summary>Строка под названием: тип, ПЗ, занятие.</summary>
    [Parameter] public Func<TItem, string?>? Meta { get; set; }

    /// <summary>Другие тексты, по которым тоже ищется (занятие, тип).</summary>
    [Parameter] public Func<TItem, IEnumerable<string?>>? Also { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Поиск по названию…";

    [Parameter] public string Empty { get; set; } = "Список пуст.";

    [Parameter] public string ConfirmText { get; set; } = "Добавить";

    /// <summary>Иконка главной кнопки: «+» у добавления, галочка у выбора (навык оружия, связь заклинания).</summary>
    [Parameter] public string ConfirmIcon { get; set; } = "fa-plus";

    /// <summary>
    /// Высота списка (класс Tailwind). Не задана — по умолчанию: без полей под списком 46vh, с полями 28vh. Окно, которому нужно
    /// иначе (подбор оружия: типы, список и заметка в одной высоте экрана), задаёт сам.
    /// </summary>
    [Parameter] public string? ListClass { get; set; }

    /// <summary>Что сказать, пока ничего не выбрано, рядом с неактивным «Выбрать» (правило 8).</summary>
    [Parameter] public string SelectReason { get; set; } = "Выберите запись";

    /// <summary>Отбор поверх поиска — например по типу (кнопки в <see cref="FilterContent"/> меняют то, что он пропускает).</summary>
    [Parameter] public Func<TItem, bool>? Filter { get; set; }

    /// <summary>Кнопки отбора — между поиском и списком.</summary>
    [Parameter] public RenderFragment? FilterContent { get; set; }

    /// <summary>Поля под выбранной записью (количество, где, заметки).</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>
    /// Поля стоят с самого начала, выключенными, пока запись не выбрана: окно не растёт и не сдвигается после выбора.
    /// Поля тогда не должны читать выбранную запись (до выбора её нет).
    /// </summary>
    [Parameter] public bool FieldsAlways { get; set; }

    /// <summary>Что делать, если нужного нет в списке: «Создать нового», «Быстрый НПС» — под списком.</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<TItem> OnPick { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Открытие — новый выбор и свежий список; перерисовка открытого окна их не сбрасывает.
        var opened = Open && !_wasOpen;
        _wasOpen = Open;
        if (!opened)
            return;

        _query = "";
        _selected = default;
        _items = null;
        _error = null;
        try
        {
            _items = await Load(CancellationToken.None);
        }
        catch (HttpRequestException ex)
        {
            _error = ApiErrors.Describe(ex);
        }
    }

    private List<TItem> Found()
    {
        var query = CatalogCodeTable.NormalizeName(_query);
        bool Matches(string? text) => text is not null && CatalogCodeTable.NormalizeName(text).Contains(query, StringComparison.Ordinal);

        var all = (_items ?? [])
            .Where(i => Filter is null || Filter(i))
            .Where(i => query.Length == 0 || Matches(Name(i)) || (Also?.Invoke(i).Any(Matches) ?? false))
            .ToList();
        return all;
    }

    private Task PickAsync() => _selected is null || Busy ? Task.CompletedTask : OnPick.InvokeAsync(_selected);

    private Task CloseAsync() => Busy ? Task.CompletedTask : OnClose.InvokeAsync();
}
