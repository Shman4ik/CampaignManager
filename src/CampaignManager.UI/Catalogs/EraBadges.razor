@using CampaignManager.Core.Catalogs
@using CampaignManager.Core

@* Метка эпохи у названия. Запись «из всех эпох» метки не несёт — различать нечего; при фильтре
   по эпохе страница метку не показывает вовсе (ShowEra): она стояла бы в каждой строке. *@
@if (Values.Count > 0 && Values.Count < Enum.GetValues<Era>().Length)
{
    @foreach (var era in Values)
    {
        <Badge Tone="Tone.Stone" class="ml-1.5 align-middle">@CatalogText.Of(era)</Badge>
    }
}

@code {
    [Parameter] public IReadOnlyCollection<Era> Values { get; set; } = [];
}
