@using CampaignManager.Core.Catalogs


@* Детали навыка — один компонент на справочник и справку на листе (в v1 их рисовали трижды:
   SkillCard, SkillDetailPage, SkillInfoPopover). Своей карточки не рисует: стоит в раскрытой строке
   справочника или в окне листа. База — по правилу Core (Уклонение — ½ ЛВК, родной язык — ОБР). *@
<div class="grid gap-3 text-sm">
    @* В строке справочника база, категория и «необычный» уже в колонках и у названия — не повторяем (UX-0b, п. «Раскрытая
       строка»); в справке на листе их нет, там они нужны. Эпоху — только когда в справочнике больше одной. *@
    @if (!InRow || Parent is not null || ShowEra)
    {
        <div class="cm-meta">
            @if (!InRow)
            {
                <span><span class="cm-meta-label">База:</span> @BaseText</span>
                <span><span class="cm-meta-label">Категория:</span> @CatalogText.Of(Skill.Category)</span>
            }
            @if (Parent is not null)
            {
                <span><span class="cm-meta-label">Специализация навыка</span> «@Parent.Name»</span>
            }
            @if (!InRow && Skill.IsUncommon)
            {
                <Badge Tone="Tone.Warning">Необычный</Badge>
            }
            @if (ShowEra)
            {
                <span><span class="cm-meta-label">Эпоха:</span> @CatalogText.Of(Skill.Eras)</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Skill.Description))
    {
        <p class="whitespace-pre-line text-primary-700">@Skill.Description</p>
    }

    @if (Children.Count > 0)
    {
        <p><span class="cm-meta-label">Специализации: </span>@string.Join(", ", Children.Select(c => c.Name))</p>
    }

    <div class="grid gap-3 sm:grid-cols-2">
        @if (Skill.UsageExamples.Count > 0)
        {
            <div>
                <h4 class="cm-section-title mb-1">Примеры применения</h4>
                <ul class="list-disc pl-5 text-primary-700">
                    @foreach (var example in Skill.UsageExamples)
                    {
                        <li>@example</li>
                    }
                </ul>
            </div>
        }
        @if (Skill.FailureConsequences.Count > 0)
        {
            <div>
                <h4 class="cm-section-title mb-1">Последствия провала</h4>
                <ul class="list-disc pl-5 text-primary-700">
                    @foreach (var consequence in Skill.FailureConsequences)
                    {
                        <li>@consequence</li>
                    }
                </ul>
            </div>
        }
    </div>

    @if (Skill.OpposingSkills.Count > 0 || Skill.TimeRequired is not null || Skill.CanRetry)
    {
        <div class="cm-meta">
            @if (Skill.OpposingSkills.Count > 0)
            {
                <span><span class="cm-meta-label">Встречная проверка:</span> @string.Join(", ", Skill.OpposingSkills)</span>
            }
            @if (Skill.TimeRequired is not null)
            {
                <span><span class="cm-meta-label">Время:</span> @Skill.TimeRequired</span>
            }
            @if (Skill.CanRetry)
            {
                <span>Проверку можно повторить</span>
            }
        </div>
    }

    @if (Skill.Source is not null)
    {
        <p class="cm-meta">Источник: @Skill.Source</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public SkillDto Skill { get; set; } = null!;

    /// <summary>Рисуется в раскрытой строке справочника: база, категория и «необычный» там уже в колонках.</summary>
    [Parameter] public bool InRow { get; set; }

    /// <summary>Показывать эпоху: только когда записи справочника из разных эпох.</summary>
    [Parameter] public bool ShowEra { get; set; }

    /// <summary>Весь справочник — для родителя и специализаций.</summary>
    [Parameter] public IReadOnlyList<SkillDto> Catalog { get; set; } = [];

    private SkillDto? Parent => Skill.ParentId is { } id ? Catalog.FirstOrDefault(s => s.Id == id) : null;

    private IReadOnlyList<SkillDto> Children => [.. Catalog.Where(s => s.ParentId == Skill.Id).OrderBy(s => s.Name)];

    /// <summary>Формула базы — словами, как на листе; число — с процентом.</summary>
    public static string BaseOf(SkillDto skill) => skill.BaseFormula switch
    {
        "DEX/2" => "½ ЛВК",
        "EDU" => "ОБР",
        { } other => other,
        null => $"{skill.BaseValue}%",
    };

    private string BaseText => BaseOf(Skill);
}
