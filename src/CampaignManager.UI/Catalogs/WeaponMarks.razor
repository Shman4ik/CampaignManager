@* Метка — только отличие (правило 17): «редк.» и «не пронз.». Пронзающее у 56 из 69 видов — это норма, бейдж у
   каждой строки переносил название на вторую строку; пронзающее видно в раскрытой строке и в фильтре «Пронзающее». *@
@if (Weapon.IsRare)
{
    <Badge Tone="Tone.Warning" class="ml-1.5 align-middle">редк.</Badge>
}
@if (!Weapon.IsImpaling)
{
    <Badge Tone="Tone.Neutral" class="ml-1.5 align-middle">не пронз.</Badge>
}

@code {
    [Parameter, EditorRequired] public WeaponDto Weapon { get; set; } = null!;
}
