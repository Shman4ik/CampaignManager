@* Редкость и «пронз.» рисуются всегда: они действительно редкие и различают строки (в отличие от
   эпохи при фильтре). Редкость ортогональна эпохе: «1920-е, редко». «пронз.» — свойство, а не ошибка: нейтральный тон (Error — только
   для ошибок, правило 17). *@
@if (Weapon.IsRare)
{
    <Badge Tone="Tone.Warning" class="ml-1.5 align-middle">редк.</Badge>
}
@if (Weapon.IsImpaling)
{
    <Badge Tone="Tone.Neutral" class="ml-1.5 align-middle">пронз.</Badge>
}

@code {
    [Parameter, EditorRequired] public WeaponDto Weapon { get; set; } = null!;
}
