@* Значок «разобрать не удалось» рядом со значением оружия. Стоит и в таблице, и в карточках:
   портрет iPad живёт на карточках, и сигнал не должен там пропадать. На книжных данных не
   срабатывает — он для самодельного оружия Хранителя. Подпись — для экранного диктора, а не title=:
   наведения на iPad нет. *@
@if (Show)
{
    <i class="fa-solid fa-circle-question ml-1 text-warning-600" role="img" aria-label="@($"Не разобрано: {What}")"></i>
}

@code {
    /// <summary>Значение не разобрано (и не пустое).</summary>
    [Parameter] public bool Show { get; set; }

    [Parameter] public string What { get; set; } = "значение";
}
