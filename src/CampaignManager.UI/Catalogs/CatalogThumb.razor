@* Миниатюра у названия в таблице и в карточке телефона — одна на все справочники (Styles/catalog.css): высотой 40px (56px
   в карточке телефона), ширина — по рамке справочника (4:5 или 3:2). Без картинки — заглушка того же размера с иконкой
   справочника: названия стоят на одной линии. 240px — миниатюра на 84px при плотности экрана 2–3. *@
<span class="@Css.Join(CatalogArtCss.Frame(Art), "cm-thumb", Large ? "cm-thumb-lg" : null)" aria-hidden="@(Url is null ? "true" : null)">
    @if (Url is not null)
    {
        <img src="@ImageUrls.Thumb(Url, 240)" alt="" loading="lazy" decoding="async" />
    }
    else
    {
        <i class="@($"fa-solid {Icon}")"></i>
    }
</span>

@code {
    /// <summary>Адрес обложки записи; нет — заглушка.</summary>
    [Parameter] public string? Url { get; set; }

    [Parameter] public CatalogArt Art { get; set; }

    /// <summary>Иконка заглушки — та же, что у пункта меню справочника.</summary>
    [Parameter] public string Icon { get; set; } = "fa-image";

    /// <summary>Карточка телефона: 56px вместо 40.</summary>
    [Parameter] public bool Large { get; set; }
}
