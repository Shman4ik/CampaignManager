<Project>

  <!--
    Общие настройки проектов 2.0: src/, tools/ и их тестов в tests/.

    v1 заморожен (docs/v2/README.md, решение D2) и собирается из своих csproj, как раньше.
    Этот файл и Directory.Packages.props лежат в корне, а Dockerfile v1 делает `COPY . .`, поэтому
    для проектов v1 всё ниже выключено по имени — иначе центральные версии пакетов уронили бы
    их PackageReference с Version (NU1008). Список уходит вместе с v1 в T3.3.
  -->
  <PropertyGroup>
    <IsCampaignManagerV1 Condition="'$(MSBuildProjectName)' == 'CampaignManager.Web'
                                    or '$(MSBuildProjectName)' == 'CampaignManager.ServiceDefaults'
                                    or '$(MSBuildProjectName)' == 'CampaignManager.AppHost'
                                    or '$(MSBuildProjectName)' == 'CampaignManager.Rules.Tests'">true</IsCampaignManagerV1>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsCampaignManagerV1)' == 'true'">
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsCampaignManagerV1)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
