<Project>

  <!-- Версии пакетов проектов 2.0. Проекты v1 этот файл не видят — см. Directory.Build.props. -->
  <PropertyGroup>
    <!--
      Транзитивные пакеты из списка ниже тоже берут эту версию. Без этого Npgsql (EF 10.0.4)
      и EF Design (EF 10.0.12) дают Data и сервису разные EF — CS1705 при сборке.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    EF Core остаётся на 10.x, хотя всё остальное — .NET 11: у провайдера Npgsql стабильной версии под EF 11 ещё нет
    (11.0.0-rc.3 на 2026-11-14), а 10.0.3 и EFCore.NamingConventions 10.0.1 требуют EF строго ниже 11.0.0.
    Вместе с EF на 10.x держится Microsoft.AspNetCore.DataProtection.EntityFrameworkCore: его 11.0.0 тянет EF 11.
    Поднимать все пять разом, когда выйдет Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0 (и NamingConventions под него).
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
